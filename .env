# API Gateway URL
APIGATEWAY_ACONTPLUS=https://localhost:7060

# CORS Origins (production domains)
SAFE_ORIGINS=https://app.acontplus.com,https://www.acontplus.com

RESTART_POLICY=unless-stopped
MEMORY_LIMIT=512M
CPU_LIMIT=1

# Logging Driver with rotation
LOG_DRIVER=json-file
LOG_MAX_SIZE=50m
LOG_MAX_FILE=5

# Redis (configure if used)
# REDIS_HOST=redis-production
# REDIS_PORT=6379
# REDIS_PASSWORD=

# RabbitMQ (configure if used)
# RABBITMQ_HOST=rabbitmq-production
# RABBITMQ_PORT=5672
# RABBITMQ_USER=acontplus
# RABBITMQ_PASSWORD=

# Email Settings (configure if used)
# SMTP_SERVER=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USERNAME=apikey
# SMTP_PASSWORD=
# EMAIL_FROM=noreply@acontplus.com

# AWS/S3 Settings (configure if used)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# S3_BUCKET_NAME=acontplus-production-assets

# Feature Flags
ENABLE_SWAGGER=true
ENABLE_HEALTHCHECKS=true

# Monitoring & APM (configure if used)
# APPLICATION_INSIGHTS_KEY=
# ELASTIC_APM_SERVER_URL=
# ELASTIC_APM_SECRET_TOKEN=
