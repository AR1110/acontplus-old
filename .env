# Development Environment Variables
# This file is used by default when running: docker-compose up
# For other environments, use: docker-compose --env-file .env.staging up

COMPOSE_PROJECT_NAME=acontplus-dev

# Docker Registry (local prefix or remote registry URL)
# Deja vacío en desarrollo para usar el default del compose (acontplus/)
# Solo setéalo si quieres apuntar a un registry remoto
DOCKER_REGISTRY=

# Environment
ASPNETCORE_ENVIRONMENT=Development

# Gateway Port
GATEWAY_PORT=5000

# Logging Configuration
LOG_LEVEL=Information
LOG_PATH=/app/logs/log-.txt
ENABLE_LOCAL_FILE_LOGGING=true

# Service URLs (internal Docker network communication)
SERVICE_URL_IDENTITY=http://identity.api:8080
SERVICE_URL_ACCOUNTING=http://accounting.api:8080
SERVICE_URL_BILLING=http://billing.api:8080
SERVICE_URL_SALES=http://sales.api:8080
SERVICE_URL_INVENTORY=http://inventory.api:8080
SERVICE_URL_PURCHASES=http://purchases.api:8080
SERVICE_URL_COMMON=http://common.api:8080
SERVICE_URL_CONFIGURATION=http://configuration.api:8080
SERVICE_URL_RESTAURANT=http://restaurant.api:8080
SERVICE_URL_MECHANICAL=http://mechanical.api:8080
SERVICE_URL_VET=http://vet.api:8080
SERVICE_URL_BARBERSHOP=http://barbershop.api:8080
SERVICE_URL_TECHSUPPORT=http://technicalsupport.api:8080

# Database Configuration - Development
# Use your local or development database
DB_SERVER=52.15.244.122
DB_PORT=1433
DB_NAME=AcontPlus
DB_USER=sa
DB_PASSWORD=Acontplus2025Dev@!
DB_TRUST_CERT=True
CONNECTION_STRING=Server=${DB_SERVER},${DB_PORT};Database=${DB_NAME};User Id=${DB_USER};Password=${DB_PASSWORD};TrustServerCertificate=${DB_TRUST_CERT};Pooling=true;Max Pool Size=20;Min Pool Size=3;Connection Timeout=30;

