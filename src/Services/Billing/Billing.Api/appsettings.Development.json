{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "JwtSettings": {
    "Audience": ["ocelot.service", "billing.service"]
  },
  "RecaptchaSolver": {
    "Enabled": true,
    "Provider": "2captcha",
    "ApiKey": "3b5e947bc93a929fd6af28fb20ea486b",
    "BaseUrl": "https://2captcha.com/",
    "PollIntervalSeconds": 5,
    "TimeoutSeconds": 120
  },
  "AdvancedLogging": {
    "EnableLocalFile": true,
    "Shared": false,
    "Buffered": true,
    "LocalFilePath": "C:\\Acontplus\\Logs\\Services\\BillingApi\\log-.txt",
    "TimeZoneId": "America/Guayaquil"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "Enrich": ["WithMachineName", "WithEnvironmentUserName", "FromLogContext"],
    "Properties": {
      "Application": "Billing.API"
    }
  },
  "ErrorCleanup": {
    "BatchSize": 500,
    "MaxBatches": 10,
    "Period": 24
  }
}
