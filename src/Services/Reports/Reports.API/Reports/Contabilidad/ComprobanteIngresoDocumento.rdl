  <Code>Dim GroupTotals As New System.Collections.Generic.List(Of Decimal)

Public Function AddGroupTotal(ByVal GroupTotal As Decimal) As Decimal
    GroupTotals.Add(GroupTotal)
    Return GroupTotal
End Function

Public Function GetOverallTotal() As Decimal
    Dim TotalSum As Decimal = 0
    For Each total As Decimal In GroupTotals
        TotalSum += total
    Next
    Return TotalSum
End Function</Code>
