# =============================================================================
# SUPPLIERS
# =============================================================================

### Get All Suppliers
GET {{Purchases.Api_HostAddress}}/api/suppliers
Accept: application/json
Authorization: {{Token}}

### Create Supplier
POST {{Purchases.Api_HostAddress}}/api/suppliers
Content-Type: application/json
Authorization: {{Token}}

{
  "name": "Supplier Name",
  "idCard": "1234567890",
  "email": "supplier@example.com",
  "phone": "0999999999",
  "address": "Supplier Address"
}

### Update Supplier
PUT {{Purchases.Api_HostAddress}}/api/suppliers/1
Content-Type: application/json
Authorization: {{Token}}

{
  "name": "Updated Supplier Name",
  "idCard": "1234567890",
  "email": "supplier@example.com",
  "phone": "0999999999",
  "address": "Updated Address"
}

### Delete Supplier
DELETE {{Purchases.Api_HostAddress}}/api/suppliers/1
Authorization: {{Token}}

