# =============================================================================
# RECEIVED DOCUMENTS
# =============================================================================

### Get All Received Documents
GET {{Purchases.Api_HostAddress}}/api/received-documents?pageNumber=1&pageSize=10
Accept: application/json
Authorization: {{Token}}

### Get Received Document By ID (Anonymous)
GET {{Purchases.Api_HostAddress}}/api/received-documents/1
Accept: application/json

### Preview Received Document (HTML)
GET {{Purchases.Api_HostAddress}}/api/received-documents/preview/1
Accept: text/html
Authorization: {{Token}}

### Download Received Document XML
GET {{Purchases.Api_HostAddress}}/api/received-documents/download/1
Accept: application/xml
Authorization: {{Token}}

### Create Received Document
POST {{Purchases.Api_HostAddress}}/api/received-documents
Content-Type: application/json
Authorization: {{Token}}

{
  "accessKey": "1812202501210030268200120020020000267871190081711",
  "establishmentId": 553,
  "subcategoryId": 110
}

### Read Received Documents File (Upload Text File)
POST {{Purchases.Api_HostAddress}}/api/received-documents/read
Content-Type: multipart/form-data; boundary=----WebKitFormBoundary7MA4YWxkTrZu0gW
Authorization: {{Token}}

------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="file"; filename="documents.txt"
Content-Type: text/plain

Document data here
------WebKitFormBoundary7MA4YWxkTrZu0gW--

### Check Received Document XML Existence
POST {{Purchases.Api_HostAddress}}/api/received-documents/check-existence-xml
Content-Type: application/json
Authorization: {{Token}}

{
  "accessKey": "1234567890123456789012345678901234567890123456789"
}

### Upload Received Document XML
POST {{Purchases.Api_HostAddress}}/api/received-documents/upload-xml
Content-Type: multipart/form-data; boundary=----WebKitFormBoundary7MA4YWxkTrZu0gW
Authorization: {{Token}}

------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="file"; filename="document.xml"
Content-Type: application/xml

<?xml version="1.0" encoding="UTF-8"?>
<document>XML content here</document>
------WebKitFormBoundary7MA4YWxkTrZu0gW--

### Update Received Document
PUT {{Purchases.Api_HostAddress}}/api/received-documents/1
Content-Type: application/json
Authorization: {{Token}}

{
  "documentNumber": "DOC-001-UPD",
  "documentDate": "2025-12-19",
  "supplierId": 1,
  "totalAmount": 600.00
}

### Migrate Received Document
PUT {{Purchases.Api_HostAddress}}/api/received-documents/migrate
Content-Type: application/json
Authorization: {{Token}}

{
  "documentId": 1,
  "newCategoryId": 2
}

### Update Received Document Subcategory
PUT {{Purchases.Api_HostAddress}}/api/received-documents/subcategory/1
Content-Type: application/json
Authorization: {{Token}}

{
  "subcategoryId": 3
}

### Delete Received Document
DELETE {{Purchases.Api_HostAddress}}/api/received-documents/1
Authorization: {{Token}}

