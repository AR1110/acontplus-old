### ========== LOOKUPS ========== ###

# Get Lookups
GET {{Restaurant.Api_HostAddress}}/api/lookups?filters[module]=order&filters[context]=filters
Authorization: {{Token}}

###

# Refresh Lookups Cache
POST {{Restaurant.Api_HostAddress}}/api/lookups/refresh
Authorization: {{Token}}

### ========== CONFIGURATION ========== ###

# Get Configuration
GET {{Restaurant.Api_HostAddress}}/api/configuration?json={}
Authorization: {{Token}}

### ========== STATS ========== ###

# Get Stats
GET {{Restaurant.Api_HostAddress}}/api/stats?json={}
Authorization: {{Token}}

### ========== FLOORS ========== ###

# Get All Floors
GET {{Restaurant.Api_HostAddress}}/api/floor/Get
Authorization: {{Token}}

###

# Get Floors by Establishment
@establecimientoId=396
GET {{Restaurant.Api_HostAddress}}/api/floor/GetByEstab/{{establecimientoId}}
Authorization: {{Token}}

###

# Create Floor
POST {{Restaurant.Api_HostAddress}}/api/floor
Content-Type: application/json
Authorization: {{Token}}

{
  "name": "Main Floor",
  "establecimientoId": 396,
  "isActive": true
}

###

# Update Floor
PUT {{Restaurant.Api_HostAddress}}/api/floor/1
Content-Type: application/json
Authorization: {{Token}}

{
  "id": 1,
  "name": "Updated Floor",
  "establecimientoId": 396,
  "isActive": true
}

###

# Delete Floor
DELETE {{Restaurant.Api_HostAddress}}/api/floor/1
Authorization: {{Token}}

