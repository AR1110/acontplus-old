{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "JwtSettings": {
    "Audience": [
      "ocelot.service",
      "identity.service"
    ],
    "AccessExpiration": 7200,
    "RefreshExpiration": 7,
    "ClockSkew": 5,
    "RequireHttps": true
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug"
    }
  }
}