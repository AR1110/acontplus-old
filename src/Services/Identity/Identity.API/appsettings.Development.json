{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "JwtSettings": {
    "Audience": [ "ocelot.service", "identity.service" ],
    "AccessExpiration": 7200,
    "RefreshExpiration": 7,
    "ClockSkew": 5,
    "RequireHttps": true
  },
  "TokenCleanup": {
    "CheckInterval": "1",
    "BatchSize": "500"
  },
  "AdvancedLogging": {
    "EnableLocalFile": true,
    "Shared": false,
    "Buffered": true,
    "LocalFilePath": "C:\\Acontplus\\Logs\\Services\\IdentityApi\\log-.txt",
    "TimeZoneId": "America/Guayaquil"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "Enrich": [
      "WithMachineName",
      "WithEnvironmentUserName",
      "FromLogContext"
    ],
    "Properties": {
      "Application": "Identity.API"
    }
  }
}

