<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<AssemblyName>Acontplus Print</AssemblyName>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net6.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>disable</Nullable>
		<StartupObject>PrintServer.HttpServer</StartupObject>
		<ApplicationManifest>app.manifest</ApplicationManifest>
	</PropertyGroup>

	<ItemGroup>
		<None Remove="favicon.ico" />
		<None Remove="Reports\AperturaCaja.rdl" />
		<None Remove="Reports\FacturaInyeccion.rdl" />
		<None Remove="Reports\FacturaMatricial.rdl" />
		<None Remove="Reports\FacturaTermica.rdl" />
		<None Remove="Reports\MovimientoCaja.rdl" />
		<None Remove="Reports\NotaEntregaInyeccion.rdl" />
		<None Remove="Reports\NotaEntregaMatricial.rdl" />
		<None Remove="Reports\NotaEntregaTermica.rdl" />
		<None Remove="Reports\Test.rdlc" />
		<None Remove="Reports\TicketTpv.rdl" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="favicon.ico" />
		<Content Include="Reports\AperturaCaja.rdl">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
		<Content Include="Reports\FacturaInyeccion.rdl">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
		<Content Include="Reports\FacturaMatricial.rdl">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
		<Content Include="Reports\FacturaTermica.rdl">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
		<Content Include="Reports\MovimientoCaja.rdl">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
		<Content Include="Reports\NotaEntregaInyeccion.rdl">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
		<Content Include="Reports\NotaEntregaMatricial.rdl">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
		<Content Include="Reports\NotaEntregaTermica.rdl">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
		<Content Include="Reports\Test.rdlc">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
		<Content Include="Reports\TicketTpv.rdl">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\03.business_logic\BL.Print\BL.Print.csproj" />
		<ProjectReference Include="..\..\03.business_logic\BL.Reports\BL.Reports.csproj" />
	</ItemGroup>

	<PropertyGroup>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<ApplicationIcon>favicon.ico</ApplicationIcon>
	</PropertyGroup>
</Project>
