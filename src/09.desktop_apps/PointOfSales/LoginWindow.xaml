<Window x:Class="PointOfSales.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PointOfSales"
        mc:Ignorable="d"
        Title="Login" Height="450" Width="800">
    <Grid>
        <TextBox x:Name="identificacionTxtBox" HorizontalAlignment="Left" Margin="81,58,0,0" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Top" Width="120"/>
        <Label Content="C.I." HorizontalAlignment="Left" Margin="81,32,0,0" VerticalAlignment="Top"/>
        <Label Content="Contraseña:" HorizontalAlignment="Left" Margin="81,94,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="passwordTxtBox" HorizontalAlignment="Left" Margin="81,120,0,0" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Top" Width="120"/>
        <Button Content="Login" HorizontalAlignment="Left" Margin="81,161,0,0" VerticalAlignment="Top" Click="Button_Click" Background="#FFF67C00"/>

    </Grid>
</Window>
