
@{
    ViewData["Title"] = "Index";
}
<div ng-controller="tarifaCtrl" ng-cloak>
    <div class="row page-titles">
        <div class="col-md-5 align-self-center">
            <h4 class="text-themecolor">Gestión de Tarifas</h4>
        </div>
        <div class="col-md-7 align-self-center text-right">
            <div class="d-flex justify-content-end align-items-center">
                @*<ol class="breadcrumb">
                        <li class="breadcrumb-item"><a href="javascript:void(0)">Inicio</a></li>
                        <li class="breadcrumb-item active">Tarifa</li>
                    </ol>*@
                
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <div class="row">
                        <div class="col-lg-9 col-md-9 col-sm-6 col-xs-6">
                           
                        </div>
                        <div class="col-lg-3 col-md-3 col-sm-6 col-xs-6">
                            <input type="text" class="form-control" ng-model="buscar" placeholder="Buscar Tarifa" />
                        </div>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-condensed ">
                            <thead>
                                <tr class="text-center">
                                    <th ng-if="accion.editar">Op.</th>
                                    <th>N°</th>
                                    <th>Código</th>
                                    <th>Descripcion</th>
                                    <th>Predeterminado</th>
                                    <th>Estado</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="t in tarifas | filter:buscar track by $index" class="text-center">
                                    <td ng-if="accion.editar">
                                        <button type="button" ng-if="accion.editar" class="btn btn-info btn-xs" tooltip data-toggle="toggle" title="Editar" ng-click="abrirModal(t,2)"><i class="ti-pencil"></i></button>                                        
                                    </td>                                    
                                    <td>{{$index+1}}</td>
                                    <td>{{t.codigo}}</td>
                                    <td>{{t.descripcion}}</td>
                                    <td ng-bind-html="t.predeterminada|sino"></td>
                                    <td ng-bind-html="t.estado | estadoPrimario"></td>
                                </tr>
                                <tr class="text-center" ng-show="tarifas.length==0">
                                    <td colspan="6">
                                        No existen registros disponibles en esta tabla;
                                    </td>
                                </tr>
                            </tbody>                           
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="modal fade" id="agregar" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel1" data-backdrop="static" data-keyboard="false">
        <div class="modal-dialog modal-sm" role="document">
            <form ng-submit="saveUpdate(type)" class="form-material" autocomplete="off" novalidate>
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">{{tituloModal}}</h5>
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                    <div class="modal-body">
                        <div class="row">
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                <div class="form-group">
                                    <label class="form-control-label" for="descripcion">Descripcion <span class="text-danger">*</span></label>
                                    <input type="text" ng-model="data.descripcion" touppercase class="form-control form-control-line" placeholder="Ej: Contado">
                                </div>                                
                                @*<div class="icheck-primary icheck-inline">
                                        <input type="checkbox" id="chb1" />
                                        <label for="chb1">Predeterminado</label>
                                    </div>*@
                            </div>

                        </div>
                        <div class="row">
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                <div class="form-group">
                                    <label class="form-control-label" for="descripcion">Codigo: </label>
                                    <input type="text" ng-model="data.codigo" class="form-control" touppercase placeholder="Ej: CON">
                                </div>
                            </div>
                        </div>
                        <br />
                        <div class="row" ng-show="type==2">
                            <div class="col-lg-6 col-md-6 col-sm-6 col-xs-6">
                                <div class="icheck-primary">
                                    <input type="radio" ng-model="data.estado" ng-value="true" id="someRadioId1" name="someGroupName" />
                                    <label for="someRadioId1">Activo</label>
                                </div>
                            </div>
                            <div class="col-6 col-md-6 col-sm-6 col-xs-6 text-right">
                                <div class="icheck-primary">
                                    <input type="radio" ng-model="data.estado" ng-value="false" id="someRadioId2" name="someGroupName" />
                                    <label for="someRadioId2">Inactivo</label>
                                </div>
                            </div>
                        </div>

                    </div>
                    <div class="modal-footer">
                        <button type="submit" class="btn btn-success"><i class="{{icono}}"></i> {{btnModal}}</button>
                        <button type="button" class="btn btn-dark" data-dismiss="modal"> &times; Cerrar</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
@section Scripts{
    <script src="~/js/controllers/almacen/tarifaCtrl.min.js" asp-append-version="true"></script>

}

