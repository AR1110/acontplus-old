

@{
    ViewData["Title"] = "Index";
}
<div ng-controller="familiaCtrl">
    <div ng-if="accion.leer">    
        <div class="row page-titles">
            <div class="col-md-5 align-self-center">
                <h4>Gestión de Familias</h4>
            </div>
            <div class="col-md-7 align-self-center text-right">
                <div class="d-flex justify-content-end align-items-center">
                    @*<ol class="breadcrumb">
                            <li class="breadcrumb-item"><a href="javascript:void(0)">Inicio</a></li>
                            <li class="breadcrumb-item active">Familias</li>
                        </ol>*@
                    <button type="button" ng-if="accion.crear" ng-click="openModal()" class="btn btn-info m-l-15">
                        <i class="ti-plus"></i> Nuevo
                    </button>                  
                </div>
            </div>
        </div>
        
        <div class="row">
            <div class="col-lg-12">
                <div class="card">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-lg-9">
                                <span class="form-group pull-left page-size form-inline">
                                    <select class="form-control control-color"
                                            ng-model="dataSearch.pageSize"
                                            ng-change="changePageSize()"
                                            ng-options="ra for ra in recordsQuantity">
                                    </select>
                                </span>
                            </div>
                            <div class="col-lg-3">
                                <form class="form-material">
                                    <input type="text" class="form-control border-color" ng-keyup="onKeyupSearch()" ng-model="dataSearch.bySearch" placeholder="Buscar Familia" />
                                </form>
                            </div>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-bordered">
                                <thead>
                                    <tr>                            
                                        <th ng-if="accion.editar || accion.eliminar">Op</th>                           
                                        <th>N°</th>                            
                                        <th>Código</th>
                                        <th>Descripción</th>                                        
                                        <th>Estado</th> 
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr ng-repeat="item in familias">                           
                                        <td ng-if="accion.editar || accion.eliminar">
                                            <button type="button" class="btn btn-info btn-xs"  ng-if="accion.editar" ng-click="openModal(item)">
                                                <i class="ti-pencil"></i>
                                            </button>
                                            <button type="button" class="btn btn-danger btn-xs" ng-if="accion.eliminar" ng-click="delete(item)">
                                                <i class="ti-trash"></i>
                                            </button>                                                                                
                                        </td>
                                        <td>{{$index+1}}</td>                            
                                        <td>{{item.siglas}}</td>
                                        <td>{{item.descripcion}}</td>                                        
                                        <td ng-bind-html="item.estado|estadoPrimario"></td>    
                                    </tr>
                                    <tr class="text-center" ng-if="familias.length===0">
                                        <td colspan="5">No hay regsitros en esta tabla</td>
                                    </tr>
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <td align="center" colspan="8">
                                            <div class="pull-left">
                                                <ul uib-pagination total-items="totalRecords" items-Per-Page="dataSearch.pageSize" ng-change="pagechanged()" ng-model="dataSearch.pageIndex" max-size="maxSize" class="pagination" boundary-links="true" rotate="false"></ul>
                                            </div>
                                        </td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
               
    </div>
    <partial name="PageNotAccessible"/>
</div>
@section Scripts{
    <script src="~/js/controllers/almacen/familiaCtrl.min.js" asp-append-version="true"></script>    
}