 <div class="row">
    <div class="col-xl-6 col-lg-6 col-md-6 col-sm-12 col-xs-12">
        <div class="form-group">
            <label for="establecimiento">Estab.: <span class="text-danger">*</span></label>
            <select name="establecimiento" id="establecimiento" class="form-control border-select" ng-model="codEstab" ng-change="onChangeEstablecimiento()">
                <option ng-value="item.codEstab" ng-repeat="item in establecimientos">
                    {{item.nombreComercial}}
                </option>
            </select>
        </div>                                                
    </div>
    <div class="col-xl-6 col-lg-6 col-md-6 col-sm-12 col-xs-12">
        <div class="form-group">
            <h6>Proveedor</h6>
            <input type="text" uib-typeahead="ss as ss.proveedor.nombreFiscal for ss in searchSupplier($viewValue)" 
            class="form-control border-select" 
            name="autocompleteSupplier"
            autocomplete="off"
            ng-model="selectedSupplier"
            typeahead-editable="false"
            typeahead-loading="data.loadingLocations" 
            typeahead-no-results="data.noResults"
            typeahead-template-url="autocompleteSupplier.html"
            ng-keyup="onKeyupSearchSupplier()"
            typeahead-on-select="selectedSupplierChange($item)"
            placeholder="Ingrese C.I o nombre Comercial">
            <script type="text/ng-template" id="autocompleteSupplier.html">
                <div class="autocomplete-suggestion-cliente">
                    <span class="item-title">
                        {{match.model.proveedor.nombreFiscal}}<br/>
                        <span>{{match.model.proveedor.numeroIdentificacion}}</span>
                    </span>
                </div>
            </script>
            <small class="text-danger" ng-show="data.noResults">No se encontró ningún resultado.</small>
        </div>
    </div>
</div>


<div ng-show="listDocuments.length>0">
    <md-table-container style="max-height: 400px;" >
        <table md-table md-row-select="options.rowSelection" multiple="{{options.multiSelect}}" ng-model="selectedDocs" >
            <thead fix-head md-head md-order="query.order" md-on-reorder="logOrder">
                <tr md-row>
                    <th md-column ><span>N°. Doc</span></th>
                    <th md-column><span>T. Doc</span></th>
                    <th md-column><span>F. Emisión</span></th>
                    <th md-column><span>F. Vcto</span></th>
                    <th md-column><span>Total</span></th>
                    <th md-column><span>Abono</span></th>
                    <th md-column><span>Saldo</span></th>
                    <th md-column><span>Estado</span></th>                        
                </tr>
            </thead>
            <tbody md-body class="text-center">
                <tr md-row md-select="ld" md-on-select="getCuota" 
                    md-auto-select="options.autoSelect" style="cursor: pointer;"                 
                    ng-repeat="ld in listDocuments | filter: filter.search" >
                    <td md-cell>{{ld.nroDocumento}}</td>                
                    <td md-cell>{{ld.tipoDocumento}}</td>
                    <td md-cell>{{ld.fechaEmision}}</td>
                    <td md-cell>{{ld.fechaVencimiento}}</td>
                    <td md-cell>$ {{ld.total | number: 2}}</td>
                    <td md-cell>$ {{ld.abono|number: 2 }}</td>
                    <td md-cell>${{ld.saldo|number: 2}}</td>           
                    <td md-cell ng-style="{'background':ld.codigoColor, 'color':'white', 'text-align':'center'}">{{ld.estadoFinanciero}}</td>           
                </tr>
            
            </tbody>
        </table>
    </md-table-container> 
</div>
