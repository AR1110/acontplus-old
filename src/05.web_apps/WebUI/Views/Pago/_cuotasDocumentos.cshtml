<div class="row">
    <div class="col-lg-10 col-md-8 col-sm-8 col-xs-12">
        <div class="row">
            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                <div class="row">
                    <div class="col-6 mt-4 mb-2">
                        <h5 class="card-title">Cuotas a Pagar </h5>                                        
                    </div>
                    <div class="col-6 align-self-center display-6 text-right">
                        <button class="btn btn-outline-success" ng-click="newPayMoney()"><i class="far fa-money-bill-alt"></i> Nuevo Pago</button>
                    </div>                
                </div>                
                <div class="card border border">                      
                    <div class="table-responsive">
                        <table class="table table-condensed text-center table-sm" width="100%">
                            <thead>
                                <tr> 
                                    <th></th>
                                    <th>N°</th>
                                    <th>T. Doc</th>
                                    <th>N°. Doc</th>
                                    <th>F. Emision</th>
                                    <th>Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat-start="sd in selectedDocs" ng-click="displayCuota(sd)" class="table-success" style="cursor: pointer;">
                                    <td>
                                        <span ng-if="sd.display"><i class="fas fa-caret-square-down"></i></span>
                                        <span ng-if="!sd.display"><i class="fas fa-caret-square-right"></i></span>
                                    </td>
                                    <td>{{$index+1}}</td>
                                    <td>{{sd.nroDocumento}}</td>
                                    <td>{{sd.tipoDocumento}}</td>
                                    <td>{{sd.fechaEmision}}</td>
                                    <td>{{sd.total|currency:'$'}}</td> 
                                </tr>    
                                 <tr ng-show="sd.display" ng-repeat-end="">
                                    <td colspan="6">
                                        <div class="justify-content-center mr-3 ml-3">
                                            <div class="table-responsive">
                                                <table class="tabla-cuota table table-no-bordered text-center" width="100%">
                                                    <thead>
                                                        <tr>
                                                            <th>N°.</th>
                                                            <th>Cuota</th>
                                                            <th>Abono</th>
                                                            <th>Abono Pos</th>
                                                            <th>Saldo</th>
                                                            <th>Mora</th>
                                                            <th>T. Interes</th>
                                                            <th>F. Vcto</th>
                                                            <th>Estado</th>
                                                            <th></th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        <tr ng-repeat="c in sd.cuotas">
                                                            <td style="min-width: 10px;">{{c.nroCuota}}</td>
                                                            <td style="min-width: 10px;" class="txt-oflo">{{c.cxp.cuota|currency:'$'}}</td>
                                                            <td style="min-width: 10px;" class="text-muted">{{c.abono|currency:'$' }}</td>
                                                            <td style="min-width: 10px;">{{c.abonoPosfechado|currency:'$'}}</td>
                                                            <td style="min-width: 10px;">{{c.saldo |currency:'$' }}</td>
                                                            <td style="min-width: 10px;">{{c.diasMoraView}}</td>
                                                            <td style="min-width: 10px;">{{c.totalMasInteres|currency:'$'}}</td>
                                                            <td style="min-width: 10px;">{{c.cxp.fechaVencimiento}}</td>
                                                            <td style="min-width: 15px; width:15px;align:center;">
                                                                <span ng-class="{'badge badge-success badge-pill':c.cxp.cuota===(c.abono+c.abonoPosfechado), 'badge badge-danger badge-pill':c.cxp.cuota===c.saldo, 'badge badge-info badge-pill':c.saldo>0}"> {{estadoAbonoCuota(c)}}</span>                                                            
                                                            </td>
                                                            <td style="min-width: 10px;">                                                                
                                                                <a uib-popover-template="'viewPopoverAbonoCuota.html'" ng-show="(c.abono>0||c.abonoPosfechado>0) && c.cuotaAfectado" popover-trigger="'outsideClick'" popover-placement="top" href="javascript:void(0)" class="text-dark ">
                                                                    <i ng-click="viewCuotaPago(c)" class="ti-eye"></i>
                                                                </a>
                                                            </td>
                                                        </tr>
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                    </td>
                                </tr>                                                                       
                            </tbody>
                        </table>
                    </div>                    
                </div>
            </div>
            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                <h5 class="card-title">Datos de Pago </h5>    
                <div class="card border border">                                      
                    <div class="table-responsive">
                        <table class="table table-condensed table-sm">
                            <thead>
                                <tr>
                                    <th>N°</th>
                                    <th>Fecha Emisión</th>
                                    <th>Sub Entidad</th>
                                    <th>Valor</th>
                                    <th>Número</th>
                                    <th>Op</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="p in listaPagos">
                                    <td>{{$index+1}}</td>
                                    <td>{{p.fechaEmision|date:'MM/dd/yyyy  h:mma'}}</td>
                                    <td><sup>{{p.posFechado?'*':''}}</sup> <span>{{p.subEntidad}}</span></td>                                    
                                    <td>{{p.valor|currency:'$'}}</td>
                                    <td>{{p.nro}}</td>
                                    <td>
                                        <button class="btn btn-danger btn-sm" ng-click="validateDeletePagoCuota(p)"><i class="ti-trash"></i></button>
                                    </td>

                                </tr>
                                <tr ng-show="listaPagos.length==0" class="text-center">
                                    <td colspan="6">No hay datos</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-2 col-md-4 col-sm-4 col-xs-12">
        <div class="mt-4">
            <div ng-include src="'asideSubTotalPago'"></div>
        </div>        
    </div>
</div>
