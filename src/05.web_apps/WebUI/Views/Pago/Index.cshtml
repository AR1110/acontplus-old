@{
    ViewData["title"]="Pagos";
}

<style> 
     .modal-full-screen-width {
        width: 95%;
        max-width: none; 
        height: 90%;         
    } 
  
    .typeahead-group-header {
        padding: 3px 20px;
        border-bottom: 1px solid black;
        font-weight: bold;
    }
</style>


<div ng-controller="pagoCtrl">
    <div class="row page-titles">
        <div class="col-md-5 align-self-center">
            <h4 class="text-themecolor">Gestión de Egresos</h4>
        </div>
        <div class="col-md-7 align-self-center text-right">
            <div class="d-flex justify-content-end align-items-center">
                @* <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="javascript:void(0)">Inicio</a></li>
                    <li class="breadcrumb-item"><a href="javascript:void(0)">Tesorería</a></li>
                    <li class="breadcrumb-item active">Pagos</li>
                </ol> *@
                <button type="button" class="btn btn-info m-l-15" ng-if="accion.crear" ng-click="newPayment()"><i class="fa fa-plus-circle"></i> Nuevo</button>
            </div>
        </div>
    </div>

    @await Html.PartialAsync("_ModalPagoFiltro.cshtml")

    <div class="row">
        <div class="col-lg-12 col-md-12">                       
            <md-card>
                <md-toolbar class="md-table-toolbar md-default _md _md-toolbar-transitions">
                    <div class="md-toolbar-tools">
                        <div class="col-lg-9 col-md-9 col-sm-1">
                            <button type="button" class="btn btn-info" ng-click="openModalPagoFiltro()"><i class="fas fa-filter"></i> Filtro</button>
                        </div>
                        <div class="col-lg-3 col-md-3 col-sm-12 col-xs-12">
                            <form class="form-material">
                                <input type="text" class="form-control" ng-model="buscar" placeholder="Buscar Pagos">
                            </form>
                        </div>
                    </div>
                </md-toolbar>                  
                <md-table-container style="max-height: 400px;">
                    <table md-table>
                        <thead fix-head md-head md-order="options.order"  md-on-reorder="pagos">
                            <tr md-row>
                                <th md-column ng-if="accion.historialFinanciero || accion.eliminar || accion.reporte">Op.</th> 
                                <th md-column>N°</th>
                                <th md-column >N°. Doc. </th>
                                <th md-column>F. Emision</th>                                
                                <th md-column >Proveedor</th>
                                <th md-column >Total</th>
                                <th md-column>Estado</th>
                                <th md-column>Usuario</th>
                            </tr>
                        </thead>
                        <tbody md-body>
                            <tr md-row ng-repeat="p in pagos | filter: buscar  | orderBy: options.order" ng-class="p.color">
                                <td md-cell ng-if="accion.historialFinanciero || accion.eliminar || accion.reporte">
                                    <div class="dropdown h-2">
                                        <button class="btn btn-default " type="button" id="dropdownMenu" data-toggle="dropdown" data-boundary="viewport" aria-haspopup="true" aria-expanded="false">
                                        <i class="fa fa-bars"></i>
                                        </button>
                                        <div class="dropdown-menu"  aria-labelledby="dropdownMenu">
                                        <button class="dropdown-item" type="button" ng-if="accion.historialFinanciero" ng-click="openModalHistorialPago(p)"><i class="ti-menu"></i> Detalle</button>
                                        <button class="dropdown-item" type="button" ng-if="accion.eliminar"  ng-click="deletePayment(p)">&times; Anular</button>                            
                                        <button class="dropdown-item" type="button" ng-if="accion.reporte" ng-click="getReport(p)"><i class="ti-file"></i> PDF</button>                                            
                                        </div>
                                    </div>                                                     
                                </td>
                                <td md-cell>{{$index+1}}</td>
                                <td md-cell>{{p.nroDoc}}</td>
                                <td md-cell>{{p.fechaRegistro}}</td>                                
                                <td md-cell>{{p.persona|uppercase}}</td>
                                <td md-cell>${{p.total}}</td>
                                <td md-cell>{{p.estado}}</td>
                                <td md-cell>{{p.usuario}}</td>
                            </tr>
                            <tr ng-if="pagos.length===0" class="text-center">
                               <td colspan="9">No hay registro en esta tabla.</td> 
                            </tr>                            
                        </tbody>
                        <tfoot>
                            <tr>
                                <td></td>
                            </tr>
                        </tfoot>
                    </table>
                </md-table-container>                   
            </md-card>
                                           
        </div>
    </div>    

    <!--Modal Payment-->
    <partial name="_modalPayment"></partial> 
    <partial name="_modalPayMoney"></partial>

  
</div>
@section Scripts{ 
    <script src="~/js/controllers/financiera/pagoCtrl.js" asp-append-version="true"></script>
    <script type="text/ng-template" id="asideSubTotalPago">
        <div class="table-responsive">
            <table class="table table-clear table-sm">                
                <tbody>
                    <tr>
                        <td class="left"><h4><strong>Total</strong></h4></td>
                        <td class="right"><h4>{{pago.total|currency:'$'}}</h4></td>
                    </tr>
                     <tr ng-show="pago.totalAbonoAnterior>0">
                        <td class="left"><strong>Abono Anterior</strong></td>
                        <td class="right"><span class="badge badge-danger">{{pago.totalAbonoAnterior|currency:'$'}}</span></td>
                    </tr>

                    
                    <tr>
                        <td class="left"><strong>Abono</strong></td>
                        <td class="right">{{pago.abono - pago.abonoPosfechado|currency:'$'}}</td>
                    </tr>
                    <tr>
                        <td class="left"><strong>Abono Posf.</strong></td>
                        <td class="right">{{pago.abonoPosfechado|currency:'$'}}</td>
                    </tr>
                    <tr>
                        <td class="left"><strong>Total Abono</strong></td>
                        <td class="right"><strong>{{pago.totalPago | currency:'$'}}</strong></td>
                    </tr>
                    <tr>
                        <td class="left"><strong>Saldo</strong></td>
                        <td class="right"><strong>{{pago.saldo|currency:'$'}}</strong></td>
                    </tr>
                    <tr>
                        <td class="left"><h4 class="text-danger">Cambio</h4></td>
                        <td class="right"><h4 class="text-danger">{{pago.valorCambio}}</h4></td>
                    </tr>
                </tbody>
            </table> 
        </div>    
    </script>
   
    <script type="text/ng-template" id="viewPopoverAbonoCuota.html">
        <div class="table-responsive">
            <table class="table table-no-bordered  text-center">
                <thead>
                    <tr>
                        <th>Cuota</th>
                        <th>Abono</th>
                        <th>Saldo</th>
                        <th>PosF.</th>
                    </tr>
                </thead>
                <tbody>
                    <tr ng-repeat="c in viewCuotaAbonos" class="text-muted">
                        <td>{{c.cuota|currency:'$'}}</td>
                        <td>{{c.detalle.abono|currency:'$'}}</td>
                        <td>{{c.saldo|currency:'$'}}</td>
                        <td>{{c.isPosfechado?'SI':'NO'}}</td>
                    </tr>

                </tbody>
            </table>
        </div>
    </script>
}

