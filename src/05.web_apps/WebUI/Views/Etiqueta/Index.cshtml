@{
    ViewData["title"] = "Etiqueta";
}

<div ng-controller="etiquetaCtrl">

        <div class="row page-titles">
            <div class="col-md-5 align-self-center">
                <h4 class="text-themecolor">Gestión de Etiquetas</h4>
            </div>
            <div class="col-md-7 align-self-center text-right">
                <div class="d-flex justify-content-end align-items-center">
                @* <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a href="/Home/Index">Inicio</a></li>
                        <li class="breadcrumb-item"><a href="javascript:void(0)">Administración</a></li>
                        <li class="breadcrumb-item active">Etiquetas</li>
                    </ol> *@
                    <button type="button" class="btn btn-info m-l-15" ng-if="accion.crear" ng-click="openModalNew()"><i class="fa fa-plus-circle"></i> Nuevo</button> 
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th ng-if="accion.editar || accion.eliminar || accion.acceso">Op.</th>
                                        <th>N°</th>
                                        <th>Descripción</th>
                                        <th>Etiquetas</th>
                                        <th>Estado</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr ng-repeat="item in etiquetas">
                                        <td ng-if="accion.editar || accion.eliminar || accion.acceso">                                        
                                                <button class="btn btn-info btn-sm" ng-if="accion.editar" ng-click="openModalEdit(item)">
                                                    <i class="mdi mdi-pencil"></i>
                                                </button>
                                                <button class="btn btn-danger btn-sm" ng-if="accion.eliminar" ng-click="onDelete(item)">
                                                    <i class="mdi mdi-delete"></i>
                                                </button>                                                                     
                                            </td>
                                        <td>{{$index+1}}</td>
                                        <td>{{item.descripcion}}</td>
                                        <td>{{item.etiquetas}}</td>
                                        <td ng-bind-html="item.estado | estadoPrimario"></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
</div>

@section Scripts{
                                                            <script src="~/js/inventario/services/etiquetaService.min.js" asp-append-version="true"></script>
                                                            <script src="~/js/inventario/controllers/etiquetaCtrl.min.js" asp-append-version="true"></script>
}
