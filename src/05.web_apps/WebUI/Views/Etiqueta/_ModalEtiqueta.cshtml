<div class="modal-header">
    <h5 class="modal-title">Etiquetas</h5>
    <button ng-click="$ctrl.closeModal()" class="close">&times;</button>
</div>

<div class="modal-body">
    <h5><span class="text-muted">Actividad:</span> {{$ctrl.data.descripcion}}</h5>

    <div class="grid" ui-grid="$ctrl.gridOptions"  ui-grid-edit
                            ui-grid-resize-columns
                            ui-grid-cellNav
                            ui-grid-auto-resize>
                    </div>  
</div>

<div class="modal-footer">
     <button type="button" ng-click="$ctrl.saveUpdateEtiqueta()"  class="btn btn-success">
        <i class="ti-save"></i> 
        Guardar
    </button>
    <button type="button" ng-click="$ctrl.closeModal()" class="btn btn-dark">&times; Cerrar</button>
</div>