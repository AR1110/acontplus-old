<form autocomplete="off" ng-submit="save();">
    <div class="modal-header">
        <h5 class="modal-title"><i class="fa fa-tags"></i> {{modalTitle}} Etiqueta</h5>
        <button type="button" ng-click="closeModal()" class="close">&times;</button>
    </div>

    <div class="modal-body">
        <div class="row">
            <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">
                <div class="form-group">
                    <label for="description">Descripción <span class="text-danger">*</span></label>
                    <input type="text" ng-model="data.descripcion" touppercase class="form-control border-select"
                        placeholder="Cel.">
                </div>
            </div>

            <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">
                <div class="table-responsive">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>N°</th>
                                <th>Código</th>
                                <th>Descripción</th>
                                <th>
                                    <button type="button" class="btn btn-secondary btn-sm" ng-click="addRow()">
                                        <i class="ti-plus"></i>
                                    </button>
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="item in etiquetas">
                                <td>{{$index+1}}</td>
                                <td>
                                    <div ng-if="isNew">
                                        <input type="text" ng-model="item.codigo" class="form-control border-select"
                                            touppercase>
                                    </div>
                                    <div ng-if="!isNew">
                                        {{item.codigo}}
                                    </div>
                                </td>
                                <td>
                                    <input type="text" ng-model="item.descripcion" class="form-control border-select"
                                        touppercase>
                                </td>
                                <td>
                                    <button type="button" class="btn btn-danger btn-sm" ng-click="removeRow(item)">
                                        <i class="ti-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                @* <div class="form-group">
                <label for="etiquetas">Etiquetas <span class="text-danger"></span></label>
                <md-chips id="etiquetas" ng-model="dataLabel.etiquetas" readonly="dataLabel.readonly"
                md-enable-chip-edit="dataLabel.edit" input-aria-label="Nombre de las Etiquetas"
                placeholder="Ej. SERIE" ng-change="onChipSelect($chip)" md-on-remove="onChipRemove($chip, $index)">
                </md-chips>


                </div> *@
            </div>

            <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12" ng-if="data.idEtiqueta>0 && showEstado">
                <div class="form-group">
                    <label for="estado">Estado</label>
                    <md-switch ng-model="data.estado" aria-label="Estado" ng-true-value="true" ng-false-value="false"
                        class="md-warn">
                        {{ data.estado?'Activo':'Inactivo'}}
                    </md-switch>
                </div>
            </div>

        </div>

        @* <div class="grid" ui-grid="gridOptions" ui-grid-edit ui-grid-resize-columns ui-grid-cellNav
        ui-grid-auto-resize>
        </div> *@
    </div>

    <div class="modal-footer">
        <button type="submit" class="btn btn-success">
            <i ng-class="iconSave"></i>
            {{txtSave}}
        </button>
        <button type="button" ng-click="closeModal()" class="btn btn-dark">&times; Cerrar</button>
    </div>
</form>