

<div class="modal-header">
    <h5 class="modal-title">Busqueda Avanzada</h5>
    <button class="close" ng-click="$ctrl.closeModal()">&times;</button>
</div>

<div class="modal-body">
    <div class="row justify-content-between">        
        <div class="col-lg-3 col-md-3 col-sm-3 col-xs-3">
            <div class="icheck-info">
                <input type="checkbox" id="checkboxClienteFilter" ng-model="$ctrl.dataSearch.checkBoxCliente">
                <label for="checkboxClienteFilter">Cliente</label>
            </div>                        
        </div>

        <div class="col-lg-3 col-md-3 col-sm-3 col-xs-3">
            <div class="icheck-info">
                <input type="checkbox"  ng-model="$ctrl.dataSearch.checkBoxFecha" ng-change="$ctrl.onChangeFechaFiltro()" id="checkboxFechaFilter">
                <label for="checkboxFechaFilter">Fecha</label>
            </div> 
        </div>

        <div class="col-lg-3 col-md-3 col-sm-3 col-xs-3">
            <div class="icheck-info">
                <input type="checkbox" ng-model="$ctrl.dataSearch.checkBoxUsuario" id="checkboxUsuarioFilter">
                <label for="checkboxUsuarioFilter">Usuario</label>
            </div>                          
        </div>

        <div class="col-lg-3 col-md-3 col-sm-3 col-xs-3">
            <div class="icheck-info">
                <input type="checkbox"  ng-model="$ctrl.dataSearch.checkBoxEstado" id="checkboxEstadoFilter">
                <label for="checkboxEstadoFilter">Estado</label>
            </div> 
        </div>                    
    </div>               
    <hr>

    <div class="row">
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12">           
            <div class="form-group">
                <label for="sucursalFilter">Sucursal</label>
                <select class="form-control border-select" ng-model="$ctrl.dataSearch.codEstab">
                    <option ng-value="item.codEstab" ng-repeat="item in $ctrl.establecimientos">{{item.nombreComercial}}</option>
                </select>
            </div> 
        </div>
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12" ng-if="$ctrl.dataSearch.checkBoxCliente">
            <div class="form-group">
                <label for="clienteFiltro">Cliente</label>
                @await Html.PartialAsync("~/Views/Cliente/_UibModalClienteSearchFilter.cshtml") 
            </div>                                 
        </div>
    </div>

    <div class="row" ng-if="$ctrl.dataSearch.checkBoxFecha">             
        
        <div class="col-xl-3 col-lg-3 col-md-3 col-sm-12 col-12">
            <div class="form-group">
                <label class="control-label">Mes: </label>
                <select ng-model="$ctrl.mes" class="form-control" ng-change="$ctrl.getFechaInicioFinFilter($ctrl.mes)">
                    <option ng-value="item.numero" ng-repeat="item in $ctrl.meses">{{item.nombre}}</option>
                </select>
            </div>
        </div>

        <div class="col-xl-3 col-lg-3 col-md-3 col-sm-12 col-12">
            <div class="form-group">
                <label>Fecha Inicio:</label>
                <input type="date" class="form-control" ng-model="$ctrl.dataSearch.fechaInicio"/>
            </div>
        </div>

        <div class="col-xl-3 col-lg-3 col-md-3 col-sm-12 col-12">
            <div class="form-group">
                <label>Fecha Fin:</label>
                <input type="date" class="form-control" ng-model="$ctrl.dataSearch.fechaFin" />
            </div>
        </div>

        <div class="col-xl-3 col-lg-3 col-md-3 col-sm-12 col-12">
            <div class="form-group">
                <label for="">Tipo Fecha</label>
                <div class="icheck-info">
                    <input type="radio" ng-model="$ctrl.dataSearch.tipoFecha" value="FE" id="tipoFechaEmision" name="tipoFecha">
                    <label for="tipoFechaEmision"> Fecha Emisión</label>
                </div>
                <div class="icheck-info">
                    <input type="radio" ng-model="$ctrl.dataSearch.tipoFecha" value="FV" id="tipoFechaVencimiento" name="tipoFecha">
                    <label for="tipoFechaVencimiento"> Fecha Vencimiento</label>
                </div>
            </div>
        </div>                                                                                               
    </div>

    <div class="row">                    

        <div class="col-xl-6 col-lg-6 col-md-6 col-sm-6 col-12" ng-show="$ctrl.dataSearch.checkBoxUsuario">
            <div class="form-group">
                <label>Usuario:</label>
                @await Html.PartialAsync("~/Views/Usuario/_UibModalUsuarioSearchFiltro.cshtml")                            
            </div>
        </div>

        <div class="col-xl-6 col-lg-6 col-md-6 col-sm-6 col-12" ng-show="$ctrl.dataSearch.checkBoxEstado">
            <div class="form-group">
                <label>Estado:</label>
                <select id="idEstadoPago" class="form-control" ng-model="$ctrl.dataSearch.byEstado">
                    <option ng-value="item.idEstadoPago" ng-repeat="item in $ctrl.estadoDocumentos">
                        {{item.descripcion}}
                    </option>
                </select>
            </div>
        </div>                    
    </div>  
</div>

<div class="modal-footer">
    <button class="btn btn-success" ng-click="$ctrl.getSearch()()"><i class="fa fa-search"></i> Buscar</button>
    <button type="button" class="btn btn-dark" ng-click="$ctrl.closeModal()">&times; Cerrar</button>
</div>
       