@{
    ViewData["title"] = "Nota de Entrega";
}

<div ng-controller="notaEntregaCtrl">
    <div class="row page-titles">
        <div class="col-md-5 align-self-center">
            <h5 class="text-themecolor">Gestión de Nota de Entrega</h5>
        </div>
        <div class="col-md-7 align-self-center text-right">
            <div class="d-flex justify-content-end align-items-center">
                <button class="btn btn-info m-l-15" ng-show="accion.crear" id="btnNewDocument"
                    ng-click="openModalNew()"><i class="fa fa-plus-circle"></i> Nuevo</button>
            </div>
        </div>
    </div>



    <div class="card">
        <div class="card-body">
            <div class="row">
                <div class="col-xl-3 col-lg-3 col-md-6 col-sm-12 col-12">
                    <div class="form-gorup">
                        <span for="establecimiento">Establecimiento</span>
                        <select name="establecimiento" id="establecimiento" ng-model="dataSearch.codEstab"
                            class="form-control  border-select" ng-change="getNotaEntregas()">
                            <option ng-value="item.codEstab" ng-repeat="item in establecimientos">
                                {{item.nombreComercial}}
                            </option>
                        </select>
                    </div>
                </div>
                <div class="col-xl-4 col-lg-4 col-md-6 col-sm-12 col-12">
                    <div class="form-group">
                        <span for="">Rango de Fechas</span>
                        @* <div class="input-group"> *@
                        <date-range-filter current-date="dataSearch.fechaInicio" start-date="dataSearch.fechaInicio"
                            end-date="dataSearch.fechaFin"
                            result-range-date="resultRangeFilter(result)"></date-range-filter>
                        @* <div class="input-group-append">
                        <div class="btn-group" data-toggle="buttons" role="group">
                        <label class="btn btn-outline btn-info">
                        <div class="custom-control custom-radio">
                        <input type="radio" id="customRadio1" name="options" value="male"
                        class="custom-control-input">
                        <label class="custom-control-label" for="customRadio1"> <i
                        class="ti-check text-active" aria-hidden="true"></i></label>
                        </div>
                        </label>
                        <label class="btn btn-outline btn-info active">
                        <div class="custom-control custom-radio">
                        <input type="radio" id="customRadio2" name="options" value="female"
                        class="custom-control-input">
                        <label class="custom-control-label" for="customRadio2"> <i
                        class="ti-check text-active" aria-hidden="true"></i></label>
                        </div>
                        </label>
                        </div>
                        </div>
                        </div> *@
                    </div>
                </div>
                <div class="col-xl-3 col-lg-3 col-md-6 col-sm-12 col-12">
                    <div class="form-group">
                        <span for="clienteFiltro">Cliente</span>
                        <input type="text" id="customerInputSearch" class="form-control border-select"
                            ng-model="cliente.nombreCliente" cliente-search-drtv on-select="onSelectCliente(result)"
                            on-keyup-cliente="onKeyupCliente()" placeholder="Ingrese C.I o Nombre Comercial"
                            onclick="select();">

                        <script type="text/ng-template" id="autocompleteClienteTemplate.html">
                            <div class="autocomplete-suggestion-uib-typeahead">
                                <span class="item-title"><b> {{match.model.numeroIdentificacion}}</b> - {{match.model.nombreFiscal}}</span>
                            </div>
                        </script>
                    </div>
                </div>
                <div class="col-xl-2 col-lg-2 col-md-6 col-sm-12 col-12">
                    <button type="button" class="btn btn-info btm-sm mt-4" data-toggle="button" data-more="#sh"
                        aria-pressed="false" ng-click="onClickBtnMore()">
                        <span class="text"><i class="fas fa-eye" aria-hidden="true"
                                uib-tooltip="Más opciones"></i></span>
                        <span class="text-active"><i class="fas fa-eye" aria-hidden="true"
                                uib-tooltip="Ocultar opciones"></i></span>
                    </button>
                    <button type="button" class="btn btn-success btm-sm mt-4" uib-tooltip="Recargar"
                        ng-click="getNotaEntregas()">
                        <i class="fas fa-redo"></i>
                    </button>
                </div>
            </div>

            <div class="row justify-content-between" ng-if="moreSearchOptions">

                <div class="col-xl-3 col-lg-3 col-md-12 col-sm-12 col-12">
                    <div class="form-group">
                        <span for="usuario">Usuario</span>
                        <input type="text" class="form-control border-select" ng-model="nombreCompleto"
                            ng-keyup="onKeyupUsuarioSearch()"
                            uib-typeahead="u as u.nombreCompleto for u in usuarioSearch($viewValue)"
                            typeahead-editable="false" placeholder="Buscar Usuario" autocomplete="off"
                            typeahead-template-url="usuarioSearchTemplate.html"
                            typeahead-no-results="usuarioSearch.noResults"
                            typeahead-on-select="selectedUsuarioSearch($item)">

                        <script type="text/ng-template" id="usuarioSearchTemplate.html">
                                <div class="autocomplete-suggestion-uib-typeahead">
                                    <span class="item-title">
                                        {{match.model.nombreCompleto}}
                                    </span>
                                </div>
                            </script>
                    </div>
                </div>

                 <div class="col-xl-3 col-lg-3 col-md-6 col-sm-12 col-12">
                    <div class="form-group">
                        <span>Buscar por Nro. Documento:</span>
                        <input type="text" class="form-control border-select"  ng-model="dataSearch.nroSecuencial" placeholder="Ej: 123"/>                       
                    </div>
                </div>
                
                <div class="col-xl-3 col-lg-3 col-md-12 col-sm-12 col-12">
                    <div class="form-group">
                        <span>Estado:</span>
                        <select id="estadoDocumentos" class="form-control" ng-model="dataSearch.codEstado"
                            ng-change="getNotaEntregas()">
                            <option value="">Todos</option>
                            <option ng-value="item.codigo" ng-repeat="item in estadoDocumentos">
                                {{item.descripcion}}
                            </option>
                        </select>
                    </div>
                </div>
                <div class="col-xl-3 col-lg-3 col-md-12 col-sm-12 col-12">
                    <div class="form-group">
                        <span>Buscar</span>
                        <input type="text" class="form-control border-select" ng-change="searchFilterLocal()"
                            ng-model="dataSearch.bySearch" placeholder="Ej: 001-002">
                    </div>
                </div>
            </div>

            <div class="row justify-contend-start">
                <div class="col-xl-3 col-lg-3 col-md-12 col-sm-12 col-12">
                    <span class="form-group pull-left page-size form-inline">
                        <select class="form-control control-color" ng-model="dataSearch.pageSize"
                            ng-change="changePageSize()" ng-options="ra for ra in recordsQuantity">
                        </select>
                    </span>
                </div>
            </div>

            <!--Lista Nota de Entregas-->

            <div id="upperScroll" style="overflow-x:scroll; overflow-y: hidden; max-height:20px; width:100%">
                <div name="innerScroll" ng-style="duelScroll" style="height:20px;"></div>
            </div>
            <div ng-style="getStyle($index)">
                <md-table-container name="wireTable" infinite-scroll="loadMore($index)" infinite-scroll-distance="1"
                    infinite-scroll-parent="true" ng-init="isShow=true" ng-show="isShow"
                    style=" max-height: 400px; overflow-x: hidden;">
                    <table resize master md-table name="innerWireTable">
                        <thead fix-head md-head md-trim-column-names>
                            <tr md-row>
                                <th md-column></th>
                                @* <th md-column>N°</th> *@
                                <th md-column>N°. Doc</th>
                                <th md-column>F. Emision</th>
                                <th md-column>F. Vcto</th>
                                <th md-column>Cliente</th>
                                <th md-column totales-venta-view="ventaPermiso">Total</th>
                                <th md-column totales-venta-view="ventaPermiso">Abono</th>
                                <th md-column totales-venta-view="ventaPermiso">Saldo</th>
                                <th md-column>Estado </th>
                                <th md-column>Usuario</th>
                            </tr>
                        </thead>
                        <tbody md-body>
                            <tr md-row ng-repeat="ne in notaEntregas" ng-class="ne.style">
                                <td md-cell>
                                    <md-menu>
                                        <md-button aria-label="Open demo menu" class="md-icon-button"
                                            ng-click="$mdMenu.open($event)">
                                            <icon class="mdi mdi-menu"></icon>
                                        </md-button>
                                        <md-menu-content class="md-dense">
                                            <md-menu-item>
                                                <md-button ng-click="openModalDetalle(ne)">
                                                    <span md-menu-align-target><i class="ti-menu"></i>
                                                        Detalle</span>
                                                </md-button>
                                            </md-menu-item>

                                            <md-menu-item ng-if="accion.editar">
                                                <md-button ng-click="openModalEdit(ne)"
                                                    ng-disabled="ne.codEstado==='A'">
                                                    <span md-menu-align-target><i class="ti-pencil"></i>
                                                        Editar</span>
                                                </md-button>
                                            </md-menu-item>

                                            <md-menu-item ng-if="accion.anular">
                                                <md-button ng-click="askToDelete(ne)" ng-disabled="ne.codEstado==='A'">
                                                    <span md-menu-align-target><i class="ti-close"></i>
                                                        Anular</span>
                                                </md-button>
                                            </md-menu-item>

                                            <md-menu-item>
                                                <md-button ng-click="openModalDuplicate(ne)">
                                                    <span md-menu-align-target><i class="ti-files"></i>
                                                        Duplicar</span>
                                                </md-button>
                                            </md-menu-item>

                                            <md-menu-item
                                                ng-if="(accion.cobroPago && ne.codEstado==='PE') || (accion.cobroPago && ne.codEstado==='PP')">
                                                <md-button ng-click="opcionCobro(ne)"
                                                    ng-disabled="ne.codEstado==='A' || ne.cobro || ne.gestion">
                                                    <span md-menu-align-target><i class="ti-shortcode"></i>
                                                        Cobro</span>
                                                </md-button>
                                            </md-menu-item>


                                            <md-menu-item ng-if="accion.cuota">
                                                <md-button ng-click="openModalCuota(ne)">
                                                    <span md-menu-align-target><i class="ti-list"></i>
                                                        Cuota</span>
                                                </md-button>
                                            </md-menu-item>


                                            <md-menu-item ng-if="accion.historialFinanciero">
                                                <md-button ng-click="openModalHistorialCobro($event, ne)">
                                                    <span md-menu-align-target><i class="ti-layout-cta-center"></i>
                                                        Hist. Mov.</span>
                                                </md-button>
                                            </md-menu-item>

                                            <md-menu-item>
                                                <md-button ng-click="print(ne)">
                                                    <span md-menu-align-target>
                                                        <icon class="mdi mdi-cloud-print-outline"></icon>
                                                        Impresión
                                                    </span>
                                                </md-button>
                                            </md-menu-item>

                                            <md-menu-item ng-if="accion.enviarCorreo">
                                                <md-button btn-send-to-email params="ne" type-send="typeSendToMail"
                                                    get-param-to-send-mail="getParamToSendMail(params)">
                                                    <span md-menu-align-target><i class="far fa-envelope"></i>
                                                        Enviar Correo</span>
                                                </md-button>
                                            </md-menu-item>

                                            <md-menu-item>
                                                <md-button uib-tooltip="Enviar por Whatsapp" tooltip-placement="top"
                                                    btn-send-to-whats-app params="ne" has-permission="hasPermissions"
                                                    type-send="typeSend">
                                                    <span md-menu-align-target>
                                                        <i class="mdi mdi-whatsapp"></i> Enviar por Whatsapp
                                                    </span>
                                                </md-button>
                                            </md-menu-item>


                                            <md-menu-item ng-if="accion.reporte">
                                                <md-button ng-click="getReport(ne)">
                                                    <span md-menu-align-target><i class="ti-file"></i>
                                                        PDF</span>
                                                </md-button>
                                            </md-menu-item>
                                        </md-menu-content>
                                    </md-menu>

                                </td>
                                @* <td md-cell>{{$index+1}}</td> *@
                                <td md-cell>{{ne.nroDocumento}}</td>
                                <td md-cell>{{ne.fechaEmision}}</td>
                                <td md-cell>{{ne.fechaVencimiento}}</td>
                                <td md-cell>{{ne.nombreFiscal}}</td>
                                <td md-cell totales-venta-view="ventaPermiso">${{ne.total}}</td>
                                <td md-cell totales-venta-view="ventaPermiso">${{ne.abono}}</td>
                                <td md-cell totales-venta-view="ventaPermiso">${{ne.saldo}}</td>
                                <td md-cell>{{ne.estadoFinanciero}}</td>
                                <td md-cell>{{ne.usuario}}</td>
                            </tr>
                            @* <tr class="text-center" ng-show="notaEntregas.length===0">
                            <td colspan="11">No hay registros</td>
                            </tr> *@
                        </tbody>
                        <tfoot md-foot fixed-tfoot>
                            <tr md-row>
                                <td md-cell colspan="2"><span class="font-weight-bold">{{dataSearch.totalRecords}}
                                        Notas de Entregas</span></td>
                                <td md-cell colspan="3"><span class="font-weight-bold">Total: </span></td>
                                <td md-cell totales-venta-view="ventaPermiso"><span
                                        class="font-weight-bold">${{total}}</span></td>
                                <td md-cell totales-venta-view="ventaPermiso"><span
                                        class="font-weight-bold">${{totalAbono}}</span></td>
                                <td md-cell totales-venta-view="ventaPermiso"><span
                                        class="font-weight-bold">${{totalSaldo}}</span></td>
                                <td md-cell colspan="3"></td>
                            </tr>
                        </tfoot>
                    </table>
                </md-table-container>
            </div>
        </div>
         <div class="card-body">
             <ul uib-pagination total-items="dataSearch.totalRecords" items-Per-Page="dataSearch.pageSize"
                ng-change="pagechanged()" ng-model="dataSearch.pageIndex" max-size="dataSearch.maxSize"
                class="pagination" boundary-links="true" rotate="false"></ul>
        </div>
    </div>

</div>

@section Scripts{
    <script src="~/js/services/storageService.min.js" asp-append-version="true"></script>
    <script src="~/js/factElect/directives/factElectDirective.min.js" asp-append-version="true"></script>
    <script src="~/js/factElect/services/facturaService.min.js" asp-append-version="true"></script>
    <script src="~/js/ventas/services/notaEntregaService.min.js" asp-append-version="true"></script>
    <script src="~/js/ventas/controllers/notaEntregaCtrl.min.js" asp-append-version="true"></script>
}