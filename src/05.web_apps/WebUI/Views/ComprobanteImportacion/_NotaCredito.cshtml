<div id="notaCreditoModal" class="modal fade" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <form ng-submit="saveNotaCredito()">
                <div class="modal-header">
                    <h5 class="modal-title">Nota de Crédito</h5>
                    <button class="close" data-dismiss="modal">&times;</button>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <div class="col-xl-6 col-lg-6 col-md-6 col-sm-6 col-6">
                            <div class="card border border-dark rounded">
                                <div class="card-body">
                                    <img src="" alt="NO LOGO" height="150">
                                    <h5>{{infoTributaria.razonSocial}}</h5>
                                    <br>
                                    <h5>{{infoTributaria.nombreComercial}}</h5>
                                    <br>
                                    <h5><label for="">Dirección Matriz:</label> {{infoTributaria.dirMatriz}}</h5>
                                    <br>
                                    <h5>
                                        <label for="">Dirección Sucursal: </label>
                                        {{infoNotaCredito.dirEstablecimiento}}
                                    </h5>
                                    <br>
                                    <h5 ng-show="">
                                        <label for="infoNotaCredito.contribuyenteEspecial.length > 0">
                                            Contribuyente
                                            Especial Nro.
                                        </label>
                                        {{infoNotaCredito.contribuyenteEspecial}}
                                    </h5>
                                    <h5>
                                        <label for="">OBLIGADO A LLEVAR CONTABILIDAD </label>
                                        {{infoNotaCredito.obligadoContabilidad}}
                                    </h5>
                                </div>
                            </div>


                        </div>
                        <div class="col-xl-6 col-lg-6 col-md-6 col-sm-6 col-6">
                            <div class="card border border-dark rounded">
                                <div class="card-body">
                                    <h5><label>RUC: </label> {{infoTributaria.ruc}}</h5>
                                    <h4>COMPROBANTE DE RETENCIÓN</h4>
                                    <h5>
                                        <label for="">No.</label>
                                        {{infoTributaria.estab}}-{{infoTributaria.ptoEmi}}-{{infoTributaria.secuencial}}
                                    </h5>
                                    <label for="">NÚMERO DE AUTORIZACIÓN</label>
                                    <small>
                                        {{infoTributaria.claveAcceso}}
                                    </small>
                                    <label for="">FECHA Y HORA DE AUTORIZACIÓN</label>
                                    <small>
                                        {{selected[0].fechaAutorizacion}}
                                    </small>
                                    <h5>
                                        <label for="">AMBIENTE:</label>
                                        <span ng-bind-html="infoTributaria.ambiente | ambienteSri"></span>
                                    </h5>
                                    <h5>
                                        <label for="">EMISIÓN:</label>
                                        <span ng-bind-html="infoTributaria.tipoEmision | tipoEmisionSri"></span>
                                    </h5>
                                    <label for="">CLAVE DE ACCESSO</label>
                                    <img id="barcodeImg" src="" alt="">
                                    <small> {{infoTributaria.claveAcceso}}</small>
                                </div>

                            </div>

                        </div>
                    </div>
                    <div class="row">
                        <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">
                            <div class="card border border-dark rounded">
                                <div class="card-body">
                                    <div class="row">
                                        <div class="col-xl-8 col-lg-8 col-md-8 col-sm-8 col-8">
                                            <h5>
                                                <label for="">Razón Social / Nombres y Apellidos: </label>
                                                {{infoNotaCredito.razonSocialComprador}}
                                            </h5>
                                            <br>
                                            <h5>
                                                <label for="">Fecha Emisión: </label>
                                                {{infoNotaCredito.fechaEmision}}
                                            </h5>
                                        </div>
                                        <div class="col-xl-4 col-lg-4 col-md-4 col-sm-4 col-4">
                                            <h5>
                                                <label for="">Identificación: </label>
                                                {{infoNotaCredito.identificacionComprador}}
                                            </h5>
                                        </div>
                                    </div>

                                </div>
                            </div>
                        </div>

                        <br>
                        <div class="table-responsive">
                            <table class="table table-bordered">
                            </table>
                        </div>

                    </div>
                    <div class="row">
                        <div class="col-xl-6 col-lg-6 col-md-6 col-sm-6 col-6">
                            <table class="table table-borderless">
                                <thead>
                                    <tr>
                                        <th>Nombre</th>
                                        <th>Valor</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr ng-repeat="test in infoAdicional">
                                        <td>{{test.nombre}}</td>
                                        <td>{{test.valor}}</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-success btn-sm"><i class="ti-save"></i> Importar</button>
                    <button class="btn btn-dark btn-sm" data-dismiss="modal">&times; Cerrar</button>
                </div>
            </form>
        </div>
    </div>
</div>