<div id="newImportModal" class="modal fade" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form ng-submit="post()">
                <div class="modal-header">
                    <h4 class="modal-title">
                        <icon class="ti-upload"></icon> Nueva Importacion
                    </h4>
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <div class="col-12">
                            <div class="form-group">
                                <label for="">Archivo Sri:</label>
                                <input type="file" ngf-select ng-model="fileTxt" class="form-control">
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-success"><i class="ti-upload"></i> Subir</button>
                    <button type="button" class="btn btn-dark" data-dismiss="modal">
                        <i class="ti-close"></i>
                        Cerrar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<div id="xmlIndividualModal" class="modal fade" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form ng-submit="putXmlManual()">
                <div class="modal-header">
                    <h4 class="modal-title">
                        <icon class="ti-upload"></icon> Subir Xml
                    </h4>
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <div class="col-xl-6 col-lg-6 col-md-6 col-sm-12 col-12">
                            <div class="form-group">
                                <label for="comprobante">Comprobante:</label>
                                <input type="text" class="form-control" value="{{selected[0].comprobante}}"
                                       disabled>
                            </div>
                        </div>
                        <div class="col-xl-6 col-lg-6 col-md-6 col-sm-12 col-12">
                            <div class="form-group">
                                <label for="comprobante">Serie:</label>
                                <input type="text" class="form-control" value="{{selected[0].serieComprobante}}"
                                       disabled>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">
                            <div class="form-group">
                                <label for="comprobante">Clave Acceso:</label>
                                <input type="text" class="form-control" value="{{selected[0].claveAcceso}}"
                                       disabled>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-12">
                            <div class="form-group">
                                <label for="">Archivo Xml Sri:</label>
                                <input type="file" ngf-select ng-model="fileXml" class="form-control">
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-success"><i class="ti-upload"></i> Subir</button>
                    <button type="button" class="btn btn-dark" data-dismiss="modal">
                        <i class="ti-close"></i>
                        Cerrar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>