
                       
<tbody md-body ng-if="!dataSearch.checkBoxDeudoresFiltro">                           
    <tr md-row style="font-weight: bold;" ng-repeat-start="cc in carteraClientes | filter:txtSearch">
        <td md-cell colspan="3">{{cc.cliente.nombreFiscal}}</td>                                
        <td md-cell colspan="4"></td>
        <td md-cell colspan="3">
            <input type="text" ng-model="cc.txtFilter" class="form-control border-select" placeholder="Buscar Documentos">
        </td>
    </tr> 
    <tr md-row ng-repeat="doc in cc.documentos|filter:cc.txtFilter">
        <td md-cell ng-if="!dataSearch.checkBoxDeudoresFiltro">
            <div class="d-flex justify-content-center">
            <button ng-click="verDocumento()" class="btn btn-primary-1 btn-xs" tooltip data-tooltip data-title="Ver Documento"><i class=" far fa-file"></i> </button>
            <button ng-click="verDocumento()" class="btn btn-warning btn-xs ml-1" tooltip data-tooltip data-title="Cuota por Cobrar"><i class="fas fa-clipboard-list"></i> </button>

            </div>
        </td>
        <td md-cell>{{$index+1}}</td>
        <td md-cell ng-if="!dataSearch.checkBoxDeudoresFiltro">{{doc.codigo}}</td>
        <td md-cell ng-if="!dataSearch.checkBoxDeudoresFiltro">{{doc.nroDoc}}</td>        
        <td md-cell ng-if="!dataSearch.checkBoxDeudoresFiltro">{{doc.fechaEmision}}</td>
        <td md-cell>{{doc.total}}</td>
        <td md-cell>{{doc.abono}}</td>
        <td md-cell>{{doc.saldo}}</td>             
        <td md-cell ng-if="!dataSearch.checkBoxDeudoresFiltro">{{doc.fechaVencimiento}}</td>
    </tr>
    <tr md-row ng-repeat-end>
        <td md-cell colspan="5" align="right"><b>TOTAL:</b></td>
        <td md-cell>{{getCalculoTotal(cc, "total")}}</td>
        <td md-cell>{{getCalculoTotal(cc, "abono")}}</td>
        <td md-cell>{{getCalculoTotal(cc, "saldo")}}</td>                                
        <td md-cell colspan="4"></td>
    </tr>   
</tbody>
                  