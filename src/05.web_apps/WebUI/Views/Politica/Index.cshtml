
@{
    ViewData["Title"] = "Index";
}
<div ng-controller="politicaCtrl">
    <div class="row page-titles">
        <div class="col-md-5 align-self-center">
            <h4 class="text-themecolor">Gestión de Politicas</h4>
        </div>
        <div class="col-md-7 align-self-center text-right">
            <div class="d-flex justify-content-end align-items-center">
                @*<ol class="breadcrumb">
                        <li class="breadcrumb-item"><a href="javascript:void(0)">Inicio</a></li>
                        <li class="breadcrumb-item active">Politica</li>
                    </ol>*@
                <button type="button" ng-if="accion.leer && accion.crear" ng-click="abrirModal(0,1)" class="btn btn-info m-l-15">
                    <i class="fas fa-plus-circle"></i> Nuevo
                </button>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <div class="row">
                        <div class="col-lg-9">
                            <span class="form-group pull-left page-size form-inline">
                                <select class="form-control control-color"
                                        ng-model="pageSize"
                                        ng-change="changePageSize()"
                                        ng-options="ra for ra in recordsQuantity">
                                </select>
                            </span>
                        </div>
                        <div class="col-lg-3">
                            <input type="text" class="form-control" ng-model="buscar" placeholder="Buscar Politica" />
                        </div>
                    </div>
                    <!--Politicas -->
                    <partial name="_Politicas"/>
                </div>
            </div>
        </div>
    </div>

    <!--Modal Para Agregar y Actualizar la Politica -->
    <partial name="_ModalAddUpdate"/>

    <!--Modal Paea Asignar Accesos a la Politica -->
    <partial name="_Acceso"/>

</div>

@section Scripts{
    <script src="~/js/controllers/admin/politicaCtrl.min.js" asp-append-version="true"></script>            

}

