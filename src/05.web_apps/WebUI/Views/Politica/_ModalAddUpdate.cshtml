 <div class="modal fade" id="agregar" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel1" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog" role="document">
        <form ng-submit="saveUpdate(type)" class="form-material" autocomplete="off" novalidate>
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">{{tituloModal}} Politica</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                            <div class="form-group">
                                <label class="form-control-label" for="descripcion">Descripcion <span class="text-danger">*</span></label>
                                <input type="text" ng-model="data.descripcion" class="form-control" valid-letra placeholder="Ej: Administrador">
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                            <div class="form-group">
                                <label class="form-control-label" for="codigo">Codigo: <span class="text-danger">*</span></label>
                                <input type="text" ng-disabled="data.descripcion==''||data.descripcion==undefined|| type==2" ng-model="data.codigo" touppercase class="form-control" placeholder="Ej: ADM">
                            </div>
                        </div>
                    </div>

                    <div ng-show="type==2">
                        <label for="">Estado: </label>
                        <md-radio-group ng-model="data.estado">
                            <md-radio-button ng-value="true">Activo</md-radio-button>
                            <md-radio-button ng-value="false">Inactivo</md-radio-button>
                        </md-radio-group>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-success"><i class="{{icono}}"></i> {{btnModal}}</button>
                    <button type="button" class="btn btn-dark" data-dismiss="modal">&times; Cerrar</button>
                </div>
            </div>
        </form>
    </div>
</div>