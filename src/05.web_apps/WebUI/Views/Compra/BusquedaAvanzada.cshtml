<div class="card shadow-sm" ng-show="isBusquedaAvanzada">
    <div class="card-body">
        <div class="row">
            <div class="col-md-4 col-sm-6">
                <div class="form-group">
                    <label class="control-label">Sucursal:</label>
                    <select class="form-control border-select" ng-model="filterSucursal"
                            ng-options="s as s.nombreComercial for s in sucursales track by s.idRol">
                    </select>
                </div>
            </div>

            <div class="col-md-4 col-sm-6">
                <div class="form-group">
                    <label class="control-label">Proveedor:</label>
                    <md-autocomplete id="custom-template"
                                     md-no-cache="false"
                                     md-selected-item="proveedorFilter"
                                     md-search-text-change="searchTextChange()"
                                     md-search-text="searchText"
                                     md-items="item in searchProveedor(searchText)"
                                     md-item-text="item.proveedor.nombreComercial"
                                     md-min-length="1"
                                     md-escape-options="clear"
                                     input-aria-label="Buscar Proveedor"
                                     placeholder="Buscar Proveedor"
                                     md-menu-class="autocomplete-custom-template"
                                     md-menu-container-class="custom-container" md-clear-button="false">
                        <md-item-template>
                            <span class="item-title">
                                <i class="fa fa-user"></i>
                                <span> {{item.proveedor.nombreComercial}} </span>
                            </span>

                            <span class="item-metadata">
                                <span>
                                    <small><strong>C.I.</strong> {{item.proveedor.numeroIdentificacion}}</small>
                                </span><br />
                                <span>
                                    <small> <strong>Email:</strong> {{item.proveedor.correo | limitTo:30}}{{item.proveedor.correo.length > 30 ? '...': ''}}</small>
                                </span>

                            </span>
                        </md-item-template>

                    </md-autocomplete>
                </div>
            </div>
            <div class="col-md-1 col-sm-1 m-t-30">
                <div class="form-group">
                    <div class="icheck-primary icheck-inline">
                        <input type="checkbox" ng-model="isProveedor" id="isProveedor" />
                        <label for="isProveedor"></label>
                    </div>
                </div>
            </div>

            <div class="col-md-2 col-sm-4">
                <div class="form-group">
                    <label class="control-label">Estado:</label>
                    <select class="form-control" ng-model="idEstadoPago">
                        <option value="{{p.idEstadoPago}}" ng-repeat="p in paymentStatus">{{p.descripcion}}</option>
                    </select>
                </div>
            </div>
            <div class="col-md-1 col-sm-1 m-t-30">
                <div class="form-group">
                    <div class="icheck-primary icheck-inline">
                        <input type="checkbox" ng-model="isEstado" id="isEstado" />
                        <label for="isEstado"></label>
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-2 col-sm-1">
                <div class="form-group">
                    <label class="control-label">Mes: </label>
                    <select ng-model="mes" class="form-control" ng-change="getFechaEmisionInicioFin(mes)">
                        <option ng-value="{{m.numero}}" ng-repeat="m in meses">{{m.nombre}}</option>
                    </select>
                </div>
            </div>
            <div class="col-md-2 col-sm-4">
                <div class="form-group">
                    <label class="control-label">F. Emisión Inicio: </label>
                    <input type="date" class="form-control" name="fEmision" required
                           ng-model="fEmisionInicio" />
                </div>
            </div>

            <div class="col-md-2 col-sm-4">
                <div class="form-group">
                    <label class="control-label">F. Emisión Final:</label>
                    <input type="date" class="form-control" name="fVencimiento" required
                           ng-model="fEmisionFinal" />
                </div>
            </div>
            <div class="col-md-1 col-sm-1 m-t-30">
                <div class="form-group">
                    <div class="icheck-primary icheck-inline">
                        <input type="checkbox" ng-model="isFechaEmisionInicioFinal" id="isFechaEmisionInicioFinal" />
                        <label for="isFechaEmisionInicioFinal"></label>
                    </div>
                </div>
            </div>
            <div class="col-md-2 col-sm-4">
                <div class="form-group">
                    <label class="control-label">F. Vencimiento:</label>
                    <input type="date" class="form-control" name="fVencimiento" required
                           ng-model="fVencimiento" />
                </div>
            </div>
            <div class="col-md-1 col-sm-1 m-t-30">
                <div class="form-group">
                    <div class="icheck-primary icheck-inline">
                        <input type="checkbox" ng-model="isFvencimiento" id="isFvencimiento" />
                        <label for="isFvencimiento"></label>
                    </div>
                </div>
            </div>
            <div class="col-lg-2 col-md-2 col-sm-2 col-xs-6 m-t-30">
                <button type="button"
                        ng-click="readDocumentoCompra(td.idTipoDocumento,proveedorFilter,isProveedor, idEstadoPago, isEstado, isFechaEmisionInicioFinal)" class="btn btn-success">
                    <i class="fa fa-search"></i> Buscar
                </button>
            </div>
        </div>
    </div>
</div>