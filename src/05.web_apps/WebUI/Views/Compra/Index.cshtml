
<div ng-controller="compraCtrl">
    <div class="row page-titles">
        <div class="col-md-5 align-self-center">
            <h4 class="text-themecolor">Compra</h4>
        </div>
        <div class="col-md-7 align-self-center text-right">
            <div class="d-flex justify-content-end align-items-center">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/Home/Index">Inicio</a></li>
                    <li class="breadcrumb-item"><a href="javascript:void(0)">Compras </a></li>
                    <li class="breadcrumb-item active">Compra</li>
                </ol>
                <button type="button" class="btn btn-info m-l-15" ng-click="nuevoCompra()" id="btnAgregar"><i class="fa fa-plus-circle"></i> Nuevo</button>
            </div>
        </div>
    </div>
    <md-content id="mainList">
        <md-tabs class="md-primary" md-center-tabs md-stretch-tabs="always" md-border-bottom md-dynamic-height md-selected="selectTab">
            <md-tab label="{{td.descripcion}}" ng-repeat="td in tipoDocumentos" ng-click="tabTipoDocumento(td)">
            </md-tab>
        </md-tabs>
        <div ng-switch="tipoDocumento.codigo">
            <div ng-switch-when="OC">
                <partial name="~/Views/OrdenCompra/Index.cshtml" />
            </div>
            <div ng-switch-when="IB">
                <partial name="~/Views/OrdenCompra/Index.cshtml" />
            </div>
            <div ng-switch-when="NV">
                <partial name="~/Views/NotaVenta/Index.cshtml" />
            </div>
            <div ng-switch-when="LC">
                <partial name="~/Views/NotaVenta/Index.cshtml" />
            </div>
            <span ng-switch-default>
                <partial name="~/Views/FacturaCompra/Index.cshtml" />
            </span>
        </div>
    </md-content>
    
    <partial name="FacturaCompra" />
    
    


</div>
@section Scripts{
    <script src="~/js/controllers/ingresos/compraCtrl.js" asp-append-version="true"></script>
    <script src="~/js/factories/compraService.js" asp-append-version="true"></script>
    <script src="~/js/controllers/ingresos/facturaCompraCtrl.js"></script>
   
 <!--Proveddor-->
    <script src="~/js/controllers/proveedorCtrl.js?v=20.0" asp-append-version="true"></script>
    <script src="~/js/factories/personaService.min.js"></script>

    <!--Articulo-->
    <script src="~/js/controllers/almacen/articuloCtrl.min.js" asp-append-version="true"></script>
    <script src="~/js/factories/articuloService.min.js" asp-append-version="true"></script>
    <script src="/js/controllers/almacen/articuloCodigoBarraCtrl.min.js" asp-append-version="true"></script>
    <script src="~/js/controllers/almacen/articuloUbicacionCtrl.js" asp-append-version="true"></script>
    <script src="~/js/controllers/almacen/impuestoArticuloCtrl.min.js" asp-append-version="true"></script>

}