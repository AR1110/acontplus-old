<div class="row">
    <div class="col-lg-3 col-md-3 col-sm-3 col-xl-3">
        <div class="form-group">
            <label for="categoria">Sucursal: <span class="text-danger">*</span> </label>
            <select class="form-control border-select" ng-model="sucursal"
                    ng-options="s as s.nombreComercial for s in sucursales track by s.idRol">
            </select>
        </div>
    </div>

    <div class="col-lg-3 col-md-3 col-sm-3 col-xl-3">
        <div class="form-group">
            <label for="categoria">Categoria: <span class="text-danger">*</span> </label>
            <select class="form-control border-select" id="idCategoriaCompra" ng-model="categoriaCompra" ng-change="seleccionarCategoriaCompra(categoriaCompra)"
                    ng-options="cc as cc.descripcion for cc in categoriaCompras track by cc.idCategoriaCompra">
            </select>
        </div>
    </div>
    <div class="col-lg-3 col-md-3 col-sm-3 col-xs-2">
        <div class="form-group">
            <label>F. Emisión: </label>
            <input type="date" ng-model="data.fechaEmision" required  class="form-control" placeholder="Fecha Emision" />                       
        </div>
    </div>
    <div class="col-lg-3 col-md-3 col-sm-2">
        <div class="form-group">
            <label>Usuario: </label>
            <input type="text" ng-model="usuario" ng-disabled="true" class="form-control" />
        </div>
    </div>
</div>

<div class="row">
    <!--BUSCAR PROVEEDOR POR NOMBRE COMERCIAL-->
    <div class="col-lg-3 col-md-3 col-sm-6 col-xs-6">
        <label> Proveedor: <span class="text-danger">*</span></label>
        <input type="text" class="form-control" ng-model="proveedor.nombreFiscal" ng-disabled="tipoOperacion==2" ng-show="tipoOperacion==2" value="" />
        <div ng-show="tipoOperacion==1"><search-proveedor></search-proveedor></div><!--Buscar Proveedor-->
        <button type="button" ng-show="tipoOperacion==1" ng-click="abrirModalProveedor()" class="btn btn-success btn-sm m-t-5"><i class="fa fa-plus-circle"></i></button>
        <button type="button" ng-show="tipoOperacion==1" ng-click="abrirModalProveedor(4)" class="btn btn-secondary btn-sm m-t-5"><i class="fa fa-search"></i></button>
        <button type="button" ng-click="abrirModalProveedor(selectedProveedor)" ng-show="proveedor.idProveedor && tipoOperacion==1" class="btn btn-info btn-sm m-t-5">
            <i class="fa fa-edit"></i>
        </button>
    </div>


    <div class="col-lg-2 col-md-3 col-sm-6 col-xs-3">
        <div class="form-group">
            <label>RUC: </label>
            <input type="text" class="form-control" ng-class="typeNotify" ng-model="proveedor.numeroIdentificacion" ng-disabled="true">
            <small class="valid-feedback">{{message}} </small>
        </div>
    </div>

    <div class="col-lg-4 col-md-4 col-sm-6 col-xs-3">
        <div class="form-group">
            <label>Dirección: </label>
            <input type="text" ng-model="proveedor.direccion" ng-disabled="true" class="form-control" />
        </div>
    </div>
    <div class="col-lg-3 col-md-3 col-sm-6 col-xs-3">
        <div class="form-group">
            <label>Correo: </label>
            <input type="text" ng-model="proveedor.correo" ng-disabled="true" class="form-control" />
        </div>
    </div>
</div>

