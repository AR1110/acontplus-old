
<div class="row" id="nuevoDocumentoCompra" style="display:none">
    <div class="col-md-12 col-lg-12" >
        <div class="card">
            <div class="card-header {{colorHeader}}">
                <h5 class="m-b-0 text-white"><i class="{{iconoModal}}"></i> Registrar {{tituloModal}}</h5>
            </div>
            <div class="card-body">

                <!--mostrar si es Factura de Compra  -->
                <div ng-show="tipoDocumento.idTipoDocumento==1">
                    <partial name="FacturaCompra" />
                </div>


                <!--Se incluye contenidp si es Orden de Compra-->
                <div ng-show="tipoDocumento.idTipoDocumento==2">
                    <partial name="OrdenCompra" />
                </div>
                <!--Se incluye contenidp si es Ingreso a Bodega-->
                <div ng-show="tipoDocumento.idTipoDocumento==3">
                    <partial name="IngresoBodega" />
                </div>

                <!--mostrar si es   Nota de Venta -->
                <div ng-show="tipoDocumento.idTipoDocumento==4">
                    <partial name="NotaVenta" />
                </div>

                <!--Se incluye contenidp si es Liquidación de Compra-->
                <div ng-show="tipoDocumento.idTipoDocumento==5">
                    <partial name="LiquidacionCompra" />
                </div>

                <div class="row">
                    <div class="col-md-8 col-sm-12 col-xs-8 ">
                        <div class="form-group row">
                            <div class="col-lg-1 col-md-1 col-sm-1 m-t-10">
                                <md-switch ng-model="isSearchCodigo" aria-label="Buscar Articulo">
                                </md-switch>
                            </div>
                            <div class="col-lg-4 col-md-5 col-sm-5 col-xs-3">
                                <label class="control-label">Buscar por {{isSearchCodigo? 'Código':' Descripción'}}</label>
                                <input type="text" id="isSearchCodigo" ng-show="isSearchCodigo" ng-model="searchCodigo" ng-keydown="searchArticuloCodigo($event, searchCodigo)" class="form-control" placeholder="Buscar Articulo por Código" />
                                <md-autocomplete id="searchArticulo"
                                                 ng-hide="isSearchCodigo"
                                                 md-no-cache="true"
                                                 md-selected-item="searchArticulo"
                                                 md-search-text-change="searchTextChange(e, searchText)"
                                                 md-search-text="buscarArticulo"
                                                 md-selected-item-change="selectArticulo(item)"
                                                 md-items="item in  searchArticuloFilter(buscarArticulo)"
                                                 md-item-text="item.articulo.descripcion"
                                                 md-min-length="1"
                                                 md-escape-options="clear"
                                                 input-aria-label="Buscar Articulo"
                                                 placeholder="Buscar Articulo"
                                                 md-menu-class="autocomplete-custom-template"
                                                 md-menu-container-class="custom-container-searchArticulo" md-clear-button="false">
                                    <md-item-template>
                                        <md-tooltip class="md-tooltip-articulo" ng-mouseover="item.showDetalle()">
                                            <table class="table table-striped no-border table-sm" ng-show="item.historialEntrada.length>0">
                                                <thead>
                                                    <tr class="text-center">
                                                        <th>Nro. Documento</th>
                                                        <th>T. Doc</th>
                                                        <th>Proveedor</th>
                                                        <th>Fecha</th>
                                                        <th>Cantidad</th>
                                                        <th>Precio Costo</th>
                                                        <th>Total</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <tr ng-repeat="h in item.historialEntrada" class="text-center">
                                                        <td>{{h.numeroFactura}}</td>
                                                        <td>{{h.tipoDocumento}}</td>
                                                        <td>{{h.proveedor}}</td>
                                                        <td>{{h.fechaEmision}}</td>
                                                        <td>{{h.cantidad}}</td>
                                                        <td>{{h.precioCosto | currency:'$'}}</td>
                                                        <td>{{h.total | currency:'$'}}</td>

                                                    </tr>

                                                </tbody>
                                            </table>


                                        </md-tooltip>
                                        <table class="table-autocomplete table-sm">
                                            <thead>
                                                <tr ng-if="item.showHeader">
                                                    <th>Código</th>
                                                    <th>Descripción</th>
                                                    <th>I.V.A</th>
                                                    <th>Bodega</th>
                                                    <th>Stock Bodega</th>
                                                    <th>Stock Total</th>
                                                    <th>Ubicación</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <tr ng-mouseover="item.showDetalle()">
                                                    <td width="20px">{{ item.articulo.codigo }} </td>
                                                    <td width="140px">{{item.articulo.descripcion }}</td>
                                                    <td width="80px">{{item.nombreTipoIva}} </td>
                                                    <td width="100px">{{ item.bodega}} </td>
                                                    <td width="100px">{{ item.stockBodega}}</td>
                                                    <td width="100px">{{ item.stockTotal}}</td>
                                                    <td width="100px">{{item.ubicacion}}</td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </md-item-template>
                                </md-autocomplete>

                            </div>
                            <div class="col-lg-3 col-md-5 col-sm-5 col-xs-3 m-t-30">
                                <button type="button" ng-click="abrirModalArticulo()" class="btn btn-success btn-sm"><i class="fa fa-plus-circle"></i></button>
                                <button type="button" ng-click="modalListaArticulo(buscarArticulo)" class="btn btn-secondary btn-sm"><i class="fa fa-search"></i></button>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-4 col-sm-12 col-xs-4">
                        <div class="form-group row">
                            <div class="col-lg-6 col-md-6 col-sm-6 col-xs-12">
                                <label>Bodega: </label>
                                <select class="form-control border-select" ng-model="bodega" ng-change="seleccionarBodega(bodega.idBodega)"
                                        ng-options="b as b.descripcion for b in bodegas track by b.idBodega">
                                </select>
                            </div>
                            <div class="col-lg-6 col-md-6 col-sm-6 col-xs-12">
                                <label>Decimal: </label>
                                <select class="form-control border-select" ng-model="decimal" ng-options="d as d for d in [2,3,4,5]" ng-change="aplicarDecimal(decimal)">
                                </select>
                            </div>
                        </div>
                    </div>
                    <!--/span-->
                </div>

                <div class="row">
                    <!--/span-->
                    @*ui-grid-pinning*@
                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                        <div class="table-responsive">
                            <div id="grid" ui-grid="gridOptionsDetalleCompra"
                                 ui-grid-edit
                                 ui-grid-resize-columns
                                 ui-grid-cellNav
                                 ui-grid-auto-resize
                                 class="grid"></div>
                        </div>
                    </div>
                </div>
                <div class="row" ng-show="tipoDocumento.idTipoDocumento==4">
                    <div class="col-md-12">
                        <div class="pull-right m-t-30 text-right">
                            <h3><b>Total :</b>{{data.total | currency: $}}</h3>
                        </div>
                        <div class="clearfix"></div>
                        <hr>
                    </div>

                </div>
                <div class="row" ng-if="tipoDocumento.idTipoDocumento==1 || tipoDocumento.idTipoDocumento==2 || tipoDocumento.idTipoDocumento==3 || tipoDocumento.idTipoDocumento==5">
                    <div class="col-lg-3 col-md-3 col-sm-6 col-xs-6">
                        <div class="pull-right m-t-10 text-right">
                            <table class="table-condensed table-bordered" width="100%">
                                <tbody>
                                    <tr>
                                        <td width="60%"><b>Subtotal sin Impuesto: </b></td>
                                        <td class="padding-20 ng-binding" align="center">
                                            <input ng-model="data.subTotalSinImpuestos" disabled valid-number
                                                   class="form-control form-control-sm" value="" />
                                        </td>
                                    </tr>
                                    <tr>
                                        <td width="50%"><b>Subtotal IVA 12.0%: </b></td>
                                        <td align="center">{{data.subTotalIva|currency:$}}</td>
                                    </tr>
                                    <tr>
                                        <td width="50%"><b>Subtotal IVA 0%: </b></td>
                                        <td align="center">{{data.subTotalIvaCero|currency:$}}</td>
                                    </tr>
                                    <tr>
                                        <td width="50%"><b>Subtotal Exento IVA: </b></td>
                                        <td align="center">{{data.subTotalExentoIva|currency:$}}</td>
                                    </tr>
                                    <tr>
                                        <td width="50%"><b>Subtotal no Objeto IVA: </b></td>
                                        <td align="center">{{ data.subTotalNoObjetoIva| currency: $}}</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class=" col-lg-4 col-md-4 col-sm-6 col-xs-6">
                        <div class="pull-right m-t-10 text-right">
                            <table class="table-condensed table-bordered" width="100%">
                                <tbody>
                                    <tr>
                                        <td width="50%"><b>% Dsto:</b></td>
                                        <td align="center">
                                            <input ng-model="data.porcentajeDescuento" ng-blur="calcularPorcentajeDescuento()" id="porcentajeDescuento"
                                                   ng-disabled="gridOptionsDoc.data.length==0"
                                                   valid-number class="form-control form-control-sm" placeholder="0.00" />
                                        </td>
                                    </tr>
                                    <tr>
                                        <td width="50%"><b>SubTotal Neto IVA: </b></td>
                                        <td align="center">{{data.subTotalNetoIva|currency:$}}</td>
                                    </tr>
                                    <tr>
                                        <td width="50%"><b>SubTotal Neto IVA 0: </b></td>
                                        <td align="center">{{data.subTotalNetoIvaCero|currency:$}}</td>
                                    </tr>
                                    <tr>
                                        <td width="50%"><b>SubTotal Neto Exento IVA: </b></td>
                                        <td align="center">{{data.subTotalNetoExentoIva | currency: $}}</td>
                                    </tr>
                                    <tr>
                                        <td width="50%"><b>SubTotal Neto no Objeto IVA:</b></td>
                                        <td align="center">{{data.subTotalNetoNoObjetoIva | currency:$}}</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="col-lg-2 col-md-6 col-sm-6 col-xs-6">
                        <div class="pull-right m-t-10 text-right">
                            <table class="table-condensed table-bordered" width="100%">
                                <tbody>
                                    <tr>
                                        <td width="50%"><b>Dsto:</b></td>
                                        <td align="center">
                                            <input ng-model="data.totalDescuento"
                                                   ng-disabled="gridOptionsDoc.data.length==0"
                                                   valid-number ng-blur="calcularDescuento()"
                                                   class="form-control form-control-sm" placeholder="0.00" />
                                        </td>
                                    </tr>
                                    <tr>
                                        <td width="50%"><b>ICE:</b></td>
                                        <td align="center">{{data.totalIce|currency:$}}</td>
                                    </tr>

                                    <tr>
                                        <td width="50%"><b>{{configTributaria.tipoIva}}:</b></td>
                                        <td align="center">{{data.iva|currency:$}}</td>
                                    </tr>
                                    <tr>
                                        <td width="50%"><b>IRBPNR:</b></td>
                                        <td align="center">{{data.irbpnr}}</td>
                                    </tr>
                                    <tr>
                                        <td width="50%"><b>PROPINA:</b></td>
                                        <td align="center">{{data.propina |currency:$}}</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="col-lg-3 col-md-3 col-sm-6 col-xs-6">
                        <div class="pull-right m-t-10 text-right">
                            <table class="table-condensed table-bordered" width="100%">
                                <tbody>
                                    <tr>
                                        <td>Transporte: </td>
                                        <td>
                                            <input type="number" ng-model="data.transporte" class="form-control form-control-sm" min="0" value="0" placeholder="0.00" />
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>Recargo: </td>
                                        <td>
                                            <input type="number" ng-model="data.recargo" class="form-control form-control-sm" min="0" value="0" placeholder="0.00" />
                                        </td>
                                    </tr>
                                    <tr>
                                        <td width="50%"><h4>TOTAL</h4></td>
                                        <td align="center"><h4 class="text-success">{{data.total + data.transporte + data.recargo | currency: $}}</h4></td>
                                    </tr>
                                    <tr>
                                        <td width="50%"><b>Observaciones</b></td>
                                        <td>
                                            <textarea ng-model="data.observacion" cols="3" rows="3" class="form-control"></textarea>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
            <div class="card-footer text-right">
                <button type="button" ng-click="crudDocumentoCompra(tipoOperacion)" class="btn btn-success text-white"><i class="{{icono}}"></i> {{btnModal}}</button>
                <button type="button" class="btn btn-dark waves-effect" ng-click="closeSection()">&times; Cerrar</button>
            </div>
        </div>
    </div>
</div>

<!-- Column -->