
@{
    ViewData["Title"] = "Logo";
}


<div ng-controller="entidadLogoCtrl">
    <div>
        <div class="row page-titles">
            <div class="col-md-5 align-self-center">
                <h4 class="text-themecolor">Logos</h4>
            </div>
            <div class="col-md-7 align-self-center text-right">
                <div class="d-flex justify-content-end align-items-center">
                    <button type="button" ng-if="accion.crear" ng-click="openModal(null,1)" class="btn btn-info  m-l-15">
                        <i class="ti-plus"></i> Nuevo
                    </button>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-lg-12">
                <md-card>
                    <md-table-container>
                        <table md-table>
                            <thead md-head>
                                <tr md-row>
                                    <th md-column>N°</th>
                                    <th md-column>Entidad</th>
                                    <th md-column>Imagen</th>
                                    <th md-column>MimeType</th>
                                    <th md-column>Nombre</th>
                                    <th md-column ng-if="accion.editar || accion.eliminar">Op</th>
                            </thead>
                            <tbody md-body>
                                <tr md-row ng-repeat="item in logos">
                                    <td md-cell>{{$index+1}}</td>
                                    <td md-cell>{{item.entidad}}</td>
                                    <td md-cell><img ng-src="data:{{item.mimeType}};base64,{{item.imagen}}" class="img-fluid" width="125" alt="Alternate Text" /></td>
                                    <td md-cell>{{item.mimeType}}</td>
                                    <td md-cell>{{item.nombreImagen}}</td>
                                    <td md-cell ng-if="accion.editar || accion.eliminar">
                                        <button type="button" ng-click="openModal(item,2)" ng-if="accion.editar" class="btn btn-outline-warning btn-sm btn-rounded  m-l-15">
                                            <i class="ti-pencil-alt"></i>
                                        </button>
                                        <button type="button" ng-if="accion.eliminar" ng-click="askToDelete(item)" class="btn btn-outline-danger btn-sm btn-rounded  m-l-15">
                                            <i class="ti-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </md-table-container>                                    
                </md-card>
            </div>
        </div>

        <div id="logoModal" class="modal fade" tabindex="-1" role="dialog">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <form name="formlogo" class="form-material" ng-submit="save()">
                        <div class="modal-header">
                            <h4 class="modal-title" id="myModalLabel"><i class="ti-plus"></i> Registrar Logo</h4>
                            <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                        </div>
                        <div class="modal-body">
                            <div class="row">
                                <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">
                                    <div class="form-group">
                                        <label>Entidad:</label>
                                        <select class="form-control" ng-model="logo.idEntidad" required>
                                            <option ng-value="item.idEntidad" ng-repeat="item in entidades">
                                                {{item.razonSocial}}
                                            </option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">
                                    <div class="form-group">
                                        <label>Formato de archivos: <span class="text-info">.png | .jpg</span> </label>
                                        <input type="file" class="form-control" ngf-select ng-model="file" name="file"
                                            ngf-pattern="'image/*'" ngf-accept="'image/*'" />
                                        <i ng-show="formFiles.file.$error.pattern" class="text-danger">
                                            Formato de archivo no aceptado
                                        </i>
                                    </div>
                                </div>
                            </div>
                            <div class="row" ng-show="tipoOperacion===2">
                                <div class="col-xl-6 col-lg-6 col-md-6 col-sm-6 col-12">
                                    <img src="data:{{logo.mimeType}};base64,{{logo.imagen}}" class="img-fluid" width="125" alt="Alternate Text" />
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="submit" class="btn btn-outline-success waves-effect waves-light">
                                <i class="ti-save"></i> Guardar
                            </button>
                            <button type="button" class="btn btn-outline-dark waves-effect" data-dismiss="modal">
                                &times;
                                Cerrar
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div id="modalUpdate" class="modal fade" tabindex="-1" role="dialog">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <form ng-submit="put()">
                        <div class="modal-header">
                            <h4 class="modal-title" id="myModalLabel"><i class="ti-pencil-alt"></i> Actualizar logo</h4>
                            <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                        </div>
                        <div class="modal-body">
                            <div class="row">
                                <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">
                                    <div class="form-group">
                                        <label for="contrasenia">Entidad:</label>
                                        <h5>{{logo.nombre}}</h5>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">
                                    <div class="form-group">
                                        <label for="contrasenia">Contraseña:</label>
                                        <input type="text" class="form-control" ng-model="logo.contrasenia" required />
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="submit" class="btn btn-outline-success waves-effect waves-light">
                                <i class="ti-save"></i> Guardar
                            </button>
                            <button type="button" class="btn btn-outline-dark waves-effect" data-dismiss="modal">
                                &times;
                                Cerrar
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
    <partial name="PageNotAccessible"/>
</div>
@section Scripts{
    <script src="~/js/controllers/admin/entidadLogoCtrl.min.js" asp-append-version="true"></script>
}