
@{
    ViewData["title"] = "Config Docs";
}
<div class="row page-titles">
    <div class="col-md-5 align-self-center">
        <h4 class="text-themecolor"> Configurar Documentos</h4>
    </div>
</div>

<div ng-controller="configDocCtrl">
    <div class="card">
        <div class="card-body"> 
            <div class="row">
                <div class="col-12">
                    <form ng-submit="saveDocConfig()" class="form-material">                       
                        <div class="row">
                            <div class="col-xl-4 col-lg-4 col-md-4 col-sm-4 col-12">
                                <div class="form-group">
                                    <label>Sucursal:</label>                                    
                                    <select class="form-control" ng-model="codEstab" ng-change="onChangeEstab()">     
                                        <option ng-value="item.codEstab" ng-repeat="item in establecimientos">{{item.nombreComercial}}</option>                                   
                                    </select>
                                </div>
                            </div>
                            <div class="col-xl-4 col-lg-4 col-md-4 col-sm-4 col-12">
                                <div class="form-group">
                                    <label>Puntos de Emisión:</label>
                                    <select id="idPuntoEmision" class="form-control" ng-model="idPuntoEmision" ng-change="getConfigDocs()">
                                        <option ng-value="item.idPuntoEmision" ng-repeat="item in puntosEmision">{{item.ptoEmi}}</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <md-divider></md-divider>
                        <md-table-container ng-show="configurationDocs.length>0">
                            <table md-table>
                                <thead md-head>
                                    <tr md-row>
                                        <th></th>
                                        <th md-column>Documento</th>
                                        <th md-column>Generar Nro.</th>
                                        <th md-column>Ultima Secuencia</th>
                                        <th md-column ng-if="accion.crear"></th>
                                    </tr>                                
                                </thead>
                                <tbody md-body>
                                    <tr md-row ng-repeat="item in configurationDocs">
                                        <td md-cell>{{$index+1}}</td>
                                        <td md-cell style="vertical-align:middle;">{{item.nombreDoc}}</td>
                                        <td md-cell>
                                            <md-switch ng-model="item.configDoc.generacionNro" aria-label="generarDoc">
                                            </md-switch>
                                        </td>
                                        <td md-cell style="vertical-align:middle;">
                                            <input type="number" ng-disabled="!item.configDoc.generacionNro" class="form-control" ng-model="item.configDoc.ultimaSecuencia" min="1" />
                                        </td>
                                        <td md-cell style="vertical-align:middle;" align="center" ng-if="accion.crear">
                                            <button type="button" class="btn btn-success btn-sm" ng-if="accion.crear" ng-disabled="!item.configDoc.ultimaSecuencia" ng-click="saveConfig(item)"><i class="ti-save"></i></button>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </md-table-container>
                    </form>
                    
                </div>
            </div>
        </div>
    </div> 
    <br />
</div> 

@section Scripts{
    <script src="~/js/controllers/config/configDocCtrl.min.js" asp-append-version="true"></script>
}