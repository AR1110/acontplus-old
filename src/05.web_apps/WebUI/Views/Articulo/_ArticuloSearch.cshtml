<style>
    .custom-container {
        max-width:700px !important;
        width:700px !important;
    }
    .standard-container,
.virtual-container {
  width: 300px;
}
    .autocomplete-custom-template-test li:last-child {
        border-bottom-width: 0;
    }

    .autocomplete-custom-template-test li {
        border-bottom: 1px solid #ccc;
        height: auto;
        padding-top: 1px;
        padding-bottom: 1px;
        white-space: normal;
    }

    .rtable #headerAutocompleteArticulo:hover{
        cursor: none;
        background-color: white;
    }

    .rtable .suggestion-articulo-1{  
        text-overflow: ellipsis;
        white-space: nowrap;
        max-width: 200px;
        width: 200px;            
    }   

    .table-box tr td {
        width: 1%;
        white-space: nowrap !important;
    }
    .table-box #bodySearch{
        justify-content: center;
    }
}

</style>

    <form ng-submit="$event.preventDefault()">        
        <md-autocomplete
        id="custom-template"   
        md-no-cache="true"                
        md-selected-item="ctrl.selectedItem"
        md-search-text-change="ctrl.searchTextChange(ctrl.searchText)"
        md-search-text="searchText"
        md-selected-item-change="searchArticulo.methods.selectArticleSearch(item)"
        md-items="item in searchArticulo.methods.getDynamicSearchArticles(searchText)"
        md-item-text="item.descripcion"
        md-min-length="0"
        md-escape-options="clear"
        input-aria-label="Current Repository"
        placeholder="Pick an Angular repository"
         
         md-menu-class="autocomplete-virtual-template"
            md-menu-container-class="virtual-container"
            md-mode="virtual"> 
        <md-item-template>
            <div class="table-responsive">
                <table class="table-box browser no-border table-sm rtable">
                    <thead ng-if="item.showHeader">
                        <tr id="headerAutocompleteArticulo">
                            <th>Codigo</th>
                            <th>Descripcion</th>                                                 
                            <th>Stock</th>
                            <th>Iva</th>                               
                            <th>SubFamilia</th>                               
                            <th>Medida</th>                               
                            <th>Marca</th>                               
                            <th>Modelo</th>                               
                        </tr>
                    </thead>
                    <tbody>
                        <tr id="bodySearch">                            
                            <td class="suggestion-codigo">                        
                                {{ item.codigo }}
                            </td>
                            <td  class="suggestion-articulo-1">
                                {{ item.descripcion }}
                            </td>
                            <td class="suggestion-column text-center">
                                <h6><span class="{{item.style}}">{{ item.stock}} </span></h6>
                            </td> 
                            <td class="suggestion-column text-center">
                                {{ item.iva}}
                            </td>   
                            <td class="suggestion-column text-center">
                                {{ item.subFamilia}}
                            </td> 
                            <td class="suggestion-column text-center">
                                {{ item.medida}}
                            </td>
                            <td class="suggestion-column text-center">
                                {{ item.marca}}
                            </td>
                            <td class="suggestion-column text-center">
                                {{ item.modelo}}
                            </td>                                                                                                          
                        </tr>
                    </tbody>
                </table>                
            </div>
