<div class="modal-header">
    <h5 class="modal-title">Articulo Imagenes</h5>
    <button class="close" ng-click="$ctrl.closeModal()">&times;</button>
</div>
<div class="modal-body">
    <div class="row">
        <div class="col-lg-8 col-md-8 col-sm-12 col-12">
            <div class="card">
                <div class="card-body">
                    <div id="carouselExampleIndicators2" class="carousel slide" data-ride="carousel">
                        <ol class="carousel-indicators" ng-hide="$ctrl.imagenes.length==1">
                            <li data-target="#carouselExampleIndicators2" data-slide-to="0" class="active"></li>
                            <li data-target="#carouselExampleIndicators2" data-slide-to="1"></li>
                            <li data-target="#carouselExampleIndicators2" data-slide-to="2"></li>
                        </ol>
                        <div class="carousel-inner" role="listbox">
                            <div class="carousel-item {{$index==0?'active':''}}" ng-repeat="file in $ctrl.imagenes">                                            
                                <img class="img-responsive" ng-src="{{file.imagen}}" height="100" alt="{{file.nombreImagen}}">
                            </div>                                       
                        </div>
                        <a class="carousel-control-prev" ng-hide="$ctrl.imagenes.length==1" href="#carouselExampleIndicators2" role="button" data-slide="prev">
                            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                            <span class="sr-only">Previous</span>
                        </a>
                        <a class="carousel-control-next" ng-hide="$ctrl.imagenes.length==1" href="#carouselExampleIndicators2" role="button" data-slide="next">
                            <span class="carousel-control-next-icon" aria-hidden="true"></span>
                            <span class="sr-only">Next</span>
                        </a>
                    </div>
                    <div class="p-t-20 p-b-20">
                        <h4 class="card-title">{{$ctrl.data.descripcion}}</h4>                                    
                    </div>
                    <hr class="m-0">                               
                </div>
            </div>                       
        </div>
        <div class="col-lg-4 col-md-4 col-sm-12 col-12">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Tarifas</h5>                                
                    <div class="table-responsive">
                        <table class="table table-condensed table-sm">
                            <tbody class="text-dark">
                                <tr ng-repeat="item in $ctrl.tarifas">
                                    <td>{{item.tarifa}}</td>
                                    <td>${{item.precioConIva}}</td>
                                </tr>                                                    
                            </tbody>
                        </table>
                    </div>
                    
                    <div class="row">
                        <div class="col-lg-3">
                            <strong>Stock: </strong>
                            <h4>{{$ctrl._params.stock}}</h4>
                        </div>
                        <div class="col-lg-9">
                            <strong>Observación: </strong><br>
                            <span>{{$ctrl.data.observaciones}}</span>
                        </div>
                    </div>                               
                </div>
            </div>                                                
        </div>
    </div>
</div>
<div class="modal-footer">
    <button class="btn btn-dark" ng-click="$ctrl.closeModal()" >&times; Cerrar</button>
</div>