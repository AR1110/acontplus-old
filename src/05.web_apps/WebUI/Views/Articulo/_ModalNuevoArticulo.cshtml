<div class="modal-header">
    <h5 class="modal-title">{{$ctrl.tipoRegistro==1?'Nuevo': 'Editar'}} Articulo</h5>
    <button class="close" ng-click="$ctrl.closeModal()">&times;</button>
</div>
<div class="modal-body">

    <uib-tabset>
        <uib-tab index="0" heading="General">
            <div class="card">
                <div class="card-body border-mb">

                    <div class="row">
                        <div class="col-xl-6 col-lg-6 col-md-12 col-sm-12 col-12">
                            <div class="form-group">
                                <label class="form-control-label" for="descripcion">Nombre Articulo: <span
                                        class="text-danger">*</span> </label>
                                <input type="text" autocomplete="off" ng-model="$ctrl.data.descripcion"
                                    name="articuloDescripcion" touppercase class="form-control border-select"
                                    placeholder="Ej: Laptop-HP">
                            </div>
                        </div>

                        <div class="col-xl-6 col-lg-6 col-md-12 col-sm-12 col-12">
                            <div class="form-group ">
                                <label class="control-label">Sub Familia: <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <select class="form-control border-select" ng-model="$ctrl.data.idSubFamilia"
                                        ng-change="$ctrl.getArticuloCodigo()"
                                        ng-options="sf.idSubFamilia as sf.subFamilia group by sf.familia  for sf in $ctrl.subFamilias">
                                    </select>
                                    <div class="input-group-append">
                                        <button class="btn btn-outline-secondary btn-sm" btn-add-update-sub-familia results="$ctrl.resultModalSubFamilia(item)" type="button" tabindex="-1">
                                            <i class="fa fa-plus fa-xs"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row" ng-show="$ctrl.tipoRegistro===1">
                        <div class="col-xl-6 col-lg-6 col-md-12 col-sm-12 col-12">
                            <div class="row">
                                <div class="col-xl-4 col-lg-4 col-md-6 col-sm-12 col-12">
                                    <div class="form-group">
                                        <label for="">Código: <span class="text-danger">*</span></label>
                                        <input type="text" ng-model="$ctrl.data.codigo" ng-focus="delayFocus('.codigo')"
                                            class="form-control border-select codigo" placeholder="Ej: COM050">
                                    </div>
                                </div>

                                <div class="col-xl-4 col-lg-4 col-md-6 col-sm-12 col-12">
                                    <div class="form-group">
                                        <label for="">Código Aux: </label>
                                        <input type="text" ng-model="$ctrl.data.codigoAuxiliar"
                                            ng-focus="delayFocus('.codigoAuxiliar')"
                                            class="form-control border-select codigoAuxiliar" placeholder="Ej: COM050">
                                    </div>
                                </div>

                                <div class="col-xl-4 col-lg-4 col-md-12 col-sm-12 col-12">
                                    <div class="form-group">
                                        <label for="">Código de Barra: <span class="text-danger">*</span> </label>
                                        <div class="input-group">
                                            <input type="text" class="form-control border-select codigoBarra"
                                                ng-focus="delayFocus('.codigoBarra')" ng-model="$ctrl.data.codigoBarra"
                                                touppercase placeholder="H20089" value="" />
                                            <div class="input-group-append">
                                                <button class="btn btn-outline-secondary" ng-click="$ctrl.getBarcode()">
                                                    <i class="fas fa-barcode"></i>
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-xl-6 col-lg-6 col-md-12 col-sm-12 col-12">
                            <div class="row">
                                <div class="col-xl-6 col-lg-6 col-md-6 col-sm-12 col-12">
                                    <div class="form-group">
                                        <label for="">Tipo Artículo: <span class="text-danger">*</span> </label>
                                        <select class="form-control border-select tipoArticulo"
                                            ng-model="$ctrl.data.idTipoArticulo" ng-focus="delayFocus('.tipoArticulo')">
                                            <option ng-value="item.idTipoArticulo"
                                                ng-repeat="item in $ctrl.tipoArticulos">{{item.descripcion}}</option>
                                        </select>
                                    </div>
                                </div>

                                <div class="col-xl-6 col-lg-6 col-md-6 col-sm-12 col-12">
                                    <div class="form-group">
                                        <label for="">U. Medida</label>
                                        <div class="input-group">
                                            <select class="form-control border-select medida"
                                                ng-model="$ctrl.data.idMedida" ng-focus="delayFocus('.medida')">
                                                <option ng-value="item.idMedida" ng-repeat="item in $ctrl.medidas">
                                                    {{item.descripcion}}</option>
                                            </select>
                                            <div class="input-group-append">
                                                <button class="btn btn-outline-secondary btn-sm" btn-add-update-medida results="$ctrl.resultModalMedida(item)" tabindex="-1"><i
                                                        class="fa fa-plus fa-xs"></i></button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>


                    <div class="row" ng-show="$ctrl.tipoRegistro===1">
                        <div class="form-group col-lg-2 col-md-6 col-sm-6 col-12">
                            <label for="">Tipo Iva: </label>
                            <select class="form-control border-select tipoIva" ng-model="$ctrl.tipoIva"
                                ng-change="$ctrl.recalculateTarifaAdd()" ng-focus="delayFocus('.tipoIva')"
                                ng-options="ti as ti.descripcion for ti in $ctrl.tipoIvas track by ti.idTipoIva">
                            </select>
                        </div>
                        <div class="form-group col-lg-2 col-md-6 col-sm-6 col-xs-6">
                            <label for="">Precio Costo: <span class="text-danger">*</span></label>
                            <input type="text" class="form-control border-select precioCosto" decimal
                                ng-focus="delayFocus('.precioCosto')" ng-model="$ctrl.data.precioCosto"
                                ng-blur="$ctrl.redondearPrecioCosto()" ng-change="$ctrl.recalculateTarifaAdd()"
                                placeholder="0.00">
                        </div>
                        <div class="form-group col-lg-2 col-md-6 col-sm-6 col-12 text-center ">
                            <label>Inventario: </label>
                            <div class="icheck-primary ">
                                <input type="checkbox" id="llevarInventarioAgregar1" name="llevarInventarioAgregar1"
                                    ng-model="$ctrl.data.llevaInventario" />
                                <label for="llevarInventarioAgregar1"></label>
                            </div>
                        </div>
                        <div class="form-group col-lg-2 col-md-3 col-sm-6 col-12 text-center">
                            <label>Adicionales: </label>
                            <div class="icheck-primary">
                                <input type="checkbox" id="datosAdicionalesAgregar1" name="datosAdicionalesAgregar1"
                                    ng-model="$ctrl.data.datosAdicionales" />
                                <label for="datosAdicionalesAgregar1"></label>
                            </div>
                        </div>
                        <div class="form-group col-lg-2 col-md-3 col-sm-6 col-12 text-center"
                            ng-show="$ctrl.data.datosAdicionales">
                            <label>Etiqueta: </label>
                            <select ng-model="$ctrl.data.idEtiqueta" class="form-control">
                                <option ng-value="item.idEtiqueta"
                                    ng-repeat="item in $ctrl.etiquetaActividades">{{item.descripcion}}</option>
                            </select>
                        </div>
                        <div class="form-group col-lg-2 col-md-3 col-sm-6 col-12 text-center">
                            <label for="">Fraccionable: </label>
                            <div class="icheck-primary">
                                <input type="checkbox" id="productoFraccionableAgregar1"
                                    name="productoFraccionableAgregar1" ng-model="$ctrl.data.productoFraccionable" />
                                <label for="productoFraccionableAgregar1"></label>
                            </div>
                        </div>
                    </div>

                    <!--ACTUALIZAR-->
                    <div ng-show="$ctrl.tipoRegistro==2">

                        <div class="row">
                            <div class="form-group col-lg-3 col-md-2 col-sm-6 col-xs-6">
                                <label for="">Código: <span class="text-danger">*</span></label>
                                <input type="text" ng-model="$ctrl.data.codigo"
                                    class="form-control border-select codigoUpdate"
                                    ng-focus="delayFocus('.codigoUpdate')" placeholder="Ej: COM050">
                            </div>
                            <div class="form-group col-lg-2 col-md-2 col-sm-6 col-xs-6">
                                <label for="">Código Aux: </label>
                                <input type="text" ng-model="$ctrl.data.codigoAuxiliar"
                                    class="form-control border-select codigoAuxiliarUp"
                                    ng-focus="delayFocus('.codigoAuxiliarUp')" placeholder="Ej: COM050">
                            </div>
                            <div class="form-group col-lg-2 col-md-2">
                                <div class="form-group">
                                    <label for="">Código de Barra: <span class="text-danger">*</span> </label>
                                    <div class="input-group">
                                        <input type="text" class="form-control border-select codigoBarraUp"
                                            ng-focus="delayFocus('.codigoBarraUp')" ng-model="$ctrl.data.codigoBarra"
                                            touppercase placeholder="H20089" value="" />
                                        <div class="input-group-append">
                                            <button class="btn btn-outline-secondary" ng-click="$ctrl.getBarcode()">
                                                <i class="fas fa-barcode"></i>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="form-group col-lg-2 col-md-4 col-sm-6 col-xs-6">
                                <label for="">Tipo Artículo: <span class="text-danger">*</span> </label>
                                <select class="form-control border-select tipoArticulo"
                                    ng-model="$ctrl.data.idTipoArticulo" ng-focus="delayFocus('.tipoArticulo')">
                                    <option ng-value="item.idTipoArticulo" ng-repeat="item in $ctrl.tipoArticulos">
                                        {{item.descripcion}}</option>
                                </select>
                            </div>

                            <div class="form-group col-lg-3 col-md-4 col-sm-6 col-xs-6">
                                <label for="">U. Medida</label>
                                <div class="input-group">
                                    <select class="form-control border-select medida" ng-model="$ctrl.data.idMedida"
                                        ng-focus="delayFocus('.medida')">
                                        <option ng-value="item.idMedida" ng-repeat="item in $ctrl.medidas">
                                            {{item.descripcion}}</option>
                                    </select>
                                    <div class="input-group-append">
                                        <button class="btn btn-outline-secondary btn-sm" btn-add-update-medida results="$ctrl.resultModalMedida(item)" tabindex="-1"><i
                                                class="fa fa-plus fa-xs"></i></button>
                                    </div>
                                </div>
                            </div>
                        </div>


                        <div class="row">
                            <div class="form-group col-lg-2 col-md-2 col-sm-6 col-xs-6">
                                <label>Adicionales: </label>
                                <div class="icheck-primary">
                                    <input type="checkbox" id="datosAdicionalesUpdate" name="datosAdicionalesUpdate"
                                        ng-model="$ctrl.data.datosAdicionales" />
                                    <label for="datosAdicionalesUpdate"></label>
                                </div>
                            </div>

                            <div class="form-group col-lg-2 col-md-2 col-sm-4 col-xs-6 text-center"
                                ng-show="$ctrl.data.datosAdicionales">
                                <label>Etiqueta: </label>
                                <select ng-model="$ctrl.data.idEtiqueta" class="form-control">
                                    <option ng-value="item.idEtiqueta"
                                        ng-repeat="item in $ctrl.etiquetaActividades">{{item.descripcion}}</option>
                                </select>
                            </div>

                            <div class="form-group col-lg-2 col-md-2 col-sm-6 col-xs-6 text-center">
                                <label for="">Llevar Inventario: </label>
                                <div class="icheck-primary">
                                    <input type="checkbox" id="llevaInventarioUpdate" name="llevaInventarioUpdate"
                                        ng-model="$ctrl.data.llevaInventario" />
                                    <label for="llevaInventarioUpdate"></label>
                                </div>
                            </div>
                            <div class="form-group col-lg-2 col-md-2 col-sm-6 col-xs-6 text-center">
                                <label for="">Fraccionable: </label>
                                <div class="icheck-primary">
                                    <input type="checkbox" id="productoFraccionableUpdate"
                                        name="productoFraccionableUpdate" ng-model="$ctrl.data.productoFraccionable" />
                                    <label for="productoFraccionableUpdate"></label>
                                </div>
                            </div>
                            <div class="form-group col-lg-3 col-md-3 col-sm-6 col-xs-6">
                                <label for="">Estado: </label>
                                <md-switch ng-model="$ctrl.data.estado" aria-label="Estado">
                                    {{ $ctrl.data.estado?'Activo':'Inactivo' }}
                                </md-switch>
                            </div>
                        </div>

                        <div class="row">
                            <div class="form-group col-lg-2 col-md-2 col-sm-6 col-xs-6">
                                <label for="">Tipo Iva: </label>
                                <select class="form-control border-select tipoIva" ng-model="$ctrl.tipoIva"
                                    ng-change="$ctrl.recalculateTarifaAdd()" ng-focus="delayFocus('.tipoIva')"
                                    ng-disabled="!$ctrl.articlePermission.precio.update"
                                    ng-options="ti as ti.descripcion for ti in $ctrl.tipoIvas track by ti.idTipoIva">
                                </select>
                            </div>
                            <div class="form-group col-lg-3 col-md-3 col-sm-6 col-xs-6"
                                ng-if="$ctrl.articlePermission.precio.update">
                                <label for="">Precio Costo: <span class="text-danger">*</span></label>
                                <input type="number" class="form-control precioCostoUp"
                                    ng-disabled="$ctrl.opcionCalculate==undefined"
                                    ng-focus="$ctrl.delayFocus('.precioCostoUp')"
                                    ng-change="$ctrl.recalculateTarifaUpdate()" ng-model="$ctrl.data.precioCosto"
                                    step="any" placeholder="0.00">
                            </div>
                            <!--Opcion para calcular pvp-tarifas-->
                            <div class="col-lg-3 col-md-3 col-sm-6 col-xs-6 mt-4"
                                ng-if="$ctrl.articlePermission.precio.update">
                                <md-radio-group layout="row" ng-model="$ctrl.opcionCalculate">
                                    <md-radio-button value="optionPvp" class="md-primary">PVP</md-radio-button>
                                    <md-radio-button value="optionPorcentaje"> % Util </md-radio-button>
                                </md-radio-group>
                            </div>
                        </div>
                    </div>


                    <div class="row">
                        <div class="col-xl-10 col-lg-10 col-md-10 col-sm-12 col-12">
                            <div ui-grid="$ctrl.gridOptions" ui-grid-edit ui-grid-resize-columns ui-grid-cellNav
                                ui-grid-auto-resize class="grid"></div>
                        </div>
                    </div>
                </div>

            </div>
        </uib-tab>


        <!--DATOS ADICIONALES-->
        <uib-tab index="1" heading="Datos Adicionales" select="$ctrl.onTabArticulo(2)">
            <div class="card">
                <div class="card-body">
                    <p><b class="text-info">Articulo: </b> <b class="text-success">{{$ctrl.data.descripcion}}</b></p>
                    <div class="row">
                        <div class="form-group col-lg-4 col-md-4 col-sm-6 col-12">
                            <label for="">Marca: </label>
                            <div class="input-group">
                                <select class="form-control border-select" ng-model="$ctrl.data.idMarca">
                                    <option ng-value="item.idMarca" ng-repeat="item in $ctrl.marcas">
                                        {{item.descripcion}}</option>
                                </select>
                                <div class="input-group-append">
                                    <button class="btn btn-outline-secondary btn-sm" btn-add-update-marca results="$ctrl.resultModalMarca(item)"
                                        tabindex="-1"><i class="fa fa-plus fa-xs"></i></button>
                                </div>
                            </div>
                        </div>
                        <div class="form-group col-lg-4 col-md-4 col-sm-6 col-12">
                            <label for="">Modelo: </label>
                            <div class="input-group">
                                <select class="form-control border-select" ng-model="$ctrl.data.idModelo"
                                    ng-options="m.idModelo as m.modelo group by m.marca for m in $ctrl.modelos">
                                </select>
                                <div class="input-group-append">
                                    <div class="input-group-append">
                                        <button class="btn btn-outline-secondary btn-sm" btn-add-update-modelo results="$ctrl.resultModalModelo(item)" tabindex="-1"><i
                                                class="fa fa-plus fa-xs"></i></button>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="form-group col-lg-4 col-md-4 col-sm-6 col-12">
                            <label for="">ICE: </label>
                            <select class="form-control border-select" ng-model="$ctrl.data.idTipoIce">
                                <option ng-value="item.idTipoIce" ng-repeat="item in $ctrl.tipoIces">
                                    {{item.descripcion}}</option>
                            </select>
                        </div>
                        @*<div class="form-group col-lg-2 col-md-1 col-sm-6 col-xs-6">
                        <label for="">Valor.: </label>
                        <input type="text" ng-model="tipoIce.valor" class="form-control" placeholder="0">
                        </div>*@
                    </div>
                    <div class="row">
                        <div class="form-group col-lg-4 col-md-3 col-sm-6 col-xs-6">
                            <label>Stock Mínimo: </label>
                            <input type="text" class="form-control" value="1" ng-model="$ctrl.data.stockMinimo"
                                valid-number placeholder="0">
                        </div>
                        <div class="form-group col-lg-4 col-md-3 col-sm-6 col-xs-6">
                            <label for="">Stock Máximo: </label>
                            <input type="text" class="form-control" value="2" ng-model="$ctrl.data.stockMaximo"
                                valid-number placeholder="0">
                        </div>
                        <div class="form-group col-lg-4 col-md-4 col-sm-6 col-xs-6">
                            <label for="">Observación: </label>
                            <textarea name="textarea" ng-model="$ctrl.data.observaciones"
                                class="form-control"></textarea>
                        </div>
                    </div>
                    <hr />

                    <!--Ubicacion-->
                    <div class="row" ng-show="$ctrl.tipoOperacion==1">
                        <div class="form-group col-lg-6 col-md-6 col-sm-6 col-xs-6">
                            <label for="">Bodega: </label>
                            <select class="custom-select border-select" ng-model="$ctrl.data.idBodega">
                                <option ng-value="item.idBodega" ng-repeat="item in $ctrl.bodegas">{{item.descripcion}}
                                </option>
                            </select>
                        </div>
                        <div class="form-group col-lg-6 col-md-6 col-sm-6 col-xs-6">
                            <label for="">Ubicación</label>
                            <input type="text" ng-model="articuloUbicacion.ubicacion" class="form-control"
                                placeholder="Ej: S/N" />
                        </div>
                    </div>

                    <div class="row">
                        <div class="form-group col-lg-6 col-md-6 col-sm-6 col-xs-6">
                            <label><b>¿El producto tiene fecha de caducidad?</b> </label>
                            <div class="icheck-primary ">
                                <input type="checkbox" id="fechaCaducidadProducto" ng-model="$ctrl.data.caducidad" />
                                <label for="fechaCaducidadProducto"></label>
                            </div>
                            <div ng-show="$ctrl.data.caducidad">
                                <label for="">Fecha de Caducidad: <span class="text-danger">*</span> </label>
                                <input type="date" ng-model="$ctrl.data.fechaCaducidad" class="form-control" />

                            </div>
                        </div>
                        <div class="form-group col-lg-6 col-md-6 col-sm-6 col-xs-6">
                            <label><b>¿El producto posee lote?</b> </label>
                            <div class="icheck-primary ">
                                <input type="checkbox" id="datosLoteAgregar" ng-model="$ctrl.data.datosLote" />
                                <label for="datosLoteAgregar"></label>
                            </div>
                            <div ng-show="$ctrl.data.datosLote">
                                <label for="">Lote: <span class="text-danger">*</span> </label>
                                <input type="text" ng-model="$ctrl.data.lote" class="form-control"
                                    placeholder="LO-01" />

                                <label for="">Fecha Creación: <span class="text-danger">*</span> </label>
                                <input type="date" ng-model="$ctrl.data.fechaCreacion" class="form-control" />

                                <label for="">Fecha Caducidad: <span class="text-danger">*</span> </label>
                                <input type="date" ng-model="$ctrl.data.fechaCaducidadLote" class="form-control" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </uib-tab>

        <!--CÓDIGOS BARRAS-->
        <uib-tab index="2" heading="Código de Barras" select="$ctrl.onTabArticulo(3)" ng-show="$ctrl.tipoRegistro===2">
            <div class="card border border mt-2">
                <div class="card-body">
                    <div class="row">
                        <div class="col-lg-4 col-md-4 col-sm-4 col-12 border-right">
                            <div class="row">
                                <div class="col-lg-12 col-md-12 col-sm-12 col-12">
                                    <div class="form-group">
                                        <label>Medida: <span class="text-danger">*</span></label>
                                        <div class="input-group">
                                            <select class="form-control border-select"
                                                ng-model="$ctrl._cb.data.idMedida">
                                                <option ng-value="item.idMedida" ng-repeat="item in $ctrl.medidas">
                                                    {{item.descripcion}}</option>
                                            </select>
                                            <div class="input-group-append" id="button-addon4">
                                                <button class="btn btn-outline-secondary btn-sm" btn-add-update-medida results="$ctrl.resultModalMedida(item)" tabindex="-1"><i
                                                        class="fa fa-plus fa-xs"></i></button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-lg-12 col-md-12 col-sm-12 col-12">
                                    <div class="form-group">
                                        <label for="">Código Barra: <span class="text-danger">*</span></label>
                                        <input type="text" ng-model="$ctrl._cb.data.codigoBarra" touppercase
                                            class="form-control" placeholder="C. Barra">
                                    </div>
                                </div>

                                <div class="col-lg-12 col-md-12 col-sm-12 col-12">
                                    <div class="form-group">
                                        <label>Descripción: </label>
                                        <input type="text" ng-model="$ctrl._cb.data.descripcion" touppercase
                                            class="form-control" placeholder="Descripción">
                                    </div>
                                </div>
                                <div class="col-lg-12 col-md-12 col-sm-12 col-12 nopadding">
                                    <div class="form-group">
                                        <label>Color: </label>
                                        <input type="color" ng-model="$ctrl._cb.data.color" class="form-control" />
                                    </div>
                                </div>
                                <div class="ml-auto">
                                    <button class="btn btn-success" ng-click="$ctrl._cb.saveUpdate()">
                                        <i class="{{$ctrl._cb.tipoRegistro==1?'ti-save':'ti-pencil'}}"></i>
                                        {{$ctrl._cb.tipoRegistro===1?'Guardar':'Actualizar'}}
                                    </button>
                                    <button class="btn btn-dark" ng-click="$ctrl._cb.reset()"> Limpiar</button>
                                </div>
                            </div>

                        </div>

                        <div class="col-lg-8 col-md-8 col-sm-8 col-12">
                            <div class="card">
                                <div class="card-body">
                                    <div class="table-responsive">
                                        <table class="table table-condensed table-sm">
                                            <thead>
                                                <tr>
                                                    <th>N°</th>
                                                    <th>Codigo Barra</th>
                                                    <th>Descripcion</th>
                                                    <th>Medida</th>
                                                    <th>Color</th>
                                                    <th>Accion</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <tr ng-repeat="item in $ctrl._cb.articuloCodigoBarras">
                                                    <td>{{$index+1}}</td>
                                                    <td>{{item.codigoBarra}}</td>
                                                    <td>{{item.descripcion}}</td>
                                                    <td>{{item.medida}}</td>
                                                    <td>
                                                        <div ng-style="$ctrl._cb.coloresCodigoBarra(item)"></div>
                                                    </td>
                                                    <td>
                                                        <a class="text-success"
                                                            ng-click="$ctrl._cb.editarCodigoBarra(item)"
                                                            href="javascript:;" title="Editar">
                                                            <i class="fa fa-edit"></i>
                                                        </a>
                                                        <a ng-hide="cba.codigoPrincipal==1" class="text-danger"
                                                            ng-click="$ctrl._cb.deleteArtCodeBarra(item)"
                                                            href="javascript:void(0);" title="Eliminar">
                                                            <i class="fa fa-trash"></i>
                                                        </a>
                                                    </td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </uib-tab>

        <!--UBICACIONES-->
        <uib-tab index="4" heading="Ubicación" select="$ctrl.onTabArticulo(4)">
            <!--Agregar-->
            <div class="card-body" ng-if="$ctrl.tipoRegistro===1">
                <div class="row">
                    <div class="col-xl-4 col-lg-4 col-md-4 col-sm-12 col-12">
                        <div class="form-group">
                            <label for="">Establecimientos: <span class="text-danger">*</span> </label>
                            <select class="form-control" ng-model="$ctrl.data.codEstab"
                                ng-change="$ctrl.onChangeEstablecimiento()">
                                <option ng-value="item.codEstab" ng-repeat="item in $ctrl.establecimientos">
                                    {{item.nombreComercial}}
                                </option>
                            </select>
                        </div>
                    </div>

                    <div class="col-xl-4 col-lg-4 col-md-4 col-sm-12 col-12">
                        <div class="form-group">
                            <label for="">Bodega: <span class="text-danger">*</span> </label>
                            <select class="form-control" ng-model="$ctrl.data.idBodega">
                                <option ng-value="item.idBodega" ng-repeat="item in $ctrl.bodegas">{{item.descripcion}}
                                </option>
                            </select>
                        </div>
                    </div>

                    <div class="col-xl-4 col-lg-4 col-md-4 col-sm-12 col-12">
                        <div class="form-group">
                            <label for="">Ubicación <span class="text-danger">*</span></label>
                            <input type="text" ng-model="$ctrl.data.ubicacion" class="form-control border-select"
                                placeholder="Ej: S/N" />
                        </div>
                    </div>
                </div>
            </div>



            <!--Actualizar-->
            <div class="card-body" ng-if="$ctrl.tipoRegistro===2">
                <div class="row">
                    <div class="col-lg-4 col-md-4 col-sm-4 col-12 border-right">
                        <div class="row">
                            <div class="col-lg-12 col-md-12 col-sm-12 col-12">
                                <div class="form-group">
                                    <label for="">Establecimientos: <span class="text-danger">*</span> </label>
                                    <select class="form-control" ng-model="$ctrl._aUbic.data.codEstab"
                                        ng-change="$ctrl._aUbic.onChangeEstablecimiento()">
                                        <option ng-value="item.codEstab"
                                            ng-repeat="item in $ctrl._aUbic.establecimientos">
                                            {{item.nombreComercial}}
                                        </option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-lg-12 col-md-12 col-sm-12 col-12">
                                <div class="form-group">
                                    <label for="">Bodega: <span class="text-danger">*</span> </label>
                                    <select class="form-control" ng-model="$ctrl._aUbic.data.idBodega">
                                        <option ng-value="item.idBodega" ng-repeat="item in $ctrl._aUbic.bodegas">
                                            {{item.descripcion}}</option>
                                    </select>
                                </div>
                            </div>

                            <div class="col-lg-12 col-md-12 col-sm-12 col-12">
                                <div class="form-group">
                                    <label for="">Ubicación <span class="text-danger">*</span></label>
                                    <input type="text" ng-model="$ctrl._aUbic.data.ubicacion"
                                        class="form-control border-select" placeholder="Ej: S/N" />
                                </div>
                            </div>

                            <div class="ml-auto">
                                @* ng-click="$ctrl._aUbic.saveUpdate()" *@
                                <button class="btn btn-success" ng-click="$ctrl._aUbic.saveUpdate()">
                                    <i class="{{$ctrl._aUbic.tipoRegistro==1?'ti-save':'ti-pencil'}}"></i>
                                    {{$ctrl._aUbic.tipoRegistro==1?'Guardar':'Actualizar'}}
                                </button>
                                <button type="button" class="btn btn-dark" ng-click="$ctrl._aUbic.reset()">
                                    Limpiar
                                </button>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-8 col-md-8 col-sm-8 col-12">
                        <div class="table-responsive">
                            <table class="table table-condensed table-sm">
                                <thead>
                                    <tr>
                                        <th>N°</th>
                                        <th>Bodega</th>
                                        <th>Ubicación</th>
                                        <th>Op.</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr ng-repeat="item in $ctrl._aUbic.articuloUbicaciones">
                                        <td>{{$index+1}}</td>
                                        <td>{{item.descripcion}}</td>
                                        <td>{{item.ubicacion}}</td>
                                        <td>
                                            <a class="text-success" ng-click="$ctrl._aUbic.editUbicacionArt(item)"
                                                href="javascript:;" title="Editar">
                                                <i class="fa fa-edit"></i>
                                            </a>
                                            <a class="text-danger" ng-click="$ctrl._aUbic.deleteUbicacionArt(item)"
                                                href="javascript:;" title="Eliminar">
                                                <i class="fa fa-trash"></i>
                                            </a>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </uib-tab>
    </uib-tabset>


</div>
<div class="modal-footer">
    <button type="button" class="btn btn-success"
        ng-click="$ctrl.saveUpdateArticulo()">{{$ctrl.tipoRegistro==1?'Guardar':'Actualizar'}}</button>
    <button type="button" class="btn btn-dark" ng-click="$ctrl.closeModal()">&times; Cerrar</button>
</div>