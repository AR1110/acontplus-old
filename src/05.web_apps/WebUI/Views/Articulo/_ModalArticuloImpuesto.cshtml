<div class="modal-header">
    <h4 class="modal-title">Gestión de Impuesto Articulos</h4>
    <button type="button" class="close" ng-click="$ctrl.closeModal()">&times;</button>
</div>               
<div class="modal-body">
    <h4 class="text-center">Articulo: <strong>{{$ctrl._params.descripcion}}</strong></h4>

    <div class="row">
        <div class="col-lg-4 col-md-4 col-sm-4 col-xs-12 border-right">
            <div class="row">
                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                    <div class="form-group">      
                        <label for="contribuyente">Contribuyente <span class="text-danger">*</span></label>
                        <select class="form-control" ng-model="$ctrl.data.idSubContribuyente"
                                ng-options="sc.subContribuyente.idSubContribuyente as sc.subContribuyente.descripcion group by sc.tipoContribuyente.descripcion for sc in $ctrl.subContribuyentes ">
                        </select>        
                    </div>
                </div>
                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                    <div class="form-group">        
                        <label for="tipo-impuesto">Tipo Impuesto <span class="text-danger">*</span></label>
                        <select class="form-control" ng-model="$ctrl.data.idTipoImpuestoRenta" ng-change="$ctrl.getImpuestoByTipoImpuesto()">
                            <option ng-value="item.idTipoImpuestoRenta" ng-repeat="item in $ctrl.tipoImpuestos">{{item.descripcion}}</option>
                        </select>        
                    </div>                    
                </div>
                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                    <div class="form-group">
                        <label>Impuesto <span class="text-danger">*</span></label>
                        <select class="form-control" ng-model="$ctrl.data.idRetencionRenta">
                            <option ng-value="item.idRetencionRenta" ng-repeat="item in $ctrl.impuestos">{{item.descripcion}}</option>
                        </select>        
                    </div>                    
                </div>
                
                <button class="btn btn-success ml-5" ng-click="$ctrl.saveUpdate()"><i class="{{$ctrl.data.tipoRegistro==1?'ti-save':'ti-pencil'}}"></i> {{$ctrl.data.tipoRegistro==1?'Guardar':'Actualizar'}}</button>
                <button class="btn btn-secondary ml-2" ng-click="$ctrl.reset()"> Limpiar</button>
            </div>            
        </div>


        <div class="col-lg-8 col-md-8 col-sm-8 col-xs-12">
            <div class="table-responsive">
                <table class="table table-sm" width="100%">
                    <thead>
                        <tr>
                            <th>N°</th>
                            <th>Contribuyente</th>
                            <th>Impuesto</th>
                            <th>Op.</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="ia in $ctrl.articuloImpuestos">
                            <td>{{$index+1}}</td>
                            <td>{{ia.subContribuyente}}</td>
                            <td>{{ia.nombreRetencionRenta}}</td>
                            <td>                            
                                <a href="javascript:void(0)" ng-click="$ctrl.updateImpuestoArticulo(ia)" class="text-info"><i class="fa fa-edit"></i></a>
                                <a href="javascript:void(0)" ng-click="$ctrl.eliminarImpuestoArticulo(ia.impuestoArticulo)" class="text-danger"><i class="fa fa-trash"></i></a>
                            </td>

                        </tr>
                    </tbody>
                </table>
            </div>            
        </div>
    </div>     

</div>
<div class="modal-footer">                    
    <button type="button" class="btn btn-dark" ng-click="$ctrl.closeModal()">&times; Cerrar</button>
</div>