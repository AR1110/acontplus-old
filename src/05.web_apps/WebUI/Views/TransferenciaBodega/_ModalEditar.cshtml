<form autocomplete="off" ng-submit="$ctrl.onSave()">
    <div class="modal-header bg-info text-white">
        <h5 class="modal-title">Editar Transferencia Bodega</h5>
        <button type="button" class="close" ng-click="$ctrl.closeModal()">&times;</button>
    </div>
    <div class="modal-body">
        <div class="row">
            <div class="col-xl-6 col-lg-6 col-md-6 col-sm-12 col-xs-12">
                <div class="row justify-content-between">
                    <div class="col-xl-6 col-lg-6 col-md-6 col-sm-12 col-sm-12">
                        <div class="form-group">
                            <label for="">Establecimiento Origen: <span class="text-danger">*</span></label>
                            <select class="form-control border-select" ng-model="$ctrl.data.codEstabOrigen" disabled>
                                <option ng-value="item.codEstab" ng-repeat="item in $ctrl.establecimientosOrigen">
                                    {{item.nombreComercial}}
                                </option>
                            </select>
                        </div>
                    </div>

                    <div class="col-xl-6 col-lg-6 col-md-6 col-sm-12 col-xs-12">
                        <div class="form-group">
                            <label for="">Bodega Origen: <span class="text-danger">*</span> </label>
                            <select class="form-control border-select" ng-model="$ctrl.data.idBodegaOrigen" disabled>
                                <option ng-value="item.idBodega" ng-repeat="item in $ctrl.bodegasOrigen">
                                    {{item.descripcion}}
                                </option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-6 col-lg-6 col-md-6 col-sm-12 col-xs-12">
                <div class="row justify-content-between">
                    <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12">
                        <div class="form-group">
                            <label for="Establecimiento">Establecimiento Destino: <span
                                    class="text-danger">*</span></label>
                            <select class="form-control" ng-model="$ctrl.data.codEstabDestino" disabled>
                                <option ng-value="item.codEstab" ng-repeat="item in $ctrl.establecimientosDestino">
                                    {{item.nombreComercial}}
                                </option>
                            </select>
                        </div>
                    </div>
                    <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12">
                        <div class="form-group">
                            <label for="">Bodega Destino: <span class="text-danger">*</span> </label>
                            <select class="form-control border-select" ng-model="$ctrl.data.idBodegaDestino" disabled>
                                <option ng-value="item.idBodega" ng-repeat="item in $ctrl.bodegasDestino">
                                    {{item.descripcion}}
                                </option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-lg-3 col-md-4 col-sm-12 col-xs-12">
                <div class="form-group">
                    <label for="">Punto Emision: <span class="text-danger"></span></label>
                    <select class="form-control border-select" ng-model="$ctrl.data.idPuntoEmision" disabled>
                        <option ng-value="item.idPuntoEmision" ng-repeat="item in $ctrl.puntosEmision">
                            {{item.ptoEmi}}
                        </option>
                    </select>
                </div>
            </div>
            <div class="col-lg-3 col-md-4 col-sm-12 col-xs-12">
                <div class="form-group">
                    <label for="fechaEmision">Fecha Emisión: <span class="text-danger">*</span></label>
                    <input type="date" ng-model="$ctrl.data.fechaEmision" class="form-control border-select"
                        ng-requerid="true">
                </div>
            </div>

            <div class="col-lg-6 col-md-4 col-sm-12 col-xs-12">
                <div class="form-group">
                    <label for="observación">Observación</label>
                    <textarea ng-model="$ctrl.data.observacion" touppercase class="form-control border-select" cols="20"
                        rows="2"></textarea>
                </div>
            </div>
        </div>

        <div class="row justify-content-between">
            <div class="col-lg-6">
                <div class="form-group">
                    <label for="articulo">Articulo</label>
                    <md-autocomplete-articulo-component tipo-doc="$ctrl.TIPO_DOC"
                        abrir-modal-articulo="$ctrl.abrirModalArticulo(item)"
                        get-data-articulo="$ctrl.getDataIdArticulo(item)"
                        set-item-articulo-en-detalle="$ctrl.setItemArticuloEnDetalle(item)" scope-parent="scopeParent"
                        id-bodega="$ctrl.data.idBodegaOrigen">
                    </md-autocomplete-articulo-component>
                </div>
            </div>
        </div>

        <div ui-grid="$ctrl.gridOptions" ui-grid-edit ui-grid-resize-columns ui-grid-cellNav ui-grid-auto-resize
            class="grid"></div>


    </div>
    <div class="modal-footer">
        <button type="submit" class="btn btn-info">
            <i class="ti-pencil"></i> Actualizar</button>
        <button type="button" class="btn btn-dark" ng-click="$ctrl.closeModal()">&times; Cerrar</button>
    </div>
</form>