             
<form ng-submit="$ctrl.onSave()" autocomplete="off">

    <div class="modal-header">
        <div class="text-left">
            <div class="icheck-primary">
                <input type="checkbox" ng-model="$ctrl.showHeader" id="showHeader">
                <label for="showHeader">Datos del proveedor</label>
            </div>
        </div>
        @* <div class="float-center">
            <span>Factura Nro: {{$ctrl.nroDocumentoSecuencial}}</span>
        </div> *@
        <div class="text-right">
            <h3><strong>Total:  ${{$ctrl.getImporteTotal()}}</strong></h3>
        </div>       
    </div>

    <div class="modal-body">                   
        <div class="row" ng-if="$ctrl.showHeader">
            <div class="col-xl-4 col-lg-4 col-md-4 col-sm-4 col-xs-12">            
                <div class="form-group">
                    <label for="categoria">Estab.: <span class="text-danger">*</span></label>                  
                    <select class="form-control border-select" ng-model="$ctrl.data.codEstab" disabled>
                        <option ng-value="item.codEstab" ng-repeat="item in $ctrl.establecimientos">
                            {{item.nombreComercial}}
                        </option>
                    </select> 
                </div> 
            </div>

            <div class="col-xl-4 col-lg-4 col-md-4 col-sm-4 col-xs-12">
                <div class="form-group">
                    <label>Sustento Tributario: <span class="text-danger">*</span></label>
                    <select class="form-control border-select" ng-model="$ctrl.data.idSustentoTributario">
                            <option ng-value="item.idSustentoTributario" ng-repeat="item in $ctrl.sustentoTributarios">{{item.descripcion}}</option>
                    </select>
                </div>
            </div>

            <div class="col-xl-4 col-lg-4 col-md-4 col-sm-4 col-xs-12">
                <div class="form-group">
                    <label for="categoria">Categoria: <span class="text-danger">*</span> </label>
                    <div class="input-group">                                    
                        <select class="form-control border-select" ng-model="$ctrl.data.idCategoriaCompra">
                                <option ng-value="item.idCategoriaCompra" ng-repeat="item in $ctrl.categoriaCompras">{{item.descripcion}}</option>
                        </select>
                        <div class="input-group-append">
                            <button type="button" class="btn btn-outline-secondary btn-sm" ng-click="$ctrl.openModalCategoria()"><i class="fa fa-plus fa-xs"></i></button>
                        </div>
                    </div>                               
                </div>
            </div>
        </div>

        <div class="row" ng-show="$ctrl.showHeader">                                   
            <div class="col-xl-4 col-lg-4 col-md-6 col-sm-6 col-xs-12">
                <div class="form-group">
                    <label for="">Proveedor <span class="text-danger">*</span></label>                    
                    <uib-modal-proveedor-search selected-item-proveedor="$ctrl.selectedItemProveedor(item)" search="$ctrl.searchProveedorOptions" proveedor-data="$ctrl.proveedor"></uib-modal-proveedor-search> 
                    <span class="ml-5" ng-if="data.loadingSearch"> <i class="fas fa-sync-alt fa-xs"></i> Loading...</span>
                    <small class="text-danger ml-5" ng-if="data.noResults">No se encontraron resultados</small>
                </div>
            </div>
            <div class="col-xl-2 col-lg-2 col-md-6 col-sm-6 col-xs-12">
                <div class="form-group">
                    <label>Nro. Identificación: </label>
                    <input type="text" class="form-control" ng-model="$ctrl.proveedor.numeroIdentificacion" disabled>                    
                </div>
            </div>

            <div class="col-xl-3 col-lg-3 col-md-6 col-sm-6 col-xs-12">
                <div class="form-group">
                    <label>Dirección: </label>
                    <input type="text" ng-model="$ctrl.proveedor.direccion" disabled class="form-control" />
                </div>
            </div>
            <div class="col-xl-3 col-lg-3 col-md-6 col-sm-6 col-xs-12">
                <div class="form-group">
                    <label>Correo: </label>
                    <input type="text" ng-model="$ctrl.proveedor.correo" disabled class="form-control" />
                </div>
            </div>
        </div>

        <div class="row" ng-show="$ctrl.showHeader">
            <div class="col-lg-6">
                <div class="row">
                    <div class="col-lg-3 col-md-3 col-sm-6 col-xs-6">
                        <div class="form-group">
                            <label>Punto Emisión <span class="text-danger">*</span></label>                            
                            <input class="form-control border-select punto-emision" ng-model="$ctrl.data.puntoEmision"  mask="999-999" maxlength=7 placeholder="000-000" />
                        </div>
                    </div>
                    <div class="col-lg-3 col-md-3 col-sm-6 col-xs-3">
                        <div class="form-group">
                            <label>Nro. Documento: <span class="text-danger">*</span></label>
                            <input type="text" class="form-control border-select" ng-model="$ctrl.data.nroDocumento" decimal maxlength="9" />
                        </div>
                    </div>
                    <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12">
                        <div class="form-group">
                            <label>Autorización SRI: <span class="text-danger">*</span></label>
                            <input type="text" class="form-control border-select" valid-number ng-model="$ctrl.data.nroAutorizacion" />
                            <small class="text-danger">{{$ctrl.data.nroAutorizacion.length}}  números</small>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="row">                        
                    <div class="col-xl-4 col-lg-4 col-md-4 col-sm-6 col-xs-12">
                        <div class="form-group">
                            <label>Tiempo Credito: </label>
                            <select class="form-control border-select" ng-model="$ctrl.data.idTiempoCredito" disabled>
                                    <option ng-value="item.idTiempoCredito" ng-repeat="item in $ctrl.tiempoCreditos">{{item.descripcion}}</option>
                            </select>
                        </div>
                    </div>

                    <div class="col-xl-4 col-lg-4 col-md-4 col-sm-6 col-xs-12">
                        <div class="form-group">
                            <label>F. Emisión: </label>
                            <input type="date" class="form-control" ng-model="$ctrl.data.fechaEmision" ng-keyup="$ctrl.getFechaVencimiento()"
                                    ng-change="$ctrl.getFechaVencimiento()"  />
                            <small class="form-text text-info">{{$ctrl.fechaEmisionEscrita}}</small>
                        </div>
                    </div>

                    <div class="col-xl-4 col-lg-4 col-md-4 col-sm-6 col-xs-12">
                        <div class="form-group">
                            <label>F. de Vencimiento: </label>
                            <input type="date" class="form-control"  ng-model="$ctrl.data.fechaVencimiento" disabled />
                            <small class="form-text text-info">{{$ctrl.fechaVencimientoEscrita}}</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>                    
        

    

        <div class="row justify-content-between">
            <div class="col-lg-5 col-md-5 col-sm-12 col-xs-12">
                <label for="">Buscar Articulo</label>  
                <md-autocomplete-articulo-component 
                    tipo-doc="$ctrl.TIPO_DOC"
                    abrir-modal-articulo="$ctrl.abrirModalArticulo(item)"
                    get-data-articulo="$ctrl.getDataIdArticulo(item)"
                    set-item-articulo-en-detalle="$ctrl.setItemArticuloEnDetalle(item)"
                    scope-parent="$scope">
                </md-autocomplete-articulo-component> 
            </div>
            <div class="col-lg-2 col-md-2 col-sm-12 col-xs-12">
                <div class="form-group">
                    <label for="bodegas">Bodega</label>
                    <select name="bodegas" id="bodegas" class="form-control border-select" ng-model="$ctrl.idBodega" ng-change="$ctrl.askToChangeBodega()">
                        <option ng-value="item.idBodega" ng-repeat="item in $ctrl.bodegas">{{item.descripcion}}</option>
                    </select>
                </div>                               
            </div>   
        </div>

        <div id="grid" ui-grid="$ctrl.gridOptions"
            ui-grid-edit
            ui-grid-resize-columns
            ui-grid-cellNav
            ui-grid-auto-resize
            class="grid">
        </div>

        <div class="row">
            <div class="col-xl-9 col-lg-9 col-md-6 col-sm-12 col-xs-12">
                <div class="row mt-2" ng-if="$ctrl.showSubtotales">
                    <div class="col-xl-4 col-lg-4 col-md-6 col-sm-12 col-xs-12">
                        <div class="table-responsive">
                            <table class="table table-clear table-sm">
                                <tbody>
                                    <tr>
                                        <td class="left">
                                            <strong class="text-dark">SubTotal Iva {{$ctrl.actividadTipoIva.tarifa}}%</strong>
                                        </td>
                                        <td class="right">${{$ctrl.data.subTotalIva}}</td>
                                    </tr>

                                    <tr>
                                        <td class="left">
                                            <strong class="text-dark">SubTotal IVA 0</strong>
                                        </td>
                                        <td class="right">${{$ctrl.data.subTotalIvaCero}}</td>
                                    </tr>

                                    <tr>
                                        <td class="left">
                                            <strong class="text-dark">SubTotal Exento IVA</strong>
                                        </td>
                                        <td class="right">${{$ctrl.data.subTotalExentoIva}}</td>
                                    </tr>

                                    <tr>
                                        <td class="left">
                                            <strong class="text-dark">SubTotal no Objeto IVA</strong>
                                        </td>
                                        <td class="right">${{$ctrl.data.subTotalNoObjetoIva}}</td>
                                    </tr>                                                       
                                </tbody>
                            </table>  
                        </div>             
                    </div>

                    <div class="col-xl-4 col-lg-4 col-md-6 col-sm-12 col-xs-12">
                        <div class="table-responsive">
                            <table class="table table-clear table-sm">
                                <tbody>
                                    <tr>
                                        <td class="left">
                                            <strong class="text-dark">SubTotal Neto IVA</strong>
                                        </td>
                                        <td class="right">${{$ctrl.data.subTotalNetoIva}}</td>
                                    </tr>

                                    <tr>
                                        <td class="left">
                                            <strong class="text-dark">SubTotal Neto IVA 0</strong>
                                        </td>
                                        <td class="right">${{$ctrl.data.subTotalNetoIvaCero}}</td>
                                    </tr>

                                    <tr>
                                        <td class="left">
                                            <strong class="text-dark">SubTotal Neto Exento IVA</strong>
                                        </td>
                                        <td class="right">${{$ctrl.data.subTotalNetoExentoIva}}</td>
                                    </tr>

                                    <tr>
                                        <td class="left">
                                            <strong class="text-dark">SubTotal Neto no Objeto IVA</strong>
                                        </td>
                                        <td class="right">${{$ctrl.data.subTotalNetoNoObjetoIva}}</td>
                                    </tr>                                                       
                                </tbody>
                            </table>  
                        </div> 
                    </div>

                    <div class="col-xl-4 col-lg-4 col-md-6 col-sm-12 col-xs-12">
                        <div class="table-responsive">
                            <table class="table table-clear table-sm">
                                <tbody>                                   
                                    <tr>
                                        <td class="left">
                                            <strong class="text-dark">IRBPNR</strong>
                                        </td>
                                        <td class="right">${{$ctrl.data.irbpnr}}</td>
                                    </tr>

                                    <tr>
                                        <td class="left">
                                            <strong class="text-dark">Propina</strong>
                                        </td>
                                        <td class="right">${{$ctrl.data.propina}}</td>
                                    </tr>                                                                               
                                </tbody>
                            </table>  
                        </div> 
                    </div>                      
                </div>
                <md-divider></md-divider>
                <div class="row mt-2" ng-if="$ctrl.showSubtotales">
                    <div class="col-lg-2 col-md-6 col-sm-12 col-xs-12">
                        <div class="form-group">
                            <label>% Descuento</label>
                            <div class="input-group">
                                <input ng-model="$ctrl.data.porcentajeDescuento" ng-disabled="$ctrl.gridOptions.data.length==0" 
                                decimal class="form-control border-select" />
                                <div class="input-group-append">
                                    <button type="button" class="btn btn-secondary btn-sm" ng-click="$ctrl.calcularPorcentajeDescuento()">
                                        <i class="fa fa-calculator fa-xs"></i>
                                    </button>                                            
                                </div>
                            </div>                    
                        </div>
                    </div>

                    <div class="col-lg-2 col-md-6 col-sm-12 col-xs-12">
                        <div class="form-group">
                            <label>Descuento</label>
                            <div class="input-group">
                                <input ng-model="$ctrl.data.totalDescuento" id="totalDescuento" ng-disabled="$ctrl.gridOptions.data.length==0" decimal placeholder="0.00" class="form-control border-select" />
                                <div class="input-group-append">
                                    <button type="button" class="btn btn-secondary btn-sm" ng-click="$ctrl.calcularDescuento()">
                                        <i class="fa fa-calculator fa-xs"></i>
                                    </button>
                                </div>
                            </div>                                    
                        </div>
                    </div>

                    <div class="col-lg-2 col-md-6 col-sm-12 col-xs-12">
                        <div class="form-group">
                            <label>Transporte</label>
                            <input type="text" decimal ng-model="$ctrl.data.transporte" ng-blur="$ctrl.sumaTransporteRecargo()" class="form-control border-select" placeholder="0.00" />
                        </div>
                    </div>

                    <div class="col-lg-2 col-md-6 col-sm-12 col-xs-12">
                        <div class="form-group">
                            <label>Rercargo</label>
                            <input type="text" decimal ng-model="$ctrl.data.recargo" ng-blur="$ctrl.sumaTransporteRecargo()" class="form-control border-select" placeholder="0.00" />
                        </div>
                    </div>

                    <div class="col-lg-4">
                        <div class="form-group">
                            <label>Observacion</label>
                            <textarea class="form-control border-select" ng-model="$ctrl.data.observacion" touppercase placeholder="..."></textarea>
                        </div>
                    </div>
                </div> 
            </div>

            <div class="col-xl-3 col-lg-3 col-md-6 col-sm-12 col-xs-12">             
                <div class="table-responsive mt-2">
                    <table class="table table-clear table-sm">
                        <tbody>
                            <tr>
                                <td class="left">
                                <strong class="text-dark">SubTotal sin Impuesto</strong>
                                </td>
                                <td class="right">${{$ctrl.data.subTotalSinImpuestos}}</td>
                            </tr>

                            <tr>
                                <td class="left">
                                    <strong class="text-dark">IVA {{$ctrl.actividadTipoIva.tarifa}}%</strong>
                                </td>
                                <td class="right">${{$ctrl.data.iva}}</td>
                            </tr>

                            <tr>
                                <td class="left">
                                <strong class="text-dark">Total Descuento</strong>
                                </td>
                                <td class="right">${{$ctrl.data.totalDescuento}}</td>
                            </tr>  

                            <tr>
                                <td class="left">
                                    <strong class="text-dark">ICE</strong>
                                </td>
                                <td class="right">${{$ctrl.data.totalIce}}</td>
                            </tr>                                             
                            
                            <tr>
                                <td class="left">
                                    <h4> <strong class="text-dark">Total</strong></h4>                                       
                                </td>
                                <td class="right">
                                    <h4><strong class="text-dark">${{$ctrl.getImporteTotal()}}</strong></h4>
                                </td>
                            </tr>
                        </tbody>
                    </table>  
                </div>                               
            </div>
        </div>  

                      

    </div>
    <div class="modal-footer">
        <div class="icheck-success icheck-inline">
            <input type="checkbox" ng-model="$ctrl.showSubtotales" id="showSubtotales" />
            <label for="showSubtotales">Mas datos</label>
        </div>
        <button type="submit" class="btn btn-info">
            <i class="ti-pencil"></i> Actualizar
        </button>
        <button type="button" class="btn btn-dark"  ng-click="$ctrl.closeModal()">&times; Cerrar</button>
    </div>

</form>