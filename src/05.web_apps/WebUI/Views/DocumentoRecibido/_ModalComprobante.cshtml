        <div class="table-responsive">
            <table class="table table-bordered">
                <thead>
                    <tr>
                        <th>Cantidad</th>
                        <th>Descripcion:</th>
                        <th>Cód. Principal</th>
                        <th>Cód. Auxiliar:</th>
                        <th>Precio Unitario:</th>
                        <th>Descuento:</th>
                        <th>Imp.</th>
                        <th>Valor Imp.</th>
                        <th>Total:</th>
                    </tr>
                </thead>
                <tbody>
                    <tr ng-repeat="item in customDetailTemp">
                        <td>{{item.cantidad}}</td>
                        <td>
                            <div class="form-group">
                                <input type="text" id="{{$index}}-descripcion" class="form-control"
                                    name="{{$index}}-descripcion" autocomplete="off" class="form-control border-select"
                                    placeholder="Buscar articulo" ng-model="item.descripcion" ng-keyup="clearSearch()"
                                    uib-typeahead="a as a.codigo + '-' + a.descripcion for a in searchArticleCustomDetail($viewValue)"
                                    typeahead-loading="articleFinded.loading"
                                    typeahead-no-results="articleFinded.noResults" typeahead-editable="false"
                                    typeahead-on-select="selectArticleSearch($item, item)" onclick="select()"
                                    required />
                            </div>
                        </td>
                        <td>
                            <div class="form-group">
                                <input type="text" id="{{$index}}-codigoPrincipal" class="form-control"
                                    ng-model="item.codigoPrincipal" name="{{$index}}-codigoPrincipal" required />
                            </div>
                        </td>
                        <td>
                            <div class="form-group">
                                <input type="text" id="{{$index}}-codigoAuxiliar" class="form-control"
                                    ng-model="item.codigoAuxiliar" name="{{$index}}-codigoAuxiliar" />
                            </div>
                        </td>

                        <td>{{item.precioUnitario | currency}}</td>
                        <td>{{item.descuento | currency}}</td>
                        <td>{{item.impuesto}}</td>
                        <td>{{item.valorImpuesto}}</td>
                        <td>{{item.total | currency}}</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="row">
            <div class="col-xl-6 col-lg-6 col-md-6 col-sm-6 col-12">
                <button class="btn btn-success btn-sm" ng-click="addCustomDetail($event)">
                    <icon class="ti-plus"></icon> Agregar
                </button>
                <button class="btn btn-warning btn-sm" ng-click="cancelCustomDetails()">&times;
                    Cancelar</button>
            </div>
        </div>
    </ng-form>
    <div class="row">
        <div class="col-xl-4 col-lg-4 col-md-4 col-sm-4 offset-xl-8 offset-lg-8 offset-md-8 offset-sm-8  col-12">
            <div class="form-group">
                <label for="sizeAll">Aplicar Medida para todos</label>
                <select class="form-control" ng-model="articleSize" ng-change="updateSizeArticles(articleSize)">
                    <option ng-value="size.idMedida" ng-repeat="size in medidas"
                        ng-selected="size.idMedida == articleSize">
                        {{size.descripcion}}</option>
                </select>
            </div>
        </div>
    </div>
    <md-table-container>
        <table md-table class="table-bordered">
            <caption></caption>
            <thead md-head>
                <tr md-row>
                    <th md-column class="text-center">Cant.</th>
                    <th md-column class="text-center">Cód. Principal</th>
                    <th md-column class="text-center">Cód. Auxiliar</th>
                    <th md-column>Descripción</th>
                    <td md-column>Medida</td>
                    <th md-column class="text-right">P.U.</th>
                    <th md-column class="text-right">Costo Neto</th>
                    <th md-column class="text-right">Descuento</th>
                    <th md-column class="text-center">Imp.</th>
                    <th md-column class="text-right">Valor Imp.</th>
                    <th md-column class="text-right">Total</th>
                    <th md-column>Opciones</th>
                </tr>
            </thead>
            <tbody md-body>
                <tr md-row ng-repeat="item in tempDetail">
                    <td md-cell class="text-center">{{item.cantidad}}</td>
                    <td md-cell class="text-center">{{item.codigoPrincipal}}</td>
                    <td md-cell class="text-center">{{item.codigoAuxiliar}}</td>
                    <td md-cell>{{item.descripcion}}</td>
                    <td md-cell>
                        <div style="position:relative; min-width:100px;">
                            <select class="form-control" ng-model="item.idMedida" ng-change="updateArticleTemp(item)">
                                <option ng-value="size.idMedida" ng-repeat="size in medidas">
                                    {{size.descripcion}}</option>
                            </select>
                        </div>
                    </td>
                    <td md-cell class="text-right">{{item.precioUnitario | currency}}</td>
                    <td md-cell class="text-right">{{item.costoNeto | currency}}</td>
                    <td md-cell class="text-right">{{item.descuento | currency}}</td>
                    <td md-cell class="text-right">{{item.impuesto}}</td>
                    <td md-cell class="text-right">{{item.valorImpuesto | currency}}</td>
                    <td md-cell class="text-right">{{item.precioTotalSinImpuesto | currency}}</td>
                    <td md-cell>
                        <md-button ng-if="!(item.idArticulo > 0 && item.idProveedor > 0)" class="md-icon-button"
                            ng-click="openMerge(item)" aria-label="Unir" title="Unir">
                            <md-icon md-font-set="md" class="text-info">sync_alt</md-icon>
                        </md-button>
                        <md-button ng-if="(item.idArticulo > 0 && item.idProveedor > 0)" class="md-icon-button"
                            ng-click="getArticleHistory(item)" aria-label="Historial"
                            title="Historial de ingresos de facturas">
                            <md-icon md-font-set="md" class="text-danger">shopping_cart</md-icon>
                        </md-button>
                        <md-button ng-if="(item.idArticulo > 0 && item.idProveedor > 0)" class="md-icon-button"
                            ng-click="getArticleHC(item)" aria-label="Historial" title="Historial de vinculación">
                            <md-icon md-font-set="md" class="text-info">history</md-icon>
                        </md-button>
                    </td>
                </tr>
            </tbody>
        </table>
    </md-table-container>
    <div class="row">
        <div class="col-xl-7 col-lg-7 col-md-7 col-sm-7 col-12">
            <div class="table-responsive">
                <h5><strong>Información Adicional</strong></h5>
                <table class="table table-bordered">
                    <tbody>
                        <tr ng-repeat="item in infoAdicional">
                            <td><strong>{{item.nombre}}</strong></td>
                            <td>{{item.valor}}</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <hr>
            <div class="table-responsive">
                <table class="table table-bordered">
                    <thead>
                        <tr>
                            <th>Forma de Pago</th>
                            <th>Plazo</th>
                            <th>Total</th>
                            <th>U. Tiempo</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="item in payments">
                            <td>{{item.formaPago}}</td>
                            <td>{{item.plazo}}</td>
                            <td>{{item.total}}</td>
                            <td>{{item.unidadTiempo}}</td>
                        </tr>
                    </tbody>
                </table>
            </div>

        </div>
        <div class="col-xl-5 col-lg-5">
            <div class="table-responsive">
                <h5><strong></strong></h5>
                <table class="table table-bordeless">
