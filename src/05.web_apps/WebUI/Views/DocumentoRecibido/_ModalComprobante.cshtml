<div class="modal-header">
    <h4 class="modal-title">
        <i class="ti-upload"></i> Factura de Compra
    </h4>
    <button type="button" class="close" aria-label="Close" ng-click="closeMainModal()">
        <span aria-hidden="true">&times;</span>
    </button>
</div>
<div class="modal-body">
    <div class="row border">
        <div class="col-xl-7 col-lg-7col-md-7 col-sm-7 col-12 mb-2">
            <div class="form-group">
                <label>Proveedor:</label>
                <input maxlength="300" class="form-control" required name="description"
                    ng-model="infoTributaria.razonSocial" disabled>
            </div>
            <div class="form-group">
                <label>Dirección Matriz:</label>
                <input required class="form-control" name="dirMatriz" ng-model="infoTributaria.dirMatriz" disabled>
            </div>
            <div class="form-group">
                <label>Dir. Establecimiento:</label>
                <h5>{{infoComprobante.dirEstablecimiento}}</h5>
            </div>
            <div class="form-group">
                <label>Obligado Contabilidad:</label>
                <h5>{{infoComprobante.obligadoContabilidad}}</h5>
            </div>
            <button type="button" id="btnProv" ng-disabled="btnProvIsEnable" ng-click="addProvClient()"
                class="btn btn-success btn-sm">
                <icon class="ti-save"></icon> Guardar Proveedor
            </button>
        </div>
        <div class="col-xl-5 col-lg-5 col-md-5 col-sm-5 col-12">
            <div class="form-group">
                <label>Nro. Documento:</label>
                <h5> {{selected[0].comprobante}} {{infoTributaria.estab}} - {{infoTributaria.ptoEmi}}
                    - {{infoTributaria.secuencial}}</h5>
            </div>
            <div class="form-group">
                <label>Ruc:</label>
                <input required name="ruc" class="form-control" ng-model="infoTributaria.ruc" disabled>
            </div>
            <div class="form-group">
                <label>Nro. Autorización:</label>
                <input required name="ruc" class="form-control" ng-model="infoTributaria.claveAcceso" disabled>
            </div>
            <div class="form-group">
                <label>Fecha Emisión:</label>
                <input required name="ruc" class="form-control" ng-model="infoComprobante.fechaEmision" disabled>
            </div>
        </div>
    </div>
    <div class="row mt-2">
        <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">
            <div class="form-group">
                <label for="idSustentoTributario">Sustento Tributario:</label>
                <select id="idSustentoTributario" class="form-control" ng-model="comprobanteForm.idSustentoTributario"
                    required>
                    <option>Seleccione un Sustento</option>
                    <option value="{{item.idSustentoTributario}}" ng-repeat="item in sustentos"
                        ng-selected="item.idSustentoTributario == comprobanteForm.idSustentoTributario">
                        {{item.codigo}} - {{item.descripcion}}</option>
                </select>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-xl-4 col-lg-4 col-md-4 col-sm-4 col-12">
            <div class="form-group">
                <label for="idTiempoCredito">Tiempo Crédito:</label>
                <select id="idTiempoCredito" class="form-control" ng-model="comprobanteForm.idTiempoCredito" required>
                    <option>Seleccione un tiempo de crédito</option>
                    <option ng-value="item.idTiempoCredito" ng-repeat="item in tiemposCredito">
                        {{item.descripcion}}
                    </option>
                </select>
            </div>
        </div>
        <div class="col-xl-4 col-lg-4 col-md-4 col-sm-4 col-12">
            <div class="form-group">
                <label for="idCategoria">Categoria:</label>
                <select id="idCategoria" class="form-control" ng-model="comprobanteForm.idCategoria" required>
                    <option>Seleccione una categoria</option>
                    <option value="{{item.idCategoriaCompra}}" ng-repeat="item in categories"
                        ng-selected="item.idCategoriaCompra == comprobanteForm.idCategoria">
                        {{item.descripcion}}
                    </option>
                </select>
            </div>
        </div>
        <div class="col-xl-4 col-lg-4 col-md-4 col-sm-4 col-12">
            <div class="form-group">
                <label for="idBodega">Bodega:</label>
                <select id="idBodega" class="form-control" ng-model="comprobanteForm.idBodega" required>
                    <option>Seleccione una bodega</option>
                    <option value="{{item.idBodega}}" ng-repeat="item in bodegas"
                        ng-selected="item.idBodega == comprobanteForm.idBodega">{{item.descripcion}}
                    </option>
                </select>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">
            <button class="btn btn-info btn-sm" ng-click="askToAddCustomDetails($event)">
                <icon class="ti-plus"></icon> Agregar Detalle Personalizado
            </button>
        </div>
    </div>
    <br />
