    </div>
    <div class="row">
        <div class="col-xl-7 col-lg-7 col-md-7 col-sm-7 col-12">

        </div>
    </div>
    <div class="row">
        <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">
            <div class="form-group">
                <label for="observacion">Observación:</label>
                <textarea name="observacion" id="observacion" ng-model="comprobanteForm.observacion"
                    class="form-control"></textarea>
            </div>
        </div>
    </div>
</div>
<div class="modal-footer">
    <button type="submit" class="btn btn-success" ng-click="askToSave()" title="Guardar">
        <icon class="ti-save"></icon> Guardar
    </button>
    <button class="btn btn-dark" ng-click="closeMainModal()">
        <icon class="ti-close"></icon> Cancelar
    </button>
</div>