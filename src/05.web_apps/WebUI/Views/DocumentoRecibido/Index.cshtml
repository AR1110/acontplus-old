@{
    ViewData["Title"] = "Index";
}
<div ng-controller="documentoRecibidoCtrl">
    <div class="row page-titles">
        <div class="col-md-5 align-self-center">
            <h5 class="text-themecolor">Importación de Comprobantes</h5>
        </div>
    </div>
    <md-content class="md-padding" layout-xs="column" layout="row">
        <div flex-xs flex-gt-xs="100" layout="column">
            <md-card>
                <div class="md-padding" layout-xs="column" layout="row">
                    <div flex-xs flex-gt-xs="30" layout="column">
                        <md-card-action>
                            <md-button class="md-raised md-primary" ng-click="newImport()">
                                <icon class="ti-upload"></icon> Nueva
                                Importación
                            </md-button>
                        </md-card-action>
                    </div>
                    <div flex-xs flex-gt-xs="30" layout="column">
                        <md-input-container>
                            <label>Documentos: </label>
                            <md-select ng-model="doc" ng-change="getDocs(doc)">
                                <md-option><em>Seleccione un documento</em></md-option>
                                <md-option ng-repeat="doc in tiposDocumento" ng-value="doc">
                                    {{doc.descripcion}}
                                </md-option>
                            </md-select>
                        </md-input-container>
                    </div>
                    <div flex-xs flex-gt-xs="30" layout="column">
                        <md-input-container>
                            <label>Buscar: </label>
                            <input type="text" ng-model="search" ng-keyup="onKeyupSearchFilter()">
                        </md-input-container>
                    </div>
                </div>
                <md-card-content>
                    <md-table-container>
                        <table md-table md-row-select ng-model="selected" md-progress="promise">
                            <caption>Lista de Importaciones</caption>
                            <thead md-head md-order="query.sortBy">
                                <tr md-row>
                                    <th md-column>Doc.</th>
                                    <th md-column md-order-by="serieComprobante">Serie</th>
                                    <th md-column>Ruc Emisor</th>
                                    <th md-column md-order-by="razonSocialEmisior" ng-click="setOrder($event)">
                                        <span>Razón Social Emisor</span>
                                    </th>
                                    <th md-column>Fecha Emisión</th>
                                    <th md-column>F. Aut.</th>
                                    <th md-column md-order-by="importeTotal">Total</th>
                                </tr>
                            </thead>
                            <tbody md-body>
                                <tr md-row md-select="item" md-select-id="index" md-on-select="showOptions"
                                    md-auto-select
                                    ng-repeat="item in comprobantes"
                                    style="{{item.colorRow}}" title="{{item.hoverText}}" ng-disabled="item.complete">
                                    <td md-cell style="{{item.colorCol}}">{{item.comprobante}}</td>
                                    <td md-cell style="{{item.colorCol}}">{{item.serieComprobante}}</td>
                                    <td md-cell style="{{item.colorCol}}">{{item.rucEmisor}}</td>
                                    <td class="text-left" style="{{item.colorCol}}" md-cell>
                                        {{item.razonSocialEmisior}}
                                    </td>
                                    <td md-cell style="{{item.colorCol}}">{{item.fechaEmision}}</td>
                                    <td md-cell style="{{item.colorCol}}">{{item.fechaAutorizacion}}</td>
                                    <td md-cell class="text-right" style="{{item.colorCol}}">
                                        {{item.importeTotal |
                                        currency }}
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </md-table-container>
                    <md-table-pagination md-limit="query.limit" md-limit-options="pages" md-page="query.page"
                                         md-total="{{totalRecords}}" md-on-paginate="getComprobantes" md-page-select>
                    </md-table-pagination>
                </md-card-content>
            </md-card>
        </div>
    </md-content>
    @await Html.PartialAsync("_Upload")
</div>
@section Scripts{
    <script src="~/js/controllers/recepcion/documentoRecibidoCtrl.js" asp-append-version="true"></script>
}
