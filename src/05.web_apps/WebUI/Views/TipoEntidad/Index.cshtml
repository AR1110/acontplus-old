
@{
    ViewData["Title"] = "Index";
}
<div ng-controller="tipoEntidadCtrl">
    <div class="row page-titles">
        <div class="col-md-5 align-self-center">
            <h4 class="text-themecolor">Gestión de Tipo Entidad</h4>
        </div>
        <div class="col-md-7 align-self-center text-right">
            <div class="d-flex justify-content-end align-items-center">
                @*<ol class="breadcrumb">
                        <li class="breadcrumb-item"><a href="javascript:void(0)">Inicio</a></li>
                        <li class="breadcrumb-item active">Tipo Entidad</li>
                    </ol>*@
                <button type="button" ng-click="abrirModal(0,1)" class="btn btn-info d-none d-lg-block m-l-15">
                    <i class="ti-plus"></i> Nuevo
                </button>
            </div>
        </div>
    </div>
    <md-card>
        <md-card-content>
            <div class="row">
                <div class="col-lg-9">
                    <span class="form-group pull-left page-size form-inline">
                        <select class="form-control control-color"
                                ng-model="pageSize"
                                ng-change="changePageSize()"
                                ng-options="ra for ra in recordsQuantity">
                        </select>
                    </span>
                </div>
                <div class="col-lg-3">
                    <form class="form-material">
                        <input type="text" class="form-control" ng-model="buscar" placeholder="Buscar Tipo Entidad" />
                    </form>                    
                </div>
            </div>
            <div class="table-responsive ">
                <table  class="table table-no-bordered  text-center">
                    <thead>
                        <tr>                            
                            <th>Op.</th>                           
                            <th>N°</th>
                            <th>Código</th>
                            <th>Descripción</th>
                            <th>Estado</th> 
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="te in tipoEntidades | filter:buscar">                                                      
                            <td>
                                <div class="justify-content-center">
                                    <a href="javascript:void(0)" ng-click="abrirModal(te,2)" class="btn btn-info btn-xs" title="Actualizar" data-toggle="tooltip"><i class="ti-pencil"></i></a>                                            
                                    <a href="javascript:void(0)" ng-click="delete(te.idTipoEntidad)" class="btn btn-danger btn-xs" data-toggle="tooltip" title="Eliminar"><i class="ti-trash"></i></a>                                    
                                </div>
                            </td>                             
                            <td>{{$index+1}}</td>
                            <td>{{te.codigo}}</td>
                            <td>{{te.descripcion}}</td>
                            <td ng-bind-html="te.estado | estadoPrimario"></td> 
                        </tr>
                    </tbody>
                    <tfoot>
                        <tr>
                            <td align="center" colspan="5">
                                <div class="pull-left">
                                    <ul uib-pagination total-items="totalRecords" items-Per-Page="pageSize" ng-change="pagechanged()" ng-model="pageIndex" max-size="maxSize" class="pagination" boundary-links="true" rotate="false"></ul>
                                </div>
                            </td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </md-card-content>
    </md-card>
    <br />
    <div class="modal fade" id="agregar" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel1" data-backdrop="static" data-keyboard="false">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <form ng-submit="saveUpdate(tipo)" class="form-material" autocomplete="off" novalidate>
                    <div class="modal-content">
                        <div class="modal-header {{colorHeader}}">
                            <h5 class="modal-title text-white" id="exampleModalLabel"><i class="{{iconoModal}}"></i>{{tituloModal}}</h5>
                        </div>
                        <div class="modal-body">

                            <div class="row">
                                <div class="form-group col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                    <label for="telefono">Descripción <span class="text-danger">*</span></label>
                                    <input type="text" ng-model="data.descripcion" class="form-control" ng-keyup="obtenerTresLetras(data)" placeholder="Ej: Local">
                                </div>
                                <div class="form-group col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                    <label for="codigo">Código <span class="text-danger">*</span></label>
                                    <input type="text" ng-model="data.codigo" touppercase ng-disabled="data.descripcion==undefined || data.tipoOperacion==2" class="form-control" placeholder="Ej: LO">
                                </div>
                                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12" ng-show="tipo==2">
                                    <label>Estado</label>
                                    <md-radio-group ng-model="data.estado">
                                        <md-radio-button ng-value="true">Activo</md-radio-button>
                                        <md-radio-button ng-value="false">Inactivo</md-radio-button>
                                    </md-radio-group>
                                </div>
                            </div>
                           
                            
                        </div>
                        <div class="modal-footer">
                            <button type="submit" class="btn {{colorHeader}} text-white"><i class="{{icono}}"></i> {{btnModal}}</button>
                            <button type="button" class="btn btn-dark" data-dismiss="modal">&times; Cerrar</button>
                        </div>
                    </div>
                </form>

            </div>
        </div>
    </div>
</div>

@section Scripts{

    <script src="~/js/controllers/ingresos/tipoEntidadCtrl.min.js" asp-append-version="true"></script>
}

