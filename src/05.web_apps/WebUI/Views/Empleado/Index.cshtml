@{
    ViewData["title"] = "Empleado";
}

<div ng-controller="empleadoCtrl">
    <div>
        <div class="row page-titles">
            <div class="col-md-5 align-self-center">
                <h4 class="text-themecolor">Gestión de Empleados</h4>
            </div>
            <div class="col-md-7 align-self-center text-right">
                <div class="d-flex justify-content-end align-items-center">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a href="/Home/Index">Inicio</a></li>
                        <li class="breadcrumb-item"><a href="javascript:void(0)">Ventas</a></li>                    
                    </ol>
                    <button type="button" class="btn btn-info m-l-15" ng-if="accion.crear" ng-click="openModalAddUpdate()"><i class="fa fa-plus-circle"></i> Nuevo</button>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-lg-12">
                <div class="card">
                    <div class="card-body">
                        <md-toolbar class="md-table-toolbar md-default">
                            <div class="md-toolbar-tools">
                                <div class="col-lg-9 col-md-6 col-sm-1 col-xs-1 m-t-20">                       
                                </div>
                                <div class="col-lg-3 col-md-6 col-sm-11 col-xs-11">
                                    <input type="text" class="form-control" ng-model="buscarEmpleado" placeholder="Buscar Empleado" />
                                </div>

                            </div>
                        </md-toolbar>

                        <!-- tabla Empleado -->
                        <md-table-container>

                            <table md-table md-progress="promise">
                                <thead md-head md-order="query.order" md-on-reorder="empleados">
                                    <tr md-row>
                                        <th md-column align="center">Op.</th>
                                        <th md-column><span>N°</span></th>
                                        <th md-column>Nro. Identificación</th>
                                        <th md-column md-order-by="etiqueta.descripcion"><span>Nombre Completo</span></th>                                        
                                        <th md-column>Estado</th>
                                    </tr>
                                </thead>
                                <tbody md-body class="text-center">
                                    <tr md-row ng-repeat="e in empleados | filter: buscarEmpleado">
                                        <td md-cell>
                                            <button class="btn btn-info btn-xs" ng-if="accion.editar" ng-click="openModalEdit(e)"><i class="ti-pencil"></i></button>
                                            <button class="btn btn-danger btn-xs" ng-if="accion.eliminar" ng-click="delete(e)"><i class="ti-trash"></i></button>                                
                                        </td>
                                        <td md-cell>{{$index+1}}</td>
                                        <td md-cell>{{e.empleado.nroIdentificacion}}</td>
                                        <td md-cell><b class="text-primary">{{e.empleado.nombreCompleto}}</b></td>                                        
                                        <td md-cell ng-bind-html="e.empleado.estado | estadoPrimario"></td>
                                        
                                    </tr>
                                    <tr ng-show="empleados.length==0" class="text-center">
                                        <td colspan="6">
                                            No hay registros en esta tabla :)
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </md-table-container>                       
                    </div>
                </div>
            </div>
        </div>           
    </div>
</div>

@section Scripts{
    <script src="~/js/controllers/ventas/empleadoCtrl.min.js" asp-append-version="true"></script>
}
