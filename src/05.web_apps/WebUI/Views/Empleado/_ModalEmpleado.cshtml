<div class="modal-header">
    <h5 class="modal-title">{{$ctrl.tipoRegistro===1?'Nuevo':'Editar'}} Empleado</h5>
    <button class="close" ng-click="$ctrl.closeModal()">&times;</button>
</div>
<div class="modal-body">
    <div class="row">
        <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <div class="form-group">
                <label for="">Tipo Identificación <span class="text-danger">*</span> </label>
                <div class="form-group">
                    <select class="form-control border-select" ng-model="$ctrl.data.idTipoIdentificacion" ng-change="$ctrl.onChangeTipoIdentificacion()">
                        <option ng-value="item.idTipoIdentificacion" ng-repeat="item in $ctrl.tipoIdentificaciones">{{item.identificacion}}</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <div class="form-group">
                <label for="">{{$ctrl.data.identificacion}}: <span class="text-danger">*</span></label>
                <input type="text" ng-model="$ctrl.data.nroIdentificacion" class="form-control border-select">
            </div>
        </div>
        
        
        <div ng-if="$ctrl.tipoRegistro===1" class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <div class="form-group">
                <label for="">Nombre: <span class="text-danger">*</span></label>
                <input type="text" ng-model="$ctrl.data.nombre" touppercase class="form-control border-select">
            </div>
        </div>
        <div ng-if="$ctrl.tipoRegistro===1" class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <div class="form-group">
                <label for=""> Apellido: <span class="text-danger">*</span></label>
                <input type="text" ng-model="$ctrl.data.apellido" class="form-control border-select">                
            </div>
        </div>
        

        
        <div ng-if="$ctrl.tipoRegistro===2" class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <div class="form-group">
                <label for=""> Nombre Completo: <span class="text-danger">*</span></label>
                <input type="text" ng-model="$ctrl.data.nombreCompleto" class="form-control border-select">                
            </div>
        </div>            
        
        <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-xs-12" ng-if="$ctrl.tipoRegistro===2">
            <div class="form-group">
                <label for="">Estado</label>
                <md-radio-group ng-model="$ctrl.data.estado" aria-labelledby="estado">
                    <md-radio-button ng-value="true" class="md-primary">Activo</md-radio-button>
                    <md-radio-button ng-value="false">Inactivo</md-radio-button>
                </md-radio-group>
            </div>
        </div>
    </div>                                                 
</div>
<div class="modal-footer">
    <button type="button" class="btn btn-success" ng-click="$ctrl.saveAndUpdate()">
        <i class="{{$ctrl.tipoRegistro==1?'ti-save':'fa fa-edit'}}"></i>{{$ctrl.tipoRegistro===1?' Guardar':' Actualizar'}}
    </button>
    <button type="button" class="btn btn-dark" ng-click="$ctrl.closeModal()">
        &times; Cerrar</button>
</div>