<div class="modal fade" id="modalAddUpSubMenu" tabindex="-1" role="dialog" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog" role="document">    
        <form ng-submit="saveUpdateSubMenu()" autocomplete="off" novalidate>
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="mdi mdi-menu"></i> {{tipoRegistro===1?'Nuevo':'Editar'}} Sub Menú</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <h5 class="box-title">Menú</h5>
                    <hr class="m-t-0">
                    <div class="row">
                        <div class="col-lg-6 col-md-6 col-sm-6 col-xs-12">
                            <div class="form-group">
                                <input type="text" ng-value="menu.descripcion "  class="form-control" placeholder="Descripción" disabled />
                            </div>
                        </div>
                        <div class="col-lg-6 col-md-6 col-sm-6 col-xs-12">
                            <div class="form-group">
                                <input type="text" ng-value="menu.grupo"class="form-control" placeholder="Grupo" disabled />
                            </div>
                        </div>
                    </div>

                    <h5 class="box-title">Sub Menu</h5>
                    <hr class="m-t-0">
                    <div class="row">
                        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                            <div class="form-group">
                                <label for="descripcionSubMenu">Descripción <span class="text-danger">*</span></label>
                                <input type="text" ng-model="data.descripcion" ng-keyup="obtenerCodigoSubMenu()" class="form-control border-select" placeholder="Descripcion">
                            </div>
                        </div>

                        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                            <div class="form-group">
                                <label for="descripcionSubMenu">Código <span class="text-danger">*</span></label>
                                <input type="text" ng-model="data.codTemp" touppercase ng-disabled="tipoRegistro===2" class="form-control border-select" placeholder="Código">
                            </div>
                        </div>

                        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                            <div class="form-group">
                                <label for="urlMenu">Url <span class="text-danger">*</span></label>
                                <input type="text" ng-model="data.url" class="form-control border-select" placeholder="/Usuario/Index">
                            </div>
                        </div>

                        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                            <div class="form-group">
                                <label for="descripcionSubMenu">Icono</label>
                                <input type="text" class="form-control border-select" ng-model="data.icono" placeholder="fa fa-home">                                
                            </div>
                        </div>                                                                    
                    </div>
                    <div class="row">
                        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12" ng-show="tipoRegistro==2">
                            <label for="">Estado: </label>
                            <md-radio-group ng-model="data.estado">
                                <md-radio-button ng-value="true">Activo</md-radio-button>
                                <md-radio-button ng-value="false">Inactivo</md-radio-button>
                            </md-radio-group>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-success"><i class="{{tipoRegistro==1?'ti-save':'ti-pencil'}}"></i> {{tipoRegistro===1?'Guardar':'Actualizar'}}</button>
                    <button type="button" class="btn btn-dark" data-dismiss="modal">&times; Cerrar</button>
                </div>
            </div>
        </form>
    </div>
</div>