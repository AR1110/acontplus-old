<div class="modal fade" id="modalAddUpdateMenu" tabindex="-1" role="dialog" data-backdrop="static">
    <div class="modal-dialog" role="document">        
        <form ng-submit="saveUpdateMenu()" autocomplete="off" novalidate>
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">{{tipoRegistro==1?'Nuevo':'Editar'}} Menú</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <div class="col-lg-12 colmd-12 col-sm-12 col-xs-12">
                            <div class="form-group">
                                <label for="grupo">Grupo <span class="text-danger">*</span></label>
                                <input type="text" ng-disabled="tipoRegistro==2" touppercase 
                                       ng-model="data.grupo " class="form-control border-select"  
                                       placeholder="Ej: A" maxlength="20">
                            </div>
                        </div>

                        <div class="col-lg-12 colmd-12 col-sm-12 col-xs-12">
                            <div class="form-group">
                                <label for="descripcion">Descripcion <span class="text-danger">*</span></label>
                                <input  type="text" ng-model="data.descripcion" class="form-control border-select"  
                                        placeholder="Ej: Administración" maxlength="30">
                            </div>
                        </div>

                        <div class="col-lg-12 colmd-12 col-sm-12 col-xs-12">
                            <div class="form-group">
                                <label for="grupo">Icono <span class="text-danger">*</span></label>
                                <input type="text" ng-model="data.icono" class="form-control border-select"  
                                       placeholder="fa fa-home o mdi mdi-home" maxlength="50">
                            </div>
                        </div>
                    </div>
                                       
                    <div ng-show="tipoRegistro==2">
                        <label for="">Estado: </label>
                        <md-radio-group ng-model="data.estado">
                            <md-radio-button ng-value="true">Activo</md-radio-button>
                            <md-radio-button ng-value="false">Inactivo</md-radio-button>
                        </md-radio-group>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-info"><i class="{{tipoRegistro==1?'ti-save':'ti-pencil'}}"></i> {{tipoRegistro===1?'Guardar':'Actualizar'}}</button>
                    <button type="button" class="btn btn-dark" data-dismiss="modal"> &times; Cerrar</button>
                </div>
            </div>
        </form>        
    </div>
</div>