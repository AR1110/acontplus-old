
@{
    ViewData["Title"] = "Index";
}

<div ng-controller="anioFiscalCtrl">
    <div class="row page-titles">
        <div class="col-md-5 align-self-center">
            <h4 class="text-themecolor">Gestión de Años Fiscales </h4>
        </div>
        <div class="col-md-7 align-self-center text-right">
            <div class="d-flex justify-content-end align-items-center">
                <button type="button" ng-if="accion.leer && accion.crear" ng-click="abrirModal(0,1)" class="btn btn-info  m-l-15">
                    <i class="fa fa-plus-circle"></i> Nuevo
                </button>
            </div>
        </div>
    </div>
    <!-- row -->

    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-body">
                    <md-toolbar class="md-table-toolbar md-default">
                        <div class="md-toolbar-tools">

                            <div class="col-lg-9 col-md-6 col-sm-1 col-xs-1 m-t-20">
                                @*<span class="form-group pull-left page-size form-inline">
                                        <select class="form-control control-color"
                                                ng-model="pageSize"
                                                ng-change="changePageSize()"
                                                ng-options="ra for ra in recordsQuantity">
                                        </select>
                                    </span>*@
                            </div>
                            <div class="col-lg-3 col-md-6 col-sm-11 col-xs-11">
                                <input type="text" class="form-control" ng-model="buscar" placeholder="Buscar" />
                            </div>

                        </div>
                    </md-toolbar>
                    <div class="table-responsive">
                        <table class="table table-condensed">
                            <thead>
                                <tr>
                                    <th>N°</th>
                                    <th>Año</th>
                                    <th>Estado</th>
                                    <th ng-if="accion.editar||accion.eliminar">Op.</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="a in anios|filter:buscar">
                                    <td>{{$index+1}}</td>
                                    <td>{{a.descripcion}}</td>
                                    <td ng-bind-html="a.estado | estadoPrimario"></td>                            
                                    <td ng-if="accion.editar || accion.eliminar">
                                        <button type="button" ng-if="accion.editar" ng-click="abrirModal(a,2)" class="btn btn-info btn-xs"><i class="ti-pencil"></i></button>   
                                        <button type="button" ng-if="accion.eliminar" ng-click="delete(a)" class="btn btn-danger btn-xs"><i class="ti-trash"></i></button>                                   
                                    </td>
                                </tr>
                                <tr ng-show="anios.length==0">
                                    <td colspan="6" class="text-center">No hay registros disponibles en esta tabla.</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>    
                </div>  
            </div>                                  
        </div>
    </div>    

    <div class="modal fade" id="agregarAnioFiscal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel1" aria-hidden="true" data-backdrop="static" data-keyboard="false">
        <div class="modal-dialog modal-sm" role="document">
            <div class="modal-content">
                <form ng-submit="save(type)" autocomplete="off" novalidate>
                    <div class="modal-content">
                        <div class="modal-header {{colorHeader}}">
                            <h5 class="modal-title text-white"><i class="{{iconoModal}}"></i>{{tituloModal}}</h5>
                            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                <span aria-hidden="true">&times;</span>
                            </button>
                        </div>
                        <div class="modal-body">
                            <div class="row">
                                <div class="form-group col-lg-12 col-md-12 col-sm-12 col-12">
                                    <label for="">Año Fiscal: <span class="text-danger"> *</span> </label>
                                    <input type="text" ng-model="data.descripcion" class="form-control" valid-number placeholder="Ej: 2021">
                                </div>
                            </div>

                            <div class="row">
                                <div class="form-group col-lg-6 col-md-6 col-sm-6 col-xs-6" ng-if="type==2">
                                    <label for="">Estado: </label>
                                    <div class="icheck-primary">
                                        <input type="radio" ng-model="data.estado" ng-value="true" id="someRadioId1" name="someGroupName" />
                                        <label for="someRadioId1">Activo</label>
                                    </div>
                                    <div class="icheck-primary">
                                        <input type="radio" ng-model="data.estado" ng-value="false" id="someRadioId2" name="someGroupName" />
                                        <label for="someRadioId2">Inactivo</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="submit" class="btn {{btnColor}}"><i class="{{icono}}"></i> {{btnTitulo}}</button>
                            <button type="button" class="btn btn-secondary" data-dismiss="modal"><i class="fa fa-close"></i>Cancelar</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
@section Scripts{
    <script src="~/js/config/controllers/anioFiscalCtrl.min.js" asp-append-version="true"></script>

}


