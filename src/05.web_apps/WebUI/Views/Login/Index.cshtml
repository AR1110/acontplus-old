
@{
    ViewData["Title"] = "Index";
    Layout = "";
    var returnUrl = ViewData["ReturnUrl"] as string;
}
<!DOCTYPE html>
<html lang="es-ec">
<head>
    <meta http-equiv="content-type" content="text/html; charset=utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <meta name="description" content="Herramienta Administrativa & Contable">
    <meta name="keywords" content="AcontPlus, Contabilidad, Sistema Contable" />
    <meta name="author" content="AcontPlus">

    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="application-name" content="AcontPlus" />
    <meta name="apple-mobile-web-app-title" content="AcontPlus" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="theme-color" content="#" />

    <title>AcontPlus</title>

    <link rel="apple-touch-icon" sizes="180x180" href="~/assets/images/icon/apple-touch-icon-180x180.png">
    <link rel="icon" type="image/png" sizes="32x32" href="~/assets/images/icon/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="~/assets/images/icon/favicon-16x16.png">
    <link href="~/favicon.ico" rel="shortcut icon icon" type="image/x-icon" asp-append-version="true" />
    <link href="~/favicon.ico" rel="icon" type="image/x-icon" asp-append-version="true" />
    <link rel="manifest" href="/manifest.json" crossorigin="use-credentials" asp-append-version="true">

    <link href="~/lib/icheck-bootstrap/icheck-bootstrap.min.css" rel="stylesheet" />
    <link href="~/dist/css/pages/login-register-lock.css" rel="stylesheet" />
    <link href="~/dist/css/style.min.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/lib/limonte-sweetalert2/sweetalert2.min.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/lib/toastr/toastr.min.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/spinners.min.css" rel="stylesheet" asp-append-version="true" />
</head>
<body class="skin-blue card-no-border" ng-cloak ng-app="loginApp" ng-controller="loginCtrl">
    <div id="loaderCss"></div>
    <section id="wrapper" class="login-register">
        @* style="background-image:url(../assets/images/background/login-register.jpg);" *@
        <div class="login-box card">
            <div class="card-body">
                <form class="form-horizontal form-material text-center" ng-submit="login()" id="loginform">
                    <a href="javascript:void(0)" class="db">
                        <img class="img-fluid rounded mx-auto d-block" src="~/assets/images/logo/imgLogoTipoAcontplus.jpg" alt="logo" width="90%" height="90%">
                        <br>
                    </a>
                    <h4 class="text-center m-b-20"> Inicio de Sesión</h4>
                    <div class="form-group m-t-40">
                        <div class="col-12">
                            <input class="form-control" type="text" ng-model="data.userName" required="" placeholder="Usuario">
                        </div>
                    </div>
                    <div class="form-group">
                        <div class="col-12">
                            <div class="input-group">
                                <input id="password" ng-model="data.password" type="password" class="form-control text-primary" placeholder="Contraseña" required>
                                <div class="input-group-btn">
                                    <button ng-show="!ver" type="button" class="btn btn-info fa fa-eye" ng-click="verContrasenia(ver)"></button>
                                    <button ng-show="ver" type="button" class="btn btn-info fa fa-eye-slash" ng-click="verContrasenia(ver)"></button>
                                </div>
                            </div>
                        </div>
                    </div>
                    @* <div class="form-group row">
                        <div class="col-md-12">
                            <div class="d-flex no-block align-items-center">
                                <div class="icheck-info">
                                    <input type="checkbox" id="rememberMe" ng-model="data.rememberMe" />
                                    <label for="rememberMe"> Recordarme </label>
                                </div>
                                <input type="text" ng-model="data.returnUrl" id="returnUrl" hidden />
                            </div>
                        </div>
                    </div> *@
                    <div class="form-group text-center m-t-20">
                        <div class="col-12">
                            <button class="btn btn-block btn-lg btn-info btn-rounded" type="submit">Ingresar <i class="fa fa-sign-in-alt"></i></button>
                        </div>
                    </div>

                </form>
                <form class="form-horizontal" id="recoverform" action="index.html">
                    <div class="form-group ">
                        <div class="col-12">
                            <h3>Recover Password</h3>
                            <p class="text-muted">Enter your Email and instructions will be sent to you! </p>
                        </div>
                    </div>
                    <div class="form-group ">
                        <div class="col-12">
                            <input class="form-control" type="text" required="" placeholder="Email">
                        </div>
                    </div>
                    <div class="form-group text-center m-t-20">
                        <div class="col-12">
                            <button class="btn btn-primary btn-lg btn-block text-uppercase waves-effect waves-light" type="submit">Reset</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </section>

    <partial name="_LoginUsuarioEntidad" />

    <script src="~/lib/jquery/jquery.min.js" asp-append-version="true"></script>
    <script src="~/lib/bootstrap/js/bootstrap.min.js" asp-append-version="true"></script>
    <script src="~/lib/angularjs/angular.min.js" asp-append-version="true"></script>
    <script src="~/lib/limonte-sweetalert2/sweetalert2.all.min.js" asp-append-version="true"></script>
    <script src="~/lib/limonte-sweetalert2/sweetalert2.all.js" asp-append-version="true"></script>
    <script src="~/lib/toastr/toastr.min.js" asp-append-version="true"></script>
    <script src="~/js/spinners.min.js" asp-append-version="true"></script>
    <script src="~/lib/ngStorage/ngStorage.min.js" asp-append-version="true"></script>
    <script src="~/js/controllers/loginCtrl.js" asp-append-version="true"></script>

    <script>
        if ('serviceWorker' in navigator) {
            navigator.serviceWorker.register('/service-worker.js', { scope: './' }).then(function (registration) {
                console.log('Service worker registration succeeded:', registration);
            }).catch(function (error) {
                console.log('Service worker registration failed:', error);
            });
        } else {
            console.log('Service workers are not supported.');
        };
    </script>

    @if (ViewData["ReturnUrl"] != null)
    {
        <script type="text/javascript">
            window.onload = function () {
                var returnUrl = '@ViewData["ReturnUrl"]';
                $('#returnUrl').val(returnUrl);
            };
        </script>
    }
</body>
</html>




