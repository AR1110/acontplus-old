@{
    ViewData["Title"] = "Gestión Caja";
}

<div ng-controller="cajaCtrl">
    <div class="row page-titles">
        <div class="col-md-5 align-self-center">
            <h4 class="text-themecolor">Gestión de Cajas</h4>
        </div>
        <div class="col-md-7 align-self-center text-right">
            <div class="d-flex justify-content-end align-items-center">
                @*<ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="javascript:void(0)">Inicio</a></li>
                <li class="breadcrumb-item active">Administración</li>
                <li class="breadcrumb-item active">Cajas</li>
                </ol>*@
                <button type="button" class="btn btn-info m-l-15" ng-if="accion.leer && accion.crear"
                    ng-click="openModalCaja()">
                    <i class="fa fa-plus-circle"></i> Nuevo
                </button>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-condensed table-caja">
                            <thead>
                                <tr>
                                    <th></th>
                                    <th>N°</th>
                                    <th>Caja</th>
                                    <th>Usuario</th>
                                    <th>Turno</th>
                                    <th>Actividad</th>
                                    <th>Estado</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="c in cajas">
                                    <td>
                                        <md-menu>
                                            <md-button aria-label="Open demo menu" class="md-icon-button"
                                                ng-click="$mdMenu.open($event)">
                                                <icon class="mdi mdi-menu"></icon>
                                            </md-button>
                                            <md-menu-content class="md-dense">
                                                <md-menu-item ng-if="accion.editar">
                                                    <md-button ng-click="openModalCaja(c)">
                                                        <span md-menu-align-target><i class="ti-pencil"></i>
                                                            Editar</span>
                                                    </md-button>
                                                </md-menu-item>

                                                <md-menu-item ng-if="accion.eliminar">
                                                    <md-button ng-click="askToDeleteCaja(c)">
                                                        <span md-menu-align-target><i class="ti-trash"></i>
                                                            Eliminar</span>
                                                    </md-button>
                                                </md-menu-item>

                                                <md-menu-item>
                                                    <md-button ng-click="openModalApertura(c)">
                                                        <span md-menu-align-target><i class="ti-briefcase"></i>
                                                            Aperturar</span>
                                                    </md-button>
                                                </md-menu-item>

                                                <md-menu-item>
                                                    <md-button ng-click="openModalAsignUsuarioTurno(c)">
                                                        <span md-menu-align-target><i class="ti-user"></i> Asignar
                                                            usuario/turno</span>
                                                    </md-button>
                                                </md-menu-item>

                                                <md-menu-item>
                                                    <md-button ng-click="openModalMovimientoCaja(c.caja.idCaja)">
                                                        <span md-menu-align-target><i class="ti-wallet"></i>
                                                            Movimientos</span>
                                                    </md-button>
                                                </md-menu-item>


                                            </md-menu-content>
                                        </md-menu>
                                    </td>
                                    <td>{{$index+1}}</td>
                                    <td>{{c.caja.descripcion}}</td>
                                    <td>{{c.usuarioAsignado=='0'?'SIN ASIGNAR': c.usuarioAsignado}}</td>
                                    <td>
                                        <div class="dropdown dropdownTurno">
                                            <a class="dropdownTurno" href="javascript:void(0)" type="button"
                                                id="dropdownTurno{{$index+1}}" ng-click="detalleHorario(c.idTurno)"
                                                data-toggle="dropdown" data-boundary="viewport" aria-haspopup="true"
                                                aria-expanded="false">
                                                {{c.turno==='0'?'': c.turno}}
                                            </a>
                                            <div class="dropdown-menu" aria-labelledby="dropdownTurno">
                                                <div class="px-2 py-2">
                                                    <h5>{{c.turno }}</h5>
                                                    <partial name="_VistaTurno" />
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>{{c.conectado}}</td>
                                    <td ng-bind-html="c.caja.estado | estadoPrimario"></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>



@section Scripts{
    <script src="~/js/controllers/admin/cajaCtrl.min.js" asp-append-version="true"></script>
    @* <script src="~/js/config/controllers/cajaCtrl.min.js" asp-append-version="true"></script> *@
}