@{
    ViewData["Title"] = "Gestión Caja";
}

<div ng-controller="cajaCtrl">
    <div class="row page-titles">
        <div class="col-md-5 align-self-center">
            <h4 class="text-themecolor">Gestión de Cajas</h4>
        </div>
        <div class="col-md-7 align-self-center text-right">
            <div class="d-flex justify-content-end align-items-center">
                @*<ol class="breadcrumb">
                        <li class="breadcrumb-item"><a href="javascript:void(0)">Inicio</a></li>
                        <li class="breadcrumb-item active">Administración</li>
                        <li class="breadcrumb-item active">Cajas</li>
                    </ol>*@
                <button type="button" class="btn btn-info m-l-15" ng-if="accion.leer && accion.crear" ng-click="openModalCaja()">
                    <i class="fa fa-plus-circle"></i> Nuevo 
                </button>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-condensed table-caja">
                            <thead>
                                <tr>                                    
                                    <th>N°</th>
                                    <th>Caja</th>
                                    <th>Usuario</th>
                                    <th>Turno</th>
                                    <th>Actividad</th>
                                    <th>Estado</th>
                                    <th>Op.</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="c in cajas">                                    
                                    <td>{{$index+1}}</td>
                                    <td>{{c.caja.descripcion}}</td>
                                    <td>{{c.usuarioAsignado=='0'?'SIN ASIGNAR': c.usuarioAsignado}}</td>
                                    <td>
                                        <div class="dropdown dropdownTurno">
                                            <a class="dropdownTurno" href="javascript:void(0)" type="button" id="dropdownTurno{{$index+1}}" ng-click="detalleHorario(c.idTurno)" data-toggle="dropdown" data-boundary="viewport" aria-haspopup="true" aria-expanded="false">
                                                {{c.turno==='0'?'': c.turno}}                                             
                                            </a>
                                            <div class="dropdown-menu" aria-labelledby="dropdownTurno">
                                                <div class="px-2 py-2">
                                                    <h5>{{c.turno }}</h5>
                                                   <partial name="_VistaTurno"/>
                                                </div>                                                                                                
                                            </div>
                                        </div>   
                                    </td>
                                    <td>{{c.conectado}}</td>
                                    <td ng-bind-html="c.caja.estado | estadoPrimario"></td>
                                    <td>
                                        <div class="dropdown dropdownOp">
                                            <a id="dropdownOp" data-toggle="dropdown" data-boundary="viewport">
                                                <i class="fa fa-bars"></i>
                                            </a>
                                            <div class="dropdown-menu" aria-labelledby="dropdownOp">
                                                <h6 class="dropdown-header" ng-show="accion.editar || accion.eliminar">Acciones</h6>
                                                <button class="dropdown-item" type="button" ng-if="accion.editar" ng-click="openModalCaja(c)"><i class="ti-pencil"></i> Editar</button>                                               
                                                <button class="dropdown-item" type="button" ng-if="accion.eliminar" ng-click="askToDeleteCaja(c)"><i class="ti-trash"></i> Eliminar</button>                                               
                                                <div class="dropdown-divider"></div>
                                                <a class="dropdown-item" href="javascript:void(0)"  ng-click="openModalApertura(c)"><i class="ti-briefcase"></i> Aperturar</a>
                                                <a class="dropdown-item" href="javascript:void(0)" ng-click="openModalAsignUsuarioTurno(c)"><i class="ti-user"></i> Asignar usuario/turno</a>
                                                <a class="dropdown-item" href="javascript:void(0)" ng-click="openModalMovimientoCaja(c.caja.idCaja)"><i class=" ti-wallet"></i> Movimientos</a>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>



@section Scripts{
    <script src="~/js/controllers/admin/cajaCtrl.min.js" asp-append-version="true"></script>    
}