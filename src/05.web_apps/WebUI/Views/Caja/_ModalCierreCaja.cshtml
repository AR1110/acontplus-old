<div class="modal-header">
    <h4 class="modal-title">Cierre Caja</h4>
    <button type="button" class="close" ng-click="$ctrl.closeModal()">&times;</button>
</div>
<div class="modal-body">
    <div class="row">
        <div class="col-lg-3 col-md-3 col-sm-4 col-12" ng-repeat="a in $ctrl.arqueos">
            <div class="form-group">
                <h6>{{a.descripcion}}</h6>
                <input type="text" valid-number class="form-control border-select" uib-tooltip="{{a.descripcion}}"  
                        tooltip-trigger="'mouseenter'" tooltip-placement="top"  ng-model="a.cantidad"
                        ng-change="$ctrl.calcularCantidadMoneda()" >
            </div>
        </div>
        <h4 class="ml-auto">Total: <span>{{$ctrl.totalArqueo|currency:'$'}}</span> </h4>
    </div>
</div>
<div class="modal-footer">
    <button type="button" class="btn btn-success" ng-click="$ctrl.guardarCierreCaja()">
        <i class="ti-save"></i> Guardar                          
    </button>
    <button type="button" class="btn btn-dark" ng-click="$ctrl.closeModal()">&times; Cerrar</button>
</div>
        