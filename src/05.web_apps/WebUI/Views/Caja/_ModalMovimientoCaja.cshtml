<div class="modal-header">
    <h5 class="modal-title">Movimiento Caja</h5>
    <button class="close" ng-click="$ctrl.closeModal()">&times;</button>
</div>
<div class="modal-body">
    <div class="row justify-content-between justify-content-sm-around">
        <div class="col-xl-6 col-lg-6 col-md-5 col-sm-12 col-xs-12">
            <button type="button" class="btn btn-info" ng-click="$ctrl.openModalFiltro()">
                <i class="fa fa-filter"></i> Filtro
            </button>
        </div>
        <div class="col-xl-6 col-lg-6 col-md-5 col-sm-12 col-xs-12">
            <div class="form-group">
                <div class="input-group">
                    <input type="text" class="form-control border-select" ng-model="$ctrl.dataSearch.bySearch" ng-keyup="$ctrl.searchFilterLocal()" placeholder="Buscar">
                    <div class="input-group-append">
                        <button type="button" class="btn btn-secondary" ng-click="$ctrl.reloadMovimientoCaja()">
                            <i class="fa fa-redo"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!--Include Table Movimiento Caja-->
    <div ng-include="$ctrl.theURLTableMovimientoCaja()"></div>           

</div>
<div class="modal-footer">
    <button type="button" class="btn btn-dark" ng-click="$ctrl.closeModal()">&times; Cerrar</button>
</div>
        