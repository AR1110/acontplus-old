@{
    ViewData["Title"] = "Index";
}

<div ng-controller="impresoraCtrl" ng-init="initialLoad()">
    <div class="row page-titles">
        <div class="col-md-5 align-self-center">
            <h4 class="text-themecolor">Impresoras</h4>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <button class="btn btn-info" ng-click="openModalNew()"><i class="ti-printer"></i> Agregar
                                Impresora</button>
                        </div>
                    </div>
                    <hr>
                    <div class="table-responsive">
                        <table class="table table-no-bordered">
                            <thead>
                                <tr>
                                    <th>N°</th>
                                    <th>Nombre</th>
                                    <th class="text-center">Tipo Impr.</th>                                                                        
                                    <th class="text-center">Predeterminada</th>                                                         
                                    <th class="text-center">Copia</th>                                                                        
                                    <th class="text-center">Estab.</th>                                                                        
                                    <th class="text-center">Opciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="item in printers |filter:buscar">
                                    <td>{{$index+1}}</td>
                                    <td>{{item.nombreImpresora}}</td>
                                    <td class="text-center">{{item.tipoImpresora}}</td>
                                    <td class="text-center" ng-bind-html="item.predeterminada | sino"></td>                                    
                                    <td class="text-center" ng-bind-html="item.copyPrint | sino"></td>
                                    <td class="text-center">{{item.nombreComercial}}</td>
                                    <td class="text-center">
                                        <button class="btn btn-warning btn-sm" ng-click="openEdit(item)"><i
                                                class="ti-pencil"></i></button>
                                        <button class="btn btn-danger btn-sm" ng-click="askToDelete(item)"><i
                                                class="ti-trash"></i></button>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    
    <div id="addUpdatePrinter" class="modal fade" tabindex="-1" role="dialog" data-backdrop="static" data-keyboard="false">
        <div class="modal-dialog">
            <div class="modal-content">
                <form ng-submit="saveEdit()">
                    <div class="modal-header">
                        <h5 class="modal-title">
                            {{tipoRegistro==1?'Nuevo':'Editar'}} Impresora
                        </h5>
                        <button type="button" class="close" data-dismiss="modal">&times;</button>
                    </div>
                    <div class="modal-body">
                        <div class="row">
                            <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">
                                <div class="form-group">
                                    <label for="">Sucursal: <span class="text-danger">*</span></label>
                                    <select class="form-control border-select" ng-model="data.codEstab">
                                        <option ng-value="item.codEstab" ng-repeat="item in sucursales">
                                            {{item.nombreComercial}}
                                        </option>
                                    </select>
                                </div>
                            </div>
                        </div>                       

                        <div class="row">
                            <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">
                                <div class="form-group">
                                    <label for="namePrinterEdit">Nombre Impresora: <span class="text-danger">*</span> </label>
                                    <input type="text" id="namePrinterEdit" class="form-control border-select"
                                        ng-model="data.nombreImpresora">
                                </div>
                            </div>

                            <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">
                                <div class="form-group">
                                    <label for="">Tipo Impresora <span class="text-danger">*</span></label>
                                    <select class="form-control border-select" ng-model="data.idTipoImpresora">
                                        <option ng-value="item.idTipoImpresora" ng-repeat="item in tipoImpresoras">
                                            {{item.descripcion}}
                                        </option>
                                    </select>
                                </div>
                            </div>

                        </div>

                        <div class="row justify-content-between">                            
                            <div class="col-xl-5 col-lg-5 col-md-5 col-sm-5 col-12">
                                <div class="form-group">
                                    <label for="">Copia Impresión</label>
                                    <div class="icheck-info">
                                        <input type="checkbox" id="copiaImpresion" ng-model="data.copyPrint" />
                                        <label for="copiaImpresion"></label>
                                    </div>
                                </div>                                
                            </div>
                            
                            <div class="col-xl-5 col-lg-5 col-md-5 col-sm-5 col-12">
                                <div class="form-group">
                                    <label>Predeterminada</label>
                                    <div class="icheck-warning">
                                        <input type="checkbox" id="checkDefault" ng-model="data.predeterminada" />
                                        <label for="checkDefault"></label>
                                    </div>
                                </div>
                            </div>
                        </div>                   
                    </div>
                    <div class="modal-footer">
                        <button type="submit" class="btn btn-success"><i class="ti-save"></i> Guardar</button>
                        <button type="button" class="btn btn-dark" data-dismiss="modal">&times; Cancelar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    @* <button class="btn btn-danger" ng-click="print()">print</button> *@
</div>
@section Scripts{
<script src="~/js/controllers/reportes/impresoraCtrl.min.js" asp-append-version="true"></script>
}
