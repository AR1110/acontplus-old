@{
    ViewData["title"] = "Ingreso a Bodega";
}

<div ng-controller="ingresoBodegaCtrl">
    <div class="row page-titles">
        <div class="col-md-5 align-self-center">
            <h4 class="text-themecolor">Ingreso a Bodega</h4>
        </div>
        <div class="col-md-7 align-self-center text-right">
            <div class="d-flex justify-content-end align-items-center">
               <!-- <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/Home/Index">Inicio</a></li>
                    <li class="breadcrumb-item"><a href="javascript:void(0)">Compras </a></li>
                    <li class="breadcrumb-item active">Ingreso a Bodega</li>
                </ol>-->
                <button type="button" ng-if="accion.crear" class="btn btn-info m-l-15" ng-click="openModalNew()" id="btnAgregar"><i class="fa fa-plus-circle"></i> Nuevo</button>
            </div>
        </div>
    </div>
    
    @await Html.PartialAsync("_ModalFiltro.cshtml")

    <!--Main -->
    <div class="row">
        <div class="col-lg-12">            
            <md-card>
                <md-toolbar class="md-table-toolbar md-default _md _md-toolbar-transitions">
                    <div class="md-toolbar-tools">
                        <div class="col-lg-9 col-md-9 col-sm-1">
                            <button type="button" class="btn btn-info" ng-click="openModalFiltro()"><i class="fa fa-filter"></i> Filtrar</button>                
                        </div>
                        <div class="col-lg-3 col-md-3 col-sm-12 col-xs-12">
                            <form class="form-material">
                                <input type="text" class="form-control" ng-model="buscar" placeholder="Buscar">
                            </form>
                        </div>
                    </div>
                </md-toolbar>      
                <md-table-container style="max-height: 400px;">
                    <table resize md-table>
                        <thead fix-head md-head>
                            <tr md-row>
                                <th md-column><span>Op</span></th>
                                <th md-column><span>N°</span></th>
                                <th md-column><span>N°. Doc</span></th>
                                <th md-column><span>F. Emisión</span></th>
                                <th md-column><span>F. Vcto</span></th>
                                <th md-column><span>Proveedor</span></th>
                                <th md-column><span>Estado</span></th>
                                <th md-column><span>Total</span></th>
                                <th md-column><span>Abono</span></th>
                                <th md-column><span>Saldo</span></th>
                                <th md-column><span>Usuario</span></th>
                            </tr>
                        </thead>
                        <tbody md-body>
                            <tr md-row ng-repeat="item in ingresoBodegas" ng-class="item.style">
                                <td md-cell>
                                    <md-menu>
                                        <md-button aria-label="Open demo menu" class="md-icon-button"
                                                   ng-click="$mdMenu.open($event)">
                                            <icon class="mdi mdi-menu"></icon>
                                        </md-button>
                                        <md-menu-content class="md-dense">
                                            <md-menu-item>
                                                <md-button ng-click="openModalDetalle(item)">
                                                    <span md-menu-align-target><i class="ti-menu"></i> Detalle</span>
                                                </md-button>
                                            </md-menu-item>

                                            <md-menu-item ng-if="accion.editar">
                                                <md-button ng-click="openModalEditar(item)" ng-disabled="item.anulada || item.pago || item.gestionFinanciera">
                                                    <span md-menu-align-target><i class="ti-pencil"></i> Editar</span>
                                                </md-button>
                                            </md-menu-item>

                                            <md-menu-item ng-if="accion.anular">
                                                <md-button ng-click="askToDelete(item)" ng-disabled="item.anulada">
                                                    <span md-menu-align-target><icon class="ti-na"></icon> Anular</span>
                                                </md-button>
                                            </md-menu-item>


                                            <md-menu-item>
                                                <md-button ng-click="openModalCuota(item)">
                                                    <span md-menu-align-target><i class="fas fa-donate"></i> Cuotas</span>
                                                </md-button>
                                            </md-menu-item>

                                            <md-menu-item ng-if="accion.cobroPago">
                                                <md-button ng-click="openModalPago(item)" ng-disabled="item.pago || item.anulada">
                                                    <span md-menu-align-target><i class=" far fa-money-bill-alt"></i> Pago</span>
                                                </md-button>
                                            </md-menu-item>

                                            <md-menu-item ng-if="accion.historialFinanciero">
                                                <md-button ng-click="openModalHistorialPago(item)">
                                                    <span md-menu-align-target><icon class=" fas fa-tasks"></icon> Hist. Mov.</span>
                                                </md-button>
                                            </md-menu-item>

                                            <md-menu-item ng-if="accion.reporte">
                                                <md-button ng-click="getReport(item)">
                                                    <span md-menu-align-target><i class=" ti-file"></i> PDF</span>
                                                </md-button>
                                            </md-menu-item>


                                        </md-menu-content>
                                    </md-menu>
                                </td>
                                <td md-cell>{{$index+1}}</td>
                                <td md-cell>{{item.nroDocumento}}</td>
                                <td md-cell>{{item.fechaEmision}}</td>
                                <td md-cell>{{item.fechaVencimiento}}</td>
                                <td md-cell>{{item.nombreFiscal}}</td>
                                <td md-cell>{{item.estadoFinanciero}}</td>
                                <td md-cell>${{item.total}}</td>
                                <td md-cell>${{item.abono}}</td>
                                <td md-cell>${{item.saldo}}</td>
                                <td md-cell>{{item.usuario}}</td>

                            </tr>
                            <tr ng-show="ingresoBodegas.length===0" class="text-center">
                                <td colspan="11">No hay registros.</td>
                            </tr>                
                            
                        </tbody>
                    </table>
                </md-table-container>                   
            </md-card>                         
        </div>
    </div>           
</div>

@section Scripts{      
    <script src="~/js/components/mdAutocompleteProveedor.min.js" asp-append-version="true"></script>  
    <script src="~/js/controllers/compras/ingresoBodegaCtrl.js" asp-append-version="true"></script>    
  
}


