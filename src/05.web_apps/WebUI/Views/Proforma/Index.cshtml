@{
    ViewData["title"] = "Proforma";
}


<div ng-controller="proformaCtrl">
    <div class="row page-titles">
        <div class="col-lg-5 align-self-center">
            <h5 class="text-themecolor">Gestión de Proforma</h5>
        </div>
        <div class="col-lg-7 align-items-center text-right">
            <div class="d-flex justify-content-end align-items-center">                
                <button type="button" class="btn btn-info m-l-15" ng-if="accion.crear" ng-click="openModalNew()"><i class="fa fa-plus-circle"></i>  Nuevo</button>  
                @* <button type="button" class="btn btn-danger m-l-15" ng-if="accion.crear" ng-click="openModalProformaTest()"><i class="fa fa-plus-circle"></i>  Nuevo Test</button>     *@
            </div>
        </div>
    </div>
    
    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <md-toolbar class="md-table-toolbar md-default">
                    <div class="md-toolbar-tools">
                        <div class="col-lg-9 col-md-9 col-sm-12 col-xs-12">
                            <button type="button"  class="btn btn-info" ng-click="openModalFiltro()"><i class=" fas fa-filter"></i> Filtrar</button>
                           <button class="btn  waves-effect waves-light btn-secondary" ng-click="getProformas()"><i class=" fas fa-sync"></i></button>                                                                                                                          
                        </div>
                        <div class="col-lg-3 col-md-3 col-sm-12 col-xs-12">
                            <form class="form-material">
                                <input type="text" class="form-control" ng-model="dataSearch.bySearch" ng-keyup="searchLocalProforma()" placeholder="Buscar Proforma">
                            </form>
                        </div> 
                    </div>
                </md-toolbar>
                <md-table-container style="max-height: 400px;">
                    <table resize md-table>
                        <thead fix-head md-head md-trim-column-names>
                            <tr md-row>
                                <th md-column></th>
                                <th md-column>N°</th>
                                <th md-column>Nro. Doc</th>
                                <th md-column>Fecha Emisión</th>
                                <th md-column>Cliente</th>
                                <th md-column>Total</th>
                                <th md-column>Estado Doc.</th>
                                <th md-column>Usuario</th>
                            </tr>
                        </thead>
                        
                        <tbody md-body>
                            <tr md-row ng-repeat="p in proformas">
                                <td md-cell>                                    
                                    <md-menu>
                                        <md-button aria-label="Open demo menu" class="md-icon-button"
                                                    ng-click="$mdMenu.open($event)">
                                            <icon class="mdi mdi-menu"></icon>
                                        </md-button>
                                        <md-menu-content class="md-dense">
                                            <md-menu-item>                                            
                                                <md-button ng-click="openModalDetalle(p)">
                                                    <span md-menu-align-target><i class="ti-menu"></i> Detalle</span>
                                                </md-button>
                                            </md-menu-item> 

                                            <md-menu-item ng-if="accion.editar">                                                                                        
                                                <md-button  ng-click="openModalEdit(p)">
                                                    <span md-menu-align-target><i class="ti-pencil"></i> Editar</span>
                                                </md-button>
                                            </md-menu-item> 

                                            
                                            <md-menu-item ng-if="accion.anular">                                                                                        
                                                <md-button   ng-click="askToDelete(p)">
                                                    <span md-menu-align-target><i class="mdi mdi-block-helper"></i> Anular</span>
                                                </md-button>
                                            </md-menu-item>                                                                    

                                            <md-menu-item>                                                                                      
                                                <md-button  ng-click="openModalDuplicate(p)">
                                                    <span md-menu-align-target><i class="ti-files"></i> Duplicar</span>
                                                </md-button>
                                            </md-menu-item>
                                                                                                                                 
                                            <md-menu-item  ng-if="accion.reporte">                                                                                        
                                                <md-button ng-click="getReport(p)">
                                                    <span md-menu-align-target><i class=" ti-file"></i> PDF</span>
                                                </md-button>
                                            </md-menu-item>
                                            
                                            <md-menu-item ng-if="accion.enviarCorreo">                                                                                      
                                                <md-button ng-click="askToSendEmail(p)">
                                                    <span md-menu-align-target><i class="far fa-envelope"></i> Enviar Correo</span>
                                                </md-button>
                                            </md-menu-item>
                                        </md-menu-content>
                                    </md-menu>
                                </td>
                                <td md-cell>{{$index+1}}</td>
                                <td md-cell>{{p.nroDocumento}}</td>
                                <td md-cell>{{p.fechaEmision}}</td>
                                <td md-cell>
                                    <span data-toggle="tooltip" data-placement="top" tooltip title="" data-original-title="{{p.nroIdentificacion}}">{{p.nombreFiscal}}
                                    </span>
                                </td>
                                <td md-cell>${{p.total}}</td>
                                <td md-cell>{{p.estadoDoc}}</td>
                                <td md-cell>{{p.usuario}}</td>
                            </tr>
                            <tr class="text-center" ng-show="proformas.length==0">
                                <td colspan="8">No hay registros en esta tabla</td>
                            </tr>
                        </tbody>
                        <tfoot md-foot>
                            <tr md-row>
                                <td md-cell colspan="5"><span class="font-weight-bold">Total:</span></td>
                                <td md-cell><span class="font-weight-bold">{{total}}</span></td>
                                <td md-cell></td>
                                <td md-cell></td>
                            </tr>
                        </tfoot>
                    </table>
                </md-table-container>        
            </div>
        </div>
    </div>
</div>

@section Scripts{               
    <script src="~/js/controllers/ventas/proformaCtrl.js" asp-append-version="true"></script>             
}