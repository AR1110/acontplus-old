<div class="modal-header">
    <h5 class="modal-title">{{tipoRegistro===1?'Nuevo':'Editar'}} Modelo</h5>
    <button type="button" class="close" ng-click="closeModal()" aria-label="Close">
        <span aria-hidden="true">&times;</span>
    </button>
</div>
<div class="modal-body">
    <div class="row">
        <div class="form-group col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <label for=""> Marca: </label>           
            <div class="input-group">
                <select class="form-control border-select" ng-model="marca" ng-options="m as m.descripcion for m in marcas track by m.idMarca "></select>
                <div class="input-group-append">
                    <button class="btn btn-outline-secondary btn-sm" btn-add-update-marca results="resultModalMarca(item)" tabindex="-1"><i class="fa fa-plus fa-xs"></i></button>
                </div>
            </div> 
        </div>
    </div>
    <div class="row">
        <div class="form-group col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <label for="">Descripción: <span class="text-danger">*</span> </label>           
            <input type="text" ng-model="data.descripcion" class="form-control border-select" placeholder="Ej: L1702">
            
        </div>
    </div>
    <div class="row" ng-if="tipoRegistro==2 && showStatus">
        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <label>Estado</label>
            <md-radio-group ng-model="data.estado">
                <md-radio-button class="md-primary" ng-value="true">Activo</md-radio-button>
                <md-radio-button ng-value="false">Inactivo</md-radio-button>
            </md-radio-group>
        </div>
    </div>                            
</div>
<div class="modal-footer">
    <button type="button" class="btn btn-success" ng-click="saveAndUpdate()">
        {{tipoRegistro===1?'Guardar':'Actualizar'}}
    </button>
    <button type="button" class="btn btn-dark" ng-click="closeModal()">&times; Cerrar</button>
</div>