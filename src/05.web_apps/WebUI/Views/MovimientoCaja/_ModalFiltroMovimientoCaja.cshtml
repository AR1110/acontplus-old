<div id="modalFiltroMovimientoCaja" class="modal fade" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title1">Búsqueda</h5>
            </div>
            <div class="modal-body">
                <div class="row justify-content-between">                    
                    <div class="col-xl-4 col-lg 4 col-md-4 col-sm-6 col-12">
                        <div class="icheck-info">
                            <input type="checkbox" ng-model="$ctrl.dataSearch.checkBoxFecha" ng-change="$ctrl.onChangeFechaFilterMovimientoCaja()" id="checkboxFechaFilterMC" name="checkboxFecha">
                            <label for="checkboxFechaFilterMC">Fecha</label>
                        </div>
                    </div>
                    <div class="col-xl-4 col-lg 4 col-md-4 col-sm-6 col-12">
                        <div class="icheck-info">
                            <input type="checkbox" ng-model="$ctrl.dataSearch.checkBoxEmpleado" id="checkboxEmpleadoFilterMC" >
                            <label for="checkboxEmpleadoFilterMC">Empleado</label>
                        </div>
                    </div>
                    <div class="col-xl-4 col-lg 4 col-md-4 col-sm-6 col-12">
                        <div class="icheck-info">
                            <input type="checkbox" ng-model="$ctrl.dataSearch.checkBoxEstado" id="checkboxEstadoFilterMC" >
                            <label for="checkboxEstadoFilterMC">Estado</label>
                        </div>                        
                    </div>
                </div>
                <hr>

                <div class="row">
                    <div class="col-xl-6 col-lg-6 col-md-6 col-sm-12 col-12">
                        <div class="form-group">
                            <label for="">Estab.:</label>
                            <select name="" id="" class="form-control" ng-model="$ctrl.dataSearch.codEstab">
                                <option ng-value="item.codEstab" ng-repeat="item in $ctrl.establecimientos">
                                    {{item.nombreComercial}}
                                </option>
                            </select>
                        </div>
                    </div>

                </div>

                <div class="row" ng-show="$ctrl.dataSearch.checkBoxFecha">
                    <div class="col-xl-4 col-lg-4 col-md-4 col-sm-12 col-12">
                        <div class="form-group">
                            <label class="control-label">Mes: </label>
                            <select ng-model="$ctrl.dataSearch.mes" class="form-control" ng-change="$ctrl.getFechaInicioFinFilter()">
                                <option ng-value="m.numero" ng-repeat="m in $ctrl.meses">{{m.nombre}}</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-xl-4 col-lg-4 col-md-4 col-sm-6 col-12">
                        <div class="form-group">
                            <label>Fecha Inicio:</label>
                            <input type="date" class="form-control" ng-model="$ctrl.dataSearch.fechaInicio" />
                        </div>
                    </div>
                    <div class="col-xl-4 col-lg-4 col-md-4 col-sm-6 col-12">
                        <div class="form-group">
                            <label>Fecha Fin:</label>
                            <input type="date" class="form-control" ng-model="$ctrl.dataSearch.fechaFin" value="" required />
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-xl-6 col-lg-6 col-md-6 col-sm-12 col-12" ng-if="$ctrl.dataSearch.checkBoxEmpleado">
                        <div class="form-group">
                            <label for="filterEmpleado">Empleado</label>
                            <input type="text"
                                autocomplete="off"
                                class="form-control border-select"
                                placeholder="Ingrese Descripción"
                                ng-model="$ctrl.selectedEmpleado"
                                ng-keyup="$ctrl.onKeyupSearchEmpleado()"
                                uib-typeahead="e as e.nombreCompleto for e in $ctrl.searchEmpleado($viewValue)"
                                typeahead-loading="loadingLocations"
                                typeahead-no-results="data.noResults"
                                typeahead-items="1"
                                typeahead-wait-ms="10"                            
                                typeahead-template-url="autocompleteEmpleado.html"
                                typeahead-editable="false"                                                
                                typeahead-on-select="$ctrl.selectedEmpleadoChange($item)" />
                                <script type="text/ng-template" id="autocompleteEmpleado.html">
                                    <div class="autocomplete-suggestion-uib-typeahead">
                                        <span class="item-title">
                                            <strong>{{match.model.nroIdentificacion}}</strong> - {{match.model.nombreCompleto}}
                                        </span>
                                    </div>
                                </script>
                            <small ng-show="$ctrl.data.noResults" class="text-danger">No se encontraron los resultados</small>
                        </div>
                    </div>

                    <div class="col-xl-6 col-lg-6 col-md-6 col-sm-12 col-12" ng-if="$ctrl.dataSearch.checkBoxEstado">
                        <div class="form-group">
                            <label>Estado:</label>                            
                            <select class="form-control" ng-model="$ctrl.dataSearch.byEstado">
                                <option ng-value="item.idEstadoPago" ng-repeat="item in $ctrl.estados">
                                    {{item.descripcion}}
                                </option>
                            </select>                    
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-success" ng-click="$ctrl.filtrarMovimientoCaja()">Buscar</button>
                <button class="btn btn-dark" data-dismiss="modal">&times; Cerrar</button>
            </div>
        </div>
    </div>
</div>