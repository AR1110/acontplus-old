<div id="modalFiltroAnticipo" class="modal fade in" role="document">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title1">Filtro Anticipo</h5>
            </div>
            <div class="modal-body">
                <div class="row justify-content-between">
                    <div class="col-xl-4 col-lg-4 col-md-4 col-sm-4 col-xs-12">
                        <div class="icheck-info">
                            <input type="checkbox" id="checkBoxFecha" ng-model="$ctrl.dataSearchAnticipo.checkBoxFecha"  ng-change="$ctrl.onChangeFechaFilter()">
                            <label for="checkBoxFecha">Fecha</label>
                        </div>                        
                    </div>
                    <div class="col-xl-4 col-lg-4 col-md-4 col-sm-4 col-xs-12">
                        <div class="icheck-info">
                            <input type="checkbox" id="checkBoxCliente" ng-model="$ctrl.dataSearchAnticipo.checkBoxCliente" >
                            <label for="checkBoxCliente">Cliente</label>
                        </div>
                    </div>
                    <div class="col-xl-4 col-lg-4 col-md-4 col-sm-4 col-xs-12">
                        <div class="icheck-info">
                            <input type="checkbox" id="checkBoxEstado" ng-model="$ctrl.dataSearchAnticipo.checkBoxEstado">
                            <label for="checkBoxEstado">Estado</label>
                        </div>
                    </div>
                </div>
                <hr>

                <div class="row">
                    <div class="col-xl-6 col-lg-6 col-md-6 col-sm-12 col-xs-12">
                        <div class="form-group">
                            <label for="">Estab.:</label>
                            <select name="" id="" class="form-control" ng-model="$ctrl.dataSearchAnticipo.codEstab">
                                <option ng-value="item.codEstab" ng-repeat="item in $ctrl.establecimientos">
                                    {{item.nombreComercial}}
                                </option>
                            </select>
                        </div>
                    </div>

                </div>


                <div class="row" ng-show="$ctrl.dataSearchAnticipo.checkBoxFecha">
                    <div class="col-xl-4 col-lg-4 col-md-4 col-sm-12 col-12">
                        <div class="form-group">
                            <label class="control-label">Mes: </label>
                            <select ng-model="$ctrl.dataSearchAnticipo.mes" class="form-control" ng-change="$ctrl.getFechaInicioFinFilter('fechaAnticipo')">
                                <option ng-value="m.numero" ng-repeat="m in $ctrl.meses">{{m.nombre}}</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-xl-4 col-lg-4 col-md-4 col-sm-6 col-12">
                        <div class="form-group">
                            <label>Fecha Inicio:</label>
                            <input type="date" class="form-control" ng-model="$ctrl.dataSearchAnticipo.fechaInicio" />
                        </div>
                    </div>
                    <div class="col-xl-4 col-lg-4 col-md-4 col-sm-6 col-12">
                        <div class="form-group">
                            <label>Fecha Fin:</label>
                            <input type="date" class="form-control" ng-model="$ctrl.dataSearchAnticipo.fechaFin" value="" required />
                        </div>
                    </div>
                </div>

                <div class="row" >
                    <div class="col-xl-6 col-lg-6 col-md-6 col-sm-12 col-xs-12" ng-if="$ctrl.dataSearchAnticipo.checkBoxCliente">
                        <div class="form-group">
                            <label for="clientePersonalizado">Cliente</label>
                            <input type="text" id="autocompleteCliente"
                                autocomplete="off"
                                name="autocompleteCliente"
                                class="form-control border-select"
                                placeholder="Ingrese C.I o Nombre Fiscal"
                                ng-model="$ctrl.dataSearchAnticipo.selelectedCliente"
                                typeahead-wait-ms="10"
                                ng-keyup="$ctrl.onKeyupSearchCliente()"
                                uib-typeahead="a as a.nombreFiscal for a in $ctrl.clienteSearch($viewValue)"
                                typeahead-loading="$ctrl.data.loadingSearchCliente"
                                typeahead-no-results="$ctr.data.noResultsCliente"
                                typeahead-template-url="autocompleteCliente.html"
                                typeahead-editable="false"
                                typeahead-on-select="$ctrl.selectedClienteChange($item)" />

                                <script type="text/ng-template" id="autocompleteCliente.html">
                                    <div class="autocomplete-suggestion-uib-typeahead">
                                        <span class="item-title">
                                            <b> {{match.model.numeroIdentificacion}}</b> - {{match.model.nombreFiscal}}
                                        </span>
                                    </div>
                                </script>
                        </div>

                    </div>
                    <div class="col-xl-6 col-lg-6 col-md-6 col-sm-12 col-xs-12" ng-if="$ctrl.dataSearchAnticipo.checkBoxEstado">
                        <div class="form-group">
                            <label>Estado:</label>                            
                            <select class="form-control" ng-model="$ctrl.dataSearchAnticipo.byEstado">
                                <option ng-value="item.idEstadoPago" ng-repeat="item in $ctrl.estados">
                                    {{item.descripcion}}
                                </option>
                            </select>                    
                        </div>
                    </div>
                </div>

            </div>
            <div class="modal-footer">
                <button class="btn btn-success" ng-click="$ctrl.filtrarAnticipo()">
                    <i class="fa fa-search"></i> Buscar
                </button>
                <button class="btn btn-dark" data-dismiss="modal">
                    &times; Cerrar
                </button>
            </div>
        </div>
    </div>
</div>