<form ng-submit="$ctrl.onSave()">
    
    <div class="modal-header bg-success text-white">
        <h5 class="modal-title">Nuevo Punto de Emisión</h5>
        <button type="button" class="close" ng-click="$ctrl.closeModal()">&times;</button>
    </div>
    <div class="modal-body">
        <div class="row">
            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                <div class="form-group">
                    <label for="">Sucursal: </label>                                                                                      
                    <input type="text" ng-model="$ctrl._params.nombreComercial" class="form-control" readonly>                                                  
                </div>
            </div>
            <div class="form-group col-lg-12 col-md-12 col-sm-12 col-xs-12">
                <label for="">Punto Emisión: <span class="text-danger">*</span> </label>
                <input type="text" ng-model="$ctrl.data.ptoEmi" valid-number mask="999"  class="form-control border-select" placeholder="002">
            </div>
        </div>
        <div class="row">
            <div class="form-group col-lg-6 col-md-6 col-sm-6 col-xs-12">
                <label for="">Tipo Ambiente</label>                                  
                <md-radio-group ng-model="$ctrl.data.ambiente" aria-labelledby="tipoAmbiente">
                    <md-radio-button ng-value="item.ambiente" ng-repeat="item in $ctrl.tipoAmbientes" class="md-primary">{{item.descripcion}}</md-radio-button>
                </md-radio-group>
            </div>
            <div class="form-group col-lg-6 col-md-6 col-sm-6 col-xs-12" ng-show="tipoRegistro==2">
                <label>Estado: </label>
                <md-radio-group ng-model="data.estado" aria-labelledby="Estado">
                    <md-radio-button ng-value="true" class="md-primary">Activo</md-radio-button>
                    <md-radio-button ng-value="false">Inactivo</md-radio-button>                                                
                </md-radio-group>
            </div>
        </div>
    </div>

    <div class="modal-footer">
        <button type="submit" class="btn btn-success">
            <i class="ti-save"></i> Guardar
        </button>
        <button type="button" ng-click="$ctrl.closeModal()" class="btn btn-dark">
            &times; Cerrar
        </button>
    </div>
</form>