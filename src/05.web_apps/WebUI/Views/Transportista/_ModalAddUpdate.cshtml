<div
 class="modal-header">
    <h5 class="modal-title">{{tipoRegistro==1?'Nuevo':'Editar'}} Transportista</h5>
    <button class="close" ng-click="closeModal()"> &times;</button>
</div>
<div class="modal-body">
    <div class="row">                    
        <div class="col-lg-12">
            <div class="form-group">
                <label for="">Tipo Identificación</label>
                <select class="form-control border-select" ng-model="data.idTipoIdentificacion">
                    <option ng-value="ti.idTipoIdentificacion" ng-repeat="ti in tipoIdentificaciones">{{ti.identificacion}}</option>
                </select>                            
            </div>
        </div>

        <div class="col-lg-12">
            <div class="form-group">
                <label for="">Identificación</label>
                <input type="text" id="identificacion"                                    
                        ng-model="data.nroIdentificacion" 
                        class="form-control border-select" placeholder="1450152325001">
            </div>
        </div>

        <div class="col-lg-12">
            <div class="form-group">
                <label for="nombre">Nombre Completo</label>
                <input type="text" 
                        ng-model="data.nombre" 
                        touppercase 
                        class="form-control border-select"
                        placeholder="Ej: Juan Raúl Martinez Sanchez" >
            </div>
        </div>
    </div>                             
</div>
<div class="modal-footer">
    <button class="btn btn-success" ng-click="saveUpdate()"> <i ng-class="tipoRegistro===1?'ti-save':'ti-pencil'"></i> {{tipoRegistro==1?'Guardar':'Actualizar'}}</button>
    <button class="btn btn-dark" ng-click="closeModal()">&times; Cerrar</button>
</div>
