<form autocomplete="off" ng-submit="$ctrl.onSave()">                                         
    <div class="modal-header bg-info text-white">
        <h5 class="modal-title">Editar Consolidación Inventario</h5>
        <button type="button" class="close" ng-click="$ctrl.closeModal()">&times;</button>      
    </div> 
    <div class="modal-body">
        <div class="row">
            <div class="col-xl-4 col-lg-4 col-md-6 col-sm-12 col-xs-12">
                <div class="form-group">
                    <label for="establecimiento">Estab.: <span class="text-danger">*</span></label>
                    <select name="establecimiento" id="establecimiento" class="form-control border-select" ng-model="$ctrl.data.codEstab" disabled>
                        <option ng-value="item.codEstab" ng-repeat="item in $ctrl.establecimientos">
                            {{item.nombreComercial}}
                        </option>
                    </select>
                </div>            
            </div>
            
            <div class="col-xl-2 col-lg-2 col-md-6 col-sm-12 col-xs-12">                
                <div class="form-group">
                    <label for="puntoEmision">Punto Emisión: <span class="text-danger">*</span></label>
                    <select id="puntoEmision" name="puntoEmision" class="form-control border-select" ng-model="$ctrl.data.idPuntoEmision" disabled>
                        <option ng-value="item.idPuntoEmision" ng-repeat="item in $ctrl.puntosEmision">
                            {{item.ptoEmi}}
                        </option>
                    </select>
                </div> 
            </div> 

            <div class="col-xl-2 col-lg-2 col-md-6 col-sm-12 col-xs-12">   
                <div class="form-group">
                    <label for="fechaEmision">Fecha Emisión <span class="text-danger">*</span></label>
                    <input type="date" name="fechaEmision" ng-disabled="$ctrl.inpuDi" ng-model="$ctrl.data.fechaEmision" class="form-control border-select">
                </div>
            </div>

            <div class="col-xl-4 col-lg-4 col-md-6 col-sm-12 col-xs-12">
                <div class="form-group">
                    <label for="observacion">Observación</label>
                    <input type="text" name="observacion" placeholder="..." ng-model="$ctrl.data.observacion" class="form-control border-select">
                </div>
            </div>                                   
        </div>

        <div class="row justify-content-between">
            <div class="col-lg-5 col-md-5 col-sm-12 col-xs-12">
                <label for="">Buscar Articulo</label>  
                <md-autocomplete-articulo-component 
                    tipo-doc="$ctrl.TIPO_DOC"
                    abrir-modal-articulo="$ctrl.abrirModalArticulo(item)"
                    get-data-articulo="$ctrl.getDataIdArticulo(item)"
                    set-item-articulo-en-detalle="$ctrl.setItemArticuloEnDetalle(item)"
                    scope-parent="$scope">
                </md-autocomplete-articulo-component> 
            </div>
            <div class="col-lg-2 col-md-2 col-sm-12 col-xs-12">
                <div class="form-group">
                    <label for="bodegas">Bodega</label>
                    <select name="bodegas" id="bodegas" class="form-control border-select" ng-model="$ctrl.idBodega" ng-change="$ctrl.askToChangeBodega()">
                        <option ng-value="item.idBodega" ng-repeat="item in $ctrl.bodegas">{{item.descripcion}}</option>
                    </select>
                </div>                               
            </div>   
        </div>


        <div id="grid" ui-grid="$ctrl.gridOptions"
            ui-grid-edit
            ui-grid-resize-columns
            ui-grid-cellNav
            ui-grid-auto-resize
            class="grid">
        </div>                            

        <!--Sub Totales -->
        <div class="row justify-content-between mt-2">
            <div class="col-lg-2"></div>
            <div class="col-lg-2">
                <div class="text-right">
                    <h4><strong>Total: ${{$ctrl.data.total}}</strong></h4>
                </div>                        
            </div>
        </div>
        

    </div>
    <div class="modal-footer">                 
        <button type="submit" class="btn btn-success">
            <i class="ti-pencil"></i> Actualizar
        </button>
        <button type="button" class="btn btn-dark" ng-click="$ctrl.closeModal()">&times; Cerrar</button>
    </div>
       
</form>