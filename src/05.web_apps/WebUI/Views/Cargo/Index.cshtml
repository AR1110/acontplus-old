
@{
    ViewData["Title"] = "Cargo";
}
<div ng-controller="cargoCtrl as $ctrl">
    <div class="row page-titles">
        <div class="col-md-5 align-self-center">
            <h4 class="text-themecolor">Gestión de Cargos</h4>
        </div>
        <div class="col-md-7 align-self-center text-right">
            <div class="d-flex justify-content-end align-items-center">               
               
            </div>
        </div>
    </div>

    <div layout="column" flex="100">
        <md-card>
            <md-card-content>
                <md-toolbar class="md-table-toolbar md-default">
                    <div class="md-toolbar-tools">
                        <div class="col-lg-9 col-md-9 col-sm-1">    
                            <button type="button" ng-click="$ctrl.openModal()" class="btn btn-info d-lg-block m-l-15">
                                <i class="fa fa-plus-circle"></i> Nuevo
                            </button>          
                        </div>
                        <div class="col-lg-3 col-md-3 col-sm-12 col-xs-12">
                            <form class="form-material">
                                <input type="text" class="form-control" ng-model="$ctrl.txtFilter" placeholder="Buscar Cargo" />
                            </form>
                        </div>
                    </div>
                </md-toolbar>
                <md-divider></md-divider>
                <md-table-container>
                    <table md-table>
                        <thead md-head>
                            <tr md-row>                            
                                <th md-column>N°</th>
                                <th md-column ng-if="$ctrl.accion.editar || $ctrl.accion.eliminar"></th>
                                <th md-column>Código</th>
                                <th md-column>Descripción</th>                                
                                <th md-column>Estado</th>                            
                            </tr>
                        </thead>
                        <tbody md-body>
                            <tr md-row ng-repeat="item in $ctrl.cargos | filter: $ctrl.txtFilter">                            
                                <td md-cell>{{$index+1}}</td>
                                <td md-cell ng-if="$ctrl.accion.editar || $ctrl.accion.eliminar">
                                    <div class="justify-content-center">
                                        <a href="javascript:void(0)" ng-if="$ctrl.accion.editar" ng-click="$ctrl.openModal(item)" class="btn btn-info btn-xs"><i class="ti-pencil"></i></a>                                            
                                        <a href="javascript:void(0)" ng-if="$ctrl.accion.eliminar" ng-click="$ctrl.delete(item)" class="btn btn-danger btn-xs" ><i class="ti-trash"></i></a>                                    
                                    </div>
                                </td> 
                                <td md-cell>{{item.codigo}}</td>
                                <td md-cell>{{item.descripcion}}</td>                                
                                <td md-cell ng-bind-html="item.estado | estadoPrimario"></td>    
                                                       
                            </tr>

                        </tbody>                   
                    </table>                
                </md-table-container>
                <md-table-pagination md-limit="query.limit" md-limit-options="recordsQuantity" md-page="query.page" md-total="{{totalRecords}}" md-page-select="options.pageSelect" md-boundary-links="options.boundaryLinks" md-on-paginate="logPagination"></md-table-pagination>
            </md-card-content>
        </md-card>
    </div>

    


   
</div>

@section Scripts{
    <script type="module" src="~/js/controllers/admin/cargoCtrl.js" asp-append-version="true"></script>
}

