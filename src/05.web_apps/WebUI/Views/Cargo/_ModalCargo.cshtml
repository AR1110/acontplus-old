<div class="modal-header">
    <h5 class="modal-title">
        {{$ctrl.tipoRegistro===1?'Nuevo':'Editar'}} Cargo
    </h5>
    <button class="close" ng-click="$ctrl.closeModal()">&times;</button>
</div>

<div class="modal-body">
    <div class="row">
        <div class="co-xl-12 col-md-12 col-sm-12 col-xs-12">
            <div class="form-group">
                <label for="">Descripción <span class="text-danger">*</span></label>
                <input type="text" ng-keyup="$ctrl.obtenerCodigo()" touppercase class="form-control border-select" ng-model="$ctrl.data.descripcion">
            </div>
        </div>
        <div class="co-xl-12 col-md-12 col-sm-12 col-xs-12">
            <div class="form-group">
                <label for="">Código</label>
                <input type="text" class="form-control border-select" touppercase ng-disabled="$ctrl.tipoRegistro===2" ng-model="$ctrl.data.codigo">
            </div>
        </div>

        <div class="co-xl-12 col-md-12 col-sm-12 col-xs-12">

            <div class="form-group" ng-if="$ctrl.tipoRegistro ===2">
                <label for="">Estado</label>
                <md-radio-group ng-model="$ctrl.data.estado" aria-labelledby="Estado Cargo">
                    <md-radio-button ng-value="true" class="md-primary">Activo</md-radio-button>
                    <md-radio-button ng-value="false">Inactivo</md-radio-button>            
                </md-radio-group>
            </div>

        </div>               
    </div>

</div>

<div class="modal-footer">
    <button type="button" class="btn btn-success" ng-click="$ctrl.saveAndUpdate()">
        {{$ctrl.tipoRegistro===1?'Guardar':'Actualizar'}}
    </button>
    <button type="button" class="btn btn-dark" ng-click="$ctrl.closeModal()">&times; Cerrar</button>
</div>