

<form autocomplete="off" ng-submit="$ctrl.save()">
    <div class="modal-header">
        <h5 class="h5"><icon class="ti-pencil"></icon> Editar Impuesto Renta</h5>
        <button type="button" class="close" ng-click="$ctrl.closeModal()">&times;</button>
    </div>

    <div class="modal-body">

        <div class="row">
            <div class="col-xl-12 col-md-12 col-sm-12 col-xs-12">
                <div class="form-group">
                    <label for="codigo">Código: <span class="text-danger">*</span></label>
                    <input type="text" class="form-control border-select" ng-model="$ctrl.data.codigo" placeholder="3440">
                </div>
            </div>

            <div class="col-xl-12 col-md-12 col-sm-12 col-xs-12">
                <div class="form-group">
                    <label for="descripcion">Descripción: <span class="text-danger">*</span></label>
                    <input type="text" class="form-control border-select" touppercase ng-model="$ctrl.data.concepto" placeholder="...">
                    <span ng-if="$ctrl.data.concepto.length>50" class="text-info">{{$ctrl.data.concepto}}</span>
                </div>
            </div>

            <div class="col-xl-12 col-md-12 col-sm-12 col-xs-12">
                <div class="form-group">
                    <label for="porcentaje">Porcentaje: <span class="text-danger">*</span></label>
                    <input type="text" class="form-control border-select" decimal ng-model="$ctrl.data.porcentajeMin" placeholder="0%">
                </div>
            </div>

            <div class="col-xl-12 col-md-12 col-sm-12 col-xs-12">
                <md-radio-group ng-model="$ctrl.data.estado" aria-labelledby="estado">
                    <md-radio-button ng-value="1" class="md-primary">Activo</md-radio-button>
                    <md-radio-button ng-value="0">Inactivo</md-radio-button>
                </md-radio-group>
            </div>

            
        </div>

    </div>

    <div class="modal-footer">
        <button type="submit" class="btn btn-success" autofocus>
            <icon class="icon-pencil "></icon> Editar
        </button>

        <button type="button" class="btn btn-dark"  ng-click="$ctrl.closeModal()">
            &times; Cerrar
        </button>
    </div>
</form>