
@{
    ViewData["Title"] = "Index";
}



<div ng-controller="impuestoCtrl">
    
    <div ng-if="showImpuestoRentaV1">
        <div class="row page-titles">
            <div class="col-md-5 align-self-center">
                <h4 class="text-themecolor">Gestión de Impuestos</h4>
            </div>
            <div class="col-md-7 align-self-center text-right">
                <div class="d-flex justify-content-end align-items-center">
                    @*<ol class="breadcrumb">
                            <li class="breadcrumb-item"><a href="javascript:void(0)">Inicio</a></li>
                            <li class="breadcrumb-item active">Impuesto</li>
                        </ol>*@
                    <button type="button" ng-if="accion.crear" ng-click="abrirModal(0,1)" class="btn btn-info  m-l-15">
                        <i class="ti-plus"></i> Nuevo
                    </button>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-lg-12">
                <div class="card">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-lg-9">
                                <span class="form-group pull-left page-size form-inline">
                                    <select class="form-control control-color"
                                            ng-model="pageSize"
                                            ng-change="changePageSize()"
                                            ng-options="ra for ra in recordsQuantity">
                                    </select>
                                </span>
                            </div>
                            <div class="col-lg-3">
                                <form class="form-material">
                                    <input type="text" class="form-control" ng-model="buscar" placeholder="Buscar Imp." />
                                </form>
                            </div>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-no-bordered" width="100%">
                                <thead>
                                    <tr>
                                        <th ng-if="accion.editar || accion.eliminar"></th>
                                        <th>N°</th>
                                        <th>Codigo</th>
                                        <th>Impuesto</th>
                                        <th>%</th>
                                        <th>Campo form.</th>
                                        <th>T. Impuesto</th>
                                        <th>Est.</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr ng-repeat="i in impuestos |filter:buscar">
                                        <td width="100" ng-if="accion.editar || accion.eliminar">
                                            <div class="justify-content-center">
                                                <a href="javascript:void(0)" ng-if="accion.eliminar" ng-click="delete(i.retencionRenta)" tooltip class="text-rojo" data-toggle="tooltip" title="Eliminar"><i class="fa fa-trash"></i></a>
                                                <a href="javascript:void(0)" ng-if="accion.editar" ng-click="abrirModal(i,2)" tooltip class="text-azul m-l-10" title="Actualizar" data-toggle="tooltip"><i class=" fas fa-edit"></i></a>
                                            </div>
                                        </td>
                                        <td>{{$index+1}}</td>
                                        <td>{{i.retencionRenta.codigoAnexo}}</td>
                                        <td>{{i.retencionRenta.descripcion}}</td>
                                        <td>{{i.retencionRenta.porcentaje | currency: '%'}}</td>
                                        <td>{{i.retencionRenta.campoFormulario103}}</td>
                                        <td>{{i.tipoImpuestoRenta}}</td>
                                        <td ng-bind-html="i.retencionRenta.estado|estadoPrimario"></td>
                                    </tr>
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <td align="center" colspan="8">
                                            <div class="pull-left">
                                                <ul uib-pagination total-items="totalRecords" items-Per-Page="pageSize" ng-change="pagechanged()" ng-model="pageIndex" max-size="maxSize" class="pagination" boundary-links="true" rotate="false"></ul>
                                            </div>
                                        </td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="modal fade" id="agregarImpuesto" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel1" aria-hidden="true" data-backdrop="static" data-keyboard="true">
            <div class="modal-dialog" role="document">

                <div class="modal-content">
                    <div class="modal-header {{colorHeader}}">
                        <h5 class="modal-title text-white" id="exampleModalLabel"><i class="{{iconoModal}}"></i>{{tituloModal}}</h5>
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                    <div class="modal-body">
                        <div class="row">
                            <div class="form-group col-lg-12 col-md-12 col-sm-12 col-xs-12">

                                <label for="">Tipo Impuesto: <span class="text-danger">*</span> </label>

                                <select class="form-control" ng-model="data.idTipoImpuestoRenta">
                                    <option ng-value="item.idTipoImpuestoRenta" ng-repeat="item in tipoImpuestos">
                                        {{item.descripcion}}
                                    </option>
                                </select>
                            </div>
                            <div class="form-group col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                <label for="">Codigo Anexo: </label>
                                <input type="text" ng-model="data.codigoAnexo" class="form-control" maxlength="50" placeholder="Código Anexo">
                            </div>
                            <div class="form-group col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                <label for="">Descripción: <span class="text-danger">*</span></label>
                                <div class="controls">
                                    <input type="text" ng-model="data.descripcion" class="form-control" placeholder="Ej: Impuesto a la Renta " />
                                </div>
                            </div>
                            <div class="form-group col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                <label>Porcentaje <span class="text-danger">*</span></label>
                                <input type="text" ng-model="data.porcentaje" class="form-control" valid-number step="any" placeholder="Ej: 11">
                            </div>
                            <div class="form-group col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                <label>Campo formulario 103 <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <input type="text" ng-model="data.campoFormulario103" class="form-control" placeholder="Ej: 404,415">
                                </div>
                            </div>
                            <div class="form-group col-lg-6 col-md-6 col-sm-6 col-xs-6" ng-if="tipo==2">
                                <label for="">Estado: </label>
                                <md-radio-group ng-model="data.estado">
                                    <md-radio-button ng-value="true">Activo</md-radio-button>
                                    <md-radio-button ng-value="false">Inactivo</md-radio-button>
                                </md-radio-group>
                            </div>
                        </div>

                    </div>
                    <div class="modal-footer">
                        <button type="button" ng-click="saveUpdate(tipo)" class="btn {{btnColor}}"><i class="{{icono}}"></i> {{btnTitulo}}</button>
                        <button type="button" class="btn btn-dark" data-dismiss="modal">&times; Cerrar</button>
                    </div>
                </div>

            </div>
        </div>
    </div>
   
</div>



<div ng-controller="impuestoRentaCtrl">
    <div ng-if="showImpuestoRentaV2">
        <div class="row page-titles">
            <div class="col-md-5 align-self-center">
                <h4 class="text-themecolor">Código Retención</h4>
            </div>
            <div class="col-md-7 align-self-center text-right">
                <div class="d-flex justify-content-end align-items-center">
                    @*<ol class="breadcrumb">
                            <li class="breadcrumb-item"><a href="javascript:void(0)">Inicio</a></li>
                            <li class="breadcrumb-item active">Impuesto</li>
                        </ol>*@
                    <button type="button" ng-if="accion.crear" ng-click="openModalNew()" class="btn btn-info  m-l-15">
                        <i class="ti-plus"></i> Nuevo
                    </button>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-lg-12">
                <div class="card">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-lg-9">
                                <span class="form-group pull-left page-size form-inline">
                                    <select class="form-control control-color"
                                            ng-model="dataSearch.pageSize"
                                            ng-change="changePageSize()"
                                            ng-options="ra for ra in recordsQuantity">
                                    </select>
                                </span>
                            </div>
                            <div class="col-lg-3">
                                <form class="form-material">
                                    <input type="text" class="form-control" ng-model="buscar" placeholder="Buscar Imp." />
                                </form>
                            </div>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-no-bordered" width="100%">
                                <thead>
                                    <tr>
                                        <th ng-if="accion.editar || accion.eliminar"></th>
                                        <th>N°</th>
                                        <th>Codigo</th>
                                        <th>Descripción</th>
                                        <th>%</th>                                      
                                        <th>Est.</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr ng-repeat="item in impuestosRenta |filter:buscar">
                                        <td width="100" ng-if="accion.editar || accion.eliminar">
                                            <div class="justify-content-center">
                                                <a href="javascript:void(0)" ng-if="accion.eliminar" ng-click="delete(i.retencionRenta)" tooltip class="text-rojo" data-toggle="tooltip" title="Eliminar"><i class="fa fa-trash"></i></a>
                                                <a href="javascript:void(0)" ng-if="accion.editar" ng-click="abrirModal(i,2)" tooltip class="text-azul m-l-10" title="Actualizar" data-toggle="tooltip"><i class=" fas fa-edit"></i></a>
                                            </div>
                                        </td>
                                        <td>{{$index+1}}</td>
                                        <td>{{item.codigo}}</td>
                                        <td>{{item.concepto}}</td>
                                        <td>{{item.porcentajeMin | currency: '%'}}</td>                                    
                                        <td ng-bind-html="item.estado|estadoPrimario"></td>
                                    </tr>
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <td align="center" colspan="8">
                                            <div class="pull-left">
                                                <ul uib-pagination total-items="totalRecords" items-Per-Page="dataSearch.pageSize" ng-change="pagechanged()" ng-model="dataSearch.pageIndex" max-size="maxSize" class="pagination" boundary-links="true" rotate="false"></ul>
                                            </div>
                                        </td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>       
    </div>
   
</div>
@section Scripts{
    <script src="~/js/controllers/sri/impuestoCtrl.js" asp-append-version="true"></script>
     <script src="~/js/controllers/sri/impuestoRentaCtrl.js" asp-append-version="true"></script>
}


