<form ng-submit="$ctrl.onSave()" autocomplete="off"> 
    <div class="modal-header">
        <div class="float-left">
            <div class="icheck-primary">
                <input type="checkbox" ng-model="$ctrl.showHeaderInvoice"  id="checkHeaderInvoice" />
                <label for="checkHeaderInvoice">Datos del cliente</label>
            </div>
        </div>
        <div class="float-center">
            <h5><span>Editar Factura Nro: <b>{{$ctrl.nroDocSecuencial}}</b> </span></h5>
        </div>
        <div class="float-right">
            <h4><span class="float-right"><strong>Total: ${{$ctrl.getImporteTotal()}} </strong></span></h4>            
        </div>
    </div>

    <div class="modal-body">
        <div class="row" ng-if="$ctrl.showHeaderInvoice">
            <div class="col-xl-2 col-lg-2 col-md-6 col-sm-12 col-xs-12">
                <div class="form-group">
                    <label for="establecimiento">Estab.: <span class="text-danger">*</span></label>
                    <select name="establecimiento" id="establecimiento" class="form-control border-select" disabled ng-model="$ctrl.data.codEstab">
                        <option ng-value="item.codEstab" ng-repeat="item in $ctrl.establecimientos">
                            {{item.nombreComercial}}
                        </option>
                    </select>
                </div>
            </div>

            <div class="col-xl-3 col-lg-3 col-md-6 col-sm-6 col-xs-12">
                <div class="form-group">
                    <label for="">Cliente: <span class="text-danger">*</span></label>
                    <div class="input-group">
                        @await Html.PartialAsync("~/Views/Cliente/_UibModalSearchInvoice.cshtml")
                        <div class="input-group-append">
                            <button type="button" class="btn btn-outline-secondary btn-sm" ng-click="$ctrl.openModalClienteNew()"      tabindex="-1"> <i class="fa fa-plus fa-xs"></i>
                            </button>

                            <button type="button" class="btn btn-outline-secondary btn-sm" ng-if="$ctrl.cliente.idCliente>0" ng-click="$ctrl.openModalClienteUpdate()" tabindex="-1"><i class="fa fa-edit fa-xs"></i>
                            </button>
                            <button type="button" class="btn btn-outline-secondary btn-sm" 
                                    ng-click="$ctrl.openModalClienteLista()"                                   
                                    tabindex="-1"><i class="fa fa-search fa-xs"></i>
                            </button>                           
                        </div>
                    </div>                    
                    <span class="ml-5" ng-if="cliente.loading"> <i class="fas fa-sync-alt fa-xs"></i> Loading...</span>
                    <small class="text-danger ml-5" ng-if="cliente.noResults">No se encontraron resultados</small>
                </div>
            </div>

            <div class="col-xl-2 col-lg-2 col-md-6 col-sm-6 col-xs-12">
                <div class="form-group">
                    <label for="nroIndentificacion" class="">Nro. Identificación:</label>
                    <input type="text" name="nroIndentificacion" id="nroIndentificacion" class="form-control" readonly ng-value="$ctrl.cliente.numeroIdentificacion" placeholder="..." />
                </div>
            </div>

            <div class="col-xl-2 col-lg-2 col-md-6 col-sm-6 col-xs-12">
                <div class="form-group">
                    <label for="address" class="">Dirección:</label>
                    <input type="text" name="address" id="address" class="form-control" readonly ng-model="$ctrl.cliente.direccion" />
                </div>
            </div>

            <div class="col-xl-3 col-lg-3 col-md-6 col-sm-6 col-xs-12">
                <div class="form-group">
                    <label for="email" class="">Correo:</label>
                    <input type="text" name="email" id="email" class="form-control" readonly ng-model="$ctrl.cliente.correo">                     
                </div>
            </div>
        </div>   

        <div class="row" ng-if="$ctrl.showHeaderInvoice">
            <div class="col-xl-2 col-lg-2 col-md-6 col-sm-6 col-xs-12">
                <div class="form-group">
                    <label for="puntoEmision">Punto Emisión: <span class="text-danger">*</span></label>
                    <input type="text" ng-value="$ctrl.dataDocumento.ptoEmi" class="form-control" disabled>
                    @* <select name="puntoEmision" id="puntoEmision" class="form-control border-select" ng-model="$ctrl.data.idPuntoEmision">
                        <option ng-value="item.idPuntoEmision" ng-repeat="item in $ctrl.puntosEmisiones">{{item.ptoEmi}}</option>
                    </select>  *@
                </div>
            </div>

            <div class="col-xl-3 col-xl-3 col-lg-3 col-md-6 col-sm-6 col-xs-12">
                <div class="form-group">
                    <label for="tiempoCredito">Tiempo Crédito: <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <select name="tiempoCredito" id="tiempoCedito" disabled class="form-control border-select" ng-model="$ctrl.data.idTiempoCredito">
                            <option ng-value="item.idTiempoCredito" ng-repeat="item in $ctrl.tiempoCreditos">{{item.descripcion}}</option>
                        </select>
                        <div class="input-group-append">
                            <button type="button" class="btn btn-secondary btn-xs" disabled>
                                <i class="mdi mdi-cached"></i>
                            </button>                            
                        </div>
                    </div>                                      
                </div>
            </div>

             <div class="col-xl-2 col-lg-2 col-md-6 col-sm-6 col-xs-12">
                <div class="form-group">
                    <label for="fechaEmision">Fecha Emisión: <span class="text-danger">*</span></label>
                    <input type="date" name="fechaEmision" id="fechaEmision" class="form-control border-select" ng-model="$ctrl.data.fechaEmision" ng-change="$ctrl.getFechaVencimiento()" ng-keyup="$ctrl.getFechaVencimiento()" />
                    <small class="text-info">{{$ctrl.fechaEmisionEscrita}}</small>
                </div>
            </div>

            <div class="col-xl-2 col-lg-2 col-md-6 col-sm-6 col-xs-12">
                <div class="form-group">
                    <label for="fechaVencimiento">Fecha Vencimiento:</label>
                    <input type="date" name="fechaVencimiento" id="fechaVencimiento" class="form-control" disabled ng-model="$ctrl.data.fechaVencimiento" />
                    <small class="text-info">{{$ctrl.fechaVencimientoEscrita}}</small>
                </div>
            </div>

            <div class="col-xl-3 col-lg-3 col-md-6 col-sm-12 col-xs-12">
                <div class="form-group">
                    <label for="empleado">Empleado</label>
                    <input type="text" name="empleado" id="empleado" class="form-control " ng-value="$ctrl.cliente.empleado"  disabled />
                </div>
            </div>
        </div>   


        <div class="row">
            <div class="col-xl-6 col-lg-6 col-md-6 col-sm-12 col-xs-12">
                <div class="row justify-content-between">
                    <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-xs-12">
                        <label for="">Buscar Articulo</label>             
                        <md-autocomplete-articulo-component 
                            tipo-doc="$ctrl.TIPO_DOC_FV"
                            abrir-modal-articulo="$ctrl.abrirModalArticulo(item)"
                            get-data-articulo="$ctrl.getDataIdArticulo(item)"
                            set-item-articulo-en-detalle="$ctrl.setItemArticuloEnDetalle(item)"
                            scope-parent="scopeParent">
                        </md-autocomplete-articulo-component>            
                    </div>
                </div>
            </div>
            <div class="col-xl-6 col-lg-6 col-md-6 col-sm-12 col-xs-12">
                <div class="row justify-content-end">
                    <div class="col-xl-4 col-lg-4 col-md-6 col-sm-12 col-xs-12">
                        <div class="form-group">
                            <label for="bodegas">Bodega</label>
                            <select name="bodegas" id="bodegas" class="form-control border-select" ng-model="$ctrl.idBodega" ng-change="$ctrl.onChangeBodega()">
                                <option ng-value="item.idBodega" ng-repeat="item in $ctrl.bodegas">
                                    {{item.descripcion}}
                                </option>
                            </select>
                        </div>                       
                    </div>
                    <div class="col-xl-4 col-lg-4 col-md-6 col-sm-12 col-xs-12">
                        <div class="form-group">
                            <label for="tarifas">Tarifa: 
                                <span tooltip-placement="top" uib-tooltip="Asignación Rápida de listas de precios seleccionada a todos los productos del documento.">
                                    <i class="fas fa-info-circle fa-xs"></i>
                                </span>                                                                
                            </label>
                            <select id="tarifas" class="form-control border-select" ng-model="$ctrl.idTarifa" ng-change="$ctrl.askToChangeTariga()">
                                <option ng-value="item.idTarifa" ng-repeat="item in $ctrl.tarifas">
                                    {{item.descripcion}}
                                </option>
                            </select>
                        </div>
                    </div> 
                </div>
            </div>          
        </div> 

        <div ui-grid="$ctrl.gridOptions"
            ui-grid-edit
            ui-grid-resize-columns
            ui-grid-cellNav
            ui-grid-auto-resize
            ui-grid-validate
            ui-grid-save-state
            class="grid">
        </div>  

        <div class="row">
            <div class="col-xl-9 col-lg-9 col-md-6 col-sm-12 col-xs-12">
                <div class="row mt-2" ng-if="$ctrl.showSubtotales">
                    <div class="col-xl-4 col-lg-4 col-md-6 col-sm-12 col-xs-12">
                        <div class="table-responsive">
                            <table class="table table-clear table-sm">
                                <tbody>
                                    <tr>
                                        <td class="left">
                                            <strong class="text-dark">SubTotal Iva {{$ctrl.actividadTipoIva.tarifa}}%</strong>
                                        </td>
                                        <td class="right">${{$ctrl.data.subTotalIva}}</td>
                                    </tr>

                                    <tr>
                                        <td class="left">
                                            <strong class="text-dark">SubTotal IVA 0</strong>
                                        </td>
                                        <td class="right">${{$ctrl.data.subTotalIvaCero}}</td>
                                    </tr>

                                    <tr>
                                        <td class="left">
                                            <strong class="text-dark">SubTotal Exento IVA</strong>
                                        </td>
                                        <td class="right">${{$ctrl.data.subTotalExentoIva}}</td>
                                    </tr>

                                    <tr>
                                        <td class="left">
                                            <strong class="text-dark">SubTotal no Objeto IVA</strong>
                                        </td>
                                        <td class="right">${{$ctrl.data.subTotalNoObjetoIva}}</td>
                                    </tr>                                                       
                                </tbody>
                            </table>  
                        </div>             
                    </div>

                    <div class="col-xl-4 col-lg-4 col-md-6 col-sm-12 col-xs-12">
                        <div class="table-responsive">
                            <table class="table table-clear table-sm">
                                <tbody>
                                    <tr>
                                        <td class="left">
                                            <strong class="text-dark">SubTotal Neto IVA</strong>
                                        </td>
                                        <td class="right">${{$ctrl.data.subTotalNetoIva}}</td>
                                    </tr>

                                    <tr>
                                        <td class="left">
                                            <strong class="text-dark">SubTotal Neto IVA 0</strong>
                                        </td>
                                        <td class="right">${{$ctrl.data.subTotalNetoIvaCero}}</td>
                                    </tr>

                                    <tr>
                                        <td class="left">
                                            <strong class="text-dark">SubTotal Neto Exento IVA</strong>
                                        </td>
                                        <td class="right">${{$ctrl.data.subTotalNetoExentoIva}}</td>
                                    </tr>

                                    <tr>
                                        <td class="left">
                                            <strong class="text-dark">SubTotal Neto no Objeto IVA</strong>
                                        </td>
                                        <td class="right">${{$ctrl.data.subTotalNetoNoObjetoIva}}</td>
                                    </tr>                                                       
                                </tbody>
                            </table>  
                        </div> 
                    </div>

                    <div class="col-xl-4 col-lg-4 col-md-6 col-sm-12 col-xs-12">
                        <div class="table-responsive">
                            <table class="table table-clear table-sm">
                                <tbody>
                                    <tr>
                                        <td class="left">
                                            <strong class="text-dark">ICE</strong>
                                        </td>
                                        <td class="right">${{$ctrl.data.totalIce}}</td>
                                    </tr>

                                    <tr>
                                        <td class="left">
                                            <strong class="text-dark">IRBPNR</strong>
                                        </td>
                                        <td class="right">${{$ctrl.data.irbpnr}}</td>
                                    </tr>

                                    <tr>
                                        <td class="left">
                                            <strong class="text-dark">Propina</strong>
                                        </td>
                                        <td class="right">${{$ctrl.data.propina}}</td>
                                    </tr>                                                                               
                                </tbody>
                            </table>  
                        </div> 
                    </div>                      
                </div>
                <md-divider></md-divider>
                <div class="row mt-2" ng-if="$ctrl.showSubtotales">
                    <div class="col-lg-2 col-md-6 col-sm-12 col-xs-12">
                        <div class="form-group">
                            <label>% Descuento</label>
                            <div class="input-group">
                                <input type="text" ng-model="$ctrl.data.porcentajeDescuento" ng-disabled="$ctrl.gridOptions.data.length==0" 
                                valid-number class="form-control" />
                                <div class="input-group-append">
                                    <button type="button" class="btn btn-secondary btn-sm" ng-click="$ctrl.calcularPorcentajeDescuento()">
                                        <i class="fa fa-calculator fa-xs"></i>
                                    </button>                                            
                                </div>
                            </div>                    
                        </div>
                    </div>

                    <div class="col-lg-2 col-md-6 col-sm-12 col-xs-12">
                        <div class="form-group">
                            <label>Descuento</label>
                            <div class="input-group">
                                <input ng-model="$ctrl.data.totalDescuento" id="totalDescuento" ng-disabled="$ctrl.gridOptions.data.length==0" valid-number placeholder="0.00" class="form-control" />
                                <div class="input-group-append">
                                    <button type="button" class="btn btn-secondary btn-sm" ng-click="$ctrl.calcularDescuento()">
                                        <i class="fa fa-calculator fa-xs"></i>
                                    </button>
                                </div>
                            </div>                                    
                        </div>
                    </div>

                    <div class="col-lg-2 col-md-6 col-sm-12 col-xs-12">
                        <div class="form-group">
                            <label>Transporte</label>
                            <input type="text" decimal ng-model="$ctrl.data.transporte" class="form-control border-select" placeholder="0.00" />
                        </div>
                    </div>

                    <div class="col-lg-2 col-md-6 col-sm-12 col-xs-12">
                        <div class="form-group">
                            <label>Rercargo</label>
                            <input type="text" decimal ng-model="$ctrl.data.recargo" class="form-control border-select" placeholder="0.00" />
                        </div>
                    </div>

                    <div class="col-lg-4">
                        <div class="form-group">
                            <label>Observacion</label>
                            <textarea class="form-control border-select" ng-model="$ctrl.data.observacion" touppercase placeholder="..."></textarea>
                        </div>
                    </div>
                </div> 
            </div>

            <div class="col-xl-3 col-lg-3 col-md-6 col-sm-12 col-xs-12">             
                <div class="table-responsive mt-2">
                    <table class="table table-clear table-sm">
                        <tbody>
                            <tr>
                                <td class="left">
                                <strong class="text-dark">SubTotal sin Impuesto</strong>
                                </td>
                                <td class="right">${{$ctrl.data.subTotalSinImpuestos}}</td>
                            </tr>

                            <tr>
                                <td class="left">
                                    <strong class="text-dark">IVA {{$ctrl.actividadTipoIva.tarifa}}%</strong>
                                </td>
                                <td class="right">${{$ctrl.data.iva}}</td>
                            </tr>

                            <tr>
                                <td class="left">
                                <strong class="text-dark">Total Descuento</strong>
                                </td>
                                <td class="right">${{$ctrl.data.totalDescuento}}</td>
                            </tr>
                            
                            <tr>
                                <td class="left">
                                    <h4> <strong class="text-dark">Total</strong></h4>                                       
                                </td>
                                <td class="right">
                                    <h4><strong class="text-dark">${{$ctrl.getImporteTotal()}}</strong></h4>
                                </td>
                            </tr>
                        </tbody>
                    </table>  
                </div> 
                <div class="mt-2">
                    <button type="button" class="btn btn-secondary btn-sm btn-lg btn-block" ng-click="$ctrl.openModalInfoAdicional(false)">
                        <i class="fas fa-info-circle text-info"></i> Dato Adicional
                    </button>
                </div>                        
            </div>
        </div>
              
       

                                                                                    
    </div>

    <div class="modal-footer">
        <div class="icheck-success icheck-inline">
            <input type="checkbox" ng-model="$ctrl.showSubtotales" id="showSubTotales" />
            <label for="showSubTotales">Mas datos</label>
        </div>
        <button type="submit" class="btn btn-success">
            <i class="ti-pencil"></i> Actualizar
        </button>
        <button type="button" class="btn btn-dark" ng-click="$ctrl.closeModal()">
            &times; Cerrar
        </button>
    </div>
</form>