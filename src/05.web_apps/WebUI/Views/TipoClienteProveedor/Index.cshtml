
@{
    ViewData["Title"] = "Index";
}
<div ng-controller="tipoClienteProveedorCtrl">
    <div>
        <div class="row page-titles">
            <div class="col-md-5 align-self-center">
                <h4 class="text-themecolor">Gestión de Tipo Cliente/Proveedor</h4>
            </div>
            <div class="col-md-7 align-self-center text-right">
                <div class="d-flex justify-content-end align-items-center">
                    @*<ol class="breadcrumb">
                            <li class="breadcrumb-item"><a href="javascript:void(0)">Inicio</a></li>
                            <li class="breadcrumb-item active">Tipo Cliente/Proveedor</li>
                        </ol>*@
                    <button type="button" ng-if="accion.crear" ng-click="abrirModal(0,1)" class="btn btn-info d-none d-lg-block m-l-15">
                        <i class="ti-plus"></i> Nuevo
                    </button>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-lg-12">
                <div class="card">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-lg-9">
                                <span class="form-group pull-left page-size form-inline">
                                    <select class="form-control control-color"
                                            ng-model="pageSize"
                                            ng-change="changePageSize()"
                                            ng-options="ra for ra in recordsQuantity">
                                    </select>
                                </span>
                            </div>
                            <div class="col-lg-3">
                                <form class="form-material">
                                    <input type="text" class="form-control" ng-model="buscar" placeholder="Buscar Tipo Cliente/Proveedor" />
                                </form>                    
                            </div>
                        </div>
                        <div class="table-responsive ">
                            <table class="table table-no-bordered text-center">
                                <thead>
                                    <tr>                            
                                        <th ng-if="accion.editar || accion.eliminar">Op.</th>
                                        <th>N°</th>
                                        <th>Código</th>
                                        <th>Descripción</th>
                                        <th>Tipo</th>
                                        <th>Estado</th>                            
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr ng-repeat="tp in tipos | filter:buscar">                            
                                        <td ng-if="accion.editar || accion.eliminar">
                                            <div class="justify-content-center">
                                                <a href="javascript:void(0)" ng-if="accion.editar" ng-click="abrirModal(tp,2)" class="btn btn-info btn-xs" title="Actualizar" data-toggle="tooltip"><i class="ti-pencil"></i></a>                                            
                                                <a href="javascript:void(0)" ng-if="accion.eliminar" ng-click="delete(tp.idTipoClienteProveedor)" class="btn btn-danger btn-xs" data-toggle="tooltip" title="Eliminar"><i class="ti-trash"></i></a>                                    
                                            </div>
                                        </td>                           
                                        <td>{{$index+1}}</td>
                                        <td>{{tp.codigo}}</td>
                                        <td>{{tp.descripcion}}</td>
                                        <td>{{tp.tipoPersona.descripcion}}</td>
                                        <td ng-bind-html="tp.estado | estadoPrimario"></td> 
                                    </tr>
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <td align="center" colspan="6">
                                            <div class="pull-left">
                                                <ul uib-pagination total-items="totalRecords" items-Per-Page="pageSize" ng-change="pagechanged()" ng-model="pageIndex" max-size="maxSize" class="pagination" boundary-links="true" rotate="false"></ul>
                                            </div>
                                        </td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        

        <div class="modal fade" id="agregar" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel1" data-backdrop="static" data-keyboard="false">
            <div class="modal-dialog" role="document">
                <div class="modal-content">
                    <form ng-submit="saveUpdate(tipo)" class="form-material" autocomplete="off" novalidate>
                        <div class="modal-content">
                            <div class="modal-header {{colorHeader}}">
                                <h5 class="modal-title text-white" id="exampleModalLabel"><i class="{{iconoModal}}"></i>{{tituloModal}}</h5>
                                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                    <span aria-hidden="true">&times;</span>
                                </button>
                            </div>
                            <div class="modal-body">

                                <div class="row">
                                    <div class="form-group col-lg-12 col-md-12 col-sm-12 col-12">
                                        <label for="telefono">Descripción: <span class="text-danger">*</span></label>
                                        <input type="text" ng-model="data.descripcion" class="form-control" ng-keyup="obtenerTresLetras(data)" placeholder="Ej: Local">
                                    </div>
                                    <div class="form-group col-lg-12 col-md-12 col-sm-12 col-12">
                                        <label for="codigo">Código: <span class="text-danger">*</span></label>
                                        <input type="text" ng-model="data.codigo" touppercase ng-disabled="data.descripcion==undefined || tipo==2" class="form-control" placeholder="Ej: LO">
                                    </div>
                                    <div class="form-group col-lg-12 col-md-12 col-sm-12 col-12">
                                        <label>Tipo: <span class="text-danger">*</span></label>
                                        <select class="form-control" ng-model="tipoPersona" ng-options="tp as tp.descripcion for tp in tipoPersonas track by tp.idTipoPersona">
                                        </select>
                                    </div>
                                    <div class="form-group col-lg-12 col-md-12 col-sm-12 col-12"ng-show="tipo==2">
                                        <label for="">Estado: </label>
                                        <md-radio-group ng-model="data.estado">
                                            <md-radio-button ng-value="true">Activo</md-radio-button>
                                            <md-radio-button ng-value="false">Inactivo</md-radio-button>
                                        </md-radio-group>
                                    </div>
                                </div>                            
                            </div>
                            <div class="modal-footer">
                                <button type="submit" class="btn {{colorHeader}} text-white"><i class="{{icono}}"></i> {{btnModal}}</button>
                                <button type="button" class="btn btn-dark" data-dismiss="modal">&times; Cerrar</button>
                            </div>
                        </div>
                    </form>

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts{

    <script src="~/js/controllers/admin/tipoClienteProveedorCtrl.js" asp-append-version="true"></script>
}

