<div id="modalFiltroAvanzado" class="modal fade in" role="dialog" tabindex="-1">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Busqueda Avanzada</h5>
                <button class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <div class="row justify-content-between">
                    <div class="col-xl-3 col-lg-3 col-md-3 col-sm-4 col-12">
                        <div class="icheck-info">
                            <input type="checkbox" ng-model="dataSearch.checkBoxFecha" ng-change="onChangeFechaFilter()" id="checkBoxFechaFilter">
                            <label for="checkBoxFechaFilter">Fecha</label>
                        </div>
                    </div>                   
                    <div class="col-xl-3 col-lg-3 col-md-3 col-sm-4 col-12">
                        <div class="icheck-info">
                            <input type="checkbox" ng-model="dataSearch.checkBoxProveedor" id="checkBoxProveedorFilter">
                            <label for="checkBoxProveedorFilter">Proveedor</label>
                        </div>
                    </div>
                    <div class="col-xl-3 col-lg-3 col-md-3 col-sm-4 col-12">
                        <div class="icheck-info">
                            <input type="checkbox" ng-model="dataSearch.checkBoxUsuario" id="checkBoxUsuarioFilter">
                            <label for="checkBoxUsuarioFilter">Usuario</label>
                        </div>
                    </div>
                    <div class="col-xl-3 col-lg-3 col-md-3 col-sm-4 col-12">
                        <div class="icheck-info">
                            <input type="checkbox" ng-model="dataSearch.checkBoxEstado" id="checkBoxEstadoFilter">
                            <label for="checkBoxEstadoFilter">Estado</label>
                        </div>
                    </div>                    
                </div>                
                <hr>

                <div class="row">
                    <div class="col-xl-6 col-lg-6 col-md- col-sm-12 col-12"> 
                        <div class="form-group">
                            <label>Estab.:</label>                               
                            <select class="form-control border-select" ng-model="dataSearch.codEstab">
                                <option ng-value="item.codEstab" ng-repeat="item in establecimientos">{{item.nombreComercial}}</option>
                            </select>
                        </div>
                    </div>
                </div>

                <div class="row" ng-if="dataSearch.checkBoxFecha">                        
                    <div class="col-xl-3 col-lg-3 col-md-3 col-sm-3 col-xs-3">
                        <div class="form-group">
                            <label class="control-label">Mes: </label>
                            <select ng-model="dataSearch.mes" class="form-control" ng-change="getFechaInicioFinFilter()">
                                <option ng-value="m.numero" ng-repeat="m in meses">{{m.nombre}}</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-xl-3 col-lg-3 col-md-3 col-sm-3 col-xs-3">
                        <div class="form-group">
                            <label>Fecha Inicio:</label>
                            <input type="date" class="form-control" name="fechaInicio" ng-model="dataSearch.fechaInicio"
                                    value="" required />
                        </div>
                    </div>
                    <div class="col-xl-3 col-lg-3 col-md-3 col-sm-3 col-xs-3">
                        <div class="form-group">
                            <label>Fecha Fin:</label>
                            <input type="date" class="form-control" name="facheFin" ng-model="dataSearch.fechaFin" value="" required />
                        </div>
                    </div>

                    <div class="col-xl-3 col-lg-3 col-md-3 col-sm-3 col-xs-3">
                        <div class="form-group">
                            <label for="">Tipo Fecha</label>
                            <div class="icheck-info">
                                <input type="radio" ng-model="dataSearch.tipoFecha" value="FE" id="tipoFechaEmision" name="tipoFecha">
                                <label for="tipoFechaEmision"> Fecha Emisión</label>
                            </div>
                            <div class="icheck-info">
                                <input type="radio" ng-model="dataSearch.tipoFecha" value="FV" id="tipoFechaVencimiento" name="tipoFecha">
                                <label for="tipoFechaVencimiento"> Fecha Vencimiento</label>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-xl-6 col-lg-6 col-md-6 col-sm-6 col-12" ng-if="dataSearch.checkBoxProveedor">
                        <div class="form-group">
                                <label class="control-label">Proveedor:</label>
                                <input  type="text"                                                                           
                                        autocomplete="off"
                                        name="proveedorAutocompleteFilter"
                                        class="form-control border-select"
                                        placeholder="Ingrese C.I o Nombre Fiscal"
                                        typeahead-wait-ms="5"
                                        ng-model="dataSearch.selectedProveedor"
                                        ng-keyup="onKeyupSearchProveedor(selectedProveedor)"
                                        uib-typeahead="a as a.proveedor.nombreFiscal for a in searchProveedorFilter($viewValue)"
                                        typeahead-loading="data.loadingSearch"
                                        typeahead-no-results="data.noResults"
                                        typeahead-template-url="autocompleteProveedorFilter.html"
                                        typeahead-editable="false"
                                        typeahead-on-select="searchProveedorFilterChange($item)" /> 

                                        <script type="text/ng-template" id="autocompleteProveedorFilter.html">
                                            <div class="autocomplete-suggestion-cliente">
                                                <span class="item-title">
                                                    <b> {{match.model.proveedor.numeroIdentificacion}}</b> - {{match.model.proveedor.nombreFiscal}}
                                                </span>
                                            </div>
                                        </script> 
                            </div>
                    </div>

                    <div class="col-xl-6 col-lg-6 col-md-6 col-sm-6 col-12" ng-if="dataSearch.checkBoxUsuario">
                        <div class="form-group">
                            <label>Usuario:</label>
                            @await Html.PartialAsync("~/Views/Usuario/_UsuarioSearchFilter.cshtml")                           
                        </div>                        
                    </div>
                </div>


                <div class="row">
                    <div class="col-xl-3 col-lg-3 col-md-4 col-12" ng-if="dataSearch.checkBoxEstado">
                        <div class="form-group">
                            <label>Estado:</label>
                            <select class="form-control" ng-model="dataSearch.byEstado">
                                <option value="{{item.idEstadoPago}}" ng-repeat="item in estadoPagos">
                                    {{item.descripcion}}
                                </option>
                            </select>
                        </div>
                    </div>
                </div>


            </div>
            <div class="modal-footer">
                <button class="btn btn-info" ng-click="filtrarLiqCompra()"><i class="fa fa-search"></i> Buscar</button>
                <button class="btn btn-dark" data-dismiss="modal">&times; Cerrar</button>
            </div>
        </div>
    </div>
</div>