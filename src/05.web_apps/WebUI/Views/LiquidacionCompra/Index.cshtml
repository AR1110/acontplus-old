@{
    ViewData["title"] = "Liquidación de Compra";
}


<div ng-controller="liquidacionCompraCtrl">   
    <div class="row page-titles">
        <div class="col-md-5 align-self-center">            
            <h5 class="text-muted">Gestión de Liquidación de Compra</h5>
        </div>
        <div class="col-md-7 align-self-center text-right">
            <div class="d-flex justify-content-end align-items-center">               
                <button type="button" class="btn btn-info m-l-15" ng-if="accion.leer && accion.crear" ng-click="openModalNew()"><i class="fa fa-plus-circle"></i> Nuevo</button>
            </div>
        </div>
    </div>


    <!--Filtro -->
    <partial name="_ModalFiltro"/>
    <!--List-->
    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-body">
                    <md-toolbar class="md-table-toolbar md-default">
                        <div class="md-toolbar-tools">

                            <div class="col-lg-3 col-md-3 col-sm-6 col-xs-12">
                                <button type="button"  class="btn btn-info" ng-click="openModalFiltro()"><i class=" fas fa-filter"></i> Filtrar</button>            
                            </div>
                            <div class="col-lg-6 col"></div>
                            <div class="col-lg-3 col-md-3 col-sm-12 col-xs-12">
                                <form class="form-material">
                                    <input type="text" class="form-control" ng-keyup="filterLocalLCompras()" ng-model="txtFilter" placeholder="Buscar">
                                </form>
                            </div>
                        </div>
                    </md-toolbar>
                    <md-table-container style="max-height: 400px;">
                        <table resize md-table class="table-condensed table-sm">
                            <thead fix-head md-head md-order="query.order" md-on-reorder="liqCompras">
                                <tr md-row>
                                    <th md-column>Op</th>
                                    @* <th md-column>N°</th> *@
                                    <th md-column>N°. Doc</th>
                                    <th md-column>F. Emisión</th>
                                    <th md-column>F. Vcto</th>
                                    <th md-column>Proveedor</th>
                                    <th md-column>Total</th>
                                    <th md-column>Abono</th>
                                    <th md-column>Saldo</th>
                                    <th md-column>Estado</th>
                                    <th md-column>Estado Sri</th>
                                    <th md-column>Usuario</th>
                                </tr>
                            </thead>
                            <tbody md-body>
                                <tr md-row ng-repeat="item in liquidacionesCompra" ng-class="item.style">
                                    <td md-cell>
                                        <md-menu>
                                            <md-button aria-label="Open demo menu" class="md-icon-button"
                                                       ng-click="$mdMenu.open($event)">
                                                <icon class="mdi mdi-menu"></icon>
                                            </md-button>
                                            <md-menu-content class="md-dense">
                                                <md-menu-item>
                                                    <md-button ng-click="openModalDetalle(item)">
                                                        <span md-menu-align-target><i class="ti-menu"></i> Detalle</span>
                                                    </md-button>
                                                </md-menu-item>


                                                <md-menu-item ng-if="accion.editar">
                                                    <md-button ng-click="openModalEditar(item)">
                                                        <span md-menu-align-target><i class="ti-pencil"></i> Editar</span>
                                                    </md-button>
                                                </md-menu-item>

                                                <md-menu-item ng-if="accion.anular">
                                                    <md-button ng-click="askToDelete(item)">
                                                        <span md-menu-align-target><icon class="ti-na"></icon> Anular</span>
                                                    </md-button>
                                                </md-menu-item>

                                                <md-menu-item ng-if="accion.cobroPago">
                                                    <md-button ng-click="openModalPago(item)">
                                                        <span md-menu-align-target><i class=" far fa-money-bill-alt"></i> Pago</span>
                                                    </md-button>
                                                </md-menu-item>

                                                <md-menu-item>
                                                    <md-button ng-click="openModalCuota(item)">
                                                        <span md-menu-align-target><i class="fas fa-donate"></i> Cuotas</span>
                                                    </md-button>
                                                </md-menu-item>

                                                <md-menu-item ng-if="accion.historialFinanciero">
                                                    <md-button ng-click="openModalHistorialPago(item)">
                                                        <span md-menu-align-target><icon class=" fas fa-tasks"></icon> Hist. Mov.</span>
                                                    </md-button>
                                                </md-menu-item>                                              

                                                <md-menu-item ng-if="accion.reporte">
                                                    <md-button ng-click="getReport(item)">
                                                        <span md-menu-align-target><i class=" ti-file"></i> PDF</span>
                                                    </md-button>
                                                </md-menu-item>


                                            </md-menu-content>
                                        </md-menu>
                                    </td>
                                    @* <td md-cell>{{$index+1}}</td> *@
                                    <td md-cell>{{item.nroDocumento}}</td>
                                    <td md-cell>{{item.fechaEmision|date: 'dd/MM/yyyy'}}</td>
                                    <td md-cell>{{item.fechaVencimiento|date:'dd/MM/yyyy'}}</td>
                                    <td md-cell>{{item.nombreFiscal}}</td>
                                    <td md-cell>${{item.total}}</td>
                                    <td md-cell>${{item.abono}}</td>
                                    <td md-cell>${{item.saldo}}</td>
                                    <td md-cell>{{item.estadoFinanciero}}</td>
                                    <td md-cell>{{item.estadoSri}}</td>
                                    <td md-cell>{{item.usuario}}</td>
                                </tr>
                                <tr ng-if="liquidacionesCompra.length===0" class="text-center">
                                    <td colspan="10">No hay registros</td>
                                </tr>
                            </tbody>
                            <tfoot md-foot>
                                <tr md-row>
                                    <td md-cell colspan="2">{{liquidacionesCompra.length}} Registros</td>
                                    <td md-cell colspan="3"><span class="font-weight-bold">Total: </span></td>
                                    <td md-cell><span class="font-weight-bold">${{total}}</span></td>
                                    <td md-cell colspan="3"></td>
                                </tr>
                            </tfoot>
                        </table>
                    </md-table-container>                               
                </div>
            </div>
        </div>
    </div>      
</div>

@section Scripts{
    <script src="~/js/components/mdAutocompleteProveedor.min.js" asp-append-version="true"></script>
    <script src="~/js/controllers/compras/liquidacionCompraCtrl.js" asp-append-version="true"></script>            
    
}


