<style>
    /* Angular Material Overrides */
    .md-select-menu-container, md-backdrop {
        z-index: 9999 !important;
    }        
</style>
<div class="modal-header">
    <div class="float-left">
        <h4 class="modal-title">Detalle Retencion Venta</h4>
    </div>
    <div class="float-center">
        <span > Nro. Doc: {{$ctrl.dataTipoDocumento.nroDocumento}}</span>
    </div>    

    <div class="float-right">
        <button type="button" class="close" aria-label="Close" ng-click="$ctrl.closeModal()">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
</div>
<div class="modal-body">
    <div layout-gt-sm="row">
        <md-input-container class="md-block" flex-gt-sm>
            <md-select-sucursal  
                set-asignaciones="$ctrl.setAsignaciones(item)"
                edit-data="$ctrl.sucursal"
                scope-parent="$ctrl.scopeParent">
            </md-select-sucursal>            
        </md-input-container>
        
        <md-input-container class="md-block" flex-gt-sm>
            <label for="">Punto Emisión: <span class="text-danger">*</span></label>
            <input type="text" ng-model="$ctrl.data.ptoEmision" disabled mask="999-999" md-minlength="7"  md-maxlength="7" placeholder="001-002">
        </md-input-container>
        
        <md-input-container class="md-block" flex-gt-sm>
            <label for="">Nro. Documento: <span class="text-danger">*</span></label>
            <input type="text" ng-model="$ctrl.data.nroDoc" disabled>
        </md-input-container>
        
        <md-input-container class="md-block" flex-gt-sm>
            <label>Fecha Emisión</label>
            <input type="date" ng-model="$ctrl.data.fechaEmision" disabled >
            <span class="text-info">{{$ctrl.fechaEmisionEscrita}}</span>
        </md-input-container>                                                       
    </div>


    <div layout-gt-sm="row">                                                                                                                       
        <md-input-container class="md-block"  flex-gt-xs>
            <label>Cliente</label>
            <input ng-model="$ctrl.cliente.nombreFiscal" disabled>
        </md-input-container>

        <md-input-container class="md-block" flex-gt-xs>
            <label>Nro. Identificación</label>
            <input ng-model="$ctrl.cliente.numeroIdentificacion" disabled>
        </md-input-container>                       

        <div flex-gt-sm>
             <md-input-container class="md-block" flex-gt-sm>
                <label>Nro. Factura</label>
                <input ng-model="$ctrl.factura.nroDocumento" disabled>
                 <a class="btn btn-secondary btn-sm mt-1" ng-if="$ctrl.factura.idFactura>0" href="javascript:void(0)" ng-click="$ctrl.viewDetailInvoice()">
                    <i class="mdi mdi-eye"></i> Ver Documento
                </a>
            </md-input-container>                                                                       
        </div>                                                                     

    </div>

    <div layout-gt-sm="row">       
        <md-input-container class="md-block" flex-gt-sm>
            <label>Nro. Autorización: <span class="text-danger">*</span></label>
            <input ng-model="$ctrl.data.nroAutho" valid-number disabled>
             <span class="text-info">{{$ctrl.data.nroAutho.length}} números</span>     
        </md-input-container>

        <md-input-container class="md-block" flex-gt-sm>
            <label>Observación</label>
            <input ng-model="$ctrl.data.concepto" disabled>
        </md-input-container>
    </div> 
    
    <div ui-grid="$ctrl.gridOptionsRetencionVentaDetalle"
            ui-grid-edit
            ui-grid-resize-columns
            ui-grid-cellNav
            ui-grid-auto-resize
            class="grid">
        </div> 

        
</div>
<div class="modal-footer">    
    <button class="btn btn-dark" type="button" ng-click="$ctrl.closeModal()">
        &times; Cerrar
    </button>
</div>
