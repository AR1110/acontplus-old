

<div class="modal-header bg-success text-white">
    <h5 class="modal-title"><i class=" fas fa-exchange-alt"></i> Transformacion de {{$ctrl.TIPO_DOC.descripcion}} a Factura</h5>
    <button class="close" ng-click="$ctrl.closeModal()">&times;</button>
</div>

<div class="modal-body">  
    <!--Tab-->
    <div class="list-group list-group-horizontal" id="step">
        <a href="javascript:void(0)" ng-click="$ctrl.stepUno()" class="list-group-item list-group-item-action active">
            <div>Paso 1 </div>
            <span>Seleccionar Documentos</span>
        </a>
            <a href="javascript:void(0)" ng-click="$ctrl.stepDos()" class="list-group-item list-group-item-action">
            <div>Paso 2 </div>
            <span>Factura</span>
        </a>
    </div>
    <hr>

    <div class="tab-content">
        <div class="tab-pane fade show active" id="notas-de-entrega" role="tabpanel">
            <div class="card">
                <div class="card-body shadow">
                    <form class="form-material">
                        <div class="row justify-content-between">
                            <div class="col-xl-col-lg-3 col-md-3 col-sm-12 col-xs-12">
                                <button type="button" class="btn btn-info" ng-click="$ctrl.openModalFiltroDocumento()">
                                    <i class="fas fa-filter"></i> Filtro
                                </button>                   
                            </div>
                            <div class="col-xl-col-lg-4 col-md-4 col-sm-12 col-xs-12 b-r">
                                <strong>Cliente: </strong><br>
                                <p class="text-muted">{{$ctrl.cliente.nombreFiscal}}</p>                                 
                            </div>
                            <div class="col-xl-col-lg-4 col-md-4 col-sm-12 col-xs-12 b-r">
                                <strong>Nro. Identificación: </strong><br>
                                <p class="text-muted">{{$ctrl.cliente.numeroIdentificacion}}</p>  
                            </div>                        
                        </div>
                    </form>
                    <hr>  
                    
                    <div ui-grid="$ctrl.gridOptions" ng-if="$ctrl.gridOptions.data.length>0"                                 
                        ui-grid-auto-resize  
                        ui-grid-resize-columns
                        ui-grid-tree-view                       
                        ui-grid-pinning 
                        ui-grid-expandable 
                        ui-grid-selection 
                        class="grid">
                    </div>
                    
                    @* <div class="icheck-info">
                        <input type="checkbox" id="groupByArticle" ng-model="$ctrl.groupByArticle">
                        <label for="groupByArticle">Agrupar Articulo</label>
                    </div> *@
                </div>
            </div>
        </div>
        <div class="tab-pane fade show active" id="factura" style="display: none;" role="tabpanel">

            <div class="row">
                <div class="col-xl-4 col-lg-4 col-md-6 col-sm-12 col-xs-12">
                    <div class="form-group">
                        <label for="sucursal">Estab.: <span class="text-danger">*</span></label>
                        <select class="form-control" ng-model="$ctrl.data.codEstab" ng-change="$ctrl.onChangeEstablecimiento()">
                            <option ng-value="item.codEstab" ng-repeat="item in $ctrl.establecimientos">{{item.nombreComercial}}</option>
                        </select>
                    </div>
                </div>                

                <div class="col-xl-4 col-lg-4 col-md-6 col-sm-12 col-xs-12">
                    <div class="form-group">                        
                        <label>Punto Emisión <span class="text-danger">*</span></label>
                        <select class="form-control" ng-model="$ctrl.data.idPuntoEmision" ng-change="$ctrl.onChangePuntoEmision()">
                            <option ng-value="item.idPuntoEmision" ng-repeat="item in $ctrl.puntosEmision">{{item.ptoEmi}}</option>
                        </select>
                    </div>
                </div>

                <div class="col-xl-4 col-lg-4 col-md-6 col-sm-12 col-xs-12">
                    <div class="form-group">
                        <label>Fecha Emisión: <span class="text-danger">*</span> </label>
                        <input type="date" name="fechaEmision" class="form-control" ng-model="$ctrl.data.fechaEmision">
                        <small class="text-info">{{$ctrl.fechaEmisionEscrita}}</small>
                    </div>                    
                </div>
            </div>

            <div class="row">
                <div class="col-xl-4 col-lg-4 col-md-6 col-sm-12 col-xs-12">
                    <div class="form-group">
                        <label for="">Cliente: <span class="text-danger">*</span></label>
                        <input type="text" name="" id="" class="form-control" ng-model="$ctrl.cliente.nombreFiscal" disabled>
                    </div>
                </div>

                <div class="col-xl-4 col-lg-4 col-md-6 col-sm-12 col-xs-12">
                    <div class="form-group">
                        <label for="" class="">Nro. Identificación:</label>
                        <input type="text" id="" class="form-control" disabled ng-value="$ctrl.cliente.numeroIdentificacion" placeholder="...">
                    </div>
                </div>

                <div class="col-xl-4 col-lg-4 col-md-6 col-sm-12 col-xs-12">
                    <div class="form-group">
                        <label for="address" class="">Dirección:</label>
                        <input type="text" id="address" class="form-control" disabled ng-model="$ctrl.cliente.direccion">
                    </div>                    
                </div>
            </div>

            <div ui-grid="$ctrl.gridOptionsDetailDocument"                                  
                ui-grid-auto-resize
                ui-grid-resize-columns                                     
                ui-grid-pinning                                 
                class="grid">
            </div>

            
            <!--Subtotales-->
            <div class="row mt-3">
                <div class="col-lg-9 col-md-9 col-sm-12 col-xs-12">
                    <div class="row  border border-secondary-1 ml-0" ng-if="$ctrl.data.showSubtotales">
                        <div class="col-lg-4 col-md-4 col-sm-12 col-xs-12">
                            <div class="table-responsive">
                                <table class="table table-clear table-sm">
                                    <tbody>
                                        <tr>
                                            <td class="left">
                                                <strong>SubTotal {{$ctrl.actividadTipoIva.tarifa}}%</strong>
                                            </td>
                                            <td class="right">
                                                <strong>${{$ctrl.data.subTotalIva}}</strong>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td class="left">
                                                <strong>SubTotal IVA 0</strong>
                                            </td>
                                            <td class="right">${{$ctrl.data.subTotalIvaCero}}</td>
                                        </tr>
                                        <tr>
                                            <td class="left">
                                                <strong>SubTotal Exento IVA</strong>
                                            </td>
                                            <td class="right">
                                                <strong>${{$ctrl.data.subTotalExentoIva}}</strong>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td class="left">
                                                <strong>SubTotal no Objeto IVA</strong>
                                            </td>
                                            <td class="right">
                                                <strong>${{$ctrl.data.subTotalNoObjetoIva}}</strong>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        <div class="col-lg-4 col-md-4 col-sm-12 col-xs-12">
                            <div class="table-responsive">
                                <table class="table table-clear table-sm">
                                    <tbody>
                                        <tr>
                                            <td class="left">
                                                <strong>SubTotal Neto IVA</strong>
                                            </td>
                                            <td class="right">
                                                <strong>${{$ctrl.data.subTotalNetoIva}}</strong>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td class="left">
                                                <strong>SubTotal Neto IVA 0</strong>
                                            </td>
                                            <td class="right">
                                                <strong>${{$ctrl.data.subTotalNetoIvaCero}}</strong>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td class="left">
                                                <strong>SubTotal Neto Exento IVA</strong>
                                            </td>
                                            <td class="right">
                                                <strong>${{$ctrl.data.subTotalNetoExentoIva}}</strong>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td class="left">
                                                <strong>SubTotal Neto no Objeto IVA</strong>
                                            </td>
                                            <td class="right">
                                                <strong>${{$ctrl.data.subTotalNetoNoObjetoIva}}</strong>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        <div class="col-lg-4 col-md-4 col-sm-12 col-xs-12">
                            <div class="table-responsive">
                                <table class="table table-clear table-sm">
                                    <tbody>
                                        <tr>
                                            <td class="left">
                                                <strong>ICE</strong>
                                            </td>
                                            <td class="right">
                                                <strong>${{$ctrl.data.totalIce}}</strong>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td class="left">
                                                <strong>IRBPNR</strong>
                                            </td>
                                            <td class="right">
                                                <strong>${{$ctrl.data.irbpnr}}</strong>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td class="left">
                                                <strong>Propina</strong>
                                            </td>
                                            <td class="right">
                                                <strong>${{$ctrl.data.propina}}</strong>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                    <div class="row mt-1  border border-secondary-1 ml-0" ng-if="$ctrl.data.showSubtotales">
                        <div class="col-xl-2 col-lg-2 col-md-3 col-sm-12 col-xs-12">
                            <div class="form-group">
                                <label>% Descuento</label>
                                <div class="input-group">
                                    <input ng-model="$ctrl.data.porcentajeDescuento" disabled  class="form-control" />
                                    <div class="input-group-append">
                                        <button type="button" class="btn btn-secondary btn-sm" disabled><i class="fa fa-calculator fa-xs"></i></button>                                            
                                    </div>
                                </div>
                                
                            </div>
                        </div>

                        <div class="col-xl-2 col-lg-2 col-md-3 col-sm-12 col-xs-12">
                            <div class="form-group">
                                <label>Descuento</label>
                                <div class="input-group">
                                    <input ng-model="$ctrl.data.totalDescuento" disabled placeholder="0.00" class="form-control" />
                                    <div class="input-group-append">
                                        <button type="button" class="btn btn-secondary btn-sm" disabled><i class="fa fa-calculator fa-xs"></i></button>
                                    </div>
                                </div>                                    
                            </div>
                        </div>

                        <div class="col-xl-2 col-lg-2 col-md-3 col-sm-12 col-xs-12">
                            <div class="form-group">
                                <label>Transporte</label>
                                <input type="text" ng-model="$ctrl.data.transporte" disabled class="form-control" placeholder="0.00" />
                            </div>
                        </div>

                        <div class="col-xl-2 col-lg-2 col-md-3 col-sm-12 col-xs-12">
                            <div class="form-group">
                                <label>Rercargo</label>
                                <input type="text" decimal disabled ng-model="$ctrl.data.recargo" class="form-control" placeholder="0.00" />
                            </div>
                        </div>

                        <div class="col-xl-4 col-lg-4 col-md-12 col-sm-12 col-xs-12">
                            <div class="form-group">
                                <label>Observacion</label>
                                <textarea class="form-control border-select" ng-model="$ctrl.data.observacion" placeholder="..."></textarea>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-3 col-md-3 col-sm-6 col-xs-12 ml-auto">
                    <div class="table-responsive border border-secondary-1">
                        <table class="table table-clear table-sm">
                            <tbody>
                                <tr>
                                    <td class="left">
                                        <strong>SubTotal sin Impuesto</strong>
                                    </td>
                                    <td class="right">
                                        <strong>${{$ctrl.data.subTotalSinImpuestos}}</strong>
                                    </td>
                                </tr>

                                <tr>
                                    <td class="left">
                                        <strong>{{$ctrl.actividadTipoIva.tarifa}}%</strong>
                                    </td>
                                    <td class="right">
                                        <strong>${{$ctrl.data.iva}}</strong>
                                    </td>
                                </tr>

                                <tr>
                                    <td class="left">
                                        <strong>Descuento</strong>
                                    </td>
                                    <td class="right">
                                        <strong>${{$ctrl.data.totalDescuento}}</strong>
                                    </td>
                                </tr>

                                <tr>
                                    <td class="left">
                                        <h3><strong>Total</strong></h3>
                                    </td>
                                    <td class="right">
                                        <h3><strong>${{$ctrl.data.total}}</strong></h3>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>                   
                </div>
            </div>

        </div>
    </div>

</div>

<div class="modal-footer">
    <div ng-show="$ctrl.footerActionStepUno">
        <button class="btn btn-info" ng-click="$ctrl.stepDos()"><i class=" fas fa-angle-right"></i> Siguiente</button>
        <button class="btn btn-dark" ng-click="$ctrl.closeModal()">&times; Cerrar</button>
    </div> 

    <div ng-show="$ctrl.footerActionStepDos">
        <div class="icheck-success icheck-inline">
            <input type="checkbox" ng-model="$ctrl.data.showSubtotales" id="showSubTotales" />
            <label for="showSubTotales">Mas datos</label>
        </div>
        <button class="btn btn-info" ng-click="$ctrl.stepUno()"><i class=" fas fa-angle-left"></i> Atras</button>
        <button class="btn btn-success" ng-click="$ctrl.askToSaveInvoice()">
            <i class="ti-save"></i> Guardar
        </button>
    </div>
</div>