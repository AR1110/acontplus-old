<form ng-submit="$ctrl.askToUpdate()">    
    <div class="modal-header bg-success text-white">
        <h5 class="modal-title"><i class="icons-File-Edit "></i> Editar Aprobación Factura</h5>
        <button type="button" class="close" ng-click="$ctrl.closeModal()">&times;</button>
    </div>

    <div class="modal-body">
        <div class="row">
            <div class="col-xl-4 col-lg-4 col-md-6 col-sm-12 col-xs-12">
                <div class="form-group">
                    <label for="sucursal">Sucursal: <span class="text-danger">*</span></label>
                    <select class="form-control" ng-model="$ctrl.data.codEstab" ng-disabled="$ctrl.dataDisabled.isDisabledSucursal">
                        <option ng-value="item.codEstab" ng-repeat="item in $ctrl.establecimientos">{{item.nombreComercial}}</option>
                    </select>
                </div>
            </div>                

            <div class="col-xl-4 col-lg-4 col-md-6 col-sm-12 col-xs-12">
                <div class="form-group">                        
                    <label>Punto Emisión <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" ng-value="$ctrl.data.ptoEmi" disabled>
                    @* <select class="form-control" ng-model="$ctrl.data.idPuntoEmision" ng-disabled="$ctrl.dataDisabled.isDisabledPuntoEmision" >
                        <option ng-value="item.idPuntoEmision" ng-repeat="item in $ctrl.puntosEmision">{{item.ptoEmi}}</option>
                    </select> *@
                </div>
            </div>

            <div class="col-xl-4 col-lg-4 col-md-6 col-sm-12 col-xs-12">
                <div class="form-group">
                    <label>Fecha Emisión: <span class="text-danger">*</span> </label>
                    <input type="date" name="fechaEmision" class="form-control" ng-model="$ctrl.data.fechaEmision">
                    <small class="text-info">{{$ctrl.fechaEmisionEscrita}}</small>
                </div>                    
            </div>
        </div>

        <div class="row">
            <div class="col-xl-4 col-lg-4 col-md-6 col-sm-12 col-xs-12">
                <div class="form-group">
                    <label for="">Cliente: <span class="text-danger">*</span></label>
                    <input type="text" name="" id="" class="form-control" ng-model="$ctrl.data.cliente" disabled>
                </div>
            </div>

            <div class="col-xl-4 col-lg-4 col-md-6 col-sm-12 col-xs-12">
                <div class="form-group">
                    <label for="" class="">Nro. Identificación:</label>
                    <input type="text" id="" class="form-control" disabled ng-value="$ctrl.data.identificacionComprador" placeholder="...">
                </div>
            </div>

            <div class="col-xl-4 col-lg-4 col-md-6 col-sm-12 col-xs-12">
                <div class="form-group">
                    <label for="address" class="">Dirección:</label>
                    <input type="text" id="address" class="form-control" disabled ng-model="$ctrl.data.direccion">
                </div>                    
            </div>
        </div>


        <div class="row">
            <div class="col-xl-6 col-lg-6 col-md-6 col-sm-12 col-xs-12">
                <div class="row justify-content-between">
                    <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-xs-12">
                        <label for="">Buscar Articulo</label>             
                        <md-autocomplete-articulo-component 
                            tipo-doc="$ctrl.TIPO_DOC"
                            abrir-modal-articulo="$ctrl.abrirModalArticulo(item)"
                            get-data-articulo="$ctrl.getDataIdArticulo(item)"
                            set-item-articulo-en-detalle="$ctrl.setItemArticuloEnDetalle(item)">
                        </md-autocomplete-articulo-component>            
                    </div>
                </div>
            </div>
            <div class="col-xl-6 col-lg-6 col-md-6 col-sm-12 col-xs-12">
                <div class="row justify-content-end">                  
                    <div class="col-xl-4 col-lg-4 col-md-6 col-sm-12 col-xs-12">
                        <div class="form-group">
                            <label for="">Tarifa: 
                                <span tooltip-placement="top" uib-tooltip="Asignación Rápida de listas de precios seleccionada a todos los productos del documento.">
                                    <i class="fas fa-info-circle fa-xs"></i>
                                </span>                                                                
                            </label>
                            <select id="idTarifa" class="form-control border-select" ng-model="$ctrl.idTarifa" ng-change="$ctrl.seleccionarTarifa()">
                                <option ng-value="item.idTarifa" ng-repeat="item in $ctrl.tarifas">{{item.descripcion}}</option>
                            </select>
                        </div>
                    </div> 
                </div>
            </div>          
        </div>

        <div class="row mt-2">
            <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-xs-12">
                <div ui-grid="$ctrl.gridOptionsDetailDocument"                                  
                    ui-grid-edit
                    ui-grid-resize-columns
                    ui-grid-cellNav
                    ui-grid-auto-resize
                    ui-grid-validate
                    ui-grid-save-state class="grid">
                </div>
            </div>
        </div>

         <div class="row mt-3">
            <div class="col-lg-9 col-md-9 col-sm-12 col-xs-12">
                <div class="row  border border-secondary-1 ml-0" ng-if="$ctrl.data.showSubtotales">
                    <div class="col-lg-4 col-md-4 col-sm-12 col-xs-12">
                        <div class="table-responsive">
                            <table class="table table-clear table-sm">
                                <tbody>
                                    <tr>
                                        <td class="left">
                                            <strong>SubTotal  {{$ctrl.actividadTipoIva.tarifa}}%</strong>
                                        </td>
                                        <td class="right">
                                            <strong>${{$ctrl.data.subTotalIva}}</strong>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="left">
                                            <strong>SubTotal IVA 0</strong>
                                        </td>
                                        <td class="right">${{$ctrl.data.subTotalIvaCero}}</td>
                                    </tr>
                                    <tr>
                                        <td class="left">
                                            <strong>SubTotal Exento IVA</strong>
                                        </td>
                                        <td class="right">
                                            <strong>${{$ctrl.data.subTotalExentoIva}}</strong>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="left">
                                            <strong>SubTotal no Objeto IVA</strong>
                                        </td>
                                        <td class="right">
                                            <strong>${{$ctrl.data.subTotalNoObjetoIva}}</strong>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="col-lg-4 col-md-4 col-sm-12 col-xs-12">
                        <div class="table-responsive">
                            <table class="table table-clear table-sm">
                                <tbody>
                                    <tr>
                                        <td class="left">
                                            <strong>SubTotal Neto IVA</strong>
                                        </td>
                                        <td class="right">
                                            <strong>${{$ctrl.data.subTotalNetoIva}}</strong>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="left">
                                            <strong>SubTotal Neto IVA 0</strong>
                                        </td>
                                        <td class="right">
                                            <strong>${{$ctrl.data.subTotalNetoIvaCero}}</strong>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="left">
                                            <strong>SubTotal Neto Exento IVA</strong>
                                        </td>
                                        <td class="right">
                                            <strong>${{$ctrl.data.subTotalNetoExentoIva}}</strong>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="left">
                                            <strong>SubTotal Neto no Objeto IVA</strong>
                                        </td>
                                        <td class="right">
                                            <strong>${{$ctrl.data.subTotalNetoNoObjetoIva}}</strong>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="col-lg-4 col-md-4 col-sm-12 col-xs-12">
                        <div class="table-responsive">
                            <table class="table table-clear table-sm">
                                <tbody>
                                    <tr>
                                        <td class="left">
                                            <strong>ICE</strong>
                                        </td>
                                        <td class="right">
                                            <strong>${{$ctrl.data.totalIce}}</strong>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="left">
                                            <strong>IRBPNR</strong>
                                        </td>
                                        <td class="right">
                                            <strong>${{$ctrl.data.irbpnr}}</strong>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="left">
                                            <strong>Propina</strong>
                                        </td>
                                        <td class="right">
                                            <strong>${{$ctrl.data.propina}}</strong>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="row mt-1  border border-secondary-1 ml-0" ng-if="$ctrl.data.showSubtotales">
                    <div class="col-xl-2 col-lg-2 col-md-3 col-sm-12 col-xs-12">
                        <div class="form-group">
                            <label>% Descuento</label>
                            <div class="input-group">
                                <input ng-model="$ctrl.data.porcentajeDescuento" disabled  class="form-control" />
                                <div class="input-group-append">
                                    <button type="button" class="btn btn-secondary btn-sm" disabled><i class="fa fa-calculator fa-xs"></i></button>                                            
                                </div>
                            </div>
                            
                        </div>
                    </div>

                    <div class="col-xl-2 col-lg-2 col-md-3 col-sm-12 col-xs-12">
                        <div class="form-group">
                            <label>Descuento</label>
                            <div class="input-group">
                                <input ng-model="$ctrl.data.totalDescuento" disabled placeholder="0.00" class="form-control" />
                                <div class="input-group-append">
                                    <button type="button" class="btn btn-secondary btn-sm" disabled><i class="fa fa-calculator fa-xs"></i></button>
                                </div>
                            </div>                                    
                        </div>
                    </div>

                    <div class="col-xl-2 col-lg-2 col-md-3 col-sm-12 col-xs-12">
                        <div class="form-group">
                            <label>Transporte</label>
                            <input type="text" ng-model="$ctrl.data.transporte" disabled class="form-control" placeholder="0.00" />
                        </div>
                    </div>

                    <div class="col-xl-2 col-lg-2 col-md-3 col-sm-12 col-xs-12">
                        <div class="form-group">
                            <label>Rercargo</label>
                            <input type="text" decimal disabled ng-model="$ctrl.data.recargo" class="form-control" placeholder="0.00" />
                        </div>
                    </div>

                    <div class="col-xl-4 col-lg-4 col-md-12 col-sm-12 col-xs-12">
                        <div class="form-group">
                            <label>Observacion</label>
                            <textarea class="form-control border-select" ng-model="$ctrl.data.observacion" placeholder="..."></textarea>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 col-md-3 col-sm-6 col-xs-12 ml-auto">
                <div class="table-responsive border border-secondary-1">
                    <table class="table table-clear table-sm">
                        <tbody>
                            <tr>
                                <td class="left">
                                    <strong>SubTotal sin Impuesto</strong>
                                </td>
                                <td class="right">
                                    <strong>${{$ctrl.data.subTotalSinImpuestos}}</strong>
                                </td>
                            </tr>

                            <tr>
                                <td class="left">
                                    <strong> IVA {{$ctrl.actividadTipoIva.tarifa}}%</strong>
                                </td>
                                <td class="right">
                                    <strong>${{$ctrl.data.iva}}</strong>
                                </td>
                            </tr>

                            <tr>
                                <td class="left">
                                    <strong>Descuento</strong>
                                </td>
                                <td class="right">
                                    <strong>${{$ctrl.data.totalDescuento}}</strong>
                                </td>
                            </tr>

                            <tr>
                                <td class="left">
                                    <h3><strong>Total</strong></h3>
                                </td>
                                <td class="right">
                                    <h3><strong>${{$ctrl.data.total}}</strong></h3>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>               
            </div>
        </div>

    </div>   

    

    <div class="modal-footer">
        <div class="icheck-success icheck-inline">
            <input type="checkbox" ng-model="$ctrl.data.showSubtotales" id="showSubTotales" />
            <label for="showSubTotales">Mas datos</label>
        </div>

        <button type="submit" class="btn btn-success">
            <i class="ti-pencil"></i> Actualizar
        </button>
        <button type="button" class="btn btn-dark" ng-click="$ctrl.closeModal()">
            &times; Cerrar
        </button>
    </div>

</form>