@{
    ViewData["Title"] = "Aprob. Comprobante";
}

<div ng-controller="aprobComprobanteCtrl">
    <div class="row page-titles">
        <div class="col-md-5 align-self-center">
            <h5 class="text-themecolor">Aprob. Comprobante</h5>
        </div>
         <div class="col-md-7 align-self-center text-right">
            <div class="d-flex justify-content-end align-items-center">
                <!--<ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/Home/Index">Inicio</a></li>
                    <li class="breadcrumb-item"><a href="javascript:void(0)">Almacen</a></li>
                    <li class="breadcrumb-item active">Articulo Fraccionable</li>
                </ol>-->
                <button type="button" class="btn btn-info" ng-click="askToOpenModalOption()"><i class="ti-plus"></i> Nuevo</button>                
            </div>
        </div>         
    </div>

    <div class="card">  

        <div class="card-body">
            <div class="row justify-content-between">
                <div class="col-xl-4 col-lg-4 col-md-12 col-sm-12 col-xs-12">
                    <button class="btn btn-info" type="button" ng-click="openModalFiltro()">
                        <icon class="fas fa-filter"></icon> Filtrar
                    </button>
                </div>
                <div class="col-xl-4 col-lg-4 col-md-12 col-sm-12 col-xs-12">
                    <form class="form-material">
                        <div class="input-group">
                            <input type="text" class="form-control border-select" ng-model="dataSearch.bySearch" placeholder="Buscar...">
                            <div class="input-group-append">
                                <button type="button" class="btn btn-secondary btn-sm" ng-click="getAprobComprobantes()">
                                    <i class="fas fa-redo"></i> 
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>

            
        <div class="card-body">
            <div id="upperScroll" style="overflow-x:scroll; overflow-y: hidden; max-height:20px; width:100%">
                <div name="innerScroll" ng-style="duelScroll" style="height:20px;"></div>
            </div>

            <div ng-style="getStyle($index)">
                <md-table-container name="wireTable" infinite-scroll="loadMore($index)" infinite-scroll-distance="1" infinite-scroll-parent="true" ng-init="isShow=true" ng-show="isShow" style=" max-height: 400px; overflow-x: hidden">
                    <table resize master md-table name="innerWireTable">
                        <thead md-trim-column-names fix-head md-head>
                            <tr md-row>
                                <th md-column><span>Op</span></th>
                                <th md-column><span>N°</span></th>
                                <th md-column><span>Nro. Doc</span></th>
                                <th md-column><span>F. Emisión</span></th>
                                <th md-column><span>Identificación</span></th>
                                <th md-column><span>Razon Social Comprador</span></th>
                                <th md-column><span>Total</span></th>
                                <th md-column><span>Estado</span></th>
                              
                            </tr>
                        </thead>
                        <tbody md-body>
                            <tr md-row ng-repeat="item in aprobComprobantes track by $index" ng-class="item.colorFila">
                                <td md-cell>
                                    <md-menu>
                                        <md-button aria-label="Open demo menu" class="md-icon-button"
                                                    ng-click="$mdMenu.open($event)">
                                            <icon class="mdi mdi-menu"></icon>
                                        </md-button>
                                        <md-menu-content class="md-dense">
                                            <md-menu-item>                                            
                                                <md-button ng-click="openModalDetalle(item)">
                                                    <span md-menu-align-target><i class="ti-menu"></i> Detalle</span>
                                                </md-button>
                                            </md-menu-item> 
                                           
                                            <md-menu-item ng-if="showBtnEditar(item)">                                                                                        
                                                <md-button ng-click="openModalEdit(item)">
                                                    <span md-menu-align-target><i class="ti-pencil"></i> Editar</span>
                                                </md-button>
                                            </md-menu-item> 

                                            
                                            <md-menu-item ng-if="showBtnDelete(item)">                                                                                        
                                                <md-button ng-click="askToDelete(item)">
                                                    <span md-menu-align-target><i class="ti-na"></i> Anular</span>
                                                </md-button>
                                            </md-menu-item>                                          
                                            
                                            <md-menu-item ng-if="showBtnApprove(item)">                                            
                                                <md-button ng-click="approveDocument(item)">
                                                    <span md-menu-align-target><i class="mdi mdi-file-check"></i> Aprobar</span>
                                                </md-button>
                                            </md-menu-item> 

                                                                                    
                                            <md-menu-item  ng-if="accion.reporte">                                                                                        
                                                <md-button ng-click="getReport(item)">
                                                    <span md-menu-align-target><i class=" ti-file"></i> PDF</span>
                                                </md-button>
                                            </md-menu-item>                                                  
                                        </md-menu-content>
                                    </md-menu>                                    
                                </td>
                                <td md-cell>{{$index+1}}</td>
                                <td md-cell>{{item.serie}}</td>
                                <td md-cell>{{item.fechaEmision}}</td>
                                <td md-cell>{{item.identificacionComprador}}</td>
                                <td md-cell>{{item.razonSocialComprador}}</td>
                                <td md-cell>${{item.total}}</td>
                                <td md-cell>{{item.estado}}</td>                                                               
                            </tr>
                            <tr ng-show="aprobComprobantes.length==0" class="text-center">
                                <td colspan="8">
                                    No hay registros en esta tabla :)
                                </td>
                            </tr>
                        </tbody>
                        <tfoot md-foot fixed-tfoot>
                            <tr md-row>
                                <td md-cell colspan="2"><span class="font-weight-bold">{{aprobComprobantes.length}} Documentos</span></td>
                                <td md-cell colspan="3"></td>
                                <td md-cell colspan="1"><span class="font-weight-bold">Total</span></td>
                                <td md-cell><span class="font-weight-bold">{{total}}</span></td>  
                                <td md-cell></td>                             
                            </tr>
                        </tfoot>
                    </table>
                </md-table-container>
            </div>
        </div>
    </div>

</div>

@section Scripts{
    <script src="~/js/controllers/ventas/aprobDocumentCtrl.js" asp-append-version="true"></script>
}