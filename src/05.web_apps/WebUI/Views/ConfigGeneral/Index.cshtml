@{
    ViewData["title"] ="Configuración General";
}

<div ng-controller="configGeneralCtrl">
    <div class="row page-titles">
        <div class="col-md-5 align-self-center">
            <h4 class="text-themecolor">Configuración General</h4>
        </div>
         <div class="col-md-7 align-self-center text-right">
            <div class="d-flex justify-content-end align-items-center">                
                
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12 mb-4">
            <div >
                <md-content>
                    <md-tabs class="md-primary" md-center-tabs md-dynamic-height="">

                        <md-tab label="SISTEMA">
                            <md-content class="md-padding">
                                <md-table-container>
                                    <table md-table>                               
                                        <tbody md-body>
                                            <tr md-row>
                                                <td md-cell>
                                                    <md-switch class="md-primary" md-no-ink aria-label="Tipo IVA" ng-model="gestionSistema.taxesDefault">
                                                        Tipo IVA
                                                    </md-switch>
                                                </td>
                                                <td md-cell>                                                   
                                                    <md-input-container ng-if="gestionSistema.taxesDefault">                                                                                                               
                                                        <md-select ng-model="gestionSistema.idTipoIva" style="min-width: 200px;">                                                            
                                                            <md-option ng-repeat="item in tipoIvas" ng-value="item.idTipoIva">
                                                                {{item.descripcion}}
                                                            </md-option>
                                                        </md-select>
                                                    </md-input-container>
                                                </td>                                           
                                            </tr>                                   

                                            <tr md-row>
                                                <td md-cell>
                                                    <md-switch class="md-primary" md-no-ink aria-label="Control Inventario" ng-model="gestionSistema.llevaInventario">
                                                        Control Inventario
                                                    </md-switch>
                                                </td>
                                                <td md-cell>
                                                    <md-input-container ng-if="gestionSistema.llevaInventario">                                                                                                              
                                                        <md-select ng-model="gestionSistema.idMetodoValoracion" style="min-width: 200px;">                                                            
                                                            <md-option ng-value="item.idMetodoValoracion" ng-repeat="item in valoracionMetodos">
                                                                {{item.descripcion}}
                                                            </md-option>
                                                        </md-select>
                                                    </md-input-container>                                               
                                                </td>
                                            </tr>

                                            <tr md-row>
                                                <td md-cell>
                                                    <md-switch class="md-primary" md-no-ink aria-label="Switch No Ink" ng-model="gestionSistema.customerDefault">
                                                        Cliente
                                                    </md-switch>
                                                </td>
                                                <td md-cell>
                                                    <div ng-if="gestionSistema.customerDefault">
                                                        <md-autocomplete 
                                                            md-input-name="autocompleteField"
                                                            md-input-minlength="1"
                                                            md-input-maxlength="2000"
                                                            md-no-cache="false"
                                                            md-search-text-change="searchTextChange(searchText)"
                                                            md-search-text="searchText"
                                                            md-selected-item-change="selectedItemChangeCliente(item)"
                                                            md-items="item in searchCustomer(searchText)"
                                                            md-item-text="item.nombreFiscal"
                                                            md-escape-options="clear"
                                                            placeholder="Ej: Jorge Ramirez"
                                                            md-clear-button="false"
                                                            input-aria-describedby="Buscar Cliente">
                                                            <md-item-template>
                                                                <span md-highlight-text="searchText">{{item.nombreFiscal}}</span>
                                                            </md-item-template>                                                           
                                                        </md-autocomplete>
                                                    </div>                                                                                                
                                                </td>
                                            </tr>

                                            <tr md-row>
                                                <td md-cell>
                                                    <md-switch class="md-primary" md-no-ink aria-label="Buscador Articulo" ng-model="gestionSistema.articleDefault">
                                                        Articulo
                                                    </md-switch>
                                                </td>
                                                <td md-cell>
                                                    <div ng-if="gestionSistema.articleDefault">
                                                        <md-autocomplete class="md-block mr-10" 
                                                            md-input-name="autocompleteField"
                                                            md-min-length="3"
                                                            md-no-cache="false"
                                                            md-search-text-change="searchTextChangeArticle(searchTextArticle)"
                                                            md-search-text="searchTextArticle"
                                                            md-selected-item-change="selectedItemChangeArticle(item)"
                                                            md-items="item in searchArticle(searchTextArticle)"
                                                            md-item-text="item.descripcion"
                                                            md-escape-options="clear"
                                                            placeholder="Ej: Mouse..."
                                                            md-clear-button="false"
                                                            input-aria-describedby="Buscar Artículo">
                                                            <md-item-template>
                                                                <span md-highlight-text="searchTextArticle">{{item.descripcion}}</span>
                                                            </md-item-template>  
                                                        </md-autocomplete>                                             
                                                        <button type="button" class="btn btn-info btn-xs mt-1" ng-click="editArticle()">
                                                            <i class="ti-pencil"></i> Editar
                                                        </button>    
                                                    </div>                                                     
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </md-table-container>                              
                                <hr>
                                <div class="float-right">
                                    <button type="button" class="btn btn-success" ng-click="updateConfigSistema()">
                                        <icon class="ti-pencil"></icon> Actualizar
                                    </button>
                                </div>                          
                            </md-content>
                        </md-tab>


                        <md-tab label="DECIMALES" >
                            <md-content class="md-padding">
                                <div class="row">
                                    <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12">
                                        <div class="card">
                                            <div class="card-header bg-success">
                                                <h6 class="m-b-0 text-white">VENTAS</h6>     
                                            </div>
                                            <div class="card-body shadow">
                                                <div class="row pb-1">
                                                    <div class="col-md-12">
                                                        <div class="row">
                                                            <div class="col-6 py-2">
                                                                <span>Precio</span>
                                                            </div>
                                                            
                                                            <div class="col-6 py-2 text-truncate">
                                                                 <select class="form-control border-select" ng-model="decimalVenta.nroPrecio">
                                                                    <option ng-value="decimal" ng-repeat="decimal in decimales">
                                                                        {{decimal}}
                                                                    </option>                                    
                                                                </select>
                                                            </div>
                                                        </div>
                                                        <div class="row">
                                                            <div class="col-6 py-2">
                                                                <span>Cantidad</span>
                                                            </div>
                                                            <div class="col-6 py-2 text-truncate">
                                                                 <select class="form-control border-select" ng-model="decimalVenta.nroCantidad">
                                                                    <option ng-value="decimal" ng-repeat="decimal in decimales">
                                                                        {{decimal}}
                                                                    </option>                                    
                                                                </select>
                                                            </div>
                                                        </div>
                                                        <div class="row">
                                                            <div class="col-6 py-2">
                                                                <span>IVA</span>
                                                            </div>
                                                            <div class="col-6 py-2 text-truncate">
                                                                 <select class="form-control border-select" ng-model="decimalVenta.nroIva">
                                                                    <option ng-value="decimal" ng-repeat="decimal in decimales">
                                                                        {{decimal}}
                                                                    </option>                                    
                                                                </select>
                                                            </div>
                                                        </div>

                                                        <div class="row">
                                                            <div class="col-6 py-2">
                                                                <span>Descuento</span>
                                                            </div>
                                                            <div class="col-6 py-2 text-truncate">
                                                                 <select class="form-control border-select" ng-model="decimalVenta.nroDescuento">
                                                                    <option ng-value="decimal" ng-repeat="decimal in decimales">
                                                                        {{decimal}}
                                                                    </option>                                    
                                                                </select>
                                                            </div>
                                                        </div>

                                                        <div class="row">
                                                            <div class="col-6 py-2">
                                                                <span>Descuento Detalle</span>
                                                            </div>
                                                            <div class="col-6 py-2 text-truncate">
                                                                 <select class="form-control border-select" ng-model="decimalVenta.nroDescuentoDetalle">
                                                                    <option ng-value="decimal" ng-repeat="decimal in decimales">
                                                                        {{decimal}}
                                                                    </option>                                    
                                                                </select>
                                                            </div>
                                                        </div>

                                                        <div class="row">
                                                            <div class="col-6 py-2">
                                                                <span>Total Detalle</span>
                                                            </div>
                                                            <div class="col-6 py-2 text-truncate">
                                                                 <select class="form-control border-select" ng-model="decimalVenta.nroTotalDetalle">
                                                                    <option ng-value="decimal" ng-repeat="decimal in decimales">
                                                                        {{decimal}}
                                                                    </option>                                    
                                                                </select>
                                                            </div>
                                                        </div>

                                                        <div class="row">
                                                            <div class="col-6 py-2">
                                                                <span>Totales y SubTotales</span>
                                                            </div>
                                                            <div class="col-6 py-2 text-truncate">
                                                                 <select class="form-control border-select" ng-model="decimalVenta.nroTotalSubTotal">
                                                                    <option ng-value="decimal" ng-repeat="decimal in decimales">
                                                                        {{decimal}}
                                                                    </option>                                    
                                                                </select>
                                                            </div>
                                                        </div>

                                                        <div class="row">
                                                            <div class="col-6 py-2">
                                                                <span>ICE</span>
                                                            </div>
                                                            <div class="col-6 py-2 text-truncate">
                                                                 <select class="form-control border-select" ng-model="decimalVenta.nroIce">
                                                                    <option ng-value="decimal" ng-repeat="decimal in decimales">
                                                                        {{decimal}}
                                                                    </option>                                    
                                                                </select>
                                                            </div>
                                                        </div>

                                                    </div>                                                  
                                                </div>
                                            </div>
                                        </div>  
                                    </div>
                                    <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12">
                                         <div class="card">
                                            <div class="card-header bg-info">
                                                <h6 class="m-b-0 text-white">COMPRAS</h6>                                                
                                            </div>
                                            <div class="card-body shadow">
                                                <div class="row pb-1">
                                                    <div class="col-md-12">
                                                        <div class="row">
                                                            <div class="col-6 py-2">
                                                                <span>Precio</span>
                                                            </div>
                                                            <div class="col-6 py-2 text-truncate">
                                                                 <select class="form-control border-select" ng-model="decimalCompra.nroPrecio">
                                                                    <option ng-value="decimal" ng-repeat="decimal in decimales">
                                                                        {{decimal}}
                                                                    </option>                                    
                                                                </select>
                                                            </div>
                                                        </div>

                                                        <div class="row">
                                                            <div class="col-6 py-2">
                                                                <span>Cantidad</span>
                                                            </div>
                                                            <div class="col-6 py-2 text-truncate">
                                                                 <select class="form-control border-select" ng-model="decimalCompra.nroCantidad">
                                                                    <option ng-value="decimal" ng-repeat="decimal in decimales">
                                                                        {{decimal}}
                                                                    </option>                                    
                                                                </select>
                                                            </div>
                                                        </div>

                                                        <div class="row">
                                                            <div class="col-6 py-2">
                                                                <span>IVA</span>
                                                            </div>
                                                            <div class="col-6 py-2 text-truncate">
                                                                 <select class="form-control border-select" ng-model="decimalCompra.nroIva">
                                                                    <option ng-value="decimal" ng-repeat="decimal in decimales">
                                                                        {{decimal}}
                                                                    </option>                                    
                                                                </select>
                                                            </div>
                                                        </div>

                                                        <div class="row">
                                                            <div class="col-6 py-2">
                                                                <span>Descuento</span>
                                                            </div>
                                                            <div class="col-6 py-2 text-truncate">
                                                                 <select class="form-control border-select" ng-model="decimalCompra.nroDescuento">
                                                                    <option ng-value="decimal" ng-repeat="decimal in decimales">
                                                                        {{decimal}}
                                                                    </option>                                    
                                                                </select>
                                                            </div>
                                                        </div>

                                                        <div class="row">
                                                            <div class="col-6 py-2">
                                                                <span>Descuento Detalle</span>
                                                            </div>
                                                            <div class="col-6 py-2 text-truncate">
                                                                 <select class="form-control border-select" ng-model="decimalCompra.nroDescuentoDetalle">
                                                                    <option ng-value="decimal" ng-repeat="decimal in decimales">
                                                                        {{decimal}}
                                                                    </option>                                    
                                                                </select>
                                                            </div>
                                                        </div>

                                                        <div class="row">
                                                            <div class="col-6 py-2">
                                                                <span>Total Detalle</span>
                                                            </div>
                                                            <div class="col-6 py-2 text-truncate">
                                                                 <select class="form-control border-select" ng-model="decimalCompra.nroTotalDetalle">
                                                                    <option ng-value="decimal" ng-repeat="decimal in decimales">
                                                                        {{decimal}}
                                                                    </option>                                    
                                                                </select>
                                                            </div>
                                                        </div>

                                                        <div class="row">
                                                            <div class="col-6 py-2">
                                                                <span>Totales y SubTotales</span>
                                                            </div>
                                                            <div class="col-6 py-2 text-truncate">
                                                                 <select class="form-control border-select" ng-model="decimalCompra.nroTotalSubTotal">
                                                                    <option ng-value="decimal" ng-repeat="decimal in decimales">
                                                                        {{decimal}}
                                                                    </option>                                    
                                                                </select>
                                                            </div>
                                                        </div>

                                                        <div class="row">
                                                            <div class="col-6 py-2">
                                                                <span>ICE</span>
                                                            </div>
                                                            <div class="col-6 py-2 text-truncate">
                                                                 <select class="form-control border-select" ng-model="decimalCompra.nroIce">
                                                                    <option ng-value="decimal" ng-repeat="decimal in decimales">
                                                                        {{decimal}}
                                                                    </option>                                    
                                                                </select>
                                                            </div>
                                                        </div>

                                                    </div>                                                  
                                                </div>
                                            </div>
                                        </div> 
                                    </div>
                                </div>


                                <div class="row">
                                    <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12">
                                        <div class="card">
                                            <div class="card-header bg-primary">
                                                <h6 class="m-b-0 text-white">ALMACÉN</h6>  
                                            </div>
                                            <div class="card-body shadow">
                                                <div class="row pb-1">
                                                    <div class="col-md-12">
                                                        <div class="row">
                                                            <div class="col-6 py-2">
                                                                <span>Precio</span>
                                                            </div>
                                                            <div class="col-6 py-2 text-truncate">
                                                                 <select class="form-control border-select" ng-model="decimalAlmacen.nroPrecio">
                                                                    <option ng-value="decimal" ng-repeat="decimal in decimales">
                                                                        {{decimal}}
                                                                    </option>                                    
                                                                </select>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <hr>
                                <div class="float-right">
                                    <button type="button" class="btn btn-success" ng-click="updateModuloDecimal()">
                                        <icon class="ti-pencil"></icon> Actualizar
                                    </button>
                                </div>
                            </md-content>

                        </md-tab>
                

                        <md-tab label="COLUMNAS EN DOCUMENTOS">
                            <md-content class="md-padding">
                                <div class="row">
                                    <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12">
                                        <div class="card">
                                            <div class="card-header bg-warning">
                                                <h6 class="m-b-0 text-white">COLUMNAS A MOSTRAR EN DOCUMENTOS DE VENTA</h6>   
                                            </div>
                                            <div class="card-body shadow">                                              
                                                <div class="row pb-1">
                                                    <div class="col-md-12">
                                                        <div class="row">
                                                            <div class="col-6 py-2">
                                                                <span>1. Descuento </span>
                                                            </div>
                                                            <div class="col-6 py-2 text-truncate">
                                                                <div class="icheck-primary text-right">
                                                                    <input type="checkbox" id="showDescuento" ng-model="configDetalle.descuento">
                                                                    <label for="showDescuento"></label>
                                                                </div>
                                                            </div>
                                                        </div> 

                                                        <div class="row">
                                                            <div class="col-6 py-2">
                                                                <span>2. ICE </span>
                                                            </div>
                                                            <div class="col-6 py-2 text-truncate">
                                                                <div class="icheck-primary text-right">
                                                                    <input type="checkbox" id="showIce" ng-model="configDetalle.ice">
                                                                    <label for="showIce"></label>
                                                                </div>
                                                            </div>
                                                        </div>  

                                                        <div class="row">
                                                            <div class="col-6 py-2">
                                                                <span>3. Porcentaje Descuento </span>
                                                            </div>
                                                            <div class="col-6 py-2 text-truncate">
                                                                <div class="icheck-primary text-right">
                                                                    <input type="checkbox" id="showPorcentajeDescuento" ng-model="configDetalle.porcentajeDescuento">
                                                                    <label for="showPorcentajeDescuento"></label>
                                                                </div>
                                                            </div>
                                                        </div>   

                                                        <div class="row">
                                                            <div class="col-6 py-2">
                                                                <span>4. Porcentaje Iva </span>
                                                            </div>
                                                            <div class="col-6 py-2 text-truncate">
                                                                <div class="icheck-primary text-right">
                                                                    <input type="checkbox" id="showPorcentajeIva" ng-model="configDetalle.porcentajeIva">
                                                                    <label for="showPorcentajeIva"></label>
                                                                </div>
                                                            </div>
                                                        </div> 

                                                        <div class="row">
                                                            <div class="col-6 py-2">
                                                                <span>5. Total Descuento </span>
                                                            </div>
                                                            <div class="col-6 py-2 text-truncate">
                                                                <div class="icheck-primary text-right">
                                                                    <input type="checkbox" id="showTotalDescuento" ng-model="configDetalle.totalDescuento">
                                                                    <label for="showTotalDescuento"></label>
                                                                </div>
                                                            </div>
                                                        </div> 

                                                    </div>                                                  
                                                </div>

                                            </div>                                            
                                        </div>
                                    </div>
                                </div>
                                <hr>
                                <div class="float-right">
                                    <button type="button" class="btn btn-success" ng-click="updateConfigShowDetalle()">
                                        <icon class="ti-pencil"></icon> Actualizar
                                    </button>
                                </div>  
                            </md-content>
                        </md-tab>

                        <md-tab label="NOTIFICACIONES">
                            <md-content class="md-padding">
                                <div class="row">                                   
                                    <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12">
                                        <div class="card">
                                            @* <div class="card-header bg-info">
                                                <h6 class="m-b-0 text-white">CONFIGURACIÓN DE INVENTARIO</h6>     
                                            </div> *@
                                            <div class="card-body shadow">
                                                <div class="row pb-1">
                                                    <div class="col-md-12">
                                                        <div class="row" ng-repeat="item in entidadNotificaciones">
                                                            <div class="col-6 py-2">
                                                                <span>{{item.notificacion}}</span>
                                                            </div>
                                                            <div class="col-6 py-2 text-truncate">
                                                                <div class="icheck-primary text-right">
                                                                    <input type="checkbox" id="stockCantidad{{$index}}" ng-model="item.estado">
                                                                    <label for="stockCantidad{{$index}}"></label>
                                                                </div>
                                                            </div>
                                                            <hr>
                                                        </div>                                                        
                                                    </div>                                                  
                                                </div>
                                               
                                            </div>
                                        </div>
                                    </div>
                                </div>  
                                <hr>
                                <div class="float-right">
                                    <button type="button" class="btn btn-success" ng-click="updateNotificacion()">
                                        <icon class="ti-pencil"></icon> Actualizar
                                    </button>
                                </div>                          
                            </md-content>
                        </md-tab>

                    </md-tabs>
                </md-content>
            </div>
        </div>
    </div>   
</div>

@section Scripts{
    <script src="~/js/controllers/config/configGeneralCtrl.js" asp-append-version="true"></script>
    
}