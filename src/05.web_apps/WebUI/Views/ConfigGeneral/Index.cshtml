@{
    ViewData["title"] ="Configuración General";
}

<div ng-controller="configGeneralCtrl">
    <div class="row page-titles">
        <div class="col-md-5 align-self-center">
            <h4 class="text-themecolor">Configuración General</h4>
        </div>
         <div class="col-md-7 align-self-center text-right">
            <div class="d-flex justify-content-end align-items-center">                
                
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12 mb-4">
            <div >
                <md-content>
                    <md-tabs class="md-primary" md-center-tabs md-dynamic-height="">

                        <md-tab label="Ventas" md-on-select="getDataTabs('CV')">
                            <md-content class="md-padding">
                                <div class="row align-items-center">
                                    <div class="col-8 mx-auto">
                                        <div class="card shadow border">
                                            <div class="card-body">
                                                
                                                <div class="row justify-content-between">
                                                    <div class="col-xl-6 col-lg-6 col-md-12 col-sm-12">
                                                        <div class="icheck-success">
                                                            <input type="checkbox" name="cliente" id="cliente" ng-model="gestionSistema.customerDefault">
                                                            <label for="cliente">Cliente</label>
                                                        </div>     
                                                    </div>

                                                    <div class="col-xl-6 col-lg-6 col-md-12 col-sm-12">
                                                        <div ng-if="gestionSistema.customerDefault">
                                                            <md-autocomplete 
                                                                md-input-name="autocompleteField"
                                                                md-input-minlength="1"
                                                                md-input-maxlength="2000"
                                                                md-no-cache="false"
                                                                md-search-text-change="searchTextChange(searchText)"
                                                                md-search-text="searchText"
                                                                md-selected-item-change="selectedItemChangeCliente(item)"
                                                                md-items="item in searchCustomer(searchText)"
                                                                md-item-text="item.nombreFiscal"
                                                                md-escape-options="clear"
                                                                placeholder="Ej: Jorge Ramirez"
                                                                md-clear-button="false"
                                                                input-aria-describedby="Buscar Cliente">
                                                                <md-item-template>
                                                                    <span md-highlight-text="searchText">{{item.nombreFiscal}}</span>
                                                                </md-item-template>                                                           
                                                            </md-autocomplete>
                                                        </div>                  
                                                    </div>
                                                </div> 

                                                <hr>

                                                <div class="row justify-content-between">
                                                    <div class="col-xl-6 col-lg-6 col-md-12 col-sm-12">
                                                        <div class="icheck-success">
                                                            <input type="checkbox" name="articuloDefect" id="articuloDefect" ng-model="gestionSistema.articleDefault">
                                                            <label for="articuloDefect">Artículo</label>
                                                        </div>     
                                                    </div>

                                                    <div class="col-xl-6 col-lg-6 col-md-12 col-sm-12">
                                                        <div ng-if="gestionSistema.articleDefault">
                                                            <md-autocomplete class="md-block mr-10" 
                                                                md-input-name="autocompleteField"
                                                                md-min-length="3"
                                                                md-no-cache="false"
                                                                md-search-text-change="searchTextChangeArticle(searchTextArticle)"
                                                                md-search-text="searchTextArticle"
                                                                md-selected-item-change="selectedItemChangeArticle(item)"
                                                                md-items="item in searchArticle(searchTextArticle)"
                                                                md-item-text="item.descripcion"
                                                                md-escape-options="clear"
                                                                placeholder="Ej: Mouse..."
                                                                md-clear-button="false"
                                                                input-aria-describedby="Buscar Artículo">
                                                                <md-item-template>
                                                                    <span md-highlight-text="searchTextArticle">{{item.descripcion}}</span>
                                                                </md-item-template>  
                                                            </md-autocomplete>                                                                                                            
                                                        </div>
                                                    </div>
                                                </div>

                                                <hr>

                                                <div class="row justify-content-between">
                                                    <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12">
                                                        <div class="icheck-success">
                                                            <input type="checkbox" name="searchBarcode" id="searchBarcode" ng-model="gestionSistema.searchCode">
                                                            <label for="searchBarcode">Búsqueda de artículo por <code>Código de Barra</code> en venta</label>
                                                        </div>     
                                                    </div>

                                                </div>    

                                                <hr>    

                                                <div class="row">
                                                    <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                                        <div class="icheck-success">
                                                            <input type="checkbox" name="printerAutomatic " id="printerAutomatic " ng-model="gestionSistema.printerAutomatic ">
                                                            <label for="printerAutomatic ">Impresión automática en Ventas</label>
                                                        </div>  
                                                    </div>
                                                  
                                                </div>     

                                                <hr>
                                                <div class="row">
                                                    <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                                        <div class="icheck-success">
                                                            <input type="checkbox" name="payAutomatic " id="payAutomatic " ng-model="gestionSistema.payAutomatic ">
                                                            <label for="payAutomatic ">Cobro rápido automático en Ventas</label>
                                                        </div>  
                                                    </div>
                                                </div>    

                                                 <hr>
                                                <div class="row justify-content-between">
                                                    <div class="col-xl-5 col-lg-5 col-md-6 col-sm-12 col-12">
                                                        <div class="icheck-success">
                                                            <input type="checkbox" name="configDeuda" id="configDeuda" ng-model="gestionSistema.configDeuda">
                                                            <label for="configDeuda">Crédito Vencido de Clientes</label>
                                                        </div>  
                                                    </div>
                                                    <div class="col-xl-5 col-lg-5 col-md-6 col-sm-12 col-12" ng-if="gestionSistema.configDeuda">
                                                        <div class="form-group">
                                                            <label for="dias">Porcentaje de Interes</label>
                                                            <input type="text" name="porcentaje" id="porcentaje" valid-number class="form-control border-select" placeholder="20%" ng-model="gestionSistema.porcentajeInteres">
                                                        </div>
                                                          <div class="form-group">
                                                            <label for="dias">Días de Gracia</label>
                                                            <input type="text" name="diasGracia" id="diasGracia" valid-number class="form-control border-select" placeholder="2 días" ng-model="gestionSistema.diasGracia">
                                                        </div>
                                                    </div>                                                   
                                                </div>

                                                <hr>                                                                                      
                                            </div>

                                            <div class="card-footer">
                                                <button type="button" class="btn btn-success float-right" ng-click="save()">
                                                    <i class="ti-save"></i> Guardar
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>                         
                            </md-content>
                        </md-tab>

                        <md-tab label="Inventario" md-on-select="getDataTabs('CI')">
                            <md-content class="md-padding">
                                <div class="row align-items-center">
                                    <div class="col-8 mx-auto">
                                        <div class="card shadow border">
                                            <div class="card-body">
                                                <div class="row justify-content-between">
                                                    <div class="col-xl-6 col-lg-6 col-md-12 col-sm-12">
                                                        <div class="icheck-success">
                                                            <input type="checkbox" name="llevaInventario" id="llevaInventario" ng-model="gestionInventario.llevaInventario">
                                                            <label for="llevaInventario">Control Inventario</label>
                                                        </div>     
                                                    </div>

                                                    <div class="col-xl-6 col-lg-6 col-md-12 col-sm-12">
                                                        <div class="form-group" ng-if="gestionInventario.llevaInventario">
                                                            <select name="metodoValoracion" id="metodoValoracion" class="form-control border-select" ng-model="gestionInventario.idMetodoValoracion">
                                                                <option ng-value="item.idMetodoValoracion" ng-repeat="item in valoracionMetodos">{{item.descripcion}}</option>
                                                            </select>
                                                        </div>
                                                    </div>
                                                </div>                                                                                     
                                            </div>

                                            <div class="card-footer">
                                                <button type="button" class="btn btn-success float-right" ng-click="save()">
                                                    <i class="ti-save"></i> Guardar
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>                         
                            </md-content>
                        </md-tab>

                        <md-tab label="DECIMALES" md-on-select="getDataTabs('CD')">
                            <md-content class="md-padding">
                                <div class="row">
                                    <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12">
                                        <div class="card">
                                            <div class="card-header bg-success">
                                                <h6 class="m-b-0 text-white">VENTAS</h6>     
                                            </div>
                                            <div class="card-body shadow">
                                                <div class="row pb-1">
                                                    <div class="col-md-12">
                                                        <div class="row">
                                                            <div class="col-6 py-2">
                                                                <span>Precio</span>
                                                            </div>
                                                            
                                                            <div class="col-6 py-2 text-truncate">
                                                                 <select class="form-control border-select" ng-model="decimalVenta.nroPrecio">
                                                                    <option ng-value="decimal" ng-repeat="decimal in decimales">
                                                                        {{decimal}}
                                                                    </option>                                    
                                                                </select>
                                                            </div>
                                                        </div>
                                                        <div class="row">
                                                            <div class="col-6 py-2">
                                                                <span>Cantidad</span>
                                                            </div>
                                                            <div class="col-6 py-2 text-truncate">
                                                                 <select class="form-control border-select" ng-model="decimalVenta.nroCantidad">
                                                                    <option ng-value="decimal" ng-repeat="decimal in decimales">
                                                                        {{decimal}}
                                                                    </option>                                    
                                                                </select>
                                                            </div>
                                                        </div>
                                                        <div class="row">
                                                            <div class="col-6 py-2">
                                                                <span>IVA</span>
                                                            </div>
                                                            <div class="col-6 py-2 text-truncate">
                                                                 <select class="form-control border-select" ng-model="decimalVenta.nroIva">
                                                                    <option ng-value="decimal" ng-repeat="decimal in decimales">
                                                                        {{decimal}}
                                                                    </option>                                    
                                                                </select>
                                                            </div>
                                                        </div>

                                                        <div class="row">
                                                            <div class="col-6 py-2">
                                                                <span>Descuento</span>
                                                            </div>
                                                            <div class="col-6 py-2 text-truncate">
                                                                 <select class="form-control border-select" ng-model="decimalVenta.nroDescuento">
                                                                    <option ng-value="decimal" ng-repeat="decimal in decimales">
                                                                        {{decimal}}
                                                                    </option>                                    
                                                                </select>
                                                            </div>
                                                        </div>

                                                        <div class="row">
                                                            <div class="col-6 py-2">
                                                                <span>Descuento Detalle</span>
                                                            </div>
                                                            <div class="col-6 py-2 text-truncate">
                                                                 <select class="form-control border-select" ng-model="decimalVenta.nroDescuentoDetalle">
                                                                    <option ng-value="decimal" ng-repeat="decimal in decimales">
                                                                        {{decimal}}
                                                                    </option>                                    
                                                                </select>
                                                            </div>
                                                        </div>

                                                        <div class="row">
                                                            <div class="col-6 py-2">
                                                                <span>Total Detalle</span>
                                                            </div>
                                                            <div class="col-6 py-2 text-truncate">
                                                                 <select class="form-control border-select" ng-model="decimalVenta.nroTotalDetalle">
                                                                    <option ng-value="decimal" ng-repeat="decimal in decimales">
                                                                        {{decimal}}
                                                                    </option>                                    
                                                                </select>
                                                            </div>
                                                        </div>

                                                        <div class="row">
                                                            <div class="col-6 py-2">
                                                                <span>Totales y SubTotales</span>
                                                            </div>
                                                            <div class="col-6 py-2 text-truncate">
                                                                 <select class="form-control border-select" ng-model="decimalVenta.nroTotalSubTotal">
                                                                    <option ng-value="decimal" ng-repeat="decimal in decimales">
                                                                        {{decimal}}
                                                                    </option>                                    
                                                                </select>
                                                            </div>
                                                        </div>

                                                        <div class="row">
                                                            <div class="col-6 py-2">
                                                                <span>ICE</span>
                                                            </div>
                                                            <div class="col-6 py-2 text-truncate">
                                                                 <select class="form-control border-select" ng-model="decimalVenta.nroIce">
                                                                    <option ng-value="decimal" ng-repeat="decimal in decimales">
                                                                        {{decimal}}
                                                                    </option>                                    
                                                                </select>
                                                            </div>
                                                        </div>

                                                    </div>                                                  
                                                </div>
                                            </div>
                                        </div>  
                                    </div>
                                    <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12">
                                         <div class="card">
                                            <div class="card-header bg-info">
                                                <h6 class="m-b-0 text-white">COMPRAS</h6>                                                
                                            </div>
                                            <div class="card-body shadow">
                                                <div class="row pb-1">
                                                    <div class="col-md-12">
                                                        <div class="row">
                                                            <div class="col-6 py-2">
                                                                <span>Precio</span>
                                                            </div>
                                                            <div class="col-6 py-2 text-truncate">
                                                                 <select class="form-control border-select" ng-model="decimalCompra.nroPrecio">
                                                                    <option ng-value="decimal" ng-repeat="decimal in decimales">
                                                                        {{decimal}}
                                                                    </option>                                    
                                                                </select>
                                                            </div>
                                                        </div>

                                                        <div class="row">
                                                            <div class="col-6 py-2">
                                                                <span>Cantidad</span>
                                                            </div>
                                                            <div class="col-6 py-2 text-truncate">
                                                                 <select class="form-control border-select" ng-model="decimalCompra.nroCantidad">
                                                                    <option ng-value="decimal" ng-repeat="decimal in decimales">
                                                                        {{decimal}}
                                                                    </option>                                    
                                                                </select>
                                                            </div>
                                                        </div>

                                                        <div class="row">
                                                            <div class="col-6 py-2">
                                                                <span>IVA</span>
                                                            </div>
                                                            <div class="col-6 py-2 text-truncate">
                                                                 <select class="form-control border-select" ng-model="decimalCompra.nroIva">
                                                                    <option ng-value="decimal" ng-repeat="decimal in decimales">
                                                                        {{decimal}}
                                                                    </option>                                    
                                                                </select>
                                                            </div>
                                                        </div>

                                                        <div class="row">
                                                            <div class="col-6 py-2">
                                                                <span>Descuento</span>
                                                            </div>
                                                            <div class="col-6 py-2 text-truncate">
                                                                 <select class="form-control border-select" ng-model="decimalCompra.nroDescuento">
                                                                    <option ng-value="decimal" ng-repeat="decimal in decimales">
                                                                        {{decimal}}
                                                                    </option>                                    
                                                                </select>
                                                            </div>
                                                        </div>

                                                        <div class="row">
                                                            <div class="col-6 py-2">
                                                                <span>Descuento Detalle</span>
                                                            </div>
                                                            <div class="col-6 py-2 text-truncate">
                                                                 <select class="form-control border-select" ng-model="decimalCompra.nroDescuentoDetalle">
                                                                    <option ng-value="decimal" ng-repeat="decimal in decimales">
                                                                        {{decimal}}
                                                                    </option>                                    
                                                                </select>
                                                            </div>
                                                        </div>

                                                        <div class="row">
                                                            <div class="col-6 py-2">
                                                                <span>Total Detalle</span>
                                                            </div>
                                                            <div class="col-6 py-2 text-truncate">
                                                                 <select class="form-control border-select" ng-model="decimalCompra.nroTotalDetalle">
                                                                    <option ng-value="decimal" ng-repeat="decimal in decimales">
                                                                        {{decimal}}
                                                                    </option>                                    
                                                                </select>
                                                            </div>
                                                        </div>

                                                        <div class="row">
                                                            <div class="col-6 py-2">
                                                                <span>Totales y SubTotales</span>
                                                            </div>
                                                            <div class="col-6 py-2 text-truncate">
                                                                 <select class="form-control border-select" ng-model="decimalCompra.nroTotalSubTotal">
                                                                    <option ng-value="decimal" ng-repeat="decimal in decimales">
                                                                        {{decimal}}
                                                                    </option>                                    
                                                                </select>
                                                            </div>
                                                        </div>

                                                        <div class="row">
                                                            <div class="col-6 py-2">
                                                                <span>ICE</span>
                                                            </div>
                                                            <div class="col-6 py-2 text-truncate">
                                                                 <select class="form-control border-select" ng-model="decimalCompra.nroIce">
                                                                    <option ng-value="decimal" ng-repeat="decimal in decimales">
                                                                        {{decimal}}
                                                                    </option>                                    
                                                                </select>
                                                            </div>
                                                        </div>

                                                    </div>                                                  
                                                </div>
                                            </div>
                                        </div> 
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12">
                                        <div class="card">
                                            <div class="card-header bg-primary">
                                                <h6 class="m-b-0 text-white">ALMACÉN</h6>  
                                            </div>
                                            <div class="card-body shadow">
                                                <div class="row pb-1">
                                                    <div class="col-md-12">
                                                        <div class="row">
                                                            <div class="col-6 py-2">
                                                                <span>Precio</span>
                                                            </div>
                                                            <div class="col-6 py-2 text-truncate">
                                                                 <select class="form-control border-select" ng-model="decimalAlmacen.nroPrecio">
                                                                    <option ng-value="decimal" ng-repeat="decimal in decimales">
                                                                        {{decimal}}
                                                                    </option>                                    
                                                                </select>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <hr>
                                <div class="float-right">
                                    <button type="button" class="btn btn-success" ng-click="save()">
                                        <icon class="ti-pencil"></icon> Actualizar
                                    </button>
                                </div>
                            </md-content>

                        </md-tab>

                        <md-tab label="NOTIFICACIONES" md-on-select="getDataTabs('CS')">
                            <md-content class="md-padding">
                                <div class="row">                                   
                                    <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12">
                                        <div class="card">
                                            <div class="card-body shadow">
                                                <div class="row pb-1">
                                                    <div class="col-md-12">
                                                        <div class="row" ng-repeat="item in entidadNotificaciones">
                                                            <div class="col-6 py-2">
                                                                <span>{{item.notificacion}}</span>
                                                            </div>
                                                            <div class="col-6 py-2 text-truncate">
                                                                <div class="icheck-primary text-right">
                                                                    <input type="checkbox" id="stockCantidad{{$index}}" ng-model="item.estado">
                                                                    <label for="stockCantidad{{$index}}"></label>
                                                                </div>
                                                            </div>
                                                            <hr>
                                                        </div>                                                        
                                                    </div>                                                  
                                                </div>
                                               
                                            </div>
                                        </div>
                                    </div>
                                </div>  
                                <hr>
                                <div class="float-right">
                                    <button type="button" class="btn btn-success" ng-click="save()">
                                        <icon class="ti-pencil"></icon> Actualizar
                                    </button>
                                </div>                          
                            </md-content>
                        </md-tab>

                    </md-tabs>
                </md-content>
            </div>
        </div>
    </div>   
</div>

@section Scripts{
    <script src="~/js/config/controllers/configGeneralCtrl.min.js" asp-append-version="true"></script>
    
}