
@{
    ViewData["Title"] = "Index";
}
<div ng-controller="articuloComposicionCtrl">

    <div class="row page-titles">
        <div class="col-md-5 align-self-center">
            <h4 class="text-themecolor">Gestión de Composición Articulo</h4>
        </div>
        <div class="col-md-7 align-self-center text-right">
            <div class="d-flex justify-content-end align-items-center">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="javascript:void(0)">Inicio</a></li>
                    <li class="breadcrumb-item active">Composición Articulo</li>
                </ol>
                <button type="button" class="btn btn-outline-info btn-rounded m-l-15" ng-click="showFormulario(1)"><i class="fa fa-plus-circle"></i> Agregar</button>
            </div>
        </div>
    </div>
    <div class="row" style="display:none" id="formArticuloCompuesto">
        <div class="col-sm-12">
            <div class="card">
                <div class="card-header bg-cyan">
                    <h4 class="m-b-0 text-white">Composición Articulo</h4>
                </div>
                <form ng-submit="crudArticuloCompuesto(data.tipoOperacion)" novalidate autocomplete="off">
                    <div class="card-body">                                             
                        <div class="row">
                            <div class="col-lg-12">
                                <div class="form-group">
                                    <label class="form-control-label">Buscar Articulo Compuesto</label>
                                    <div class="input-group mb-3">
                                        <input type="text" id="articuloCompuesto" class="form-control" ng-model="art"
                                               uib-typeahead="a as  (a.articulo.codigo +' - ' + a.articulo.descripcion) for a in articuloCompuestos | filter:$viewValue | limitTo:5 "
                                               typeahead-editable="false" placeholder="Ingrese el Código o el nombre del Artículo " autocomplete="off"
                                               ng-required="true"
                                               typeahead-no-results="noResults"
                                               typeahead-on-select="selectArticuloCompuesto($item)">                                        
                                        <div class="input-group-append">
                                            <span class="input-group-text"><i class="ti-search"></i></span>
                                        </div>
                                    </div>
                                    <div ng-show="noResults" class="text-info">
                                        <i class="fas fa-times"></i> No se han encontrado resultados
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-lg-6 col-md-6 col-sm-6">
                                <div class="form-group">
                                    <label class="form-control-label">Código Articulo</label>
                                    <div class="input-group mb-3">
                                        <input type="text" class="form-control" ng-value="articuloCompuesto.codigo" ng-disabled="true" placeholder="Código Articulo">
                                        <div class="input-group-append">
                                            <span class="input-group-text"><i class=" ti-layout-cta-left"></i></span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-6 col-md-6 col-sm-6">
                                <div class="form-group">
                                    <label class="form-control-label">Precio Costo</label>
                                    <div class="input-group mb-3">
                                        <input type="text" class="form-control" ng-value="articuloCompuesto.precioCosto | currency:'$'" ng-disabled="true" placeholder="0.00">
                                        <div class="input-group-append">
                                            <span class="input-group-text">$</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-lg-3 col-md-3 col-sm-3 col-xs-3">
                                <div class="form-group">
                                    <label class="form-control-label">Tarifa:</label>
                                    <div class="input-group mb-3">
                                        <select class="form-control">
                                            <option value="" selected disabled>Seleccionar Tarifa</option>
                                        </select>
                                        <div class="input-group-append">
                                            <span class="input-group-text"><i class="ti-list-ol"></i></span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-3 col-md-3 col-sm-3 col-xs-3">
                                <div class="form-group">
                                    <label class="form-control-label">Precio Venta:</label>
                                    <div class="input-group mb-3">
                                        <input type="text" class="form-control" ng-model="articuloFraccionado.conversion" valid-number placeholder="0.00">
                                        <div class="input-group-append">
                                            <span class="input-group-text">$</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-3 col-md-3 col-sm-3 col-xs-3">
                                <div class="form-group">
                                    <label class="form-control-label">P.V.P:</label>
                                    <div class="input-group mb-3">
                                        <input type="text" class="form-control" ng-model="a" valid-number value="" />
                                        <div class="input-group-append">
                                            <span class="input-group-text">$</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-3 col-md-3 col-sm-3 col-xs-3">
                                <label class="form-control-label">¿Imprimir detalle del Articulo?</label>
                                <div class="form-group text-center">
                                    <div class="icheck-primary icheck-inline">
                                        <input type="checkbox" id="chb1" />
                                        <label for="chb1"></label>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-lg-12 col-md-12 col-sm-12">
                                <button type="button" class="btn btn-danger btn-rounded" ng-click="addItem()" ng-show="articuloCompuesto.idArticulo"><i class="fa fa-plus-circle"></i> Nuevo</button>                                                                                                
                            </div>                            
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                <div class="table-responsive m-t-10">
                                    <div id="grid1" ui-grid="gridOptions" ui-grid-edit  ui-grid-auto-resize  ui-grid-resize-columns class="grid"></div>
                                </div>
                            </div>
                        </div>
                        <br />
                        <button type="submit" class="btn btn-success btn-rounded mr-2"><i class="fa fa-check"></i> Guadar</button>
                        <button type="button" class="btn btn-dark btn-rounded" ng-click="cerrarFormulario()"><i class="ti-close"></i> Cancel</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="row" id="tablaComposicionArticulo">
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <div class="row">
                        <div class="col-lg-9">
                            <span class="form-group pull-left page-size form-inline">
                                <select class="form-control control-color"
                                        ng-model="pageSize"
                                        ng-change="changePageSize()"
                                        ng-options="ra for ra in recordsQuantity">
                                </select>
                            </span>
                        </div>
                        <div class="col-lg-3">
                            <input type="text" class="form-control" ng-model="buscar" placeholder="Buscar artículos" />
                        </div>
                    </div>
                    <div class="table-responsive">
                        <table class="table  table-bordered table-striped">
                            <thead>
                                <tr>
                                    <th>N°</th>
                                    <th>Artículo Compuesto</th>
                                    <th>PvP</th>
                                    <th>Cantidad Detalle</th>
                                    <th>Imprimir Detalle</th>
                                    <th>Estado</th>
                                    <th>Acción</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="ca in composicionArticulos">
                                    <td>{{$index+1}}</td>
                                    <td>{{ca.articulo.descripcion}}</td>
                                    <td>{{ca.pvp.precioVenta|currency:'$'}}</td>
                                    <td>{{ca.composicionArticulo.cantidadDetalle}}</td>
                                    <td ng-bind-html="ca.composicionArticulo.imprimirDetalle|sino"></td>
                                    <td ng-bind-html="ca.composicionArticulo.estado | estadoPrimario"></td>
                                    <td>                                        
                                        <a class="text-success" ng-click="abrirModal(ca,2)" href="javascript:;" title="Editar"><i class="fa fa-edit"></i></a>
                                        <a class="text-danger" ng-click="deleteArticuloCompuesto(ca)" href="javascript:;" title="Eliminar"><i class="fa fa-trash"></i></a>
                                    </td>
                                </tr>
                                <tr class="text-center" ng-show="composicionArticulos.length==0">
                                    <td colspan="7">
                                        No hay registros en esta tabla :)
                                    </td>
                                </tr>
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td align="center" colspan="8">
                                        <div class="pull-left">
                                            <ul uib-pagination total-items="totalRecords" items-Per-Page="pageSize" ng-change="pagechanged()" ng-model="pageIndex" max-size="maxSize" class="pagination" boundary-links="true" rotate="false"></ul>
                                        </div>
                                    </td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>

            <div id="agregar" class="modal fade in" tabindex="-1" role="dialog" aria-labelledby="composicion" data-backdrop="static" data-keyboard="false">
                <div class="modal-dialog modal-xl" role="document">
                    <div class="modal-content">
                        <form ng-submit="crudArticuloCompuesto(data.tipoOperacion)">
                            <div class="modal-header {{colorHeader}}">
                                <h5 class="modal-title text-white"><i class="{{iconoModal}}"></i> {{tituloModal}}</h5>
                                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                    <span aria-hidden="true">&times;</span>
                                </button>
                            </div>
                            <div class="modal-body">
                                <div class="row">
                                    <div class="col-lg-12 col-md-12 col-sm-7 col-xs-7">
                                        <div class="row">
                                            <div class="col-lg-6 col-md-6 col-sm-6">
                                                <div class="form-group">
                                                    <label>Seleccionar Articulo Compuesto:</label>

                                                    @*<input type="text" name="firstName" ng-model="art.descripcion" typeahead-on-select="selectTypeAhead($item)"
                                                               uib-typeahead="art.articulo.descripcion for art in articuloCompuestos | filter:$viewValue" typeahead-loading="loading" typeahead-no-results="noResults" class="form-control input-sm" autocomplete="off">
                                                        <i ng-show="loading" class="glyphicon glyphicon-refresh"></i>
                                                        <div ng-show="noResults">
                                                            <i class="glyphicon glyphicon-remove"></i> No se han encontrado resultados
                                                        </div>*@

                                                    <select ng-model="articuloCompuesto" class="form-control"
                                                            ng-options="a as a.articulo.descripcion for a in articuloCompuestos track by a.articulo.idArticulo">
                                                    </select>
                                                </div>
                                            </div>
                                            <div class="col-lg-3 col-md-3 col-sm-3">
                                                <div class="form-group">
                                                    <label>Código</label>
                                                    <input type="text" ng-disabled="true" class="form-control"
                                                           ng-model="articuloCompuesto.articulo.codigo" placeholder="0.00" />
                                                </div>
                                            </div>
                                            <div class="col-lg-3 col-md-3 col-sm-3">
                                                <div class="form-group">
                                                    <label>Precio Costo:</label>
                                                    <input type="text" ng-disabled="true" class="form-control"
                                                           ng-model="articuloCompuesto.articuloPvP.precioCosto" placeholder="0.00" />
                                                </div>
                                            </div>
                                        </div>
                                        <div class="row">
                                            <div class="col-lg-4">
                                                <div class="form-group">
                                                    <label>Tarifa: <span class="text-danger">*</span></label>
                                                    <select class="form-control" ng-model="pvpArtCompuesto" ng-disabled="campoArticulo"
                                                            ng-options="t as t.articuloPvP.descripcion for t in pvpArtCompuestos track by t.articuloPvP.idArticuloPvP">
                                                    </select>
                                                </div>
                                            </div>
                                            <div class="col-lg-4">
                                                <div class="form-group">
                                                    <label>P. Venta: </label>
                                                    <input type="text" ng-model="pvpArtCompuesto.articuloPvP.precioVenta"
                                                           class="form-control" ng-disabled="true" />
                                                </div>
                                            </div>
                                            <div class="col-lg-4">
                                                <div class="form-group">
                                                    <label>PvP: </label>
                                                    <input type="text" ng-model="precioVenta" valid-number class="form-control" placeholder="0.00" />
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <hr />
                                <div class="row">
                                    <div class="col-lg-3">
                                        <div class="form-group">
                                            <label>Artículo Simple</label>
                                            <select class="form-control" ng-model="articuloDetalle"
                                                    ng-disabled="campoArticulo" ng-options="a as a.articulo.descripcion for a in articuloSimples track by a.articulo.idArticulo" ng-change="seleccionarArticuloSimple(articuloSimple)">
                                            </select>
                                        </div>
                                    </div>
                                    <div class="col-lg-3">
                                        <div class="form-group">
                                            <label class="tarifa">Tarifa</label>
                                            <select class="form-control" ng-model="articuloPvPDetalle"
                                                    ng-options="p as p.articuloPvP.descripcion for p in pvpArtSimples track by p.articuloPvP.idArticuloPvP">
                                            </select>
                                        </div>
                                    </div>
                                    <div class="col-lg-2">
                                        <div class="form-group">
                                            <label class="cantidad">Cantidad</label>
                                            <input type="text" class="form-control" ng-model="composicionArticuloDetalle.cantidad"
                                                   ng-change="subTotal(composicionArticuloDetalle)" ng-disabled="pvpCampos" valid-number placeholder="0.00" />
                                        </div>
                                    </div>
                                    <div class="col-lg-2">
                                        <div class="form-group">
                                            <label class="precionVenta">Precio Venta</label>
                                            <input type="text" class="form-control" ng-model="composicionArticuloDetalle.precioVenta"
                                                   ng-change="subTotal(composicionArticuloDetalle)" ng-disabled="pvpCampos" valid-number placeholder="0.00" />
                                        </div>
                                    </div>
                                    <div class="col-lg-2">
                                        <label class="total">Total</label>
                                        <div class="form-group">
                                            <div class="input-group">
                                                <input type="text" class="form-control" ng-model="total" ng-disabled="true" valid-number placeholder="0.00" />
                                                <div class="input-group-append">
                                                    <button class="btn btn-success btn-sm" type="button" ng-disabled="pvpCampos"
                                                            ng-click="addItem()">
                                                        <i class="fa fa-plus"></i>
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="table-responsive">
                                    <div id="grid1" ui-grid="gridOptions" 
                                         ui-grid-edit 
                                         ui-grid-resize-columns
                                         ui-grid-auto-resize 
                                         class="grid"></div>
                                </div>
                                <div class="col-md-12">
                                    <div class="row">
                                        <div class="col-md-6">
                                            <div class="pull-left  m-t-30 text-left">
                                                <label>¿Imprimir detalle del Articulo ?</label>
                                                <div class="custom-control custom-switch">
                                                    <input type="checkbox" ng-model="composicionArticulo.imprimirDetalle" class="custom-control-input" id="customSwitch1">
                                                    <label class="custom-control-label" for="customSwitch1"></label>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="clearfix"></div>
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="submit" class="btn btn-success"><i class="{{icono}}"></i>{{btnModal}}</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>




        </div>
    </div>
</div>
@section Scripts{
    <script src="~/js/controllers/almacen/articuloComposicionCtrl.js"></script>
    <script src="~/js/factories/articuloService.min.js" asp-append-version="true"></script>

    <script type="text/ng-template" id="articuloTemplate.html">
        <div style="height:100%">
            <input ng-class="'colt' + col.uid" type="text" id="articulo" class="form-control" ng-model="articuloSimple"
                   uib-typeahead="a as  (a.articulo.codigo +' - ' + a.articulo.descripcion) for a in grid.appScope.articuloSimples | filter:$viewValue | limitTo:5 "
                   typeahead-editable="true" placeholder="Buscar Articulo simple" autocomplete="off"
                   ng-required="false" 
                   typeahead-no-results="grid.appScope.noResultsArticulo"
                   typeahead-on-select="grid.appScope.selectArticuloSimple(row.entity, $item)">
        </div>
    </script>
}

