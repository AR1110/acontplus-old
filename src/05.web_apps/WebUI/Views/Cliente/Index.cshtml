@{
    ViewData["title"] = "Cliente";
}


<div ng-controller="clienteCtrl">
    <div class="row page-titles">
        <div class="col-lg-5 align-self-center">
            <h5 class="text-themecolor">Gestión de Clientes</h5>
        </div>
        <div class="col-lg-7 alig-self-center text-right">
            <div class="d-flex justify-content-end align-items-center">
                <button type="button" class="btn btn-info m-l-15" 
                        ng-if="accion.leer && accion.crear" 
                        ng-click="openModal()"><i class="fa fa-plus-circle"></i> Nuevo</button> 
                        @* <button type="button" class="btn btn-info m-l-15" 
                        ng-if="accion.leer && accion.crear" 
                        ng-click="nuevoCliente()"><i class="fa fa-plus-circle"></i> Nuevo</button> *@
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <md-toolbar class="md-table-toolbar md-default">
                    <div class="md-toolbar-tools">
                        <div class="col-lg-9 col-md-9 col-sm-9 m-t-20">                            
                        </div>
                        <div class="col-lg-3 col-md-3 col-sm-3">
                            <form class="form-material" autocomplete="off">
                                <div class="input-group">
                                    <input type="text" class="form-control" id="searchCliente" ng-model="dataSearch.bySearch" ng-keyup="onKeyupSearchCliente()" placeholder="Buscar Cliente" />
                                    <div class="input-group-append" uib-tooltip="Recargar la tabla" tooltip-placement="top">
                                        <button type="button" class="btn btn-info" ng-click="resetList()">
                                            <i class="fas fa-undo"></i> 
                                        </button>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                </md-toolbar>

                <md-table-container md-scroll-y layout-fill style=" max-height: 400px;">
                    <table md-table>
                        <thead md-head fix-head>
                            <tr md-row>                
                                <th md-column ng-if="accion.editar || accion.eliminar">Op.</th>               
                                <th md-column>N°</th>
                                <th md-column>RUC</th>
                                <th md-column>Nombre Fiscal</th>
                                <th md-column>Dirección</th>
                                <th md-column>Teléfono</th>
                                <th md-column>Estado</th> 
                            </tr>
                        </thead>
                        <tbody md-body>
                            <tr md-row ng-repeat="c in clientes">                                
                                <td md-cell ng-if="accion.editar || accion.eliminar">
                                    <div layout="row" layout-align="start center">                                        
                                        <button class="btn btn-info btn-xs" ng-if="accion.editar" ng-click="openModal(c)">
                                            <i class="ti-pencil"></i>
                                        </button> 
                                        <button class="btn btn-danger btn-xs ml-2" ng-if="c.estado" ng-if="accion.eliminar" ng-click="eliminarCliente(c)">
                                            <i class="fas fa-user-times"></i>
                                        </button>
                                    </div>
                                </td> 
                                <td md-cell>{{$index+1}}</td>
                                <td md-cell>{{c.numeroIdentificacion}}</td>
                                <td md-cell><a href="javascript:void(0)" class="text-primary" ng-click="abrirModal(c,3)">{{c.nombreFiscal}}</a></td>
                                <td md-cell>{{c.direccion}}</td>
                                <td md-cell>{{c.telefono}}</td>
                                <td md-cell ng-bind-html="c.estado|estadoPrimario"></td>                               
                            </tr>
                            <tr ng-show="clientes.length==0" class="text-center">
                                <td colspan="7">
                                    No hay registros en esta tabla :)
                                </td>
                            </tr>
                        </tbody>
                        <tfoot>
                            <tr>
                                <td align="center" colspan="7">
                                    <div class="pull-left m-t-10">
                                        @* <md-table-pagination md-limit="query.limit" md-limit-options="recordsQuantity" md-page="query.page" md-total="{{totalRecords}}" md-boundary-links="options.boundaryLinks" md-on-paginate="logPagination"></md-table-pagination> *@
                                        @*<ul uib-pagination total-items="totalRecords" items-Per-Page="pageSize" ng-change="pagechanged()" ng-model="pageIndex" max-size="maxSize" class="pagination" boundary-links="true" rotate="false"></ul>*@
                                    </div>
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                </md-table-container>
            </div>
        </div>
    </div>    
</div>

@section Scripts{ 
    <script src="~/lib/jsbarcode/JsBarcode.all.min.js"></script>
    <script src="~/lib/html2canvas/html2canvas.min.js"></script>
    <script src="~/js/controllers/ventas/clienteCtrl.min.js" asp-append-version="true"></script>            
}
