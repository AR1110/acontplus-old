<form autocomplete="off">
    <div class="modal-header">
        <h5 class="modal-title">{{$ctrl.tipoRegistro===1?'Nuevo':'Editar'}} Cliente</h5>
        <button type="button" class="close" ng-click="$ctrl.closeModal()">&times;</button>
    </div>

    <div class="modal-body">
        <uib-tabset active="0">
            <uib-tab index="0">
                <uib-tab-heading>
                    <i class="mdi mdi-account-circle"></i> Datos Generales
                </uib-tab-heading>
                <div class="card">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-xl-6 col-lg-6 col-md-6 col-sm-12 col-xs-12">
                                <div class="form-group">
                                    <label for="">Tipo Identificación: <span class="text-danger">*</span> </label>
                                    <div class="input-group">
                                        <div class="input-group-prepend">
                                            <select class="form-control border-select"
                                                ng-model="$ctrl.data.idTipoIdentificacion"
                                                ng-change="$ctrl.onChangeTipoIdentificacion()" name="tipoDocumento"
                                                ng-model="$ctrl.data.idTipoIdentificacion"
                                                ng-disabled="$ctrl.isDisableSelectIdentificacion">
                                                <option ng-value="ti.idTipoIdentificacion"
                                                    ng-repeat="ti in $ctrl.tipoIdentificaciones">{{ti.identificacion}}</option>
                                            </select>
                                        </div>
                                        <input type="text" class="form-control border-select" name="numeroIdentificacion"
                                                    id="numeroIdentificacion" ng-if="$ctrl.data.codigoIdentificacion!=='P'"
                                                    ng-class="$ctrl.typeNotify" ng-model="$ctrl.data.numeroIdentificacion"
                                                    ng-keyup="$ctrl.validarNumeroIdentificacion()"
                                                    ng-disabled="$ctrl.isDisableInputIdentificacion" valid-number
                                                    placeholder="Ej: 2105234568">

                                        <input type="text" class="form-control border-select" ng-if="$ctrl.data.codigoIdentificacion=='P'"
                                                name="pasaporte" ng-model="$ctrl.data.numeroIdentificacion"
                                                ng-disabled="$ctrl.isDisableInputIdentificacion" placeholder="Ej: EH123457">
                        
                                        @* <div class="input-group-append">
                                            <div ng-if="$ctrl.data.codigoIdentificacion!=='P'" class="input-group-text" uib-tooltip="Validar Nro. Identificación" tooltip-placement="top">
                                                <input type="checkbox" aria-label="validationRucSRI" ng-change="$ctrl.onChangeValidateIdentificacionSRI()" ng-model="$ctrl.validationIdentificacionSri">
                                            </div>
                                        </div> *@
                                        
                                        <small class="invalid-feedback text-right">{{$ctrl.message}} </small>
                                        <small class="valid-feedback text-right">{{$ctrl.message}} </small>
                                    </div>
                                </div>                                
                            </div>
                            <div class="col-xl-6 col-lg-6 col-md-6 col-sm-12 col-xs-12">
                                <div class="form-group">
                                    <label>Nombre Fiscal: <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control border-select" name="nombreFiscal"
                                        id="nombreComercial" ng-keyup="$ctrl.copiarNombreComercial()" touppercase
                                        autocomplete="off" ng-model="$ctrl.data.nombreFiscal" ng-disabled="$ctrl.data.validationSri"
                                        placeholder="Ej: TECNOMEGA" />
                                </div>                               
                            </div>
                        </div>
                       
                        <div class="row">
                            <div class="col-xl-6 col-md-6 col-sm-6 col-xs-12">
                                <div class="form-group">
                                    <label>Email:
                                        <span tooltip-placement="top"
                                            uib-tooltip="Haz doble 'Click' sobre el correo para editar">
                                            <i class="fas fa-info-circle"></i>
                                        </span>
                                    </label>
                                    <md-chips ng-model="$ctrl.correos" md-add-on-blur="true"
                                        ng-keyup="$ctrl.onKeyupEmail($event)"
                                        md-transform-chip="$ctrl.transformChipEmail($chip)" md-removable="true"
                                        md-enable-chip-edit="true" placeholder="Ej: maxi@gmail.com"
                                        input-aria-label="Correos"></md-chips>
                                    <small></small>
                                </div>
                            </div>
                            <div class="col-xl-6 col-md-6 col-sm-6 col-xs-12">
                                <div class="form-group">
                                    <label>Telefono:
                                        <span tooltip-placement="top"
                                            uib-tooltip="Haz doble 'Click' sobre el número de telefono para editar">
                                            <i class="fas fa-info-circle"></i>
                                        </span>
                                    </label>
                                    <md-chips ng-model="$ctrl.telefonos" md-add-on-blur="true"
                                        md-transform-chip="$ctrl.transformChip($chip)" md-removable="true"
                                        md-enable-chip-edit="true" placeholder="Ej: 0959889744"
                                        input-aria-label="Número de teléfonos"></md-chips>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                <div class="form-group">
                                    <label>Dirección</label>
                                    @* <textarea class="form-control border-select" touppercase ng-model="$ctrl.data.direccion"
                                        rows="0" placeholder="Av. 09 de Octubre..."></textarea> *@
                                        <input type="text" class="form-control border-select" ng-model="$ctrl.data.direccion" touppercase placeholder="AV. 09 DE OCTUBRE..." ng-disabled="$ctrl.data.validationSri">
                                </div>
                            </div>
                        </div>

                        <div class="row" ng-if="$ctrl.showEstado">
                            <div class="col-lg-4 col-md-6 col-sm-12 col-xs-12">
                                <div class="form-group">
                                    <label for="">Estado</label>
                                    <md-radio-group ng-model="$ctrl.data.estado" tabindex="-1">
                                        <md-radio-button ng-value="true">Activo</md-radio-button>
                                        <md-radio-button ng-value="false">Inactivo</md-radio-button>
                                    </md-radio-group>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </uib-tab>

            <uib-tab index="1">
                <uib-tab-heading>
                    <i class="mdi mdi-note-plus-outline"></i> Adicionales
                </uib-tab-heading>
                <div class="card">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-lg-4 col-md-4 col-sm-12 col-xs-12">
                                <div class="form-group">
                                    <label>Nombre Comercial <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control border-select" autocomplete="off"
                                        ng-model="$ctrl.data.nombreComercial" touppercase placeholder="Ej: TECNOMEGA" />
                                </div>
                            </div>

                            <div class="col-lg-4 col-md-4 col-sm-12 col-xs-12">
                                <div class="form-group">
                                    <label>Contribuyente <span class="text-danger">*</span></label>
                                    <select class="form-control border-select" ng-model="$ctrl.data.idSubContribuyente"
                                        required="required"
                                        ng-options="sc.subContribuyente.idSubContribuyente as sc.subContribuyente.descripcion group by sc.tipoContribuyente.descripcion for sc in $ctrl.subContribuyentes ">
                                    </select>
                                </div> 
                            </div>   

                            <div class="col-lg-4 col-md-4 col-sm-12 col-xs-12">
                                <div class="form-group">
                                    <label>Tiempo de Credito </label>
                                    <div class="input-group">
                                        <select class="form-control border-select" ng-model="$ctrl.data.idTiempoCredito">
                                            <option ng-value="item.idTiempoCredito"
                                                ng-repeat="item in $ctrl.tiempoCreditos">{{item.descripcion}}</option>
                                        </select>
                                        <div class="input-group-append">
                                            <button type="button" class="btn btn-outline-secondary btn-sm"
                                                ng-click="getTiempoCredito()"><i class="fa fa-sync fa-xs"></i></button>
                                        </div>
                                    </div>
                                </div>
                            </div>                         
                        </div>


                        <div class="row">
                            <div class="col-xl-4 col-lg-4 col-md-6 col-sm-6 col-xs-12">
                                <div class="form-group">
                                    <label>Ciudad: </label>
                                    <select class="form-control border-select" ng-model="$ctrl.data.idCiudad"
                                        ng-options="cp.idCiudad as cp.descripcion group by cp.provincia.descripcion for cp in $ctrl.ciudadPronvincias">
                                    </select>
                                </div>
                            </div>

                            <div class="col-xl-4 col-lg-4 col-md-6 col-sm-6 col-xs-12">
                                <div class="form-group">
                                    <label>Tipo Cliente: </label>
                                    <select class="form-control border-select"
                                        ng-model="$ctrl.data.idTipoClienteProveedor">
                                        <option ng-value="item.idTipoClienteProveedor"
                                            ng-repeat="item in $ctrl.tipoClientes">{{item.descripcion}}</option>
                                    </select>
                                </div>
                            </div>

                            <div class="col-xl-4 col-lg-4 col-md-6 col-sm-6 col-xs-12">
                                <div class="form-group">
                                    <label for="">Empresa</label>
                                    <div class="input-group">
                                        <select ng-model="$ctrl.data.idEmpresa" class="form-control border-select">
                                            <option ng-value=""></option>
                                            <option ng-value="item.idEmpresa" ng-repeat="item in $ctrl.empresas">
                                                {{item.razonSocial}}</option>
                                        </select>
                                        <div class="input-group-append">
                                            <button type="button" tabindex="-1" class="btn btn-outline-secondary btn-sm"
                                                ng-click="$ctrl.openModalEmpresa()"><i
                                                    class="fa fa-plus fa-xs"></i></button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-xl-4 col-lg-4 col-md-6 col-sm-6 col-xs-12">
                                <div class="form-group">
                                    <label for="empleado">Empleado</label>
                                    <div class="input-group">
                                        <input type="text" id="clienteAutocomplete" autocomplete="off"
                                            name="empleadoAutocomplete" class="form-control border-select"
                                            placeholder="Buscar Empleado" ng-model="$ctrl.selectedEmpleado"
                                            ng-keyup="$ctrl.onKeyupSearchEmpleado(selectedEmpleado)"
                                            uib-typeahead="a as a.nombreCompleto for a in $ctrl.searchEmpleadoFilter($viewValue)"
                                            typeahead-loading="loadingLocations"
                                            typeahead-no-results="$ctrl.data.noResults"
                                            typeahead-template-url="autocompleteEmpleado.html"
                                            typeahead-editable="false"
                                            typeahead-on-select="$ctrl.selectedEmpleadoChange($item)" onClick="select();" />

                                        <script type="text/ng-template" id="autocompleteEmpleado.html">
                                                    <div class="autocomplete-suggestion-cliente">
                                                        <span class="item-title">
                                                            {{match.model.nombreCompleto}}
                                                        </span>
                                                    </div>
                                                </script>
                                        <div class="input-group-append">
                                            <button type="button" tabindex="-1" class="btn btn-outline-secondary btn-sm"
                                                ng-click="$ctrl.openModalEmpleado()"><i
                                                    class="fa fa-plus fa-xs"></i></button>
                                        </div>
                                    </div>
                                    <small class="text-danger" ng-show="$ctrl.data.noResults">No se encontraron los
                                        resultados</small>
                                </div>
                            </div>

                            <div class="col-xl-4 col-lg-4 col-md-6 col-sm-6 col-xs-12">
                                <div class="form-group">
                                    <label for="">Cargo</label>
                                    <div class="input-group">
                                        <select ng-model="$ctrl.data.idCargo" class="form-control border-select">
                                            <option ng-value=""></option>
                                            <option ng-value="item.idCargo" ng-repeat="item in $ctrl.cargos">
                                                {{item.descripcion}}</option>
                                        </select>
                                        <div class="input-group-append">
                                            <button type="button" tabindex="-1" class="btn btn-outline-secondary btn-sm"
                                                ng-click="$ctrl.openModalCargo()"><i
                                                    class="fa fa-plus fa-xs"></i></button>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-xl-4 col-lg-4 col-md-6 col-sm-6 col-xs-12">
                                <div class="form-group">
                                    <label for="">Observación</label>
                                    <textarea class="form-control border-select" touppercase ng-model="$ctrl.data.nota"
                                        placeholder="...">

                                    </textarea>
                                </div>
                            </div>
                        </div>


                        <div class="row justify-content-between">
                            <div class="col-xl-4 col-lg-4 col-md-4 col-sm-12 col-xs-12">
                                <div class="form-group">
                                    <label for="Placa">Placa <span tooltip-placement="top"
                                            uib-tooltip="Haz doble 'Click' sobre el placa para editar">
                                            <i class="fas fa-info-circle"></i>
                                        </span></label>
                                    <md-chips ng-model="$ctrl.placas" md-removable="true" md-enable-chip-edit="true"
                                        md-add-on-blur="true" placeholder="Ej: AAC-0123 "
                                        input-aria-label="Placas"></md-chips>
                                </div>
                            </div>

                            <div class="col-xl-4 col-lg-4 col-md-4 col-sm-12 col-xs-12">
                                <div class="form-group">
                                    <label for="barcode"> Código de Barras:</label>
                                    <button type="button" class="btn btn-info btn-sm"
                                        ng-click="$ctrl.getBarcode($ctrl.data.numeroIdentificacion)"><i
                                            class="fa fa-barcode"></i> Generar</button>
                                    <img id="barcode" src="" alt="" style="display: none;">
                                </div>
                                <div class="card border border-success" id="cardBusiness" style="max-width: 18rem;">
                                    <div class="card-body">
                                        <h5 class="card-title text-center">{{$ctrl.data.nombreFiscal}}</h5>
                                        <div class="row">
                                            <div class="col-md-12 ">
                                                @* <label for="identificacion">N° Identificación:</label> *@
                                            </div>
                                        </div>
                                        <div class="row">
                                            <div class="col-md-12 text-center">
                                                <h5 style="align-content: center;">{{$ctrl.data.numeroIdentificacion}}
                                                </h5>
                                                <img id="barcode" src="{{$ctrl.data.barcodeCard}}" alt="">
                                                <br>
                                                <h6> <small>&copy; Acontplus</small></h6>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <button class="btn btn-success btn-sm"  ng-if="$ctrl.data.barcodeGenerated" ng-click="$ctrl.exportTpvCard($ctrl.data.numeroIdentificacion)"><i class="ti-share"></i> Compartir Tarjeta</button>
                            </div>
                        </div>                       
                    </div>
                </div>
            </uib-tab>
        </uib-tabset>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-success" ng-click="$ctrl.saveUpdateCliente()">
            <i class="ti-{{$ctrl.tipoRegistro===1?'save':'pencil'}}"></i> {{$ctrl.tipoRegistro===1?'Guardar':'Actualizar'}}
        </button>
        <button type="button" class="btn btn-dark" ng-click="$ctrl.closeModal()">
            &times; Cerrar
        </button>
    </div>
</form>