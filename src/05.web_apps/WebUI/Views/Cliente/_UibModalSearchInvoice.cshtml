<input type="text" id="clienteSearchInvoice" autocomplete="off" name="clienteSearchInvoice"
    class="form-control border-select" placeholder="Ingrese C.I o Nombre Fiscal" ng-model="$ctrl.cliente.nombreFiscal"
    ng-keyup="$ctrl.onKeyupSearchCliente()"
    uib-typeahead="item as item.nombreFiscal for item in $ctrl.clienteSearchDynamic($viewValue)"
    typeahead-loading="$ctrl.clienteSearch.loading" typeahead-no-results="$ctrl.clienteSearch.noResults"
    typeahead-template-url="autocompleteClienteTemplate.html" typeahead-min-length="1" typeahead-editable="true"
    typeahead-on-select="$ctrl.onSelectedClienteChange($item)" onClick="select();" />

<script type="text/ng-template" id="autocompleteClienteTemplate.html">
        <div class="autocomplete-suggestion-uib-typeahead">
            <span class="item-title">
                <b> {{match.model.numeroIdentificacion}}</b> - {{match.model.nombreFiscal}}
            </span>
        </div>
    </script>