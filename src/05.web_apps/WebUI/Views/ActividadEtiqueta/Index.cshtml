@{
    ViewData["title"]="Actividad Etiqueta";
}

<div ng-controller="actividadEtiquetaCtrl">
    <div ng-if="accion.leer">
        <div class="row page-titles">
            <div class="col-md-5 align-self-center">
                <h4 class="text-themecolor">Gestión de Actividad Etiqueta</h4>
            </div>
            <div class="col-md-7 align-self-center text-right">
                <div class="d-flex justify-content-end align-items-center">
                    @* <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a href="/Home/Index">Inicio</a></li>
                        <li class="breadcrumb-item"><a href="javascript:void(0)">Administración</a></li>
                        <li class="breadcrumb-item active">Etiquetas</li>
                    </ol> *@
                    
                    <button type="button" class="btn btn-info m-l-15" ng-click="openModalActividadEmpresa()"><i class="fa fa-plus-circle"></i> Nuevo</button> 
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-lg-12">
                <md-card>                
                    <md-table-container>
                        <table md-table>
                            <thead md-head>
                                <tr md-row>                                
                                    <th md-column><span></span></th>                            
                                    <th md-column><span>N°</span></th>                            
                                    <th md-column><span>Actividad</span></th>
                                    <th md-column>Estado</th>                                
                                    <th md-column>Op</th>                                
                                </tr>
                            </thead>
                            <tbody md-body>
                                <tr md-row ng-repeat-start="a in actividades">
                                    <td md-cell ng-click="expandDetalle(a)">
                                        <span ng-if="a.expanded"><i class="fas fa-caret-square-down"></i></span>
                                        <span ng-if="!a.expanded"><i class="fas fa-caret-square-right"></i></span>
                                    </td>                                                          
                                    <td md-cell>{{$index+1}}</td>                            
                                    <td md-cell><b class="text-primary">{{a.descripcion}}</b></td>
                                    <td md-cell ng-bind-html="a.estado | estadoPrimario"></td>                                
                                    <td md-cell>                                    
                                        <button type="button" ng-if="accion.crear" ng-show="a.etiquetas.length===0" class="btn btn-success btn-sm" ng-click="nuevoEtiqueta(a)"><i class="ti-plus"></i></button>                                    
                                        <button type="button" ng-show="a.etiquetas.length>0" class="btn btn-info btn-sm" ng-click="editarEtiqueta(a)"><i class="fa fa-edit"></i></button>                                    
                                    </td>                                
                                </tr>
                                <tr md-row ng-if="a.expanded" ng-repeat-end="">
                                    <td md-cell colspan="5">
                                        <div class="ml-3 mt-2 mr-3">
                                            <div class="table-responsive">
                                                <table class="table table-no-bordered table-sm text-center">
                                                    <thead>
                                                        <tr>
                                                            <th>N°</th>
                                                            <th>Código</th>
                                                            <th>Descripción</th>                                                                                                     
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        <tr ng-repeat="e in a.etiquetas">
                                                            <td>{{$index+1}}</td>
                                                            <td>{{e.codigo}}</td>
                                                            <td>{{e.descripcion}}</td>                                                        
                                                        </tr>
                                                        @*<tr class="text-center" mg-show="tc.subContribuyentes.length==0">
                                                                <td colspan="5"> No hay registros en esta tabla</td>
                                                            </tr>*@
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                                <tr ng-show="actividades.length==0" class="text-center">
                                    <td colspan="5">
                                        No hay registros en esta tabla :)
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </md-table-container>                            
                </md-card>  
            </div>
        </div>         
    </div>    

</div>

@section Scripts{
    <script src="~/js/controllers/admin/actividadEtiquetaCtrl.js" asp-append-version="true"></script>
    


}
