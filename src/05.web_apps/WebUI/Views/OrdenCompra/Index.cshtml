@{
    ViewData["title"] ="Orden de Compra";
}

<div ng-controller="ordenCompraCtrl">
    <div class="row page-titles">
        <div class="col-md-5 align-self-center">            
            <h5 class="text-muted">Orden de Compra</h5>
        </div>
        <div class="col-md-7 align-self-center text-right">
            <div class="d-flex justify-content-end align-items-center">
                @* <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/Home/Index">Inicio</a></li>
                    <li class="breadcrumb-item"><a href="javascript:void(0)">Compras </a></li>
                    <li class="breadcrumb-item active"></li>
                </ol> *@
                <button type="button" ng-if="accion.leer && accion.crear" class="btn btn-info m-l-15" ng-click="openModalNew()" ><i class="fa fa-plus-circle"></i> Nuevo</button>
            </div>
        </div>
    </div>

    <partial name="_ModalFiltro"/>

    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-body">
                    <div class="row">
                        <div class="col-lg-9 col-md-9 col-sm-1">
                            <button type="button"  class="btn btn-info" ng-click="openModalFiltro()"><i class=" fas fa-filter"></i> Filtrar</button>        
                        </div>
                        <div class="col-lg-3 col-md-3 col-sm-12 col-12">
                            <form class="form-material">
                                <input type="text" class="form-control" ng-model="dataSearch.bySearch" ng-keyup="filterOrdenCompras()" placeholder="Buscar " />
                            </form>
                        </div>
                    </div>

                    <!--Table-->
                    <md-table-container>
                        <table md-table>
                            <thead md-head>
                                <tr md-row>
                                    <th md-column>Op.</th>
                                    <th md-column>N°</th>
                                    <th md-column>N°. Doc </th>
                                    <th md-column>F. Emisión</th>
                                    <th md-column>Proveedor</th>
                                    <th md-column>Total</th>
                                    <th md-column>usuario</th>
                                </tr>
                            </thead>
                            <tbody md-body>
                                <tr md-row ng-repeat="item in ordenCompras">
                                    <td md-cell>                                        
                                        <md-menu>
                                            <md-button aria-label="Open demo menu" class="md-icon-button"
                                                        ng-click="$mdMenu.open($event)">
                                                <icon class="mdi mdi-menu"></icon>
                                            </md-button>
                                            <md-menu-content class="md-dense">
                                                <md-menu-item>                                            
                                                    <md-button ng-click="openModalDetalle(item)">
                                                        <span md-menu-align-target><i class="ti-menu"></i> Detalle</span>
                                                    </md-button>
                                                </md-menu-item> 

                                                <md-menu-item ng-if="accion.editar">                                                                                        
                                                    <md-button ng-click="openModalEditar(item)">
                                                        <span md-menu-align-target><i class="ti-pencil"></i> Editar</span>
                                                    </md-button>
                                                </md-menu-item> 

                                                
                                                <md-menu-item ng-if="accion.eliminar">                                                                                       
                                                    <md-button ng-click="askToDelete(item)">
                                                        <span md-menu-align-target><i class="ti-trash"></i> Eliminar</span>
                                                    </md-button>
                                                </md-menu-item>                                                                                                        
                                                                                        
                                                <md-menu-item  ng-if="accion.reporte">                                                                                        
                                                    <md-button ng-click="getReport(item)">
                                                        <span md-menu-align-target><i class=" ti-file"></i> PDF</span>
                                                    </md-button>
                                                </md-menu-item>                                                                                      
                                            </md-menu-content>
                                        </md-menu>
                                    </td>
                                    <td md-cell class="align-middle">{{$index+1}}</td>
                                    <td md-cell class="align-middle">{{item.nroDoc}}</td>
                                    <td md-cell class="align-middle">{{item.fechaEmision}}</td>
                                    <td md-cell class="align-middle">{{item.proveedor}}</td>
                                    <td md-cell class="align-middle">${{item.total }}</td>
                                    <td md-cell class="align-middle">{{item.usuario}}</td>
                                </tr>
                                <tr ng-show="ordenCompras.length===0" class="text-center">
                                    <td colspan="6">
                                        No hay registros;
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </md-table-container>
                </div>
            </div>
        </div>
    </div>        

</div>

@section Scripts{
    <script src="~/js/common/components/mdAutocompleteProveedor.min.js" asp-append-version="true"></script>
    <script src="~/js/compras/controllers/ordenCompraCtrl.min.js" asp-append-version="true"></script>       
}


