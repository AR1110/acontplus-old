<form autocomplete="off">
    <div class="modal-header bg-info text-white">
        <h5 class="modal-title">Editar Guia Remisión</h5><br>          
        <button type="button" class="close" ng-click="$ctrl.closeModal()">&times;</button>
    </div>

    <div class="modal-body">
        <div class="row">
            <div class="col-lg-6 col-md-6 col-sm-12 col-12">
                <div class="row">
                    <div class="col-xl-6 col-lg-6 col-md-6 col-sm-12 col-12">                        
                        <div class="form-group">
                            <label for="establecimiento">Estab.: <span class="text-danger">*</span></label>
                            <select class="form-control border-select" ng-model="$ctrl.data.codEstab" disabled>
                                <option ng-value="item.codEstab" ng-repeat="item in  $ctrl.establecimientos">{{item.nombreComercial}}</option>
                            </select>                                    
                        </div> 
                    </div>

                    <div class="col-xl-3 col-lg-3 col-md-6 col-sm-12 col-12">                       
                        <div class="form-group">
                            <label for="ptoEmision">Punto Emisión: <span class="text-danger">*</span></label>
                            <select class="form-control border-select" ng-model="$ctrl.data.idPuntoEmision" disabled>
                                <option ng-value="item.idPuntoEmision" ng-repeat="item in $ctrl.puntosEmision">{{item.ptoEmi}}</option>
                            </select>
                        </div>                                                                 
                    </div>

                    <div class="col-lg-3">
                        <div class="form-group">                                    
                            <label for="fechaEmision">Fecha Emisión <span class="text-danger">*</span></label>
                            <input type="date" class="form-control  border-select" ng-model="$ctrl.data.fechaEmision">                                    
                        </div>
                    </div>

                </div>
            </div>
            <div class="col-lg-6 col-md-6 col-sm-12 col-12">
                <div class="row">
                    <div class="col-lg-8">
                        <div class="form-group">
                            <label for="">Cliente <span class="text-danger">*</span></label>                            
                            <search-cliente-custom selected-item-cliente="$ctrl.selectedItemCliente(item)" search-options="$ctrl.searchClienteOptions" cliente-data-param="$ctrl.cliente"/>               
                        </div>                    
                    </div>

                    <div class="col-lg-4">
                        <div class="form-group">
                            <label for="ruc">Ruc</label>
                            <input type="text" class="form-control" ng-value="$ctrl.cliente.numeroIdentificacion" tabindex="-1" readonly>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-lg-3 col-md-3 col-sm-6 col-12">
                <div class="form-group">
                    <label for="">Fecha Inicio <span class="text-danger">*</span></label>
                    <input type="date" class="form-control border-select" ng-model="$ctrl.data.fechaInicio" required>
                </div>  
            </div>
            <div class="col-lg-3 col-md-3 col-sm-6 col-12">
                <div class="form-group">
                    <label for="">Fecha Fin <span class="text-danger">*</span></label>
                    <input type="date" class="form-control border-select" ng-model="$ctrl.data.fechaFin" required>
                </div>
            </div>

            <div class="col-lg-3 col-md-3 col-sm-6 col-12">
                <div class="form-group">
                    <label for="transportista">Transportista <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <input type="text"
                                autocomplete="off"
                                class="form-control border-select"
                                placeholder="Ingrese Descripción"
                                ng-model="$ctrl.transportista.nombre"
                                ng-keyup="$ctrl.onKeyupTransportistaSearch()"
                                uib-typeahead="t as t.nombre for t in $ctrl.transporteSearch($viewValue)"
                                typeahead-loading="$ctrl.transportista.loadingLocations"
                                typeahead-no-results="$ctrl.transportista.noResults"
                                typeahead-items="1"
                                typeahead-wait-ms="10"
                                typeahead-template-url="autocompleteTransport.html"
                                typeahead-editable="false"
                                typeahead-on-select="$ctrl.selectedTransportstaChange($item)" />
                        <script type="text/ng-template" id="autocompleteTransport.html">
                            <div class="autocomplete-suggestion-uib-typeahead">
                                <span class="item-title">
                                    {{match.model.nombre}}
                                </span>
                            </div>
                        </script>
                        <div class="input-group-append">
                            <button class="btn btn-outline-secondary btn-sm" tabindex="-1" type="button" btn-transportista result-modal="$ctrl.resultModalTransportista(result)"><i class="fa fa-plus fa-xs"></i></button>
                           <button class="btn btn-outline-secondary btn-sm" tabindex="-1" type="button" ng-if="$ctrl.transportista.idTransportista>0"
                                 btn-transportista result-modal="$ctrl.resultModalTransportista(result)" params="$ctrl.transportista" >
                                <i class="fas fa-pencil-alt fa-xs"></i>
                            </button>   
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 col-md-3 col-sm-6 col-12">
                <div class="form-group">
                    <label for="vehiculo">Vehículo <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <input type="text"
                                autocomplete="off"
                                class="form-control border-select"
                                placeholder="Ingrese Descripción"
                                ng-model="$ctrl.vehiculo.placa"
                                ng-keyup="$ctrl.onKeyupVehiculoSearch()"
                                uib-typeahead="t as t.placa for t in $ctrl.vehiculoSearch($viewValue)"
                                typeahead-loading="loadingLocations"
                                typeahead-items="1"
                                typeahead-wait-ms="10"
                                typeahead-no-results="noResults"
                                typeahead-template-url="autocompleteVehiculo.html"
                                typeahead-editable="false"
                                typeahead-on-select="$ctrl.selectedVehiculoChange($item)" />
                        <script type="text/ng-template" id="autocompleteVehiculo.html">
                            <div class="autocomplete-suggestion-uib-typeahead">
                                <span class="item-title">
                                    {{match.model.placa}}
                                </span>
                            </div>
                        </script>
                        <div class="input-group-append">
                            <button type="button" class="btn btn-outline-secondary btn-sm"  btn-vehiculo result-modal="resultModalVehiculo(result)" tabindex="-1" >
                                <i class="fa fa-plus fa-xs"></i>
                            </button>
                            <button type="button" class="btn btn-outline-secondary btn-sm" ng-if="$ctrl.vehiculo.idVehiculo>0"  btn-vehiculo result-modal="$ctrl.resultModalVehiculo(result)" params="$ctrl.vehiculo" tabindex="-1">
                                <i class="fas fa-pencil-alt fa-xs"></i>
                            </button>                                                      
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-lg-3 col-md-3 col-sm-6 col-12">
                <div class="form-group">
                    <label for="ptoPartida" class="">Punto de Partida  <span class="text-danger">*</span></label>
                    <input type="text" class="form-control border-select" touppercase ng-model="$ctrl.data.ptoPartida">
                </div>
            </div>

            <div class="col-lg-3 col-md-3 col-sm-6 col-12">
                <div class="form-group">
                    <label for="ptoPartida" class="">Punto de Llegada  <span class="text-danger">*</span></label>
                    <input type="text" class="form-control border-select" touppercase ng-model="$ctrl.data.ptoLlegada">
                </div>
            </div>

            <div class="col-lg-3 col-md-3 col-sm-6 col-12">
                <div class="form-group">
                    <label for="EstDestino">Est. Destino<span class="text-danger">*</span> </label>
                    <input type="text" 
                            mask="999" maxlength=3
                            class="form-control ssn-inputmask border-select" 
                            ng-model="$ctrl.data.estableDestino">
                </div>
            </div>
            <div class="col-lg-3 col-md-3 col-sm-6 col-12">
                <div class="form-group">
                    <label for="docAduanero">Doc. Aduanero </label>
                    <input type="text" class="form-control border-select" ng-model="$ctrl.data.docAduanero">
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-lg-3 col-md-3 col-sm-6 col-12">
                <div class="form-group">
                    <label for="MotivoTraslado">Ruta  <span class="text-danger">*</span></label>
                    <input type="text" class="form-control border-select" touppercase ng-model="$ctrl.data.ruta">
                </div>
            </div> 
            <div class="col-lg-3 col-md-3 col-sm-6 col-12">
                <div class="form-group">
                    <label for="MotivoTraslado">Motivo Traslado  <span class="text-danger">*</span></label>
                    <input type="text" class="form-control border-select" touppercase ng-model="$ctrl.data.motivo">
                </div>
            </div> 

            <div class="col-lg-3 col-md-3 col-sm-6 col-12">
                <div class="form-group">
                    <label for="ptoPartida" class="">Entrega A: </label>
                    <input type="text" class="form-control border-select" touppercase ng-model="$ctrl.data.entregar">
                </div>
            </div> 

            <div class="col-lg-3 col-md-3 col-sm-6 col-12">
                <div class="form-group">
                    <label for="empleado" class="">Empleado</label>
                    <div class="input-group">
                        <input type="text"
                                autocomplete="off"
                                class="form-control border-select"
                                placeholder="Ingrese Descripción"
                                ng-model="$ctrl.empleado.nombreCompleto"
                                ng-keyup="$ctrl.onKeyupEmpleadoSearch()"
                                uib-typeahead="e as e.nombreCompleto for e in $ctrl.empleadoSearch($viewValue)"
                                typeahead-loading="$ctrl.empleado.loadingLocations"
                                typeahead-items="1"
                                typeahead-wait-ms="10"
                                typeahead-no-results="$ctrl.empleado.noResults"
                                typeahead-template-url="autocompleteEmpleado.html"
                                typeahead-editable="false"
                                typeahead-on-select="$ctrl.selectedEmpleadoChange($item)" />
                        <script type="text/ng-template" id="autocompleteEmpleado.html">
                            <div class="autocomplete-suggestion-uib-typeahead">
                                <span class="item-title">
                                    <strong>{{match.model.nroIdentificacion}}</strong> - {{match.model.nombreCompleto}}
                                </span>
                            </div>
                        </script>
                        <div class="input-group-append">
                            <button class="btn btn-outline-secondary btn-sm" ng-click="$ctrl.openModalEmpleadoNew()" tabindex="-1" type="button">
                                <i class="fa fa-plus fa-xs"></i>
                            </button>                                                                      
                        </div>
                    </div>               
                </div>
            </div>   
        </div>
        
                        
        <div class="row justify-content-between">
            <div class="col-lg-6">
                <div class="form-group">
                    <label for="">Articulo <span class="text-danger">*</span></label>
                    <md-autocomplete-articulo-component 
                        tipo-doc="$ctrl.TIPO_DOC"
                        abrir-modal-articulo="$ctrl.abrirModalArticulo(item)"
                        get-data-articulo="$ctrl.getDataIdArticulo(item)"
                        set-item-articulo-en-detalle="$ctrl.setItemArticuloEnDetalle(item)"
                        scope-parent="$scope">
                    </md-autocomplete-articulo-component> 
                </div>
            </div>
            <div class="col-lg-6"></div>
        </div>

        <div ui-grid="$ctrl.gridOptions"
            ui-grid-edit
            ui-grid-resize-columns 
            ui-grid-cellNav
            ui-grid-auto-resize 
            class="grid">
        </div>

        <div class="row justify-content-end">                   
            <div class="col-md-2">
                <div class="mt-2">
                    <button type="button" class="btn btn-secondary btn-sm btn-lg btn-block" ng-click="$ctrl.openModalInfoAdicional(false)">
                        <i class="fas fa-info-circle text-info"></i> Dato Adicional
                    </button>
                </div>                            
            </div>
        </div>

    </div>

    <div class="modal-footer">
        <button type="button" class="btn btn-info" ng-click="$ctrl.onSave()">
            <i class="ti-pencil"></i> Actualizar
        </button>
        <button type="button" class="btn btn-dark" ng-click="$ctrl.closeModal()">&times; Cerrar</button>
    </div>
</form>