<form autocomplete="off">
    <div class="modal-header bg-info text-white">
        <h5 class="modal-title">Detalle Guia Remisión</h5>      
        <button type="button" class="close" ng-click="$ctrl.closeModal()">&times;</button>
    </div>

    <div class="modal-body">
        <div class="row">
            <div class="col-lg-6 col-md-6 col-sm-12 col-12">
                <div class="row">
                    <div class="col-xl-6 col-lg-6 col-md-6 col-sm-12 col-12">                        
                        <div class="form-group">
                            <label for="establecimiento">Estab.:</label>
                            <select class="form-control border-select" ng-model="$ctrl.data.codEstab" disabled>
                                <option ng-value="item.codEstab" ng-repeat="item in  $ctrl.establecimientos">{{item.nombreComercial}}</option>
                            </select>                                    
                        </div> 
                    </div>

                    <div class="col-xl-3 col-lg-3 col-md-6 col-sm-12 col-12">                       
                        <div class="form-group">
                            <label for="ptoEmision">Punto Emisión:</label>
                            <select class="form-control border-select" ng-model="$ctrl.data.idPuntoEmision" disabled>
                                <option ng-value="item.idPuntoEmision" ng-repeat="item in $ctrl.puntosEmision">{{item.ptoEmi}}</option>
                            </select>
                        </div>                                                                 
                    </div>

                    <div class="col-lg-3">
                        <div class="form-group">                                    
                            <label for="fechaEmision">Fecha Emisión:</label>
                            <input type="date" class="form-control  border-select" ng-model="$ctrl.data.fechaEmision" disabled>                                    
                        </div>
                    </div>

                </div>
            </div>
            <div class="col-lg-6 col-md-6 col-sm-12 col-12">
                <div class="row">
                    <div class="col-lg-8">
                        <div class="form-group">
                            <label for="">Cliente:</label>                            
                            <input type="text" class="form-control" ng-value="$ctrl.cliente.nombreComercial" disabled>                                           
                        </div>                    
                    </div>

                    <div class="col-lg-4">
                        <div class="form-group">
                            <label for="ruc">Ruc:</label>
                            <input type="text" class="form-control" ng-value="$ctrl.cliente.numeroIdentificacion" tabindex="-1" disabled>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-lg-3 col-md-3 col-sm-6 col-12">
                <div class="form-group">
                    <label for="">Fecha Inicio <span class="text-danger">*</span></label>
                    <input type="date" class="form-control border-select" ng-model="$ctrl.data.fechaInicio" disabled>
                </div>  
            </div>
            <div class="col-lg-3 col-md-3 col-sm-6 col-12">
                <div class="form-group">
                    <label for="">Fecha Fin:</label>
                    <input type="date" class="form-control border-select" ng-model="$ctrl.data.fechaFin" disabled>
                </div>
            </div>

            <div class="col-lg-3 col-md-3 col-sm-6 col-12">
                <div class="form-group">
                    <label for="transportista">Transportista:</label>
                    <div class="input-group">
                        <input type="text" class="form-control" ng-value="$ctrl.transportista.nombre" disabled>
                        <div class="input-group-append">
                            <button class="btn btn-default btn-sm" tabindex="-1" type="button" disabled><i class="fa fa-plus fa-xs"></i></button>                                                                                                                
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 col-md-3 col-sm-6 col-12">
                <div class="form-group">
                    <label for="vehiculo">Vehículo:</label>
                    <div class="input-group">
                        <input type="text" class="form-control" ng-value="$ctrl.vehiculo.placa" disabled>
                        <div class="input-group-append">
                            <button type="button" class="btn btn-secondary btn-sm" disabled tabindex="-1" >
                                <i class="fa fa-plus fa-xs"></i>
                            </button>                                                                        
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-lg-3 col-md-3 col-sm-6 col-12">
                <div class="form-group">
                    <label for="ptoPartida" class="">Punto de Partida:</label>
                    <input type="text" class="form-control border-select" touppercase ng-model="$ctrl.data.ptoPartida" disabled>
                </div>
            </div>

            <div class="col-lg-3 col-md-3 col-sm-6 col-12">
                <div class="form-group">
                    <label for="ptoPartida" class="">Punto de Llegada  </label>
                    <input type="text" class="form-control border-select" touppercase ng-model="$ctrl.data.ptoLlegada" disabled>
                </div>
            </div>

            <div class="col-lg-3 col-md-3 col-sm-6 col-12">
                <div class="form-group">
                    <label for="EstDestino">Est. Destino </label>
                    <input type="text" 
                            mask="999" maxlength=3
                            class="form-control ssn-inputmask border-select" 
                            ng-model="$ctrl.data.estableDestino" disabled>
                </div>
            </div>
            <div class="col-lg-3 col-md-3 col-sm-6 col-12">
                <div class="form-group">
                    <label for="docAduanero">Doc. Aduanero </label>
                    <input type="text" class="form-control border-select" ng-model="$ctrl.data.docAduanero" disabled>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-lg-3 col-md-3 col-sm-6 col-12">
                <div class="form-group">
                    <label for="MotivoTraslado">Ruta  </label>
                    <input type="text" class="form-control border-select" touppercase ng-model="$ctrl.data.ruta" disabled>
                </div>
            </div> 
            <div class="col-lg-3 col-md-3 col-sm-6 col-12">
                <div class="form-group">
                    <label for="MotivoTraslado">Motivo Traslado  </label>
                    <input type="text" class="form-control border-select" touppercase ng-model="$ctrl.data.motivo" disabled>
                </div>
            </div> 

            <div class="col-lg-3 col-md-3 col-sm-6 col-12">
                <div class="form-group">
                    <label for="ptoPartida" class="">Entrega A: </label>
                    <input type="text" class="form-control border-select" touppercase ng-model="$ctrl.data.entregar" disabled>
                </div>
            </div> 

            <div class="col-lg-3 col-md-3 col-sm-6 col-12">
                <div class="form-group">
                    <label for="empleado" class="">Empleado</label>
                    <div class="input-group">
                        <input type="text" class="form-control" ng-value="$ctrl.empleado.nombreCompleto" disabled>
                        <div class="input-group-append">
                            <button class="btn btn-secondary btn-sm" disabled tabindex="-1" type="button">
                                <i class="fa fa-plus fa-xs"></i>
                            </button>                                                                      
                        </div>
                    </div>               
                </div>
            </div>   
        </div>
        

        <div ui-grid="$ctrl.gridOptions"
            ui-grid-edit
            ui-grid-resize-columns 
            ui-grid-cellNav
            ui-grid-auto-resize 
            class="grid">
        </div>

        <div class="row justify-content-end">                   
            <div class="col-md-2">
                <div class="mt-2">
                    <button type="button" class="btn btn-secondary btn-sm btn-lg btn-block" ng-click="$ctrl.openModalInfoAdicional(true)">
                        <i class="fas fa-info-circle text-info"></i> Dato Adicional
                    </button>
                </div>                            
            </div>
        </div>

    </div>

    <div class="modal-footer">      
        <button type="button" class="btn btn-dark" ng-click="$ctrl.closeModal()">&times; Cerrar</button>
    </div>
</form>