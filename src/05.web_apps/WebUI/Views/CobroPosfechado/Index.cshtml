@{
    ViewData["title"] = "Cobro Posf";
}

<div ng-controller="cobroPosfechadoCtrl">
    <div class="row page-titles">
        <div class="col-md-5 align-self-center">
            <h5 class="text-colortheme">Gestión de Cobros Posf.</h5>
        </div>
        <div class="col-md-7 align-self-center text-right">
            <div class="d-flex justify-content-end aligns-item-center">
                <!-- <button class="btn btn-info"><i class="fa fa-plus-circle"></i></button>-->
            </div>
        </div>
    </div>
    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">        
        <div class="card">
            <div class="card-body">
                <div class="table-responsive-sm">
                    <table class="table table-condensed table-sm">
                        <thead>
                            <tr>
                                <th height="40">N°</th>                              
                                <th  height="40">F. Emisión</th>
                                <th  height="40">Forma Cobro</th>
                                <th  height="40">Número</th>    
                                <th  height="40">Banco</th>                                                                                                
                                <th  height="40">Valor</th>                                
                                <th  height="40">Op.</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="cp in posfechados">
                                <td>{{$index+1}}</td>                                     
                                <td>{{cp.cobro.fechaEmision}}</td>                                                                                               
                                <td>{{cp.subEntiadaFinanciera}}</td>                                                                                               
                                <td>{{cp.cobro.nro}}</td>
                                <td>{{cp.banco}}</td>                                  
                                <td>{{cp.cobro.valor}}</td>
                                <td>
                                    <div class="row justify-content-center">
                                        <button class="btn btn-warning btn-sm" ng-click="save(cp.cobro.idCobro)"><i class="fa fa-check"></i></button>
                                    </div>
                                </td>
                            </tr>
                            <tr ng-show="posfechados.length===0" class="text-center">
                                <td colspan="7">
                                    No hay registros en esta tabla :)
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts{
    <script src="~/js/controllers/tesoreria/cobroPosfechadoCtrl.js" asp-append-version="true"></script>
}