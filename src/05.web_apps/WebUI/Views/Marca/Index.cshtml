
@{
    ViewData["Title"] = "Index";
}

<div ng-controller="marcaCtrl">
    
    <div class="row page-titles">
        <div class="col-md-5 align-self-center">
            <h4 class="text-themecolor">Gestión de Marcas</h4>
        </div>
        <div class="col-md-7 align-self-center text-right">
            <div class="d-flex justify-content-end align-items-center">                  
                <button type="button" ng-if="accion.crear" btn-add-update-marca results="resultModal(item)" class="btn btn-info   m-l-15">
                    <i class="ti-plus"></i> Nuevo
                </button>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-body">
                    <div class="row">
                        <div class="col-xl-6 col-lg-6 col-md-12 col-sm-12 col-xs-12">
                            <div class="d-flex justify-content-start">
                                <span class="form-group pull-left page-size form-inline">
                                    <select class="form-control control-color"
                                            ng-model="dataSearch.pageSize"
                                            ng-change="changePageSize()"
                                            ng-options="ra for ra in recordsQuantity">
                                    </select>
                                </span>                               
                               
                               <span class="form-group pull-left page-size form-inline">
                                    <button type="button" class="btn btn-success m-l-5" ng-click="exportTableToExcel()">
                                        <i class="far fa-file-excel"></i> Exportar
                                    </button> 
                               </span>
                                
                            </div>
                        </div>
                        <div class="col-xl-6 col-lg-6 col-md-12 col-sm-12 col-xs-12">
                            <div class="d-flex justify-content-end">
                                <form class="form-material">
                                    <input type="text" class="form-control" ng-keyup="onKeyupSearch()" ng-model="dataSearch.bySearch" placeholder="Buscar Marca" />
                                </form> 
                            </div>
                        </div>                        
                    </div>
                   
                    <div class="table-responsive">
                        <table class="table table-no-bordered">
                            <thead class="text-center">
                                <tr>
                                    <th>Op.</th>
                                    <th>N°</th>
                                    <th>Descripción</th>
                                    <th>codigo</th>
                                    <th>Estado</th>
                                </tr>
                            </thead>
                            <tbody class="text-center">
                                <tr ng-repeat="m in marcas">
                                    <td>
                                        <button class="btn btn-info btn-sm" ng-if="accion.editar" btn-add-update-marca results="resultModal(item)" params="m"><i class="ti-pencil"></i></button>

                                        <button class="btn btn-danger btn-sm" ng-if="accion.eliminar" ng-click="delete(m)"><i class="ti-trash"></i></button>
                                    </td>
                                    <td>{{$index+1}}</td>
                                    <td>{{m.descripcion}}</td>
                                    <td>{{m.codigo}}</td>
                                    <td ng-bind-html="m.estado|estadoPrimario"></td>
                                </tr>
                                <tr ng-show="marcas.length==0" class="text-center">
                                    <td colspan="4">
                                        No hay registros en esta tabla.
                                    </td>
                                </tr>
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td align="center" colspan="5">
                                        <div class="pull-left">
                                            <ul uib-pagination total-items="totalRecords" items-Per-Page="dataSearch.pageSize" ng-change="pagechanged()" ng-model="dataSearch.pageIndex" max-size="maxSize" class="pagination" boundary-links="true" rotate="false"></ul>
                                        </div>
                                    </td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div> 
</div>
@section Scripts{ 
    <script src="~/lib/xlsx/xlsx.full.min.js" asp-append-version="true"></script>   
    <script src="~/js/inventario/controllers/marcaCtrl.min.js" asp-append-version="true"></script>    
}
