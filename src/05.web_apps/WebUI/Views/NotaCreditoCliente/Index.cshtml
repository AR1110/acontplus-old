@{
    ViewData["title"] = "Nota Credito";
}
    
<div ng-controller="notaCreditoClienteCtrl">
    <div>
        <div class="row page-titles">
            <div class="col-lg-5 align-self-center">
                <h5 class="text-themecolor">Nota de Crédito Cliente</h5>
            </div>
            <div class="col-md-7 alig-self-center text-right">
                <div class="d-flex justify-content-end align-items-center">
                    <button class="btn btn-info m-l-15" ng-if="accion.crear" ng-click="openModalNew()"><i class="fa fa-plus-circle"></i> Nuevo</button>
                </div>
            </div>
        </div>     

        @await Html.PartialAsync("~/Views/NotaCreditoCliente/_ModalFiltro.cshtml")   

        <div class="row">
            <div class="col-lg-12">
                <div class="card">      
                    <md-toolbar class="md-table-toolbar md-default">
                        <div class="md-toolbar-tools">
                            <div class="col-lg-9 col-md-9">
                                <button class="btn btn-info" ng-click="opemModalFiltroNotaCredito()"><i class="fas fa-filter"></i> Filtrar</button>                            
                            </div>
                            <div class="col-lg-3 col-md-3 col-sm-12 col-xs-12">
                                <form class="form-material">
                                    <input type="text" class="form-control" ng-keyup="searchLocalNotaCredito()" ng-model="searchText" placeholder="Buscar" />
                                </form>
                            </div>
                        </div>
                    </md-toolbar>         
                    <md-divider></md-divider>
                    <md-table-container style="max-height: 400px">
                        <table resize md-table>
                            <thead fix-head md-head>
                                <tr md-row>
                                    <th md-column></th>
                                    <th md-column>N°</th>
                                    <th md-column>N°. Doc</th>
                                    <th md-column md-order="nota.fechaEmision">F. Emisión</th>
                                    <th md-column>Cliente</th>
                                    <th md-column>N°. Factura</th>
                                    <th md-column>Total</th>
                                    <th md-column>Estado</th>
                                    <th md-column>Estado Sri</th>
                                    <th md-column>Usuario</th>                
                                </tr>
                            </thead>
                            <tbody md-body>
                                <tr md-row ng-repeat="nc in notaCreditos" ng-class="nc.style">
                                    <td md-cell>                                     
                                        <md-menu>
                                            <md-button aria-label="Open demo menu" class="md-icon-button"
                                                        ng-click="$mdMenu.open($event)">
                                                <icon class="mdi mdi-menu"></icon>
                                            </md-button>
                                            <md-menu-content class="md-dense">
                                                <md-menu-item>                                            
                                                    <md-button ng-click="openModalDetalle(nc)">
                                                        <span md-menu-align-target><i class="ti-menu"></i> Detalle</span>
                                                    </md-button>
                                                </md-menu-item> 

                                                

                                                <md-menu-item ng-if="accion.editar">                                                                                        
                                                    <md-button ng-click="openModalEditar(nc)">
                                                        <span md-menu-align-target><i class="ti-pencil"></i> Editar</span>
                                                    </md-button>
                                                </md-menu-item> 

                                                

                                                <md-menu-item ng-if="accion.anular">                                                                                        
                                                    <md-button  ng-click="askToDelete(nc)">
                                                        <span md-menu-align-target><i class="ti-na"></i> Anular</span>
                                                    </md-button>
                                                </md-menu-item>                                              

                                                <md-menu-item ng-if="accion.reporte">                                                                                        
                                                    <md-button ng-click="getReport(nc)">
                                                        <span md-menu-align-target><i class="ti-file"></i> PDF</span>
                                                    </md-button>
                                                </md-menu-item>                                              
                                            
                                            </md-menu-content>
                                        </md-menu>
                                    </td>
                                    
                                    <td md-cell>{{$index+1}}</td>
                                    <td md-cell>{{nc.nroDoc}}</td>
                                    <td md-cell>{{nc.fechaEmision}}</td>
                                    <td md-cell>{{nc.cliente}}</td>
                                    <td md-cell>{{nc.nroFactura}}</td>
                                    <td md-cell>${{nc.total}}</td>
                                    <td md-cell>{{nc.estadoDoc}}</td>
                                    <td md-cell>{{nc.estadoSri}}</td>
                                    <td md-cell>{{nc.usuario}}</td>
                                </tr>
                                <tr ng-show="notaCreditos.length===0" class="text-center">
                                    <td colspan="10">No hay registros en esta tabla.</td>
                                </tr>
                            </tbody>
                            <tfoot md-foot>
                                <tr md-row>
                                    <td md-cell colspan="6"><span class="font-weight-bold">Total:</span></td>
                                    <td md-cell><span class="font-weight-bold">{{total}}</span></td>
                                    <td md-cell colspan="3"></td>
                                </tr>
                            </tfoot>
                        </table>
                    </md-table-container> 
                </div>
            </div>
        </div>          
    </div>
    
</div>


@section Scripts{        
    <script src="~/js/ventas/controllers/notaCreditoClienteCtrl.min.js" asp-append-version="true"></script>        
}