<div class="modal fade in" id="modalFiltroNotaCredito" role="dialog" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Busqueda Avanzada</h5>
                <button class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <div class="row justify-content-between">
                    <div class="col-lg-3">
                        <div class="icheck-info">
                            <input type="checkbox" id="checkboxClienteFilter" ng-model="dataSearch.checkBoxCliente">
                            <label for="checkboxClienteFilter">Cliente</label>
                        </div>                        
                    </div>
                    <div class="col-lg-3">                       
                        <div class="icheck-info">
                            <input type="checkbox" ng-model="dataSearch.checkBoxFecha" ng-change="onChangeFechaFiltro()" id="checkboxFechaFilter">
                            <label for="checkboxFechaFilter">Fecha</label>
                        </div>                        
                    </div>                   
                    <div class="col-lg-3">                       
                        <div class="icheck-info">
                            <input type="checkbox" ng-model="dataSearch.checkBoxEstado" id="checkboxEstadoFilter">
                            <label for="checkboxEstadoFilter">Estado</label>
                        </div>             
                    </div>
                </div>
                <hr>

                <div class="row">
                    <div class="col-lg-6 col-md-6 col-sm-12 col-12">
                        <div class="form-group">
                            <label for="">Estab.:</label>
                            <select ng-model="dataSearch.codEstab" class="form-control border-select">
                                <option ng-value="item.codEstab" ng-repeat="item in establecimientos">{{item.nombreComercial}}</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-lg-6 col-md-6 col-sm-12 col-12" ng-show="dataSearch.checkBoxCliente">
                         @await Html.PartialAsync("~/Views/Cliente/_ClienteAutocompleteFiltro.cshtml")                                               
                    </div>
                </div>

                <div class="row" ng-show="dataSearch.checkBoxFecha">
                    <div class="col-xl-4 col-lg-4 col-md-6 col-sm-12 col-12">
                        <div class="form-group">
                            <label class="control-label">Mes: </label>
                            <select ng-model="mes" class="form-control" ng-change="getFechaInicioFinFilter(mes)">
                                <option ng-value="m.numero" ng-repeat="m in meses">{{m.nombre}}</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-xl-4 col-lg-4 col-md-6 col-sm-12 col-12">
                        <div class="form-group">
                            <label>Fecha Inicio:</label>
                            <input type="date" class="form-control" name="fechaInicio" ng-model="dataSearch.fechaInicio"
                                    value="" required />
                        </div>
                    </div>
                    <div class="col-xl-4 col-lg-4 col-md-6 col-sm-12 col-12">
                        <div class="form-group">
                            <label>Fecha Fin:</label>
                            <input type="date" class="form-control" name="facheFin" ng-model="dataSearch.fechaFin" value="" required />
                        </div>
                    </div>                   
                </div>

                <div class="row">                   
                    <div class="col-xl-6 col-lg-6 col-md-6 col-sm-6 col-12" ng-show="dataSearch.checkBoxEstado">
                        <div class="form-group">
                            <label>Estado:</label>
                            <select id="idEstadoPago" class="form-control" ng-model="dataSearch.byEstado">
                                <option ng-value="item.idEstadoPago" ng-repeat="item in estadoPagos">
                                    {{item.descripcion}}
                                </option>
                            </select>
                        </div>
                    </div>
                </div> 
            </div>
            <div class="modal-footer">
                <button class="btn btn-success" ng-click="busquedaAvanzada()"><i class="fa fa-search"></i> Buscar</button>
                <button type="button" class="btn btn-dark" data-dismiss="modal">&times; Cerrar</button>
            </div>
        </div>
    </div>
</div>