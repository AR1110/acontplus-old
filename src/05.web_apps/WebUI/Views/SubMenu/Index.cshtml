
@{
    ViewData["Title"] = "Index";
}

<div ng-controller="subMenuCtrl">
    <div class="row page-titles">
        <div class="col-md-5 align-self-center">
            <h4 class="text-themecolor">Gestión de Sub Menus</h4>
        </div>
        <div class="col-md-7 align-self-center text-right">
            <div class="d-flex justify-content-end align-items-center">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="javascript:void(0)">Inicio</a></li>
                    <li class="breadcrumb-item active">Sub Menu</li>
                </ol>
                <button type="button" ng-click="abrirModal(0,1)" class="btn btn-info d-none d-lg-block m-l-15">
                    <i class="fa fa-plus-circle"></i>Agregar
                </button>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <div class="table-responsive m-t-40">
                        <table id="config-table" class="table display table-bordered table-striped no-wrap">
                            <thead>
                                <tr>
                                    <th>Id</th>
                                    <th>Menus</th>
                                    <th>Sub Menus</th>
                                    <th>URL</th>
                                    <th>Icono</th>
                                    <th>Estado</th>
                                    <th>Acción</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="sm in subMenus">
                                    <td>{{$index+1}}</td>
                                    <td>{{sm.grupo}}</td>
                                    <td>{{sm.descripcion}}</td>
                                    <td>{{sm.url}}</td>
                                    <td><i class="{{sm.icono}}"></i></td>
                                    <td ng-bind-html="sm.estado | estadoPrimario"></td>
                                    <td class="text-left">
                                        <a class="text-success" ng-click="abrirModal(sm,2)" href="javascript:;" title="Editar"><i class="fa fa-edit"></i></a>
                                        <a class="text-danger" ng-click="abrirModal(sm,3)" href="javascript:;" title="Eliminar"><i class="fa fa-trash"></i></a>
                                        <a class="text-info" ng-click="abrirModal(sm,4)" href="javascript:;" title="Eliminar"><i class="fas fa-list-ol"></i></a>

                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="modal fade" id="agregar" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel1">
                <div class="modal-dialog  modal-lg" role="document">
                    <div class="modal-conten">
                        <form ng-submit="crudSubMenu(data.tipoOperacion)" autocomplete="off" novalidate>
                            <div class="modal-content">
                                <div class="modal-header {{colorHeader}}">
                                    <h5 class="modal-title text-white" id="exampleModalLabel"><i class="{{icono}}"></i>{{tituloModal}}</h5>
                                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                        <span aria-hidden="true">&times;</span>
                                    </button>
                                </div>
                                <div class="modal-body">
                                    <h3 class="box-title">Menú</h3>
                                    <hr class="m-t-0 m-b-40">
                                    <div class="row">
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <select class="form-control" ng-model="menu"
                                                        ng-options="m as m.descripcion for m in menus track by m.idMenu">
                                                </select>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <input type="text" ng-model="menu.grupo" name="name" id="grupo" value="" class="form-control" placeholder="GRUPO" disabled />
                                            </div>
                                        </div>
                                    </div>

                                    <h3 class="box-title">Sub Menu</h3>
                                    <hr class="m-t-0 m-b-40">
                                    <div class="row">
                                        <div class="form-group col-lg-4 col-md-4 col-sm-4 col-xs-4">
                                            <div class="controls">
                                                <input type="text" ng-model="subMenu.descripcion " class="form-control" placeholder="Descripcion">
                                            </div>
                                        </div>
                                        <div class="form-group col-lg-4 col-md-4 col-sm-4 col-xs-4">
                                            <div class="controls">
                                                <input type="text" ng-model="subMenu.url" class="form-control" placeholder="/Usuario/Index">
                                            </div>
                                        </div>
                                        <div class="form-group col-lg-3 col-md-3 col-sm-3 col-xs-3">
                                            <div class="controls">
                                                <input type="text" ng-model="subMenu.icono" class="form-control" placeholder="fa fa-user">
                                            </div>
                                        </div>
                                        <div class="form-group col-lg-1 col-md-1 col-sm-1 col-xs-1" ng-hide="data.tipoOperacion == 2">
                                            <div class="controls">
                                                <button class="btn btn-success" type="button" ng-click="addSubMenu(menu, subMenu)"><i class="fa fa-plus"></i></button>
                                            </div>
                                        </div>

                                        <div class="table-responsive">
                                            <table class="table">
                                                <tbody>
                                                    <tr ng-repeat="sm in subMenusAdded">
                                                        <td>{{sm.descripcion}}</td>
                                                        <td>{{sm.url}}</td>
                                                        <td>{{sm.icono}}</td>
                                                        <td><a class="text-danger" href="javascript:;" ng-click="removeMenu(sm)"><i class="fa fa-times"></i></a></td>
                                                    </tr>

                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="form-group col-lg-1 col-md-1 col-sm-1 col-xs-1" ng-if="data.tipoOperacion==2">
                                            <label for="">Estado: </label>
                                            <fieldset class="controls">
                                                <div class="custom-control custom-radio">
                                                    <input type="radio" value="1" ng-model="subMenu.estado" ng-value="true" name="styled_radio" required id="styled_radio1" class="custom-control-input">
                                                    <label class="custom-control-label" for="styled_radio1">Activo</label>
                                                </div>
                                            </fieldset>
                                            <fieldset>
                                                <div class="custom-control custom-radio">
                                                    <input type="radio" value="2" ng-model="subMenu.estado" ng-value="false" name="styled_radio" id="styled_radio2" class="custom-control-input">
                                                    <label class="custom-control-label" for="styled_radio2">Inactivo</label>
                                                </div>
                                            </fieldset>
                                        </div>
                                    </div>
                                </div>
                                <div class="modal-footer">
                                    <button type="submit" class="btn btn-info"><i class="fa fa-save"></i> Guardar</button>
                                    <button type="button" class="btn btn-secondary" data-dismiss="modal"><i class="fa fa-close"></i>Cancelar</button>
                                </div>
                            </div>
                        </form>

                    </div>
                </div>
            </div>
            <div class="modal fade" id="modalEliminar" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
                <div class="modal-dialog" role="document">
                    <form ng-submit="crudSubMenu(data.tipoOperacion)" autocomplete="off">
                        <div class="modal-content">
                            <div class="modal-header {{colorHeader}}">
                                <h5 class="modal-title text-white" id="exampleModalLabel"><i class="{{icono}}"></i> {{tituloModal}}</h5>
                                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                    <span aria-hidden="true">&times;</span>
                                </button>
                            </div>
                            <div class="modal-body">
                                <p>Está usted seguro de eliminar los Sub Menu <b>{{subMenu.descripcion}} </b>, de manera permanente?</p>
                            </div>
                            <div class="modal-footer">
                                <button type="submit" class="btn btn-primary"><i class="fa fa-save"></i> Guardar</button>
                                <button type="button" class="btn btn-danger" data-dismiss="modal"><i class="fa fa-close"></i> Cancelar</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

            <!--Acciones-->
            <div class="modal fade" id="asignacion" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel1">
                <div class="modal-dialog modal-lg" role="document">
                    <div class="modal-content">
                        <form ng-submit="crudSubMenu(data.tipoOperacion)" autocomplete="off" novalidate>
                            <div class="modal-content">
                                <div class="modal-header {{colorHeader}}">
                                    <h5 class="modal-title text-white" id="exampleModalLabel"><i class="{{icono}}"></i>{{tituloModal}}</h5>
                                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                        <span aria-hidden="true">&times;</span>
                                    </button>
                                </div>
                                <div class="modal-body">
                                    <div class="p-4 border shadow-sm rounded">
                                        <div class="row">
                                            <div class="col-md-12 border-right">
                                                <ul class="list-style-none" ng-repeat="a in acciones">
                                                    <li class="my-2 border-bottom pb-3">
                                                        <input type="checkbox" ng-model="checkedAccion[a.acciones.idAcciones]" ng-change="addAcciones(a.acciones.idAcciones)"><span class="font-weight-medium text-danger"> {{a.acciones.descripcion}}</span> 
                                                    </li>
                                                </ul>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="modal-footer">
                                    <button type="submit" class="btn btn-info" ng-disabled="btnActive"><i class="fa fa-save"></i> Guardar</button>
                                    <button type="button" class="btn btn-secondary" data-dismiss="modal"><i class="fa fa-close"></i>Cancelar</button>
                                </div>
                            </div>
                        </form>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script src="~/js/controllers/subMenuCtrl.js?v=52"></script>