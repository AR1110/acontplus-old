<h4>Impuestos del Documento</h4>
<div class="row">
    <div class="col-xl-3 col-lg-3 col-md-3 col-sm-3 col-6">
        <div class="form-group">
            <label for="codImpuestoDocSustento">Impuesto:</label>
            <select name="codImpuestoDocSustento" id="codImpuestoDocSustento" class="form-control"
                ng-model="tax.codImpuestoDocSustento">
                <option></option>
                <option ng-value="item.codigo" ng-repeat="item in impuestos">{{item.codigo}} - {{item.descripcion}}
                </option>
            </select>
        </div>
    </div>
    <div class="col-xl-3 col-lg-3 col-md-3 col-sm-3 col-6">
        <div class="form-group">
            <label for="codigoPorcentaje">Porcentaje:</label>
            <select name="codigoPorcentaje" id="codigoPorcentaje" class="form-control" ng-model="tax.codigoPorcentaje"
                ng-change="setTarifaImp(tax.codigoPorcentaje)">
                <option></option>
                <option ng-value="item.codigo"
                    ng-repeat="item in tarifasImp | filter: {codImpuesto:tax.codImpuestoDocSustento }:true">
                    {{item.codigo}} -
                    {{item.descripcion}}
                </option>
            </select>
        </div>
    </div>
    <div class="col-xl-2 col-lg-2 col-md-2 col-sm-2 col-3">
        <div class="form-group">
            <label for="baseImponible">Base Imponible:</label>
            <input type="number" name="baseImponible" id="baseImponible" class="form-control"
                ng-model="tax.baseImponible" ng-blur="setTaxValue(this)" step="any" min="0" />
        </div>
    </div>
    <div class="col-xl-2 col-lg-2 col-md-2 col-sm-2 col-3">
        <div class="form-group">
            <label for="tarifa">Tarifa:</label>
            <input type="text" name="tarifa" id="tarifa" class="form-control" ng-model="tax.tarifa" step="any" min="0"
                disabled />
        </div>
    </div>
    <div class="col-xl-2 col-lg-2 col-md-2 col-sm-2 col-3">
        <div class="form-group">
            <label for="valorImpuesto">Valor Impuesto:</label>
            <input type="text" name="valorImpuesto" id="valorImpuesto" class="form-control" ng-model="tax.valorImpuesto"
                step="any" min="0" disabled />
        </div>
    </div>
</div>
<button type="button" class="btn btn-info  btn-sm" id="{{item.uniqueIdDoc}}-btnAddTax" ng-click="addTax(item.uniqueIdDoc, true)"><i
        class="ti-plus"></i>
    Añadir Impuesto</button>
<button type="button" class="btn btn-info btn-sm" id="{{item.uniqueIdDoc}}-btnEditTax" ng-click="updateTax(item.uniqueIdDoc)"
    style="display:none;"><i class="ti-save"></i>
    Guardar Impuesto</button>
<hr>
<div class="table-responsive" ng-if="taxesAdded.length > 0">
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Impuesto</th>
                <th>Porcentaje</th>
                <th>Base Imponible</th>
                <th>Tarifa</th>
                <th>Valor Impuesto</th>
                <th>Opc.</th>
            </tr>
        </thead>
        <tbody>
            <tr dir-paginate="tax in taxesAdded | orderBy:sortKey:reverse | filter: item.uniqueIdDoc|itemsPerPage:10"
                ng-class-even="'even'" ng-class-odd="'odd'">
                <td>{{tax.impuesto}}<input type="hidden" ng-model="tax.uniqueIdDoc" /></td>
                <td>{{tax.porcentaje}}</td>
                <td>{{tax.baseImponible | currency}}</td>
                <td>{{tax.tarifa}}</td>
                <td>{{tax.valorImpuesto | currency}}</td>
                <td>
                    <button class="btn btn-warning btn-sm" ng-click="editTax($index, tax, item)"><i
                            class="ti-pencil"></i></button>
                    <button class="btn btn-danger btn-sm" ng-click="askToRemoveTax($index, tax, item)"><i
                            class="ti-trash"></i></button>
                </td>
            </tr>
        </tbody>
    </table>

</div>
