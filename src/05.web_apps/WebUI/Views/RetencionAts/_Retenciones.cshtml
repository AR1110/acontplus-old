<hr>
<h4>Retenciones</h4>
<div class="row">
    <div class="col-xl-3 col-lg-3 col-md-3 col-sm-3 col-6">
        <div class="form-group">
            <label for="codigo">Impuesto:</label>
            <select name="codigo" id="codigo" class="form-control" ng-model="retencion.codigo"
                ng-change="setPorcentajesRet(retencion.codigo, item.uniqueIdDoc)">
                <option></option>
                <option ng-value="item.codigo" ng-repeat="item in impuestosRet">{{item.codigo}} - {{item.descripcion}}
                </option>
            </select>
        </div>
    </div>
    <div class="col-xl-3 col-lg-3 col-md-3 col-sm-3 col-6">
        <div class="form-group">
            <label for="codigoRetencion">Codigo Retención:</label>
            <input type="text" id="{{item.uniqueIdDoc}}-descripcion" class="form-control"
                                    name="{{item.uniqueIdDoc}}-descripcion" autocomplete="off" class="form-control border-select"
                                    placeholder="Buscar código de retención" ng-model="retencionCodigoSearch" ng-keyup="clearSearch()"
                                    uib-typeahead="a as a.codigo + '-' + a.descripcion for a in porcentajeRetener | filter: $viewValue"
                                    typeahead-loading="articleFinded.loading"
                                    typeahead-no-results="articleFinded.noResults" typeahead-editable="false"
                                    typeahead-on-select="setPorcentajeRet($item.codigo, false)" 
                                    uib-popover="{{retencionCodigoSearch.descripcion}}"  popover-trigger="'focus'"
                                    onclick="select()"
                                    required />
            @* <select name="codigoRetencion" id="codigoRetencion" class="form-control"
                ng-model="retencion.codigoRetencion" ng-change="setPorcentajeRet(retencion.codigoRetencion, false)">
                <option></option>
                <option ng-value="item.codigo" ng-repeat="item in porcentajeRetener">{{item.codigo}} -
                    {{item.descripcion}}</option> *@
            </select>
        </div>
    </div>
    <div class="col-xl-2 col-lg-2 col-md-2 col-sm-2 col-3">
        <div class="form-group">
            <label for="baseImponible">Base Imponible:</label>
            <input type="number" name="baseImponible" id="baseImponible" class="form-control"
                ng-model="retencion.baseImponible" step="any" min="0" ng-blur="setValueRet(this)" />
        </div>
    </div>
    <div class="col-xl-2 col-lg-2 col-md-2 col-sm-2 col-3">
        <div class="form-group">
            <label for="porcentajeRetener">Porcentaje:</label>
            <input type="text" name="porcentajeRetener" id="porcentajeRetener" class="form-control"
                ng-model="retencion.porcentajeRetener" step="any" min="0" ng-blur="setPorcentajeRet(this, true)" />
        </div>
    </div>
    <div class="col-xl-2 col-lg-2 col-md-2 col-sm-2 col-3">
        <div class="form-group">
            <label for="valorRetenido">Valor Retenido:</label>
            <input type="text" name="valorRetenido" id="valorRetenido" class="form-control"
                ng-model="retencion.valorRetenido" step="any" min="0" disabled />
        </div>
    </div>
</div>
<button type="button" id="btnAddRet" class="btn btn-info  btn-sm" ng-click="addRetencion(item.uniqueIdDoc, true)"><i
        class="ti-plus"></i> Añadir
    Retención</button>
<button type="button" id="btnEditRet" class="btn btn-info  btn-sm" ng-click="updateRet(item.uniqueIdDoc)"
    style="display:none;"><i class="ti-save"></i> Guardar
    Retención</button>
<hr>
<div class="table-responsive" ng-if="retencionAdded.length > 0">
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Impuesto</th>
                <th>Código Ret.</th>
                <th>Base Imponible</th>
                <th>Porcentaje</th>
                <th>Valor Retenido</th>
                <th>Opc.</th>
            </tr>
        </thead>
        <tbody>
            <tr dir-paginate="ret in retencionAdded|orderBy:sortKey : reverse | filter: {uniqueIdDoc: item.uniqueIdDoc}|itemsPerPage:10"
                ng-class-even="'even'" ng-class-odd="'odd'">
                <td>{{ret.impuesto}}</td>
                <td>{{ret.codRet}}</td>
                <td>{{ret.baseImponible | currency}}</td>
                <td>{{ret.porcentajeRetener}}</td>
                <td>{{ret.valorRetenido | currency}}</td>
                <td>
                    <button class="btn btn-warning btn-sm" ng-click="editRetencion($index, ret, item)"><i
                            class="ti-pencil"></i></button>
                    <button class="btn btn-danger btn-sm" ng-click="askToRemoveRet($index, ret, item)"><i
                            class="ti-trash"></i></button>
                </td>
            </tr>
        </tbody>
    </table>
</div>