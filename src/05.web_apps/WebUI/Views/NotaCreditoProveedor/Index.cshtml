@{
    ViewData["title"] = "Nota de Credito Proveedor";
}

<div ng-controller="notaCreditoProvCtrl">
    <div class="row page-titles">
        <div class="col-lg-5 align-selft-center">
            <h5 class="text-themecolor">Nota de Crédito Proveedor</h5>
        </div>
        <div class="col-lg-7 align-items-center text-right">
            <div class="d-flex justify-content-end align-items-center">
                <button class="btn btn-info m-l-15" ng-if="accion.leer && accion.crear" ng-click="openModalNew()"><i
                        class="fa fa-plus-circle"></i> Nuevo</button>
            </div>
        </div>
    </div>

    @await Html.PartialAsync("_ModalFiltro")

    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <md-toolbar class="md-table-toolbar md-default">
                    <div class="md-toolbar-tools">
                        <div class="col-lg-9 col-md-9 col-sm-1">
                            <button type="button" class="btn btn-info" ng-click="openModalFiltro()"><i
                                    class="fa fa-filter"></i> Filtrar</button>
                        </div>
                        <div class="col-lg-3 col-md-3 col-sm-12 col-xs-12">
                            <form class="form-material">
                                <input type="text" class="form-control" ng-model="buscar" placeholder="Buscar">
                            </form>
                        </div>
                    </div>
                </md-toolbar>
                <md-table-container style="max-height: 400px;">
                    <table resize md-table>
                        <thead fix-head md-head>
                            <tr md-row>
                                <th md-column ng-if="accion.editar || accion.eliminar || accion.reporte"></th>
                                <th md-column>N°</th>
                                <th md-column>N°. Doc</th>
                                <th md-column>F. Emisión</th>
                                <th md-column>Proveedor</th>
                                <th md-column>Estado</th>
                                <th md-column>Nro. Factura</th>
                                <th md-column>Total</th>
                                <th md-column>Usuario</th>
                            </tr>
                        </thead>
                        <tbody md-body>
                            <tr md-row ng-repeat="item in notasCredito">
                                <td md-cell ng-if="accion.editar || accion.eliminar || accion.reporte">
                                    <md-menu>
                                        <md-button aria-label="Open demo menu" class="md-icon-button"
                                            ng-click="$mdMenu.open($event)">
                                            <icon class="mdi mdi-menu"></icon>
                                        </md-button>
                                        <md-menu-content class="md-dense">
                                            <md-menu-item>
                                                <md-button ng-click="openModalDetalle(item)">
                                                    <span md-menu-align-target><i class="ti-menu"></i> Detalle</span>
                                                </md-button>
                                            </md-menu-item>

                                            <md-menu-item ng-if="accion.editar">
                                                <md-button ng-click="openModalEditar(item)">
                                                    <span md-menu-align-target><i class="ti-pencil"></i> Editar</span>
                                                </md-button>
                                            </md-menu-item>


                                            <md-menu-item ng-if="accion.eliminar">
                                                <md-button ng-click="askToDelete(item)">
                                                    <span md-menu-align-target><i class="ti-na"></i> Anular</span>
                                                </md-button>
                                            </md-menu-item>

                                            <md-menu-item ng-if="accion.reporte">
                                                <md-button ng-click="getReport(item)">
                                                    <span md-menu-align-target><i class="ti-file"></i> PDF</span>
                                                </md-button>
                                            </md-menu-item>


                                        </md-menu-content>
                                    </md-menu>
                                </td>
                                <td md-cell>{{$index+1}}</td>
                                <td md-cell>{{item.nroDoc}}</td>
                                <td md-cell>{{item.fechaEmision}}</td>
                                <td md-cell>{{item.nombreFiscal|uppercase}}</td>
                                <td md-cell>{{item.estadoDoc}}</td>
                                <td md-cell>{{item.nroFactura}}</td>
                                <td md-cell>${{item.total}}</td>
                                <td md-cell>{{item.usuario}}</td>
                            </tr>
                            <tr class="text-center" ng-show="notasCredito.length===0">
                                <td colspan="8">No hay registros.</td>
                            </tr>
                        </tbody>
                    </table>
                </md-table-container>
            </div>
        </div>
    </div>

</div>

@section Scripts{
    <script src="~/js/components/mdAutocompleteProveedor.min.js" asp-append-version="true"></script>
    <script src="~/js/compras/services/facturaCompraService.min.js" asp-append-version="true"></script>
    <script src="~/js/controllers/compras/notaCreditoProveedorCtrl.min.js" asp-append-version="true"></script>
}

