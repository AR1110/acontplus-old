@{
    ViewBag.title = "Reporte Kardex";
}

<div ng-controller="reporteKardexCtrl">
    <div class="row page-titles">
        <div class="col-md-5 align-self-center">
            <h4 class="text-themecolor">Reporte Kardex</h4>
        </div>
        <div class="col-md-7 align-self-center text-right">
            <div class="d-flex justify-content-end align-items-center">
                
            </div>
        </div>
    </div>

    <partial name="_ModalReporteKardex"/>

    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-body">
                    <button class="btn btn-info" ng-click="openModalReporte()">
                        <i class="mdi mdi-file-find fa-lg"></i> Nuevo Reporte
                    </button>
                    <button class="btn btn-danger">
                        <i class=" fas fa-file-pdf"></i> PDF
                    </button>
                </div>
                <md-divider></md-divider>
                <div class="card-body">
                    <div class="jumbotron text-center">
                        <br><br><br><br><br><br><br><br><br>
                        <h2>Aquí se mostrará el reporte creado!</h2>
                        <br><br><br><br><br><br><br><br><br>
                    </div>
                </div>
            </div>
        </div>
    </div>




</div>

@section Scripts{
    <script src="~/js/controllers/reportes/reporteKardexCtrl.js" asp-append-version="true"></script>
}