For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    ViewData["Title"] = "Reporte";
}

<div ng-controller="reporteCtrl">

    <div class="row page-titles">
        <div class="col-md-5 align-self-center">
            <h4 class="text-themecolor">Reporte</h4>
        </div>
        <div class="col-md-7 align-self-center text-right">
            <div class="d-flex justify-content-end align-items-center">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="javascript:void(0)">Configuración</a></li>
                    <li class="breadcrumb-item active">Reporte</li>
                </ol>
                <button type="button" ng-if="accion.crear" ng-click="openModal(null,1)" class="btn btn-info  m-l-15">
                    <i class="ti-plus"></i> Agregar
                </button>
            </div>
        </div>
    </div>


    <div class="card">
        <div class="card-body">
            <md-toolbar class="md-table-toolbar md-default">
                <div class="md-toolbar-tools">
                    <div class="col-lg-9 col-md-9 col-sm-12 col-xs-12">
                        <button ng-click="getReport(2)" class=" btn btn-danger"> get report test</button>
                    </div>
                    <div class="col-lg-3 col-md-3 col-sm-12 col-xs-12">
                        <form class="form-material">
                            <input type="text" class="form-control" ng-model="textSearch" placeholder="Buscar">
                        </form>
                    </div>
                </div>
            </md-toolbar>
            <div class="table-responsive">
                <table class="table">
                    <thead class="small">
                        <tr>
                            <th ng-if="accion.editar || accion.eliminar">Op.</th>
                            <th>N°</th>
                            <th></th>
                            <th>codigo</th>
                            <th>reportPath</th>
                            <th>contentType</th>
                            <th>storedProcedure</th>
                            <th>estado</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat-start="item in reports | filter:textSearch" class="small">
                            <td ng-if="accion.editar || accion.eliminar">
                                <button class="btn btn-outline-warning btn-sm" ng-if="accion.editar"
                                    ng-click="openModal(item, 2)">
                                    <span class="ti-pencil"></span>
                                </button>
                                <button class="btn btn-outline-danger btn-sm" ng-if="accion.eliminar"
                                    ng-click="askToDelete(item)">
                                    <span class="ti-trash"></span>
                                </button>
                            </td>
                            <td ng-click="expandDetalle(item)">
                                <span ng-if="item.expanded"><i class="fa fa-eye-slash"></i></span>
                                <span ng-if="!item.expanded"><i class="fa fa-eye" title="Ver data sources"></i></span>
                            </td>
                            <td>{{item.idReporte}}</td>
                            <td>{{item.codigo}}</td>
                            <td>{{item.reportPath}}</td>
                            <td>{{item.contentType}}</td>
                            <td>{{item.storedProcedure}}</td>
                            <td ng-bind-html="item.estado | estadoPrimario"></td>
                        </tr>
                        <tr ng-if="item.expanded" ng-repeat-end="">
                            <td colspan="7">
                                <div class="ml-5 mr-5">
                                    <button type="button" class="btn btn-info btn-sm" ng-click="openModalDs(item)">
                                        <i class="ti-plus"></i> Nuevo
                                    </button>
                                    <div class="table-responsive">
                                        <table class="table table-no-bordered table-sm">
                                            <thead>
                                                <tr class="small">
                                                    <th>Op</th>
                                                    <th>Data Source</th>
                                                    <th>Posición</th>
                                                    <th>Estado</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <tr ng-repeat="ds in item.dataSources" class="small">
                                                    <td>
                                                        <button type="button" class="btn btn-warning btn-xs"
                                                            ng-click="openModalEditDs(item, ds)">
                                                            <span class="ti-pencil"></span>
                                                        </button>
                                                        <button class="btn btn-danger btn-xs"
                                                            ng-click="askToDeleteDs(item, ds)">
                                                            <span class="ti-trash"></span>
                                                        </button>
                                                    </td>
                                                    <td>{{ds.dataSource}}</td>
                                                    <td>{{ds.position}}</td>
                                                    <td ng-bind-html="ds.estado | estadoPrimario"></td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div> >

    <!--Reporte Modal-->
    <div id="reporteModal" class="modal fade" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel"
        aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">
                <form ng-submit="save()">
                    <div class="modal-header">
                        <h5 class="modal-title" id="exampleModalLabel">
                            <span class="{{modalIcon}}"></span>
                            {{modalTitle}}
                        </h5>
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                    <div class="modal-body">
                        <div class="row">
                            <div class="col-xl-4 col-lg-4 col-md-4 col-sm-4 col-12">
                                <div class="form-group">
                                    <label for="codigo">Código</label>
                                    <input type="text" class="form-control" id="codigo" ng-model="reporte.codigo"
                                        placeholder="RR" required>
                                </div>
                            </div>
                            <div class="col-xl-8 col-lg-6 col-md-8 col-sm-8 col-12">
                                <div class="form-group">
                                    <label for="reportPath">Report Path</label>
                                    <input type="text" class="form-control" id="reportPath"
                                        ng-model="reporte.reportPath" placeholder="Example.rdlc" required>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">
                                <div class="form-group">
                                    <label for="storedProcedure">Stored Procedure</label>
                                    <input type="text" class="form-control" id="storedProcedure"
                                        ng-model="reporte.storedProcedure" placeholder="" required>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-xl-4 col-lg-4 col-md-4 col-sm-4 col-12">
                                <div class="form-group">
                                    <label for="contentType">Content Type</label>
                                    <input type="text" class="form-control" id="contentType"
                                        ng-model="reporte.contentType" placeholder="application/pdf" required>
                                </div>
                            </div>
                            <div class="col-xl-8 col-lg-8 col-md-8 col-sm-8 col-12">
                                <div class="form-group">
                                    <label for="nombreReport">Nombre Reporte</label>
                                    <input type="text" class="form-control" id="nombreReport"
                                        ng-model="reporte.nombreReporte" placeholder="Example" required>
                                </div>
                            </div>
                        </div>
                        <div class="row" ng-show="operation === 2">
                            <div class="col-xl-4 col-lg-4 col-md-4 col-sm-6 col-6">
                                <div class="icheck-warning">
                                    <input type="radio" id="estado" ng-model="reporte.estado" ng-value="true">
                                    <label for="estado">Activo</label>
                                </div>
                            </div>
                            <div class="col-xl-4 col-lg-4 col-md-4 col-sm-6 col-6">
                                <div class="icheck-warning">
                                    <input type="radio" id="inactivo" ng-model="reporte.estado" ng-value="false">
                                    <label for="inactivo">Inactivo</label>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="submit" class="btn btn-outline-success">
                            <span class="ti-save"></span>
                            Guardar
                        </button>
                        <button type="button" class="btn btn-outline-dark" data-dismiss="modal">&times; Cerrar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>



    <!--Reporte Modal-->
    <div class="modal fade" id="dataSourceModal" tabindex="-1" role="dialog" aria-labelledby="dSModalLabel"
        aria-hidden="true">
        <div class="modal-dialog modal-sm" role="document">
            <div class="modal-content">
                <form ng-submit="saveDs()">
                    <div class="modal-header">
                        <h5 class="modal-title">
                            {{operationDs===1?'Nuevo':'Editar'}} Data Source
                        </h5>
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                    <div class="modal-body">
                        <div class="row">
                            <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">
                                <div class="form-group">
                                    <label for="dsPosition">Posición</label>
                                    <input type="text" class="form-control" id="dsPosition"
                                        ng-model="dataSource.position" valid-number placeholder="0" required>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">
                                <div class="form-group">
                                    <label for="codigo">DataSource</label>
                                    <input type="text" class="form-control" id="codigo" ng-model="dataSource.dataSource"
                                        placeholder="mainDs" required>
                                </div>
                            </div>
                        </div>
                        
                        <div class="row" ng-show="operationDs === 2">
                            <div class="col-xl-4 col-lg-4 col-md-4 col-sm-6 col-6">
                                <div class="icheck-warning">
                                    <input type="radio" id="estadoDs" ng-model="dataSource.estado" ng-value="true">
                                    <label for="estadoDs">Activo</label>
                                </div>
                            </div>
                            <div class="col-xl-4 col-lg-4 col-md-4 col-sm-6 col-6">
                                <div class="icheck-warning">
                                    <input type="radio" id="inactivoDs" ng-model="dataSource.estado" ng-value="false">
                                    <label for="inactivoDs">Inactivo</label>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="submit" class="btn btn-outline-success">
                            <span class="ti-save"></span>
                            Guardar
                        </button>
                        <button type="button" class="btn btn-outline-dark" data-dismiss="modal">&times; Cerrar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>




    <img id="barcode" src="" alt="" style="display: none;">

</div>



@section scripts{
    <script src="~/js/controllers/config/reporteCtrl.min.js" asp-append-version="true"></script>
}