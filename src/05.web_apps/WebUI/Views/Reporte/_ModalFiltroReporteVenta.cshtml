<div id="modalFiltroReporteVenta" class="modal fade in" role="dialog" tabindex="-1" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title">Reporte Venta</h4>
                <button class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">   
                <div class="row">
                    <div class="col-lg-4">
                        <div class="form-group">
                            <label for="">Tipo Documento</label>
                            <select class="form-control" ng-model="dataSearch.codDoc" ng-change="onChangeTipoReporte()">
                                <option ng-value="item.codigo" ng-repeat="item in tipoDocumentos">{{item.descripcion}}</option>                              
                            </select>   
                        </div>
                    </div>                  
                </div>

                <div class="row justify-content-between">
                    <div class="col-xl-3 col-lg-3 col-md-3 col-sm-6 col-xs-12">
                        <div class="icheck-info">
                            <input type="checkbox" 
                            ng-model="dataSearch.checkboxSucursalFiltro" ng-change="onChangeSucursal()"
                            name="checkboxSucursalFiltro" id="checkboxSucursalFiltro">
                            <label for="checkboxSucursalFiltro">Establecimiento</label>
                        </div>                        
                    </div>
                    <div class="col-xl-3 col-lg-3 col-md-3 col-sm-6 col-xs-12">
                        <div class="icheck-info">
                            <input type="checkbox" ng-disabled="!dataSearch.checkboxSucursalFiltro || dataSearch.codDoc==='RV'"
                            ng-model="dataSearch.checkboxPuntoEmisionFiltro" 
                            name="checkboxPuntoEmisionFiltro" id="checkboxPuntoEmisionFiltro">
                            <label for="checkboxPuntoEmisionFiltro">Punto Emisión</label>
                        </div>
                    </div>
                    <div class="col-xl-3 col-lg-3 col-md-3 col-sm-6 col-xs-12" ng-if="dataSearch.codDoc!=='FVNE'">
                        <div class="icheck-info">
                            <input type="checkbox" ng-change="onChangeClienteFiltro()"
                            ng-model="dataSearch.checkboxClienteFiltro" ng-disabled="dataSearch.codDoc===''"
                            name="checkboxClienteFiltro" id="checkboxClienteFiltro">
                            <label for="checkboxClienteFiltro">Cliente</label>
                        </div>
                    </div>
                    <div class="col-xl-3 col-lg-3 col-md-3 col-sm-6 col-xs-12">
                        <div class="icheck-info">
                            <input type="checkbox" ng-change="onChangeUsuarioFiltro()" 
                            ng-model="dataSearch.checkboxUsuarioFiltro" ng-disabled="dataSearch.codDoc===''"
                            name="checkboxUsuarioFiltro" id="checkboxUsuarioFiltro">
                            <label for="checkboxUsuarioFiltro">Usuario</label>
                        </div>
                    </div>                    
                </div>
             
                <div class="row justify-content-between"> 
                    <div class="col-xl-3 col-lg-3 col-md-3 col-sm-6 col-xs-12" ng-hide="dataSearch.codDoc==='RV'">
                        <div class="icheck-info">
                            <input type="checkbox" ng-change="onChangeEstadoFiltro()"
                            ng-model="dataSearch.checkboxEstadoFiltro" ng-disabled="dataSearch.codDoc===''"
                            name="checkboxEstadoFiltro" id="checkboxEstadoFiltro">
                            <label for="checkboxEstadoFiltro">Estado</label>
                        </div>                        
                    </div>

                    <div class="col-xl-3 col-lg-3 col-md-3 col-sm-6 col-xs-12">
                        <div class="icheck-info">
                            <input type="checkbox" ng-model="dataSearch.checkboxTipoClienteFiltro" name="checkboxTipoClienteFiltro" id="checkboxTipoClienteFiltro">
                            <label for="checkboxTipoClienteFiltro">Tipo Cliente</label>
                        </div>
                    </div>

                    <div class="col-xl-3 col-lg-3 col-md-3 col-sm-6 col-xs-12" ng-if="dataSearch.codDoc==='FV'">
                        <div class="icheck-info">
                            <input type="checkbox"
                            ng-model="dataSearch.checkboxRetencionFiltro" ng-disabled="dataSearch.codDoc===''"
                            name="checkboxRetencionFiltro" id="checkboxRetencionFiltro">
                            <label for="checkboxRetencionFiltro">Retención</label>
                        </div>
                    </div>

                    <div class="col-xl-3 col-lg-3 col-md-3 col-sm-6 col-xs-12"  ng-if="dataSearch.codDoc==='FV'">
                        <div class="icheck-info">
                            <input type="checkbox"
                            ng-model="dataSearch.checkboxDevolucionFiltro" ng-disabled="dataSearch.codDoc===''"
                            name="checkboxDevolucionFiltro" id="checkboxDevolucionFiltro">
                            <label for="checkboxDevolucionFiltro">Devolución</label>
                        </div>
                    </div>
                </div>

                <div class="row">  
                    <div class="col-xl-3 col-lg-3 col-md-3 col-sm-3 col-xs-12">
                        <div class="icheck-info">
                            <input type="checkbox" ng-model="dataSearch.checkboxHoraFiltro" name="checkboxHoraFiltro" id="checkboxHoraFiltro">
                            <label for="checkboxHoraFiltro">Hora</label>
                        </div>                        
                    </div>                               
                    <div class="col-lg-3 col-md-4 col-sm-4 col-xs-12">
                        <div class="icheck-info">
                            <input type="radio" ng-model="dataSearch.radioFechaFiltro" ng-change="onChangeFechaFiltro()" name="radioFechaFiltro" ng-value="true" id="radioFechaFiltro">
                            <label for="radioFechaFiltro">Fecha</label>
                        </div>
                        <div class="icheck-info" ng-hide="dataSearch.codDoc=='NC' || dataSearch.codDoc==='RV' || dataSearch.codDoc==='PR' ">
                            <input type="radio" ng-model="dataSearch.radioFechaFiltro" ng-change="onChangeFechaFiltro()" name="radioFechaFiltro" ng-value="false" id="radioFechaVctoFiltro">
                            <label for="radioFechaVctoFiltro">Fecha Vencimiento</label>
                        </div>
                    </div>                                       
                </div>                
                <hr>  



                <div class="row">
                    <div class="col-lg-xl-6 col-lg-6 col-md-6 col-sm-6 col-xs-12" ng-if="dataSearch.checkboxSucursalFiltro">
                        <div class="form-group">
                            <label for="">Sucursal</label>
                            <select class="form-control" ng-model="dataSearch.codEstab" ng-change="getAsignaciones()">
                                @* <option value="">Todos</option> *@
                                <option ng-value="item.codEstab" ng-repeat="item in sucursales">{{item.nombreComercial}}</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-lg-xl-6 col-lg-6 col-md-6 col-sm-6 col-xs-12" ng-if="dataSearch.checkboxPuntoEmisionFiltro"  ng-hide="dataSearch.codDoc==='RV'">                       
                        <div class="form-group">
                            <label for="">Punto Emisión</label>
                            <select class="form-control" ng-model="dataSearch.byPuntoEmision">                                
                                <option ng-value="pto.idPuntoEmision" ng-repeat="pto in puntosEmisiones">
                                    {{pto.ptoEmi}}
                                </option>
                            </select>
                        </div>                                            
                    </div>
                </div>             
                

                <div class="row">
                    <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12" ng-if="dataSearch.codDoc!=='FVNE'">
                        <div ng-show="dataSearch.checkboxClienteFiltro">
                            @await Html.PartialAsync("~/Views/Cliente/_ClienteAutocompleteFiltro.cshtml")
                        </div>
                    </div>

                    <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12" ng-show="dataSearch.checkboxUsuarioFiltro">
                        <div class="form-group">
                            <label>Usuario:</label>
                            @await Html.PartialAsync("~/Views/Usuario/_UsuarioSearchFilter.cshtml") 
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-xl-3 col-lg-3 col-md-6 col-sm-12 col-12">
                        <div class="form-group">
                            <label class="control-label">Mes: </label>
                            <select ng-model="mes" class="form-control" ng-change="getFechaInicioFinFilter()">
                                <option ng-value="m.numero" ng-repeat="m in meses">{{m.nombre}}</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-xl-3 col-lg-3 col-md-6 col-sm-12 col-12">
                        <div class="form-group">
                            <label>Fecha Inicio:</label>
                            <input type="date" class="form-control" ng-model="dataSearch.fechaInicio"/>
                        </div>
                    </div>
                    <div class="col-xl-3 col-lg-3 col-md-6 col-sm-12 col-12">
                        <div class="form-group">
                            <label>Fecha Fin:</label>
                            <input type="date" class="form-control" ng-model="dataSearch.fechaFin" />
                        </div>
                    </div>
                    <div class="col-xl-3 col-lg-3 col-md-6 col-sm-12 col-12" ng-show="dataSearch.checkboxEstadoFiltro">
                        <div class="form-group">
                            <label>Estado:</label>
                            <!--Factura Venta-->
                            <select class="form-control" ng-model="dataSearch.byEstado" ng-show="dataSearch.codDoc=='FV'">
                                <option ng-value="item.id" ng-repeat="item in estadoPagosFV">
                                    {{item.descripcion}}
                                </option>
                            </select>

                            <!--Nota de Entrega-->
                             <select class="form-control" ng-model="dataSearch.byEstado" ng-show="dataSearch.codDoc=='NE'">
                                <option ng-value="item.id" ng-repeat="item in estadoPagosNE">
                                    {{item.descripcion}}
                                </option>
                            </select>

                            <!--Nota Credito Cliente -->
                            <select class="form-control" ng-model="dataSearch.byEstado" ng-show="dataSearch.codDoc=='NC'">
                                <option ng-value="item.id" ng-repeat="item in estadoPagosNC">
                                    {{item.descripcion}}
                                </option>
                            </select>

                            <!--CONSOLIDADO VENTA  -->
                            <select class="form-control" ng-model="dataSearch.byEstado" ng-show="dataSearch.codDoc=='FVNE'">
                                <option ng-value="item.id" ng-repeat="item in estadoPagosNC">
                                    {{item.descripcion}}
                                </option>
                            </select>

                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-lg-4 col-md-4 col-xs-12" ng-if="dataSearch.checkboxHoraFiltro">
                        <div class="row">
                            <div class="col-xl-6 col-lg-6 col-md-6 col-sm-6 col-xs-12">
                                <div class="form-group">
                                    <label for="horaInicio">Hora Inicio</label>
                                    <input type="time" step="0" ng-model="dataSearch.horaInicio" class="form-control border-selecr">
                                </div>
                            </div>
                            <div class="col-xl-6 col-lg-6 col-md-6 col-sm-6 col-xs-12">
                                <div class="form-group">
                                    <label for="horaInicio">Hora Fin</label>
                                    <input type="time" step="0" ng-model="dataSearch.horaFin" class="form-control border-selecr">
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-8 col-md-8 col-xs-12">
                        <div class="row ">
                            <div class="col-lg-4 col-md-4 col-sm-12 col-xs-12" ng-if="dataSearch.checkboxTipoClienteFiltro">
                                <div class="form-group">
                                    <label for="tipoCliente">Tipo Cliente</label>
                                    <select ng-model="dataSearch.byTipoCliente" class="form-control">
                                        <option ng-value="tc.idTipoClienteProveedor" ng-repeat="tc in tipoClientes">{{tc.descripcion}}</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-lg-4 col-md-4 col-sm-4 col-xs-12" ng-if="dataSearch.checkboxRetencionFiltro">
                                <div class="icheck-info  mt-3">
                                    <input type="radio" ng-model="dataSearch.retencion" ng-value="true" name="checkboxRetencionFiltro" id="checkboxConRetencionFiltro">
                                    <label for="checkboxConRetencionFiltro">Con Retención</label>
                                </div>
                                <div class="icheck-info">
                                    <input type="radio" ng-model="dataSearch.retencion" ng-value="false" name="checkboxRetencionFiltro" id="checkboxSinRetencionFiltro">
                                    <label for="checkboxSinRetencionFiltro">Sin Retención</label>
                                </div>  
                            </div>
                            <div class="col-lg-4 col-md-4 col-sm-4 col-xs-12" ng-if="dataSearch.checkboxDevolucionFiltro">
                                <div class="icheck-info  mt-3">
                                    <input type="radio" ng-model="dataSearch.notaCredito" ng-value="true" name="checkboxDevolucionFiltro" id="checkboxConDevolucionFiltro">
                                    <label for="checkboxConDevolucionFiltro">Con Devolución</label>
                                </div>
                                <div class="icheck-info">
                                    <input type="radio" ng-model="dataSearch.notaCredito" ng-value="false" name="checkboxDevolucionFiltro" id="checkboxSinDevolucionFiltro">
                                    <label for="checkboxSinDevolucionFiltro">Sin Devolución</label>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                </div>
                <div class="row justify-content-between" >                
                    <div class="col-lg-3 col-md-3 col-sm-6 col-xs-12">
                        <div class="form-group">
                            <label for="">Ordenar por</label>
                            <select class="form-control" ng-model="dataSearch.byOrderCampo">
                                <!--Nro Documento -->
                                <option value="fv.nroFactura"   ng-if="dataSearch.codDoc=='FV'">Nro. Factura</option>
                                <option value="ne.nroDocumento" ng-if="dataSearch.codDoc=='NE'">Nro Nota Entrega</option>
                                <option value="nc.nroDocumento" ng-if="dataSearch.codDoc=='NC'">Nro Nota Credito</option>
                                <option value="rv.nroDoc" ng-if="dataSearch.codDoc=='RV'">Nro Retención</option>
                                <option value="pr.nroDocumento" ng-if="dataSearch.codDoc==='PR'">Nro Proforma</option>

                                <!--Fecha Emisiòn-->
                                <option value="fv.fechaEmision" ng-if="dataSearch.codDoc=='FV'">Fecha</option>
                                <option value="ne.fechaEmision" ng-if="dataSearch.codDoc=='NE'">Fecha</option>
                                <option value="nc.fechaEmision" ng-if="dataSearch.codDoc=='NC'">Fecha</option>
                                <option value="rv.fechaEmision" ng-if="dataSearch.codDoc=='RV'">Fecha</option>
                                <option value="pr.fechaEmision" ng-if="dataSearch.codDoc==='PR'">Fecha</option>
                                <option value="doc.fechaEmision" ng-if="dataSearch.codDoc==='FVNE'">Fecha</option>

                                <option value="cl.idCliente">Cliente</option>
                            </select>
                        </div>                        
                    </div>
                    <div class="col-lg-3 col-md-3 col-sm-6 col-xs-12">                       
                        <div class="icheck-info mt-3">
                            <input type="radio" ng-model="dataSearch.byOrder" value='ASC' name="radioByOrder" id="byOrderAsc">
                            <label for="byOrderAsc">Ascendente</label>
                        </div>
                        <div class="icheck-info">
                            <input type="radio" ng-model="dataSearch.byOrder" value="DESC" name="radioByOrder" id="byOrderDesc">
                            <label for="byOrderDesc">Descendente</label>
                        </div>
                    </div>
                    
                    <div class="col-xl-3 col-lg-3 col-md-6 col-sm-4 col-xs-12">
                        <div class="form-group">
                            <label for="tipoFormato">Tipo Formato</label>
                            <div class="icheck-info">
                                <input type="radio" ng-model="dataSearch.byTipoFormato" value="pdf" name="tipoFormato" id="pdf">
                                <label for="pdf">PDF</label>
                            </div>
                            <div class="icheck-info">
                                <input type="radio" ng-model="dataSearch.byTipoFormato" value="excel" name="tipoFormato" id="excel">
                                <label for="excel">EXCEL</label>
                            </div>
                        </div>
                    </div>  
                </div>              

            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary-1" ng-click="filtrarReporteVenta()"><i class="fas fa-search"></i> Buscar</button>
                @* <button type="button" class="btn btn-danger" ng-click="limpiar()"><i class="fas fa-reset"></i> Limpiar</button> *@
                <button type="button" class="btn btn-dark" data-dismiss="modal">&times; Cerrar</button>               
            </div>
        </div>
    </div>
</div>