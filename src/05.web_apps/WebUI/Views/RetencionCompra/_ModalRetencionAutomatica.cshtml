<style>
    .formRetencionAutomatica {
        pointer-events: none;
    }
    .ui-grid-footer-panel {
        height: auto !important;        
    }

    [uib-typeahead-popup].dropdown-menu {
        z-index:999999!important; 
        max-height: 250px;
        overflow-y: auto;   
        width: 50%;     
    }  

    .md-select-menu-container, md-backdrop {
        z-index: 9999 !important;
    }
</style>

<div class="modal-header">               
    <h5 class="modal-title"> Retención de Compra</b></h5>
    <span class="h5 ml-auto">Total: <b>${{$ctrl.data.total}}</b></span>                                                                              
</div>                
<div class="modal-body">
    <div layout-gt-sm="row">
        <md-input-container class="md-block" flex-gt-sm>
            <label>Estab.:</label>
            <md-select name="type" ng-model="$ctrl.data.codEstab" disabled>                    
                <md-option ng-value="item.codEstab" ng-repeat="item in $ctrl.establecimientos">{{item.nombreComercial}}</md-option>
            </md-select>
        </md-input-container>
        
        <md-input-container class="md-block" flex="25" flex-gt-sm>
            <label>Proveedor</label>
            <input ng-model="$ctrl.proveedor.proveedor" disabled>
        </md-input-container> 

        <md-input-container class="md-block" flex="25" flex-gt-sm>
            <label>Nro. Identificación</label>
            <input ng-model="$ctrl.proveedor.numeroIdentificacion" disabled>
        </md-input-container>

        <md-input-container class="md-block" flex="25" flex-gt-sm>
            <label>Dirección</label>
            <input ng-model="$ctrl.proveedor.direccion" disabled>
        </md-input-container>         
    </div>

    <div layout="row">
        <md-input-container class="md-block" flex-gt-sm>             
            <label>Punto Emisión</label>
            <md-select ng-model="$ctrl.data.idPuntoEmision" >
                <md-option ng-value="item.idPuntoEmision" ng-repeat="item in $ctrl.puntosEmision">
                    {{item.ptoEmi}}
                </md-option>                
            </md-select>           
        </md-input-container>   

        <md-input-container flex="25">
            <label>Fecha Emisión</label>
            <input type="date" ng-model="$ctrl.data.fechaEmision" class="form-control select-border">            
        </md-input-container>

        <md-input-container flex="50">
            <label>Observación</label>
            <input ng-model="$ctrl.data.concepto">          
        </md-input-container>
    </div>

    <button type="button" ng-click="$ctrl.recargarDetalleRetencion()" class="btn btn-info btn-sm">
        <i class="mdi mdi-replay"></i> Recargar
    </button>
    <div  ui-grid="$ctrl.gridOptions"
            ui-grid-edit
            ui-grid-resize-columns
            ui-grid-cellNav
            ui-grid-auto-resize
            class="grid">
    </div>                                                    
</div>

<div class="modal-footer">
    <button type="button" ng-click="$ctrl.guardarRetencionCompra()" class="btn btn-success">
        <i class="ti-save"></i> Guardar
    </button>
    <button type="button" class="btn btn-dark" ng-click="$ctrl.closeModal()">&times; Cerrar</button>
</div>