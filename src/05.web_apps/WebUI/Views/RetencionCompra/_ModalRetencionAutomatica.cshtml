<style>
    .formRetencionAutomatica {
        pointer-events: none;
    }
    .ui-grid-footer-panel {
        height: auto !important;        
    }

    [uib-typeahead-popup].dropdown-menu {
        z-index:999999!important; 
        max-height: 250px;
        overflow-y: auto;   
        width: 50%;     
    }  

    .md-select-menu-container, md-backdrop {
        z-index: 9999 !important;
    }
</style>

<div class="modal-header">               
    <h5 class="modal-title"> Retención de Compra N°. <b>{{$ctrl.dataTipoDocumento.nroDocumento}}</b></h5>
    <span class="h5 ml-auto">Total: <b>${{$ctrl.dataTipoDocumento.total}}</b></span>                                                                              
</div>                
<div class="modal-body">
    <div layout-gt-sm="row">
        <md-input-container class="md-block" flex="25" flex-gt-sm>
            <md-select-sucursal  
                set-asignaciones="$ctrl.setAsignaciones(item)"
                edit-data="$ctrl.sucursal"
                scope-parent="$ctrl.scopeParent">
            </md-select-sucursal>
        </md-input-container>

        <md-input-container class="md-block" flex="25" flex-gt-sm>
            <label>Proveedor</label>
            <input ng-model="$ctrl.proveedor.nombreFiscal" disabled>
        </md-input-container> 

        <md-input-container class="md-block" flex="25" flex-gt-sm>
            <label>Nro. Identificación</label>
            <input ng-model="$ctrl.proveedor.numeroIdentificacion" disabled>
        </md-input-container>

        <md-input-container class="md-block" flex="25" flex-gt-sm>
            <label>Dirección</label>
            <input ng-model="$ctrl.proveedor.direccion" disabled>
        </md-input-container>         
    </div>

    <div layout="row">
        <md-input-container flex="25">             
            <md-select-punto-emision
                asignaciones-data="$ctrl.asignacionesData"
                set-item-punto-emision="$ctrl.setItemPuntoEmision(item)"
                edit-data="$ctrl.dataDocumento" 
                scope-parent="$ctrl.scopeParent">
            </md-select-punto-emision>           
        </md-input-container>

        <md-input-container flex="25">
            <label>Fecha Emisión</label>
            <input type="date" ng-model="$ctrl.data.fechaEmision" class="form-control select-border">            
        </md-input-container>

        <md-input-container flex="50">
            <label>Observación</label>
            <input ng-model="$ctrl.data.concepto">          
        </md-input-container>
    </div>

    <button type="button" ng-click="$ctrl.recargarDetalleRetencion()" class="btn btn-info btn-sm">
        <i class="mdi mdi-replay"></i> Recargar
    </button>
    <div  ui-grid="$ctrl.gridOptions"
            ui-grid-edit
            ui-grid-resize-columns
            ui-grid-cellNav
            ui-grid-auto-resize
            class="grid">
    </div>                                                    
</div>

<div class="modal-footer">
    <button type="button" ng-click="$ctrl.guardarRetencionCompra()" class="btn btn-success">
        <i class="ti-save"></i> Guardar
    </button>
    <button type="button" class="btn btn-dark" ng-click="$ctrl.closeModal()">&times; Cerrar</button>
</div>