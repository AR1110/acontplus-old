@{
    ViewData["Title"] = "Index";
}
<div ng-controller="documentoElectronicoCtrl">
    @* <div class="card">
    <div class="card-body">
    <div class="table-responsive">
    <table class="table">
    <thead>
    <tr>
    <th>codDoc</th>
    <th>Nro</th>
    </tr>
    </thead>
    <tbody>
    <tr ng-repeat="item in documents">
    <td>{{item.codDoc}}</td>
    <td>{{item.nroDocumento}}</td>
