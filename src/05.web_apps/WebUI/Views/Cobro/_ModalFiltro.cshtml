@* modal-dialog-scrollable *@
<div id="modalCobroFiltro" class="modal fade in" role="dialog" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Búsqueda</h5>
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>

            <div class="modal-body">

                           

                <div class="row justify-content-between">
                    <div class="col-xl-2 col-lg-2 col-md-4 col-sm-12 col-xs-12">
                        <div class="icheck-peterriver">
                            <input type="checkbox" ng-model="dataSearch.checkBoxFecha" ng-change="onChangeFechaFiltro()" id="checkBoxFechaFiltro">
                            <label for="checkBoxFechaFiltro">Fecha</label>
                        </div>
                    </div>
                    <div class="col-xl-2 col-lg-2 col-md-4 col-sm-12 col-xs-12">
                        <div class="icheck-peterriver">
                            <input type="checkbox" ng-model="dataSearch.checkBoxPersona" id="checkBoxPersonaFiltro" ng-disabled="dataSearch.checkBoxDocumento">
                            <label for="checkBoxPersonaFiltro">Persona</label>
                        </div>
                    </div>
                    <div class="col-xl-2 col-lg-2 col-md-4 col-sm-12 col-xs-12">
                        <div class="icheck-peterriver">
                            <input type="checkbox" ng-model="dataSearch.checkBoxUsuario" id="checkBoxUsuarioFiltro">
                            <label for="checkBoxUsuarioFiltro">Usuario</label>
                        </div>
                    </div>
                    <div class="col-xl-2 col-lg-2 col-md-4 col-sm-12 col-xs-12">
                        <div class="icheck-peterriver">
                            <input type="checkbox" ng-model="dataSearch.checkBoxEstado" id="checkBoxEstadoFiltro">
                            <label for="checkBoxEstadoFiltro">Estado</label>
                        </div>
                    </div>

                    <div class="col-xl-2 col-lg-2 col-md-4 col-sm-12 col-xs-12">
                        <div class="icheck-peterriver">
                            <input type="checkbox" ng-model="dataSearch.checkBoxDocumento" ng-change="onChangeDocumentoFiltro()" id="checkBoxDocumentoFiltro">
                            <label for="checkBoxDocumentoFiltro">Documento</label>
                        </div>
                    </div>
                </div>
                <hr> 

                 <div class="row">
                    <div class="colxl-6 col-lg-4 col-md-6 col-sm-12 col-xs-12">
                        <div class="form-group">
                            <label for="establecimiento" >Estab.:</label>                            
                            <select name="establecimiento" id="establecimiento" class="form-control" ng-model="dataSearch.codEstab">
                                <option ng-value="item.codEstab" ng-repeat="item in establecimientos">
                                    {{item.nombreComercial}}
                                </option>                                
                            </select>
                        </div>
                    </div>                    
                </div>   
            
                <!--Fecha -->
                <div class="row" ng-if="dataSearch.checkBoxFecha">                        
                    <div class="col-xl-4 col-lg-4 col-md-4 col-sm-6 col-xs-12">
                        <div class="form-group">
                            <label class="control-label">Mes: </label>
                            <select ng-model="mes" class="form-control" ng-change="getFechaInicioFinFilter(mes)">
                                <option ng-value="{{m.numero}}" ng-repeat="m in meses">{{m.nombre}}</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-xl-4 col-lg-4 col-md-4 col-sm-6 col-xs-12">
                        <div class="form-group">
                            <label>Fecha Inicio:</label>
                            <input type="date" class="form-control" name="fechaInicio" ng-model="dataSearch.fechaInicio"/>
                        </div>
                    </div>
                    <div class="col-xl-4 col-lg-4 col-md-4 col-sm-6 col-xs-12">
                        <div class="form-group">
                            <label>Fecha Fin:</label>
                            <input type="date" class="form-control" name="facheFin" ng-model="dataSearch.fechaFin"/>
                        </div>
                    </div>
                </div>  

                <!--TIPO PERSONA-->
                <div class="row">
                    <div class="col-xl-4 col-lg-4 col-md-6 col-xs-12 col-sm-12" ng-if="dataSearch.checkBoxPersona">
                        <div class="form-group">
                            <label for="">Persona (Cliente/Empleado)</label>
                            <select class="form-control" ng-model="dataSearch.byTipoPersona">
                                <option ng-value="1">Cliente</option>
                                <option ng-value="2">Empleado</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-xl-8 col-lg-8 col-md-6 col-xs-12 col-sm-12" ng-if="dataSearch.checkBoxPersona">                                                                        
                        <div class="form-group" ng-show="dataSearch.byTipoPersona===1">
                            <label for="">Cliente</label>
                            <input type="text"
                                autocomplete="off"                                
                                class="form-control border-select"
                                placeholder="Ingrese C.I o Nombre Fiscal"
                                ng-model="selectedClienteFilter"
                                typeahead-wait-ms="10"
                                ng-keyup="onKeyupSearchClienteFilter()"
                                uib-typeahead="a as a.nombreFiscal for a in clienteSearch($viewValue)"
                                typeahead-loading="data.loadingClienteFiltro"
                                typeahead-no-results="data.noResultsClienteFiltro"
                                typeahead-template-url="autocompleteClienteFiltro.html"
                                typeahead-editable="false"
                                typeahead-on-select="selectedClienteFiltroChange($item)" />

                                <script type="text/ng-template" id="autocompleteClienteFiltro.html">
                                    <div class="autocomplete-suggestion-uib-typeahead">
                                        <span class="item-title">
                                            <b> {{match.model.numeroIdentificacion}}</b> - {{match.model.nombreFiscal}}
                                        </span>
                                    </div>
                                </script>
                        </div>
                        
                        <div class="form-group" ng-show="dataSearch.byTipoPersona===2">
                            <label for="empleado">Empleado</label>
                            <input type="text" 
                                    autocomplete="off"                                    
                                    class="form-control border-select"
                                    placeholder="Buscar Empleado"
                                    ng-model="selectedEmpleadoFiltro"
                                    ng-keyup="onKeyupSearchEmpleadoFiltro()"
                                    uib-typeahead="a as a.nombreCompleto for a in searchEmpleadoFilter($viewValue)"
                                    typeahead-loading="loadingLocations"
                                    typeahead-no-results="data.noResults"
                                    typeahead-template-url="autocompleteEmpleado.html"
                                    typeahead-editable="false"
                                    typeahead-on-select="selectedEmpleadoFiltroChange($item)" />

                                    <script type="text/ng-template" id="autocompleteEmpleado.html">
                                        <div class="autocomplete-suggestion-uib-typeahead">
                                            <span class="item-title">
                                                {{match.model.nombreCompleto}}
                                            </span>
                                        </div>
                                    </script>
                            
                            
                            <small class="text-danger" ng-show="$ctrl.data.noResults">No se encontraron los resultados</small>
                        </div>
                    </div>
                </div>

                <div class="row">                    
                    <div class="col-xl-6 col-lg-6 col-md-6 col-sm-6 col-12" ng-show="dataSearch.checkBoxUsuario">
                        <div class="form-group">
                            <label>Usuario:</label>
                            @await Html.PartialAsync("~/Views/Usuario/_UsuarioSearchFilter.cshtml")
                        </div>
                    </div>

                    <div class="col-xl-6 col-lg-6 col-md-6 col-sm-6 col-12" ng-show="dataSearch.checkBoxEstado">
                        <div class="form-group">
                            <label>Estado:</label>
                            <md-radio-group ng-model="dataSearch.byEstado" aria-labelledby="Estado">
                                <md-radio-button ng-value="1" class="md-primary">Activo</md-radio-button>
                                <md-radio-button ng-value="0">Anulado</md-radio-button>                               
                            </md-radio-group>
                        </div>
                    </div>                    
                </div> 

                <hr ng-if="dataSearch.checkBoxDocumento">

                <div class="row justify-content-between" ng-if="dataSearch.checkBoxDocumento">
                    <div class="col-lg-3">
                        <div class="form-group">
                            <label for="">Tipo Documento</label>
                            <select class="form-control border-select" ng-model="dataSearch.tipoDocumento" ng-change="onChangeTipoDocumento()">
                                <option value="FV">FACTURA DE VENTA</option>
                                <option value="NE">NOTA DE ENTREGA</option>
                            </select>
                        </div>
                    </div>

                    <div class="col-lg-4 col-md-4 col-sm-6 col-xs-12">
                        <div class="form-group">
                            <label for="">Buscar</label>
                            <input type="text" class="form-control border-select" ng-model="dataSearch.txtFiltroDocumento" placeholder="Buscar Documento">
                        </div>
                    </div>
                </div> 

                <div class="row" ng-if="dataSearch.checkBoxDocumento">
                    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                        <div class="table-reponsive" ng-if="dataSearch.tipoDocumento==='FV'">
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th><span>Op.</span></th>
                                        <th><span>Nro. Doc.</span></th>
                                        <th><span>F. Emisión</span></th>                                    
                                        <th><span>Cliente</span></th>
                                        <th><span>Total</span></th>
                                        <th><span>Abono</span></th>
                                        <th><span>Saldo</span></th>
                                        <th><span>Estado</span></th>
                                    </tr>
                                </thead>

                                <tbody>
                                    <tr ng-repeat="f in facturas | filter: dataSearch.txtFiltroDocumento" ng-class="f.style">
                                        <td>                   
                                            <div class="icheck-info">
                                                <input type="radio" name="opcionFiltro" ng-click="onChangeSelectDocumentoFiltro(f)" id="opcionFiltro{{$index+1}}">                                                        
                                                <label for="opcionFiltro{{$index+1}}"></label>
                                            </div>
                                        </td>
                                        <td>{{f.nroFactura}}</td>
                                        <td>{{f.fechaEmision}}</td>                                     
                                        <td>{{f.nombreFiscal}}</td>
                                        <td>${{f.total}}</td>
                                        <td>${{f.abono}}</td>
                                        <td>${{f.saldo}}</td>                                                   
                                        <td>{{f.estadoFinanciero}}</td>                                                   
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                         <div class="table-reponsive" ng-if="dataSearch.tipoDocumento==='NE'">
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th><span>Op.</span></th>
                                        <th><span>Nro. Doc.</span></th>
                                        <th><span>F. Emisión</span></th>                                    
                                        <th><span>Cliente</span></th>
                                        <th><span>Total</span></th>
                                        <th><span>Abono</span></th>
                                        <th><span>Saldo</span></th>
                                        <th><span>Estado</span></th>
                                    </tr>
                                </thead>

                                <tbody>
                                    <tr ng-repeat="ne in notaEntregas | filter: dataSearch.txtFiltroDocumento" ng-class="f.style">
                                        <td>                   
                                            <div class="icheck-info">
                                                <input type="radio" name="opcionFiltro" ng-click="onChangeSelectDocumentoFiltro(ne)" id="opcionFiltro{{$index+1}}">                                                        
                                                <label for="opcionFiltro{{$index+1}}"></label>
                                            </div>
                                        </td>
                                        <td>{{ne.nroDocumento}}</td>
                                        <td>{{ne.fechaEmision}}</td>
                                        <td>{{ne.fechaVencimiento}}</td>
                                        <td>{{ne.nombreFiscal}}</td>
                                        <td>${{ne.total}}</td>
                                        <td>${{ne.abono}}</td>
                                        <td>${{ne.saldo}}</td>
                                        <td>{{ne.estadoFinanciero}}</td>                                                     
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>                                                               
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-info" ng-click="buscarCobro()"><i class="fas fa-search"></i> Buscar</button>
                <button type="button" class="btn btn-dark" data-dismiss="modal">&times; Cerrar</button>
            </div>
        </div>
    </div>
</div>