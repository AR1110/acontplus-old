<h5 class="card-title m-t-0">Datos de Cobro </h5>
<div class="table-responsive">
    <table class="table table-condensed table-sm text-center">
        <thead>
            <tr>
                <th>N°</th>
                <th>F. Emisión</th>
                <th>Sub Entidad</th>                
                <th>Valor</th>
                <th>Número</th>
                <th>Valor Cobrado</th>
                <th>Op.</th>
            </tr>
        </thead>
        <tbody>
            <tr ng-repeat="c in $ctrl.abonoEntidadesFinancieras">
                <td>{{$index+1}}</td>
                <td>{{c.fechaEmision|date:'MM/dd/yyyy  h:mma'}}</td>
                <td><sup>{{c.posFechado?'*':''}}</sup> <span>{{c.subEntidad}}</span></td>                
                <td>{{c.abono|currency:'$'}}</td>
                <td>{{c.nro}}</td>
                <td>{{c.valor|currency:'$'}}</td>
                <td>
                    <button class="btn btn-danger btn-sm" ng-click="$ctrl.askToDeleteAbono(c)"><i class="ti-trash"></i></button>
                </td>

            </tr>
            <tr ng-show="$ctrl.abonoEntidadesFinancieras.length==0">
                <td colspan="7">No hay datos</td>
            </tr>
        </tbody>
    </table>
</div>