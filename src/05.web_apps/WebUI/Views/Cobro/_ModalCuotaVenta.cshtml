<form autocomplete="off">    
    <div class="modal-header bg-info text-white">
        <h4 class="modal-title">Cuotas</h4>
        <button type="button" class="close" ng-click="$ctrl.closeModal()" >&times;</button>
    </div>
    <div class="modal-body">
        <div class="row">
            <div class="col-md-3 col-xs-12 b-r">
                <strong>Cliente:</strong>
                <br>                        
                <p class="text-muted">{{$ctrl.data.razonSocialComprador}}</p>
            </div>
            <div class="col-md-3 col-xs-12 b-r">
                <strong>Nro. Documento:</strong>
                <br>
                <p class="text-muted">{{$ctrl.data.identificacionComprador}}</p>
            </div>
            <div class="col-md-3 col-xs-12 b-r">
                <strong>Fecha Emisión:</strong>
                <br>
                <p class="text-muted">{{$ctrl.data.fechaEmision}}</p>
            </div>
            <div class="col-md-3 col-xs-12 b-r">
                <strong>Total:</strong>
                <h2>${{$ctrl.data.total}}</h2>
            </div>
        </div>
        <md-divider></md-divider>

        <div class="row mt-2">
            <div class="col-lg-5 col-md-5 col-sm-6 col-xs-12">
                <div class="form-group">
                    <label>Tiempo Crédito</label>
                    <div class="input-group">                                
                        <select class="form-control border-select" ng-model="$ctrl.data.idTiempoCredito" ng-disabled="dataTipoDocumento.cobrado" ng-change="$ctrl.onChangeTiempoCredito()">
                            <option ng-value="item.idTiempoCredito" ng-repeat="item in $ctrl.tiempoCreditos">
                                {{item.descripcion}}
                            </option>
                        </select>
                        <div class="input-group-append">
                            <button type="button" ng-click="$ctrl.onChangeTiempoCredito()"
                                    class="btn btn-secondary btn-sm">
                                    <i class=" fas fa-redo fa-xs"></i>
                            </button>
                            @* <button type="button" ng-click="$ctrl.()" ng-disabled="dataTipoDocumento.cobrado" class="btn btn-secondary btn-sm">
                                <i class="fa fa-plus fa-xs"></i>
                            </button> *@
                        </div>
                    </div>                            
                </div>
            </div>
            <div class="col-lg-3 col-md-3 col-sm-6 col-xs-12">
                <label>Configurar Fecha: <code>dd/MM/yyyy</code></label>
                <div class="input-group">
                    <input type="date" ng-model="$ctrl.configFecha" name="configFechaCuota" class="form-control border-select" aria-label="Config. Fecha Vencimiento">
                    <div class="input-group-append">                                    
                        <button class="btn btn-info dropdown-toggle" type="button" data-toggle="dropdown" aria-expanded="false">Op.</button>
                        <div class="dropdown-menu">
                            <a class="dropdown-item" ng-click="$ctrl.setNewFechaVcto(true)"  href="javascript:void(0)">Fin Mes</a>
                            <a class="dropdown-item" ng-click="$ctrl.setNewFechaVcto(false)" href="javascript:void(0)">Mismo Dia</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <md-table-responsive>
            <table md-table>
                <thead md-head>
                    <tr md-row>
                        <th md-column><span>N°</span></th>
                        <th md-column><span>Cuota</span></th>
                        <th md-column colspan="2" class="text-center"><span>F. Vencimiento</span></th>
                    </tr>
                </thead>
                <tbody md-body>
                    <tr md-row ng-repeat="c in $ctrl.cuotas">
                        <td md-cell width="100">{{c.nroCuota}}</td>
                        <td md-cell width="100">
                            <!--Input Entrada-->
                            <input type="text" ng-if="c.nroCuota==='E'" valid-number ng-model="c.cxc.cuota" id="valorEntrada" ng-blur="$ctrl.setValorEntrada(c.cxc.cuota)" class="form-control border-select" />
                                    
                            <!--Input Cuota -->
                            <input type="text" ng-if="c.nroCuota!=='E'" id="setValcuota{{c.cxc.idCuotaXCobrar}}" valid-number ng-blur="$ctrl.setValorCuota(c)" ng-model="c.cxc.cuota" class="form-control border-select" />
                        </td>
                        <td md-cell width="100">
                            <span ng-if="c.nroCuota=='E'" class="ml-1">{{c.cxc.fechaVencimiento | date:'dd/MM/yyyy'}}</span>
                            
                            <input type="date" min="2020-01-01" max="2030-12-31" id="fechaVencimiento{{c.cxc.idCuotaXCobrar}}" ng-if="c.nroCuota!=='E'" ng-model="c.cxc.fechaVencimiento" ng-change="$ctrl.setFechaVencimientoCuota(c)" class="form-control border-select" required />
                            <small class="invalid-feedback">Fecha Vcto. no válida </small>
                        </td>
                        <td md-cell width="100">
                            {{$ctrl.getFechaEscritaCuota(c.cxc)}}
                        </td>
                    </tr>  
                    <tr md-row>
                        <td md-cell class="text-right">
                            <h5><strong>Total Cuota: </strong></h5>
                            <h5><strong>Diferencia: </strong></h5>
                        </td>
                        <td md-cell align="left">
                            <h4>${{$ctrl.totalCuota}}</h4>
                            <h4 class="text-danger">${{$ctrl.totalDiferencia}}</h4>
                        </td>
                        <td md-cell></td>
                        <td md-cell></td>
                    </tr>                              
                </tbody>
            </table>
        </md-table-responsive>
                            
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-success" ng-click="$ctrl.onSave()"><i class="ti-save"></i> Guardar</button>
        <button type="button" class="btn btn-dark" ng-click="$ctrl.closeModal()">&times; Cerrar</button>
    </div>
</form>
