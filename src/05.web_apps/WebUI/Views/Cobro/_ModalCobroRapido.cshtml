                        <div class="d-flex flex-column">
                            <span class="entidad">Cliente</span>
                            <span class="text-muted">{{$ctrl.data.razonSocialComprador}}</span>
                            <span class="text-muted">{{$ctrl.data.identificacionComprador}}</span>
                        </div>
                    </div>
                    <div class="d-flex flex-column align-items-start">
                        <span><sup class="font-weight-bold">Total Factura:</sup>
                        <span class="amount ml-1 mr-1">${{$ctrl.data.total}}</span></span>
                        <span><sup class="font-weight-bold">Fecha Emisión:</sup>     
                        <span>{{$ctrl.data.fechaEmision}}</span> </span>
                    </div>
                    @* <div class="d-flex flex-row align-items-center">
                        <sup class="font-weight-bold">Total Factura:</sup>
                        <span class="amount ml-1 mr-1">{{dataTipoDocumento.total |currency:'$'}}</span>
                        <span><b>Fecha Emisión:</b> {{dataTipoDocumento.fechaEmision}}</span>                                    
                    </div>                                                                           *@
                </div>
            </div>
        </div>
        
        <div class="row justify-content-between">
            <div class="col-lg-7 mt-2">                                
                    @* <table class="table table-sm table-bordered text-small">
                        <tr>
                            <td>dd</td>
                            <td>dd</td>
                            <td>dd</td>
                            <td>dd</td>
                        </tr>
                    </table>                                 *@
            </div>
            <div class="col-lg-3">
                <div class="mt-3 align-self-center text-right">
                    <button type="button" class="btn btn-warning" ng-click="$ctrl.openModalCobroDocumento()">Cobro avanzado</button>
                </div>                                                                  
            </div>
        </div>                                               
        <hr />                       
        <div class="row">
            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
