                                            <input type="text" ng-model="$ctrl.cobro.aprobacion"  class="form-control border-select" />
                                    </div>
                                </div>
                                <div class="col-lg-6 col-md-4 col-sm-12 col-xs-12">
                                    <div class="form-group">
                                        <label class="text-muted">Lote <span class="text-danger">*</span></label>
                                        <input type="text" ng-model="$ctrl.cobro.lote"  class="form-control border-select" />
                                    </div>
                                </div>
                            </div>                        
                        </div>
                    </div>

                    <!--TRANSFERENCIAS-->
