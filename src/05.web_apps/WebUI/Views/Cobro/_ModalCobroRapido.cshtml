
                
<div class="modal-header">                    
    <h4 class="modal-title">Cobro {{$ctrl.TIPO_DOC.codigo}} N° <b> {{$ctrl.data.nroDocumento}}</b></h4>
    <button type="button" class="close" ng-click="$ctrl.closeModal()">&times;</button>
</div>
<div class="modal-body">
    <form>
        <div class="row">
            <div class="col-lg-12">
