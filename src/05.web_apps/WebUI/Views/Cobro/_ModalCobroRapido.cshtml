                                <td class="padding-20 " align="right">
                                    <h4> {{$ctrl.cobro.valorCambio|currency:$}}</h4>
                                </td>
                            </tr>
                        
                        </tbody>
                    </table>
                </div>                                
            </div>
        </div>


        <div class="row mt-2">
            <div class="col-md-4"></div>
            <div class="col-md-4 d-flex justify-content-end">
                
            </div>
            <div class="col-md-4"></div>
        </div>
    </form>
</div>
<div class="modal-footer">
    <button type="button" autofocus id="btnSaveCobroRapido" class="btn btn-success" ng-click="$ctrl.onSave()"><i class="ti-save"></i> Guardar</button>
    <button type="button" class="btn btn-dark" ng-click="$ctrl.closeModal()">&times; Cerrar</button>
</div>
           