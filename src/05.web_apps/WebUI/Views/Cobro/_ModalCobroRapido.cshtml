                    <a href="javascript:void(0)" data-toggle="list" class="list-group-item list-group-item-action"
                        ng-class="ef.codigo=='EFE'?'active':''" 
                        ng-show="ef.codigo!=='DOC'"
                        ng-repeat="ef in $ctrl.entidadesFinancieras"
                        ng-click="$ctrl.tabEntidadFinanciera(ef)">
                        <small>{{ef.descripcion}}</small>
                    </a>                                       
                </div>                                               

                <div class="tab-content border border mt-2">
                    <!--EFECTIVO-->
                    <div class="tab-pane active" role="tabpanel" ng-show="$ctrl.entidadFinanciera.codigo==='EFE'">
                        <div class="p-20">
                            <div class="row">
                                <div class="col-lg-4 col-md-4 col-sm-6 col-xs-12">
                                    <div class="form-group">
                                        <label class="text-muted">SubEntidad Financiera <span class="text-danger">*</span></label>
                                        <select class="form-control border-select" ng-model="$ctrl.subEntidad">
                                            <option ng-value="se" ng-repeat="se in $ctrl.subEntidades">{{se.descripcion}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-lg-4 col-md-4 col-sm-6 col-xs-12">
                                    <div class="form-group">
                                        <label class="control-label">Fecha Emisión</label>
                                        <input type="date" ng-model="$ctrl.cobro.fechaEmision" ng-required="true" class="form-control border-select">
                                    </div>
                                </div>
                                <div class="col-lg-4 col-md-4 col-sm-12 col-xs-12">
                                    <div class="form-group">
                                        <label class="text-danger">Valor a cancelar</label>
                                        <input type="text" ng-model="$ctrl.cobro.valorAbono" ng-keyup="$ctrl.setValorEfectivo()"  class="form-control border-select" ng-enter="$ctrl.onSave()"
                                                ng-required="true" valid-number
                                                placeholder="0.00" />
                                    </div>
                                </div>                                            
                            </div>            
                        </div>
                    </div>

                    <!--TARJETA-->
                    <div class="tab-pane active" role="tabpanel" ng-show="$ctrl.entidadFinanciera.codigo==='TAR'">
                        <div class="p-20">
                            <div class="row">
                                <div class="form-group col-lg-4">
                                    <label class="text-muted">SubEntidad Financiera <span class="text-danger">*</span></label>
                                    <select class="form-control border-select" ng-model="$ctrl.subEntidad">
                                        <option ng-value="se" ng-repeat="se in $ctrl.subEntidades">{{se.descripcion}}</option>
                                    </select>                                                
                                </div>                                            
                                <div class="form-group col-lg-4">
                                    <label class="control-label">Fecha Emisión</label>
                                    <input type="date" ng-model="$ctrl.cobro.fechaEmision" ng-required="true" class="form-control border-select">                                                
                                </div>
                                <div class="form-group col-lg-4">
                                    <label>Valor</label>
                                    <input type="text" ng-model="$ctrl.cobro.valorAbono" ng-keyup="$ctrl.setValorEfectivo()" class="form-control border-select" ng-required="true" valid-number  ng-enter="$ctrl.onSave()"
                                                placeholder="0.00" />                                                
                                </div>
                            </div>
                            <div class="row">
                                <div class="form-group col-lg-4">
                                    <label class="text-muted">Número <span class="text-danger">*</span></label>
                                    <input type="text" ng-model="$ctrl.cobro.nro"  class="form-control border-select" />                                               
