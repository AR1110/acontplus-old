                                <div class="form-group col-lg-4">
                                    <label>Ciudad: <span class="text-danger">*</span></label>                                                    
                                    <select class="form-control border-select" ng-model="$ctrl.cobro.idCiudad" id="ciudad"
                                            ng-options="cp.idCiudad as cp.descripcion group by cp.provincia.descripcion for cp in $ctrl.ciudadPronvincias">
                                    </select>                                                                                                  
                                </div>
                                <div class="form-group col-lg-4">
                                    <label>Referencia: <span class="text-danger">*</span></label>
                                    <input type="text" ng-model="$ctrl.cobro.referencia" class="form-control border-select" />                                                                                            
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-lg-6 col-md-4 col-sm-12 col-xs-12">
