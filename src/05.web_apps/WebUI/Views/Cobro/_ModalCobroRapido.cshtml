                                        </div>                                                            
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                    <div class="form-group">
                                        <label for="">Dirigido a:</label>
                                        <input type="text" class="form-control border-select" ng-model="$ctrl.cobro.referencia">
                                    </div>
                                </div>
                            </div>              
                        </div>
                    </div>
                </div>                                
            </div>
        </div>

        <div class="row justify-content-center mt-1">                           
            <div class="col-lg-4">
                <div class="table-responsive">
                    <table class="table table-condensed table-no-bordered table-sm" width="100%">
                        <tbody>
                            <tr class="table-danger" ng-show="$ctrl.cobro.abonoAnterior>0">
                                <td align="left"><h4>Abono Anterior</h4></td>
                                <td align="right"><h4>${{$ctrl.cobro.abonoAnterior}}</h4></td>
                            </tr>
                            <tr>
                                <td align="left"><h4><b>Saldo: </b></h4></td>
                                <td class="padding-20 " align="right">
                                    <h4> {{$ctrl.cobro.valorSaldo|currency:$}}</h4>
                                </td>
                            </tr>

                            @* <tr>
                                <td align="left"><h4><b>Valor: </b></h4></td>
                                <td class="padding-20 " align="right"><h4> {{cobro.valorAbono |currency:$}}</h4></td>
