                                    </select>                                                
                                </div>                                            
                                <div class="form-group col-lg-4">
                                    <label class="control-label">Fecha Emisión</label>
                                    <input type="date" ng-model="$ctrl.cobro.fechaEmision" ng-required="true" class="form-control border-select">                                                
                                </div>
                                <div class="form-group col-lg-4">
                                    <label>Valor Abono</label>
                                    <input type="text" ng-model="$ctrl.cobro.valorAbono" ng-keyup="$ctrl.setValorEfectivo()"  class="form-control" ng-required="true" valid-number  ng-enter="$ctrl.onSave()"
