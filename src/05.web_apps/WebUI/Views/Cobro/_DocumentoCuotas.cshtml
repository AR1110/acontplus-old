<div class="table-responsive">
    <table class="table table-condensed table-sm text-center">
        <thead>
            <tr>
                <th></th>
                <th>N°</th>
                <th>N°. Doc</th>
                <th>T. Doc.</th>
                <th>F. Emisión</th>
                <th>Total</th>
            </tr>
        </thead>
        <tbody>
            <tr ng-repeat-start="item in $ctrl.selectedDocumentos" ng-click="$ctrl.expandDetalle(item)" class="table-success">
                <td>
                    <span ng-if="item.showCuota"><i class="fas fa-caret-square-down"></i></span>
                    <span ng-if="!item.showCuota"><i class="fas fa-caret-square-right"></i></span>
                </td>
                <td>{{$index+1}}</td>
                <td>{{item.nroDocumento}}</td>
                <td>{{item.tipoDocumento}}</td>
                <td>{{item.fechaEmision}}</td>
                <td>{{item.total|currency:'$'}}</td>
            </tr>

            <tr ng-show="item.showCuota" ng-repeat-end="">
                <td colspan="6">
                    <div class="justify-content-center mr-2 ml-2">
                        <div class="table-responsive" width="100%">
                            <table class="tabla-cuota table table-no-bordered text-center">
                                <thead>
                                    <tr>
                                        <th>N°.</th>
                                        <th>Cuota</th>
                                        <th>Abono</th>
                                        <th>Abono Pos</th>
                                        <th>Saldo</th>
                                        <th>Mora</th>
                                        <th>T. Interes</th>
                                        <th>F. Vcto</th>
                                        <th>Estado</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr ng-repeat="c in item.cuotas">
                                        <td>{{c.nroCuota}}</td>
                                        <td class="txt-oflo">{{c.cxc.cuota|currency:'$'}}</td>
                                        <td class="text-muted">{{c.abono|currency:'$' }}</td>
                                        <td>{{c.abonoPosfechado|currency:'$'}}</td>
                                        <td>{{c.saldo |currency:'$' }}</td>
                                        <td>{{c.diasMoraView}}</td>
                                        <td>{{c.totalMasInteres|currency:'$'}}</td>
                                        <td>{{c.cxc.fechaVencimiento}}</td>
                                        <td width="130px"><code>{{c.estadoFinanciero}}</code></td>
                                        <td>
                                            <a uib-popover-template="'viewPopoverAbonoCuota'" ng-click="$ctrl.viewCuotaAbonos(c)" ng-show="(c.abono>0||c.abonoPosfechado>0) && c.cuotaAfectado" popover-trigger="'outsideClick'" popover-placement="top" href="javascript:void(0)" class="text-dark ">
                                                <i  class="ti-eye"></i>
                                            </a>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </td>
            </tr>
        </tbody>
    </table>
</div>