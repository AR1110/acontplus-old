@{
    ViewData["title"]="Gestión de Cobros";
}

<div ng-controller="cobroCtrl">
    <div>
        <div class="row page-titles">
            <div class="col-md-5 align-self-center">
                <h5 class="text-themecolor">Gestión de Cobros</h5>
            </div>
            <div class="col-md-7 align-self-center text-right">
                <div class="d-flex justify-content-end align-self-center">
                    <button class="btn btn-info m-l-15" ng-if="accion.leer && accion.crear" ng-click="openModalCobroLote()"><i class="fa fa-plus-circle"></i> Nuevo</button>
                </div>
            </div>
        </div>


        @await Html.PartialAsync("~/Views/Cobro/_ModalFiltro.cshtml")    

        <div class="row">
            <div class="col-lg-12">
                <div class="card">
                    <div class="card-body">
                        <md-toolbar class="md-table-toolbar md-default">
                            <div class="md-toolbar-tools">
                                <div class="col-lg-9 col-md-9 col-sm-1">
                                    <button type="button" class="btn btn-info" ng-click="openModalFiltro()"><i class="fa fa-filter"></i> Filtro</button>
                                </div>
                                <div class="col-lg-3 col-md-3 col-sm-12 col-xs-12">
                                    <form class="form-material">
                                        <div class="input-group">
                                            <input type="text" class="form-control" ng-model="buscar" placeholder="Buscar cobros" />
                                            <div class="input-group-append">
                                                <button class="btn btn-secondary btn-xs" ng-click="getCobros()">
                                                    <i class="fas fa-redo"></i>
                                                </button>
                                            </div>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </md-toolbar>
                        <md-divider></md-divider>
                        <md-table-container style="max-height: 400px;">
                            <table resize md-table>
                                <thead fix-head  md-head>
                                    <tr md-row>
                                        <th md-column>Op.</th>
                                        @* <th md-column>N°</th> *@
                                        <th md-column>N°. Doc. </th>
                                        <th md-column md-order-by="fechaEmision">F. Emision</th>
                                        @* <th md-column>N°. Identificación</th> *@
                                        <th md-column>Cliente</th>
                                        <th md-column>Total</th>                    
                                        <th md-column>Abono</th>                    
                                        <th md-column>Cambio</th>                    
                                        <th md-column>Estado</th>
                                        <th md-column>Usuario</th>
                                    </tr>
                                </thead>
                                <tbody md-body>
                                    <tr md-row ng-repeat="c in cobros | filter: buscar" ng-class="c.style">
                                        <td md-cell>
                                            <div class="dropdown h-2">
                                                <button class="btn btn-default " type="button" id="dropdownMenu" data-toggle="dropdown" data-boundary="viewport" aria-haspopup="true" aria-expanded="false">
                                                    <i class="fa fa-bars"></i>
                                                </button>
                                                <div class="dropdown-menu"  aria-labelledby="dropdownMenu">
                                                    <button class="dropdown-item" type="button" ng-if="accion.leer" ng-click="openModalHistorialCobro(c)"><i class="ti-menu"></i> Detalle</button>                                                        
                                                    <button class="dropdown-item" type="button" ng-if="accion.anular" ng-disabled="c.color==='table-danger'" ng-click="askToDelete(c)"><i class="ti-na"></i> Anular</button>                                                                                                                                            
                                                    <button class="dropdown-item" type="button" ng-if="accion.reporte" ng-click="getReport(c)"><i class="ti-file"></i> Reporte</button>                                                               
                                                </div>
                                            </div>                          
                                        </td>
                                        @* <td md-cell>{{$index+1}}</td> *@
                                        <td md-cell>{{c.nroDoc}}</td>
                                        <td md-cell>{{c.fechaRegistro}}</td>
                                        @* <td md-cell>{{c.nroIdentificacion}}</td> *@
                                        <td md-cell>{{c.cliente|uppercase}}</td>
                                        <td md-cell>${{c.total}}</td>
                                        <td md-cell>${{c.abono}}</td>
                                        <td md-cell>${{c.cambio}}</td>
                                        <td md-cell>{{c.estado}}</td>
                                        <td md-cell>{{c.usuario}}</td>
                                    </tr>
                                    <tr ng-show="cobros.length==0" class="text-center">
                                        <td colspan="8">                        
                                            <span>No hay registros en esta tabla:)</span>                        
                                        </td>
                                    </tr>
                                </tbody>
                                <tfoot md-foot>
                                    <tr md-row>
                                        <td md-cell colspan="6">Total:</td>
                                        <td md-cell></td>
                                        <td md-cell></td>                  
                                        <td md-cell></td>                  
                                    </tr>
                                </tfoot>
                            </table>
                        </md-table-container> 
                    </div>
                </div>                
            </div>
        </div>  


        @await Html.PartialAsync("~/Views/Cobro/_ModalHistorialCobro.cshtml")    

    </div>
</div>



@section Scripts{    
    <script src="~/js/contabilidad/controllers/cobroCtrl.min.js" asp-append-version="true"></script>

    <script type="text/ng-template" id="asideSubTotalPago">
        <div class="table-responsive">
            <table class="table table-condensed table-sm">                
                <tbody>
                    <tr>
                        <td class="left"><h3><strong>Total</strong></h3></td>
                        <td class="right"><h3>{{$ctrl.cobro.total|currency:'$'}}</h3></td>
                    </tr>
                     <tr ng-show="$ctrl.cobro.totalAbonoAnterior>0">
                        <td class="left"><strong>Abono Anterior</strong></td>
                        <td class="right"><h4><span class="badge badge-info">{{$ctrl.cobro.totalAbonoAnterior|currency:'$'}}</span></h4></td>
                    </tr>
                    
                    <tr>
                        <td class="left"><strong>Abono</strong></td>
                        <td class="right"><h4>{{$ctrl.cobro.abono - $ctrl.cobro.abonoPosfechado|currency:'$'}}</h4></td>
                    </tr>
                    <tr ng-show="$ctrl.cobro.totalAbonoPosfAnterior>0">
                        <td class="left"><strong>Abono Posf. Anterior</strong></td>
                        <td class="right"><h4><span class="badge badge-danger">{{$ctrl.cobro.totalAbonoPosfAnterior|currency:'$'}}</span><h4></td>
                    </tr>
                    <tr>
                        <td class="left"><strong>Abono Posf.</strong></td>
                        <td class="right"><h4>{{$ctrl.cobro.abonoPosfechado|currency:'$'}}</h4></td>
                    </tr>
                    <tr>
                        <td class="left"><strong>Total Abono</strong></td>
                        <td class="right"><h4><strong>{{$ctrl.cobro.totalAbono | currency:'$'}}</strong></h4></td>
                    </tr>
                    <tr>
                        <td class="left"><strong>Saldo</strong></td>
                        <td class="right"><h4><strong>{{$ctrl.cobro.saldo|currency:'$'}}</strong></h4></td>
                    </tr>
                    <tr>
                        <td class="left"><h3 class="text-danger">Cambio</h3></td>
                        <td class="right"><h3 class="text-danger">{{$ctrl.cobro.valorCambio}}</h3></td>
                    </tr>
                </tbody>
            </table> 
        </div>    
    </script>

    <script type="text/ng-template" id="viewPopoverAbonoCuota">
        <div class="table-responsive">
            <table class="table table-no-bordered  text-center">
                <thead>
                    <tr>
                        <th>Cuota</th>
                        <th>Abono</th>
                        <th>Saldo</th>
                        <th>PosF.</th>
                    </tr>
                </thead>
                <tbody>
                    <tr ng-repeat="c in $ctrl.abonoCuotas" class="text-muted">
                        <td>{{c.cuota|currency:'$'}}</td>
                        <td>{{c.cobroDetalle.abono|currency:'$'}}</td>
                        <td>{{c.saldo|currency:'$'}}</td>
                        <td>{{c.isPosfechado?'SI':'NO'}}</td>
                    </tr>

                </tbody>
            </table>
        </div>
    </script>


}