@{
    ViewData["title"] = "Gestión de Cobros";
}

<div ng-controller="cobroCtrl">
    <div>
        <div class="row page-titles">
            <div class="col-md-5 align-self-center">
                <h5 class="text-themecolor">Gestión de Cobros</h5>
            </div>
            <div class="col-md-7 align-self-center text-right">
                <div class="d-flex justify-content-end align-self-center">
                    <button class="btn btn-info m-l-15" ng-if="accion.leer && accion.crear"
                        ng-click="openModalCobroLote()"><i class="fa fa-plus-circle"></i> Nuevo</button>
                </div>
            </div>
        </div>


        @await Html.PartialAsync("~/Views/Cobro/_ModalFiltro.cshtml")

        <div class="row">
            <div class="col-lg-12">
                <div class="card">
                    <div class="card-body">
                        <md-toolbar class="md-table-toolbar md-default">
                            <div class="md-toolbar-tools">
                                <div class="col-lg-9 col-md-9 col-sm-1">
                                    <button type="button" class="btn btn-info" ng-click="openModalFiltro()"><i
                                            class="fa fa-filter"></i> Filtro</button>
                                </div>
                                <div class="col-lg-3 col-md-3 col-sm-12 col-12">
                                    <form class="form-material">
                                        <div class="input-group">
                                            <input type="text" class="form-control" ng-model="buscar"
                                                placeholder="Buscar cobros" />
                                            <div class="input-group-append">
                                                <button class="btn btn-secondary btn-xs" ng-click="getCobros()">
                                                    <i class="fas fa-redo"></i>
                                                </button>
                                            </div>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </md-toolbar>
                        <md-divider></md-divider>
                        <md-table-container style="max-height: 400px;">
                            <table resize md-table>
                                <thead fix-head md-head>
                                    <tr md-row>
                                        <th md-column>Op.</th>
                                        @* <th md-column>N°</th> *@
                                        <th md-column>N°. Doc. </th>
                                        <th md-column md-order-by="fechaEmision">F. Emision</th>
                                        @* <th md-column>N°. Identificación</th> *@
                                        <th md-column>Cliente</th>
                                        <th md-column>Total</th>
                                        <th md-column>Abono</th>
                                        <th md-column>Cambio</th>
                                        <th md-column>Estado</th>
                                        <th md-column>Usuario</th>
                                    </tr>
                                </thead>
                                <tbody md-body>
                                    <tr md-row ng-repeat="c in cobros | filter: buscar" ng-class="c.style">
                                        <td md-cell>
                                            <md-menu>
                                                <md-button aria-label="Open demo menu" class="md-icon-button"
                                                    ng-click="$mdMenu.open($event)">
                                                    <icon class="mdi mdi-menu"></icon>
                                                </md-button>
                                                <md-menu-content class="md-dense">
                                                    <md-menu-item>
                                                        <md-button ng-click="openModalCobroDetalle($event, c)">
                                                            <span md-menu-align-target><i class="ti-menu"></i>
                                                                Detalle</span>
                                                        </md-button>
                                                    </md-menu-item>

                                                    <md-menu-item>
                                                        <md-button ng-if="accion.anular" ng-click="askToDelete(c)"
                                                            ng-disabled="c.esAnulado">
                                                            <span md-menu-align-target>
                                                                <i class="ti-na"></i> Anular
                                                            </span>
                                                        </md-button>
                                                    </md-menu-item>

                                                    <md-menu-item>
                                                        <md-button ng-if="accion.reporte" ng-click="getReport(c)"
                                                            ng-disabled="c.esAnulado">
                                                            <span md-menu-align-target>
                                                                <i class="ti-file"></i> Reporte
                                                            </span>
                                                        </md-button>
                                                    </md-menu-item>

                                                    <md-menu-item ng-if="accion.enviarCorreo">
                                                        <md-button btn-send-to-email params="c" type-send="typeSend"
                                                            get-param-to-send-mail="getParamToSendMail(params)">
                                                            <span md-menu-align-target><i class="far fa-envelope"></i>
                                                                Enviar Correo</span>
                                                        </md-button>
                                                    </md-menu-item>

                                                    <md-menu-item>
                                                        <md-button uib-tooltip="Enviar por Whatsapp"
                                                            tooltip-placement="top" btn-send-to-whats-app params="c"
                                                            has-permission="hasPermissions" type-send="typeSend">
                                                            <span md-menu-align-target>
                                                                <i class="mdi mdi-whatsapp"></i> Enviar por Whatsapp
                                                            </span>
                                                        </md-button>
                                                    </md-menu-item>

                                                </md-menu-content>
                                            </md-menu>
                                        </td>
                                        @* <td md-cell>{{$index+1}}</td> *@
                                        <td md-cell>{{c.nroDoc}}</td>
                                        <td md-cell>{{c.fechaRegistro}}</td>
                                        @* <td md-cell>{{c.nroIdentificacion}}</td> *@
                                        <td md-cell>{{c.cliente|uppercase}}</td>
                                        <td md-cell>${{c.total}}</td>
                                        <td md-cell>${{c.abono}}</td>
                                        <td md-cell>${{c.cambio}}</td>
                                        <td md-cell>{{c.estado}}</td>
                                        <td md-cell>{{c.usuario}}</td>
                                    </tr>
                                    <tr ng-show="cobros.length==0" class="text-center">
                                        <td colspan="8">
                                            <span>No hay registros en esta tabla:)</span>
                                        </td>
                                    </tr>
                                </tbody>
                                <tfoot md-foot>
                                    <tr md-row>
                                        <td md-cell colspan="6">Total:</td>
                                        <td md-cell></td>
                                        <td md-cell></td>
                                        <td md-cell></td>
                                    </tr>
                                </tfoot>
                            </table>
                        </md-table-container>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>



@section Scripts{
    <script src="~/js/contabilidad/controllers/cobroCtrl.min.js" asp-append-version="true"></script>
}