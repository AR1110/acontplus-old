                                                                                    <th>Saldo</th>
                                                                                </tr>
                                                                            </thead>
                                                                            <tbody>
                                                                                <tr ng-repeat="c in c.cobroDetalles">
                                                                                    <td>{{c.nroCuota}}</td>
                                                                                    <td>{{c.fechaVencimiento}}</td>
                                                                                    <td>${{c.cuota}}</td>
                                                                                    <td>${{c.saldoAnterior}}</td>
                                                                                    <td>${{c.cobroDetalle.abono}}</td>
