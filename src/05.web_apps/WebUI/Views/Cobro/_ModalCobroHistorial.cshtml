                                                            <th></th>
                                                            <th>N°</th>
                                                            <th>PosF.</th>
                                                            <th>Fecha</th>
                                                            <th>Forma Cobro</th>
                                                            <th>Número</th>
                                                            <th>Banco</th>                                                                    
                                                            <th>Valor</th>
                                                            <th>Abono</th>
                                                            <th>Estado</th>                                                                    
                                                        </tr>
                                                    </thead>
