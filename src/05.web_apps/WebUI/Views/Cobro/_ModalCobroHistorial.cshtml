                                                        @* class="{{c.showDetalle?'table-primary':''}}" *@
                                                        <tr ng-repeat-start="c in hc.cobros" class="{{c.showDetalle?'table-primary':''}}">
                                                            <td ng-click="$ctrl.getCobroDetalle(c)">
                                                                <span  ng-if="c.showDetalle" class="fas fa-minus-circle"></span>
                                                                <span ng-if="!c.showDetalle" class="fas fa-plus-circle" ></span>
                                                            </td>
                                                            <td>{{$index+1}}</td>
                                                            <td>{{c.posfechado}}</td>
                                                            <td>{{c.cobro.fechaEmision}}</td>
                                                            <td>{{c.subEntiadaFinanciera}}</td>
                                                            <td>{{c.nroTransaccion}}</td>
                                                            <td>{{c.banco}}</td>
                                                            <td>${{c.cobro.valor}}</td>
                                                            <td>${{c.cobro.abono}}</td>
                                                            <td>{{c.cobroEstado}}</td>
                                                        </tr>
                                                        <tr ng-show="c.showDetalle" ng-repeat-end="">                                                                    
