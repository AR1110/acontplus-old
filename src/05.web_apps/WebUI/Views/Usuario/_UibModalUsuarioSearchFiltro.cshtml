<!--Se usa en Filtro Factura Venta, NotaEntrega, proforma-->
<input type="text" class="form-control border-select" 
        ng-model="$ctrl.usuarioSearchFiltro.nombreCompleto"
        ng-keyup="$ctrl.onKeyupUsuarioSearchFiltro()"
        uib-typeahead="u as u.nombreCompleto for u in $ctrl.usuarioSearchDynamic($viewValue)"
        typeahead-editable="false" 
        placeholder="Buscar Usuario"
        autocomplete="off"
        typeahead-template-url="usuarioSearchFiltroTemplate.html"
        typeahead-no-results="$ctrl.usuarioSearchFiltro.noResults"
        typeahead-on-select="$ctrl.selectedUsuarioSearchFiltro($item)">

        <script type="text/ng-template" id="usuarioSearchFiltroTemplate.html">
            <div class="autocomplete-suggestion-uib-typeahead">
                <span class="item-title">
                    {{match.model.nombreCompleto}}</b>
                </span>
            </div>
        </script>
                
        <span class="ml-5" ng-if="$ctrl.usuarioSearchFiltro.loading"> <i class="fas fa-sync-alt fa-xs"></i> Loading...</span>
        <small class="text-danger ml-5" ng-if="$ctrl.usuarioSearchFiltro.noResults">No se encontraron resultados</small>