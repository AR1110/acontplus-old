
@{
    ViewData["Title"] = "Index";
}
<div ng-controller="usuarioCtrl">
    <div class="row page-titles">
        <div class="col-md-5 align-self-center">
            <h4 class="text-themecolor">Gestión de Usuarios</h4>
        </div>
        <div class="col-md-7 align-self-center text-right">
            <div class="d-flex justify-content-end align-items-center">
                @*<ol class="breadcrumb">
                        <li class="breadcrumb-item"><a href="javascript:void(0)">Inicio</a></li>
                        <li class="breadcrumb-item active">Usuario</li>
                    </ol>*@
                <button type="button" ng-if="accion.leer && accion.crear" ng-click="openModalUserNew()" class="btn btn-info d-block d-lg-inline-block m-l-15">
                    <i class="fa fa-plus-circle"></i> Nuevo 
                </button>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card">                
                <div class="card-body">
                    <div class="row justify-content-between">
                        <div class="col-lg-4"></div>
                        <div class="col-lg-4">
                            <form class="form-material">
                                <div class="input-group">
                                    <input type="text" class="form-control" ng-model="txtFilter" placeholder="Buscar Usuario">
                                    <button class="btn btn-secondary btn-sm">
                                        <i class="ti-search"></i>
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                    <!--Lista Usuarios -->
                    <md-table-container style="max-height: 400px;">
                        <table resize md-table>
                            <thead fix-head md-head>
                                <tr md-row>
                                    <th md-column >N°</th>
                                    <th md-column ng-if="accion.editar || accion.eliminar || accion.acceso">Op.</th>
                                    <th md-column> Nro. Identificación</th>
                                    <th md-column >Nombre Completo</th>
                                    <th md-column >Usuario</th>
                                    <th md-column >Correo</th>                
                                </tr>
                            </thead>
                            <tbody md-body>
                                <tr md-row ng-repeat="item in usuarios | filter:txtFilter">                           
                                    <td md-cell>{{$index+1}}</td>
                                    <td md-cell ng-if="accion.editar || accion.eliminar || accion.acceso">                                        
                                        <button class="btn btn-info btn-sm" ng-if="accion.editar" ng-click="openModalUserEdit(item)">
                                            <i class="mdi mdi-pencil"></i>
                                        </button>
                                        <button class="btn btn-danger btn-sm" ng-if="accion.eliminar" ng-click="askToDelete(item)">
                                            <i class="mdi mdi-delete"></i>
                                        </button>
                                        <button class="btn btn-warning btn-sm" ng-if="accion.acceso" tooltip-placement='top' uib-tooltip='Asig. de Establecimientos, Puntos de Emisión, Bodegas y Permisos' ng-click="openModalUserConfig(item)">
                                            <i class="mdi mdi-account-settings-variant"></i>
                                        </button>                                  
                                    </td>
                                    <td md-cell>{{item.nroIdentificacion}}</td>
                                    <td md-cell>{{item.nombreCompleto|uppercase}}</td>
                                    <td md-cell>{{item.nombreUsuario}}</td>
                                    <td md-cell>{{item.correo}}</td>                
                                </tr>
                            </tbody>
                        </table>
                    </md-table-container>
                </div>
            </div>
        </div>
    </div>              
</div>
@section Scripts{
    <script src="~/js/controllers/admin/usuarioCtrl.js" asp-append-version="true" ></script>
}