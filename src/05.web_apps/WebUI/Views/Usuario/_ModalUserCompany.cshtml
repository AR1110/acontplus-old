<div class="modal-header">
    <h5 class="modal-tile">Usuario Entidad</h5>
    <button type="button" class="close" ng-click="$ctrl.closeModal()">&times;</button>
</div>

<div class="modal-body">
    <div class="row">        
        <div class="col-xl-3 col-lg-3 col-md-12 col-sm-12 col-xs-12">
            <div class="card">
                <img class="card-img" src="~/assets/images/user/fondo-user.jpg" height="300" alt="Fondo image">
                <div class="card-img-overlay card-inverse text-white social-profile d-flex justify-content-center">
                    <div class="align-self-center">
                        <img src="~/assets/images/user/user.png" class="img-circle" width="100">
                        <h4 class="card-title mt-2">{{$ctrl._params.nombreCompleto}}</h4>
                        <h6 class="card-subtitle"></h6>
                        <p class="text-white">{{$ctrl._params.nroIdentificacion}} </p>
                    </div>
                </div>
            </div>
            <div class="card">
                <div class="card-body">
                    <small class="text-muted">Correo Electrónico </small>
                    <h6>{{$ctrl._params.correo}}</h6>
                </div>
            </div>
        </div>

        <div class="col-xl-9 col-lg-9 col-md-12 col-sm-12 col-xs-12"> 
            <div class="card border-dark">
                <div class="card-header bg-info">
                    <h6 class="m-b-0 text-white"><i class="fas fa-industry"></i> Entidades</h6>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>N°</th>
                                    <th>Ruc</th>
                                    <th>Entidad</th>
                                    @* <th>Rol</th> *@
                                    <th>Op</th>
                                </tr>
                            </thead>   
                            <tbody>
                                <tr ng-repeat="item in $ctrl.usuarioRoles track by $index">                           
                                    <td>{{$index+1}}</td>
                                    <td>{{item.ruc}}</td>
                                    <td>{{item.razonSocial | uppercase}}</td>
                                    @* <td>{{item.rol|uppercase}}</td>                        *@
                                    <td>                                                                              
                                        <a href="javascript:void(0)" class="btn btn-info btn-sm" ng-click="$ctrl.getEstablecimientos(item)"  tooltip data-toggle="tooltip" data-placement="top" title="Asignación de Sucursales"> <i class="mdi mdi-folder-account"></i>
                                        </a>                               
                                    </td>
                                </tr>
                            </tbody>                         
                        </table>
                    </div>                      
                </div>
            </div>                             
            <hr>

            <div class="card border-dark">
                <div class="card-header bg-success">
                    <h6 class="m-b-0 text-white"><i class="fas fa-tasks"></i> Establecimientos</h6>
                </div>
                <div class="card-body">
                    <h5>{{$ctrl.dataEntidadRol.razonSocial}}</h5>
                    <div class="table-responsive">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>N°</th>
                                    <th>Nombre Comercial</th>
                                    <th>Nro. Estab.</th>
                                    <th>Estado</th>
                                    <th>Predeterminado</th>
                                    <th>Op</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="item in $ctrl.establecimientos">
                                    <td>{{$index+1}}</td>
                                    <td>{{item.nombreComercial}}</td>
                                    <td>{{item.estab}}</td>
                                    <td>
                                        {{item.estado?'Asignada':'No Asignada'}}
                                    </td>
                                    <td>
                                        <md-switch  ng-if="item.estado" ng-model="item.predeterminado" ng-change="$ctrl.onChangePredeterminada(item)" aria-label="Sucursal Predeterminada">                                          
                                        </md-switch>                                       
                                    </td>
                                    <td>                                       
                                        <div class="icheck-info icheck-inline">
                                            <input type="checkbox" ng-model="item.estado" ng-change="$ctrl.asignarEstab(item)" id="checkboxEstab{{$index}}" name="checkboxEstab{{$index}}">
                                            <label for="checkboxEstab{{$index}}"></label>
                                        </div>                                        
                                        <button type="button" ng-if="item.estado" class="btn btn-dark btn-rounded btn-sm" 
                                                ng-click="$ctrl.openModalAsignPtoEmisionAndBodega(item)"
                                                tooltip-placement="top" uib-tooltip="Asignar Pto de Emisión y Bodegas">
                                                <i class="mdi mdi-account-network"></i>
                                        </button>
                                    </td>
                                </tr>
                                <tr ng-if="$ctrl.establecimientos.length===0">
                                    <td colspan="5">
                                        <div class="alert alert-warning text-center" role="alert">
                                            No hay Sucursales Asignadas.                                            
                                        </div>                                   
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>                                        
                </div>
            </div>               
        </div>

    </div>
</div>
<div class="modal-footer">
    <button type="button" ng-click="$ctrl.closeModal()" class="btn btn-dark">&times; Cerrar</button>
</div>