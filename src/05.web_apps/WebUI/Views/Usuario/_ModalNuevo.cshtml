
<form ng-submit="$ctrl.onSave()" autocomplete="off">
    <div class="modal-header bg-success text-white">
        <h5 class="modal-title">Nuevo Usuario</h5>
        <button type="button" class="close" ng-click="$ctrl.closeModal()">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>

    <div class="modal-body">                   
        <div class="row">
            <div class="col-lg-12 col-md-12 col-sm-12">
                <div class="form-group">
                    <label for="nroIdentificacion">Nro. Identificación</label>
                    <input type="text" valid-number ng-model="$ctrl.data.nroIdentificacion" class="form-control border-select" placeholder="1450152325">
                </div>
            </div>
        </div>

        <div class="row">
            <div class="form-group col-lg-6 col-md-6 col-sm-6 col-xs-6">
                <label class="text-muted">Nombres: <span class="text-danger">*</span> </label>
                <input type="text" ng-model="$ctrl.data.nombres" valid-letra touppercase class="form-control border-select" placeholder="Ej: Maria">
            </div>
            <div class="form-group col-lg-6 col-md-6 col-sm-6 col-xs-6">
                <label class="text-muted">Apellidos: <span class="text-danger">*</span></label>
                <input type="text" ng-model="$ctrl.data.apellidos" valid-letra touppercase class="form-control border-select" placeholder="Ej: Znchéz">
            </div>
        </div>                    

        <div class="row">
            <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12">
                <div class="form-group">
                    <label class="text-muted">Email: <span class="text-danger">*</span> </label>
                    <div class="controls">
                        <input type="text" ng-model="$ctrl.data.correo" class="form-control border-select correo" validate-email placeholder="Ej: admin@gmail.com">
                        <small class="invalid-feedback">Email no válido </small>
                    </div>
                </div>
            </div>  

            <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12">
                <div class="form-group">
                    <label class="text-muted">Usuario: <span class="text-danger">*</span></label>
                    <div class="controls">
                        <input type="text" ng-model="$ctrl.data.nombreUsuario" class="form-control border-select" required placeholder="Ej: admin2021">
                    </div>
                </div>
            </div>                      
        </div>
    
        <div class="row">
            <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12">
                <div class="form-group">
                    <label class="text-muted">Contraseña <span class="text-danger">*</span></label>   
                    <div class="input-group">
                        <input type="password" ng-model="$ctrl.data.contrasena" ng-class="$ctrl.classValidPassword" id="passwordUno" name="password" class="form-control border-select password" placeholder="Contraseña">                                
                        <div class="input-group-append">
                            <button type="button" class="btn btn-info" ng-click="$ctrl.verPassword(1)">
                                <i class="ti-eye"></i>
                            </button>
                        </div>
                    </div>                             
                </div>
            </div>

            <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12">
                <div class="form-group">
                    <label class="text-muted">Repite la Contraseña<span class="text-danger">*</span></label> 
                    <div class="input-group">
                        <input type="password" ng-model="$ctrl.data.contrasena1" ng-class="$ctrl.classValidPassword" name="password" id="passwordDos" class="form-control border-select password" placeholder="********">                                                                       
                        <div class="input-group-append">
                            <button type="button" class="btn btn-info" ng-click="$ctrl.verPassword()">
                                <i class="ti-eye"></i>
                            </button>
                        </div>
                        <small class="invalid-feedback">Las contraseñas no coinciden </small>                           
                    </div>                      
                </div>                
            </div>           
        </div>
        
        <div class="row">
            <div class="form-group col-lg-6 col-md-6 col-sm-6 col-xs-6">
                <label class="text-muted">Politica: <span class="text-danger">*</span> </label>
                <select class="form-control" ng-model="$ctrl.data.idPolitica">
                    <option ng-value="item.idPolitica" ng-repeat="item in $ctrl.politicas">{{item.descripcion}}</option>
                </select>
                @* <select class="form-control" ng-model="data.codRol">
                    <option ng-value="item.codRol" ng-repeat="item in roles">{{item.descripcion}}</option>
                </select> *@

            </div>
        </div>
    </div>
    <div class="modal-footer">
        <button type="submit" class="btn btn-success"><i class="ti-save"></i> Guardar</button>
        <button type="button" class="btn btn-dark" ng-click="$ctrl.closeModal()">&times; Cerrar</button>
    </div>
    
</form>


