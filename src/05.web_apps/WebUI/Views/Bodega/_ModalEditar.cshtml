
<form ng-submit="$ctrl.onSave()" autocomplete="off" novalidate>    
    <div class="modal-header bg-info text-white">
        <h5 class="modal-title">Editar Bodega</h5>
        <button type="button" class="close" ng-click="$ctrl.closeModal()">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
    <div class="modal-body">
        <div class="row">
            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                <div class="form-group">
                    <label for="">Sucursal: <span class="text-danger">*</span> </label>
                    <select class="form-control border-select" ng-model="$ctrl.data.codEstab" disabled>
                            <option ng-value="item.codEstab" ng-repeat="item in $ctrl.sucursales">
                                {{item.nombreComercial}}
                            </option>
                    </select>
                </div>
            </div>
            
            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                <div class="form-group">
                    <label for="">Descripción: <span class="text-danger">*</span> </label>
                    <input type="text" ng-model="$ctrl.data.descripcion" touppercase class="form-control border-select" placeholder="BODEGA PRINCIPAL">
                </div>
            </div>

            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                <div class="form-group">
                    <label for="telefono">Teléfono </label>
                    <input type="text" ng-model="$ctrl.data.telefono" class="form-control border-select" valid-number placeholder="0959889748">
                </div>
            </div>

            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                <div class="form-group">
                    <label for="direccion">Dirección </label>
                    <textarea name="textarea" ng-model="$ctrl.data.direccion" touppercase class="form-control border-select" placeholder="AV. 09 DE OCTUBRE"></textarea>
                </div>
            </div>

            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12" ng-if="$ctrl.showEstado">
                <div class="form-group">
                    <label for="">Estado: </label>
                    <md-radio-group ng-model="$ctrl.data.estado">
                        <md-radio-button ng-value="true">Activo</md-radio-button>
                        <md-radio-button ng-value="false">Inactivo</md-radio-button>
                    </md-radio-group>
                </div>
            </div>
        </div>                                                       
    </div>
    <div class="modal-footer">
        <button type="submit" class="btn btn-info">
            <i class="ti-pencil"></i> 
            Actualizar
        </button>
        <button type="button" class="btn btn-dark" ng-click="$ctrl.closeModal()">&times; Cerrar</button>
    </div>
    
</form>

           