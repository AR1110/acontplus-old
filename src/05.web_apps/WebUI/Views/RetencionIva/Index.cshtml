
@{
    ViewData["Title"] = "Index";
}
<div ng-controller="retencionIvaCtrl">
    <div>
        <div class="row page-titles">
            <div class="col-md-5 align-self-center">
                <h4 class="text-themecolor">Gestión de Retencion IVA</h4>
            </div>
            <div class="col-md-7 align-self-center text-right">
                <div class="d-flex justify-content-end align-items-center">
                    @*<ol class="breadcrumb">
                            <li class="breadcrumb-item"><a href="javascript:void(0)">Inicio</a></li>
                            <li class="breadcrumb-item active">Retenciones IVA</li>
                        </ol>*@
                    <button type="button" ng-click="abrirModal(0,1)" ng-if="accion.crear" class="btn btn-info d-none d-lg-block m-l-15">
                        <i class="ti-plus"></i> Nuevo
                    </button>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-lg-9">
                                <span class="form-group pull-left page-size form-inline">
                                    <select class="form-control control-color"
                                            ng-model="pageSize"
                                            ng-change="changePageSize()"
                                            ng-options="ra for ra in recordsQuantity">
                                    </select>
                                </span>
                            </div>
                            <div class="col-lg-3">
                                <input type="text" class="form-control" ng-model="buscar" placeholder="Buscar " />
                            </div>
                        </div>
                        <div class="table-responsive">
                            <table class="table  table-no-bordered ">
                                <thead>
                                    <tr>
                                        <th ng-if="accion.editar || accion.eliminar"></th>
                                        <th>N°</th>
                                        <th>Código</th>
                                        <th>Descripción</th>
                                        <th>Porcentaje</th>
                                        <th>Estado</th>                                    
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr ng-repeat="ri in retencionesIva|filter:buscar">
                                        <td  ng-if="accion.editar || accion.eliminar">
                                            <div class="justify-content-center">
                                                <a href="javascript:void(0)" ng-if="accion.eliminar" ng-click="delete(ri)" tooltip class="text-rojo" data-toggle="tooltip" title="Eliminar"><i class="fa fa-trash"></i></a>
                                                <a href="javascript:void(0)" ng-if="accion.editar" ng-click="abrirModal(ri,2)" tooltip class="text-azul m-l-10" title="Actualizar" data-toggle="tooltip"><i class=" fas fa-edit"></i></a>                                            
                                            </div>
                                        </td>
                                        <td>{{$index+1}}</td>
                                        <td>{{ri.codigo}}</td>
                                        <td>{{ri.descripcion}}</td>
                                        <td>{{ri.porcentaje | currency:'%'}}</td>
                                        <td ng-bind-html="ri.estado| estadoPrimario"></td>                                 
                                    </tr>
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <td align="center" colspan="6">
                                            <div class="pull-left">
                                                <ul uib-pagination total-items="totalRecords" items-Per-Page="pageSize" ng-change="pagechanged()" ng-model="pageIndex" max-size="maxSize" class="pagination" boundary-links="true" rotate="false"></ul>
                                            </div>
                                        </td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="modal fade in" id="agregar" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel1" data-backdrop="static" data-keyboard="true">
            <div class="modal-dialog" role="document">
                <form ng-submit="saveUpdate(type)" class="form-material" autocomplete="off" novalidate>
                    <div class="modal-content">
                        <div class="modal-header {{colorHeader}} text-white">
                            <h5 class="modal-title" id="exampleModalLabel"><i class="{{icono}}"></i>{{tituloModal}}</h5>
                            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                <span aria-hidden="true">&times;</span>
                            </button>
                        </div>
                        <div class="modal-body">
                            <div class="row">
                                <div class="form-group col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                    <label for="">Descripción: <span class="text-danger">*</span> </label>
                                    <div class="controls">
                                        <input type="text" class="form-control" ng-model="data.descripcion" ng-change="obtenerTresLetras(data)" placeholder="" />
                                    </div>
                                </div>
                                <div class="form-group col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                    <label for="">Código: </label>
                                    <input type="text" class="form-control" ng-disabled="data.descripcion==undefined||type==2" ng-model="data.codigo"  placeholder="" />
                                </div>
                                <div class="form-group col-lg-12 col-md-12 col-sm-12 col-xs-12">
                                    <label for="codigo">Porcentaje: <span class="text-danger">*</span></label>
                                    <div class="form-group">
                                        <input type="text" class="form-control" ng-model="data.porcentaje" valid-number>
                                    </div>
                                </div>
                                <div class="form-group col-lg-12 col-md-12 col-sm-12 col-xs-12" ng-show="type==2">
                                    <label for="">Estado: </label>
                                    <md-radio-group ng-model="data.estado">
                                        <md-radio-button ng-value="true">Activo</md-radio-button>
                                        <md-radio-button ng-value="false">Inactivo</md-radio-button>
                                    </md-radio-group>
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="submit" class="btn btn-info"><i class="fa fa-save"></i> Guardar</button>
                            <button type="button" class="btn btn-dark" data-dismiss="modal">&times; Cerrar</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <partial name="PageNotAccessible"/>
</div>
@section Scripts{

    <script src="~/js/controllers/sri/retencionIvaCtrl.min.js" asp-append-version="true"></script>
}