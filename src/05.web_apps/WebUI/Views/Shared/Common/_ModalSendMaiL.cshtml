
<div class="modal-header bg-info text-white">
    <h4 class="modal-title"><i class="mdi mdi-email"></i> Reenvío de Correo</h4>
    <button type="button" class="close" aria-label="Close" ng-click="$ctrl.closeModal()">
        <span aria-hidden="true">&times;</span>
    </button> 
</div>
<div class="modal-body">
    <h6>El Comprobante Nro. <strong>{{$ctrl.data.serie}}</strong> será enviado a los siguientes destinatarios:    
    <md-chips ng-model="$ctrl.correos" md-add-on-blur="true" ng-keyup="$ctrl.onKeyupEmail($event)" md-transform-chip="$ctrl.transformChip($chip)"
        md-removable="true" md-enable-chip-edit="true"  placeholder="Ej: maxi@gmail.com"
        input-aria-label="Correos">
    </md-chips> 
    <small class="text-danger">Si desea ingresar a un destinatario adicional digítele aquí.</small>    
    
</div>
<div class="modal-footer">
    <button   class="btn btn-success" type="button" ng-click="$ctrl.saveResendEmail()">
        <i class="mdi mdi-send"></i> Sí, reenviar
    </button>
    <button  class="btn btn-dark" type="button" ng-click="$ctrl.closeModal()">
        &times; No, cancelar
    </button>
</div>