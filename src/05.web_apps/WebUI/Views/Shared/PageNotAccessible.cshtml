
<section id="wrapper" ng-if="!accion.leer" class="error-page m-t-40">
    <div class="error-box">
        <div class="error-body text-center">
            <h1>Página no accesible</h1>
            <h3 class="text-uppercase">No tienes permiso para acceder a esta página @ViewBag.title!</h3>            
            <a href="/Home/Index" class="btn btn-info btn-rounded waves-effect waves-light m-b-40"><i class="fa fa-arrow-alt-circle-left"></i> Click aquí, para navegar a la página de inicio </a>
        </div>
    </div>
</section>