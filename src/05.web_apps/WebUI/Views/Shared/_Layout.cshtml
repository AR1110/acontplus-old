        <aside class="left-sidebar">
            <!-- Sidebar scroll-->
            <div class="scroll-sidebar" style="overflow: auto;">
                <!-- Sidebar navigation-->
                <nav class="sidebar-nav">
                    <ul id="sidebarnav">


                        <li>
                            <span class="has-arrow waves-effect waves-dark">
                            </span>
                        </li>

                        <li ng-repeat="m in menus">

                            <a class="has-arrow waves-effect waves-dark {{active?'active':''}}" ng-show="!active"
                               ng-click="active=true" href="javascript:void(0)" aria-expanded="false">
                                <i class="{{m.icon}}"></i><span class="hide-menu">{{m.description}}</span>
                            </a>
                            <a class="has-arrow waves-effect waves-dark {{active?'active':''}}" ng-show="active"
                               ng-click="active=false" href="javascript:void(0)" aria-expanded="false">
                                <i class="{{m.icon}}"></i><span class="hide-menu">{{m.description}}</span>
                            </a>
                            <ul ng-repeat="sm in subMenus |orderBy:sm.idSubmenu" aria-expanded="false"
                                class="collapse {{active?'in':''}}" ng-if="m.idMenu==sm.idMenu">
                                <li>
                                    <a href="javascript:void(0)" ng-click="onChangeSubMenu(sm)">
                                        <i class="{{sm.icon}}"></i> <small class="font-15">{{sm.description}}</small>
                                    </a>
                                </li>
                            </ul>
                        </li>
                    </ul>
                </nav>
                <!-- End Sidebar navigation -->
            </div>

            <!-- End Sidebar scroll-->
        </aside>

