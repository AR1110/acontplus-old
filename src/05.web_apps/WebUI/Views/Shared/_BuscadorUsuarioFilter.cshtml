<input  type="text"
        class="form-control border-select" 
        ng-model="modelUsuarioFilter"         
        id="buscadorUsuario"
        uib-typeahead="u for u in searchUsuarioFilter($viewValue)"
        typeahead-editable="false" 
        placeholder="Buscar Usuario" 
        autocomplete="off"
        typeahead-no-results="noResultsUser"
        typeahead-on-select="onChangeSearchUsuario($item)"
         typeahead-template-url="templateUsuarioFilter.html">

<script type="text/ng-template" id="templateUsuarioFilter.html">
  <a class="dropdown-item" style="cursor:pointer;" 
     onMouseOver="this.style.backgroundColor='#0088cc', this.style.color='white'"
     onMouseOut="this.style.backgroundColor='#FFFFFF', this.style.color='black'">              
      <span ng-bind-html="match.label.usuario.nombreCompleto | uibTypeaheadHighlight:query"></span>
  </a>
</script>
        