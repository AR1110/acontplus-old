
@{
    ViewData["title"] = "Consultar Precio";
}
<div ng-controller="consultarPrecioCtrl as $ctrl">
    <div>
        <div class="row page-titles">
            <div class="col-md-5 align-self-center">
                <h4 class="text-themecolor">Consultar Precio</h4>
            </div>

        </div>

        <div class="row">
            <div class="col-lg-12">
                <div class="card">
                    <div class="card-body">
                        <div class="row justify-content-between">
                           <div class="col-xl-6 col-lg-6 col-md-6 col-sm-12 col-xs-12">
                                <div class="form-group">
                                    <label for="">Buscar Artículo</label>
                                    <input type="text" class="form-control border-select" ng-model="$ctrl.dataSearch.busqueda"
                                        ng-keyup="$ctrl.consultarPrecioSearchText()"
                                        ng-keypress="$ctrl.consultarPrecioEnter($event)" 
                                        placeholder="Ingrese la Descripcion o Código del Articulo" />
                                </div>                                                                
                            </div>

                            <div class="col-xl-3 col-lg-3 col-md-3 col-sm-12 col-xs-12">
                                <div class="form-group">
                                    <label for="">Buscar por:</label>
                                    <select class="form-control border-select" ng-model="$ctrl.dataSearch.byColumn" ng-change="$ctrl.querySearchArticulo()">
                                        <option ng-value="item.codigo" ng-repeat="item in $ctrl.tipoBusquedas">
                                            {{item.descripcion}}
                                        </option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-xl-3 col-lg-3 col-md-3 col-sm-12 col-xs-12">
                                <div class="form-group">
                                    <label for="opcion">Opción</label>
                                    <select class="form-control border-select" ng-model="$ctrl.dataSearch.stock" ng-change="$ctrl.querySearchArticulo()">                                        
                                        <option ng-value="0">Todos</option>
                                        <option ng-value="1">Con Stock</option>
                                        <option ng-value="2">Sin Stock</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>     

                    @await Html.PartialAsync("~/Views/ConsultarPrecio/_ListaArticulos.cshtml")
                                
                </div>              
            </div>
        </div>
    </div>
    
</div>
@section Scripts{
   <script  src="~/js/ventas/controllers/consultarPrecioCtrl.js" asp-append-version="true"></script>
   
   
}