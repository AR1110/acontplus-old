<div class="modal-header">
    <h5 class="modal-title">{{$ctrl.tipoRegistro==1?'Nuevo':'Editar'}} Proveedor</h5>
    <button type="button" class="close" ng-click="$ctrl.closeModal()">&times;</button>
</div>                

<div class="modal-body">
    <uib-tabset active="activeForm">
        <uib-tab index="0">
            <uib-tab-heading>
                <i class="mdi mdi-account-circle"></i> Datos Generales
            </uib-tab-heading>
            <div class="card">
                <div class="card-body">
                    <div class="row">
                        <div class="col-xl-3 col-lg-3 col-sm-6 col-12">
                            <div class="form-group">
                                <label>Tipo Identificación</label>
                                <select class="form-control border-select" id="tipoDocumento"
                                        name="tipoDocumento" ng-model="$ctrl.tipoIdentificacion"
                                        ng-change="$ctrl.onChangeTipoIdentificacion()"
                                    ng-disabled="$ctrl.isDisableInputIdentificacion"
                                        ng-options="ti as ti.identificacion for ti in $ctrl.tipoIdentificaciones track by ti.idTipoIdentificacion">
                                </select>
                            </div>
                        </div> 

                        <div class="col-xl-3 col-lg-3 col-sm-6 col-12">
                            <div class="form-group">
                                <label>{{$ctrl.tipoIdentificacion.identificacion}}</label>
                                <input type="text" class="form-control border-select" ng-show="$ctrl.tipoIdentificacion.codigoIdentificacion!=='P'"
                                        name="numeroIdentificacion" id="numeroIdentificacion"
                                        ng-keyup="$ctrl.onKeyupNumeroIndentificacion()"
                                        ng-class="$ctrl.typeNotify" ng-model="$ctrl.data.numeroIdentificacion"
                                    ng-disabled="$ctrl.isDisableInputIdentificacion"
                                        valid-number placeholder="Ej: 2105234568">

                                <input type="text" class="form-control border-select" ng-show="$ctrl.tipoIdentificacion.codigoIdentificacion=='P'"
                                        name="pasaporte"
                                        ng-model="$ctrl.data.numeroIdentificacion"
                                        ng-disabled="$ctrl.tipoRegistro==2"
                                        placeholder="Ej: EH123457">
                                <small class="invalid-feedback">{{$ctrl.message}} </small>
                                <small class="valid-feedback">{{$ctrl.message}} </small>
                            </div>
                        </div>
                        <div class="col-xl-6 col-lg-6 col-sm-12 col-12">
                            <div class="form-group">
                                <label>Contribuyente <span class="text-danger">*</span></label>
                                <select class="form-control border-select" ng-model="$ctrl.data.idSubContribuyente" required="required"
                                        ng-options="sc.subContribuyente.idSubContribuyente as sc.subContribuyente.descripcion group by sc.tipoContribuyente.descripcion for sc in $ctrl.subContribuyentes ">
                                </select>
                            </div>
                        </div>               
                    </div>  

                    <!--Nombre Fiscal-->
                     <div class="row">
                        <div class="col-lg-6 col-md-6 col-sm-12 col-12">
                            <div class="form-group">
                                <label>Nombre Fiscal <span class="text-danger">*</span></label>
                                <input type="text" 
                                        touppercase 
                                        class="form-control border-select" 
                                        autocomplete="off"                        
                                        name="nombreFiscal" 
                                        ng-model="$ctrl.data.nombreFiscal"
                                        ng-keyup="$ctrl.onKeyupNombreFiscal()"
                                        required placeholder="Ej: TECNOMEGA" />
                            </div>
                        </div>
                        <div class="col-lg-6 col-md-6 col-sm-12 col-12">
                            <div class="form-group">
                                <label>Nombre Comercial <span class="text-danger">*</span></label>
                                <input type="text" touppercase class="form-control border-select" autocomplete="off"
                                        ng-model="$ctrl.data.nombreComercial" placeholder="Ej: TECNOMEGA" />
                            </div>
                        </div>
                    </div>    

                    <div class="row">
                        <div class="col-xl-6 col-md-6 col-sm-6 col-12">
                            <div class="form-group">
                                <label>Email: </label>
                                <md-chips ng-model="$ctrl.correos" ng-keyup="$ctrl.onKeyupEmail($event)" md-transform-chip="$ctrl.tranformMdChipsEmail($chip)"
                            md-removable="true" md-enable-chip-edit="true" md-add-on-blur="true" placeholder="Ej: maxi@gmail.com"
                            input-aria-label="Correos"></md-chips>              
                            </div>
                        </div>                           
                        <div class="col-xl-6 col-md-6 col-sm-6 col-12">
                            <div class="form-group">
                                <label>Telefono: </label>                             
                                <md-chips ng-model="$ctrl.telefonos" md-transform-chip="$ctrl.transformC($chip)"
                            md-removable="true" md-enable-chip-edit="true" md-add-on-blur="true"  placeholder="Ej: 0959889744"
                            input-aria-label="Número de teléfonos"></md-chips>                           
                            </div>
                        </div>                           
                    </div>


                    <div class="row">
                        <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">
                            <div class="form-group">
                                <label>Dirección</label>
                                <textarea class="form-control border-select" touppercase ng-model="$ctrl.data.direccion" rows="2" placeholder="AV. 09 DE OCTUBRE..."></textarea>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </uib-tab>
        <uib-tab index="1">
            <uib-tab-heading>
                <i class="mdi mdi-note-plus-outline"></i> Adicional
            </uib-tab-heading>
            <div class="card">
                <div class="card-body">
                    <div class="row">
                        <div class="col-lg-4 col-md-4 col-sm-6 col-12">
                            <div class="form-group">
                                <label>Tipo Proveedor: </label>
                                <select class="form-control border-select" ng-model="$ctrl.data.idTipoClienteProveedor">
                                        <option ng-value="item.idTipoClienteProveedor" ng-repeat="item in $ctrl.tipoClienteProveedores">{{item.descripcion}}</option>
                                </select>
                            </div>
                        </div> 

                        <div class="col-lg-4 col-md-4 col-sm-6 col-12">
                            <div class="form-group">
                                <label>Ciudad: </label>
                                <select class="form-control border-select" ng-model="$ctrl.data.idCiudad"
                                        ng-options="cp.idCiudad as cp.descripcion group by cp.provincia.descripcion for cp in $ctrl.ciudadPronvincias">
                                </select>
                            </div>
                        </div>   

                        <div class="col-lg-4 col-md-4 col-sm-6 col-12">
                            <div class="form-group">
                                <label>Tipo Entidad: </label>
                                <select class="form-control border-select" ng-model="$ctrl.data.idTipoEntidad">
                                        <option ng-value="item.idTipoEntidad" ng-repeat="item in $ctrl.tipoEntidades">{{item.descripcion}}</option>
                                </select>
                            </div>
                        </div>
                    </div> 

                    <div class="row">
                        <div class="col-lg-4 col-md-4 col-sm-6 col-12">                            
                            <div class="form-group">
                                <label>Tiempo de Credito</label>
                                <div class="input-group">                                    
                                    <select class="form-control border-select" ng-model="$ctrl.data.idTiempoCredito">
                                        <option ng-value="item.idTiempoCredito" ng-repeat="item in $ctrl.tiempoCreditos">{{item.descripcion}}</option>
                                        </select>
                                    <div class="input-group-append">
                                        <button type="button" class="btn btn-warning" ng-click="$ctrl.openModalTiempoCredito()"><i class="fas fa-plus fa-xs"></i></button>
                                    </div>
                                </div>
                            </div>
                        </div> 

                        <div class="col-xl-4 col-lg-4 col-md-4 col-sm-4 col-12 text-center" ng-show="$ctrl.tipoRegistro==2">                                                       
                            <div class="form-group">
                                <label>Estado</label> <br> 
                                <div class="radio icheck-primary icheck-inline">
                                <input type="radio" ng-model="$ctrl.data.estado" ng-value="true" id="estadoActivo" name="estadoActivo" />
                                <label for="estadoActivo">Activo</label>
                            </div>
                            <div class="radio icheck-primary icheck-inline">
                                <input type="radio" ng-model="$ctrl.data.estado" ng-value="false" id="estadoInactivo" name="estadoInactivo" />
                                <label for="estadoInactivo">Inactivo</label>
                            </div>   
                            </div>                           
                        </div>

                    </div>
                </div>
            </div>
        </uib-tab>      
    </uib-tabset>        
</div>
<div class="modal-footer">
    <button type="button" ng-click="$ctrl.saveAndUpdate()" class="btn btn-success">
        <i class="{{$ctrl.tipoRegistro==1?'ti-save':'ti-pencil'}}"></i> {{$ctrl.tipoRegistro==1?'Guardar':'Actualizar'}}</button>
    <button type="button" class="btn btn-dark" ng-click="$ctrl.closeModal()">&times; Cerrar</button>
</div>