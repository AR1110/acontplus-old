
@{
    ViewData["Title"] = "Index";
}
<div ng-controller="asignacionImpuestoContribuyenteCtrl">
    <div class="row page-titles">
        <div class="col-md-5 align-self-center">
            <h4 class="text-themecolor">Gestión de Asignación de Impuestos</h4>
        </div>
        <div class="col-md-7 align-self-center text-right">
            <div class="d-flex justify-content-end align-items-center">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="javascript:void(0)">Inicio</a></li>
                    <li class="breadcrumb-item active">Asignación de Impuestos a Contribuyentes</li>
                </ol>
                <button type="button" ng-click="abrirModal(0,1)" class="btn btn-info d-none d-lg-block m-l-15">
                    <i class="fa fa-plus-circle"></i>Agregar
                </button>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <div class="table-responsive">
                        <table id="myTable" class="table table-bordered table-striped ">
                            <thead>
                                <tr>
                                    <th>N°</th>
          
                                    <th>Estado</th>
                                    <th>Acción</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="ri in retencionesIva">
                                    <td>{{$index+1}}</td>
               
                                    <td ng-bind-html="ri.estado| estadoPrimario"></td>
                                    <td class="text-left">
                                        <a class="text-success" ng-click="abrirModal(ri,2)" href="javascript:;" title="Editar"><i class="fa fa-edit"></i></a>
                                        <a class="text-danger" ng-click="deleteRetencionIva(ri)" href="javascript:;" title="Eliminar"><i class="fa fa-trash"></i></a>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="modal fade in" id="agregar" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel1" data-backdrop="static" data-keyboard="true">
                <div class="modal-dialog modal-xl" role="document">
                    <div class="modal-content">
                        <form ng-submit="crudAsignacionImpuestoContribuyente(data.tipoOperacion)" autocomplete="off" novalidate>
                            <div class="modal-content">
                                <div class="modal-header {{colorHeader}} text-white">
                                    <h5 class="modal-title" id="exampleModalLabel"><i class="{{icono}}"></i>{{tituloModal}}</h5>
                                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                        <span aria-hidden="true">&times;</span>
                                    </button>
                                </div>
                                <div class="modal-body">
                                    <div class="row">
                                        <div class="col-md-3">
                                            <div class="form-group">
                                                <label>De Contribuyente Empresa: <span class="text-danger">*</span></label>
                                                <select-contribuyente lista='subContribuyentes' model="subContribuyenteEmpresa" />
                                            </div>
                                        </div>
                                        <div class="col-md-6">                                       
                                            <center><label>Retención de Impuestos: </label></center>
                                            <div class="card bg-secondary ">
                                                <div class="card-body">                                                    
                                                    <div class="row">
                                                        <div class="col-6">
                                                            <label>Impuesto RENTA: </label>
                                                            <div class="custom-control custom-switch">
                                                                <input type="checkbox" ng-model="configuracionContribuyente.renta" class="custom-control-input" id="customSwitch1">
                                                                <label class="custom-control-label" for="customSwitch1"></label>
                                                            </div>
                                                            
                                                        </div>
                                                        <div class="col-md-6 col-sm-6 col-6">
                                                            <label>Impuesto IVA: </label>
                                                            <div class="custom-control custom-switch">
                                                                <input type="checkbox" ng-model="configuracionContribuyente.renta" class="custom-control-input" id="customSwitch1">
                                                                <label class="custom-control-label" for="customSwitch1"></label>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                           
                                        </div>
                                        <div class="col-md-3">
                                            <div class="form-group">
                                                <label>A Contribuyente Proveedor: <span class="text-danger">*</span> </label>
                                                <select-contribuyente lista='subContribuyentes' model="subContribuyenteProveedor" />
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="modal-footer">
                                    <button type="submit" class="btn btn-info"><i class="fa fa-save"></i> Guardar</button>
                                    <button type="button" class="btn btn-secondary" data-dismiss="modal"><i class="fa fa-close"></i>Cancelar</button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>
@section Scripts{

    <script src="~/js/controllers/asignacionImpuestoContribuyenteCtrl.js?v=0.6"></script>
}