<div id="modalFiltroInventario" class="modal fade in" tabindex="-1" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fa-solid fa-shelves"></i> Reporte Inventario</h5>
                <button class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">

                <div class="row justify-content-between">

                    <div class="col-xl-3 col-lg-3 col-md-6 col-sm-12 col-12">
                        <div class="form-group">
                            <select class="form-control" ng-model="dataSearch.byTipoReporte"
                                ng-change="onChangeTipoReporte()">
                                <option ng-value="1">Con Valoración</option>
                                <option ng-value="2">Con Lista de Precios</option>
                                <option ng-value="3">Consumo Diario</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-xl-3 col-lg-3 col-md-6 col-sm-12 col-12">
                        <div class="icheck-info">
                            <input type="checkbox" ng-model="dataSearch.chkProveedor" class="form-control"
                                name="chkProveedor" id="chkProveedor">
                            <label for="chkProveedor">Proveedor</label>
                        </div>
                    </div>

                    <div class="col-xl-3 col-lg-3 col-md-6 col-sm-12 col-12" ng-show="!dataSearch.chkProveedor">
                        <div class="icheck-info">
                            <input type="checkbox" ng-model="dataSearch.checkboxSubFamiliaFiltro" class="form-control"
                                name="checkboxSubFamiliaFiltro" id="checkboxSubFamiliaFiltro">
                            <label for="checkboxSubFamiliaFiltro">SubFamilia</label>
                        </div>
                    </div> 
                    <div class="col-xl-3 col-lg-3 col-md-6 col-sm-12 col-12" ng-if="dataSearch.byTipoReporte==3">
                        <div class="icheck-info">
                            <input type="checkbox" ng-model="dataSearch.checkboxArticuloFiltro" class="form-control"
                                name="checkboxArticuloFiltro" id="checkboxArticuloFiltro">
                            <label for="checkboxArticuloFiltro">Articulo</label>
                        </div>
                    </div> 
                <div class="row">
                    <div class="col-xl-6 col-lg-6 col-md-6 col-sm-6 col-12"
                        ng-if="(!dataSearch.chkProveedor && dataSearch.checkboxSubFamiliaFiltro)">
                        <div class="form-group">
                            <label for="">SubFamilia</label>
                            <select class="form-control border-select" ng-model="dataSearch.bySubFamilia"
                                ng-options="sf.subFamilia.idSubFamilia as sf.subFamilia.descripcion group by sf.nombreFamilia  for sf in subFamilias">
                            </select>
                        </div>
                    </div>
                    <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12" ng-if="dataSearch.chkProveedor">
                        @await Html.PartialAsync("~/Views/Proveedor/_ProveedorAutocompleteFiltro.cshtml")
                    </div>
                </div>

                <div class="row justify-content-between">
                    <div class="col-xl-3 col-lg-3 col-md-3 col-sm-12 col-12">
                        <div class="form-group">
                            <label for="ordenar">Ordenar por:</label>
                            <select class="form-control" ng-model="dataSearch.byOrderCampo">
                                <option value="ar.codigo">Codigo</option>
                                <option value="ar.descripcion">Descripción</option>
                                <option value="ar.idSubFamilia">SubFamilia</option>
                                <option value="ar.stock">Stock</option>
                            </select>
                        </div>
                    </div>

                    <div class="col-xl-3 col-lg-3 col-md-3 col-sm-12 col-12">
                        <div class="icheck-info mt-3">
                            <input type="radio" ng-model="dataSearch.byOrder" value='ASC' name="radioByOrder"
                                id="byOrderAsc">
                            <label for="byOrderAsc">Ascendente</label>
                        </div>
                        <div class="icheck-info">
                            <input type="radio" ng-model="dataSearch.byOrder" value="DESC" name="radioByOrder"
                                id="byOrderDesc">
                            <label for="byOrderDesc">Descendente</label>
                        </div>
                    </div>

                    <div class="col-xl-3 col-lg-3 col-md-6 col-sm-4 col-12">
                        <div class="form-group">
                            <label for="tipoFormato">Tipo Formato</label>
                            <div class="icheck-info">
                                <input type="radio" ng-model="dataSearch.byTipoFormato" value="pdf" name="tipoFormato"
                                    id="pdf">
                                <label for="pdf">PDF</label>
                            </div>
                            <div class="icheck-info">
                                <input type="radio" ng-model="dataSearch.byTipoFormato" value="excel" name="tipoFormato"
                                    id="excel">
                                <label for="excel">EXCEL</label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-primary-1" ng-click="filtrar()"> <i class="fa fa-search"></i> Buscar</button>
                <button class="btn btn-dark" data-dismiss="modal">&times; Cerrar</button>
            </div>
        </div>
    </div>
</div>