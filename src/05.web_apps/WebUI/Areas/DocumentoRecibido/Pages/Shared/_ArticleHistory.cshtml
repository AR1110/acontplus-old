<div class="modal-header">
    <h4 class="modal-title">
        <i class="fa fa-history"></i> Historial de Ingresos - {{articleName}}
    </h4>
    <button type="button" class="close" aria-label="Close" ng-click="modalRefArticleHistory.close()">
        <span aria-hidden="true">&times;</span>
    </button>
</div>
<div class="modal-body">
    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th>Proveedor</th>
                    <th class="text-center">Nro. Doc.</th>
                    <th class="text-center">Fecha Compra</th>
                    <th class="text-center">Cantidad</th>
                    <th class="text-center">P. Unitario</th>
                </tr>
            </thead>
            <tbody>
                <tr ng-repeat="item in articleHistory">
                    <td>{{item.proveedor}}</td>
                    <td class="text-center">{{item.nroDocumento}}</td>
                    <td class="text-center">{{item.fechaEmision | date: 'dd/MM/yyyy'}}</td>
                    <td class="text-center">{{item.cantidad}}</td>
                    <td class="text-rigth">{{item.precioUnitario | currency}}</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
<div class="modal-footer">
    <button class="btn btn-dark" ng-click="modalRefArticleHistory.close()">&times; Cerrar</button>
</div>