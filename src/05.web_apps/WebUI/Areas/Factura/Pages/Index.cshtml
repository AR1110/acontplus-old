@page
@model WebUI.Areas.Factura.Pages.IndexModel
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<div ng-controller="facturaCtrl">
    <div class="row page-titles">
        <div class="col-md-5 align-self-center">
            <h5 class="text-themecolor">Factura Refactorización</h5>
        </div>
        <div class="col-md-7 align-self-center text-right">
            <div class="d-flex justify-content-end align-items-center">

                <button type="button" ng-click="openModalNew()" class="btn btn-info d-block d-lg-inline-block m-l-15">
                    <i class="fa fa-plus-circle"></i> Nuevo
                </button>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <div class="row">
                <div class="col-xl-3 col-lg-3 col-md-6 col-sm-12 col-12">
                    <div class="form-gorup">
                        <span for="establecimiento">Establecimiento</span>
                        <select name="establecimiento" id="establecimiento" ng-model="dataSearch.codEstab"
                            class="form-control  border-select" ng-change="getFacturas()">
                            <option ng-value="item.codEstab" ng-repeat="item in establecimientos">
                                {{item.nombreComercial}}
                            </option>
                        </select>
                    </div>
                </div>
                <div class="col-xl-3 col-lg-3 col-md-6 col-sm-12 col-12">
                    <div class="form-group">
                        <span for="">Rango de Fechas</span>
                        <date-range-filter current-date="dataSearch.fechaInicio" start-date="dataSearch.fechaInicio"
                            end-date="dataSearch.fechaFin"
                            result-range-date="resultRangeFilter(result)"></date-range-filter>
                    </div>
                </div>
                <div class="col-xl-3 col-lg-3 col-md-6 col-sm-12 col-12">
                    <div class="form-group">
                        <span for="clienteFiltro">Cliente</span>
                        <input type="text" id="clienteSearchFiltro" autocomplete="off" name="clienteSearchFiltro"
                            class="form-control border-select" placeholder="Ingrese C.I o Nombre Fiscal"
                            ng-model="modelTextSearch" typeahead-wait-ms="10" ng-keyup="onKeyupClienteSearchFiltro()"
                            uib-typeahead="a as a.nombreFiscal for a in clienteSearch($viewValue)"
                            typeahead-loading="clienteFiltro.loading" typeahead-no-results="clienteFiltro.noResults"
                            typeahead-template-url="clienteSearchFiltro.html" typeahead-editable="false"
                            typeahead-on-select="selectedClienteSearchFiltro($item)" onClick="select();" />

                        <script type="text/ng-template" id="clienteSearchFiltro.html">
                                <div class="autocomplete-suggestion-uib-typeahead">
                                    <span class="item-title">
                                        <b> {{match.model.numeroIdentificacion}}</b> - {{match.model.nombreFiscal}}
                                    </span>
                                </div>
                            </script>
                    </div>
                </div>
                <div class="col-xl-3 col-lg-3 col-md-6 col-sm-12 col-12">
                    <button type="button" class="btn btn-info btm-xs mt-4" data-toggle="button" data-more="#sh"
                        aria-pressed="false" ng-click="onClickBtnMore()">
                        <span class="text" uib-tooltip="Más"><i class="ti-plus" aria-hidden="true"></i></span>
                        <span class="text-active" uib-tooltip="Menos"><i class="ti-minus" aria-hidden="true"></i>
                        </span>
                    </button>
                    <button type="button" class="btn btn-success btm-xs mt-4" uib-tooltip="Recargar"
                        ng-click="getFacturas()">
                        <i class="fas fa-redo"></i>
                    </button>
                </div>
            </div>

            <div class="row justify-content-between" ng-if="moreSearchOptions">

                <div class="col-xl-3 col-lg-3 col-md-12 col-sm-12 col-12">
                    <div class="form-group">
                        <span for="usuario">Usuario</span>
                        <input type="text" class="form-control border-select" ng-model="nombreCompleto"
                            ng-keyup="onKeyupUsuarioSearch()"
                            uib-typeahead="u as u.nombreCompleto for u in usuarioSearch($viewValue)"
                            typeahead-editable="false" placeholder="Buscar Usuario" autocomplete="off"
                            typeahead-template-url="usuarioSearchTemplate.html"
                            typeahead-no-results="usuarioSearch.noResults"
                            typeahead-on-select="selectedUsuarioSearch($item)">

                        <script type="text/ng-template" id="usuarioSearchTemplate.html">
                                <div class="autocomplete-suggestion-uib-typeahead">
                                    <span class="item-title">
                                        {{match.model.nombreCompleto}}
                                    </span>
                                </div>
                            </script>
                    </div>
                </div>
                <div class="col-xl-3">
                    <div class="form-group">
                        <span>Estado:</span>
                        <select id="estadoDocumentos" class="form-control" ng-model="dataSearch.codEstado"
                            ng-change="getGuiasRemision()">
                            <option value="">Todos</option>
                            <option ng-value="item.codigo" ng-repeat="item in estadosDocumento">
                                {{item.descripcion}}
                            </option>
                        </select>
                    </div>
                </div>
                <div class="col-xl-3">
                    <div class="form-group">
                        <span>Buscar</span>
                        <input type="text" class="form-control border-select" ng-change="searchFilterLocal()"
                            ng-model="dataSearch.bySearch" placeholder="Ej: 001-002">
                    </div>
                </div>
            </div>

            <md-table-container name="wireTable" infinite-scroll="loadMore($index)" infinite-scroll-distance="1"
                infinite-scroll-parent="true" ng-init="isShow=true" ng-show="isShow"
                style=" max-height: 400px; overflow-x: hidden">
                <table resize master md-table name="innerWireTable">
                    <thead md-trim-column-names fix-head md-head>
                        <tr md-row>
                            <th md-column><span>Op</span></th>
                            <th md-column><span>Nro. Doc</span></th>
                            <th md-column><span>F. Emisión</span></th>
                            <th md-column><span>F. Vcto</span></th>
                            <th md-column><span>Cliente</span></th>
                            <th md-column totales-venta-view="ventaPermiso"><span>Total</span></th>
                            <th md-column totales-venta-view="ventaPermiso"><span>Abono</span></th>
                            <th md-column totales-venta-view="ventaPermiso"><span>Saldo</span></th>
                            <th md-column><span>Nro. Ret</span></th>
                            <th md-column><span>Nro. NC.</span></th>
                            <th md-column><span>Estado</span></th>
                            <th md-column><span>Estado SRI</span></th>
                            <th md-column><span>F. Pago</span></th>
                            <th md-column><span>Usuario</span></th>
                        </tr>
                    </thead>
                    <tbody md-body>
                        <tr md-row ng-repeat="item in facturas track by $index" ng-class="item.style">
                            <td md-cell>
                                <md-menu>
                                    <md-button aria-label="Open demo menu" class="md-icon-button"
                                        ng-click="$mdMenu.open($event)">
                                        <icon class="mdi mdi-menu"></icon>
                                    </md-button>
                                    <md-menu-content class="md-dense">
                                        <md-menu-item>
                                            <md-button ng-click="openModalDetalle(item)">
                                                <span md-menu-align-target><i class="ti-menu"></i>
                                                    Detalle</span>
                                            </md-button>
                                        </md-menu-item>

                                        <md-menu-item ng-if="accion.editar">
                                            <md-button ng-click="openModalInvoiceEdit(item)" ng-disabled="item.gestion">
                                                <span md-menu-align-target><i class="ti-pencil"></i>
                                                    Editar</span>
                                            </md-button>
                                        </md-menu-item>

                                        <md-menu-item>
                                            <md-button ng-click="openModalInvoiceDuplicate(item)">
                                                <span md-menu-align-target><i class="ti-files"></i>
                                                    Duplicar</span>
                                            </md-button>
                                        </md-menu-item>

                                        <md-menu-item>
                                            <md-button ng-click="openModalDetalle(item, true)">
                                                <span md-menu-align-target><i class="ti-files"></i>
                                                    Dividir</span>
                                            </md-button>
                                        </md-menu-item>

                                        <md-menu-item ng-if="accion.anular">
                                            <md-button ng-click="askToDelete(item)"
                                                ng-disabled="item.gestionTributaria">
                                                <span md-menu-align-target><i class="ti-na"></i>
                                                    Anular</span>
                                            </md-button>
                                        </md-menu-item>

                                        <md-menu-item
                                            ng-if="(accion.cobroPago && item.codEstado==='PP') || (accion.cobroPago && item.codEstado==='PE')">
                                            <md-button ng-click="opcionCobro(item)"
                                                ng-disabled="item.gestionFinanciera">
                                                <span md-menu-align-target><i class=" fas fa-hand-holding-usd"></i>
                                                    Cobro</span>
                                            </md-button>
                                        </md-menu-item>

                                        <md-menu-item ng-if="accion.cuota">
                                            <md-button ng-click="openModalCuota(item)"
                                                ng-disabled="item.gestionTributaria">
                                                <span md-menu-align-target><i class=" fas fa-hand-holding-usd"></i>
                                                    Cuotas</span>
                                            </md-button>
                                        </md-menu-item>

                                        <md-menu-item ng-if="accion.historialFinanciero">
                                            <md-button ng-click="openModalHistorialCobro($event, item)">
                                                <span md-menu-align-target><i class=" fas fa-tasks"></i>
                                                    Hist. Mov.</span>
                                            </md-button>
                                        </md-menu-item>

                                        <md-menu-item ng-if="accion.reporte">
                                            <md-button ng-click="getReport(item)">
                                                <span md-menu-align-target> <i class="fa fa-file-pdf fa-xs"></i>
                                                    PDF</span>
                                            </md-button>
                                        </md-menu-item>

                                        <md-menu-item>
                                            <md-button ng-click="print(item)">
                                                <span md-menu-align-target> <i class="fa fa-file-pdf fa-xs"></i>
                                                    Impresion</span>
                                            </md-button>
                                        </md-menu-item>

                                        <md-menu-item>
                                            <md-button uib-tooltip="Enviar por Whatsapp" tooltip-placement="top"
                                                btn-send-to-whats-app params="item" has-permission="hasPermissions"
                                                type-send="typeSend">
                                                <span md-menu-align-target>
                                                    <i class="mdi mdi-whatsapp"></i> Enviar por Whatsapp
                                                </span>
                                            </md-button>
                                        </md-menu-item>

                                    </md-menu-content>
                                </md-menu>
                            </td>
                            <td md-cell>{{item.nroFactura}}</td>
                            <td md-cell>{{item.fechaEmision}}</td>
                            <td md-cell>{{item.fechaVencimiento}}</td>
                            <td md-cell>{{item.nombreFiscal}}</td>
                            <td md-cell totales-venta-view="ventaPermiso">${{item.total}}</td>
                            <td md-cell totales-venta-view="ventaPermiso">${{item.abono}}</td>
                            <td md-cell totales-venta-view="ventaPermiso">${{item.saldo}}</td>
                            <td md-cell>{{item.nroRetencion}}</td>
                            <td md-cell>{{item.nroNotaCredito}}</td>
                            <td md-cell>{{item.estadoFinanciero}}</td>
                            <td md-cell ng-bind-html="item.estadoSri"></td>
                            <td md-cell>{{item.tiempoCredito?"CONTADO":"CREDITO"}}</td>
                            <td md-cell>{{item.usuario}}</td>
                        </tr>
                        @* <tr ng-show="facturas.length==0" class="text-center">
                        <td colspan="13">
                        No hay registros en esta tabla :)
                        </td>
                        </tr> *@
                    </tbody>
                    <tfoot md-foot fixed-tfoot>
                        <tr md-row>
                            <td md-cell colspan="2"><span class="font-weight-bold">{{facturas.length}}
                                    Facturas</span></td>
                            <td md-cell colspan="3"><span class="font-weight-bold">Total</span></td>
                            <td md-cell totales-venta-view="ventaPermiso"><span
                                    class="font-weight-bold">{{total}}</span></td>
                            <td md-cell totales-venta-view="ventaPermiso"><span
                                    class="font-weight-bold">{{totalAbono}}</span></td>
                            <td md-cell totales-venta-view="ventaPermiso"><span
                                    class="font-weight-bold">{{totalSaldo}}</span></td>
                            <td md-cell colspan="6"></td>
                        </tr>
                    </tfoot>
                </table>
            </md-table-container>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/services/storageService.js" asp-append-version="true"></script>
    <script src="~/js/factElect/directives/factElectDirective.min.js" asp-append-version="true"></script>
    <script src="~/js/factElect/services/facturaService.min.js" asp-append-version="true"></script>
    <script src="~/js/factElect/controllers/facturaCtrl.min.js" asp-append-version="true"></script>
}