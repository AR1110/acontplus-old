@page
@model WebUI.Areas.Ats.Pages.IndexModel
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<div class="row page-titles">
    <div class="col-md-5 align-self-center">
        <h5 class="text-themecolor">Ats</h5>
    </div>
</div>
<div ng-controller="atsCtrl">
    <div class="row">
        <div class="col-6 offset-lg-3 offset-md-3 offset-sm-3 offset-3">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">Anexo Transaccional Simplificado -ATS</h4>
                    <form ng-submit="getAts()">
                        <div class="form-group">
                            <label for="year">Año:</label>
                            <select name="year" id="year" class="form-control" ng-model="yearSelected"
                                    ng-options="year as year.year for year in years" required>
                            </select>
                        </div>
                        <div class="form-group">
                            <label for="month">Mes:</label>
                            <select name="month" id="month" class="form-control" ng-model="monthSelected"
                                    ng-options="month as month.name for month in months" ng-change="declarationType()"
                                    required>
                            </select>
                        </div>
                        <div class="form-group">
                            <div class="icheck-info" ng-show="showSemiAnual">
                                <input type="checkbox" id="semestral" name="declaracionSemestral" ng-model="semiannual">
                                <label for="semestral">Declaración semestral</label>
                            </div>
                        </div>

                        <button class="btn btn-success">
                            <icon class="ti-download"></icon> Descargar
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts{
    <script src="~/js/controllers/sri/atsCtrl.min.js" asp-append-version="true"></script>
}
