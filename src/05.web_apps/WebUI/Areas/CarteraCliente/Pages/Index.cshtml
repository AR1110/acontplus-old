@page
@model WebUI.Areas.CarteraCliente.Pages.Index
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div ng-controller="carteraClienteCtrl" ng-cloak>
    <div class="row page-titles">
        <div class="col-md-5 align-self-center">
            <h4 class="text-themecolor">Gestión de Cartera Clientes</h4>
        </div>
        <div class="col-md-7 align-self-center text-right">
            <div class="d-flex justify-content-end align-items-center">

            </div>
        </div>
    </div>

    @* <partial name="_ModalFiltro" /> *@

    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-body">
                    <div class="row">
                        <div class="col-xl-3 col-lg-3 col-md-6 col-sm-12 col-xs-12">
                            <div class="form-gorup">
                                <span for="establecimiento">Establecimiento</span>
                                <select name="establecimiento" id="establecimiento" ng-model="dataSearch.codEstab"
                                    class="form-control  border-select" ng-change="getAprobComprobantes()">
                                    <option ng-value="item.codEstab" ng-repeat="item in establecimientos">
                                        {{item.nombreComercial}}
                                    </option>
                                </select>
                            </div>
                        </div>
                        <div class="col-xl-3 col-lg-3 col-md-6 col-sm-12 col-xs-12">
                            <div class="form-group">
                                <span for="">Rango de Fechas</span>
                                <date-range-filter current-date="dataSearch.fechaInicio"
                                    start-date="dataSearch.fechaInicio" end-date="dataSearch.fechaFin"
                                    result-range-date="resultRangeFilter(result)"></date-range-filter>
                            </div>
                        </div>
                        <div class="col-xl-3 col-lg-3 col-md-6 col-sm-12 col-xs-12">
                            <div class="form-group">
                                <span for="clienteFiltro">Cliente</span>
                                <input type="text" id="clienteSearchFiltro" autocomplete="off"
                                    name="clienteSearchFiltro" class="form-control border-select"
                                    placeholder="Ingrese C.I o Nombre Fiscal" ng-model="modelTextSearch"
                                    typeahead-wait-ms="10" ng-keyup="onKeyupClienteSearchFiltro()"
                                    uib-typeahead="a as a.nombreFiscal for a in clienteSearch($viewValue)"
                                    typeahead-loading="clienteFiltro.loading"
                                    typeahead-no-results="clienteFiltro.noResults"
                                    typeahead-template-url="clienteSearchFiltro.html" typeahead-editable="false"
                                    typeahead-on-select="selectedClienteSearchFiltro($item)" onClick="select();" />

                                <script type="text/ng-template" id="clienteSearchFiltro.html">
                                <div class="autocomplete-suggestion-uib-typeahead">
                                    <span class="item-title">
                                        <b> {{match.model.numeroIdentificacion}}</b> - {{match.model.nombreFiscal}}
                                    </span>
                                </div>
                            </script>
                            </div>
                        </div>

                        <div class="col-xl-3 col-lg-3 col-md-6 col-sm-12 col-xs-12">
                            <div class="btn-group mt-4" role="group" aria-label="Basic example">
                                <button type="button" class="btn btn-warning btm-sm" data-toggle="button"
                                    data-more="#sh" aria-pressed="false" ng-click="onClickBtnMore()">
                                    <span class="text"><i class="ti-plus" aria-hidden="true"></i> Más</span>
                                    <span class="text-active"><i class="ti-minus" aria-hidden="true"></i> Menos</span>
                                </button>
                                <button type="button" class="btn btn-info btm-sm" uib-tooltip="Listar"
                                    ng-click="search()">
                                    <i class=" fas fa-search"></i>
                                </button>
                                <button type="button" class="btn btn-success btm-sm" uib-tooltip="Exportar a Excel"
                                    ng-click="exportToExcel()">
                                    <i class="mdi mdi-file-excel"></i>
                                </button>

                                <button type="button" class="btn btn-secondary btm-sm" uib-tooltip="Exportar a PDF"
                                    ng-click="exportToPDF()">
                                    <i class="mdi mdi-file-pdf"></i>
                                </button>
                            </div>
                            @* <button type="button" class="btn btn-info btm-sm mt-4" data-toggle="button"
                            data-more="#sh"
                            aria-pressed="false" ng-click="onClickBtnMore()">
                            <span class="text"><i class="ti-plus" aria-hidden="true"></i> Más</span>
                            <span class="text-active"><i class="ti-minus" aria-hidden="true"></i> Menos</span>
                            </button>
                            <button type="button" class="btn btn-success btm-sm mt-4" ng-click="getAprobComprobantes()">
                            <i class="mdi mdi-file-excel"></i>
                            </button>
                            <button type="button" class="btn btn-secondary btm-sm mt-4"
                            ng-click="getAprobComprobantes()">
                            <i class="mdi mdi-file-pdf"></i>
                            </button> *@
                        </div>
                    </div>

                    <div class="row justify-content-between" ng-if="moreSearchOptions">

                        <div class="col-lg-3 col-md-3 col-sm-6 col-xs-12">
                            <div class="form-group">
                                <span>Estado:</span>
                                <select class="form-control" ng-model="dataSearch.byEstado">
                                    <option value="">Todos</option>
                                    <option ng-value="item.codigo" ng-repeat="item in estadoDocumentos">
                                        {{item.descripcion}}
                                    </option>
                                </select>
                            </div>
                            @* <button type="button" ng-click="openModalFiltro()"
                            class="btn waves-effect waves-light btn-info">
                            <i class="mdi mdi-filter-outline"></i> Filtro
                            </button>
                            <button class="btn btn-danger waves-effect waves-light" ng-click="getDownload()"
                            type="button">
                            <span class="btn-label">
                            <i class="ti-file"></i>
                            </span> Reporte
                            </button> *@
                        </div>

                        <div class="col-xl-4 col-lg-4 col-md-6 col-sm-12 col-12" ng-if="!dataSearch.byCliente>0">
                            <md-switch ng-model="dataSearch.verDetalleDoc"
                                aria-label="Ver detalle de documentos por cobrar">
                                Ver detalle de documentos por cobrar
                            </md-switch>
                        </div>
                        <div class="col-xl-3 col-lg-3 col-md-6 col-sm-12 col-12">
                            <div class="form-group">
                                <span class="">Buscar</span>
                                <input type="text" class="form-control border-select" ng-keyup="filterLocal()"
                                    ng-model="txtSearch" placeholder="Ej: 001">
                            </div>
                            <div>
                            </div>
                        </div>
                    </div>

                    <!--CARTERA CLIENTE POR CLIENTE-->

                    <div ng-show="!dataSearch.checkBoxDeudores">
                        <md-table-container style="max-height:400px;">
                            <table resize md-table>
                                <thead fix-head md-head md-trim-column-names>
                                    <tr md-row>
                                        <th md-column></th>
                                        <th md-column>T. Doc</th>
                                        <th md-column>Nro. Doc</th>
                                        <th md-column>Cliente</th>
                                        <th md-column>F. Emisión</th>
                                        <th md-column>Total</th>
                                        <th md-column>Abono</th>
                                        <th md-column>Saldo</th>
                                        <th md-column>F. Vcto</th>
                                        <th md-column>Días</th>
                                        <th md-column>Estado</th>
                                    </tr>
                                </thead>
                                <tbody md-body>
                                    <tr md-row ng-repeat="doc in carteraClientes |filter:txtSearch">
                                        <td md-cell>
                                            <div class="d-flex justify-content-center">
                                                <button ng-click="verDocumento(doc)" class="btn btn-primary-1 btn-xs"
                                                    tooltip data-tooltip data-title="Ver Documento">
                                                    <i class=" far fa-file"></i>
                                                </button>
                                                @* <button ng-click="verCuotaDocumento(doc)" class="btn btn-warning
                                                btn-xs
                                                ml-1" tooltip data-tooltip data-title="Cuota por Cobrar">
                                                <i class="fas fa-clipboard-list"></i>
                                                </button> *@
                                            </div>
                                        </td>
                                        @* <td md-cell>{{$index+1}}</td> *@
                                        <td md-cell>{{doc.codigo}}</td>
                                        <td md-cell>{{doc.nroDoc}}</td>
                                        <td md-cell>{{doc.nombreFiscal}}</td>
                                        <td md-cell>{{doc.fechaEmision}}</td>
                                        <td md-cell>{{doc.total}}</td>
                                        <td md-cell>{{doc.abono}}</td>
                                        <td md-cell>{{doc.saldo}}</td>
                                        <td md-cell>{{doc.fechaVencimiento}}</td>
                                        <td md-cell>{{doc.expira}}</td>
                                        <td md-cell>{{doc.estadoFinanciero}}</td>
                                    </tr>
                                    <tr class="text-center" ng-if="carteraClientes.length===0">
                                        <td colspan="11">No hay registros en esta tabla.</td>
                                    </tr>
                                </tbody>
                                <tfoot md-foot>
                                    <tr md-row>
                                        <td md-cell></td>
                                        <td md-cell colspan="3"></td>
                                        <td md-cell><span class="font-weight-bold">Total: </span></td>
                                        <td md-cell><span class="font-weight-bold">${{total}}</span></td>
                                        <td md-cell><span class="font-weight-bold">${{abono}}</span></td>
                                        <td md-cell><span class="font-weight-bold">${{saldo}}</span></td>
                                        <td md-cell><span class="font-weight-bold"></span></td>
                                        <td md-cell><span class="font-weight-bold"></span></td>
                                        <td md-cell><span class="font-weight-bold"></span></td>
                                    </tr>
                                </tfoot>
                            </table>
                        </md-table-container>
                    </div>

                    <!--LISTA DE DEUDORES-->
                    <div ng-show="dataSearch.checkBoxDeudores">
                        <md-table-container style="max-height:400px;">
                            <table resize md-table>
                                <thead fix-head md-head md-trim-column-names>
                                    <tr md-row>
                                        <th md-column></th>
                                        <th md-column>N°</th>
                                        <th md-column>Cliente</th>
                                        <th md-column>Nro. Identificacion</th>
                                        <th md-column>Total</th>
                                        <th md-column>Abono</th>
                                        <th md-column>Saldo</th>
                                        <th md-column>Dias</th>
                                    </tr>
                                </thead>
                                <tbody md-body>
                                    <tr md-row ng-repeat="doc in carteraClientes |filter:txtSearch"
                                        ng-class="{'table-danger':doc.expira<0}">
                                        <td md-cell>
                                            @* <div class="d-flex justify-content-center">
                                            <button ng-click="getDocumentos()" class="btn btn-warning btn-xs ml-1"
                                            tooltip
                                            data-tooltip data-title="Cuota por Cobrar"><i class="fas
                                            fa-clipboard-list"></i>
                                            </button>
                                            </div> *@
                                        </td>
                                        <td md-cell>{{$index+1}}</td>
                                        <td md-cell>{{doc.nombreFiscal}}</td>
                                        <td md-cell>{{doc.numeroIdentificacion}}</td>
                                        <td md-cell>{{doc.total}}</td>
                                        <td md-cell>{{doc.abono}}</td>
                                        <td md-cell>{{doc.saldo}}</td>
                                        <td md-cell>{{doc.expira}}</td>
                                    </tr>
                                    <tr class="text-center" ng-if="carteraClientes.length===0">
                                        <td colspan="8">No hay registros en esta tabla.</td>
                                    </tr>
                                </tbody>
                                <tfoot md-foot>
                                    <tr md-row>
                                        <td md-cell></td>
                                        <td md-cell colspan="2"></td>
                                        <td md-cell><span class="font-weight-bold">Total: </span></td>
                                        <td md-cell><span class="font-weight-bold">${{total}}</span></td>
                                        <td md-cell><span class="font-weight-bold">${{abono}}</span></td>
                                        <td md-cell><span class="font-weight-bold">${{saldo}}</span></td>
                                        <td md-cell><span class="font-weight-bold"></span></td>
                                    </tr>
                                </tfoot>
                            </table>
                        </md-table-container>
                    </div>
                </div>

            </div>
        </div>
    </div>


    <partial name="_ModalCuotaCarteraCliente" />
</div>
@section Scripts{
    <script src="~/js/contabilidad/controllers/carteraClienteCtrl.min.js" asp-append-version="true"></script>
}