
<style>
    .cellPenditeParcial {
        background-color: rgb(247, 150, 26) !important;
        color: #000 !important;
    }

    .cellPendiente {
        background-color: #FF9999 !important;
        color: #000 !important;
    }
</style>
<form autocomplete="off">
    <div class="modal-header">
        <h5 class="modal-title">Nuevo Cobro</h5>
        <button class="close" ng-click="closeModal()">&times;</button>
    </div>
    <div class="modal-body">
        <!--Tab-->
        <div class="list-group list-group-horizontal" id="paymentStep">
            <a href="javascript:void(0)" ng-click="stepSelectDocPaymentLote()" class="list-group-item list-group-item-action active">
                <div>Paso 1 </div>
                <span>Seleccionar Documentos</span>
            </a>
            <a href="javascript:void(0)" ng-click="stepCuotaPaymentLote()" class="list-group-item list-group-item-action">
                <div>Paso 2 </div>
                <span>Cuotas</span>
            </a>
        </div>

        <!--Tab Content-->
        <div class="tab-content">
            <div class="tab-pane fade show active" id="stepSelectDocs" role="tabpanel">
                <div class="row">
                    <div class="col-xl-6 col-lg-6 col-md-6 col-sm-12 col-12">
                        <div class="form-group">
                            <label for="establecimiento">Estab.: <span class="text-danger">*</span></label>
                            <select name="establecimiento" id="establecimiento" class="form-control border-select" ng-model="dataSearch.codEstab" ng-change="onChangeEstablecimiento()">
                                <option ng-value="item.codEstab" ng-repeat="item in establecimientos">
                                    {{item.nombreComercial}}
                                </option>
                            </select>
                        </div>
                    </div>
                    <div class="col-xl-6 col-lg-6 col-md-6 col-sm-12 col-12">
                        <div class="form-group">
                            <label for="">Cliente: <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <input type="text" id="clienteSearch" autocomplete="off" name="clienteSearch"
                                    class="form-control border-select" placeholder="Ingrese C.I o Nombre Fiscal"
                                    ng-model="modelTextSearch" typeahead-wait-ms="10"
                                    ng-keyup="onKeyupClienteSearch()"
                                    uib-typeahead="a as a.nombreComercial for a in clienteSearch($viewValue)"
                                    typeahead-loading="cliente.loading" 
                                    typeahead-no-results="cliente.noResults"
                                    typeahead-template-url="clienteSearchTemplate.html"
                                    typeahead-editable="false"
                                    typeahead-on-select="selectedClienteSearch($item)" onClick="select();" />

                                <script type="text/ng-template" id="clienteSearchTemplate.html">
                                    <div class="autocomplete-suggestion-uib-typeahead">
                                        <span class="item-title">
                                            <b> {{match.model.numeroIdentificacion}}</b> - {{match.model.nombreFiscal}}
                                        </span>
                                    </div>
                                </script>
                                <div class="input-group-append">
                                    <md-button class="md-icon-button" ng-click="refreshDocs()" aria-label="Stock"
                                        title="Actualizar">
                                        <md-icon md-font-set="md" class="text-info">sync</md-icon>
                                    </md-button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
               

                <md-table-container style=" max-height: 400px;" ng-show="tipoDocumentos.length>0">
                    <table md-table md-row-select="options.rowSelection" multiple="{{options.multiSelect}}" ng-model="selectedDocumentos">
                        <thead md-head>
                            <tr class="border-bottom">
                                <th md-column colspan="3"></span></th>
                                <th md-column><i>Total:</span></th>
                                <th md-column md-numeric><i>{{data.importeTotal}}</span></th>
                                <th md-column md-numeric><i>{{data.totalAbonoAnterior}}</span></th>
                                <th md-column md-numeric><i>{{data.totalSaldo}}</span></th>
                                <th md-column md-numeric><span></span></th>
                            </tr>
                            <tr md-row>
                                @*<th md-column><span>N°</span></th>*@
                                <th md-column><span>N°. Doc.</span></th>
                                <th md-column><span>Tipo Doc.</span></th>
                                <th md-column><span>F. Emisión</span></th>
                                <th md-column><span>F. Vcto.</span></th>
                                <th md-column md-numeric><span>Total</span></th>
                                <th md-column md-numeric><span>Abono</span></th>
                                <th md-column md-numeric><span>Saldo</span></th>
                                <th md-column md-numeric><span>Estado</span></th>
                                @*<th md-column md-numeric hide-gt-xs show-gt-lg><span></span></th>*@
                            </tr>
                        </thead>
                        <tbody md-body id="body-cobro">
                            <tr style="cursor: pointer;"
                                md-row md-select="item"
                                md-on-select="onSelectDoc"
                                md-on-deselect="onDesSelectDoc"
                                md-auto-select="true"
                                ng-disabled="item.hasEntrada"
                                ng-repeat="item in tipoDocumentos ">
                                @*<td md-cell>{{$index+1}}</td>*@
                                <td md-cell>{{item.serieComprobante}}</td>
                                <td md-cell>{{item.tipoDoc}}</td>
                                <td md-cell>{{item.fechaEmision}}</td>
                                <td md-cell>{{item.fechaVencimiento}}</td>
                                <td md-cell>${{item.importeTotal}}</td>
                                <td md-cell>${{item.abono}}</td>
                                <td md-cell>${{item.saldo}}</td>
                                <td md-cell>{{item.estado}}</td>
                            </tr>
                        </tbody>
                    </table>
                </md-table-container>

            </div>

            <div class="tab-pane fade show active" id="stepCuotas" style="display: none;" role="tabpanel">
                <div class="card">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-3 col-xs-6 b-r"> <strong>C.I./RUC</strong>
                                <br>
                                <p class="text-muted">{{comprobante.numeroIdentificacion}}</p>
                            </div>
                            <div class="col-md-3 col-xs-6 b-r"> <strong>Cliente</strong>
                                <br>
                                <p class="text-muted">{{comprobante.nombreFiscal}}</p>
                            </div>
                            @* <div class="col-md-3 col-xs-6 b-r"> <strong>Email</strong>
                                <br>
                                <p class="text-muted">johnathan@admin.com</p>
                            </div>
                            <div class="col-md-3 col-xs-6"> <strong>Location</strong>
                                <br>
                                <p class="text-muted">London</p>
                            </div> *@
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-xl-9 col-lg-9 col-md-12 col-sm-12 col-12">
                        <div class="card border border-info">
                            <div class="card-header">
                                <h6 class="card-title">Cuotas</h6>
                            </div>
                            <md-table-container style=" max-height: 400px;">
                                <table md-table>
                                    <thead md-head>
                                        <tr md-row>
                                            <th md-column><span></span></th>
                                            <th md-column><span>Nro. Cuota</span></th>
                                            <th md-column><span>Cuota</span></th>
                                            <th md-column><span>Mora</span></th>
                                            <th md-column><span>Dias Mora</span></th>
                                            <th md-column><span>Abono</span></th>
                                            <th md-column><span>Saldo</span></th>
                                            <th md-column><span>Estado</span></th>
                                        </tr>
                                    </thead>
                                    <tbody md-body>
                                        <tr md-row ng-repeat-start="group in selectedDocumentos">
                                            <td md-cell colspan="1" class="text-left" ng-click="displayCuota(group)">
                                                <span ng-if="group.display"><i class="fas fa-caret-square-down"></i></span>
                                                <span ng-if="!group.display"><i class="fas fa-caret-square-right"></i></span>
                                            </td>
                                            <td md-cell colspan="3">{{group.tipoDoc}} - {{group.serieComprobante}}</td>
                                            <td md-cell colspan="2">
                                                <strong>${{group.importeTotal}}</strong>
                                            </td>

                                        </tr>
                                        <tr md-row ng-repeat-end ng-repeat="cuota in group.cuotas" ng-show="group.display">
                                            <td md-cell>
                                                <button class="btn btn-secondary btn-xs" ng-if="cuota.esCuotaAfectada" ng-click="showCobroDetalle(cuota)">
                                                    <i class="ti-eye"></i>
                                                </button>
                                            </td>
                                            <td md-cell>{{cuota.nroCuota}}</td>
                                            <td md-cell>{{cuota.cuota}}</td>
                                            <td md-cell>{{cuota.mora}}</td>
                                            <td md-cell>{{cuota.diasMora}}</td>
                                            <td md-cell>{{cuota.abono}}</td>
                                            <td md-cell>{{cuota.saldo}}</td>
                                            <td md-cell>{{cuota.estado}}</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </md-table-container>
                        </div>

                        <div class="card border border-dark">
                            <div class="card-header bg-secondary">
                                <h6 class="card-title">Datos de cobro</h6>
                            </div>
                            <md-table-container style=" max-height: 400px;">
                                <table md-table>
                                    <thead md-head>
                                        <tr md-row>
                                            <th md-column><span>Op.</span></th>
                                            <th md-column><span>N°</span></th>
                                            <th md-column><span>F. Emisión</span></th>
                                            <th md-column><span>Sub Entidad</span></th>
                                            <th md-column><span>Valor</span></th>
                                            <th md-column><span>Tipo Doc.</span></th>
                                            <th md-column><span>Nro.</span></th>
                                            <th md-column><span>Abono</span></th>
                                            <th md-column><span></span></th>
                                        </tr>
                                    </thead>
                                    <tbody md-body>
                                        <tr md-row ng-repeat-start="item in datosCobro">
                                            <td md-cell>
                                                <button class="btn btn-danger btn-xs" ng-click="askToDeleteDatoPago(item)">
                                                    <i class="mdi mdi-delete"></i>
                                                </button>
                                            </td>
                                            <td md-cell>{{$index+1}}</td>
                                            <td md-cell>{{item.fechaEmision | date:'MM/dd/yyyy  h:mma'}}</td>
                                            <td md-cell>{{item.subEntidadFinanciera}}</td>
                                            <td md-cell>{{item.valorAbono | currency}}</td>
                                            <td md-cell>{{item.tipoDocumento}}</td>
                                            <td md-cell>{{item.nro}}</td>
                                            <td md-cell>{{item.abonoCuota | currency}}</td>
                                            <td md-cell ng-click="displayInfoDatosCobro(item)">
                                                <span ng-if="item.display"><i class="fas fa-caret-square-down"></i></span>
                                                <span ng-if="!item.display"><i class="fas fa-caret-square-right"></i></span>
                                            </td>
                                        </tr>
                                        <tr md-row ng-repeat-end ng-if="item.display">
                                            <td colspan="8">
                                                <div class="row ml-5 mr-5">
                                                    <div class="col-md-4 col-xs-6 b-r">
                                                        <small class="text-muted">Ciudad: </small>
                                                        <br>
                                                        <h6>{{item.ciudad}}</h6>
                                                    </div>
                                                    <div class="col-md-4 col-xs-6 b-r">
                                                        <small class="text-muted">Referencia: </small>
                                                        <br>
                                                        <h6>{{item.referencia}}</h6>
                                                    </div>
                                                    <div class="col-md-4 col-xs-6 b-r">
                                                        <small class="text-muted">Aprobación:</small>
                                                        <br>
                                                        <h6>{{item.aprobacion}}</h6>
                                                    </div>
                                                </div>
                                                <div class="row ml-5 mr-5">
                                                    <div class="col-md-4 col-xs-6">
                                                        <small class="text-muted">Lote:</small>
                                                        <br>
                                                        <h6>{{item.lote}}</h6>
                                                    </div>
                                                    <div class="col-md-4 col-xs-6">
                                                        <small class="text-muted">PosFechado:</small>
                                                        <br>
                                                        <h6><span class="badge badge-success">{{item.posFechado?'SI':'NO'}}</span></h6>
                                                    </div>
                                                    <div class="col-md-4 col-xs-6">
                                                        <small class="text-muted">Banco: </small>
                                                        <br>
                                                        <h6><span class="badge badge-success">{{item.banco}}</span></h6>
                                                    </div>
                                                </div>
                                            </td>
                                        </tr>
                                        <tr class="text-center" ng-if="datosPago.length === 0">
                                            <td colspan="8">No hay datos</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </md-table-container>

                        </div>
                    </div>

                    <div class="col-xl-3 col-lg-3 col-md-12 col-sm-12 col-12">
                        <div class="card">
                            <button type="button" class="btn btn-info btn-block" ng-click="openModalFormaCobro()">
                                <icon class="ti-plus"></icon> Nuevo Abono
                            </button>

                            <ul class="list-group">
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    Total:
                                    <span>
                                        <h5>
                                            {{data.importeTotal | currency}}
                                        </h5>
                                    </span>
                                </li>
                                <li class="list-group-item d-flex justify-content-between align-items-center list-group-item-info" ng-if="data.totalAbonoAnterior>0">
                                    Abono Anterior:
                                    <span>
                                        {{data.totalAbonoAnterior | currency}}
                                    </span>
                                </li>
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    Abono
                                    <span>
                                        {{data.totalValorAbono | currency}}
                                    </span>
                                </li>
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    Saldo:
                                    <span>
                                        {{data.totalSaldo | currency}}
                                    </span>
                                </li>
                                <li class="list-group-item d-flex justify-content-between align-items-center list-group-item-danger">
                                    Cambio:
                                    <span>
                                        {{data.valorCambio | currency}}
                                    </span>
                                </li>
                            </ul>

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-footer">
        <div ng-if="isPaymentLote">
            <div ng-show="footerActionStepUno">
                <button type="button" class="btn btn-info" ng-click="stepCuotaPaymentLote()"><i class=" fas fa-angle-right"></i> Siguiente</button>
                <button type="button" class="btn btn-dark" ng-click="closeModal()">&times; Cerrar</button>
            </div>
            <div ng-show="footerActionStepDos">
                <button type="button" class="btn btn-info" ng-click="stepSelectDocPaymentLote()"><i class=" fas fa-angle-left"></i> Atras</button>
                <button type="button" class="btn btn-success" ng-click="save()"> <i class="ti-save"></i> Guardar</button>
            </div>
        </div>

        <div ng-if="isPaymentDocument">
            <button type="button" class="btn btn-success" ng-click="save()"> <i class="ti-save"></i> Guardar</button>
            <button type="button" class="btn btn-dark" ng-click="closeModal()"> &times; Cerrar</button>
        </div>

    </div>
</form>
