@page
@model Contabilidad_UI.CuentaPorPagar.Pages.IndexModel
@{
    ViewData["Title"] = "Index";
    Layout = "_Layout";
}
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<div ng-controller="cuentaPorPagarCtrl">
    <div class="row page-titles">
        <div class="col-md-5 align-self-center">
            <h5 class="text-themecolor">Cuentas por Pagar</h5>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <div class="row">
                <div class="col-xl-3 col-lg-3 col-md-6 col-sm-12 col-xs-12">
                    <small for="estab" class="text-muted">Establecimiento</small>
                    <select class="form-control form-control-sm border-select" name="estab" id="estab" ng-model="dataSearch.codEstab" ng-change="getCuentasPorPagar()">
                        <option value="ALL">Todos</option>
                        <option ng-value="item.codEstab" ng-repeat="item in establecimientos">{{item.nombreComercial}}</option>
                    </select>                    
                </div>

                <div class="col-xl-4 col-lg-4 col-md-6 col-sm-12 col-xs-12">
                    <small class="text-muted">Proveedor</small>
                    <div class="input-group input-group-sm mb-3">
                        <input  type="text" 
                                name="proveedorSearch" 
                                id="proveedorSearch" 
                                class="form-control form-control-sm border-select"
                                autocomplete="off"                                                               
                                placeholder="..."         
                                onclick="select()"                       
                                ng-model="dataSearch.selectedProveedor"
                                ng-keyup="onKeyupSearchProveedor(selectedProveedor)"
                                uib-typeahead="a as a.proveedor.nombreFiscal for a in searchProveedorFilter($viewValue)"
                                typeahead-loading="data.loadingSearch"
                                typeahead-no-results="data.noResults"
                                typeahead-template-url="autocompleteProveedorFilter.html"
                                typeahead-editable="false"
                                typeahead-on-select="selectedOnChangeFilter($item)">
                                <script type="text/ng-template" id="autocompleteProveedorFilter.html">
                                    <div class="autocomplete-suggestion-uib-typeahead">
                                        <span class="item-title">
                                            <b> {{match.model.proveedor.numeroIdentificacion}}</b> - {{match.model.proveedor.nombreFiscal}}
                                        </span>
                                    </div>
                                </script> 
                        <div class="input-group-append">
                          
                                <button class="btn btn-success" type="button" ng-click="getCuentasPorProveedor()">
                                    <i class="mdi mdi-account-search"></i>
                                </button>
                                <button class="btn btn-danger" type="button" ng-click="cancelCuentasPorProveedor()">
                                    <i class="mdi mdi-close-circle-outline"></i>
                                </button>
                            
                        </div>
                    </div>       
                </div>

                <div class="col-xl-3 col-lg-3 col-md-6 col-sm-12 col-xs-12">
                    <small for="tipoDocumento" class="text-muted">Tipo Documento</small>
                    <select name="tipoDoc" id="tipoDoc" class="form-control form-control-sm border-select" ng-model="dataSearch.codDoc" ng-change="getCuentasPorPagar()">
                            <option value="ALL">Todos</option>
                            <option ng-value="item.codigo" ng-repeat="item in tipoDocumentos">
                                {{item.descripcion}}
                            </option>
                        </select>                   
                </div>

                <div class="col-xl-2 col-lg-2 col-md-6 col-sm-12 col-xs-12">
                    <small class="text-muted" for="estado">Estado</small>
                    <select name="estadoDoc" id="estadoDoc" ng-model="dataSearch.codEstado" class="form-control form-control-sm border-select" ng-change="getCuentasPorPagar()">
                        <option value="ALL">Todos</option>
                        <option ng-value="item.codigo" ng-repeat="item in estadoDocumentos">
                            {{item.descripcion}}
                        </option>
                    </select>                    
                </div>

               
            </div>

            <div class="row justify-content-between">
                <div class="col-xl-3 col-lg-3 col-md-6 col-sm-12 col-xs-12">
                    <small class="text-muted">Rango de Fechas: </small>
                    <input  class="form-control form-control-sm date-picker" type="text"
                            ng-model="dateRangePicker.date" picker="dateRangePicker.picker"
                            picker-classes="extra-class-names" min="'2014-02-23'" max="dateRangePicker.maxDate"
                            date-range-picker 
                            options="dateRangePicker.options" />
                </div> 
                <div class="col-xl-3 col-lg-3 col-md-6 col-sm-12 col-xs-12">   
                                     
                </div>               
            </div>
        </div>
    </div>

    
    <div class="card">
        <div class="card-body">
            <div class="row justify-content-between">                   
                <div class="col-xl-3 col-lg-3 col-md-3 col-sm-6 col-xs-12">
                    <button type="button" class="btn btn-info btn-block" ng-click="openModalPagoLote()">
                        <i class="ti-layers"></i>  Pago Lote
                    </button>
                </div>
                <div class="col-xl-3 col-lg-3 col-md-3 col-sm-6 col-xs-12">                    
                    <form class="form-material">
                        <div class="input-group input-group-sm mb-3">
                            <input type="text" class="form-control border-select"  placeholder="Buscar Cuentas por pagar">
                            <div class="input-group-append">
                                <button class="btn btn-info" type="button" ng-click="getCuentasPorPagar()">
                                    <i class="mdi mdi-refresh"></i>
                                </button>
                            </div>
                        </div>
                    </form>  
                </div>
            </div>    
        </div>   

        <md-table-container style="max-height: 400px;">
            <table md-table md-row-select="options.rowSelection" multiple="{{options.multiSelect}}"  ng-model="selectedDocumentos" md-progress="promise">
                <thead fix-head md-head>
                    <tr md-row>
                        <th md-column ><span></span></th>
                        <th md-column ><span>N°</span></th>
                        <th md-column ><span>Cod. Doc</span></th>
                        <th md-column ><span>Serie</span></th>
                        <th md-column ><span>Proveedor</span></th>
                        <th md-column>Fecha Emisión</th>
                        <th md-column>Fecha Vcto.</th>
                        <th md-column>Total</th>
                        <th md-column>Abono</th>
                        <th md-column>Saldo</th>
                        <th md-column>Estado</th>
                    </tr>
                </thead>
                <tbody md-body>
                    <tr md-row
                        ng-disabled="item.codPago=='PA' || item.codPago=='PFC'"
                        md-select="item" 
                        md-on-select="selectedRow"  
                        md-select-id="idCuentaPorPagar" 
                        md-auto-select 
                        ng-repeat="item in cuentasPorPagar" ng-style="{'background-color': item.colorRow}">
                        <td md-cell>
                            <md-menu>
                                <md-button aria-label="Open demo menu" class="md-icon-button"
                                            ng-click="$mdMenu.open($event)">
                                    <icon class="mdi mdi-menu"></icon>
                                </md-button>
                                <md-menu-content class="md-dense">
                                    <md-menu-item>
                                        <md-button ng-click="openModalCuota(item)"><span
                                            md-menu-align-target>Cuotas</span>
                                        </md-button>
                                    </md-menu-item>

                                    <md-menu-item>
                                        <md-button ng-click="openModalPago(item)" ng-disabled="item.codPago==='PA' || item.codPago=='PFC'"><span
                                            md-menu-align-target>Pago</span>
                                        </md-button>
                                    </md-menu-item>     

                                    <md-menu-item>
                                        <md-button ng-click="openModalHistorialMov(item)" ng-disabled="(item.codPago==='PE')"><span
                                            md-menu-align-target>Hist. Movimiento</span>
                                        </md-button>
                                    </md-menu-item>     
                                                                   
                                </md-menu-content>
                            </md-menu>
                        </td>
                        <td md-cell>{{$index+1}}</td>
                        <td md-cell>{{item.codDoc}}</td>
                        <td md-cell>{{item.serieComprobante}}</td>
                        <td md-cell>{{item.nombreFiscal}}</td>
                        <td md-cell>{{item.fechaEmision}}</td>
                        <td md-cell>{{item.fechaVencimiento}}</td>
                        <td md-cell>${{item.importeTotal}}</td>
                        <td md-cell>${{item.abono}}</td>
                        <td md-cell>${{item.saldo}}</td>
                        <td md-cell>{{item.estado}}</td>
                    </tr>
                </tbody>
            </table>
        </md-table-container>
    </div>
</div>

@section Scripts {
    <script src="~/js/contabilidad/controllers/cuentaPorPagarCtrl.min.js" asp-append-version="true"></script>
}