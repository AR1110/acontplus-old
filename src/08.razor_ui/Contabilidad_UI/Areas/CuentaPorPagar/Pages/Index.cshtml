@page
@model Contabilidad_UI.CuentaPorPagar.Pages.IndexModel
@{
    ViewData["Title"] = "Index";
    Layout = "_Layout";
}

<div ng-controller="cuentaPorPagarCtrl">
    <div class="row page-titles">
        <div class="col-md-5 align-self-center">
            <h5 class="text-themecolor">Cuentas por Pagar</h5>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <div class="table-responsivve">
                <table class="table table-borderless">
                    <thead>
                        <tr class="small">
                            <th></th>   
                            <th>Proveedor</th>
                            <th>Cred.</th>
                            <th>Doc</th>
                            <th>Serie</th>
                            <th>F.Emi</th>
                            <th>Venc</th>
                            <th>Total</th>
                            <th>Abono</th>
                            <th>Saldo</th>
                            <th class="">Estado</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="item in cuentasPorPagar" class="small" ng-style="item.colorRow">
                            <td>
                                <md-menu>
                                    <md-button aria-label="Open demo menu" class="md-icon-button"
                                               ng-click="$mdMenu.open($event)">
                                        <icon class="mdi mdi-menu"></icon>
                                    </md-button>

                                    <md-menu-content class="md-dense">

                                        <md-menu-item>
                                            <md-button ng-click="askToDelete(item)" >
                                                <span md-menu-align-target><i class="ti-na"></i> Anular</span>
                                            </md-button>
                                        </md-menu-item>

                                        <md-menu-item>
                                            <md-button ng-click="opcionCobro(item)" >
                                                <span md-menu-align-target><i class=" fas fa-hand-holding-usd"></i> Pago</span>
                                            </md-button>
                                        </md-menu-item>

                                        <md-menu-item>
                                            <md-button ng-click="openModalCuota(item)" >
                                                <span md-menu-align-target><i class=" fas fa-hand-holding-usd"></i> Cuotas</span>
                                            </md-button>
                                        </md-menu-item>

                                        <md-menu-item>
                                            <md-button ng-click="openModalHistorialCobro(item)">
                                                <span md-menu-align-target><i class=" fas fa-tasks"></i> Hist. Mov.</span>
                                            </md-button>
                                        </md-menu-item>

                                    </md-menu-content>
                                </md-menu>
                            </td>
                            <td>{{item.nombreFiscal}}</td>
                            <td>{{item.diasCredito}} días</td>
                            <td>{{item.codDoc}}</td>
                            <td>{{item.serieComprobante}}</td>
                            <td>{{item.fechaEmision}}</td>
                            <td>{{item.fechaVencimiento}}</td>
                            <td class="text-right">{{item.importeTotal | currency}}</td>
                            <td class="text-right">{{item.abono | currency}}</td>
                            <td class="text-right">{{item.saldo | currency}}</td>
                            <td class="text-right">{{item.estado}}</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <script src="~/js/controllers/contabilidad/cuentaPorPagarCtrl.js" asp-append-version="true"></script>
}