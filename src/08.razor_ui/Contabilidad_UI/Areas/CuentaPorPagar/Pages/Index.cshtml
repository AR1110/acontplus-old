@page
@model Contabilidad_UI.CuentaPorPagar.Pages.IndexModel
@{
    ViewData["Title"] = "Index";
    Layout = "_Layout";
}

<div ng-controller="cuentaPorPagarCtrl">
    <div class="row page-titles">
        <div class="col-md-5 align-self-center">
            <h5 class="text-themecolor">Cuentas por Pagar</h5>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <div class="table-responsivve">
                <table class="table table-bordered">
                    <thead>
                        <tr>
                            <th>Proveedor</th>
                            <th>T. Cred.</th>
                            <th>Documento</th>
                            <th>Serie</th>
                            <th>F. Emi.</th>
                            <th>F. Venc.</th>
                            <th>Total</th>
                            <th>Abono</th>
                            <th>Saldo</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="item in cuenntasPorPagar">
                            <td>{{item.}}</td>
                            <td>{{item.}}</td>
                            <td>{{item.}}</td>
                            <td>{{item.}}</td>
                            <td>{{item.}}</td>
                            <td>{{item.}}</td>
                            <td>{{item.}}</td>
                            <td>{{item.}}</td>
                            <td>
                                <button class="btn btn-success"></button>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <script src="~/js/controllers/contabilidad/cuentaPorPagarCtrl.js" asp-append-version="true"></script>
}