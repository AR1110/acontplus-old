

<form autocomplete="off">
    <div class="modal-header">
        <h5 class="modal-title"><icon class="mdi mdi-plus"></icon> Nuevo Compra No Habitual</h5>
        <button type="button" class="close" ng-click="$ctrl.closeModal()">&times;</button>
    </div>


    <div class="modal-body">
        <div class="row">
            <div class="col-xl-4 col-lg-4 col-md-4 col-sm-12 col-xs-12">
                <div class="row">
                    <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-xs-12">
                        <div class="form-group">
                            <label for="establecimiento">Estab: <span class="text-danger">*</span></label>
                            <select name="establecimiento" id="establecimiento" class="form-control border-select">
                                <option ng-value="item.codEstab" ng-repeat="item in $ctrl.establecimientos">
                                    {{item.nombreComercial}}
                                </option>
                            </select>
                        </div>
                    </div>

                    <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-xs-12">
                        <div class="form-group">
                            <label for="establecimiento">Estab: <span class="text-danger">*</span></label>
                            <select name="establecimiento" id="establecimiento" class="form-control border-select">
                                <option ng-value="item.codEstab" ng-repeat="item in $ctrl.establecimientos">
                                    {{item.nombreComercial}}
                                </option>
                            </select>
                        </div>
                    </div>
                </div>                
            </div>

            <div class="col-xl-8 col-lg-8 col-md-8 col-sm-12 col-xs-12">

            </div>
        </div>
        <div class="row">
            <div class="col-xl-4 col-lg-4 col-md-6 col-sm-12 col-xs-12">
                
            </div>
        </div>

        <div class="row col-xl-4 col-lg-4 col-md-6 col-sm-12 col-xs-12">

        </div>

        <div class="row col-xl-4 col-lg-4 col-md-6 col-sm-12 col-xs-12">

        </div>

        
    </div>

    <div class="modal-footer">
        <button  class="btn btn-success" ng-click="$ctrl.askToSave()">
            <icon class="ti-save"></icon> Guardar
        </button>
        <button type="button" class="btn btn-dark" ng-click="$ctrl.closeModal()">
            &times; Cerrar
        </button>
    </div>
</form>
