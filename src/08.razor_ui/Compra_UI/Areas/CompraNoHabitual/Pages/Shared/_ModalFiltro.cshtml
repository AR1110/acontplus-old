<div class="modal fade in" id="modalFiltro" role="dialog" tabindex="-1" databackdrop="static">
    <div class="modal-dialog modal-lg">

        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Busqueda Avanzada</h5>
                <button class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <div class="row justify-content-between">

                    <div class="col-xl-3 col-lg-3 col-md-3 col-sm-4 col-4">
                        <div class="icheck-info">
                            <input type="checkbox" ng-change="onChangeFechaFiltro()" ng-model="dataSearch.checkBoxFecha"
                                disabled id="checkBoxFechaFiltroFC" />
                            <label for="checkBoxFechaFiltroFC">Fecha</label>
                        </div>
                    </div>

                    <div class="col-xl-3 col-lg-3 col-md-3 col-sm-4 col-4">
                        <div class="icheck-info">
                            <input type="checkbox" ng-model="dataSearch.checkBoxEstab" id="checkBoxEstabFiltroFC" />
                            <label for="checkBoxEstabFiltroFC">Establecimiento</label>
                        </div>
                    </div>

                    <div class="col-xl-3 col-lg-3 col-md-3 col-sm-4 col-4">
                        <div class="icheck-info">
                            <input type="checkbox" ng-model="dataSearch.checkBoxProveedor"
                                id="checkBoxProveedorFiltroFC" />
                            <label for="checkBoxProveedorFiltroFC">Proveedor</label>
                        </div>
                    </div>

                    <div class="col-xl-2 col-lg-2 col-md-3 col-sm-4 col-4">
                        <div class="icheck-info">
                            <input type="checkbox" ng-model="dataSearch.checkBoxEstado" id="checkBoxEstadoFiltroFC" />
                            <label for="checkBoxEstadoFiltroFC">Estado</label>
                        </div>
                    </div>
                </div>
                <hr>
                <div class="row">
                    <div class="col-xl-6 col-lg-6 col-md- col-sm-12 col-12">
                        <div class="form-group" ng-show="dataSearch.checkBoxEstab">
                            <label>Estab.:</label>
                            <select class="form-control border-select" ng-model="dataSearch.codEstab">
                                <option ng-value="item.codEstab" ng-repeat="item in establecimientos">
                                    {{item.nombreComercial}}</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-xl-6 col-lg-6 col-md- col-sm-12 col-12" ng-show="dataSearch.checkBoxProveedor">
                        <div class="form-group">
                            <label class="control-label">Proveedor:</label>
                            <input type="text" autocomplete="off" name="proveedorAutocompleteFilter"
                                class="form-control border-select" placeholder="Ingrese C.I o Nombre Fiscal"
                                typeahead-wait-ms="5" ng-model="dataSearch.selectedProveedor"
                                ng-keyup="onKeyupSearchProveedor(selectedProveedor)"
                                uib-typeahead="a as a.proveedor.nombreFiscal for a in searchProveedorFilter($viewValue)"
                                typeahead-loading="data.loadingSearch" typeahead-no-results="data.noResults"
                                typeahead-template-url="autocompleteProveedorFilter.html" typeahead-editable="false"
                                typeahead-on-select="searchProveedorFilterChange($item)" />

                            <script type="text/ng-template" id="autocompleteProveedorFilter.html">
                                <div class="autocomplete-suggestion-uib-typeahead">
                                    <span class="item-title">
                                        <b> {{match.model.proveedor.numeroIdentificacion}}</b> - {{match.model.proveedor.nombreFiscal}}
                                    </span>
                                </div>
                            </script>
                        </div>
                    </div>
                </div>

                <div class="row" ng-if="dataSearch.checkBoxFecha">
                    <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">
                        <date-range-filter current-date="dataSearch.fechaInicio" start-date="dataSearch.fechaInicio" end-date="dataSearch.fechaFin" result-change=""></date-range-filter>
                    </div>
                    @* <div class="col-xl-4 col-lg-4 col-md-6 col-sm-12 col-xs-12">
                        <div class="form-group">
                            <label class="control-label">Mes: </label>
                            <select ng-model="mes" class="form-control" ng-change="getFechaInicioFinFilter(mes)">
                                <option ng-value="m.numero" ng-repeat="m in meses">{{m.nombre}}</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-xl-4 col-lg-4 col-md-6 col-sm-12 col-xs-12">
                        <div class="form-group">
                            <label>Fecha Inicio:</label>
                            <input type="date" class="form-control" name="fechaInicio"
                                ng-model="dataSearch.fechaInicio" />
                        </div>
                    </div>
                    <div class="col-xl-4 col-lg-4 col-md-6 col-sm-12 col-xs-12">
                        <div class="form-group">
                            <label>Fecha Fin:</label>
                            <input type="date" class="form-control" name="facheFin" ng-model="dataSearch.fechaFin" />
                        </div>
                    </div> *@
                </div>
                <div class="row">
                    <div class="col-xl-6 col-lg-6 col-md-6 col-sm-6 col-12" ng-show="dataSearch.checkBoxEstado">
                        <div class="form-group">
                            <label>Estado:</label>
                            <select id="idEstadoPago" class="form-control" ng-model="dataSearch.byEstado">
                                <option ng-value="item.estado" ng-repeat="item in estadoDocs">
                                    {{item.descripcion}}
                                </option>
                            </select>
                        </div>
                    </div>
                </div>

            </div>
            <div class="modal-footer">
                <button type="button" ng-click="busquedaAvanzada()" class="btn btn-info"><i class="fa fa-search"></i>
                    Buscar</button>
                <button class="btn btn-dark" data-dismiss="modal">&times; Cerrar</button>
            </div>

        </div>
    </div>
</div>
