@page
@model FACT_UI.Areas.Cliente.Pages.Index
@{
    @RouteData.Values["id"]
    ViewData["Title"] = "Index";
    Layout = "_Layout";
}


<div ng-controller="clienteCtrl">
    <div class="row page-titles">
        <div class="col-lg-5 align-self-center">
            <h5 class="text-themecolor">Gestión de Clientes</h5>
        </div>
        <div class="col-lg-7 alig-self-center text-right">
            <div class="d-flex justify-content-end align-items-center">
                <button type="button" class="btn btn-info" id="btnNewCustomerDocument" customer-modal-new
                    get-data-customer="resultConfirmedCreate(result)">
                    <i class="fa fa-plus fa-xs"></i> Nuevo
                </button>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <md-toolbar class="md-table-toolbar md-default">
                    <div class="md-toolbar-tools">
                        <div class="col-lg-9 col-md-9 col-sm-9 m-t-20">
                        </div>
                        <div class="col-lg-3 col-md-3 col-sm-3">
                            <form class="form-material" autocomplete="off">
                                <div class="input-group">
                                    <input type="text" class="form-control" id="searchCliente"
                                        ng-model="dataSearch.bySearch" ng-keyup="onKeyupSearchCliente()"
                                        placeholder="Buscar Cliente" />
                                    <div class="input-group-append" uib-tooltip="Recargar la tabla"
                                        tooltip-placement="top">
                                        <button type="button" class="btn btn-info" ng-click="resetList()">
                                            <i class="fas fa-undo"></i>
                                        </button>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                </md-toolbar>

                <md-table-container md-scroll-y layout-fill style=" max-height: 400px;">
                    <table md-table>
                        <thead md-head fix-head>
                            <tr md-row>
                                <th md-column ng-if="accion.editar || accion.eliminar">Op.</th>
                                <th md-column>N°</th>
                                <th md-column>RUC</th>
                                <th md-column>Nombre Fiscal</th>
                                <th md-column>Dirección</th>
                                <th md-column>Teléfono</th>
                                <th md-column>Estado</th>
                            </tr>
                        </thead>
                        <tbody md-body>
                            <tr md-row ng-repeat="item in customers">
                                <td md-cell ng-if="accion.editar || accion.eliminar">
                                    <div layout="row" layout-align="start center">
                                        <button class="btn btn-info btn-xs" ng-if="accion.editar" customer-modal-edit
                                            params="item" get-data-customer="resultConfirmedCreate(result)">
                                            <i class="ti-pencil"></i>
                                        </button>
                                        <button class="btn btn-danger btn-xs ml-2" ng-if="item.estado"
                                            ng-if="accion.eliminar" ng-click="eliminarCliente(item)">
                                            <i class="fas fa-user-times"></i>
                                        </button>
                                    </div>
                                </td>
                                <td md-cell>{{$index+1}}</td>
                                <td md-cell>{{item.numeroIdentificacion}}</td>
                                <td md-cell>
                                    {{item.nombreFiscal}}
                                </td>
                                <td md-cell>{{item.direccion}}</td>
                                <td md-cell>{{item.telefono}}</td>
                                <td md-cell ng-bind-html="item.estado|estadoPrimario"></td>
                            </tr>
                            <tr ng-show="customers.length==0" class="text-center">
                                <td colspan="7">
                                    No hay registros en esta tabla :)
                                </td>
                            </tr>
                        </tbody>
                        <tfoot>
                            <tr>
                                <td align="center" colspan="7">
                                    <div class="pull-left m-t-10">
                                        @* <md-table-pagination md-limit="query.limit"
                                        md-limit-options="recordsQuantity" md-page="query.page"
                                        md-total="{{totalRecords}}" md-boundary-links="options.boundaryLinks"
                                        md-on-paginate="logPagination"></md-table-pagination> *@
                                        @*<ul uib-pagination total-items="totalRecords" items-Per-Page="pageSize"
                                        ng-change="pagechanged()" ng-model="pageIndex" max-size="maxSize"
                                        class="pagination" boundary-links="true" rotate="false"></ul>*@
                                    </div>
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                </md-table-container>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script src="~/js/common/services/apiErrorHandler.min.js" asp-append-version="true"></script>
    <script src="~/js/factElect/mappers/factElectMapper.min.js" asp-append-version="true"></script>
    <script src="~/js/factElect/repositories/factElectRepository.min.js" asp-append-version="true"></script>
    <script src="~/js/common/utils/utils.js" asp-append-version="true"></script>
    <script src="~/js/factElect/services/clienteService.min.js" asp-append-version="true"></script>
    <script src="~/js/factElect/shared/factElectDirective.min.js" asp-append-version="true"></script>
    <script src="~/js/factElect/controllers/clienteCtrl.js" asp-append-version="true"></script>
}