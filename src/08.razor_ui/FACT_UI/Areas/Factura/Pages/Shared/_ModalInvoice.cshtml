<div class="modal-header">
    <div class="float-left">
        <div class="custom-control custom-checkbox">
            <input type="checkbox" class="custom-control-input" ng-model="showHeaderInvoice" id="checkbox0"
                value="check">
            <label class="custom-control-label" for="checkbox0">Mas datos</label>
        </div>
    </div>
    <div class="float-center">
        <h6><span class="font-weight-bold">Estab:</span> {{infoEstabPtoEmi.nombreComercial}} | <span
                class="font-weight-bold">Pto. Emisión:</span> {{infoEstabPtoEmi.ptoEmi}}</h6>
    </div>
    <div class="float-right">
        <h4><span class="float-right"><strong>Total: ${{data.total}} </strong></span></h4>
    </div>
</div>

<div class="modal-body">

    <!--Información Adicional Documento-->
    <div class="row" ng-if="showHeaderInvoice">
        <div class="col-xl-3 col-lg-3 col-md-6 col-sm-12 col-xs-12">
            <div class="form-group">
                <label for="establecimiento">Estab.: <span class="text-danger">*</span></label>
                <select name="establecimiento" id="establecimiento" class="form-control border-select"
                    ng-model="data.codEstab" ng-change="onChangeEstablecimiento()">
                    <option ng-value="item.codEstab" ng-repeat="item in establecimientos">
                        {{item.nombreComercial}}
                    </option>
                </select>
            </div>
        </div>

        <div class="col-xl-2 col-lg-2 col-md-6 col-sm-6 col-xs-12">
            <div class="form-group">
                <label for="puntoEmision">Punto Emisión: <span class="text-danger">*</span></label>
                <select name="puntoEmision" id="puntoEmision" class="form-control border-select"
                    ng-model="data.idPuntoEmision">
                    <option ng-value="item.idPuntoEmision" ng-repeat="item in puntosEmision">{{item.ptoEmi}}</option>
                </select>
            </div>
        </div>

        <div class="col-xl-3 col-xl-3 col-lg-3 col-md-6 col-sm-6 col-xs-12">
            <div class="form-group">
                <label for="tiempoCredito">Tiempo Crédito: <span class="text-danger">*</span></label>
                <div class="input-group">
                    <select name="tiempoCredito" id="tiempoCedito" class="form-control border-select"
                        ng-model="data.idTiempoCredito" ng-change="onChangeTiempoCredito()"
                        ng-disabled="!ventaComprobantePermission.tiempoCedito.update">
                        <option ng-value="item.idTiempoCredito" ng-repeat="item in tiempoCreditos">{{item.descripcion}}
                        </option>
                    </select>
                    <div class="input-group-append">
                        <button type="button" class="btn btn-secondary btn-xs" ng-click="getAllTiempoCredito()">
                            <i class="mdi mdi-cached"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-2 col-lg-2 col-md-6 col-sm-6 col-xs-12">
            <div class="form-group">
                <label for="fechaVencimiento">Fecha Vencimiento:</label>
                <input type="date" name="fechaVencimiento" id="fechaVencimiento" class="form-control" disabled
                    ng-model="data.fechaVencimiento" />
                <small class="text-info">{{fechaVencimientoEscrita}}</small>
            </div>
        </div>

        <div class="col-xl-2 col-lg-2 col-md-6 col-sm-12 col-xs-12">
            <div class="form-group">
                <label for="empleado">Empleado</label>
                <input type="text" name="empleado" id="empleado" class="form-control " ng-value="cliente.empleado"
                    disabled />
            </div>
        </div>
    </div>

    <!--Datos Cliente-->
    <div class="row">
        <div class="col-xl-4 col-lg-4 col-md-6 col-sm-12 col-12">
            <div class="form-group">
                <label>Cliente: <span class="text-danger">*</span></label>
                <div class="input-group">

                    <input type="text" id="customerInputSearch" class="form-control border-select"
                        ng-model="cliente.nombreCliente" customer-search-custom on-select="selectedCustomer(item)"
                        placeholder="Ingrese C.I o Nombre Comercial" onclick="select();">

                    <script type="text/ng-template" id="autocompleteClienteTemplate.html">
                        <div class="autocomplete-suggestion-uib-typeahead">
                            <span class="item-title"><b> {{match.model.numeroIdentificacion}}</b> - {{match.model.nombreFiscal}}</span>
                        </div>
                    </script>

                    <div class="input-group-append">

                        <button type="button" class="btn btn-outline-secondary btn-xs border-select"
                            id="btnNewCustomerDocument" customer-modal-new get-data-customer="selectedCustomer(result)">
                            <i class="fa fa-plus fa-xs"></i>
                        </button>

                        @* <button type="button" class="btn btn-outline-secondary btn-xs border-select"
                        id="btnNewCustomerDocument" ng-click="openModalClienteNew()">
                        </button> *@

                        <button type="button" class="btn btn-outline-secondary btn-xs" ng-if="cliente.idCliente>0"
                            customer-modal-edit params="cliente" tabindex="-1">
                            <i class="fa fa-edit fa-xs"></i>
                        </button>
                        <button type="button" class="btn btn-outline-secondary btn-xs" customer-modal-list
                            get-data-customer="selectedCustomer(result)" tabindex="-1">
                            <i class="fa fa-search fa-xs"></i>
                        </button>

                        <button type="button" customer-info-popover popover-title="Title" popover-content="Content"
                            popover-placement="bottom" customer="cliente" class="btn btn-outline-secondary btn-xs"
                            ng-if="cliente.idCliente>0" tabindex="-1">
                            <i class="fa fa-info fa-xs"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-2 col-lg-2 col-md-6 col-sm-12 col-12">
            <div class="form-group">
                <label for="nroIndentificacion" class="">Nro. Identificación:</label>
                <input type="text" name="nroIndentificacion" id="nroIndentificacion" class="form-control" disabled
                    ng-value="cliente.numeroIdentificacion" placeholder="..." />
            </div>
        </div>

        <div class="col-xl-2 col-lg-2 col-md-6 col-sm-12 col-12">
            <div class="form-group">
                <label for="fechaEmision">Fecha Emisión: <span class="text-danger">*</span></label>
                <input type="date" name="fechaEmision" id="fechaEmision" class="form-control border-select"
                    ng-model="data.fechaEmision" ng-change="onChangeFechaEmision()" ng-keyup="onChangeFechaEmision()"
                    tabindex="-1" ng-disabled="!ventaComprobantePermission.fechaEmision.update" />
                <small class="text-info">{{fechaEmisionEscrita}}</small>
            </div>
        </div>

        <div class="col-xl-2 col-lg-2 col-md-6 col-sm-12 col-12">
            <div class="form-group">
                <label for="bodegas">Bodega</label>
                <select name="bodegas" id="bodegas" class="form-control border-select" ng-model="data.idBodega"
                    ng-change="onChangeBodega()" tabindex="-1">
                    <option ng-value="item.idBodega" ng-repeat="item in bodegas">
                        {{item.descripcion}}
                    </option>
                </select>
            </div>
        </div>

        <div class="col-xl-2 col-lg-2 col-md-6 col-sm-12 col-12">
            <div class="form-group">
                <label for="tarifas">
                    Tarifa:
                    <span tooltip-placement="top"
                        uib-tooltip="Asignación Rápida de listas de precios seleccionada a todos los productos del documento.">
                        <i class="fas fa-info-circle fa-xs"></i>
                    </span>
                </label>
                <select id="tarifas" class="form-control border-select" ng-model="data.idTarifa"
                    ng-change="onChangeTarifaGeneral()" tabindex="-1"
                    ng-disabled="!ventaComprobantePermission.tarifa.update">
                    <option ng-value="item.idTarifa" ng-repeat="item in tarifas">
                        {{item.descripcion}}
                    </option>
                </select>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-xl-8 col-lg-8 col-md-6 col-sm-12 col-xs-12">
            <div class="row">
                <div class="col-xl-6 col-lg-6 col-md-6 col-sm-12 col-xs-12">
                    <label for="">Buscar por Artículo</label>
                    <md-autocomplete-articulo-component tipo-doc="tipoDoc"
                        set-item-articulo-en-detalle="getItemArticulo(item)" is-default-article="isDefaultArticle">
                    </md-autocomplete-articulo-component>
                </div>

                <div class="col-xl-4 col-lg-4 col-md-6 col-sm-12 col-xs-12">
                    <div class="form-group">
                        <label for="searchBarcode">Buscar por Código</label>
                        <articulo-search-barcode tipo-doc="tipoDoc"
                            set-item-articulo-en-detalle="getItemArticulo(item)"></articulo-search-barcode>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-4 col-lg-4 col-md-6 col-sm-12 col-xs-12">
            <div class="row justify-content-end">
                <div class="col-lg-6 col-lg-6 col-md-6 col-sm-12 col-xs-12">
                    <button type="button" class="btn btn-block btn-lg btn-success mt-4" id="btnSaveAndUpdateDocument"
                        ng-click="onSave()">
                        <i class="ti-save"></i> Guardar
                    </button>
                </div>
            </div>
        </div>
    </div>


    <!--Detalle-->
    <div ui-grid="gridOptions" ui-grid-edit ui-grid-resize-columns ui-grid-cellNav ui-grid-auto-resize ui-grid-validate
        ui-grid-save-state class="grid">
    </div>

    <!--SubTotales-->
    <div class="row">
        <div class="col-xl-9 col-lg-9 col-md-6 col-sm-12 col-xs-12">
            <div class="row mt-2" ng-if="showSubtotales">
                <div class="col-xl-4 col-lg-4 col-md-6 col-sm-12 col-xs-12">
                    <div class="table-responsive">
                        <table class="table table-clear table-sm">
                            <tbody>
                                <tr>
                                    <td class="left">
                                        <strong class="text-dark">SubTotal Iva {{data.impuestoTarifa.tarifa}}%</strong>
                                    </td>
                                    <td class="right">${{data.subTotalIva}}</td>
                                </tr>

                                <tr>
                                    <td class="left">
                                        <strong class="text-dark">SubTotal IVA 0</strong>
                                    </td>
                                    <td class="right">${{data.subTotalIvaCero}}</td>
                                </tr>

                                <tr>
                                    <td class="left">
                                        <strong class="text-dark">SubTotal Exento IVA</strong>
                                    </td>
                                    <td class="right">${{data.subTotalExentoIva}}</td>
                                </tr>

                                <tr>
                                    <td class="left">
                                        <strong class="text-dark">SubTotal no Objeto IVA</strong>
                                    </td>
                                    <td class="right">${{data.subTotalNoObjetoIva}}</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="col-xl-4 col-lg-4 col-md-6 col-sm-12 col-xs-12">
                    <div class="table-responsive">
                        <table class="table table-clear table-sm">
                            <tbody>
                                <tr>
                                    <td class="left">
                                        <strong class="text-dark">SubTotal Neto IVA</strong>
                                    </td>
                                    <td class="right">${{data.subTotalNetoIva}}</td>
                                </tr>

                                <tr>
                                    <td class="left">
                                        <strong class="text-dark">SubTotal Neto IVA 0</strong>
                                    </td>
                                    <td class="right">${{data.subTotalNetoIvaCero}}</td>
                                </tr>

                                <tr>
                                    <td class="left">
                                        <strong class="text-dark">SubTotal Neto Exento IVA</strong>
                                    </td>
                                    <td class="right">${{data.subTotalNetoExentoIva}}</td>
                                </tr>

                                <tr>
                                    <td class="left">
                                        <strong class="text-dark">SubTotal Neto no Objeto IVA</strong>
                                    </td>
                                    <td class="right">${{data.subTotalNetoNoObjetoIva}}</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="col-xl-4 col-lg-4 col-md-6 col-sm-12 col-xs-12">
                    <div class="table-responsive">
                        <table class="table table-clear table-sm">
                            <tbody>
                                <tr>
                                    <td class="left">
                                        <strong class="text-dark">ICE</strong>
                                    </td>
                                    <td class="right">${{data.totalIce}}</td>
                                </tr>

                                <tr>
                                    <td class="left">
                                        <strong class="text-dark">IRBPNR</strong>
                                    </td>
                                    <td class="right">${{data.irbpnr}}</td>
                                </tr>

                                <tr>
                                    <td class="left">
                                        <strong class="text-dark">Propina</strong>
                                    </td>
                                    <td class="right">${{data.propina}}</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <md-divider ng-if="showSubtotales"></md-divider>
            <div class="row mt-2" ng-if="showSubtotales">
                <div class="col-lg-2 col-md-6 col-sm-12 col-xs-12">
                    <div class="form-group">
                        <label>% Descuento</label>
                        <div class="input-group">
                            <input ng-model="data.porcentajeDescuento"
                                ng-disabled="!ventaComprobantePermission.porcentajeDescuento.update || gridOptions.data.length==0"
                                decimal class="form-control border-select" />
                            <div class="input-group-append">
                                <button type="button" class="btn btn-secondary btn-sm"
                                    ng-click="calcularPorcentajeDescuento()">
                                    <i class="fa fa-calculator fa-xs"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-2 col-md-6 col-sm-12 col-xs-12">
                    <div class="form-group">
                        <label>Descuento</label>
                        <div class="input-group">
                            <input ng-model="data.totalDescuento" id="totalDescuento"
                                ng-disabled="!ventaComprobantePermission.descuento.update || gridOptions.data.length==0"
                                decimal placeholder="0.00" class="form-control border-select" />
                            <div class="input-group-append">
                                <button type="button" class="btn btn-secondary btn-sm" ng-click="calcularDescuento()">
                                    <i class="fa fa-calculator fa-xs"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-2 col-md-6 col-sm-12 col-xs-12">
                    <div class="form-group">
                        <label>Transporte</label>
                        <input type="text" decimal ng-model="data.transporte" class="form-control border-select"
                            placeholder="0.00" />
                    </div>
                </div>

                <div class="col-lg-2 col-md-6 col-sm-12 col-xs-12">
                    <div class="form-group">
                        <label>Rercargo</label>
                        <input type="text" decimal ng-model="data.recargo" class="form-control border-select"
                            placeholder="0.00" />
                    </div>
                </div>

                <div class="col-lg-4">
                    <div class="form-group">
                        <label>Observacion</label>
                        <textarea class="form-control border-select" ng-model="data.observacion" touppercase
                            placeholder="..."></textarea>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-lg-3 col-md-6 col-sm-12 col-xs-12">
            <div class="table-responsive mt-2">
                <table class="table table-clear table-sm">
                    <tbody>
                        <tr>
                            <td class="left">
                                <strong class="text-dark">SubTotal sin Impuesto</strong>
                            </td>
                            <td class="right">${{data.subTotalSinImpuestos}}</td>
                        </tr>

                        <tr>
                            <td class="left">
                                <select style="width: 150px;" name="impuestoTarifa" id="impuestoTarifa"
                                    ng-model="data.impuestoTarifa.codigoPorcentaje"
                                    class="form-control form-control-sm border-select"
                                    ng-change="recalculateImpuestoTarifa()" ng-disabled="disabledImpuestoTarifa">
                                    <option ng-value="item.codigoPorcentaje"
                                        ng-repeat="item in actividadEstabImpuestos">
                                        {{item.descripcion}}
                                    </option>
                                </select>
                                @* <strong class="text-dark">IVA {{actividadTipoIva.tarifa}}%</strong> *@
                            </td>
                            <td class="right">${{data.iva}}</td>
                        </tr>

                        <tr>
                            <td class="left">
                                <strong class="text-dark">Total Descuento</strong>
                            </td>
                            <td class="right">${{data.totalDescuento}}</td>
                        </tr>

                        <tr>
                            <td class="left">
                                <h4> <strong class="text-dark">Total</strong></h4>
                            </td>
                            <td class="right">
                                <h4><strong class="text-dark">${{data.total}}</strong></h4>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <div class="mt-2">
                <button type="button" class="btn btn-secondary btn-sm btn-lg btn-block"
                    open-modal-additional-data-document is-view="false" datos-adicionales="datosAdicionalesDocumento"
                    get-data-additional-document="openModalModalDatoAdicionalDoc(result)">
                    <i class="fas fa-info-circle text-info"></i> Dato Adicional
                </button>
            </div>
        </div>
    </div>

</div>

<div class="modal-footer">
    <div class="icheck-success icheck-inline">
        <input type="checkbox" ng-model="showSubtotales" id="showSubTotales" />
        <label for="showSubTotales">Mas datos</label>
    </div>

    <button type="button" class="btn btn-dark" id="btnCloseModalDocument" ng-click="closeModal()">
        &times; Cerrar
    </button>
</div>



