@page
@model Reports_UI.Areas.Inventario.Pages.IndexModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewBag.title = "Reporte Inventario";
    Layout = "_Layout";
}
<div ng-controller="reporteInventarioCtrl">
    <div class="row page-titles">
        <div class="col-md-5 align-self-center">
            <h4 class="text-themecolor">Reporte Inventario</h4>
        </div>
        <div class="col-md-7 align-self-center text-right">
            <div class="d-flex justify-content-end align-items-center">

            </div>
        </div>
    </div>


    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-body">
                    <button class="btn btn-info" ng-click="openModalReporte()">
                        <i class="mdi mdi-file-find fa-lg"></i> Nuevo Reporte
                    </button>
                </div>
                <md-divider></md-divider>
                <div class="card-body">
                    <div class="jumbotron text-center">
                        <br><br><br><br><br><br><br><br><br>
                        <h2>Aquí se mostrará el reporte creado!</h2>
                        <br><br><br><br><br><br><br><br><br>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @await Html.PartialAsync("_ModalFiltroInventario")

</div>

@section Scripts{
    <script src="~/js/controllers/reportes/reporteInventarioCtrl.min.js" asp-append-version="true"></script>
}