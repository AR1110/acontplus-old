@page
@model Reports_UI.Areas.ReporteVentas.Pages.ConsumoClienteModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewBag.title = "Reporte Consumo Cliente";
    Layout = "_Layout";
}
<div ng-controller="reporteConsumoClienteCtrl">
    <div class="row page-titles">
        <div class="col-md-5 align-self-center">
            <h4 class="text-themecolor">Reporte Consumo Cliente</h4>
        </div>
        <div class="col-md-7 align-self-center text-right">
            <div class="d-flex justify-content-end align-items-center">

            </div>
        </div>
    </div>

    @await Html.PartialAsync("_ModalReporteConsumoCliente")
    @await Html.PartialAsync("_ModalReporteGraficoVentaCliente")

    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-body">
                    <button class="btn btn-info" ng-click="openModalReporte()">
                        <i class="mdi mdi-file-find fa-lg"></i> Nuevo Reporte
                    </button>
                    <button class="btn btn-warning-1" ng-click="openModalReporteGrafico()">
                        <i class="text-white mdi mdi-chart-bar fa-lg"></i> Venta por Cliente
                    </button>
                </div>
                <md-divider></md-divider>
            </div>
        </div>
    </div>

    <div class="row">
        @* <div class="col-lg-6">
                <div class="card">
                    <div class="card-body">
                        <p class="text-center">POR CANTIDAD DE NOTA DE ENTREGAS Y FACTURAS</p>
                        <canvas id="chartBarVentaCliente" width="300" style="display: inline; width: 1239px; height: 90px;"></canvas>
                    </div>
                </div>
            </div> *@
        <div class="col-lg-12">
            <div class="card">
                <div class="card-body">
                    <canvas id="chartBarVentaClienteNetas" width="300" style="display: inline; width: 1239px; height: 150px;"></canvas>
                </div>
            </div>
        </div>
    </div>





</div>

@section Scripts{
    <script src="~/js/reports/controllers/reporteConsumoClienteCtrl.js" asp-append-version="true"></script>
}