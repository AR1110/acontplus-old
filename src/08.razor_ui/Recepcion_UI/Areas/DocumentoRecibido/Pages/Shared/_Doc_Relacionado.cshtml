<div id="docRelModal" class="modal fade" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Documentos Relacionados</h5>
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <div class="table-responsive">
                    <table class="table table-hover table-borderless table-sm">
                        <tbody>
                            <tr>
                                <td><b>Documento</b></td>
                                <td>{{selected[0].comprobante}}</td>
                            </tr>
                            <tr>
                                <td><b>Clave de acceso</b></td>
                                <td>{{selected[0].claveAcceso}}</td>
                            </tr>
                            <tr>
                                <td><b>Nro. Autorización</b></td>
                                <td>{{selected[0].numeroAutorizacion}}</td>
                            </tr>
                            <tr>
                                <td><b>Fecha autorización</b></td>
                                <td>{{selected[0].fechaAutorizacion}}</td>
                            </tr>
                            <tr>
                                <td><b>Ruc emisor</b></td>
                                <td>{{selected[0].rucEmisor}}</td>
                            </tr>
                            <tr>
                                <td><b>Razón social emisor</b></td>
                                <td>{{selected[0].razonSocialEmisior}}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <br />
                <md-table-container>
                    <table md-table>
                        <thead md-head>
                            <tr md-row>
                                <th md-column ng-if="showOptionsMergeDoc">Op.</th>
                                <th md-column>N°.</th>
                                <th md-column>Doc.</th>
                                <th md-column>Serie Comprobante</th>
                                <th md-column>Fecha Emisión</th>                             
                                <th md-column>Clave Accesso</th>
                                <th md-column>Total</th>
                            </tr>
                        </thead>
                        <tbody md-body>
                            <tr md-row ng-repeat="item in mergedDocs">
                                <td md-cell ng-if="showOptionsMergeDoc">
                                    <buttion type="button" class="btn btn-outline-secondary btn-sm" ng-click="viewDocument(item)">
                                        <i class="ti-eye"></i>
                                    </buttion>
                                    <buttion type="button" class="btn btn-outline-danger btn-sm" ng-click="viewDocument(item)">
                                        <i class="ti-file"></i>
                                    </buttion>
                                </td>
                                <td md-cell>{{$index+1}}</td>
                                <td md-cell>{{item.comprobante}}</td>
                                <td md-cell>{{item.serieComprobante}}</td>
                                <td md-cell>{{item.fechaEmision}}</td>
                                <td md-cell>{{item.claveAcceso}}</td>
                                <td md-cell>{{item.importeTotal}}</td>
                            </tr>
                        </tbody>
                    </table>
                </md-table-container>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-dark btn-sm" data-dismiss="modal">&times; Cerrar</button>
            </div>
        </div>
    </div>
</div>