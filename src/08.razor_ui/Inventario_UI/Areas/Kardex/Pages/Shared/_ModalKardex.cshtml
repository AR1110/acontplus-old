<div class="modal-header">
    <h5 class="modal-title">Articulo Kardex</h5>
    <button type="button" class="close" ng-click="$ctrl.closeModal()">&times;</button>
</div>

<div class="modal-body ">

    <div class="row mb-1 justify-content-between">
        <div class="col-lg-8 col-md-8 col-sm-12 col-xs-12">
            <span><strong>Codigo: </strong> {{$ctrl.articulo.codigo}}</span><br>
            <span><strong>Articulo: </strong> {{$ctrl.articulo.descripcion}}</span>
        </div>
        <div class="col-lg-2 col-md-6 col-sm-12 col-xs-12">

            <button type="button" class="btn btn-secondary" ng-click="$ctrl.getReport()">
                <i class="mdi mdi-file"></i> Reporte
            </button>
            <button type="button" class="btn btn-info" ng-click="$ctrl.openModalSearch()">
                <i class="fas fa-filter"></i> Filtro
            </button>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-12">
            <div id="tabla-kardex"></div>
            <span class="text-danger">* Haz click sobre la celda para ver el Documento</span>
        </div>

    </div>
</div>

<div class="modal-footer">
    <button class="btn btn-dark" ng-click="$ctrl.closeModal()">&times; Cerrar</button>
</div>

@await Html.PartialAsync("~/Areas/DocumentoRecibido/Pages/Shared/_FacturaPreview.cshtml")
