
<div class="modal-header">
    <h5 class="modal-title">Busqueda</h5>
    <button type="button" class="close" ng-click="$ctrl.closeModal()">&times;</button>
</div>

<div class="modal-body">
    <div class="row justify-content-between">
        <div class="col-lg-3 col-md-3 col-sm-12 col-xs-12">
            <div class="icheck-info">
                <input type="checkbox" ng-change="$ctrl.onChangeFechaFiltro()" ng-model="$ctrl.dataSearch.checkBoxFecha" id="checkBoxFechaFiltro">
                <label for="checkBoxFechaFiltro">Fecha</label>
            </div>
        </div>

        <div class="col-lg-3 col-md-3 col-sm-12 col-xs-12">
            <div class="icheck-info">
                <input type="checkbox" ng-model="$ctrl.dataSearch.checkBoxBodega" id="checkBoxBodegaFiltro">
                <label for="checkBoxBodegaFiltro">Bodega</label>
            </div>
        </div>

        <div class="col-lg-3 col-md-3 col-sm-12 col-xs-12">
            <div class="icheck-info">
                <input type="checkbox" ng-model="$ctrl.dataSearch.checkBoxMovement" id="checkBoxMovement">
                <label for="checkBoxMovement">Movimiento</label>
            </div>
        </div>
    </div>

    <div class="row justify-content-between">
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12" ng-if="$ctrl.dataSearch.checkBoxBodega">
            <div class="icheck-info">
                <input type="checkbox" ng-model="$ctrl.dataSearch.checkBoxUltimaConsolidacion" ng-change="$ctrl.onChangeUltimaConsolidacion()" id="checkBoxUltimaConsolidacion">
                <label for="checkBoxUltimaConsolidacion">Buscar a partir de la ultima consolidación  </label>
            </div>
        </div>
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12">
            <div class="icheck-info">
                <input type="checkbox" ng-model="$ctrl.dataSearch.checkBoxConsolidacion" ng-change="$ctrl.onChangecheckBoxConsolidacionInventario()" id="checkBoxConsolidacionInventario">
                <label for="checkBoxConsolidacionInventario">Buscar consolidaciones de Inventario  </label>
            </div>
        </div>
    </div>
    <hr>

    <div class="row">
        <div class="col-lg-4 col-md-4 col-sm-12 col-xs-12">
            <div class="form-group">
                <label for="">Establecimiento</label>
                <select class="form-control border-select" ng-model="$ctrl.dataSearch.codEstab" ng-change="$ctrl.getBodegas()">
                    <option ng-value="item.codEstab" ng-repeat="item in $ctrl.establecimientos">{{item.nombreComercial}}</option>
                </select>
            </div>
        </div>
        <div class="col-lg-8 col-md-8 col-sm-12 col-xs-12">
            <div class="form-group">
                <label for="articuloFiltro">Articulo</label>
                <input type="text" id="articuloSearchFiltro"
                       autocomplete="off"
                       name="articuloSearchFiltro"
                       class="form-control border-select"
                       placeholder="Ingrese Descripción del Articulo"
                       ng-model="$ctrl.articuloFiltro.descripcion"
                       ng-keyup="$ctrl.onKeyupArticuloSearchFiltro()"
                       uib-typeahead="a as a.descripcion for a in $ctrl.articuloSearch($viewValue)"
                       typeahead-loading="$ctrl.articuloFiltro.loading"
                       typeahead-no-results="$ctrl.articuloFiltro.noResults"
                       typeahead-template-url="articuloSearchFiltroTemplate.html"
                       typeahead-editable="false"
                       typeahead-on-select="$ctrl.selectedArticuloSearchFiltro($item)" />

                <script type="text/ng-template" id="articuloSearchFiltroTemplate.html">
                    <div class="autocomplete-suggestion-uib-typeahead">
                        <span class="item-title">
                            <small> {{match.model.descripcion}}</small><br>
                            <small><b>Código: </b>{{match.model.codigo}}</small>
                        </span>
                    </div>
                </script>

                <span class="ml-5" ng-if="$ctrl.articuloFiltro.loading"> <i class="fas fa-sync-alt fa-xs"></i> Loading...</span>
                <small class="text-danger ml-5" ng-if="$ctrl.articuloFiltro.noResults">No se encontraron resultados</small>
            </div>
        </div>
    </div>

    <div class="row" ng-if="$ctrl.dataSearch.checkBoxFecha">
        <div class="col-xl-4 col-lg-4 col-md-6 col-sm-12 col-12">
            <div class="form-group">
                <label class="control-label">Mes: </label>
                <select ng-model="$ctrl.dataSearch.mes" class="form-control" ng-change="$ctrl.getFechaInicioFinFiltro(mes)">
                    <option ng-value="m.numero" ng-repeat="m in $ctrl.meses">{{m.nombre}}</option>
                </select>
            </div>
        </div>
        <div class="col-xl-4 col-lg-4 col-md-6 col-sm-12 col-12">
            <div class="form-group">
                <label>Fecha Inicio:</label>
                <input type="date" class="form-control border-select" ng-model="$ctrl.dataSearch.fechaInicio" />
            </div>
        </div>
        <div class="col-xl-4 col-lg-4 col-md-6 col-sm-12 col-12">
            <div class="form-group">
                <label>Fecha Fin:</label>
                <input type="date" class="form-control border-select" ng-model="$ctrl.dataSearch.fechaFin" />
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-4 col-md-4 col-sm-6 col-xs-12" ng-if="$ctrl.dataSearch.checkBoxBodega">
            <div class="form-group">
                <label for="bodega">Bodega</label>
                <select class="form-control border-select" ng-model="$ctrl.dataSearch.byBodega">
                    <option ng-value="b.idBodega" ng-repeat="b in $ctrl.bodegas">{{b.descripcion}}</option>
                </select>
            </div>
        </div>

        <div class="col-lg-4 col-md-4 col-sm-6 col-xs-12" ng-if="$ctrl.dataSearch.checkBoxMovement">
            <div class="form-group">
                <label for="bodega">Movimiento</label>
                <select class="form-control border-select" ng-model="$ctrl.dataSearch.movement">
                    <option ng-value="item.codigo" ng-repeat="item in $ctrl.estadoMovimientos">{{item.descripcion}}</option>
                </select>
            </div>
        </div>

    </div>
</div>
<div class="modal-footer">
    <button type="button" class="btn btn-info" ng-click="$ctrl.searchKardex()"> <i class="fa fa-search"></i> Buscar</button>
    <button class="btn btn-dark" ng-click="$ctrl.closeModal()">&times; Cerrar</button>
</div>

