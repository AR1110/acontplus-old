@page
@model Inventario_UI.Areas.PrecioMasivo.Pages.IndexModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Index";
    Layout = "_Layout";
}
<div ng-controller="precioMasivoCtrl">
    <div class="row page-titles">
        <div class="col-md-5 align-self-center">
            <h4 class="text-themecolor">Precio Masivo</h4>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <div class="row">
                <div class="col-xl-4 col-lg-4 col-md-4 col-sm-4 col-12">
                    <div class="form-group">
                        <label for="codEstab">Establecimientos:</label>
                        <select name="codEstab" id="codEstab" class="form-control" ng-model="mainForm.codEstab">
                            <option ng-value="item.codEstab" ng-repeat="item in establecimientos">
                                {{item.nombreComercial}}
                            </option>
                        </select>
                    </div>
                </div>
                <div class="col-xl-3 col-lg-3 col-md-4 col-sm-4 col-12">
                    <div class="form-group">
                        <label for="codEstab">Opciones:</label>
                        <select name="codEstab" id="codEstab" class="form-control" ng-model="mainForm.opcion">
                            <option ng-value="item.code" ng-repeat="item in catalogs">
                                {{item.description}}
                            </option>
                        </select>
                    </div>
                </div>
                <div class="col-lg-4 col-md-4 col-sm-4 col-12" ng-if="mainForm.opcion == 1">
                    <div class="form-group">
                        <label for="articuloFiltro">Articulo</label>
                        <input type="text" id="articuloSearchFiltro" autocomplete="off" name="articuloSearchFiltro"
                            class="form-control border-select" placeholder="Ingrese Descripción del Articulo"
                            ng-model="$ctrl.articuloFiltro.descripcion" ng-keyup="$ctrl.onKeyupArticuloSearchFiltro()"
                            uib-typeahead="a as a.descripcion for a in articuloSearch($viewValue)"
                            typeahead-loading="$ctrl.articuloFiltro.loading"
                            typeahead-no-results="$ctrl.articuloFiltro.noResults"
                            typeahead-template-url="articuloSearchFiltroTemplate.html" typeahead-editable="false"
                            typeahead-on-select="articleSelected($item)" onclick="this.select()" />

                        <script type="text/ng-template" id="articuloSearchFiltroTemplate.html">
                            <div class="autocomplete-suggestion-uib-typeahead">
                                <span class="item-title">
                                    <small> {{match.model.descripcion}}</small><br>
                                    <small><b>Código: </b>{{match.model.codigo}}</small>
                                </span>
                            </div>
                        </script>
                        <span class="ml-5" ng-if="$ctrl.articuloFiltro.loading"> <i class="fas fa-sync-alt fa-xs"></i>
                            Loading...</span>
                        <small class="text-danger ml-5" ng-if="$ctrl.articuloFiltro.noResults">No se encontraron
                            resultados</small>
                    </div>
                </div>
                <div class="col-xl-4 col-lg-4 col-md-4 col-sm-4 col-12" ng-if="mainForm.opcion==2">
                    <div class="form-group">
                        <label for="idFamilia">Familias:</label>
                        <select name="idFamilia" id="idFamilia" class="form-control" ng-model="mainForm.idFamilia"
                            ng-change="getArticles()">
                            <option ng-value="item.idFamilia" ng-repeat="item in familias">
                                {{item.descripcion}}
                            </option>
                        </select>
                    </div>
                </div>
                <div class="col-xl-4 col-lg-4 col-md-4 col-sm-4 col-12" ng-if="mainForm.opcion==3">
                    <div class="form-group">
                        <label for="idSubFamilia">Subfamilias:</label>
                        <select name="idSubFamilia" id="idSubFamilia" class="form-control"
                            ng-model="mainForm.idSubFamilia">
                            <option ng-value="item.idSubFamilia" ng-repeat="item in subfamilias"
                                ng-change="getArticles()">
                                {{item.descripcion}}
                            </option>
                        </select>
                    </div>
                </div>
                <div class="col-xl-4 col-lg-4 col-md-4 col-sm-4 col-12" ng-if="mainForm.opcion==4">
                    @await Html.PartialAsync("~/Views/Proveedor/_ProveedorAutocompleteFiltro.cshtml")
                </div>
                <div class="col-xl-4 col-lg-4 col-md-4 col-sm-4 col-12" ng-if="mainForm.opcion==5">
                    <div class="form-group">
                        <label for="nroDocumento">N° de Documento:</label>
                        <input type="text" class="form-control" id="nroDocumento" name="nroDocumento"
                            placeholder="000-000-000000000" onclick="this.select()" mask="999-999-999999999"
                            ng-blur="getArticles()" ng-model="mainForm.nroDocumento" required>
                    </div>
                </div>
            </div>
            <hr>
            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Cod.</th>
                            <th>Cod. Auxiliar</th>
                            <th>Articulo</th>
                            <th class="text-center">Stock</th>
                            <th>P. Costo</th>
                            <th>Pvp 1</th>
                            <th>Pvp 2</th>
                            <th>Pvp 3</th>
                            <th>Pvp 4</th>
                            <th>Pvp 5</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="item in articles track by $index" class="small">
                            <td>{{item.codigo}}</td>
                            <td>{{item.codigoAuxiliar}}</td>
                            <td>{{item.descripcion}}</td>
                            <td class="text-center">{{item.stock}}</td>
                            <td class="text-right">
                                <input type="number" class="form-control" step="any" value="{{item.precioCosto}}">
                            </td>
                            <td class="text-right">
                                <input type="number" class="form-control" step="any" value="{{item.pvp1}}">
                            </td>
                            <td class="text-right">
                                <input type="number" class="form-control" step="any" value="{{item.pvp2}}">
                            </td>
                            <td class="text-right">
                                <input type="number" class="form-control" step="any" value="{{item.pvp3}}">
                            </td>
                            <td class="text-right">
                                <input type="number" class="form-control" step="any" value="{{item.pvp4}}">
                            </td>
                            <td class="text-right">
                                <input type="number" class="form-control" step="any" value="{{item.pvp5}}">
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>

@section Scripts{
    <script type="text/javascript" src="~/js/inventario/controllers/precioMasivoCtrl.js" asp-append-version="true"></script>
}