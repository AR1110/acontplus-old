<div class="modal-header">
    <h5 class="modal-title"><i class="mdi mdi-whatsapp"></i> Envio de notificación por WhatsApp</h5>
    <button type="button" class="close" ng-click="closeModal()">&times;</button>
</div>
<div class="modal-body">
    <div class="row" ng-show="connected_devices != null">
        <div class="col-12">
            <div class="header">
                Device has connected
            </div>
            <p>
                Device ID: <b>{{current_device.device}}</b>
            </p>
        </div>
    </div>
    <div class="row">
        <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">
            <div class="text-center">
                <img src="{{session.src}}" id="qrcode" alt="" class="img-fluid">
            </div>
            <small class="text-info">{{session.message}}</small>
        </div>
    </div>
    <hr />
    <form ng-submit="sendMessage()" ng-if="session.isLogged">
        <div class="row">
            <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">
                <div class="form-group">
                    <label for="">Para:</label>
                    <input type="tel" name="" id="" class="form-control" ng-model="whatsapp.number" required>
                </div>
                <div class="form-group">
                    <label for="">Mensaje:</label>
                    <textarea type="tel" name="" id="" class="form-control" ng-model="whatsapp.message"
                        required></textarea>
                </div>
            </div>
        </div>
        <hr>
        <button type="submit" class="btn btn-success">
            <i class="fa fa-whatsapp" aria-hidden="true"></i>
            Enviar
        </button>
    </form>
</div>
<div class="modal-footer">
    <button type="button" class="btn btn-dark btn-sm" ng-click="closeModal()">
        &times; Cerrar
    </button>
</div>
