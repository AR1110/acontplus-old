<div class="modal-header">
    <h5 class="modal-title"><i class="fa fa-tags"></i> Dato adicional del artículo</h5>
    <button type="button" class="close">&times;</button>
</div>

<div class="modal-body">

    <div class="table-responsive">
        <table class="table table-sm">
            <thead>
                <tr>
                    <th ng-repeat="column in columns">{{column}}</th>
                    <th>
                        <button class="btn btn-info btn-sm" ng-click="addRow()">
                            <i class="fa fa-plus fa-fw"></i>
                        </button>
                    </th>
                </tr>
            </thead>
            <tbody>
                <tr ng-repeat="item in data">
                    <td ng-repeat="column in columns">
                        <input type="text" ng-model="item[column]" class="form-control border-select">
                    </td>
                    <td>
                        <button class="btn btn-danger btn-sm" ng-click="removeRow(item)">
                            <i class="ti-trash"></i>
                        </button>
                    </td>
                    </t>
            </tbody>
        </table>
    </div>

</div>

<div class="modal-footer">
    <button type="button" class="btn btn-success" ng-click="save()">
        <i class="ti-save"></i> Guardar
    </button>
    <button type="button" class="btn btn-dark" ng-click="closeModal()">
        &times; Cerrar
    </button>
</div>