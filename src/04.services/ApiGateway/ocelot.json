{
  "Routes": [
    {
      "UpstreamPathTemplate": "/api/Account",
      "UpstreamHttpMethod": [ "Post" ],
      "DownstreamPathTemplate": "/api/Account",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5415
        }
      ]
    },
    {
      "UpstreamPathTemplate": "/api/DocumentoRecibido/{json}",
      "UpstreamHttpMethod": [ "Get" ],
      "DownstreamPathTemplate": "/api/DocumentoRecibido/{json}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 40474
        }
      ],
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Bearer",
        "AllowedScopes": []
      },
      "RateLimitOptions": {
        "ClientWhitelist": [],
        "EnableRateLimiting": true,
        "Period": "60s",
        "PeriodTimespan": 1,
        "Limit": 1
      }
    }
  ],
  "GlobalConfiguration": {
    "BaseUrl": "http://localhost:57340/",
    "RequestIdKey": "OcRequestId",
    "RateLimitOptions": {
      "DisableRateLimitHeaders": false,
      "QuotaExceededMessage": "Request not allowed",
      "HttpStatusCode": 999,
      "ClientIdHeader": "Test"
    }
  }
}
