{
	"compilerOptions": {
		"paths": {
			"$components": [
				"../src/lib/components"
			],
			"$components/*": [
				"../src/lib/components/*"
			],
			"$constants": [
				"../src/lib/constants"
			],
			"$constants/*": [
				"../src/lib/constants/*"
			],
			"$contabilidad": [
				"../src/modules/contabilidad"
			],
			"$contabilidad/*": [
				"../src/modules/contabilidad/*"
			],
			"$home": [
				"../src/modules/home"
			],
			"$home/*": [
				"../src/modules/home/*"
			],
			"$interfaces": [
				"../src/lib/interfaces"
			],
			"$interfaces/*": [
				"../src/lib/interfaces/*"
			],
			"$inventario": [
				"../src/modules/inventario"
			],
			"$inventario/*": [
				"../src/modules/inventario/*"
			],
			"$modules": [
				"../src/modules"
			],
			"$modules/*": [
				"../src/modules/*"
			],
			"$restaurant": [
				"../src/modules/restaurant"
			],
			"$restaurant/*": [
				"../src/modules/restaurant/*"
			],
			"$sales": [
				"../src/modules/sales"
			],
			"$sales/*": [
				"../src/modules/sales/*"
			],
			"$services": [
				"../src/lib/services"
			],
			"$services/*": [
				"../src/lib/services/*"
			],
			"$technicalsupport": [
				"../src/modules/technical-support"
			],
			"$technicalsupport/*": [
				"../src/modules/technical-support/*"
			],
			"$utils": [
				"../src/lib/utils"
			],
			"$utils/*": [
				"../src/lib/utils/*"
			],
			"$vet": [
				"../src/modules/vet"
			],
			"$vet/*": [
				"../src/modules/vet/*"
			],
			"$lib": [
				"../src/lib"
			],
			"$lib/*": [
				"../src/lib/*"
			]
		},
		"rootDirs": [
			"..",
			"./types"
		],
		"verbatimModuleSyntax": true,
		"isolatedModules": true,
		"lib": [
			"esnext",
			"DOM",
			"DOM.Iterable"
		],
		"moduleResolution": "bundler",
		"module": "esnext",
		"noEmit": true,
		"target": "esnext"
	},
	"include": [
		"ambient.d.ts",
		"non-ambient.d.ts",
		"./types/**/$types.d.ts",
		"../vite.config.js",
		"../vite.config.ts",
		"../src/**/*.js",
		"../src/**/*.ts",
		"../src/**/*.svelte",
		"../tests/**/*.js",
		"../tests/**/*.ts",
		"../tests/**/*.svelte"
	],
	"exclude": [
		"../node_modules/**",
		"../src/service-worker.js",
		"../src/service-worker.ts",
		"../src/service-worker.d.ts"
	]
}