    "@types/tabulator-tables": "^5.5.4",
    "@types/toastr": "^2.1.43",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.28.0",
    "eslint-config-prettier": "^9.1.0",
