<form ng-submit="$ctrl.saveAndUpdate()" autocomplete="off">
    <div class="modal-header">
        <h5 class="modal-title">{{$ctrl.tipoRegistro===1?'Nuevo':'Editar'}} Actividad Etiqueta</h5>
        <button type="button" class="close" ng-click="$ctrl.closeModal()">&times;</button>
    </div>

    <div class="modal-body">
        <div class="row">
            <div class="col-lg-12 col-md-12 col-sm-12 col-12">
                <div class="form-group">
                    <label for="">Descripción</label>
                    <input type="text" touppercase ng-model="$ctrl.data.descripcion" 
                           ng-keyup="$ctrl.onKeyupDescripcion()" class="form-control border-select">
                </div>                
            </div>
            <div class="col-lg-12 col-md-12 col-sm-12 col-12">
                 <div class="form-group">
                    <label for="">Código</label>
                    <input type="text" touppercase ng-model="$ctrl.data.codigo" ng-disabled="$ctrl.tipoRegistro===2" class="form-control border-select">
                </div>
            </div>

            <div class="col-lg-12 col-md-12 col-sm-12 col-12">
                <div ng-if="$ctrl.tipoRegistro==2">
                    <label for="">Estado: </label>
                    <md-radio-group ng-model="$ctrl.data.estado">
                        <md-radio-button class="md-primary" ng-value="true">Activo</md-radio-button>
                        <md-radio-button ng-value="false">Inactivo</md-radio-button>
                    </md-radio-group>
                </div>
            </div>
        </div>


    </div>


    <div class="modal-footer">
        <button type="submit" class="btn btn-success">
            <i class="fas fa-{{$ctrl.tipoRegistro===1?'save':'edit'}}"></i>
            {{$ctrl.tipoRegistro===1?'Guardar':'Actualizar'}}
        </button>
        <button type="button" class="btn btn-dark" ng-click="$ctrl.closeModal()">&times; Cerrar</button>
    </div>
</form>