
@{
    ViewData["Title"] = "Index";
}
<div ng-controller="entidadFinancieraCtrl">
    <div ng-show="accion.leer">
        <div class="row page-titles">
            <div class="col-md-5 align-self-center">
                <h4 class="text-themecolor">Gestión de Entidad Financiera</h4>
            </div>
            <div class="col-md-7 align-self-center text-right">
                <div class="d-flex justify-content-end align-items-center">
                    @*<ol class="breadcrumb">
                        <li class="breadcrumb-item"><a href="javascript:void(0)">Inicio</a></li>
                        <li class="breadcrumb-item"><a href="javascript:void(0)">Admin</a></li>
                        <li class="breadcrumb-item active">Entidad Financiera</li>
                    </ol>*@
                    <button type="button" ng-if="accion.crear" ng-click="abrirModal(0,1)" class="btn btn-info m-l-15">
                        <i class="fa fa-plus-circle"></i> Nuevo
                    </button>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-lg-12">
                <div class="card">
                    <div class="card-body">
                        <md-toolbar class="md-table-toolbar md-default">
                            <div class="md-toolbar-tools">

                                <div class="col-lg-9 col-md-6 col-sm-1 col-xs-1 m-t-20">
                                    @*<span class="form-group pull-left page-size form-inline">
                                            <select class="form-control control-color"
                                                    ng-model="pageSize"
                                                    ng-change="changePageSize()"
                                                    ng-options="ra for ra in recordsQuantity">
                                            </select>
                                        </span>*@
                                </div>
                                <div class="col-lg-3 col-md-6 col-sm-11 col-xs-11">
                                    <input type="text" class="form-control" ng-model="buscar" placeholder="Buscar" />
                                </div>

                            </div>
                        </md-toolbar>
                        <!-- tabla articulo fraccionado -->
                        <md-table-container>
                            <table md-table md-progress="promise">
                                <thead md-head md-order="query.order" md-on-reorder="etiquetas">
                                    <tr md-row>
                                        <th md-column><span>N°</span></th>
                                        <th md-column>Código</th>
                                        <th md-column md-order-by="etiqueta.descripcion"><span>Descripción</span></th>
                                        <th md-column>Detalle</th>
                                        <th md-column>Estado</th>
                                        <th md-column ng-if="aacion.editar || accion.eliminar">Op.</th>
                                    </tr>
                                </thead>
                                <tbody md-body class="text-center">                       
                                    <tr md-row ng-repeat="ef in entidadesFinancieras|filter:buscar  | orderBy: query.order | limitTo: query.limit : (query.page -1) * query.limit">
                                        <td md-cell>{{$index+1}}</td>
                                        <td md-cell>{{ef.codigo}}</td>
                                        <td md-cell>{{ef.descripcion}}</td>
                                        <td md-cell ng-bind-html="ef.detalle | sino"></td>
                                        <td md-cell ng-bind-html="ef.estado | estadoPrimario"></td>
                                        <td md-cell ng-if="accion.editar||accion.eliminar">
                                            <button class="btn btn-info btn-xs" ng-if="accion.editar" ng-click="abrirModal(ef,2)"><i class="ti-pencil"></i></button>                                
                                            <button class="btn btn-danger btn-xs" ng-if="accion.eliminar" ng-click="delete(ef)" ><i class="ti-trash"></i></button>                                                               
                                        </td>
                                    </tr>
                                    <tr  ng-show="entidadesFinancieras.length==0" class="text-center">
                                        <td colspan="6">No hay registros disponibles en esta tabla.</td>
                                    </tr>
                                </tbody>
                            </table>
                        </md-table-container>
                        <md-table-pagination md-limit="query.limit" md-limit-options="recordsQuantity" md-page="query.page" md-total="{{totalRecords}}" md-page-select="options.pageSelect" md-boundary-links="options.boundaryLinks" md-on-paginate="logPagination"></md-table-pagination>
                    </div>
                </div>
            </div>
        </div>   

        <div class="modal fade" id="agregar" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel1" data-backdrop="static" data-keyboard="false">
            <div class="modal-dialog" role="document">
                <div class="modal-content">
                    <form ng-submit="saveUpdate(type)" class="form-material" autocomplete="off" novalidate>
                        <div class="modal-content">
                            <div class="modal-header {{colorHeader}}">
                                <h5 class="modal-title text-white">{{type==1?'Nuevo':'Editar'}} Entidad Financiera</h5>
                                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                    <span aria-hidden="true">&times;</span>
                                </button>
                            </div>
                            <div class="modal-body">
                                <div class="row">
                                    <div class="col-lg-12">
                                        <div class="form-group">
                                            <label for="descripcion">Descripción <span class="text-danger">*</span> </label>
                                            <input type="text" touppercase ng-model="data.descripcion" class="form-control">
                                        </div>
                                    </div>
                                    <div class="col-lg-12">
                                        <div class="form-group">
                                            <label for="telefono">Código <span class="text-danger">*</span> </label>
                                            <input type="text" ng-model="data.codigo" touppercase ng-disabled="data.descripcion==undefined || data.descripcion=='' || tipooperacion==2" class="form-control" placeholder="...">
                                        </div>
                                    </div>                                
                                </div>
                                                        
                                <div class="row">
                                    <div class="form-group col-lg-12 col-md-12 col-sm-12 col-12">
                                        <label for="telefono">Forma de Pago <span class="text-danger">*</span> </label>
                                        <select class="form-control border-select" ng-model="formaPagoSri" ng-options="fp as fp.descripcion for fp in formaPagos track by fp.idFormaPagoSri">
                                        </select>
                                    </div>
                                </div>
                                <div class="row">                               
                                    <div class="col-lg-6 col-md-6 col-sm-6 col-12">                                    
                                        <div class="form-group">
                                            <label for="Detalle">Detalle</label>
                                            <md-switch ng-model="data.detalle" aria-label="detalle">
                                                {{data.detalle?'SI':'NO'}}
                                            </md-switch>
                                        </div>                                   
                                    </div>
                                    <div class="col-lg-6">
                                    <div class="form-group" ng-show="type==2">
                                        <label for="estado">Estado</label>
                                            <md-radio-group ng-model="data.estado" aria-labelledby="favoriteFruit">
                                                <md-radio-button ng-value="true" class="md-primary">Activo</md-radio-button>
                                                <md-radio-button ng-value="false" class="md-primary">Inactivo</md-radio-button>                                        
                                            </md-radio-group>
                                    </div>                                   
                                    </div>
                                </div>
                                
                            </div>
                            <div class="modal-footer">
                                <button type="submit" class="btn btn-success"><i class="{{icono}}"></i> {{btnModal}}</button>
                                <button type="button" class="btn btn-dark" data-dismiss="modal"><i class="fa fa-close"></i>&times; Cerrar</button>
                            </div>
                        </div>
                    </form>

                </div>
            </div>
        </div>
    </div>
    <partial name="PageNotAccessible"/>
</div>

@section Scripts{
    <script src="~/js/controllers/financiera/entidadFinancieraCtrl.min.js" asp-append-version="true"></script>
}


