<form autocomplete="off" >
    <div class="modal-header">
        <h4 class="modal-title">{{tituloModal}} Transferencia Bodega</h4>
        <button type="button" class="close" ng-click="closeModal()">&times;</button>
    </div>
    <div class="modal-body">
        <div class="row">
            <div class="col-xl-6 col-lg-6 col-md-6 col-sm-12 col-12">
                <div class="row justify-content-between">
                    <div class="col-xl-6 col-lg-6 col-md-6 col-sm-12 col-sm-12">
                        <div class="form-group">
                            <label for="">Establecimiento Origen: <span class="text-danger">*</span></label>
                            <select class="form-control border-select" ng-model="data.codEstabOrigen"
                                ng-change="onChangeEstablecimientoOrigen()" ng-disabled="data.idTransferenciaBodega>0">
                                <option ng-value="item.codEstab" ng-repeat="item in establecimientosOrigen">
                                    {{item.nombreComercial}}
                                </option>
                            </select>
                        </div>
                    </div>

                    <div class="col-xl-6 col-lg-6 col-md-6 col-sm-12 col-12">
                        <div class="form-group">
                            <label for="">Bodega Origen: <span class="text-danger">*</span> </label>
                            <select class="form-control border-select" ng-model="data.idBodegaOrigen" ng-disabled="data.idTransferenciaBodega>0">
                                <option ng-value="item.idBodega" ng-repeat="item in bodegasOrigen">
                                    {{item.descripcion}}
                                </option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-6 col-lg-6 col-md-6 col-sm-12 col-12">
                <div class="row justify-content-between">
                    <div class="col-lg-6 col-md-6 col-sm-12 col-12">
                        <div class="form-group">
                            <label for="Establecimiento">Establecimiento Destino: <span
                                    class="text-danger">*</span></label>
                            <select class="form-control" ng-model="data.codEstabDestino"
                                ng-change="onChangeEstablecimientoDestino()" ng-disabled="data.idTransferenciaBodega>0">
                                <option ng-value="item.codEstab" ng-repeat="item in establecimientosDestino">
                                    {{item.nombreComercial}}
                                </option>
                            </select>
                        </div>
                    </div>
                    <div class="col-lg-6 col-md-6 col-sm-12 col-12">
                        <div class="form-group">
                            <label for="">Bodega Destino: <span class="text-danger">*</span> </label>
                            <select class="form-control border-select" ng-model="data.idBodegaDestino" ng-disabled="data.idTransferenciaBodega>0">
                                <option ng-value="item.idBodega" ng-repeat="item in bodegasDestino">
                                    {{item.descripcion}}
                                </option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-lg-3 col-md-4 col-sm-12 col-12">
                <div class="form-group">
                    <label for="">Punto Emision: <span class="text-danger"></span></label>
                    <select class="form-control border-select" ng-model="data.idPuntoEmision" ng-disabled="data.idTransferenciaBodega>0">
                        <option ng-value="item.idPuntoEmision" ng-repeat="item in puntosEmision">
                            {{item.ptoEmi}}
                        </option>
                    </select>
                </div>
            </div>
            <div class="col-lg-3 col-md-4 col-sm-12 col-12">
                <div class="form-group">
                    <label for="fechaEmision">Fecha Emisión: <span class="text-danger">*</span></label>
                    <input type="date" ng-model="data.fechaEmision" class="form-control border-select"
                        ng-requerid="true">
                </div>
            </div>

            <div class="col-lg-6 col-md-4 col-sm-12 col-12">
                <div class="form-group">
                    <label for="observación">Observación</label>
                    <textarea ng-model="data.observacion" touppercase class="form-control border-select" cols="20"
                        rows="2"></textarea>
                </div>
            </div>
        </div>

        <div class="row justify-content-between">
            <div class="col-lg-6">
                <div class="form-group">
                    <label for="articulo">Articulo</label>
                    <md-autocomplete-articulo-component tipo-doc="tipoDoc"
                        abrir-modal-articulo="abrirModalArticulo(item)"
                        get-data-articulo="getDataIdArticulo(item)"
                        set-item-articulo-en-detalle="setItemArticuloEnDetalle(item)" scope-parent="scopeParent"
                        id-bodega="data.idBodegaOrigen">
                    </md-autocomplete-articulo-component>
                </div>
            </div>
        </div>

        <div ui-grid="gridOptions" ui-grid-edit ui-grid-resize-columns ui-grid-cellNav ui-grid-auto-resize
            class="grid"></div>


    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-success" ng-click="onSave()">
            <i class="{{iconModal}}"></i> 
            {{btnText }}
            </button>
        <button type="button" class="btn btn-dark" ng-click="closeModal()">&times; Cerrar</button>
    </div>
</form>