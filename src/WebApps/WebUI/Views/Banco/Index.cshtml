
@{
    ViewData["Title"] = "Index";
}
<div ng-controller="bancoCtrl">
    <div class="row page-titles">
        <div class="col-md-5 align-self-center">
            <h4 class="text-themecolor">Gestión de Bancos</h4>
        </div>
        <div class="col-md-7 align-self-center text-right">
            <div class="d-flex justify-content-end align-items-center">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="javascript:void(0)">Inicio</a></li>
                    <li class="breadcrumb-item active">Banco</li>
                </ol>
                <button type="button" ng-click="abrirModal(0,1)" ng-if="accion.leer && accion.crear" class="btn btn-info d-lg-block m-l-15">
                    <i class="fa fa-plus-circle"></i> Nuevo
                </button>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-body">
                    <md-toolbar class="md-table-toolbar md-default">
                        <div class="md-toolbar-tools">

                            <div class="col-lg-9 col-md-6 col-sm-1 col-xs-1 m-t-20">
                                @*<span class="form-group pull-left page-size form-inline">
                            <select class="form-control control-color"
                                    ng-model="pageSize"
                                    ng-change="changePageSize()"
                                    ng-options="ra for ra in recordsQuantity">
                            </select>
                        </span>*@
                            </div>
                            <div class="col-lg-3 col-md-6 col-sm-11 col-xs-11">
                                <input type="text" class="form-control" ng-model="buscar" placeholder="Buscar" />
                            </div>

                        </div>
                    </md-toolbar>
                    <md-table-container>
                        <table md-table>
                            <thead md-head>
                                <tr md-row>                            
                                    <th md-column>N°</th>
                                    <th md-column>Codigo</th>
                                    <th md-column>Descripcion</th>
                                    <th md-column>Estado</th>                            
                                    <th md-column ng-if="accion.editar || accion.eliminar"></th>
                                </tr>
                            </thead>
                            <tbody md-body>
                                <tr md-row ng-repeat="b in bancos|filter:buscar  | orderBy: query.order | limitTo: query.limit : (query.page -1) * query.limit">                            
                                    <td md-cell>{{$index+1}}</td>
                                    <td md-cell>{{b.codigo}}</td>
                                    <td md-cell>{{b.descripcion}}</td>
                                    <td md-cell ng-bind-html="b.estado | estadoPrimario"></td>    
                                    <td md-cell ng-if="accion.editar || accion.eliminar">
                                        <div class="justify-content-center">
                                            <a href="javascript:void(0)" ng-if="accion.editar" ng-click="abrirModal(b,2)" class="btn btn-info btn-xs" tooltip title="Actualizar" data-toggle="tooltip"><i class="ti-pencil"></i></a>                                            
                                            <a href="javascript:void(0)" ng-if="accion.eliminar" ng-click="delete(b)" class="btn btn-danger btn-xs" tooltip data-toggle="tooltip" title="Eliminar"><i class="ti-trash"></i></a>                                    
                                        </div>
                                    </td>                        
                                </tr>

                            </tbody>                   
                        </table>                
                    </md-table-container>
                    <md-table-pagination md-limit="query.limit" md-limit-options="recordsQuantity" md-page="query.page" md-total="{{totalRecords}}" md-page-select="options.pageSelect" md-boundary-links="options.boundaryLinks" md-on-paginate="logPagination"></md-table-pagination>
                </div>
            </div>            
        </div>
    </div>    


    <div class="modal fade" id="agregar" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel1" data-backdrop="static" data-keyboard="false">
        <div class="modal-dialog" role="document">

            <form ng-submit="saveUpdate(type)" autocomplete="off" novalidate>
                <div class="modal-content">
                    <div class="modal-header {{colorHeader}}">
                        <h5 class="modal-title text-white"><i class="{{iconoModal}}"></i>{{tituloModal}}</h5>
                        <button class="close" data-dismiss="modal">&times;</button>
                    </div>
                    <div class="modal-body">
                        <md-input-container class="md-block">
                            <label for="Descripcion">Descripción <span class="text-danger">*</span></label>
                            <input type="text" ng-model="data.descripcion" ng-keyup="obtenerTresLetras(data)" placeholder="Ej: Guayaquil">
                        </md-input-container>
                        <md-input-container class="md-block">
                            <label for="codigo">Código <span class="text-danger">*</span></label>
                            <input type="text" ng-model="data.codigo" valid-letra touppercase ng-disabled="data.descripcion==undefined || data.tipoOperacion==2" placeholder="Ej: G">
                        </md-input-container>


                        <div ng-if="type==2">
                            <label for="">Estado: </label>
                            <md-radio-group ng-model="data.estado" aria-labelledby="estado">
                                <md-radio-button ng-value="true" class="md-primary">Activo</md-radio-button>
                                <md-radio-button ng-value="false">Inactivo</md-radio-button>
                            </md-radio-group>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="submit" class="btn {{colorHeader}} text-white"><i class="{{icono}}"></i> {{btnModal}}</button>
                        <button type="button" class="btn btn-dark" data-dismiss="modal">&times; Cerrar</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts{
    <script src="~/js/controllers/financiera/bancoCtrl.min.js" asp-append-version="true"></script>
}

