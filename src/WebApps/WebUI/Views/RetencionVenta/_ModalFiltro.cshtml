<div id="modalFiltroRetencionVenta" class="modal fade in" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Búsqueda</h5>
                <button class="close" data-dismiss="modal">&times;</button>
            </div>

            <div class="modal-body">
                <div class="row justify-content-between">
                    
                    <div class="col-lg-3 col-md-3 col-sm-3 col-xs-3">
                        <div class="icheck-info">
                            <input type="checkbox" id="checkboxClienteFilter" ng-model="dataSearch.checkBoxCliente">
                            <label for="checkboxClienteFilter">Cliente</label>
                        </div>                        
                    </div>

                    <div class="col-lg-3 col-md-3 col-sm-3 col-xs-3">
                        <div class="icheck-info">
                            <input type="checkbox"  ng-model="dataSearch.checkBoxFecha" ng-change="onChangeFechaFiltro()" id="checkboxFechaFilter">
                            <label for="checkboxFechaFilter">Fecha</label>
                        </div> 
                    </div>

                    <div class="col-lg-3 col-md-3 col-sm-3 col-xs-3">
                        <div class="icheck-info">
                            <input type="checkbox" ng-model="dataSearch.checkBoxUsuario" id="checkboxUsuarioFilter">
                            <label for="checkboxUsuarioFilter">Usuario</label>
                        </div>                          
                    </div>

                    <div class="col-lg-3 col-md-3 col-sm-3 col-xs-3">
                        <div class="icheck-info">
                            <input type="checkbox"  ng-model="dataSearch.checkBoxEstado" id="checkboxEstadoFilter">
                            <label for="checkboxEstadoFilter">Estado</label>
                        </div> 
                    </div>                    
                </div>               
                <hr>

                <div class="row">
                    <div class="col-lg-6 col-md-6 col-sm-12 col-12">
                        <div class="form-group">
                            <label for="sucursalFilter">Estab.</label>
                            <select class="form-control border-select" ng-model="dataSearch.codEstab">
                                <option ng-value="item.codEstab" ng-repeat="item in establecimientos">{{item.nombreComercial}}</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-lg-6 col-md-6 col-sm-12 col-12" ng-if="dataSearch.checkBoxCliente">
                        @await Html.PartialAsync("~/Pages/Cliente/_ClienteAutocompleteFiltro.cshtml")                                                                                                                       
                    </div>
                </div>

                <div class="row" ng-if="dataSearch.checkBoxFecha">             
                    <div class="col-xl-4 col-lg-4 col-md-4 col-sm-12 col-12">
                        <div class="form-group">
                            <label class="control-label">Mes: </label>
                            <select ng-model="mes" class="form-control" ng-change="getFechaInicioFinFilter(mes)">
                                <option ng-value="m.numero" ng-repeat="m in meses">{{m.nombre}}</option>
                            </select>
                        </div>
                    </div>

                    <div class="col-xl-4 col-lg-4 col-md-4 col-sm-12 col-12">
                        <div class="form-group">
                            <label>Fecha Inicio:</label>
                            <input type="date" class="form-control" ng-model="dataSearch.fechaInicio"/>
                        </div>
                    </div>

                    <div class="col-xl-4 col-lg-4 col-md-4 col-sm-12 col-12">
                        <div class="form-group">
                            <label>Fecha Fin:</label>
                            <input type="date" class="form-control" ng-model="dataSearch.fechaFin" />
                        </div>
                    </div>                                                                                                           
                </div>

                <div class="row">                    

                    <div class="col-xl-6 col-lg-6 col-md-6 col-sm-6 col-12" ng-show="dataSearch.checkBoxUsuario">
                        <div class="form-group">
                            <label>Usuario:</label>
                            @await Html.PartialAsync("~/Views/Usuario/_UsuarioSearchFilter.cshtml") 
                        </div>
                    </div>

                    <div class="col-xl-6 col-lg-6 col-md-6 col-sm-6 col-12" ng-show="dataSearch.checkBoxEstado">
                        <div class="form-group">
                            <label>Estado:</label>
                            <select id="idEstadoPago" class="form-control" ng-model="dataSearch.byEstado">
                                <option ng-value="item.idEstadoPago" ng-repeat="item in estadoPagos">
                                    {{item.descripcion}}
                                </option>
                            </select>
                        </div>
                    </div>                    
                </div>                  
            </div>

            <div class="modal-footer">
                <button class="btn btn-info" ng-click="filtrarRetencionVenta()"><i class="fa fa-search" aria-hidden="true"></i> Buscar</button>
                <button class="btn btn-dark" data-dismiss="modal">&times; Cerrar</button>
            </div>
        </div>
    </div>
</div>