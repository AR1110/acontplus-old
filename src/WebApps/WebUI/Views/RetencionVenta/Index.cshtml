@{
    ViewData["title"] = "Retencion Venta";
}
<style>
    .modal-full-width {
        width: 95%;
        max-width: none;
        height: 90%;
    }

    [uib-typeahead-popup].dropdown-menu {
        z-index: 999999 !important;
        max-height: 200px;
        overflow-y: auto;
        width: 50%;
    }
</style>

<div ng-controller="retencionVentaCtrl">
    <div>
        <div class="row page-titles">
            <div class="col-lg-5 align-self-center">
                <h5 class="text-themecolor">Gestión de Retención de Venta</h5>
            </div>
            <div class="col-lg-7 align-self-center text-right">
                <div class="d-flex justify-content-end align-item-center">
                    <button class="btn btn-info m-l-15" ng-if="accion.crear" ng-click="openModalNew()"><i class="fa fa-plus-circle"></i> Nuevo</button>
                </div>
            </div>
        </div>

       <partial name="_ModalFiltro" />

        <div class="row">
            <div class="col-lg-12">
                <div class="card">
                    <md-toolbar class="md-table-toolbar md-default">
                        <div class="md-toolbar-tools">
                            <div class="col-lg-8 col-md-9 col-sm-6 col-12">
                                <button class="btn btn-info" ng-click="openModalFiltroRetencionVenta()"><i class="fa fa-filter fa-xs"></i> Filtrar</button>                                
                            </div>
                            <div class="col-lg-4 col-md-3 col-sm-6 col-12">
                                <form class="form-material">
                                    <input type="text" class="form-control" ng-keyup="filterLocalRVenta()" ng-model="textFilterLocal" placeholder="Buscar" />
                                </form>
                            </div>
                        </div>
                    </md-toolbar>
                    <md-divider></md-divider>
                    <md-table-container style="max-height: 400px;">
                        <table resize md-table>
                            <thead fix-head md-head>
                                <tr md-row>
                                    <th md-column></th>                                    
                                    <th md-column>Nro. Doc.</th>
                                    <th md-column>F. Emisión</th>
                                    <th md-column>Cliente</th>
                                    <th md-column>Nro. Factura</th>
                                    <th md-column>T. IVA</th>
                                    <th md-column>T. RENTA</th>
                                    <th md-column>Total</th>                
                                    <th md-column>Usuario</th>                
                                    <th md-column>Estado</th>                
                                </tr>
                            </thead>
                            <tbody md-body>
                                <tr md-row ng-repeat="rv in retencionesVenta">
                                    <td md-cell>                                    
                                        <md-menu>
                                            <md-button aria-label="Open demo menu" class="md-icon-button"
                                                        ng-click="$mdMenu.open($event)">
                                                <icon class="mdi mdi-menu"></icon>
                                            </md-button>
                                            <md-menu-content class="md-dense">
                                                <md-menu-item>                                          
                                                    <md-button  ng-click="openModalDetalle(rv)">
                                                        <span md-menu-align-target><i class="ti-menu"></i> Detalle</span>
                                                    </md-button>
                                                </md-menu-item>
                                                
                                                <md-menu-item  ng-if="accion.editar">                                          
                                                    <md-button  ng-click="openModalEditar(rv)">
                                                        <span md-menu-align-target><i class="ti-pencil"></i> Editar</span>
                                                    </md-button>
                                                </md-menu-item>

                                                                           

                                                <md-menu-item  ng-if="accion.eliminar">                                          
                                                    <md-button ng-click="askToDelete(rv)">
                                                        <span md-menu-align-target><i class="ti-trash"></i> Eliminar</span>
                                                    </md-button>
                                                </md-menu-item>                                               

                                                <md-menu-item  ng-if="accion.reporte">                                          
                                                    <md-button ng-click="getReport(rv)">
                                                        <span md-menu-align-target><i class="ti-file"></i> PDF</span>
                                                    </md-button>
                                                </md-menu-item>
                                            </md-menu-content>
                                        </md-menu>
                                    </td>
                                    @* <td md-cell>{{$index+1}}</td> *@
                                    <td md-cell>{{rv.nroDoc}}</td>
                                    <td md-cell>{{rv.fechaEmision}}</td>
                                    <td md-cell>{{rv.cliente}}</td>
                                    <td md-cell>{{rv.nroFactura}}</td> 
                                    <td md-cell>${{rv.totalIva}}</td>
                                    <td md-cell>${{rv.totalRenta}}</td>
                                    <td md-cell>${{rv.total}}</td>            
                                    <td md-cell>{{rv.usuario}}</td>            
                                    <td md-cell>{{rv.estadoDoc}}</td>            
                                </tr>
                                <tr class="text-center" ng-show="retencionesVenta.length==0">
                                    <td colspan="9">No hay registros en esta tabla.</td>
                                </tr>                                                        
                            </tbody>
                            <tfoot md-foot>
                                <tr md-row>
                                    <td md-cell colspan="2">
                                        <span class="font-weight-bold">{{retencionesVenta.length}} Retenciones</span>
                                    </td>
                                    <td md-cell colspan="2"></td>
                                    <td md-cell colspan="1"><span class="font-weight-bold">Total: </span></td>
                                    <td md-cell colspan="1"><span class="font-weight-bold">${{totalIva}}</span></td>
                                    <td md-cell colspan="1"><span class="font-weight-bold">${{totalRenta}}</span></td>
                                    <td md-cell colspan="1"><span class="font-weight-bold">${{total}} </span></td>
                                    <td md-cell colspan="2"></td>
                                </tr>
                            </tfoot>
                        </table>
                    </md-table-container>
                </div>
            </div>
        </div>

     
        
    </div>
    

</div>

@section Scripts{
    <script src="~/js/factElect/services/facturaService.min.js" asp-append-version="true"></script>
    <script src="~/js/ventas/controllers/retencionVentaCtrl.min.js" asp-append-version="true"></script>
}

