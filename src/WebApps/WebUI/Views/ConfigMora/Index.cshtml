
@{
    ViewData["title"] = "Config. Mora";
}

<div ng-controller="configMoraCtrl" ng-cloak>
    <div ng-if="accion.leer">
        <div class="row page-titles">
            <div class="col-md-5 align-self-center">
                <h4 class="text-themecolor">Gestión de Config. Mora</h4>
            </div>
            <div class="col-md-7 align-self-center text-right">
                <div class="d-flex justify-content-end align-items-center">
                    @*<ol class="breadcrumb">
                            <li class="breadcrumb-item"><a href="javascript:void(0)">Inicio</a></li>
                            <li class="breadcrumb-item"><a href="javascript:void(0)">Configuracón</a></li>
                            <li class="breadcrumb-item active">Config. Mora</li>
                        </ol>*@
                    <button type="button" ng-if="accion.crear" ng-click="abrirModal(0,1)" class="btn btn-info  m-l-15">
                        <i class="ti-plus"></i> Nuevo
                    </button>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-lg-12">
                <div class="card">
                    <div class="card-body">
                        <md-table-container>
                            <table md-table>
                                <thead md-head md-order="query.order" md-on-reorder="contraPartidas">
                                    <tr md-row>
                                        <th md-column><span>N°</span></th>
                                        <th md-column md-order-by="diasGracia"><span>Dias de Gracia</span></th>
                                        <th md-column>%. Mora</th>
                                        <th md-column>Tiempo Config.</th>
                                        @*<th md-column>Estado</th>*@
                                        <th md-column class="text-center" ng-if="accion.editar || accion.eliminar">Op.</th>
                                    </tr>
                                </thead>
                                <tbody md-body class="text-center">

                                    <tr md-row ng-repeat="c in configMoras | filter: buscar  | orderBy: query.order | limitTo: query.limit : (query.page -1) * query.limit">
                                        <td md-cell>{{$index+1}}</td>
                                        <td md-cell>{{c.diaGracia}}</td>
                                        <td md-cell><b class="text-primary">{{c.configuracionMora.porcentajeMora | currency:'%'}}</b></td>
                                        <td md-cell>{{c.configuracion}}</td>
                                        @*<td md-cell ng-bind-html="c.configuracionMora.estado| estadoPrimario">
                                            </td>*@
                                        <td md-cell class="text-center" ng-if="accion.editar || accion.eliminar">
                                            <md-button class="md-icon-button md-primary" ng-if="accion.editar" ng-click="abrirModal(c,2)" aria-label="Editar Config. Mora">
                                                <i class="fa fa-edit"></i>
                                            </md-button>
                                            <md-button class="md-icon-button md-accent" ng-if="accion.eliminar" ng-click="eliminarConfigMora(c)" aria-label="Eliminar Config. Mora">
                                                <i class="fa fa-trash"></i>
                                            </md-button>
                                        </td>
                                    </tr>
                                    <tr ng-show="configMoras.length==0" class="text-center">
                                        <td colspan="6">
                                            No hay registros en esta tabla :)
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </md-table-container>
                    </div>
                </div>
            </div>
        </div>
   
        <!--Modal Agregar Config. Mora-->
        <div class="modal fade" id="agregar" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel1" data-backdrop="static" data-keyboard="false">
            <div class="modal-dialog modal-sm" role="document">
                <div class="modal-content">
                    <form ng-submit="saveUpdate(tipo)" class="form-material" autocomplete="off" novalidate>
                        <div class="modal-content">
                            <div class="modal-header {{colorHeader}}">
                                <h5 class="modal-title text-white" id="exampleModalLabel"><i class="{{iconoModal}}"></i>{{tituloModal}}</h5>
                                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                    <span aria-hidden="true">&times;</span>
                                </button>
                            </div>
                            <div class="modal-body">
                                <div class="row">
                                    <div class="form-group col-lg-12 col-md-12 col-sm-12 col-12">
                                        <label for="dias_de_gracia">Dias de Gracia:  <span class="text-danger">*</span> </label>
                                        <input type="text" valid-number ng-model="data.diasGracia" class="form-control" placeholder="00">
                                    </div>
                                    <div class="form-group col-lg-12 col-md-12 col-sm-12 col-12">
                                        <label for="">% Mora: <span class="text-danger">*</span> </label>
                                        <input type="text" valid-number ng-model="data.porcentajeMora" id="porcentajeMora" class="form-control" placeholder="000">
                                    </div>
                                    @*<div class="form-group col-lg-12 col-md-12 col-sm-12 col-12" ng-show="tipo==2">
                                            <label for="Estado">Estado: </label>
                                            <md-radio-group ng-model="data.estado" aria-labelledby="Estado">
                                                <md-radio-button value="1" class="md-primary">Activo</md-radio-button>
                                                <md-radio-button value="0">Inactivo</md-radio-button>
                                            </md-radio-group>
                                        </div>*@

                                    @*<div class="form-group col-lg-12 col-md-12 col-sm-12 col-12">
                                            <label for="telefono">Tiempo Config.:  </label>
                                            <md-switch ng-model="data.tiempoConfiguracion" disabled aria-label="Tiempo Config">
                                            </md-switch>
                                        </div>*@
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="submit" class="btn btn-success"><i class="{{icono}}"></i> {{btnModal}}</button>
                                <button type="button" class="btn btn-dark" data-dismiss="modal"><i class="fa fa-close"></i>&times; Cerrar</button>
                            </div>
                        </div>
                    </form>

                </div>
            </div>
        </div>
    </div>

    <partial name="PageNotAccessible"/>
</div>

@section Scripts{
    <script src="~/js/config/controllers/configMoraCtrl.min.js" asp-append-version="true"></script>
}



