@{
    ViewData["title"] = "Pagos";
}


<div ng-controller="pagoCtrl">
    <div class="row page-titles">
        <div class="col-md-5 align-self-center">
            <h4 class="text-themecolor">Gestión de Egresos</h4>
        </div>
        <div class="col-md-7 align-self-center text-right">
            <div class="d-flex justify-content-end align-items-center">
                @* <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="javascript:void(0)">Inicio</a></li>
                <li class="breadcrumb-item"><a href="javascript:void(0)">Tesorería</a></li>
                <li class="breadcrumb-item active">Pagos</li>
                </ol> *@
                @* <button type="button" class="btn btn-info m-l-15" ng-if="accion.crear" ng-click="newPayment()"><i
                class="fa fa-plus-circle"></i> Nuevo</button> *@
            </div>
        </div>
    </div>

    @await Html.PartialAsync("_ModalPagoFiltro.cshtml")


    <div class="card">
        <div class="card-body">
            <div class="row justify-content-between">
                <div class="col-xl-4 col-lg-4 col-md-6 col-sm-12 col-12">
                    <button type="button" class="btn btn-info" ng-click="openModalPagoFiltro()"><i
                            class="fas fa-filter"></i> Filtro</button>
                </div>
                <div class="col-xl-4 col-lg-4 col-md-6 col-sm-12 col-12">
                    <form class="form-material">
                        <div class="input-group">
                            <input type="text" class="form-control" ng-model="buscar" placeholder="Buscar Pagos">
                            <div class="input-group-append">
                                <button class="btn btn-outline-secondary">
                                    <i class="fas fa-redo"></i>
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="card-body">
            <md-table-container style="max-height: 400px;">
                <table md-table>
                    <thead fix-head md-head md-order="options.order" md-on-reorder="pagos">
                        <tr md-row>
                            <th md-column ng-if="accion.historialFinanciero || accion.eliminar || accion.reporte">Op.
                            </th>
                            <th md-column>N°</th>
                            <th md-column>N°. Doc. </th>
                            <th md-column>F. Emision</th>
                            <th md-column>Proveedor</th>
                            <th md-column>Total</th>
                            <th md-column>Estado</th>
                            <th md-column>Usuario</th>
                        </tr>
                    </thead>
                    <tbody md-body>
                        <tr md-row ng-repeat="p in pagos | filter: buscar  | orderBy: options.order" ng-class="p.color">
                            <td md-cell ng-if="accion.historialFinanciero || accion.eliminar || accion.reporte">
                                <div class="dropdown h-2">
                                    <button class="btn btn-default " type="button" id="dropdownMenu"
                                        data-toggle="dropdown" data-boundary="viewport" aria-haspopup="true"
                                        aria-expanded="false">
                                        <i class="fa fa-bars"></i>
                                    </button>
                                    <div class="dropdown-menu" aria-labelledby="dropdownMenu">
                                        <button class="dropdown-item" type="button" ng-if="accion.historialFinanciero"
                                            ng-click="openModalHistorialPago(p)"><i class="ti-menu"></i>
                                            Detalle</button>
                                        <button class="dropdown-item" type="button" ng-if="accion.eliminar"
                                            ng-click="askToCancel(p)">&times; Anular</button>
                                        <button class="dropdown-item" type="button" ng-if="accion.reporte"
                                            ng-click="getReport(p)"><i class="ti-file"></i> PDF</button>

                                        <button class="dropdown-item" type="button" ng-if="accion.enviarCorreo"
                                            btn-send-to-email params="p" type-send="typeSend"
                                            get-param-to-send-mail="getParamToSendMail(params)"> <i
                                                class="far fa-envelope"></i>
                                            Enviar Correo</button>

                                        @* <button class="dropdown-item" type="button" uib-tooltip="Enviar por Whatsapp"
                                        tooltip-placement="top" btn-send-to-whats-app params="p"
                                        has-permission="hasPermissions" type-send="typeSend"> <i
                                        class="mdi mdi-whatsapp"></i> Enviar por Whatsapp</button> *@


                                    </div>
                                </div>
                            </td>
                            <td md-cell>{{$index+1}}</td>
                            <td md-cell>{{p.nroDoc}}</td>
                            <td md-cell>{{p.fechaRegistro}}</td>
                            <td md-cell>{{p.persona|uppercase}}</td>
                            <td md-cell>${{p.total}}</td>
                            <td md-cell>{{p.estado}}</td>
                            <td md-cell>{{p.usuario}}</td>
                        </tr>
                        <tr ng-if="pagos.length===0" class="text-center">
                            <td colspan="9">No hay registro en esta tabla.</td>
                        </tr>
                    </tbody>
                    <tfoot>
                        <tr>
                            <td></td>
                        </tr>
                    </tfoot>
                </table>
            </md-table-container>
        </div>
    </div>
</div>
@section Scripts{
    <script src="~/js/controllers/financiera/pagoCtrl.min.js" asp-append-version="true"></script>
}

