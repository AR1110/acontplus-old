@{
    ViewData["Title"] = "Index";
}

<hr />

<hr />
<br />
<form action="/Test/EncryptText" method="post">
    <input type="text" name="txtToEncrypt" class="form-control" value="" required />
    <button type="submit" class="btn btn-info">encrypt</button>
</form>
<a class="nav-link text-dark" asp-page="/Index" asp-area="MyFeature">MyFeature</a>
<a class="nav-link text-dark" asp-page="/Index" asp-area="Documento">Documento</a>
<div ng-controller="testCtrl">
    <div class="card">
        <div class="card-body">
            <h5 class="card-body">Envios por whatsapp</h5>
            <div class="row">
                <div class="col-6">
                    <img src="" class="img-rounded" alt="QR Code" id="qrcode">
                    <ul class="logs"></ul>
                </div>
            </div>

            <div class="form-container">
                <form ng-submit="login()">
                    <label for="client-id">ID</label><br>
                    <input type="text" id="client-id" ng-model="client.id" class="form-control" placeholder="ID">
                    <br><br>
                    <label for="client-description">Descripción</label><br>
                    <textarea rows="3" id="client-description" ng-model="client.description" class="form-control"
                              placeholder="Session description"></textarea>
                    <br>
                    <button type="submit" class="btn btn-success"><i class="fa fa-sign-in"></i> Login</button>
                </form>
                <div class="table-responsive">
                    <table class="table">
                        <tbody>
                            <tr ng-repeat="item in sessions">
                                <td>{{item.id}}</td>
                                <td>{{item.description}}</td>
                                <td><img src="" id="{{item.id}}-qrcode" alt=""></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <form ng-submit="sendMessage()">
                <div class="row">
                    <div class="col-6">
                        <div class="form-group">
                            <label for="">Para:</label>
                            <input type="tel" name="" id="" class="form-control" ng-model="whatsapp.number" required>
                        </div>
                        <div class="form-group">
                            <label for="">Mensaje:</label>
                            <textarea type="tel" name="" id="" class="form-control" ng-model="whatsapp.message"
                                      required></textarea>
                        </div>
                    </div>
                </div>
                <hr>
                <button type="submit" class="btn btn-success">
                    <i class="fa fa-whatsapp" aria-hidden="true"></i>
                    Enviar
                </button>
            </form>
        </div>
    </div>

    <button type="button" class="btn btn-info" ng-click="print()">
        <i class="fa fa-server"></i> Test Local
        Server
    </button>
</div>

<form action="/Test/GenerateRandomKey" method="post">
    <button type="submit" class="btn btn-info">Generate Key</button>
</form>

