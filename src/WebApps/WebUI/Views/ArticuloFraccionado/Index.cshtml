@{
    ViewData["Title"] = "Index";
}
<div ng-controller="articuloFraccionableCtrl as $ctrl">
    <div class="row page-titles">
        <div class="col-md-5 align-self-center">
            <h4 class="text-themecolor">Articulos Fraccionables</h4>
        </div>
        <div class="col-md-7 align-self-center text-right">
            <div class="d-flex justify-content-end align-items-center">
                <!--<ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/Home/Index">Inicio</a></li>
                    <li class="breadcrumb-item"><a href="javascript:void(0)">Almacen</a></li>
                    <li class="breadcrumb-item active">Articulo Fraccionable</li>
                </ol>-->
                <button type="button" class="btn btn-info m-l-15" ng-if="accion.crear" ng-click="openModal()"><i
                        class="fa fa-plus-circle"></i> Nuevo</button>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-12">
            <md-toolbar class="md-table-toolbar md-default">
                <div class="md-toolbar-tools">

                    <div class="col-lg-9 col-md-9 col-sm-1">

                    </div>
                    <div class="col-lg-3 col-md-3 col-sm-12 col-12">
                        <form class="form-material">
                            <input type="text" class="form-control" ng-model="buscarText"
                                placeholder="Buscar Articulo" />
                        </form>
                    </div>
                </div>
            </md-toolbar>
            <div class="card">
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-condensed">
                            <thead>
                                <tr>
                                    <th ng-if="accion.editar || accion.eliminar">Op.</th>
                                    <th>N°</th>
                                    <th>Articulo</th>
                                    <th>Conversión</th>
                                    <th>P. Costo Fraccionado</th>
                                    <th>Medida</th>
                                    <th>Gestión</th>
                                    <th>Estado</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="af in articuloFraccionados | filter: buscarText">
                                    <td ng-if="accion.editar || accion.eliminar">
                                        <div class="row justify-content-center">
                                            <button type="button" class="btn btn-info btn-sm" ng-if="accion.editar"
                                                ng-click="openModal(af)"><i class="ti-pencil"></i></button>
                                            <button type="button" class="btn btn-danger btn-sm ml-1"
                                                ng-if="accion.eliminar" ng-click="askToDelete(af)"><i
                                                    class="ti-trash"></i></button>
                                        </div>
                                    </td>
                                    <td>{{$index+1}}</td>
                                    <td><b class="text-primary">{{af.articulo}}</b></td>
                                    <td>{{af.conversion}}</td>
                                    <td>${{af.precioCostoFraccionado}}</td>
                                    <td>{{af.medida}}</td>
                                    <td>
                                        <span>
                                            {{af.fraccionado.gestionVenta?'Venta':'Compra'}}
                                        </span>
                                    </td>
                                    <td ng-bind-html="af.estado | estadoPrimario"></td>

                                </tr>
                                <tr class="text-center" ng-show="articuloFraccionados.length===0">
                                    <td colspan="7">No hay registros :)</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script src="~/js/inventario/controllers/articuloFraccionableCtrl.min.js" asp-append-version="true"></script>
}



