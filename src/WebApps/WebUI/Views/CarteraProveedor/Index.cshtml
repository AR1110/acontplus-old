@{
    ViewData["title"] ="Cartera Proveedor";
}
<style>
     .modal-full-width {
        width: 95%;
        max-width: none; 
        height: 90%; 
    } 
</style>
<div ng-controller="carteraProveedorCtrl">
    <div class="row page-titles">
        <div class="col-md-5 align-self-center">
            <h4 class="text-themecolor">Gestión de Cartera Proveedores</h4>
        </div>
        <div class="col-md-7 align-self-center text-right">
            <div class="d-flex justify-content-end align-items-center">              
               
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-body">
                    <div class="row justify-content-between mb-1">
                        <div class="col-lg-4 col-md-4 col-sm-6 col-12">
                            <button type="button" ng-click="openModalFiltro()" class="btn btn-info"><i class="mdi mdi-filter"></i> Filtro</button>
                            <button class="btn btn-danger waves-effect waves-light" ng-click="getDownload()" type="button">
                                <span class="btn-label">
                                    <i class="ti-file"></i>
                                </span> Reporte 
                            </button>                            
                        </div>
                        <div class="col-lg-4 col-md-4 col-sm-6 col-12">
                            <div class="form-material-form">
                                <input type="text" ng-model="txtSearch" ng-keyup="filterLocal()" class="form-control border-select" placeholder="Buscar">
                            </div>
                        </div>
                    </div>
                    
                    <md-table-container style="max-height: 400px;">
                        <table resize md-table>
                            <thead fix-head md-head>
                                <tr md-row>
                                    <th md-column></th> 
                                    <th md-column>N°</th>
                                    <th md-column>T. Doc</th>
                                    <th md-column>Nro. Doc</th>   
                                    <th md-column>Proveedor</th>                                                                                                                                                             
                                    <th md-column>F. Emisión</th>                                                                                                                                                           
                                    <th md-column>Total</th>
                                    <th md-column>Abono</th>
                                    <th md-column>Saldo</th>
                                    <th md-column>F. Vcto</th>                          
                                    <th md-column>Estado</th>                                    
                                </tr>
                            </thead>
                            <tbody md-body>
                                <tr md-row ng-repeat="cartera in carteraProveedores">                                    
                                    <td md-cell>
                                        <div class="d-flex justify-content-center">
                                            <button ng-click="openModalDocumento(cartera)" class="btn btn-secondary btn-xs" tooltip data-tooltip data-title="Ver Documento"><i class=" far fa-file"></i> </button>
                                            @* <button ng-click="verDocumento()" class="btn btn-warning btn-xs ml-1" tooltip data-tooltip data-title="Cuota por Cobrar"><i class="fas fa-clipboard-list"></i> </button> *@
                                        </div> 
                                    </td> 
                                    <td md-cell>{{$index+1}}</td>
                                    <td md-cell>{{cartera.codigo}}</td>
                                    <td md-cell>{{cartera.nroDoc}}</td>
                                    <td md-cell>{{cartera.nombreFiscal}}</td>
                                    <td md-cell>{{cartera.fechaEmision}}</td>
                                    <td md-cell>{{cartera.total}}</td>
                                    <td md-cell>{{cartera.abono}}</td>
                                    <td md-cell>{{cartera.saldo}}</td>             
                                    <td md-cell>{{cartera.fechaVencimiento}}</td>
                                    <td md-cell>{{cartera.estadoFinanciero}}</td>
                                </tr>

                                <tr class="text-center" ng-if="carteraProveedores.length===0">
                                    <td colspan="11">No hay registros en esta tabla</td>
                                </tr>
                                
                            </tbody>
                            <tfoot md-foot>
                            <tr md-row>
                                <td md-cell></td>
                                <td md-cell></td>
                                <td md-cell></td>
                                <td md-cell colspan="3"><span class="font-weight-bold">Total: </span></td>
                                <td md-cell><span class="font-weight-bold">${{total}}</span></td>
                                <td md-cell><span class="font-weight-bold">${{abono}}</span></td>
                                <td md-cell><span class="font-weight-bold">${{saldo}}</span></td>                                
                                <td md-cell><span class="font-weight-bold"></span></td>                                
                                <td md-cell><span class="font-weight-bold"></span></td>                                
                            </tr>
                        </tfoot>
                        </table>
                    </md-table-container>
                </div>
            </div>
        </div>
    </div>

    <partial name="_ModalFiltroCarteraProveedor"/>

</div>

@section Scripts{
    <script src="~/js/controllers/financiera/carteraProveedorCtrl.min.js" asp-append-version="true"></script>    
}