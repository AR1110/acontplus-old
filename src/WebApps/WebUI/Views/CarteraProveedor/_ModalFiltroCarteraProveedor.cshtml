<div id="modalFiltroCarteraProveedor" class="modal fade in" role="dialog" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="mdi mdi-filter-outline"></i> Filtro</h5>
                <buton class="close" data-dismiss="modal">&times;</buton>
            </div>
            <div class="modal-body">
                <div class="row justify-content-between">                   
                    <div class="col-xl-3 col-lg-3 col-md-3 col-sm-4 col-12">
                        <div class="icheck-info">
                            <input type="checkbox" ng-model="dataSearch.checkBoxProveedor" id="checkBoxProveedorFiltro">
                            <label for="checkBoxProveedorFiltro">Proveedor</label>
                        </div>
                    </div>
                    <div class="col-xl-3 col-lg-3 col-md-3 col-sm-4 col-12">
                        <div class="icheck-info">
                            <input type="checkbox" ng-model="dataSearch.checkBoxFecha" ng-change="onChangeFecha()" id="checkBoxFechaFiltro">
                            <label for="checkBoxFechaFiltro">Fecha</label>
                        </div>
                    </div>

                    <div class="col-xl-2 col-lg-2 col-md-3 col-sm-6 col-12">
                        <div class="icheck-info">
                            <input type="checkbox" ng-model="dataSearch.checkBoxEstado" id="checkBoxEstadoFiltro">
                            <label for="checkBoxEstadoFiltro">Estado</label>
                        </div>
                    </div>
                </div>
                <hr>

                <div class="row">
                    <div class="col-lg-6 col-md-6 col-sm-12 col-12">
                        <div class="form-group">
                            <label for="filtroSucursal">Sucursal</label>
                            <select class="form-control" ng-model="dataSearch.codEstab">
                                <option ng-value="item.codEstab" ng-repeat="item in establecimientos">{{item.nombreComercial}}</option>
                            </select>
                        </div>
                    </div>                    
                    <div class="col-lg-6 col-md-6 col-sm-12 col-12" ng-show="dataSearch.checkBoxProveedor">                        
                        @await Html.PartialAsync("~/Views/Proveedor/_ProveedorAutocompleteFiltro.cshtml")                        
                    </div>
                </div>

                <div class="row" ng-if="dataSearch.checkBoxFecha">             
                    <div class="col-xl-3 col-lg-3 col-md-3 col-sm-12 col-12">
                        <div class="form-group">
                            <label class="control-label">Mes: </label>
                            <select ng-model="mes" class="form-control" ng-change="getFechaInicioFinFilter(mes)">
                                <option ng-value="m.numero" ng-repeat="m in meses">{{m.nombre}}</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-xl-3 col-lg-3 col-md-3 col-sm-12 col-12">
                        <div class="form-group">
                            <label>Fecha Inicio:</label>
                            <input type="date" class="form-control" ng-model="dataSearch.fechaInicio"/>
                        </div>
                    </div>
                    <div class="col-xl-3 col-lg-3 col-md-3 col-sm-12 col-12">
                        <div class="form-group">
                            <label>Fecha Fin:</label>
                            <input type="date" class="form-control" ng-model="dataSearch.fechaFin" />
                        </div>
                    </div>

                    <div class="col-xl-3 col-lg-3 col-md-3 col-sm-12 col-12">
                        <div class="form-group">
                            <label for="">Tipo Fecha</label>
                            <div class="icheck-info">
                                <input type="radio" ng-model="dataSearch.tipoFecha" value="FE" id="tipoFechaEmision" name="tipoFecha">
                                <label for="tipoFechaEmision"> Fecha Emisión</label>
                            </div>
                            <div class="icheck-info">
                                <input type="radio" ng-model="dataSearch.tipoFecha" value="FV" id="tipoFechaVencimiento" name="tipoFecha">
                                <label for="tipoFechaVencimiento"> Fecha Vencimiento</label>
                            </div>
                        </div>
                    </div>                                                                                               
                </div>                

                <div class="row">
                    <div class="col-lg-3" ng-show="dataSearch.checkBoxEstado">
                        <div class="form-group">
                            <label>Estado:</label>
                            <select class="form-control" ng-model="dataSearch.byEstado">
                                <option ng-value="item.idEstadoPago" ng-repeat="item in estadoDocumentos">
                                    {{item.descripcion}}
                                </option>
                            </select>
                        </div>
                    </div>                    
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-success" ng-click="filtrar()"><i class="fa fa-search"></i> Buscar</button>
                <button type="button" class="btn btn-dark" data-dismiss="modal">&times; Cerrar</button>
            </div>
        </div>
    </div>
</div>