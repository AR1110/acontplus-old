@{
    ViewData["Title"] = "Firma E";
}
<div ng-controller="firmaElectronicaCtrl">
    <div>
        <div class="row page-titles">
            <div class="col-md-5 align-self-center">
                <h4 class="text-themecolor">Firma Electrónica</h4>
            </div>
            <div class="col-md-7 align-self-center text-right">
                <div class="d-flex justify-content-end align-items-center">
                    <button type="button" ng-if="accion.crear" ng-click="openModal(null,1)"
                            class="btn btn-info  m-l-15">
                        <icon class="ti-plus"></icon> Nuevo
                    </button>
                </div>
            </div>
        </div>


        <div class="row">
            <div class="col-lg-12">
                <md-card>
                    <md-card-content>
                        <md-table-responsive>
                            <table md-table>
                                <thead md-head>
                                    <tr md-row>
                                        <th md-column>N°.</th>
                                        <th md-column>Entidad</th>
                                        <th md-column>Contraseña</th>
                                        <th md-column>Archivo</th>
                                        <th md-column ng-if="accion.editar || accion.eliminar">Op.</th>
                                    </tr>
                                </thead>
                                <tbody md-body>
                                    <tr md-row ng-repeat="item in firmas">
                                        <td md-cell>{{$index+1}}</td>
                                        <td md-cell>{{item.razonSocial}}</td>
                                        <td md-cell ng-mouseover="verContrasenia(item)"
                                            ng-mouseleave="contraseniaEncryp(item)">
                                            {{item.contraseniaEncryp}}
                                        </td>
                                        <td md-cell>{{item.nombreArchivo}}</td>
                                        <td md-cell ng-if="accion.editar || accion.eliminar">
                                            <div class="justify-content-center">
                                                <a href="javascript:void(0)" ng-if="accion.editar"
                                                   ng-click="openModal(item,2)" class="btn btn-info btn-xs"
                                                   title="Actualizar" data-toggle="tooltip">
                                                    <i class="ti-pencil"></i>
                                                </a>
                                                <a href="javascript:void(0)" ng-if="accion.eliminar"
                                                   ng-click="askToDelete(item)" class="btn btn-danger btn-xs"
                                                   data-toggle="tooltip" title="Eliminar"><i class="ti-trash"></i></a>
                                            </div>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </md-table-responsive>
                    </md-card-content>
                </md-card>
            </div>
        </div>

        <div id="modalFirma" class="modal fade" tabindex="-1" role="dialog">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <form name="formFirma" autocomplete="off" class="form-material" ng-submit="post()">
                        <div class="modal-header">
                            <h4 class="modal-title" id="myModalLabel"><i class="ti-plus"></i> Registrar Firma</h4>
                            <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                        </div>
                        <div class="modal-body">
                            <div class="row">
                                <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">
                                    <div class="form-group">
                                        <label>Contraseña:</label>
                                        <input type="text" class="form-control" ng-model="firma.contrasenia" name="name"
                                               value="" required />
                                    </div>
                                    <div class="form-group">
                                        <label for="fechaCaducidad">Fecha Caducidad: </label>
                                        <input type="date" class="form-control" ng-model="firma.fechaCaducidad"
                                               required />
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">
                                    <div class="form-group">
                                        <label>Formato de archivos: <span class="text-info">.p12</span> </label>
                                        <input type="file" class="form-control" ngf-select ng-model="fileSign" />
                                        <i ng-show="formFirma.fileSign.$error.pattern" class="text-danger">
                                            Formato de archivo no aceptado
                                        </i>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="submit" class="btn btn-outline-success waves-effect waves-light">
                                <i class="ti-save"></i> Guardar
                            </button>
                            <button type="button" class="btn btn-outline-dark waves-effect" data-dismiss="modal">
                                &times;
                                Cerrar
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div id="modalUpdate" class="modal fade" tabindex="-1" role="dialog">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <form ng-submit="put()" class="form-material" autocomplete="off">
                        <div class="modal-header">
                            <h4 class="modal-title" id="myModalLabel">
                                <i class="ti-pencil-alt"></i> Actualizar Firma
                            </h4>
                            <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                        </div>
                        <div class="modal-body">
                            <div class="row">
                                <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">
                                    <div class="form-group">
                                        <label>Contraseña:</label>
                                        <input type="text" class="form-control" ng-model="firma.contrasenia" name="name"
                                               value="" required />
                                    </div>
                                    <div class="form-group">
                                        <label for="fechaCaducidad">Fecha Caducidad: </label>
                                        <input type="date" class="form-control" ng-model="firma.fechaCaducidad"
                                               required />
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">
                                    <md-switch ng-model="data.estado" aria-label="Switch 1">
                                       ¿Actualizar Archivo Firma?
                                    </md-switch>
                                </div>
                                <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12" ng-if="data.estado">
                                    <div class="form-group">
                                        <label>Formato de archivos: <span class="text-info">.p12</span> </label>
                                        <input type="file" class="form-control" ngf-select ng-model="fileSign" />
                                        <i ng-show="formFirma.fileSign.$error.pattern" class="text-danger">
                                            Formato de archivo no aceptado
                                        </i>
                                    </div>
                                </div>
                            </div>
                            
                        </div>
                        <div class="modal-footer">
                            <button type="submit" class="btn btn-outline-success waves-effect waves-light">
                                <i class="ti-save"></i> Guardar
                            </button>
                            <button type="button" class="btn btn-outline-dark waves-effect" data-dismiss="modal">
                                &times;
                                Cerrar
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
    
</div>
@section Scripts{
    <script src="~/js/config/controllers/firmaElectronicaCtrl.min.js" asp-append-version="true"></script>
}