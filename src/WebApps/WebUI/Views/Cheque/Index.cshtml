@{
    ViewData["title"] = "Cheque";
}

<div ng-controller="chequeCtrl">
    <div class="row page-titles">
        <div class="col-lg-5 align-self-center">
            <h5 class="text-themecolor">Gestión de Cheques</h5>
        </div>
        <div class="col-lg-7 align-self-center text-right">
            @* <div class="d-flex justify-content-end align-items-center">

            </div> *@
        </div>
    </div>

    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <md-toolbar class="md-table-toolbar md-default">
                    <div class="md-toolbar-tools">
                        <div class="col-lg-9 col-md-9 col-sm-1">                        
                            <button type="button"  class="btn btn-info" ng-click="openModalFiltro()"><i class=" fas fa-filter"></i> Filtrar</button>                          
                        </div>
                        <div class="col-lg-3 col-md-3 col-sm-12 col-12">
                            <form class="form-material">
                                <input type="text" class="form-control border-select" ng-model="txtFilter" ng-keyup="filterCheques()" placeholder="Buscar" />
                            </form>
                        </div>
                    </div>
                </md-toolbar>
                <md-divider></md-divider>
                @* <md-card-content> *@
                    <md-table-container style="max-height:400px;">
                        <table md-table>
                            <thead md-head fix-head>
                                <tr md-row>
                                    <th md-column ng-if="accion.crear || accion.anular"></th>                
                                    <th md-column>Nro. Comprobante</th>
                                    <th md-column>F. Emisión</th>
                                    <th md-column>Tipo</th>
                                    <th md-column>Persona</th>
                                    <th md-column>PosF.</th>                
                                    <th md-column>Nro</th>
                                    <th md-column>Banco</th>
                                    <th md-column>Valor</th>                
                                    <th md-column>Estado</th>                
                                </tr>     
                            </thead>
                            <tbody md-body>
                                <tr md-row ng-repeat="c in cheques" class="{{c.color}}">
                                    <td md-cell ng-if="accion.crear || accion.anular">
                                        <div class="dropdown h-2">
                                            <button class="btn btn-default " type="button" id="dropdownMenu" data-toggle="dropdown" data-boundary="viewport" aria-haspopup="true" aria-expanded="false">
                                                <i class="fa fa-bars"></i>
                                            </button>
                                            <div class="dropdown-menu"  aria-labelledby="dropdownMenu">
                                                <button class="dropdown-item" type="button" ng-if="accion.crear"  ng-click="askToSaveCheck(c)" tooltip data-toggle="tooltip" title="Guardar Cobro Cheque"><i class="ti-save"></i> Guardar</button>
                                                <button class="dropdown-item" type="button" ng-if="accion.anular" ng-click="askToAnnulCheck(c)" tooltip data-toggle="tooltip" title="Anular Cobro Cheque"><i class="mdi mdi-block-helper"></i> Anular</button>                            
                                                <button class="dropdown-item" type="button" ng-if="accion.reporte" ng-click="getReport(c)" tooltip data-toggle="tooltip" title="Reporte PDF"><i class="fa fa-file-pdf"></i> PDF</button>                            
                                            </div>
                                        </div>                       
                                    </td>                
                                    <td md-cell>{{c.nroComprobante}}</td>  
                                    <td md-cell> {{c.fechaEmision}}</td> 
                                    <td md-cell>
                                        <span>{{c.gestion==1?'Cobro':'Pago'}}</span>
                                    </td> 
                                    <td md-cell>{{c.persona}}</td>  
                                    <td md-cell>{{c.posfechado}}</td>                                                                                                                                                                                                     
                                    <td md-cell>{{c.nro}}</td>
                                    <td md-cell>{{c.banco}}</td>                                  
                                    <td md-cell>${{c.valor}}</td>
                                    <td md-cell>{{c.estado}}</td>
                                </tr>
                                <tr ng-show="cheques.length===0" class="text-center">
                                    <td colspan="9">
                                        No hay registros en esta tabla :)
                                    </td>
                                </tr>
                            </tbody>
                            <tfoot md-foot fix>
                                <tr md-row>
                                    <td md-cell colspan="2"><span class="font-weight-bold">{{cheques.length}} Registros</span></td>
                                    <td md-cell colspan="6"><span class="font-weight-bold">Total</span></td>
                                    <td md-cell><span class="font-weight-bold">{{total}}</span></td>
                                    <td md-cell colspan="1"></td>
                                </tr>                
                            </tfoot>
                        </table>
                    </md-table-container>
                @* </md-card-content> *@
            </div>            
        </div>
    </div>

    <partial name="_ModalFiltroCheque"/>

        

</div>

@section Scripts{        
    <script src="~/js/controllers/financiera/chequeCtrl.min.js" asp-append-version="true"></script>
}
