
<div class="modal-header">
    <h4 class="modal-title">Aperturar Caja</h4>
    <button type="button" class="close" ng-click="$ctrl.closeModal()" aria-hidden="true">&times;</button>
</div>

<div class="modal-body">
    <div class="form-group">
        <label for="username">Entidad Financiera <span class="text-danger">*</span>  </label>
        <select class="form-control border-select" ng-model="$ctrl.data.idEntidadFinanciera">
            <option ng-value="item.idEntidadFinanciera" ng-repeat="item in $ctrl.entidadesFinancieras">{{item.descripcion}}</option>
        </select>
    </div>

    <div class="form-group">
        <label for="concepto">Concepto <span class="text-danger">*</span></label>
        <input class="form-control border-select" touppercase type="text" ng-model="$ctrl.data.concepto">
    </div>
    <div class="form-group">
        <label for="concepto">Valor <span class="text-danger">*</span></label>
        <input class="form-control border-select" decimal type="text" ng-model="$ctrl.data.entrada">
    </div>
</div>
<div class="modal-footer">
    <button type="button" class="btn btn-success" ng-click="$ctrl.aperturaCaja()">
        <i class="ti-save"></i> Guardar
    </button>
    <button type="button" class="btn btn-dark" ng-click="$ctrl.closeModal()">&times; Cerrar</button>
</div>
     