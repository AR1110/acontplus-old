
<form ng-submit="$ctrl.saveAndUpdate()" autocomplete="off" novalidate>
    <div class="modal-content">
        <div class="modal-header">
            <h5 class="modal-title">{{$ctrl.tipoRegistro===1?'Nuevo':'Editar'}} Caja</h5>
            <button type="button" class="close" ng-click="$ctrl.closeModal()" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
        <div class="modal-body">
            <div class="row">
                <div class="form-group col-lg-12 col-md-12 col-sm-12 col-12">
                    <label for="telefono">Descripcion <span class="text-danger">*</span> </label>
                    <input type="text" ng-model="$ctrl.data.descripcion" touppercase class="form-control border-select" placeholder="Caja1">
                </div>
            </div>

            <div class="row" ng-if="$ctrl.tipoRegistro==2">
                <div class="col-6">
                    <div class="icheck-primary">
                        <input type="radio" ng-model="$ctrl.data.estado" ng-value="true" id="estadoActivoRadio" name="estadoCaja" />
                        <label for="estadoActivoRadio">Activo</label>
                    </div>
                </div>
                <div class="col-6 text-right">
                    <div class="icheck-primary">
                        <input type="radio" ng-model="$ctrl.data.estado" ng-value="false" id="estadoInactivoRadio" name="estadoCaja" />
                        <label for="estadoInactivoRadio">Inactivo</label>
                    </div>
                </div>
            </div>
        </div>
        <div class="modal-footer">
            <button type="submit" class="btn btn-success">
                {{$ctrl.tipoRegistro===1?'Guardar':'Actualizar'}}
            </button>
            <button type="button" class="btn btn-dark" ng-click="$ctrl.closeModal()">&times; Cancelar</button>
        </div>
    </div>
</form>