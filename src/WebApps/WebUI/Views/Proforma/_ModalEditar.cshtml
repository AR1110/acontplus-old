<form autocomplete="off">
    <div class="modal-header">
        <h5 class="modal-title">Editar Proforma</h5>
        <div class="float-center">
            <h5><span>Nro: <b>{{$ctrl.nroDocSecuencial}}</b> </span></h5>
        </div>
        <div class="float-right">
            <h4><span class="float-right"><strong>Total: ${{$ctrl.getImporteTotal()}} </strong></span></h4>
        </div>
    </div>
    <div class="modal-body">
        <div class="row">
            <div class="col-xl-4 col-lg-4 col-md-4 col-sm-12 col-12">
                <div class="form-group">
                    <label for="establecimiento">Estab.: <span class="text-danger">*</span></label>
                    <select name="establecimiento" id="establecimiento" class="form-control border-select"
                        ng-model="$ctrl.data.codEstab" disabled>
                        <option ng-value="item.codEstab" ng-repeat="item in $ctrl.establecimientos">
                            {{item.nombreComercial}}
                        </option>
                    </select>
                </div>
            </div>

            <div class="col-xl-4 col-lg-4 col-md-4 col-sm-12 col-12">
                <div class="form-group">
                    <label for="puntoEmision">Punto Emisión: <span class="text-danger">*</span></label>
                    <select name="puntoEmision" id="puntoEmision" class="form-control border-select" disabled
                        ng-model="$ctrl.data.idPuntoEmision">
                        <option ng-value="item.idPuntoEmision" ng-repeat="item in $ctrl.puntosEmisiones">{{item.ptoEmi}}
                        </option>
                    </select>
                </div>
            </div>

            <div class="col-xl-4 col-lg-4 col-md-4 col-sm-12 col-12">
                <div class="form-group">
                    <label for="fechaEmision">Fecha Emisión: <span class="text-danger">*</span> </label>
                    <input type="date" name="fechaEmision" id="fechaEmision" class="form-control border-select"
                        ng-model="$ctrl.data.fechaEmision"
                        ng-disabled="!$ctrl.ventaComprobantePermission.fechaEmision.update">
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-xl-4 col-lg-4 col-md-4 col-sm-12 col-12">
                <div class="form-group">
                    <label for="">Cliente: <span class="text-danger">*</span></label>
                    <div class="input-group">
                          <input type="text" id="clienteSearchInvoice" name="clienteSearchInvoice" class="form-control border-select"
                            ng-model="$ctrl.cliente.nombreFiscal" cliente-search-drtv on-select="$ctrl.onSelectedClienteChange(result)"
                            on-keyup-cliente="$ctrl.onKeyupCustomer()" placeholder="Ingrese C.I o Nombre Comercial"
                            onclick="select();">

                        <script type="text/ng-template" id="autocompleteClienteTemplate.html">
                            <div class="autocomplete-suggestion-uib-typeahead">
                                <span class="item-title"><b> {{match.model.numeroIdentificacion}}</b> - {{match.model.nombreFiscal}}</span>
                            </div>
                        </script>
                        <div class="input-group-append">
                            <button type="button" class="btn btn-outline-secondary btn-xs border-select"
                                id="btnNewCustomerDocument" btn-cliente
                                result-modal="$ctrl.onSelectedClienteChange(result)"> <i class="fa fa-plus fa-xs"></i>
                            </button>

                            <button type="button" class="btn btn-outline-secondary btn-xs"
                                ng-if="$ctrl.cliente.idCliente>0" btn-cliente
                                result-modal="$ctrl.onSelectedClienteChange(result)" params="$ctrl.cliente"
                                tabindex="-1"><i class="fa fa-edit fa-xs"></i>
                            </button>
                            <button type="button" class="btn btn-outline-secondary btn-xs" btn-cliente-lista
                                result-modal="$ctrl.onSelectedClienteChange(result)" tabindex="-1"><i
                                    class="fa fa-search fa-xs"></i>
                            </button>

                            <button type="button" cliente-info-popover customer="$ctrl.cliente" popover-placement='top'
                                class="btn btn-outline-secondary btn-xs" ng-if="$ctrl.cliente.idCliente>0"
                                tabindex="-1"><i class="fa fa-info fa-xs"></i>
                            </button>
                        </div>
                    </div>
                    <span class="ml-5" ng-if="cliente.loading"> <i class="fas fa-sync-alt fa-xs"></i> Loading...</span>
                    <small class="text-danger ml-5" ng-if="cliente.noResults">No se encontraron resultados</small>
                </div>
            </div>

            <div class="col-xl-2 col-lg-2 col-md-2 col-sm-12 col-12">
                <div class="form-group">
                    <label for="numeroIdentificacion">Nro. Identificaciòn</label>
                    <input type="text" disabled ng-value="$ctrl.cliente.numeroIdentificacion" class="form-control">
                </div>
            </div>

            <div class="col-xl-3 col-lg-3 col-md-6 col-sm-12 col-12">
                <div class="form-group">
                    <label for="correo">Correo</label>
                    <input type="text" ng-value="$ctrl.cliente.correo" disabled class="form-control">
                </div>
            </div>

            <div class="col-lg-3">
                <div class="form-group">
                    <label for="correo">Dirección</label>
                    <input type="text" ng-value="$ctrl.cliente.direccion" disabled class="form-control">
                </div>
            </div>
        </div>


        <div class="row">
            <div class="col-xl-6 col-lg-6 col-md-6 col-sm-12 col-12">
                <div class="row">
                    <div class="col-xl-6 col-lg-6 col-md-6 col-sm-12 col-12">
                        <label for="">Buscar por Artículo</label>
                        <md-autocomplete-articulo-component tipo-doc="$ctrl.TIPO_DOC_PR"
                            abrir-modal-articulo="$ctrl.abrirModalArticulo(item)"
                            get-data-articulo="$ctrl.getDataIdArticulo(item)"
                            set-item-articulo-en-detalle="$ctrl.setItemArticuloEnDetalle(item)"
                            scope-parent="scopeParent" id-bodega="$ctrl.idBodega">
                        </md-autocomplete-articulo-component>
                    </div>

                    <div class="col-xl-6 col-lg-6 col-md-6 col-sm-12 col-12">
                        <div class="form-group">
                            <label for="searchBarcode">Buscar por Código</label>
                            <articulo-search-barcode tipo-doc="$ctrl.TIPO_DOC_PR"
                                set-item-articulo-en-detalle="$ctrl.setItemArticuloEnDetalle(item)" id-bodega="$ctrl.idBodega"></articulo-search-barcode>
                        </div>
                    </div>

                </div>
            </div>
            <div class="col-xl-6 col-lg-6 col-md-6 col-sm-12 col-12">
                <div class="row justify-content-end">
                    <div class="col-xl-4 col-lg-4 col-md-6 col-sm-12 col-12">
                        <div class="form-group">
                            <label for="bodegas">Bodega</label>
                            <select name="bodegas" id="bodegas" class="form-control border-select"
                                ng-model="$ctrl.idBodega" ng-change="$ctrl.onChangeBodega()">
                                <option ng-value="item.idBodega" ng-repeat="item in $ctrl.bodegas">
                                    {{item.descripcion}}
                                </option>
                            </select>
                        </div>
                    </div>
                    <div class="col-xl-4 col-lg-4 col-md-6 col-sm-12 col-12">
                        <div class="form-group">
                            <label for="">Tarifa:
                                <span tooltip-placement="top"
                                    uib-tooltip="Asignación Rápida de listas de precios seleccionada a todos los productos del documento.">
                                    <i class="fas fa-info-circle fa-xs"></i>
                                </span>
                            </label>
                            <select id="tarifas" class="form-control border-select" ng-model="$ctrl.idTarifa"
                                ng-change="$ctrl.askToChangeTariga()"
                                ng-disabled="!$ctrl.ventaComprobantePermission.tarifa.update">
                                <option ng-value="item.idTarifa" ng-repeat="item in $ctrl.tarifas">
                                    {{item.descripcion}}
                                </option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
        </div>


        <div ui-grid="$ctrl.gridOptions" ui-grid-edit ui-grid-resize-columns ui-grid-cellNav ui-grid-auto-resize
            ui-grid-validate ui-grid-save-state class="grid">
        </div>

        <div class="row">
            <div class="col-xl-9 col-lg-9 col-md-6 col-sm-12 col-12">
                <div class="row mt-2" ng-if="$ctrl.showSubtotales">
                    <div class="col-xl-4 col-lg-4 col-md-6 col-sm-12 col-12">
                        <div class="table-responsive">
                            <table class="table table-clear table-sm">
                                <tbody>
                                    <tr>
                                        <td class="left">
                                            <strong class="text-dark">SubTotal Iva
                                                {{$ctrl.actividadTipoIva.tarifa}}%</strong>
                                        </td>
                                        <td class="right">${{$ctrl.data.subTotalIva}}</td>
                                    </tr>

                                    <tr>
                                        <td class="left">
                                            <strong class="text-dark">SubTotal IVA 0</strong>
                                        </td>
                                        <td class="right">${{$ctrl.data.subTotalIvaCero}}</td>
                                    </tr>

                                    <tr>
                                        <td class="left">
                                            <strong class="text-dark">SubTotal Exento IVA</strong>
                                        </td>
                                        <td class="right">${{$ctrl.data.subTotalExentoIva}}</td>
                                    </tr>

                                    <tr>
                                        <td class="left">
                                            <strong class="text-dark">SubTotal no Objeto IVA</strong>
                                        </td>
                                        <td class="right">${{$ctrl.data.subTotalNoObjetoIva}}</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="col-xl-4 col-lg-4 col-md-6 col-sm-12 col-12">
                        <div class="table-responsive">
                            <table class="table table-clear table-sm">
                                <tbody>
                                    <tr>
                                        <td class="left">
                                            <strong class="text-dark">SubTotal Neto IVA</strong>
                                        </td>
                                        <td class="right">${{$ctrl.data.subTotalNetoIva}}</td>
                                    </tr>

                                    <tr>
                                        <td class="left">
                                            <strong class="text-dark">SubTotal Neto IVA 0</strong>
                                        </td>
                                        <td class="right">${{$ctrl.data.subTotalNetoIvaCero}}</td>
                                    </tr>

                                    <tr>
                                        <td class="left">
                                            <strong class="text-dark">SubTotal Neto Exento IVA</strong>
                                        </td>
                                        <td class="right">${{$ctrl.data.subTotalNetoExentoIva}}</td>
                                    </tr>

                                    <tr>
                                        <td class="left">
                                            <strong class="text-dark">SubTotal Neto no Objeto IVA</strong>
                                        </td>
                                        <td class="right">${{$ctrl.data.subTotalNetoNoObjetoIva}}</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="col-xl-4 col-lg-4 col-md-6 col-sm-12 col-12">
                        <div class="table-responsive">
                            <table class="table table-clear table-sm">
                                <tbody>
                                    <tr>
                                        <td class="left">
                                            <strong class="text-dark">ICE</strong>
                                        </td>
                                        <td class="right">${{$ctrl.data.totalIce}}</td>
                                    </tr>

                                    <tr>
                                        <td class="left">
                                            <strong class="text-dark">IRBPNR</strong>
                                        </td>
                                        <td class="right">${{$ctrl.data.irbpnr}}</td>
                                    </tr>

                                    <tr>
                                        <td class="left">
                                            <strong class="text-dark">Propina</strong>
                                        </td>
                                        <td class="right">${{$ctrl.data.propina}}</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <md-divider></md-divider>
                <div class="row mt-2" ng-if="$ctrl.showSubtotales">
                    <div class="col-lg-2 col-md-6 col-sm-12 col-12">
                        <div class="form-group">
                            <label>% Descuento</label>
                            <div class="input-group">
                                <input ng-model="$ctrl.data.porcentajeDescuento"
                                    ng-disabled="!$ctrl.ventaComprobantePermission.porcentajeDescuento.update || $ctrl.gridOptions.data.length==0"
                                    decimal class="form-control" />
                                <div class="input-group-append">
                                    <button type="button" class="btn btn-secondary btn-sm"
                                        ng-click="$ctrl.calcularPorcentajeDescuento()">
                                        <i class="fa fa-calculator fa-xs"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-2 col-md-6 col-sm-12 col-12">
                        <div class="form-group">
                            <label>Descuento</label>
                            <div class="input-group">
                                <input ng-model="$ctrl.data.totalDescuento" id="totalDescuento"
                                    ng-disabled="!$ctrl.ventaComprobantePermission.descuento.update || $ctrl.gridOptions.data.length==0"
                                    decimal placeholder="0.00" class="form-control" />
                                <div class="input-group-append">
                                    <button type="button" class="btn btn-secondary btn-sm"
                                        ng-click="$ctrl.calcularDescuento()">
                                        <i class="fa fa-calculator fa-xs"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-2 col-md-6 col-sm-12 col-12">
                        <div class="form-group">
                            <label>Transporte</label>
                            <input type="text" decimal ng-model="$ctrl.data.transporte"
                                class="form-control border-select" placeholder="0.00" />
                        </div>
                    </div>

                    <div class="col-lg-2 col-md-6 col-sm-12 col-12">
                        <div class="form-group">
                            <label>Rercargo</label>
                            <input type="text" decimal ng-model="$ctrl.data.recargo" class="form-control border-select"
                                placeholder="0.00" />
                        </div>
                    </div>

                    <div class="col-lg-4">
                        <div class="form-group">
                            <label>Observacion</label>
                            <textarea class="form-control border-select" ng-model="$ctrl.data.observacion" touppercase
                                placeholder="..."></textarea>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-lg-3 col-md-6 col-sm-12 col-12">
                <div class="table-responsive mt-2">
                    <table class="table table-clear table-sm">
                        <tbody>
                            <tr>
                                <td class="left">
                                    <strong class="text-dark">SubTotal sin Impuesto</strong>
                                </td>
                                <td class="right">${{$ctrl.data.subTotalSinImpuestos}}</td>
                            </tr>

                            <tr>
                                <td class="left">
                                    @* <strong class="text-dark">IVA {{$ctrl.actividadTipoIva.tarifa}}%</strong> *@
                                    <select style="width: 150px;" name="impuestoTarifa" id="impuestoTarifa"
                                        ng-model="$ctrl.data.tarifa" class="form-control form-control-sm border-select"
                                        ng-change="$ctrl.recalculateImpuestoTarifa()">
                                        <option ng-value="item.tarifa" ng-repeat="item in $ctrl.impuestoTarifas">
                                            {{item.descripcion}}
                                        </option>
                                    </select>
                                </td>
                                <td class="right">${{$ctrl.data.iva}}</td>
                            </tr>

                            <tr>
                                <td class="left">
                                    <strong class="text-dark">Total Descuento</strong>
                                </td>
                                <td class="right">${{$ctrl.data.totalDescuento}}</td>
                            </tr>

                            <tr>
                                <td class="left">
                                    <h4> <strong class="text-dark">Total</strong></h4>
                                </td>
                                <td class="right">
                                    <h4><strong class="text-dark">${{$ctrl.getImporteTotal()}}</strong></h4>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                @* <div class="mt-2">
                <button type="button" class="btn btn-secondary btn-sm btn-lg btn-block"
                ng-click="$ctrl.openModalInfoAdicional(false)">
                <i class="fas fa-info-circle text-info"></i> Dato Adicional
                </button>
                </div> *@
            </div>
        </div>
    </div>
    <div class="modal-footer">
        <div class="icheck-success icheck-inline">
            <input type="checkbox" ng-model="$ctrl.showSubtotales" id="showSubTotales" />
            <label for="showSubTotales">Mas datos</label>
        </div>
        <button type="button" class="btn btn-info" ng-click="$ctrl.onSave()">
            <i class="ti-pencil"></i> Actualizar
        </button>
        <button type="button" class="btn btn-dark" ng-click="$ctrl.closeModal()">&times; Cerrar</button>
    </div>
</form>
