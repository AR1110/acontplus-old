
@{
    ViewData["Title"] = "Index";
}
<div ng-controller="bodegaCtrl">
    <div class="row page-titles">
        <div class="col-md-5 align-self-center">
            <h4 class="text-themecolor">Gestión de Bodegas</h4>
        </div>
        <div class="col-md-7 align-self-center text-right">
            <div class="d-flex justify-content-end align-items-center">               
                <button type="button" ng-if="accion.leer && accion.crear" ng-click="openModalNew()" class="btn btn-info  m-l-15">
                    <i class="fa fa-plus-circle"></i> Nuevo
                </button>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <div class="row">
                        <div class="col-lg-9">
                            <span class="form-group pull-left page-size form-inline">
                                <select class="form-control control-color"
                                        ng-model="dataSearch.pageSize"
                                        ng-change="changePageSize()"
                                        ng-options="ra for ra in recordsQuantity">
                                </select>
                            </span>
                        </div>
                        <div class="col-lg-3">
                            <form class="form-material">
                                <input type="text" class="form-control border-select" ng-model="dataSearch.textSearch" placeholder="Buscar Bodega" />
                            </form>
                        </div>
                    </div>
                    <div class="table-responsive ">
                        <table class="table table-condensed">
                            <thead>
                                <tr>                                    
                                    <th ng-if="accion.editar || accion.eliminar">Op.</th>
                                    <th>N°</th>
                                    <th>Sucursal</th>
                                    <th>Bodega</th>
                                    <th>Telefono</th>
                                    <th>Direccion</th>
                                    <th>Estado</th>                                    
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="item in bodegas|filter: dataSearch.textSearch">                                    
                                    <td ng-if="accion.editar || accion.eliminar">
                                        <div class="justify-content-center">
                                            <button class="btn btn-info btn-sm" ng-if="accion.editar" ng-click="openModalUpdate(item)"><i class="mdi mdi-pencil"></i>
                                            </button>
                                            <button class="btn btn-danger btn-sm" ng-if="item.estado && accion.eliminar" ng-click="askToDelete(item)"><i class="mdi mdi-delete"></i>
                                            </button>                                                                      
                                        </div>
                                    </td>                                 
                                    <td>{{$index+1}}</td>
                                    <td>{{item.nombreComercial}}</td>
                                    <td>{{item.descripcion}}</td>
                                    <td>{{item.telefono}}</td>
                                    <td>{{item.direccion}}</td>
                                    <td ng-bind-html="item.estado | estadoPrimario"></td>  
                                </tr>
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td align="center" colspan="7">
                                        <div class="pull-left">
                                            <ul uib-pagination total-items="totalRecords" items-Per-Page="dataSearch.pageSize" ng-change="pagechanged()" ng-model="dataSearch.pageIndex" max-size="maxSize" class="pagination" boundary-links="true" rotate="false"></ul>
                                        </div>
                                    </td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>   
</div>

@section Scripts{
    <script src="~/js/controllers/admin/bodegaCtrl.min.js" asp-append-version="true"></script>    
}


