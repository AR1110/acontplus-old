<input type="text" id="clienteSearchInput" 
    autocomplete="off"                            
    name="clienteSearchInput"
    class="form-control border-select"
    placeholder="Ingrese C.I o Nombre Fiscal"
    ng-model="cliente.nombreFiscal"            
    ng-keyup="onKeyupSearchCliente()"
    uib-typeahead="a as a.nombreFiscal for a in clienteSearch($viewValue)"
    typeahead-loading="cliente.loading"
    typeahead-no-results="cliente.noResults"
    typeahead-template-url="autocompleteClienteTemplate.html"
    typeahead-min-length="1"
    typeahead-editable="false"
    typeahead-on-select="selectedClienteChange($item)" />

    <script type="text/ng-template" id="autocompleteClienteTemplate.html">
        <div class="autocomplete-suggestion-uib-typeahead" style="border-bottom: 1px solid #ccc;">                            
            <span class="item-title" ng-if="$parent.$parent.$parent._sessionActividadEntidad!=='HB'">
                <i class="fa fa-user fa-xs"></i>
                <span> {{match.model.nombreFiscal}} </span>
            </span>

            <span class="item-title" ng-if="$parent.$parent.$parent._sessionActividadEntidad=='HB' && match.model.placa!=='N/A'">                                        
                <span> {{match.model.placa}} </span>
            </span>

            <p class="item-desc">{{match.model.numeroIdentificacion}}</p>
            <span class="item-metadata" ng-if="$parent.$parent.$parent._sessionActividadEntidad=='HB'">
                <span><strong>{{match.model.nombreFiscal}}</strong></span>                                        
            </span>                                              
        </div>
    </script>