@{
    ViewData["title"] = "Cliente";
}


<div ng-controller="clienteCtrl">
    <div class="row page-titles">
        <div class="col-lg-5 align-self-center">
            <h5 class="text-themecolor">Gestión de Clientes</h5>
        </div>
        <div class="col-lg-7 alig-self-center text-right">
            <div class="d-flex justify-content-end align-items-center">
                <button type="button" class="btn btn-info m-l-15" ng-if="accion.leer && accion.crear" btn-cliente
                    result-modal="resultModal(result)"><i class="fa fa-plus-circle"></i> Nuevo</button>
                @* <button type="button" class="btn btn-info m-l-15"
                ng-if="accion.leer && accion.crear"
                ng-click="nuevoCliente()"><i class="fa fa-plus-circle"></i> Nuevo</button> *@
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-body">
                    <div class="row">
                        <div class="col-lg-9 col-md-9 col-sm-9">
                            <div class="row justify-contend-start">
                                <div class="col-xl-3 col-lg-3 col-md-12 col-sm-12 col-12">
                                    <span class="form-group pull-left page-size form-inline">
                                        <select class="form-control control-color" ng-model="dataSearch.pageSize"
                                            ng-change="changePageSize()" ng-options="ra for ra in recordsQuantity">
                                        </select>
                                    </span>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-3 col-md-3 col-sm-3">
                            <form class="form-material" autocomplete="off">
                                <div class="input-group">
                                    <input type="text" class="form-control" id="searchCliente"
                                        ng-model="dataSearch.textSearch" ng-keyup="onKeyupSearchCliente()"
                                        placeholder="Buscar Cliente" />
                                    <div class="input-group-append">
                                        <button type="button" uib-tooltip="Recargar la tabla" tooltip-placement="top"
                                            class="btn btn-info btn-sm" ng-click="resetList()">
                                            <i class="fas fa-undo"></i>
                                        </button>
                                        <button type="button" class="btn btn-success btn-sm" ng-click="getReport()"
                                            uib-tooltip="Exportar clientes" tooltip-placement="top">
                                            <i class="ti-download"></i>
                                        </button>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                    <hr>
                    <md-table-container md-scroll-y layout-fill style=" max-height: 300px;">
                        <table md-table>
                            <thead md-head fix-head>
                                <tr md-row>
                                    <th md-column ng-if="accion.editar || accion.eliminar">Op.</th>
                                    <th md-column>N°</th>
                                    <th md-column>RUC</th>
                                    <th md-column>Nombre Fiscal</th>
                                    <th md-column>Dirección</th>
                                    <th md-column>Teléfono</th>
                                    <th md-column>Estado</th>
                                </tr>
                            </thead>
                            <tbody md-body>
                                <tr md-row ng-repeat="c in clientes">
                                    <td md-cell ng-if="accion.editar || accion.eliminar">
                                        <div layout="row" layout-align="start center">
                                            <button class="btn btn-info btn-xs"
                                                ng-if="accion.editar && !c.esConsumidorFinal" btn-cliente
                                                result-modal="resultModal(result)" params="c">
                                                <i class="ti-pencil"></i>
                                            </button>
                                            <button class="btn btn-danger btn-xs ml-2"
                                                ng-if="accion.eliminar && c.estado && !c.esConsumidorFinal"
                                                ng-click="askToDelete(c)">
                                                <i class="fas fa-user-times"></i>
                                            </button>
                                        </div>
                                    </td>
                                    <td md-cell>{{$index+1}}</td>
                                    <td md-cell>{{c.numeroIdentificacion}}</td>
                                    <td md-cell><a href="javascript:void(0)" class="text-primary"
                                            ng-click="abrirModal(c,3)">{{c.nombreFiscal}}</a></td>
                                    <td md-cell>{{c.direccion}}</td>
                                    <td md-cell>{{c.telefono}}</td>
                                    <td md-cell ng-bind-html="c.estado|estadoPrimario"></td>
                                </tr>
                                <tr ng-show="clientes.length==0" class="text-center">
                                    <td colspan="7">
                                        No hay registros en esta tabla :)
                                    </td>
                                </tr>
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td align="center" colspan="7">

                                    </td>
                                </tr>
                            </tfoot>
                        </table>
                    </md-table-container>
                </div>
                <div class="card-body">
                    <div class="pull-left m-t-5 m-l-10">
                        <ul uib-pagination total-items="dataSearch.totalRecords" items-Per-Page="dataSearch.pageSize"
                            ng-change="pagechanged()" ng-model="dataSearch.pageIndex" max-size="dataSearch.maxSize"
                            class="pagination" boundary-links="true" rotate="false"></ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script src="~/js/ventas/controllers/clienteCtrl.min.js" asp-append-version="true"></script>
}
