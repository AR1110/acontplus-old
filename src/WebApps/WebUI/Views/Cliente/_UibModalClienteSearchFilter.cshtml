<!--Se usa en el fitlro de FACTURA VENTA, NOTA DE ENTREGA -->
<input type="text" id="clienteSearchFiltro" autocomplete="off" name="clienteSearchFiltro"
    class="form-control border-select" placeholder="Ingrese C.I o Nombre Fiscal"
    ng-model="$ctrl.clienteFiltro.nombreFiscal" ng-keyup="$ctrl.onKeyupClienteSearchFiltro()"
    uib-typeahead="a as a.nombreFiscal for a in $ctrl.clienteSearchDynamic($viewValue)"
    typeahead-loading="$ctrl.clienteFiltro.loading" typeahead-no-results="$ctrl.clienteFiltro.noResults"
    typeahead-template-url="clienteSearchFiltro.html" typeahead-editable="true"
    typeahead-on-select="$ctrl.selectedClienteSearchFiltro($item)" onClick="select();" />

<script type="text/ng-template" id="clienteSearchFiltro.html">
        <div class="autocomplete-suggestion-uib-typeahead">
            <span class="item-title">
                <b> {{match.model.numeroIdentificacion}}</b> - {{match.model.nombreFiscal}}
            </span>
        </div>
    </script>

