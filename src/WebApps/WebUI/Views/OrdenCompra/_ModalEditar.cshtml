
<form autocomplete="off" ng-submit="$ctrl.onSave()">
    <div class="modal-header">                
        <div class="icheck-primary icheck-inline">
            <input type="checkbox" ng-model="$ctrl.showHeader" id="showHeader" class="form-control">
            <label for="showHeader">Datos del Proveedor</label>
        </div>
        <h4><strong>Total: </strong>${{$ctrl.getImporteTotal()}}</h4>                                                  
    </div>
    <div class="modal-body">
        <div class="row" ng-if="$ctrl.showHeader">
            <div class="col-xl-4 col-lg-4 col-md-6 col-sm-12 col-12">
                <div class="form-group">
                    <label for="categoria">Estab.: <span class="text-danger">*</span></label>                  
                    <select class="form-control border-select" ng-model="$ctrl.data.codEstab" disabled>
                        <option ng-value="item.codEstab" ng-repeat="item in $ctrl.establecimientos">
                            {{item.nombreComercial}}
                        </option>
                    </select> 
                </div> 
            </div>

            <div class="col-xl-4 col-lg-4 col-md-6 col-sm-12 col-12">
                <div class="form-group">
                    <label for="puntoEmision">Punto Emisión: <span class="text-danger">*</span></label>
                    <select name="puntoEmision" id="puntoEmision" class="form-control border-select" ng-model="$ctrl.data.idPuntoEmision" disabled>
                        <option ng-value="item.idPuntoEmision" ng-repeat="item in $ctrl.puntosEmision">{{item.ptoEmi}}</option>
                    </select>
                </div>
            </div>

            <div class="col-xl-4 col-lg-4 col-md-6 col-sm-12 col-12">
                <div class="form-group">
                    <label for="fechaEmision">Fecha Emisión: <span class="text-danger">*</span></label>
                    <input type="date" name="fechaEmision" id="fechaEmision" class="form-control border-select" ng-model="$ctrl.data.fechaEmision" />
                    <small class="text-info">{{$ctrl.fechaEmisionEscrita}}</small>
                </div>
            </div>
        </div>

        <div class="row" ng-show="$ctrl.showHeader">                        
            <div class="col-xl-4 col-lg-4 col-md-6 col-sm-6 col-12">
                <div class="form-group">
                    <label for="">Proveedor <span class="text-danger">*</span></label>                    
                    <input type="text" class="form-control" ng-value="$ctrl.proveedor.nombreFiscal" disabled>                               
                </div>
            </div>
            <div class="col-xl-2 col-lg-2 col-md-6 col-sm-6 col-12">
                <div class="form-group">
                    <label>Nro. Identificación: </label>
                    <input type="text" class="form-control" ng-model="$ctrl.proveedor.numeroIdentificacion" disabled>                    
                </div>
            </div>

            <div class="col-xl-3 col-lg-3 col-md-6 col-sm-6 col-12">
                <div class="form-group">
                    <label>Dirección: </label>
                    <input type="text" ng-model="$ctrl.proveedor.direccion" disabled class="form-control" />
                </div>
            </div>
            <div class="col-xl-3 col-lg-3 col-md-6 col-sm-6 col-12">
                <div class="form-group">
                    <label>Correo: </label>
                    <input type="text" ng-model="$ctrl.proveedor.correo" disabled class="form-control" />
                </div>
            </div>
        </div>

        <div class="row justify-content-between">
            <div class="col-lg-5 col-md-5 col-sm-12 col-12">
                <label for="">Buscar Articulo</label>  
                <md-autocomplete-articulo-component 
                    tipo-doc="$ctrl.TIPO_DOC"
                    abrir-modal-articulo="$ctrl.abrirModalArticulo(item)"
                    get-data-articulo="$ctrl.getDataIdArticulo(item)"
                    set-item-articulo-en-detalle="$ctrl.setItemArticuloEnDetalle(item)"
                    scope-parent="$scope" id-bodega="$ctrl.idBodega">
                </md-autocomplete-articulo-component> 
            </div>
            <div class="col-lg-2 col-md-2 col-sm-12 col-12">
                <div class="form-group">
                    <label for="bodegas">Bodega</label>
                    <select name="bodegas" id="bodegas" class="form-control border-select" ng-model="$ctrl.idBodega" ng-change="$ctrl.askToChangeBodega()">
                        <option ng-value="item.idBodega" ng-repeat="item in $ctrl.bodegas">{{item.descripcion}}</option>
                    </select>
                </div>                               
            </div>   
        </div>

        <div id="grid" ui-grid="$ctrl.gridOptions"
            ui-grid-edit
            ui-grid-resize-columns
            ui-grid-cellNav
            ui-grid-auto-resize
            class="grid">
        </div>

        <div class="row">
            <div class="col-xl-9 col-lg-9 col-md-6 col-sm-12 col-12">
                <div class="row mt-2" ng-if="$ctrl.showSubtotales">
                    <div class="col-xl-4 col-lg-4 col-md-6 col-sm-12 col-12">
                        <div class="table-responsive">
                            <table class="table table-clear table-sm">
                                <tbody>
                                    <tr>
                                        <td class="left">
                                            <strong class="text-dark">SubTotal Iva {{$ctrl.actividadTipoIva.tarifa}}%</strong>
                                        </td>
                                        <td class="right">${{$ctrl.data.subTotalIva}}</td>
                                    </tr>

                                    <tr>
                                        <td class="left">
                                            <strong class="text-dark">SubTotal IVA 0</strong>
                                        </td>
                                        <td class="right">${{$ctrl.data.subTotalIvaCero}}</td>
                                    </tr>

                                    <tr>
                                        <td class="left">
                                            <strong class="text-dark">SubTotal Exento IVA</strong>
                                        </td>
                                        <td class="right">${{$ctrl.data.subTotalExentoIva}}</td>
                                    </tr>

                                    <tr>
                                        <td class="left">
                                            <strong class="text-dark">SubTotal no Objeto IVA</strong>
                                        </td>
                                        <td class="right">${{$ctrl.data.subTotalNoObjetoIva}}</td>
                                    </tr>                                                       
                                </tbody>
                            </table>  
                        </div>             
                    </div>

                    <div class="col-xl-4 col-lg-4 col-md-6 col-sm-12 col-12">
                        <div class="table-responsive">
                            <table class="table table-clear table-sm">
                                <tbody>
                                    <tr>
                                        <td class="left">
                                            <strong class="text-dark">SubTotal Neto IVA</strong>
                                        </td>
                                        <td class="right">${{$ctrl.data.subTotalNetoIva}}</td>
                                    </tr>

                                    <tr>
                                        <td class="left">
                                            <strong class="text-dark">SubTotal Neto IVA 0</strong>
                                        </td>
                                        <td class="right">${{$ctrl.data.subTotalNetoIvaCero}}</td>
                                    </tr>

                                    <tr>
                                        <td class="left">
                                            <strong class="text-dark">SubTotal Neto Exento IVA</strong>
                                        </td>
                                        <td class="right">${{$ctrl.data.subTotalNetoExentoIva}}</td>
                                    </tr>

                                    <tr>
                                        <td class="left">
                                            <strong class="text-dark">SubTotal Neto no Objeto IVA</strong>
                                        </td>
                                        <td class="right">${{$ctrl.data.subTotalNetoNoObjetoIva}}</td>
                                    </tr>                                                       
                                </tbody>
                            </table>  
                        </div> 
                    </div>

                    <div class="col-xl-4 col-lg-4 col-md-6 col-sm-12 col-12">
                        <div class="table-responsive">
                            <table class="table table-clear table-sm">
                                <tbody>                                   
                                    <tr>
                                        <td class="left">
                                            <strong class="text-dark">IRBPNR</strong>
                                        </td>
                                        <td class="right">${{$ctrl.data.irbpnr}}</td>
                                    </tr>

                                    <tr>
                                        <td class="left">
                                            <strong class="text-dark">Propina</strong>
                                        </td>
                                        <td class="right">${{$ctrl.data.propina}}</td>
                                    </tr>     

                                    <tr>
                                        <td class="left">
                                            <strong class="text-dark">ICE</strong>
                                        </td>
                                        <td class="right">${{$ctrl.data.totalIce}}</td>
                                    </tr> 

                                </tbody>
                            </table>  
                        </div> 
                    </div>                      
                </div>
                <md-divider></md-divider>
                <div class="row mt-2" ng-if="$ctrl.showSubtotales">
                    <div class="col-lg-2 col-md-6 col-sm-12 col-12">
                        <div class="form-group">
                            <label>% Descuento</label>
                            <div class="input-group">
                                <input ng-model="$ctrl.data.porcentajeDescuento" ng-disabled="$ctrl.gridOptions.data.length==0" 
                                decimal class="form-control border-select" />
                                <div class="input-group-append">
                                    <button type="button" class="btn btn-secondary btn-sm" ng-click="$ctrl.calcularPorcentajeDescuento()">
                                        <i class="fa fa-calculator fa-xs"></i>
                                    </button>                                            
                                </div>
                            </div>                    
                        </div>
                    </div>

                    <div class="col-lg-2 col-md-6 col-sm-12 col-12">
                        <div class="form-group">
                            <label>Descuento</label>
                            <div class="input-group">
                                <input ng-model="$ctrl.data.totalDescuento" id="totalDescuento" ng-disabled="$ctrl.gridOptions.data.length==0" decimal placeholder="0.00" class="form-control border-select" />
                                <div class="input-group-append">
                                    <button type="button" class="btn btn-secondary btn-sm" ng-click="$ctrl.calcularDescuento()">
                                        <i class="fa fa-calculator fa-xs"></i>
                                    </button>
                                </div>
                            </div>                                    
                        </div>
                    </div>

                    <div class="col-lg-2 col-md-6 col-sm-12 col-12">
                        <div class="form-group">
                            <label>Transporte</label>
                            <input type="text" decimal ng-model="$ctrl.data.transporte" ng-blur="$ctrl.sumaTransporteRecargo()" class="form-control border-select" placeholder="0.00" />
                        </div>
                    </div>

                    <div class="col-lg-2 col-md-6 col-sm-12 col-12">
                        <div class="form-group">
                            <label>Rercargo</label>
                            <input type="text" decimal ng-model="$ctrl.data.recargo" ng-blur="$ctrl.sumaTransporteRecargo()" class="form-control border-select" placeholder="0.00" />
                        </div>
                    </div>

                    <div class="col-lg-4">
                        <div class="form-group">
                            <label>Observacion</label>
                            <textarea class="form-control border-select" ng-model="$ctrl.data.observacion" touppercase placeholder="..."></textarea>
                        </div>
                    </div>
                </div> 
            </div>

            <div class="col-xl-3 col-lg-3 col-md-6 col-sm-12 col-12">             
                <div class="table-responsive mt-2">
                    <table class="table table-clear table-sm">
                        <tbody>
                            <tr>
                                <td class="left">
                                <strong class="text-dark">SubTotal sin Impuesto</strong>
                                </td>
                                <td class="right">${{$ctrl.data.subTotalSinImpuestos}}</td>
                            </tr>

                            <tr>
                                <td class="left">
                                    <strong class="text-dark">IVA {{$ctrl.actividadTipoIva.tarifa}}%</strong>
                                </td>
                                <td class="right">${{$ctrl.data.iva}}</td>
                            </tr>

                            <tr>
                                <td class="left">
                                <strong class="text-dark">Total Descuento</strong>
                                </td>
                                <td class="right">${{$ctrl.data.totalDescuento}}</td>
                            </tr>  
                                                                       
                            
                            <tr>
                                <td class="left">
                                    <h4> <strong class="text-dark">Total</strong></h4>                                       
                                </td>
                                <td class="right">
                                    <h4><strong class="text-dark">${{$ctrl.getImporteTotal()}}</strong></h4>
                                </td>
                            </tr>
                        </tbody>
                    </table>  
                </div>                               
            </div>
        </div>      
    </div>             
    <div class="modal-footer">
        <div class="icheck-success icheck-inline">
            <input type="checkbox" ng-model="$ctrl.showSubtotales" id="showSubtotales" />
            <label for="showSubtotales">Mas datos</label>
        </div>
        <button type="submit" class="btn btn-success">
            <i class="ti-pencil"></i> Actualizar
        </button>
        <button type="button" class="btn btn-dark waves-effect" ng-click="$ctrl.closeModal()">&times; Cerrar</button>                
    </div>
</form>
       