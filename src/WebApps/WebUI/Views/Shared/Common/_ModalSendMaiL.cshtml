<div class="modal-header bg-info text-white">
    <h4 class="modal-title"><i class="mdi mdi-email"></i> Reenvío de Correo</h4>
    <button type="button" class="close" aria-label="Close" ng-click="closeModal()">
        <span aria-hidden="true">&times;</span>
    </button>
</div>
<div class="modal-body">
    <h6>El Comprobante Nro. <strong>{{data.serieComprobante}}</strong> será enviado a los siguientes destinatarios:
        <md-chips ng-model="correos" md-add-on-blur="true" ng-keyup="onKeyupEmail($event)"
            md-transform-chip="transformChip($chip)" md-removable="true" md-enable-chip-edit="true"
            placeholder="Ej: maxi@gmail.com" input-aria-label="Correos">
        </md-chips>
        <small class="text-danger">Si desea ingresar a un destinatario adicional digítele aquí.</small>

</div>
<div class="modal-footer">
    <button class="btn btn-success" type="button" ng-click="saveResendEmail()">
        <i class="mdi mdi-send"></i> Sí, reenviar
    </button>
    <button class="btn btn-dark" type="button" ng-click="closeModal()">
        &times; No, cancelar
    </button>
</div>