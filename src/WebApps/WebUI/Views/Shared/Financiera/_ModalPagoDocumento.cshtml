<form autocomplete="off">
    <div class="modal-header">
        <h5 class="modal-title">Pago Documento</h5>
        <button class="close" ng-click="$ctrl.closeModal()">&times;</button>
    </div>

    <div class="modal-body">
        <div class="list-group list-group-horizontal">
            <a href="javscript:void(0)" id="newPaymentForm-head-1" ng-click="paymentStepUno()" class="list-group-item list-group-item-action disabled">
                <div>Paso 1</div>
                <span>Seleccionar Documentos</span>
            </a>
            <a href="javascript:void(0)" id="newPaymentForm-head-2" ng-click="paymentStepDos()" class="list-group-item list-group-item-action">
                <div>Paso 2</div>
                <span>Cuotas</span>
            </a>
        </div>   

        <!--Datos del proveedor-->
        <div class="card mt-2">
            <div class="card-body shadow">
                <div class="row justify-content-between">
                    <div class="col-lg-3 col-md-3 col-sm-6 col-12">
                        <small class="text-muted">Proveedor: </small>
                        <h6>{{$ctrl.proveedor.nombreFiscal}}</h6>
                    </div>
                    <div class="col-lg-3 col-md-3 col-sm-6 col-12">
                        <small class="text-muted">RUC: </small>
                        <h6>{{$ctrl.proveedor.numeroIdentificacion}}</h6>
                    </div>
                    <div class="col-lg-3 col-md-3 col-sm-6 col-12">
                        <small class="text-muted">Dirección: </small>
                        <h6>{{$ctrl.proveedor.direccion}}</h6>
                    </div>
                    @* <div class="col-lg-3 col-md-2 col-sm-6 col-12">
                        <small class="text-muted">Correo: </small>
                        <h6 ng-repeat="item in $ctrl.proveedor.correos">{{item.text}}</h6>
                    </div> *@
                </div>
            </div>
        </div> 

        <div class="row">
            <div class="col-lg-12">
                <div class="card">
                    <div class="card-body shadow">
                        <div class="d-flex">
                            @* <div>
                                <h5 class="card-title">Cuotas a Pagar</h5>                                
                            </div> *@
                            <div class="ml-auto">                               
                                 <md-button class="md-raised md-primary" ng-click="$ctrl.nuevoFormaPago()">
                                    <icon class="mdi mdi-plus"></icon> Nuevo Pago
                                 </md-button>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-xl-9 col-lg-9 col-md-9 col-sm-12 col-12">
                                <div class="card">                                                                         
                                    <div class="table-responsive">
                                        <table class="table no-wrap table-sm">
                                            <thead>
                                                <tr>
                                                    <th colspan="6"><span class="text-muted">Cuotas a Pagar</span></th>
                                                </tr>
                                                <tr>
                                                    <th></th>
                                                    <th>N°</th>
                                                    <th>T. Doc</th>
                                                    <th>N°. Doc</th>
                                                    <th>F. Emision</th>
                                                    <th>Total</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <tr ng-repeat-start="sd in $ctrl.selectedDocs" ng-click="$ctrl.displayCuota(sd)" style="cursor: pointer;">
                                                    <td>
                                                        <span ng-if="sd.display"><i class="fas fa-caret-square-down"></i></span>
                                                        <span ng-if="!sd.display"><i class="fas fa-caret-square-right"></i></span>
                                                    </td>
                                                    <td>{{$index+1}}</td>
                                                    <td>{{sd.nroDocumento}}</td>
                                                    <td>{{sd.tipoDocumento}}</td>
                                                    <td>{{sd.fechaEmision}}</td>
                                                    <td>${{sd.total}}</td>
                                                </tr>
                                                <tr ng-show="sd.display" ng-repeat-end="">
                                                    <td colspan="6">
                                                        <div class="justify-content-center mr-3 ml-3">
                                                            <div class="table-responsive" width="100%">
                                                                <table class="tabla-cuota table table-no-bordered text-center">
                                                                    <thead>
                                                                        <tr>
                                                                            <th>N°.</th>
                                                                            <th>Cuota</th>
                                                                            <th>Abono</th>
                                                                            <th>Abono Pos</th>
                                                                            <th>Saldo</th>                                                                        
                                                                            <th>F. Vcto</th>
                                                                            <th>Estado</th>                                                                            
                                                                        </tr>
                                                                    </thead>
                                                                    <tbody>
                                                                        <tr ng-repeat="c in sd.cuotas">
                                                                            <td>{{c.nroCuota}}</td>
                                                                            <td class="txt-oflo">${{c.cxp.cuota}}</td>
                                                                            <td class="text-muted">${{c.abono }}</td>
                                                                            <td>${{c.abonoPosfechado}}</td>
                                                                            <td>${{c.saldo  }}</td>                                                                           
                                                                            <td>{{c.cxp.fechaVencimiento}}</td>
                                                                            <td width="130px"><code>{{c.estadoFinanciero}}</code></td>                                                                       
                                                                        </tr>
                                                                    </tbody>
                                                                </table>
                                                            </div>
                                                        </div>
                                                    </td>
                                                </tr>                                                                                              
                                            </tbody>
                                        </table>
                                    </div>                                    
                                </div>

                                <div class="card">
                                    <div class="table-responsive">
                                        <table class="table table-hover no-wrap table-sm">
                                            <thead>
                                                <tr>
                                                    <th colspan="8"><span class="text-muted">Datos de Pago</span></th>
                                                </tr>
                                                <tr>
                                                    <th>N°</th>
                                                    <th>Fecha Emisión</th>
                                                    <th>Sub Entidad</th>
                                                    <th>Valor</th>
                                                    <th>Tipo Documento</th>
                                                    <th>Número</th>
                                                    <th>Abono</th>
                                                    <th>Op</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <tr ng-repeat="item in $ctrl.abonoEntidadesFinancieras">
                                                    <td>{{$index+1}}</td>
                                                    <td>{{item.fechaEmision|date:'MM/dd/yyyy  h:mma'}}</td>
                                                    <td><sup>{{item.posFechado?'*':''}}</sup> <span>{{item.subEntidad}}</span></td>
                                                    <td>{{item.valor}}</td>
                                                    <td>{{item.tipoDocumento}}</td>
                                                    <td>{{item.nro}}</td>
                                                    <td>${{item.abono}}</td>
                                                    <td>
                                                        <button class="btn btn-danger btn-sm" ng-click="$ctrl.eliminarAbonoEntidad(item)">
                                                            <i class="ti-trash"></i>
                                                        </button>
                                                    </td>
                                                </tr>
                                                <tr ng-show="$ctrl.abonoEntidadesFinancieras.length==0" class="text-center">
                                                    <td colspan="8">No hay datos</td>
                                                </tr>                                                                                            
                                            </tbody>
                                        </table>
                                    </div>                                    
                                </div>                                
                            </div>   
                            <div class="col-xl-3 col-lg-3 col-md-3 col-sm-12 col-12">
                                <div class="card-body border">
                                    <div class="row pb-1">
                                        <div class="col-md-12">
                                            <div class="row">
                                                <div class="col-7 py-2">
                                                    <span>Total</span>
                                                </div>
                                                <div class="col-5 py-2">
                                                    @* <span class="font-medium"></span> *@
                                                    <h4 class="text-success">${{$ctrl.data.total}}</h4>
                                                </div>
                                            </div>

                                            <div class="row bg-primary text-white" ng-if="$ctrl.data.totalAbonoAnterior>0">
                                                <div class="col-7 py-2">
                                                    <span>Abono Anterior</span>
                                                </div>
                                                <div class="col-5 py-2">
                                                    :<span class="font-medium">${{$ctrl.data.totalAbonoAnterior}}</span>
                                                </div>
                                            </div>

                                            <div class="row">
                                                <div class="col-7 py-2">
                                                    <span>Abono</span>
                                                </div>
                                                <div class="col-5 py-2">
                                                    :<span class="font-medium">
                                                        ${{$ctrl.data.abono}}
                                                    </span>
                                                </div>
                                            </div>
                                            <div class="row">
                                                <div class="col-7 py-2">
                                                    <span>Abono Posf.</span>
                                                </div>
                                                <div class="col-5 py-2">
                                                    :<span class="font-medium">
                                                        ${{$ctrl.data.abonoPosfechado}}
                                                    </span>
                                                </div>
                                            </div>

                                            <div class="row">
                                                <div class="col-7 py-2">
                                                    <span>Total Abono</span>
                                                </div>
                                                <div class="col-5 py-2">
                                                    :<span class="font-medium">
                                                        ${{$ctrl.data.abonoTotal}}
                                                    </span>
                                                </div>
                                            </div>

                                            <div class="row">
                                                <div class="col-7 py-2">
                                                    <span>Saldo</span>
                                                </div>
                                                <div class="col-5 py-2">
                                                    :<span class="font-medium">
                                                        ${{$ctrl.data.saldo}}
                                                    </span>
                                                </div>
                                            </div>
                                            
                                            <div class="row bg-dark text-white">
                                                <div class="col-7 py-2">
                                                    <span>Cambio</span>
                                                </div>
                                                <div class="col-5 py-2">
                                                    :<span class="font-medium">
                                                        ${{$ctrl.data.valorCambio}}
                                                    </span>
                                                </div>
                                            </div>
                                        </div>                                        
                                    </div>                                   
                                </div>
                            </div>                         
                        </div>

                    </div>                                       
                </div>
            </div>
        </div>                      
    </div>

    

    <div class="modal-footer">
        <button type="button" class="btn waves-effect waves-light btn-info" ng-click="$ctrl.askToSave()">
            <i class="ti-save"></i> Guardar
        </button>
        <button type="button" class="btn waves-effect waves-light btn-dark" ng-click="$ctrl.closeModal()">
            <i class="ti-close"></i> Cerrar
        </button>        
    </div>

</form>
