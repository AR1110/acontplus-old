@{
    ViewBag.Title = "404";
}
<!-- ============================================================== -->
<section id="wrapper" class="error-page m-t-40">
    <div class="error-box">
        <div class="error-body text-center">
            <h1>404</h1>
            <h3 class="text-uppercase">Página No Encontrada !</h3>
            <p class="text-muted m-t-30 m-b-30">@ViewBag.ErrorMessage</p>
            <a href="/Home/Index" class="btn btn-info btn-rounded waves-effect waves-light m-b-40"><i class="fa fa-arrow-alt-circle-left"></i> Click aquí, para navegar a la página de inicio </a>
        </div>
    </div>
</section>