@{
    ViewData["title"] = "Importación";
}

<style>
    .item-import-register{
        background-color: rgb(116, 255, 158);        
    }
    .item-import-error{
        background-color: rgb(255, 167, 116); 
    }
    
    .item-import-register .item-import-error{
        cursor: pointer;
    }

</style>

<div ng-controller="almacenImportacionCtrl as $ctrl">
    <div class="row page-titles">
        <div class="col-md-5 align-self-center">
            <h5 class="text-themecolor">Importación</h5>
        </div>
    </div>
    
    <div class="row">
        <div class="col-lg-12"> 
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title">{{$ctrl.dataModulo.descripcion}}</h5>
                </div>
                <div class="card-body">
                    <md-toolbar class="md-table-toolbar md-default" ng-hide="options.rowSelection && selected.length">
                        <div class="md-toolbar-tools">                            
                            <button type="button" class="btn btn-info" ng-click="$ctrl.openModalImport()">
                                <i class="mdi mdi-arrow-up"></i> Nueva Importación
                            </button>
                            <button type="button" ng-if="$ctrl.items.length>0" class="btn btn-success m-l-15" ng-click="$ctrl.validarCampo()">
                                <i class="ti-save"></i> Guardar
                            </button>
                            <div flex></div>
                            <form class="form-material">
                                <input type="search" ng-model="txtFilter" class="form-control border-select" placeholder="Buscar Item">
                            </form>
                        </div>
                    </md-toolbar>
                

                    <div id="upperScroll" style="overflow-x:scroll; overflow-y: hidden; max-height:20px; width:100%">
                        <div name="innerScroll" ng-style="duelScroll" style="height:20px;"></div>
                    </div>
                    
                    <div ng-style="getStyle($index)" ng-show="$ctrl.items.length>0">
                        <md-table-container name="wireTable" infinite-scroll="loadMore($index)" infinite-scroll-distance="1" infinite-scroll-parent="true" ng-init="isShow=true" ng-show="isShow" style=" max-height: 400px; overflow-x: hidden">
                            <table md-row-select="true"  multiple="true"  ng-model="$ctrl.selected" resize master md-table name="innerWireTable">
                                <thead  md-trim-column-names fix-head md-head>
                                    <tr md-row>
                                        <th md-column>N°</th>
                                        <th ng-repeat="column in $ctrl.nameColums" ng-hide="$ctrl.hiddenColumn(column)" md-column>{{column}}</th>                                          
                                    </tr>
                                </thead>
                                <tbody md-body>
                                    <tr md-row md-select="item" ng-disabled="!(item.estado==='IMPORTAR')" 
                                        md-on-select="$ctrl.seleccionarCliente" 
                                        md-auto-select="true" ng-repeat="item in $ctrl.itemsImportacion | filter: txtFilter" ng-class="$ctrl.classColumnTable(item)">
                                        @* ng-class="{'md-placeholder': !item[column]}" *@
                                        <td md-cell>{{$index+1}}</td>
                                        <td md-cell ng-repeat="column in $ctrl.nameColums" ng-hide="$ctrl.hiddenColumn(column)">                                            
                                            {{item[column]}}
                                            
                                        </td> 

                                         @* <td md-cell ng-repeat="column in $ctrl.nameColums" ng-click="$ctrl.editColumn($event, item, column)">                                            
                                            {{item[column]}}
                                            
                                        </td>  *@
                                    </tr>
                                </tbody>
                            </table>
                        </md-table-container>
                    </div>
                </div>
                <div class="card-footer">
                    <span ng-show="$ctrl.items.length>0">{{$ctrl.items.length}} {{$ctrl.items.length > 1 ? 'items' : 'item'}} Importados</span>                            
                </div>
            </div>                                  
        </div>
    </div>
    
    
</div>

@section Scripts{
    <script src="~/lib/xlsx/xlsx.full.min.js" asp-append-version="true"></script>
    <script src="~/js/controllers/importacion/importacionCtrl.js" asp-append-version="true"></script>
}