
@{
    ViewData["Title"] = "Index";
}

<div ng-controller="modeloCtrl">
    <div class="row page-titles">
        <div class="col-md-5 align-self-center">
            <h4 class="text-themecolor">Gestión de Modelos</h4>
        </div>
        <div class="col-md-7 align-self-center text-right">
            <div class="d-flex justify-content-end align-items-center">
                @*<ol class="breadcrumb">
                        <li class="breadcrumb-item"><a href="javascript:void(0)">Inicio</a></li>
                        <li class="breadcrumb-item active">Modelos</li>
                    </ol>*@
                <button type="button" ng-if="accion.crear" btn-add-update-modelo results="resultModal(item)" class="btn btn-info   m-l-15">
                    <i class="ti-plus"></i> Nuevo 
                </button>
            </div>
        </div>
    </div>

    <md-card>
        <md-card-content>
            <div class="row">
                <div class="col-xl-6 col-lg-6 col-md-12 col-sm-12 col-12">
                    <div class="d-flex justify-content-start">
                        <span class="form-group pull-left page-size form-inline">
                            <select class="form-control control-color"
                                    ng-model="dataSearch.pageSize"
                                    ng-change="changePageSize()"
                                    ng-options="ra for ra in recordsQuantity">
                            </select>
                        </span>                                
                        
                        <span class="form-group pull-left page-size form-inline">
                            <button type="button" class="btn btn-success m-l-5" ng-click="exportTableToExcel()">
                                <i class="far fa-file-excel"></i> Exportar
                            </button> 
                        </span>
                        
                    </div>
                </div>
                <div class="col-xl-6 col-lg-6 col-md-12 col-sm-12 col-12">
                    <div class="d-flex justify-content-end">
                        <form class="form-material">
                            <input type="text" class="form-control" ng-model="buscar" placeholder="Buscar Modelo" />
                        </form> 
                    </div>
                </div>                        
            </div>

           
            <div class="table-responsive">
                <table class="table table-no-bordered">
                    <thead>
                        <tr>
                            <th ng-if="accion.editar || accion.eliminar">Op.</th>
                            <th>N°</th>
                            <th>Marca</th>
                            <th>Modelo</th>
                            <th>codigo</th>
                            <th>Estado</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="m in modelos | filter:buscar">
                            <td ng-if="accion.editar || accion.eliminar">
                                <button class="btn btn-info btn-sm" ng-if="accion.editar" btn-add-update-modelo results="resultModal(item)" params="m"><i class="ti-pencil"></i></button>
                                <button class="btn btn-danger btn-sm" ng-if="accion.eliminar" ng-click="delete(m)"><i class="ti-trash"></i></button>

                            </td>
                            <td>{{$index+1}}</td>
                            <td>{{m.marca}}</td>
                            <td>{{m.descripcion}}</td>
                            <td>{{m.codigo}}</td>
                            <td ng-bind-html="m.estado|estadoPrimario"></td>
                        </tr>
                        <tr ng-show="modelos.length==0" class="text-center">
                            <td colspan="5">
                                No hay registros en esta tabla :)
                            </td>
                        </tr>
                    </tbody>
                    <tfoot>
                        <tr>
                            <td align="center" colspan="5">
                                <div class="pull-left">
                                    <ul uib-pagination total-items="totalRecords" items-Per-Page="dataSearch.pageSize" ng-change="pagechanged()" ng-model="dataSearch.pageIndex" max-size="maxSize" class="pagination" boundary-links="true" rotate="false"></ul>
                                </div>
                            </td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </md-card-content>
    </md-card>
       
</div>
@section Scripts{    
    <script src="~/lib/xlsx/xlsx.full.min.js" asp-append-version="true"></script>
    <script src="~/js/inventario/controllers/modeloCtrl.min.js" asp-append-version="true"></script>
}
