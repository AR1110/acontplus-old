{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ApiGateways": {
    "Acontplus": "https://localhost:7060",
    "Proxy": "https://localhost:7060"
  },
  "AngularClient": {
