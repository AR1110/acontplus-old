    "ProductionUrl": "/client"
  },
  "SocialNetworks": {
    "BusinessUrl": "https://acontplus.com.ec",
    "DemoUrl": "https://demo.acontplus.com",
    "Facebook": "https://www.facebook.com/acontplus.ec",
    "Instagram": "https://www.instagram.com/acontplus.ec/",
    "GooglePlay": "https://play.google.com/store/apps/details?id=com.acontplus_facturacion&hl=es_EC",
    "Whatsapp": "https://api.whatsapp.com/send?phone=593986669930",
    "Youtube": "https://www.youtube.com/@acontplusweb/playlists"
  },
  "AdvancedLogging": {
    "EnableLocalFile": true,
    "Shared": false,
    "Buffered": true,
    "LocalFilePath": "C:\\Acontplus\\Logs\\WebApps\\WebUI\\log-.txt",
    "TimeZoneId": "America/Guayaquil"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "Enrich": [
      "WithMachineName",
      "WithEnvironmentUserName",
      "FromLogContext"
    ],
    "Properties": {
      "Application": "Web_UI"
    }
  }
