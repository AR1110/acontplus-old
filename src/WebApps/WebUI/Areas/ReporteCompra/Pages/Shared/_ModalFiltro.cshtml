
<div class="modal-header">
    <h4 class="modal-title">Reporte Compra</h4>
    <button class="close" ng-click="closeModal()">&times;</button>
</div>
<div class="modal-body">
    
    <div class="row">
        <div class="col-lg-4 col-md-4 col-sm-6 col-12">
            <div class="form-group">
                <label for="tipoDocumento">Tipo Documento</label>
                <select class="form-control" ng-model="dataSearch.tipoDoc" ng-change="onChangeTipoReporte()">
                    <option ng-value="item.codigo" ng-repeat="item in tipoDocumentos">{{item.descripcion}}</option>
                </select>
            </div>
        </div>
        <div class="col-lg-4 col-md-4 col-sm-6 col-12">
            
        </div>
        <div class="col-lg-4 col-md-4 col-sm-6 col-12" ng-if="dataSearch.tipoDoc==='LC' || dataSearch.tipoDoc=='RC' || dataSearch.tipoDoc==='IB' || dataSearch.tipoDoc==='OC'">
            
        </div>
    </div>

    <div class="row">
        <div class="col-lg-3 col-md-3 col-sm-6 col-12">
            <div class="icheck-info">
                <input type="checkbox" ng-change="onChangeSucursalFiltro()" ng-model="dataSearch.checkboxSucursalFiltro" name="checkboxSucursalFiltro" id="checkboxSucursalFiltro">
                <label for="checkboxSucursalFiltro">Estab.:</label>
            </div>
        </div>
        <div class="col-lg-3 col-md-3 col-sm-6 col-12">
            <div class="icheck-info">
                <input type="checkbox" ng-model="dataSearch.checkboxPuntoEmisionFiltro"
                ng-disabled="!dataSearch.checkboxSucursalFiltro || dataSearch.tipoDoc==='FC' || dataSearch.tipoDoc=='NCP'"
                    name="checkboxPuntoEmisionFiltro" id="checkboxPuntoEmisionFiltro">
                <label for="checkboxPuntoEmisionFiltro">Punto Emisión</label>
            </div>
        </div>
        <div class="col-lg-3 col-md-3 col-sm-6 col-12">
            <div class="icheck-info">
                <input type="checkbox" ng-model="dataSearch.checkboxProveedorFiltro" name="checkboxProveedorFiltro" id="checkboxProveedorFiltro">
                <label for="checkboxProveedorFiltro">Proveedor</label>
            </div>
        </div>
        <div class="col-lg-3 col-md-3 col-sm-6 col-12">
            <div class="icheck-info">
                <input type="checkbox" ng-model="dataSearch.checkboxUsuarioFiltro" name="checkboxUsuarioFiltro" id="checkboxUsuarioFiltro">
                <label for="checkboxUsuarioFiltro">Usuario</label>
            </div>
        </div>
    </div>

    
    
    <div class="row">                   
        <div class="col-lg-3 col-md-3 col-sm-6 col-12" ng-if="dataSearch.tipoDoc==='FC'">
            <div class="icheck-info">
                <input type="checkbox" ng-model="dataSearch.checkboxCategoriaFiltro" name="checkboxCategoriaFiltro" id="checkboxCategoriaFiltro">
                <label for="checkboxCategoriaFiltro">Categoria</label>
            </div>
        </div>                                  
        <div class="col-lg-3 col-md-3 col-sm-6 col-12">
            <div class="icheck-info">
                <input type="checkbox" ng-model="dataSearch.checkboxEstadoFiltro" name="checkboxEstadoFiltro" id="checkboxEstadoFiltro">
                <label for="checkboxEstadoFiltro">Estado</label>
            </div>
        </div>  

        <div class="col-lg-3 col-md-3 col-sm-3 col-12" ng-if="dataSearch.tipoDoc==='FC'">
            <div class="icheck-info">
                <input type="checkbox" ng-model="dataSearch.checkboxRetencionFiltro" name="checkboxRetencionFiltro" id="checkboxRetencionFiltro">
                <label for="checkboxRetencionFiltro">Retención</label>
            </div>
        </div>
        <div class="col-lg-3 col-md-3 col-sm-3 col-12" ng-if="dataSearch.tipoDoc==='FC'">
            <div class="icheck-info">
                <input type="checkbox" ng-model="dataSearch.checkboxDevolucionFiltro" name="checkboxDevolucionFiltro" id="checkboxDevolucionFiltro">
                <label for="checkboxDevolucionFiltro">Devolución</label>
            </div>
        </div>  
    </div>

    <div class="row">                    
        <div class="col-lg-3 col-md-3 col-sm-3 col-12">
            <div class="icheck-info">
                <input type="radio" ng-model="dataSearch.radioFechaFiltro" ng-value="true" name="radioFechaFiltro" id="radioFechaFiltro">
                <label for="radioFechaFiltro">Fecha</label>
            </div>
            <div class="icheck-info" ng-hide="dataSearch.tipoDoc==='RC' || dataSearch.tipoDoc==='NCP' || dataSearch.tipoDoc==='O'">
                <input type="radio" ng-model="dataSearch.radioFechaFiltro" name="radioFechaFiltro" ng-value="false" id="radioFechaVctoFiltro">
                <label for="radioFechaVctoFiltro">Fecha Vencimiento</label>
            </div>
        </div>
    </div>  
    <hr>

    <div class="row">
        <div class="col-lg-6 col-md-6 col-sm-6 col-12" ng-if="dataSearch.checkboxSucursalFiltro ">
            <div class="form-group">
                <label for="sucursal">Estab.:</label>
                <select class="form-control" ng-model="dataSearch.codEstab" ng-change="getAsignacionByRol()">
                    <option ng-value="item.codEstab" ng-repeat="item in sucursales">{{item.nombreComercial}}</option>
                </select>
            </div>
        </div>
        <div class="col-lg-6 col-md-6 col-sm-6 col-12" ng-if="dataSearch.checkboxSucursalFiltro && dataSearch.checkboxPuntoEmisionFiltro" >
            <div class="form-group" ng-if="dataSearch.tipoDoc==='LC' || dataSearch.tipoDoc=='RC' || dataSearch.tipoDoc==='IB' || dataSearch.tipoDoc==='OC'">
                <label for="sucursal">Punto Emisión</label>
                <select class="form-control" ng-model="dataSearch.byPuntoEmision">
                    <option ng-value="item.idPuntoEmision" ng-repeat="item in puntosEmisiones">{{item.ptoEmi}}</option>
                </select>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-6 col-md-6 col-sm-12 col-12" ng-show="dataSearch.checkboxProveedorFiltro">
            <div class="form-group">
                <label for="labelProvPersonalizado">Proveedor</label>
                <input  type="text" 
                    id="provAutocompletePersonalizado"         
                    autocomplete="off"
                    name="provAutocompletePersonalizado"
                    class="form-control border-select"
                    placeholder="Ingrese C.I o Nombre Fiscal"
                    typeahead-wait-ms="10"
                    typeahead-show-hint="true"
                    ng-model="selectedProvPersonalizado"
                    ng-keyup="onKeyupSearchProvPersonalizado()"
                    uib-typeahead="a as a.nombreFiscal for a in searchProveedorFilter($viewValue)"
                    typeahead-loading="data.loadingSearchProvPersonalizado"
                    typeahead-no-results="data.noResultsProvPersonalizado"
                    typeahead-template-url="autocompleteProvPersonalizado.html"
                    typeahead-editable="false"
                    typeahead-on-select="selectedProvPersonalizadoChange($item)" /> 

                    <script type="text/ng-template" id="autocompleteProvPersonalizado.html">
                        <div class="autocomplete-suggestion-uib-typeahead">               
                            <span class="item-title">
                                <b> {{match.model.numeroIdentificacion}}</b> - {{match.model.nombreFiscal}}
                            </span>
                        </div>
                    </script> 
            </div>
        </div>

        <div class="col-lg-6 col-md-6 col-sm-12 col-12" ng-show="dataSearch.checkboxUsuarioFiltro">
            <div class="form-group">
                <label>Usuario:</label>
                @await Html.PartialAsync("~/Views/Usuario/_UsuarioSearchFilter.cshtml")
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-xl-4 col-lg-4 col-md-6 col-sm-12 col-12">
            <div class="form-group">
                <label class="control-label">Mes: </label>                
                <select ng-model="mes" class="form-control" ng-change="getFechaInicioFinFilter()">
                    <option ng-value="m.numero" ng-repeat="m in meses">{{m.nombre}}</option>
                </select>
            </div>
        </div>
        <div class="col-xl-4 col-lg-4 col-md-6 col-sm-12 col-12">
            <div class="form-group">
                <label>Fecha Inicio:</label>
                <input type="date" class="form-control" ng-model="dataSearch.fechaInicio"/>
            </div>
        </div>
        <div class="col-xl-4 col-lg-4 col-md-6 col-sm-12 col-12">
            <div class="form-group">
                <label>Fecha Fin:</label>
                <input type="date" class="form-control" ng-model="dataSearch.fechaFin" />
            </div>
        </div>                    
    </div>

    <div class="row">
        <div class="col-lg-3 col-md-3 col-sm-12 col-12" ng-if="dataSearch.checkboxCategoriaFiltro">
            <div class="form-group">
                <label for="categoria">Categoria</label>
                <select class="form-control" ng-model="dataSearch.byCategoria">
                    <option ng-value="item.idCategoriaCompra" ng-repeat="item in categoriaCompras">{{item.descripcion}}</option>
                </select>
            </div>
        </div>
        
        <div class="col-lg-3 col-md-3 col-sm-12 col-12" ng-show="dataSearch.checkboxEstadoFiltro">
            <div class="form-group">
                <label>Estado:</label>                            
                <select class="form-control" ng-model="dataSearch.byEstado">
                    <option ng-value="item.id" ng-repeat="item in estadoPagos">
                        {{item.descripcion}}
                    </option>
                </select>                    
            </div>
        </div>

        <div class="col-lg-3 col-md-3 col-sm-6 col-12" ng-if="dataSearch.checkboxRetencionFiltro">
            <div class="icheck-info  mt-3">
                <input type="radio" ng-model="dataSearch.retencion" ng-value="true" name="checkboxRetencionFiltro" id="checkboxConRetencionFiltro">
                <label for="checkboxConRetencionFiltro">Con Retención</label>
            </div>
            <div class="icheck-info">
                <input type="radio" ng-model="dataSearch.retencion" ng-value="false" name="checkboxRetencionFiltro" id="checkboxSinRetencionFiltro">
                <label for="checkboxSinRetencionFiltro">Sin Retención</label>
            </div>  
        </div>
        <div class="col-lg-3 col-md-3 col-sm-6 col-12" ng-if="dataSearch.checkboxDevolucionFiltro">
            <div class="icheck-info  mt-3">
                <input type="radio" ng-model="dataSearch.notaCredito" ng-value="true" name="checkboxDevolucionFiltro" id="checkboxConDevolucionFiltro">
                <label for="checkboxConDevolucionFiltro">Con Devolución</label>
            </div>
            <div class="icheck-info">
                <input type="radio" ng-model="dataSearch.notaCredito" ng-value="false" name="checkboxDevolucionFiltro" id="checkboxSinDevolucionFiltro">
                <label for="checkboxSinDevolucionFiltro">Sin Devolución</label>
            </div>
        </div>
    </div>

    <div class="row justify-content-between" >                
        <div class="col-lg-3 col-md-3 col-sm-6 col-12">
            <div class="form-group">
                <label for="">Ordenar por</label>
                <select class="form-control" ng-model="dataSearch.byOrderCampo">
                    <option value="fc.nroDocumento" ng-if="dataSearch.tipoDoc=='FC'">Factura</option>                               
                    <option value="lc.nroDocumento" ng-if="dataSearch.tipoDoc=='LC'">Nro Liquidacion Compra</option>                               
                    <option value="ncp.nroDoc" ng-if="dataSearch.tipoDoc=='NCP'">Nro Nota Crédito</option>                               
                    <option value="rc.nroDocumento" ng-if="dataSearch.tipoDoc=='RC'">Nro Retencion</option>
                    <option value="nroDocumento" ng-if="dataSearch.tipoDoc=='IB'">Nro Ingreso Bodega</option>
                    <option value="oc.nroDocumento" ng-if="dataSearch.tipoDoc=='OC'">Nro Orden Compra</option>

                    <!--Fechas -->
                    <option value="fc.fechaEmision" ng-if="dataSearch.tipoDoc=='FC'">Fecha Emisión</option>
                    <option value="lc.fechaEmision" ng-if="dataSearch.tipoDoc=='LC'">Fecha Emisión</option>
                    <option value="ncp.fechaEmision" ng-if="dataSearch.tipoDoc=='NCP'">Fecha Emisión</option>
                    <option value="rc.fechaEmision" ng-if="dataSearch.tipoDoc=='RC'">Fecha Emisión</option>
                    <option value="fechaEmision" ng-if="dataSearch.tipoDoc=='IB'">Fecha Emisión</option>
                    <option value="oc.fechaEmision" ng-if="dataSearch.tipoDoc=='OC'">Fecha Emisión</option>
                    <option value="prov.idProveedor">Proveedor</option>
                </select>
            </div>                        
        </div>
        <div class="col-lg-3 col-md-3 col-sm-6 col-12">                       
            <div class="icheck-info mt-3">
                <input type="radio" ng-model="dataSearch.byOrder" value='ASC' name="radioByOrder" id="byOrderAsc">
                <label for="byOrderAsc">Ascendente</label>
            </div>
            <div class="icheck-info">
                <input type="radio" ng-model="dataSearch.byOrder" value="DESC" name="radioByOrder" id="byOrderDesc">
                <label for="byOrderDesc">Descendente</label>
            </div>
        </div>
        
        <div class="col-xl-3 col-lg-3 col-md-6 col-sm-4 col-12">
            <div class="form-group">
                <label for="tipoFormato">Tipo Formato</label>
                <div class="icheck-info">
                    <input type="radio" ng-model="dataSearch.byTipoFormato" value="pdf" name="tipoFormato" id="pdf">
                    <label for="pdf">PDF</label>
                </div>
                <div class="icheck-info">
                    <input type="radio" ng-model="dataSearch.byTipoFormato" value="excel" name="tipoFormato" id="excel">
                    <label for="excel">EXCEL</label>
                </div>
            </div>
        </div>




    </div>




</div>
<div class="modal-footer">
    <button type="button" class="btn btn-primary-1" ng-click="filtrarReporteCompra()"><i class="fa fa-search"></i> Buscar</button>
    <button type="button" class="btn btn-dark" ng-click="closeModal()">&times; Cerrar</button>
</div>
       