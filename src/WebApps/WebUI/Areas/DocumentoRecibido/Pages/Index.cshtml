@page
@model Recepcion_UI.Areas.DocumentoRecibido.Pages.IndexModel
@{
    ViewData["Title"] = "Index";
    Layout = "_Layout";
}
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
<style>
    .inputdemoInlineForm .demo-inline-form-container {
        padding: 16px;
    }

        .inputdemoInlineForm .demo-inline-form-container .demo-radio-button-label {
            margin: 18px 16px;
            padding-top: 6px;
        }
</style>
<div ng-controller="documentoRecibidoCtrl">
    <div class="row page-titles">
        <div class="col-md-5 align-self-center">
            <h5 class="text-themecolor">Recepción de Comprobantes</h5>
        </div>
    </div>

    <div class="row">
        <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">
            <div class="card">
                <div class="card-body">
                    <div section layout="row" layout-wrap>
                        <md-input-container>
                            <md-button class="md-raised md-primary" ng-click="askToNewImport(1)">
                                <icon class="ti-cloud"></icon> Importación Automatica
                            </md-button>
                        </md-input-container>
                        <md-input-container>
                            <md-button class="md-raised md-accent text-white" ng-click="askToNewImport(2)">
                                <icon class="fa fa-keyboard"></icon> Importación Manual
                            </md-button>
                        </md-input-container>
                        <md-input-container flex-gt-sm="20">
                            <label for="documentos">Comprobantes</label>
                            <md-select ng-model="doc" ng-change="getDocs(doc)">
                                <md-option ng-repeat="doc in tiposDocumento" ng-value="doc">
                                    {{doc.descripcion}}
                                </md-option>
                            </md-select>
                        </md-input-container>
                        <md-input-container flex-gt-sm="30">
                            <label for="search">Buscar:</label>
                            <input type="text" ng-model="search" ng-keyup="onKeyupSearchFilter()">
                        </md-input-container>
                        <md-input-container>
                            <md-button class="md-icon-button" ng-click="refresh()" aria-label="Stock"
                                       title="Actualizar">
                                <md-icon md-font-set="md" class="text-info">sync</md-icon>
                            </md-button>
                        </md-input-container>
                    </div>
                    <div class="row">
                        <div class="col-xl-4 col-lg-4 col-md-4 col-sm-4 col-12">
                            <div class="form-group">
                                <label for="sucursalFilter">Estab.:</label>
                                <select class="form-control border-select" ng-model="query.codEstab"
                                        ng-change="getComprobantes()">
                                    <option ng-value="item.codEstab" ng-repeat="item in establecimientos">
                                        {{item.nombreComercial}}
                                    </option>
                                </select>
                            </div>
                        </div>
                        <div class="col-xl-4 col-lg-4 col-md-4 col-sm-4 col-12">
                            <label>Rango de Fechas: </label>
                            <input date-range-picker class="form-control date-picker" type="text"
                                   ng-model="dateRangePicker.date" picker="dateRangePicker.picker"
                                   picker-classes="extra-class-names" min="'2014-02-23'" max="dateRangePicker.maxDate"
                                   options="dateRangePicker.options" options="{locale: {separator: " :"}}" />
                        </div>
                        <div class="col-xl-4 col-lg-4 col-md-4 col-sm-4 col-12">
                            @await Html.PartialAsync("~/Views/Proveedor/_ProveedorAutocompleteFiltro.cshtml")
                        </div>
                    </div>
                    <div class="row" ng-if="establecimientos.length > 1">
                        <div class="col-xl-4 col-lg-4 col-md-4 col-sm-4 col-12">
                            <button class="btn btn-info" ng-click="openMigrate()">
                                <i class="fa-solid fa-file-export"></i> Migrar Comprobantes
                            </button>
                        </div>
                    </div>
                    <div class="table-responsive" style="max-height: 400px;">
                        <table md-table md-row-select ng-model="selected" md-progress="promise">
                            <caption>Lista de Importaciones</caption>
                            <thead md-head md-order="query.sortBy" fix-head>
                                <tr md-row>
                                    <th md-column>Doc.</th>
                                    <th md-column md-order-by="serieComprobante">Serie</th>
                                    <th md-column>Ruc Emisor</th>
                                    <th md-column md-order-by="razonSocialEmisior" ng-click="setOrder($event)">
                                        <span>Razón Social Emisor</span>
                                    </th>
                                    <th md-column>Fecha Emisión</th>
                                    <th md-column>F. Aut.</th>
                                    <th md-column md-order-by="importeTotal">Total</th>
                                    <th md-column>No. Aut.</th>
                                </tr>
                            </thead>
                            <tbody md-body>
                                <tr md-row md-select="item" md-select-id="index" md-on-select="showOptions"
                                    md-auto-select="false" ng-repeat="item in comprobantes" style="{{item.colorRow}}"
                                    title="{{item.hoverText}}">
                                    <td md-cell style="{{item.colorCol}}">{{item.comprobante}}</td>
                                    <td md-cell style="{{item.colorCol}}">{{item.serieComprobante}}</td>
                                    <td md-cell style="{{item.colorCol}}">{{item.rucEmisor}}</td>
                                    <td class="text-left" style="{{item.colorCol}}" md-cell>
                                        {{item.razonSocialEmisior}}
                                    </td>
                                    <td md-cell style="{{item.colorCol}}">{{item.fechaEmision}}</td>
                                    <td md-cell style="{{item.colorCol}}">{{item.fechaAutorizacion}}</td>
                                    <td md-cell class="text-right" style="{{item.colorCol}}">
                                        {{item.importeTotal |
                                        currency }}
                                    </td>
                                    <td class="text-left" style="{{item.colorCol}}" md-cell>
                                        {{item.numeroAutorizacion}}
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                        @*<md-table-pagination md-limit="query.limit" md-limit-options="pages" md-page="query.page"
                        md-total="{{totalRecords}}" md-on-paginate="getComprobantes" md-page-select>
                        </md-table-pagination>*@
                    </div>

                </div>
            </div>
        </div>
    </div>
    @await Html.PartialAsync("_NewImport")
    @await Html.PartialAsync("_CompFounded")
    @await Html.PartialAsync("_MigrateEstab")
    @await Html.PartialAsync("_Retencion")
    @await Html.PartialAsync("_NotaCredito")
    @await Html.PartialAsync("_Doc_Relacionado")
    @await Html.PartialAsync("_ModalNewManual")

</div>
@section Scripts{
    <script src="~/js/compras/directives/compraDirective.min.js" asp-append-version="true"></script>
    <script src="~/js/controllers/recepcion/documentoRecibidoCtrl.min.js" asp-append-version="true"></script>
}
