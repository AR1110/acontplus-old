@page
@model WebUI.Areas.Inventario.Pages.IndexModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewBag.title = "Reporte Inventario";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div ng-controller="reporteInventarioCtrl">
    <div class="row page-titles">
        <div class="col-md-5 align-self-center">
            <h4 class="text-themecolor">Reporte Inventario</h4>
        </div>
        <div class="col-md-7 align-self-center text-right">
            <div class="d-flex justify-content-end align-items-center">

            </div>
        </div>
    </div>


    <div class="row">
        <div class="col-lg-12">
            <div class="card">

                <!-- Nav tabs -->
                <ul class="nav nav-tabs customtab" role="tablist">
                    <li class="nav-item">
                        <a class="nav-link active" ng-click="onTab($event, 0)" data-toggle="tab" href="#" role="tab">
                            <span class="hidden-sm-up"></span>
                            <span class="hidden-xs-down">Consumo Diario</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" ng-click="onTab($event, 1)" data-toggle="tab" href="#" role="tab">
                            <span class="hidden-sm-up"></span>
                            <span class="hidden-xs-down">Artículo</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" ng-click="onTab($event, 2)" data-toggle="tab" href="#" role="tab">
                            <span class="hidden-sm-up"></span>
                            <span class="hidden-xs-down">Articulos fraccionados</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" ng-click="onTab($event, 3)" data-toggle="tab" href="#" role="tab">
                            <span class="hidden-sm-up"></span>
                            <span class="hidden-xs-down">Caducidad</span>
                        </a>
                    </li>
                </ul>
                <div class="tab-content">

                    <!--Consumo diario-->
                    <div class="tab-pane active" id="tab1" role="tabpanel">
                        <div class="p-15">
                            <div class="row">
                                <div class="col-xl-6 col-lg-6 col-md-12 col-sm-12 col-12">
                                    <div class="icheck-info">
                                        <input type="checkbox" ng-model="dataSearch.checkboxArticuloFiltro"
                                            class="form-control" name="checkboxArticuloConsumoDiario"
                                            id="checkboxArticuloConsumoDiario">
                                        <label for="checkboxArticuloConsumoDiario">Articulo</label>
                                    </div>
                                </div>
                                <div class="col-xl-6 col-lg-6 col-md-12 col-sm-12 col-12">
                                    <div class="icheck-info">
                                        <input type="checkbox" ng-model="dataSearch.checkboxUsuarioFiltro"
                                            class="form-control" name="checkboxConsumoDiarioUsuario"
                                            id="checkboxConsumoDiarioUsuario">
                                        <label for="checkboxConsumoDiarioUsuario">Usuario</label>
                                    </div>
                                </div>
                            </div>
                            <hr>

                            <div class="row">
                                <div class="col-xl-6 col-lg-6 col-md-12 col-sm-12 col-12"
                                    ng-show="dataSearch.checkboxArticuloFiltro">
                                    <div class="form-group">
                                        <label class="form-control-label">Buscar Articulo</label>
                                        <input type="text" id="articleInputSearch" class="form-control border-select"
                                            article-search-drtv on-select="onSelectArticle(result)"
                                            on-keyup-article="onKeyupArticle()" ng-model="dataSearchArticle"
                                            placeholder="..." onclick="select();" />
                                        <script type="text/ng-template" id="autocompleteArticleTemplate.html">
                                            <div class="autocomplete-suggestion-cliente">
                                                <span class="item-title">
                                                    <small> {{match.model.descripcion}}</small><br>
                                                    <small><b>Medida: </b>{{match.model.medida}}</small>
                                                </span>
                                            </div>
                                        </script>
                                    </div>
                                </div>

                                <div class="col-xl-6 col-lg-6 col-md-12 col-sm-12 col-12"
                                    ng-show="dataSearch.checkboxUsuarioFiltro">
                                    <div class="form-group">
                                        <label class="form-control-label">Buscar Usuario</label>
                                        <input type="text" id="userInputSearch" class="form-control border-select"
                                            user-search-drtv on-select="onSelectUser(result)"
                                            onKeyup-search="onKeyupUser()" ng-model="dataSearchUser.nombreCompleto"
                                            placeholder="..." onclick="select();" />
                                        <script type="text/ng-template" id="autocompleteUserTemplate.html">
                                            <div class="autocomplete-suggestion-cliente">
                                                <span class="item-title">
                                                    <small> {{match.model.nombreCompleto}}</small><br>
                                                    <small><b>C.I: </b>{{match.model.nroIdentificacion}}</small>
                                                </span>
                                            </div>
                                        </script>
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-xl-6 col-lg-6 col-md-12 col-sm-12 col-12">
                                    <div class="form-group">
                                        <label>Rango Fechas</label>
                                        <date-range-filter current-date="dataSearch.fechaInicio"
                                            start-date="dataSearch.fechaInicio" end-date="dataSearch.fechaFin"
                                            result-range-date="resultRangeFilter(result)"></date-range-filter>
                                    </div>
                                </div>
                                <div class="col-xl-6 col-lg-6 col-md-12 col-sm-12 col-12">
                                    <div class="form-group">
                                        <label for="ordenar">Tipo Transacción:</label>
                                        <select class="form-control border-select" ng-model="dataSearch.codTransaccion">
                                            <option value="S">Salida</option>
                                            <option value="E">Entrada</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!--Articulo con valoracion o lista precios-->
                    <div class="tab-pane p-20" id="tab2" role="tabpanel">
                        <div class="row">
                            <div class="col-xl-3 col-lg-3 col-md-6 col-sm-12 col-12">
                                <div class="icheck-info">
                                    <input type="checkbox" ng-model="dataSearch.chkProveedor" class="form-control"
                                        ng-change="onChangeCheckProveedor()" name="chkProveedor" id="chkProveedor">
                                    <label for="chkProveedor">Proveedor</label>
                                </div>
                            </div>

                            <div class="col-xl-3 col-lg-3 col-md-6 col-sm-12 col-12">
                                <div class="icheck-info" ng-if="!dataSearch.chkProveedor">
                                    <input type="checkbox" ng-model="dataSearch.checkboxSubFamiliaFiltro"
                                        class="form-control" name="checkboxSubFamiliaFiltro"
                                        id="checkboxSubFamiliaFiltro">
                                    <label for="checkboxSubFamiliaFiltro">SubFamilia</label>
                                </div>
                            </div>
                        </div>
                        <hr>
                        <div class="row">
                            <div class="col-xl-4 col-lg-4 col-md-6 col-sm-6 col-12" ng-if="dataSearch.chkProveedor">
                                <div class="form-group">
                                    <label for="proveedorFiltro">Proveedor:</label>
                                    <input type="text" id="providerInputSearch" class="form-control border-select"
                                        ng-model="proveedor.nombreProveedor" provider-search-drtv
                                        on-select="onSelectProveedor(result)" on-keyup="onKeyupProveedor()"
                                        placeholder="Ingrese C.I o Nombre Comercial" onclick="select();">

                                    <script type="text/ng-template" id="autocompleteProviderTemplate.html">
                                        <div class="autocomplete-suggestion-uib-typeahead">
                                            <span class="item-title"><b> {{match.model.numeroIdentificacion}}</b> - {{match.model.nombreFiscal}}</span>
                                        </div>
                                    </script>
                                </div>
                            </div>

                            <div class="col-xl-4 col-lg-4 col-md-6 col-sm-6 col-12"
                                ng-if="dataSearch.checkboxSubFamiliaFiltro">
                                <div class="form-group">
                                    <label for="">SubFamilia</label>
                                    <select class="form-control border-select" ng-model="dataSearch.bySubFamilia"
                                        ng-options="sf.idSubFamilia as sf.subFamilia group by sf.familia  for sf in subFamilias">
                                    </select>
                                </div>
                            </div>

                            <div class="col-xl-3 col-lg-3 col-md-6 col-sm-6 col-12" ng-if="dataSearch.chkUbicacion">
                                <div class="form-group">
                                    <label for="estab">Establecimiento</label>
                                    <select name="estab" id="estab" class="form-control border-select"
                                        ng-model="dataSearch.codEstab" ng-change="onChangeEstab()">
                                        <option ng-value="item.codEstab" ng-repeat="item in establecimientos">
                                            {{item.nombreComercial}}
                                        </option>
                                    </select>
                                </div>

                            </div>
                            <div class="col-xl-3 col-lg-3 col-md-6 col-sm-6 col-12" ng-if="dataSearch.chkUbicacion">
                                <div class="form-group">
                                    <label for="bodega">Bodega</label>
                                    <select name="bodega" id="bodega" class="form-control border-select"
                                        ng-model="dataSearch.idBodega">
                                        <option ng-value="item.idBodega" ng-repeat="item in bodegas">
                                            {{item.bodega}}
                                        </option>
                                    </select>
                                </div>

                            </div>
                            <div class="col-xl-2 col-lg-2 col-md-6 col-sm-6 col-12" ng-if="dataSearch.chkUbicacion">
                                <div class="form-group">
                                    <label for="ubicacion">Ubicación</label>
                                    <input type="text" class="form-control border-select"
                                        ng-model="dataSearch.textUbicacion">
                                </div>

                            </div>
                        </div>

                        <div class="row">
                            <div class="col-xl-3 col-lg-3 col-md-6 col-sm-12 col-12"
                                ng-if="dataSearch.ckFechaCaducidad">
                                <div class="form-group">
                                    <label>Rango Fechas</label>
                                    <date-range-filter current-date="dataSearch.fechaInicio"
                                        start-date="dataSearch.fechaInicio" end-date="dataSearch.fechaFin"
                                        result-range-date="resultRangeFilter(result)"></date-range-filter>
                                </div>
                            </div>

                            <div class="col-xl-3 col-lg-3 col-md-6 col-sm-12 col-12">
                                <div class="form-group">
                                    <label for="ordenar">Ordenar por:</label>
                                    <select class="form-control border-select" ng-model="dataSearch.byOrderCampo">
                                        <option value="ar.codigo">Codigo</option>
                                        <option value="ar.descripcion">Descripción</option>
                                        <option value="ar.idSubFamilia">SubFamilia</option>
                                        <option value="ar.stock">Stock</option>
                                    </select>
                                </div>
                            </div>


                            <div class="col-xl-3 col-lg-3 col-md-6 col-sm-12 col-12">
                                <div class="icheck-info mt-3">
                                    <input type="radio" ng-model="dataSearch.byOrder" value='ASC' name="radioByOrder"
                                        id="byOrderAsc">
                                    <label for="byOrderAsc">Ascendente</label>
                                </div>
                                <div class="icheck-info">
                                    <input type="radio" ng-model="dataSearch.byOrder" value="DESC" name="radioByOrder"
                                        id="byOrderDesc">
                                    <label for="byOrderDesc">Descendente</label>
                                </div>
                            </div>

                            <div class="col-xl-3 col-lg-3 col-md-6 col-sm-12 col-12">
                                <div class="icheck-info mt-3">
                                    <input type="radio" ng-model="dataSearch.tipoReporteArticulo" value='INVRV'
                                        name="tipoReporteArticulo" id="tipoReporteArticuloValoracion">
                                    <label for="tipoReporteArticuloValoracion">Con valoración</label>
                                </div>
                                <div class="icheck-info">
                                    <input type="radio" ng-model="dataSearch.tipoReporteArticulo" value="INVAT"
                                        name="tipoReporteArticulo" id="tipoReporteArticuloListaPrecio">
                                    <label for="tipoReporteArticuloListaPrecio">Con lista de precios</label>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!--Articulo Fraccionado-->
                    <div class="tab-pane p-20" id="tab3" role="tabpanel">
                        <div class="row">
                            <div class="col-xl-6 col-lg-6 col-md-12 col-sm-12 col-12">
                                <div class="icheck-info">
                                    <input type="checkbox" ng-model="dataSearch.checkboxArticuloFiltro"
                                        class="form-control" name="checkboxArticuloConsumoDiario"
                                        id="checkboxArticuloConsumoDiario">
                                    <label for="checkboxArticuloConsumoDiario">Articulo</label>
                                </div>
                            </div>

                            <div class="col-xl-3 col-lg-3 col-md-6 col-sm-12 col-12">
                                <div class="icheck-info">
                                    <input type="checkbox" ng-model="dataSearch.chkProveedor" class="form-control"
                                        ng-change="onChangeCheckProveedor()" name="chkProveedor" id="chkProveedor">
                                    <label for="chkProveedor">Proveedor</label>
                                </div>
                            </div>

                            <div class="col-xl-3 col-lg-3 col-md-6 col-sm-12 col-12">
                                <div class="icheck-info" ng-if="!dataSearch.chkProveedor">
                                    <input type="checkbox" ng-model="dataSearch.checkboxSubFamiliaFiltro"
                                        class="form-control" name="checkboxSubFamiliaFiltro"
                                        id="checkboxSubFamiliaFiltro">
                                    <label for="checkboxSubFamiliaFiltro">SubFamilia</label>
                                </div>
                            </div>
                        </div>
                        <hr>
                        <div class="row">
                            <div class="col-xl-4 col-lg-4 col-md-6 col-sm-6 col-12" ng-if="dataSearch.chkProveedor">
                                <div class="form-group">
                                    <label for="proveedorFiltro">Proveedor:</label>
                                    <input type="text" id="providerInputSearch" class="form-control border-select"
                                        ng-model="proveedor.nombreProveedor" provider-search-drtv
                                        on-select="onSelectProveedor(result)" on-keyup="onKeyupProveedor()"
                                        placeholder="Ingrese C.I o Nombre Comercial" onclick="select();">

                                    <script type="text/ng-template" id="autocompleteProviderTemplate.html">
                                        <div class="autocomplete-suggestion-uib-typeahead">
                                            <span class="item-title"><b> {{match.model.numeroIdentificacion}}</b> - {{match.model.nombreFiscal}}</span>
                                        </div>
                                    </script>
                                </div>
                            </div>

                            <div class="col-xl-4 col-lg-4 col-md-6 col-sm-6 col-12"
                                ng-if="dataSearch.checkboxSubFamiliaFiltro">
                                <div class="form-group">
                                    <label for="">SubFamilia</label>
                                    <select class="form-control border-select" ng-model="dataSearch.bySubFamilia"
                                        ng-options="sf.idSubFamilia as sf.subFamilia group by sf.familia  for sf in subFamilias">
                                    </select>
                                </div>
                            </div>

                            <div class="col-xl-6 col-lg-6 col-md-12 col-sm-12 col-12"
                                ng-show="dataSearch.checkboxArticuloFiltro">
                                <div class="form-group">
                                    <label class="form-control-label">Buscar Articulo</label>
                                    <input type="text" id="articleInputSearch" class="form-control border-select"
                                        article-search-drtv on-select="onSelectArticle(result)"
                                        on-keyup-article="onKeyupArticle()" ng-model="dataSearchArticle"
                                        placeholder="..." onclick="select();" />
                                    <script type="text/ng-template" id="autocompleteArticleTemplate.html">
                                        <div class="autocomplete-suggestion-cliente">
                                            <span class="item-title">
                                                <small> {{match.model.descripcion}}</small><br>
                                                <small><b>Medida: </b>{{match.model.medida}}</small>
                                            </span>
                                        </div>
                                    </script>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!--Articulo con configuracion de caducidad-->
                    <div class="tab-pane p-20" id="tab4" role="tabpanel">
                        <div class="row">
                            <div class="col-xl-3 col-lg-3 col-md-6 col-sm-12 col-12">
                                <div class="icheck-info">
                                    <input type="checkbox" ng-model="dataSearch.chkProveedor" class="form-control"
                                        ng-change="onChangeCheckProveedor()" name="chkProveedor" id="chkProveedor">
                                    <label for="chkProveedor">Proveedor</label>
                                </div>
                            </div>

                            <div class="col-xl-3 col-lg-3 col-md-6 col-sm-12 col-12">
                                <div class="icheck-info" ng-if="!dataSearch.chkProveedor">
                                    <input type="checkbox" ng-model="dataSearch.checkboxSubFamiliaFiltro"
                                        class="form-control" name="checkboxSubFamiliaFiltro"
                                        id="checkboxSubFamiliaFiltro">
                                    <label for="checkboxSubFamiliaFiltro">SubFamilia</label>
                                </div>
                            </div>

                            <div class="col-xl-3 col-lg-3 col-md-6 col-sm-12 col-12">
                                <div class="icheck-info">
                                    <input type="checkbox" ng-model="dataSearch.ckFechaCaducidad" class="form-control"
                                        name="chkFechaCaducidad" id="chkFechaCaducidad">
                                    <label for="chkFechaCaducidad">Fecha Caducidad</label>
                                </div>
                            </div>

                            <div class="col-xl-3 col-lg-3 col-md-6 col-sm-12 col-12">
                                <div class="icheck-info">
                                    <input type="checkbox" ng-model="dataSearch.chkUbicacion" class="form-control"
                                        name="chkUbicacion" id="chkUbicacion">
                                    <label for="chkUbicacion">Ubicación</label>
                                </div>
                            </div>
                            
                        </div>
                        <hr>
                        <div class="row">
                            <div class="col-xl-4 col-lg-4 col-md-6 col-sm-6 col-12" ng-if="dataSearch.chkProveedor">
                                <div class="form-group">
                                    <label for="proveedorFiltro">Proveedor:</label>
                                    <input type="text" id="providerInputSearch" class="form-control border-select"
                                        ng-model="proveedor.nombreProveedor" provider-search-drtv
                                        on-select="onSelectProveedor(result)" on-keyup="onKeyupProveedor()"
                                        placeholder="Ingrese C.I o Nombre Comercial" onclick="select();">

                                    <script type="text/ng-template" id="autocompleteProviderTemplate.html">
                                        <div class="autocomplete-suggestion-uib-typeahead">
                                            <span class="item-title"><b> {{match.model.numeroIdentificacion}}</b> - {{match.model.nombreFiscal}}</span>
                                        </div>
                                    </script>
                                </div>
                            </div>

                            <div class="col-xl-4 col-lg-4 col-md-6 col-sm-6 col-12"
                                ng-if="dataSearch.checkboxSubFamiliaFiltro">
                                <div class="form-group">
                                    <label for="">SubFamilia</label>
                                    <select class="form-control border-select" ng-model="dataSearch.bySubFamilia"
                                        ng-options="sf.idSubFamilia as sf.subFamilia group by sf.familia  for sf in subFamilias">
                                    </select>
                                </div>
                            </div>

                            <div class="col-xl-3 col-lg-3 col-md-6 col-sm-6 col-12" ng-if="dataSearch.chkUbicacion">
                                <div class="form-group">
                                    <label for="estab">Establecimiento</label>
                                    <select name="estab" id="estab" class="form-control border-select"
                                        ng-model="dataSearch.codEstab" ng-change="onChangeEstab()">
                                        <option ng-value="item.codEstab" ng-repeat="item in establecimientos">
                                            {{item.nombreComercial}}
                                        </option>
                                    </select>
                                </div>

                            </div>
                            <div class="col-xl-3 col-lg-3 col-md-6 col-sm-6 col-12" ng-if="dataSearch.chkUbicacion">
                                <div class="form-group">
                                    <label for="bodega">Bodega</label>
                                    <select name="bodega" id="bodega" class="form-control border-select"
                                        ng-model="dataSearch.idBodega">
                                        <option ng-value="item.idBodega" ng-repeat="item in bodegas">
                                            {{item.bodega}}
                                        </option>
                                    </select>
                                </div>

                            </div>
                            <div class="col-xl-2 col-lg-2 col-md-6 col-sm-6 col-12" ng-if="dataSearch.chkUbicacion">
                                <div class="form-group">
                                    <label for="ubicacion">Ubicación</label>
                                    <input type="text" class="form-control border-select"
                                        ng-model="dataSearch.textUbicacion">
                                </div>
                            </div>

                            <div class="col-xl-4 col-lg-4 col-md-6 col-sm-6 col-12">
                                <div class="form-group">
                                    <label for="">Estado</label>
                                    <select class="form-control border-select" ng-model="dataSearch.estado">
                                        <option value="CA">Caducado</option>
                                        <option value="PA">Proximo a Caducar</option>
                                        <option value="VI">Vigente</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-xl-3 col-lg-3 col-md-6 col-sm-12 col-12"
                                ng-if="dataSearch.ckFechaCaducidad">
                                <div class="form-group">
                                    <label>Rango Fechas</label>
                                    <date-range-filter current-date="dataSearch.fechaInicio"
                                        start-date="dataSearch.fechaInicio" end-date="dataSearch.fechaFin"
                                        result-range-date="resultRangeFilter(result)"></date-range-filter>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
                <div class="card-body">
                    <div class="form-group">
                        <label for="tipoFormato">Tipo Formato</label>
                        <div class="icheck-info">
                            <input type="radio" ng-model="dataSearch.byTipoFormato" value="pdf" name="tipoFormato"
                                id="pdf">
                            <label for="pdf">PDF</label>
                        </div>
                        <div class="icheck-info">
                            <input type="radio" ng-model="dataSearch.byTipoFormato" value="excel" name="tipoFormato"
                                id="excel">
                            <label for="excel">EXCEL</label>
                        </div>
                    </div>
                </div>
                <div class="card-footer">
                    <button class="btn btn-success" ng-click="filtrar()">
                        <i class="ti-file"></i> Descargar
                    </button>
                </div>
            </div>
        </div>
    </div>


</div>

@section Scripts{
    <script src="~/js/reports/controllers/reporteInventarioCtrl.min.js" asp-append-version="true"></script>
}