@page
@model WebUI.CompraNoHabitual.Pages.IndexModel
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<div ng-controller="compraNoHabitualCtrl">
    <div class="row page-titles">
        <div class="col-md-5 align-self-center">
            <h4 class="text-themecolor">Compra No Habitual</h4>
        </div>
        <div class="col-md-7 align-self-center text-right">
            <div class="d-flex justify-content-end align-items-center">
                <button type="button" ng-click="openModalNew()" class="btn btn-info d-none d-lg-block m-l-15">
                    <i class="icons-Add-File"></i> Nuevo
                </button>
            </div>
        </div>
    </div>


    @await Html.PartialAsync("_ModalFiltro")

    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-body">
                    <md-toolbar class="md-table-toolbar md-default">
                        <div class="md-toolbar-tools">

                            <div class="col-lg-3 col-md-3 col-sm-6 col-12">
                                <button type="button" class="btn btn-info" ng-click="openModalFiltro()"><i
                                        class=" fas fa-filter"></i> Filtrar</button>
                            </div>
                            <div class="col-lg-6 col"></div>
                            <div class="col-lg-3 col-md-3 col-sm-12 col-12">
                                <form class="form-material">
                                    <div class="input-group">
                                        <input type="text" class="form-control" ng-keyup="filterLocalLCompras()"
                                            ng-model="txtFilter" placeholder="Buscar">
                                        <div class="input-group-append">
                                            <button type="button" class="btn btn-outline-secondary btn-xs"
                                                ng-click="getComprasNoHabitual()">
                                                <i class="fas fa-redo fa-xs"></i>
                                            </button>
                                        </div>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </md-toolbar>

                    <md-table-container style="max-height: 400px;">
                        <table resize md-table class="table-condensed table-sm">
                            <thead fix-head md-head md-order="query.order" md-on-reorder="liqCompras">
                                <tr md-row>
                                    <th md-column>Op</th>
                                    <th md-column>N°. Doc</th>
                                    <th md-column>F. Emisión</th>
                                    <th md-column>Proveedor</th>
                                    <th md-column>Total</th>
                                    <th md-column>Estado</th>
                                    <th md-column>Usuario</th>
                                </tr>
                            </thead>
                            <tbody md-body>
                                <tr md-row ng-repeat="item in documentoIngreso" ng-class="item.colorRow">
                                    <td md-cell>
                                        <md-menu>
                                            <md-button aria-label="Open demo menu" class="md-icon-button"
                                                ng-click="$mdMenu.open($event)">
                                                <icon class="mdi mdi-menu"></icon>
                                            </md-button>
                                            <md-menu-content class="md-dense">
                                                <md-menu-item>
                                                    <md-button ng-click="openModalDetalle(item)">
                                                        <span md-menu-align-target><i class="ti-menu"></i>
                                                            Detalle</span>
                                                    </md-button>
                                                </md-menu-item>

                                                <md-menu-item>
                                                    <md-button ng-click="openModalEditar(item)">
                                                        <span md-menu-align-target><i class="ti-pencil"></i>
                                                            Editar</span>
                                                    </md-button>
                                                </md-menu-item>

                                                <md-menu-item>
                                                    <md-button ng-click="askToDelete(item)">
                                                        <span md-menu-align-target>
                                                            <icon class="ti-na"></icon> Anular
                                                        </span>
                                                    </md-button>
                                                </md-menu-item>

                                            </md-menu-content>
                                        </md-menu>
                                    </td>
                                    <td md-cell>{{item.serieComprobante}}</td>
                                    <td md-cell>{{item.fechaEmision}}</td>
                                    <td md-cell>{{item.nombreFiscal}}</td>
                                    <td md-cell>${{item.importeTotal}}</td>
                                    <td md-cell>{{item.estado}}</td>
                                    <td md-cell>{{item.usuario}}</td>
                                </tr>
                                <tr ng-if="documentoIngreso.length===0" class="text-center">
                                    <td colspan="10">No hay registros</td>
                                </tr>
                            </tbody>
                            <tfoot md-foot>
                                <tr md-row>
                                    <td md-cell colspan="2">{{liquidacionesCompra.length}} Registros</td>
                                    <td md-cell colspan="2"><span class="font-weight-bold">Total:</span></td>
                                    <td md-cell><span class="font-weight-bold">{{importeTotal}}</span></td>
                                    <td md-cell colspan="3"></td>
                                </tr>
                            </tfoot>
                        </table>
                    </md-table-container>
                </div>
            </div>
        </div>
    </div>



</div>

@section Scripts{

    <script src="~/js/common/components/mdAutocompleteProveedor.min.js" asp-append-version="true"></script>
    <script src="~/js/compras/directives/compraDirective.min.js" asp-append-version="true"></script>
    <script src="~/js/compras/services/compraNoHabitualService.js" asp-append-version="true"></script>
    <script src="~/js/compras/controllers/compraNoHabitualCtrl.js" asp-append-version="true"></script>

}