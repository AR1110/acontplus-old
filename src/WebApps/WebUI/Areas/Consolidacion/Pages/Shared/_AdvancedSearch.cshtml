<form autocomplete="off" ng-submit="setArticlesSelected()">
    <div class="modal-header">
        <h5 class="modal-title"><i class="ti-search"></i> Busqueda Avanzada</h5>
        <button class="close" ng-click="closeAdvancedSearch()">&times;</button>
    </div>
    <div class="modal-body">
        <div class="row">
            <div class="col-xl-3 col-lg-3 col-md-4 col-sm-4 col-12">
                <div class="form-group">
                    <label for="codEstab">Opciones:</label>
                    <select name="codEstab" id="codEstab" class="form-control" ng-model="mainForm.opcion">
                        <option ng-value="item.code" ng-repeat="item in catalogs">
                            {{item.description}}
                        </option>
                    </select>
                </div>
            </div>
            <div class="col-lg-4 col-md-4 col-sm-4 col-12" ng-if="mainForm.opcion == 1">
                <div class="form-group">
                    <label for="articuloFiltro">Articulo</label>
                    <input type="text" id="articuloSearchFiltro" autocomplete="off" name="articuloSearchFiltro"
                           class="form-control border-select" placeholder="Ingrese Descripción del Articulo"
                           ng-model="$ctrl.articuloFiltro.descripcion" ng-keyup="$ctrl.onKeyupArticuloSearchFiltro()"
                           uib-typeahead="a as a.descripcion for a in articuloSearch($viewValue)"
                           typeahead-loading="$ctrl.articuloFiltro.loading"
                           typeahead-no-results="$ctrl.articuloFiltro.noResults"
                           typeahead-template-url="articuloSearchFiltroTemplate.html" typeahead-editable="false"
                           typeahead-on-select="articleSelected($item)" onclick="this.select()" />

                    <script type="text/ng-template" id="articuloSearchFiltroTemplate.html">
                        <div class="autocomplete-suggestion-uib-typeahead">
                            <span class="item-title">
                                <small> {{match.model.descripcion}}</small><br>
                                <small><b>Código: </b>{{match.model.codigo}}</small>
                            </span>
                        </div>
                    </script>
                    <span class="ml-5" ng-if="$ctrl.articuloFiltro.loading">
                        <i class="fas fa-sync-alt fa-xs"></i>
                        Loading...
                    </span>
                    <small class="text-danger ml-5" ng-if="$ctrl.articuloFiltro.noResults">
                        No se encontraron
                        resultados
                    </small>
                </div>
            </div>
            <div class="col-xl-4 col-lg-4 col-md-4 col-sm-4 col-12" ng-if="mainForm.opcion==2">
                <div class="form-group">
                    <label for="idFamilia">Familias:</label>
                    <select name="idFamilia" id="idFamilia" class="form-control" ng-model="mainForm.idFamilia"
                            ng-change="getArticles()">
                        <option ng-value="item.idFamilia" ng-repeat="item in familias">
                            {{item.descripcion}}
                        </option>
                    </select>
                </div>
            </div>
            <div class="col-xl-4 col-lg-4 col-md-4 col-sm-4 col-12" ng-if="mainForm.opcion==3">
                <div class="form-group">
                    <label for="idSubFamilia">Subfamilias:</label>
                    <select name="idSubFamilia" id="idSubFamilia" class="form-control"
                            ng-model="mainForm.idSubFamilia" ng-change="getArticles()">
                        <option ng-value="item.idSubFamilia" ng-repeat="item in subfamilias">
                            {{item.descripcion}}
                        </option>
                    </select>
                </div>
            </div>
            <div class="col-xl-4 col-lg-4 col-md-4 col-sm-4 col-12" ng-if="mainForm.opcion==4">
                @await Html.PartialAsync("~/Pages/Compras/Proveedor/_ProveedorAutocompleteFiltro.cshtml")
            </div>
            <div class="col-xl-4 col-lg-4 col-md-4 col-sm-4 col-12" ng-if="mainForm.opcion==5">
                <div class="form-group">
                    <label for="nroDocumento">N° de Documento:</label>
                    <input type="text" class="form-control" id="nroDocumento" name="nroDocumento"
                           placeholder="000-000-000000000" onclick="this.select()" mask="999-999-999999999"
                           ng-blur="getArticles()" ng-model="mainForm.nroDocumento" required>
                </div>
            </div>
        </div>
        <hr />
        <div class="row" ng-show="articlesFounded.length > 0">
            <div class="col-xl-6 col-lg-6 col-md-6 col-sm-6 col-12">
                <div class="form-group">
                    <input type="text" class="search form-control" onclick="this.select()" ng-model="search"
                           placeholder="Buscar artículo">
                </div>
            </div>
        </div>
        <div class="table-responsive" ng-show="articlesFounded.length > 0">
            <table md-table md-row-select multiple ng-model="articlesSelected" md-progress="promise">
                <caption>Articulos Selecionados: <span class="text-info">{{articlesSelected.length}}</span></caption>
                <thead md-head>
                    <tr md-row>
                        <th md-column>Cód.</th>
                        <th md-column>Descripcion</th>
                        <th md-column>Cantidad</th>
                        <th md-column>Medida</th>
                        <th md-column>Iva</th>
                        <th md-column>Stock</th>
                        <th md-column>Precio Costo</th>
                        <th md-column>Precio Actual</th>
                    </tr>
                </thead>
                <tbody md-body>
                    <tr md-row md-select="item" md-select-id="index"
                        md-auto-select ng-repeat="item in articlesFounded | filter: search">
                        <td md-cell>{{item.codigo}}</td>
                        <td md-cell>{{item.descripcion}}</td>
                        <td md-cell>{{item.cantidad}}</td>
                        <td class="text-lSoeft" md-cell> {{item.medida}}</td>
                        <td md-cell>{{item.nombreTipoIva}}</td>
                        <td md-cell>{{item.stock}}</td>
                        <td md-cell class="text-right">
                            {{item.precioCosto | currency }}
                        </td>
                        <td class="text-left" md-cell>
                            {{item.precioActual}}
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

    </div>
    <div class="modal-footer">
        <button type="submit" class="btn btn-success"><i class="ti-settings"></i> Aplicar</button>
        <button type="button" class="btn btn-dark" ng-click="closeAdvancedSearch()">&times; Cancelar</button>
    </div>
</form>
