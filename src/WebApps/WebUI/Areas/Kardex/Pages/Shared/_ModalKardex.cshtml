<div class="modal-header">
    <h5 class="modal-title">Articulo Kardex</h5>
    <button type="button" class="close" ng-click="closeModal()">&times;</button>
</div>

<div class="modal-body ">
    <div class="row justify-content-between">
        <div class="col-lg-2 col-md-4 col-sm-12 col-12">
            <div class="icheck-info">
                <input type="checkbox" ng-change="onChangeFechaFiltro()" ng-model="dataSearch.checkBoxFecha"
                    id="checkBoxFechaFiltro">
                <label for="checkBoxFechaFiltro">Fecha</label>
            </div>
        </div>

        <div class="col-lg-2 col-md-4 col-sm-12 col-12">
            <div class="icheck-info">
                <input type="checkbox" ng-model="dataSearch.checkBoxBodega" id="checkBoxBodegaFiltro">
                <label for="checkBoxBodegaFiltro">Bodega</label>
            </div>
        </div> 
        <div class="col-lg-4 col-md-4 col-sm-12 col-12">
            <div class="icheck-info">
                <input type="checkbox" ng-model="dataSearch.checkBoxConsolidacion"
                    ng-change="onChangecheckBoxConsolidacionInventario()" id="checkBoxConsolidacionInventario">
                <label for="checkBoxConsolidacionInventario">Buscar consolidaciones de Inventario </label>
            </div>
        </div>
        <div class="col-lg-4 col-md-4 col-sm-12 col-12" ng-if="dataSearch.checkBoxBodega">
            <div class="icheck-info">
                <input type="checkbox" ng-model="dataSearch.checkBoxUltimaConsolidacion"
                    ng-change="onChangeUltimaConsolidacion()" id="checkBoxUltimaConsolidacion">
                <label for="checkBoxUltimaConsolidacion">Buscar a partir de la ultima consolidación </label>
            </div>
        </div>
    </div> 
    <hr>
    <div class="row">
        <div class="col-lg-3 col-md-3 col-sm-12 col-12">
            <div class="form-group">
                <label for="">Establecimiento</label>
                <select class="form-control border-select" ng-model="dataSearch.codEstab" ng-change="getBodegas()">
                    <option ng-value="item.codEstab" ng-repeat="item in establecimientos">{{item.nombreComercial}}
                    </option>
                </select>
            </div>
        </div>

        <div class="col-lg-3 col-md-3 col-sm-12 col-12" ng-if="dataSearch.checkBoxBodega">
            <div class="form-group">
                <label for="bodega">Bodega</label>
                <select class="form-control border-select" ng-model="dataSearch.byBodega">
                    <option ng-value="b.idBodega" ng-repeat="b in bodegas">{{b.descripcion}}</option>
                </select>
            </div>
        </div>

        <div class="col-lg-5 col-md-5 col-sm-12 col-12">
            <div class="form-group">
                <label for="articuloFiltro">Articulo</label>
                <input type="text" id="articuloSearchFiltro" autocomplete="off" name="articuloSearchFiltro"
                    class="form-control border-select" placeholder="Ingrese Descripción del Articulo"
                    ng-model="articuloFiltro.descripcion" ng-keyup="onKeyupArticuloSearchFiltro()"
                    uib-typeahead="a as a.descripcion for a in articuloSearch($viewValue)"
                    typeahead-loading="articuloFiltro.loading" typeahead-no-results="articuloFiltro.noResults"
                    typeahead-template-url="articuloSearchFiltroTemplate.html" typeahead-editable="false"
                    typeahead-on-select="selectedArticuloSearchFiltro($item)" onClick="this.select()" />

                <script type="text/ng-template" id="articuloSearchFiltroTemplate.html">
                    <div class="autocomplete-suggestion-uib-typeahead">
                        <span class="item-title">
                            <small> {{match.model.descripcion}}</small><br>
                            <small><b>Código: </b>{{match.model.codigo}}</small>
                        </span>
                    </div>
                </script>

                <span class="ml-5" ng-if="articuloFiltro.loading"> <i class="fas fa-sync-alt fa-xs"></i>
                    Loading...</span>
                <small class="text-danger ml-5" ng-if="articuloFiltro.noResults">No se encontraron
                    resultados</small>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8 col-md-8 col-sm-12 col-12">
            <div class="row">
                <div class="col-xl-6 col-lg-6 col-md-6 col-sm-12 col-12" ng-if="dataSearch.checkBoxFecha">
                    <div class="form-group">
                        <label for="dateRange">Rango de Fechas: </label>
                        <input date-range-picker class="form-control date-picker" type="text" ng-model="dateRangePicker.date"
                            picker="dateRangePicker.picker" picker-classes="extra-class-names" min="'2014-02-23'"
                            max="dateRangePicker.maxDate" options="dateRangePicker.options" options="{locale: {separator: "
                            :"}}" />
                    </div>
                </div>
                <div class="col-xl-6 col-lg-6 col-md-6 col-sm-12 col-12">
                    <div class="form-group">
                        <label for="estadoMovimiento">Movimiento</label> 
                        <select name="estadoMovimiento" di="estadoMovimiento"  class="form form-control border-select"
                            ng-model="dataSearch.movement">
                            <option value="">Todos</option>
                            <option ng-value="item.codigo" ng-repeat="item in estadoMovimientos">
                                {{item.descripcion}}
                            </option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-4 col-md-4 col-sm-12 col-12">
            <div class="row justify-content-end mt-3">
                <div class="col-lg-6 col-md-6 col-sm-12"> 
                     <button type="button" class="btn btn-info" ng-click="searchKardex()">
                        <i class="ti-search"></i> Buscar
                    </button> 
                    <button type="button" class="btn btn-secondary" ng-click="getReport()">
                        <i class="mdi mdi-file"></i> Reporte
                    </button> 
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-12">
            <div id="table-kardex"></div>
            <span class="text-danger">* Haz click sobre la celda para ver el Documento</span>
        </div>

    </div>
</div>

<div class="modal-footer">
    <button class="btn btn-dark" ng-click="closeModal()">&times; Cerrar</button>
</div> 
