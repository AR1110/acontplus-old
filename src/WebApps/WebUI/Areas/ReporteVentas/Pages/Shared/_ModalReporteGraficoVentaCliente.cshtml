
<div id="ModalReporteGraficoVentaCliente" class="modal fade in" tabindex="-1" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Venta por Cliente</h5>
                <button class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <div class="row justify-content-between">
                    <div class="col-lg-4 col-md-4 col-sm-6 col-12">
                        <div class="icheck-info">
                            <input type="checkbox" ng-model="dataSearch.checkboxSucursalRG" id="checkboxSucursalRG" name="checkboxSucursalRG">
                            <label for="checkboxSucursalRG">Sucursal</label>
                        </div>

                    </div>
                    <div class="col-lg-4 col-md-4 col-sm-6 col-12" ng-if="dataSearch.checkboxSucursalRG">
                        <div class="icheck-info">
                            <input type="checkbox" ng-model="dataSearch.checkboxPtoEmisionRG" id="checkboxPtoEmisionRG" name="checkboxPtoEmisionRG">
                            <label for="checkboxPtoEmisionRG">Punto Emisión</label>
                        </div>
                    </div>

                    <div class="col-lg-4 col-md-4 col-sm-6 col-12">
                        <div class="icheck-info">
                            <input type="checkbox" ng-model="dataSearch.checkboxTipoDocRG" id="checkboxTipoDocRG" name="checkboxTipoDocRG">
                            <label for="checkboxTipoDocRG">Tipo Documento</label>
                        </div>
                    </div>
                </div>
                <hr>

                <div class="row">
                    <div class="col-xl-2 col-lg-2 col-md-2 col-sm-6 col-12">
                        <div class="form-group">
                            <label for="periodo">Periodo</label>
                            <select ng-model="dataSearch.byAnio" class="form-control">
                                <option ng-value="item.descripcion" ng-repeat="item in anios">{{item.descripcion}}</option>
                            </select>
                        </div>
                    </div> 
                    <div class="col-lg-10 col-md-10 col-sm-6 col-12">
                        @await Html.PartialAsync("~/Views/Cliente/_ClienteAutocompleteFiltro.cshtml")
                    </div>
                </div>

                <div class="row">   
                                       
                    <div class="col-xl-4 col-lg-4 col-md-4 col-sm-6 col-12" ng-if="dataSearch.checkboxSucursalRG">
                        <div class="form-group">
                            <label for="sucursal">Sucursal</label>
                            <select class="form-control border-select" ng-model="dataSearch.codEstab" ng-change="getAsignaciones()">
                                <option ng-value="item.codEstab" ng-repeat="item in sucursales">{{item.nombreComercial}}</option>
                            </select>
                        </div>
                    </div>

                    <div class="col-xl-4 col-lg-4 col-md-4 col-sm-6 col-12" ng-if="dataSearch.checkboxPtoEmisionRG">
                        <div class="form-group">
                            <label for="puntoEmision">Punto Emisión</label>
                            <select class="form-control border-select" ng-model="dataSearch.byPuntoEmisionRG">
                                <option ng-value="item.idPuntoEmision" ng-repeat="item in puntosEmisiones">{{item.ptoEmi}}</option>
                            </select>
                        </div>
                    </div>

                    <div class="col-xl-4 col-lg-4 col-md-4 col-sm-12 col-12" ng-if="dataSearch.checkboxTipoDocRG">
                        <div class="form-group">
                            <label for="sucursal">Tipo Documento</label>
                            <select ng-model="dataSearch.byTipoDocRG" class="form-control">
                                <option ng-value="item.codigo" ng-repeat="item in tipoDocumentos">{{item.descripcion}}</option>
                            </select>
                        </div>
                    </div>

                </div>

                


            </div>
            <div class="modal-footer">
                <button class="btn btn-primary-1" ng-click="getEstadisticaCliente()"><i class="fa fa-search"></i> Buscar</button>
                <button class="btn btn-dark" data-dismiss="modal">&times; Cerrar</button>
            </div>
        </div>
    </div>
</div>