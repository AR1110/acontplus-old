<div id="modalReporteConsumoCliente" class="modal fade in" role="dialog" tabindex="-1" data-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Reporte de Consumo Cliente</h5>
                <button class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <div class="row justify-content-between">
                    <div class="col-xl-3 col-lg-3 col-md-3 col-sm-6 col-12">
                        <div class="icheck-info">
                            <input type="checkbox" ng-model="dataSearch.checkboxSucursalFiltro" ng-change="onChangeSucursal()" name="checkboxSucursalFiltro" id="checkboxSucursalFiltro">
                            <label for="checkboxSucursalFiltro">Sucursal</label>
                        </div>
                    </div>
                    <div class="col-xl-3 col-lg-3 col-md-3 col-sm-6 col-12" ng-if="dataSearch.checkboxSucursalFiltro">
                        <div class="icheck-info">
                            <input type="checkbox" ng-model="dataSearch.checkboxPuntoEmisionFiltro" name="checkboxPuntoEmisionFiltro" id="checkboxPuntoEmisionFiltro">
                            <label for="checkboxPuntoEmisionFiltro">Punto Emisión</label>
                        </div>
                    </div>
                    <div class="col-xl-3 col-lg-3 col-md-3 col-sm-6 col-12">
                        <div class="icheck-info">
                            <input type="checkbox" ng-change="onChangeCheckboxTipoDocFiltro()" ng-model="dataSearch.checkboxTipoDocFiltro" name="checkboxTipoDocFiltro" id="checkboxTipoDocFiltro">
                            <label for="checkboxTipoDocFiltro">Tipo Documento</label>
                        </div>
                    </div>                    
                </div>  
                <hr/>
                <div class="row">
                    <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">
                        @await Html.PartialAsync("~/Views/Cliente/_ClienteAutocompleteFiltro.cshtml")
                    </div>
                </div>          
                <div class="row">                   
                    <div class="col-xl-6 col-lg-6 col-md-6 col-sm-6 col-12" ng-if="dataSearch.checkboxSucursalFiltro">
                        <div class="form-group">
                            <label for="sucursal">Sucursal</label>
                            <select class="form-control border-select" ng-model="dataSearch.codEstab" ng-change="getAsignaciones()">
                                <option ng-value="item.codEstab" ng-repeat="item in sucursales">{{item.nombreComercial}}</option>
                            </select>
                        </div>
                    </div>

                    <div class="col-xl-6 col-lg-6 col-md-6 col-sm-6 col-12" ng-if="dataSearch.checkboxPuntoEmisionFiltro">
                        <div class="form-group">
                            <label for="puntoEmision">Punto Emisión</label>
                            <select class="form-control border-select" ng-model="dataSearch.byPuntoEmision">
                                <option ng-value="item.idPuntoEmision" ng-repeat="item in puntosEmisiones">{{item.ptoEmi}}</option>
                            </select>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-xl-4 col-lg-4 col-md-4 col-sm-12 col-12">
                        <div class="form-group">
                            <label class="control-label">Mes: </label>
                            <select ng-model="mes" class="form-control" ng-change="getFechaInicioFinFilter()">
                                <option ng-value="m.numero" ng-repeat="m in meses">{{m.nombre}}</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-xl-4 col-lg-4 col-md-4 col-sm-12 col-12">
                        <div class="form-group">
                            <label>Fecha Inicio:</label>
                            <input type="date" class="form-control" ng-model="dataSearch.fechaInicio"/>
                        </div>
                    </div>
                    <div class="col-xl-4 col-lg-4 col-md-4 col-sm-12 col-12">
                        <div class="form-group">
                            <label>Fecha Fin:</label>
                            <input type="date" class="form-control" ng-model="dataSearch.fechaFin" />
                        </div>
                    </div>
                </div>

                <div class="row justify-content-between">
                    <div class="col-lg-3 col-md-3 col-sm-6 col-12" ng-if="dataSearch.checkboxTipoDocFiltro">
                        <div class="form-group">
                            <label for="tipoDoc">Tipo Documento</label>
                            <select class="form-control" ng-model="dataSearch.byTipoDoc">
                                <option ng-value="item.codigoDoc" ng-repeat="item in tipoDocs">{{item.descripcion}}</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-lg-3 col-md-3 col-sm-6 col-12">
                        <div class="form-group">
                            <label for="tipoDoc">Campo Ordenar</label>
                            <select class="form-control" ng-model="dataSearch.byOrderCampo">
                                <option value="fechaEmision">Fecha Emisión</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-lg-3 col-md-3 col-sm-6 col-12">                       
                        <div class="icheck-info mt-3">
                            <input type="radio" ng-model="dataSearch.byOrder" value='ASC' name="radioByOrder" id="byOrderAsc">
                            <label for="byOrderAsc">Ascendente</label>
                        </div>
                        <div class="icheck-info">
                            <input type="radio" ng-model="dataSearch.byOrder" value="DESC" name="radioByOrder" id="byOrderDesc">
                            <label for="byOrderDesc">Descendente</label>
                        </div>
                    </div>
                    <div class="col-lg-3 col-md-3 col-sm-6 col-12">
                        <div class="form-group">
                            <label for="tipoFormato">Tipo Formato</label>
                            <div class="icheck-info">
                                <input type="radio" ng-model="dataSearch.byTipoFormato" value="pdf" name="tipoFormato" id="pdf">
                                <label for="pdf">PDF</label>
                            </div>
                            <div class="icheck-info">
                                <input type="radio" ng-model="dataSearch.byTipoFormato" value="excel" name="tipoFormato" id="excel">
                                <label for="excel">EXCEL</label>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-lg-4 col-sm-4">
                        <div class="icheck-info">
                            <input type="checkbox" ng-model="dataSearch.showPrecioCosto" name="showPrecioCosto" id="showPrecioCosto">
                            <label for="showPrecioCosto">Mostrar Precio Costo</label>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-primary-1" ng-click="filtrar()"><i class="fa fa-search"></i> Buscar</button>
                <button class="btn btn-dark" data-dismiss="modal">&times; Buscar</button>
            </div>
        </div>
    </div>
</div>