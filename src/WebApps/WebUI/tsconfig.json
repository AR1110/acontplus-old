{
    "extends": "@tsconfig/svelte/tsconfig.json",

    "include": ["**/*"],
    "exclude": [
        "node_modules/*"
    ],

    "compilerOptions": {
        "target": "es2017",
        "module": "commonjs",
        "strict": false,
        "forceConsistentCasingInFileNames": true,
        "lib": [ "es2015", "dom" ],
        "baseUrl": ".",
        "paths": {
            "$lib/*": ["App/lib/*"],
            "$pet/*": ["App/lib/Pet/*"], 
            "$petbreed/*": ["App/lib/PetBreed/*"],
            "$petmedicalhistory/*": ["App/lib/PetMedicalHistory/*"],
        }
    }
}
