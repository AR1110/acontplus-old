{
    "extends": "@tsconfig/svelte/tsconfig.json",
    "include": [
        "**/*"
    ],
    "exclude": [
        "node_modules/*"
    ],
    "compilerOptions": {
        "target": "esnext",
        // "module": "CommonJS",
        "module": "ESNext",
        "strict": false,
        "forceConsistentCasingInFileNames": true,
        // "lib": [ "es2015", "dom" ],
        "lib": [
            "ES2020",
            "DOM",
            "DOM.Iterable"
        ],
        "baseUrl": ".",
        "paths": {
            "$lib/*": [
                "App/lib/*"
            ],
            "$pet/*": [
                "App/lib/Pet/*"
            ],
            "$petbreed/*": [
                "App/lib/PetBreed/*"
            ],
            "$petmedicalhistory/*": [
                "App/lib/PetMedicalHistory/*"
            ],
        }
    }
}