{
    "extends": "@tsconfig/svelte/tsconfig.json",
    "include": [
        "**/*"
    ],
    "exclude": [
        "node_modules/*"
    ],
    "compilerOptions": {
        "target": "esnext",
        "module": "ESNext",
        "strict": false,
        "forceConsistentCasingInFileNames": false,
        "noUnusedLocals": false,
        "noUnusedParameters": false,
        "lib": [
            "ESNext",
            "DOM",
            "DOM.Iterable"
        ],
        "baseUrl": ".",
    }
}