
<div class="modal-header">
    <h5 class="modal-title">{{tipoRegistro===1?'Nuevo':'Editar'}} Marca</h5>
    <button type="button" class="close" ng-click="closeModal()" aria-label="Close">
        <span aria-hidden="true">&times;</span>
    </button>
</div>
<div class="modal-body">
    <div class="row">
        <div class="form-group col-lg-12 col-md-12 col-sm-12 col-12">
            <label for="">Descripción: <span class="text-danger">*</span></label>
            <input type="text" ng-model="data.descripcion" touppercase class="form-control border-select" placeholder="Ej: HP">
        </div>
        <div class="form-group col-lg-6 col-md-6 col-sm-6 col-xs-6" ng-if="tipoRegistro==2 && showStatus">
            <label for="">Estado: </label>
            <md-radio-group ng-model="data.estado">
                <md-radio-button ng-value="true">Activo</md-radio-button>
                <md-radio-button ng-value="false">Inactivo</md-radio-button>
            </md-radio-group>
        </div>
    </div>

</div>
<div class="modal-footer">
    <button type="button" class="btn btn-success" ng-click="saveAndUpdate()">
        {{tipoRegistro===1?'Guardar':'Actualizar'}}
    </button>
    <button type="button" class="btn btn-dark" ng-click="closeModal()">&times; Cerrar</button>
</div>