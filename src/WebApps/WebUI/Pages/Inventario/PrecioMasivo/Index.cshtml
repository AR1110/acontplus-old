@page
@model WebUI.Pages.Inventario.PrecioMasivo.Index

@{
    ViewData["Title"] = "Index";
    
}
<style>

    #grid-articles .ui-grid-header-cell .ui-grid-cell-contents {
        text-align: center;
    }

    .modifiedCell {
        background-color: #FF9999 !important;
        color: #000 !important;
    }

    .printSelection {
        width: 600px;
        margin-top: 10px;
    }

    .highlight {
        background-color: #b3c4c7 !important;
    }
</style>
<div ng-controller="precioMasivoCtrl">
    <div class="row page-titles">
        <div class="col-md-5 align-self-center">
            <h4 class="text-themecolor">Actualización Masiva de Precios</h4>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <div class="row">
                <div class="col-xl-3 col-lg-3 col-md-4 col-sm-4 col-12">
                    <div class="form-group">
                        <label for="">Tarifas:</label>
                        <select name="ddlTarifa" id="ddlTarifa" class="form-control border-select" ng-model="mainForm.idTarifa"
                                ng-change="onChangeTarifa()">
                            <option ng-value="item.idTarifa" ng-repeat="item in tarifas track by $index">
                                {{item.descripcion}}
                            </option>
                        </select>
                    </div>
                </div>
                <div class="col-xl-3 col-lg-3 col-md-4 col-sm-4 col-12">
                    <div class="form-group">
                        <label for="codEstab">Opciones:</label>
                        <select name="codEstab" id="codEstab" class="form-control border-select" ng-model="mainForm.opcion" ng-chane="onChangeOpciones()">
                            <option ng-value="item.code" ng-repeat="item in catalogs">
                                {{item.description}}
                            </option>
                        </select>
                    </div>
                </div>

                <div class="col-xl-4 col-lg-4 col-md-6 col-12">
                    <!--Start Product-->
                    <div class="form-group" ng-if="mainForm.opcion == 1">
                        <label for="articuloFiltro">Articulo</label>
                        <input type="text"
                               ng-model="dataSearchProduct.name"
                               class="form-control border-select"
                               article-search-drtv
                               on-select="onSelectProduct(result)"
                               on-keyup-article="onKeyupProduct()"
                               placeholder="...">

                        <script type="text/ng-template" id="autocompleteArticleTemplate.html">
                            <div class="autocomplete-suggestion-uib-typeahead">
                                <span class="item-title">
                                    <small> {{match.model.descripcion}}</small><br>
                                    <small><b>Código: </b>{{match.model.codigo}}</small>
                                </span>
                            </div>
                        </script>
                    </div>
                    <!--End Product-->
                    <!--Start SubFamilia -->
                    <div class="form-group" ng-if="mainForm.opcion===3"> 
                        <label for="idSubFamilia">SubFamilias:</label>
                        <select name="idSubFamilia" id="idSubFamilia" class="form-control border-select"
                            ng-model="mainForm.idSubFamilia" ng-change="onChangeSubFamilia()">
                            <option ng-value="item.idSubFamilia" ng-repeat="item in subfamilias">
                                {{item.descripcion}}
                            </option>
                        </select> 
                    </div>
                    <!--End SubFamilia-->
                    <!--Start Proveedor -->
                    <div class="form-group" ng-if="mainForm.opcion==4">
                        <label for="proveedorFiltro">Proveedor:</label>
                        <input type="text" id="providerInputSearch" class="form-control border-select"
                               ng-model="dataSearchProveedor.name" provider-search-drtv
                               on-select="onSelectProveedor(result)" on-keyup="onKeyupProveedor()"
                               placeholder="Ingrese C.I o Nombre Comercial" onclick="select();">

                        <script type="text/ng-template" id="autocompleteProviderTemplate.html">
                            <div class="autocomplete-suggestion-uib-typeahead">
                                <span class="item-title"><b> {{match.model.numeroIdentificacion}}</b> - {{match.model.nombreFiscal}}</span>
                            </div>
                        </script>
                    </div>
                    <!--End Proveedor -->
                    <!--Start Nro Documento -->
                    <div class="form-group" ng-if="mainForm.opcion==5">
                        <label for="nroDocumento">N° de Documento:</label>
                        <input type="text" class="form-control border-select" id="nroDocumento" name="nroDocumento"
                               placeholder="000-000-000000000" onclick="this.select()" mask="999-999-999999999"
                               ng-blur="getArticles()" ng-model="mainForm.nroDocumento" required>
                    </div>
                    <!--End Nro Documento -->

                </div>

                <div class="col-xl-2 col-lg-2 col-md-6 col-12 d-flex justify-content-end">
                    <div class="align-self-center mt-lg-3 mt-md-3 mt-sm-0">
                        <button type="button" class="btn btn-info " ng-click="rollbackChanges()"><i class="fas fa-redo"></i> Recargar</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card" ng-show="articles.length > 0">
        <div class="card-body">
            <div class="row justify-content-between">
                <div class="col-xl-6 col-lg-6 col-md-6 col-12">
                    <div class="row">
                        <div class="col-xl-6 col-lg-6 col-md-6 col-12">
                            <div class="form-froup">
                                <label for="tipoIvaOrigen">Tipo Iva Inicial</label>
                                <select class="form-control border-select" id="tipoIvaOrigen" name="tipoIvaOrigen" ng-model="mainForm.idTipoIva" ng-change="onChangeTipoIvaInicial()">
                                    <option ng-value="item.idTipoIva" ng-repeat="item in tarifasImpuesto">
                                        {{item.descripcion}}
                                    </option>
                                </select>
                            </div>
                        </div>
                        <div class="col-xl-6 col-lg-6 col-md-6 col-12">
                            <div class="form-froup">
                                <label for="tipoIvaDestino">Tipo Iva Destino</label>
                                <select class="form-control border-select" 
                                id="tipoIvaDestino" 
                                name="tipoIvaDestino" 
                                ng-model="mainForm.idTipoIvaDestino"
                                ng-change="onChangeTipoIvaDestino()"
                                >
                                    <option ng-value="item.idTipoIva" ng-repeat="item in tarifasImpuestoDestino">
                                        {{item.descripcion}}
                                    </option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-xl-6 col-lg-6 col-md-6 col-12">
                     <div class="d-flex justify-content-end" ng-if="articlesToSave.length > 0">
                        <button type="button" class="btn btn-success btn-lg m-1" ng-click="save()">
                            <i class="fa fa-save"></i> Guardar Todo
                        </button>
                        <button class="btn btn-warning btn-lg   m-1" ng-click="refresh()">
                            <i class="fa fa-close"></i> Cancelar
                        </button>
                    </div>                
                </div>     
            </div> 

            <div class="row mt-1">
                <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">
                    <div ui-grid="gridOptions" ui-grid-edit ui-grid-auto-resize ui-grid-resize-columns ui-grid-cellNav
                         class="grid-articles"></div>
                </div>
            </div>
