        </div>
    </div>

</div>

@section Scripts{
    <script type="text/javascript" src="~/js/inventario/services/precioMasivoService.min.js" asp-append-version="true"></script>
    <script type="text/javascript" src="~/js/inventario/controllers/precioMasivoCtrl.min.js" asp-append-version="true"></script>
}