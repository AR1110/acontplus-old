@page
@model WebUI.Pages.Inventario.Consolidacion.IndexModel

@{
    ViewData["Title"] = "Index";

}

@* <div id="iframeApp" ng-controller="iframeAngularCtrl"></div> *@
<div ng-controller="consolidacionInvCtrl">

    <div class="row page-titles">
        <div class="col-lg-5 align-self-center">
            <h5 class="text-themecolor">Gestión de Consolidación Inventario</h5>
        </div>
        <div class="col-lg-7 align-self-center text-right">
            <div class="d-flex justify-content-end align-items-center">
                <button class="btn btn-info" ng-if="accion.crear" ng-click="openModalNew()"><i
                        class="fa fa-plus-circle"></i> Nuevo</button>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-body">
                    <div class="row">
                        <div class="col-xxl-6 col-xl-6 col-lg-6 col-md-6 col-sm-6 col-12">
                            <div class="row">
                                <div class="col-xxl-6 col-xl-6 col-lg-6 col-md-6 col-sm-12 col-12">
                                    <div class="form-group">
                                        <label for="tipoDoc">Tipo Documento: </label>
                                        <select name="tipoDoc" id="tipoDoc" ng-model="dataSearch.tipoDocId"
                                            class="form-control border-select" ng-change="refresh()">
                                            <option ng-value="0">Todos</option>
                                            <option ng-value="item.idTipoDocumento" ng-repeat="item in tiposDoc">
                                                {{item.descripcion}}
                                            </option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xxl-6 col-xl-6 col-lg-6 col-md-6 col-sm-12 col-12">
                                    <div class="form-group">
                                        <label for="">Rango fecha</label>
                                        <div class="input-group">

                                            <div class="input-group-prepend">
                                                <div class="input-group-text">
                                                    <div class="custom-control custom-checkbox mr-sm-2">
                                                        <input type="checkbox" ng-model="dataSearch.ckFecha"
                                                            class="custom-control-input" id="checkBoxFecha"
                                                            ng-change="refresh()">
                                                        <label class="custom-control-label" for="checkBoxFecha"></label>
                                                    </div>
                                                </div>
                                            </div>

                                            <date-range-filter current-date="dataSearch.fechaInicio"
                                                start-date="dataSearch.fechaInicio" end-date="dataSearch.fechaFin"
                                                result-range-date="resultRangeFilter(result)"></date-range-filter>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-xxl-6 col-xl-6 col-lg-6 col-md-6 col-sm-6 col-12">
                            <div class="row">
                                <div class="col-xxl-5 col-xl-5 col-lg-5 col-md-6 col-sm-6 col-12">
                                    <div class="form-group">
                                        <label for="nroDoc">Número documento</label>
                                        <input type="text" class="form-control border-select"
                                            ng-model="dataSearch.nroSecuencial" placeholder="Ej: 123 o 1-30">
                                    </div>
                                </div>
                                <div class="col-xxl-5 col-xl-5 col-lg-5 col-md-6 col-sm-6 col-12">
                                    <div class="form-group">
                                        <label for="observacion">Observación</label>
                                        <input type="text" class="form-control border-select"
                                            ng-model="dataSearch.textSearch" placeholder="...">
                                    </div>
                                </div>
                                <div
                                    class="col-xxl-2 col-xl-2 col-lg-2 col-md-6 col-sm-6 col-12 d-flex align-items-center ">
                                    <button type="button" class="btn btn-success btn-sm" ng-click="refresh()">
                                        <i class="fas fa-redo"></i>
                                    </button>
                                </div>
                            </div>
                        </div>

                    </div>



                    <md-table-container style="max-height: 350px;">
                        <table md-table>
                            <thead fix-head md-head>
                                <tr md-row>
                                    <th md-column>#</th>
                                    <th md-column>Op.</th>
                                    <th md-column>Documento</th>
                                    <th md-column>N°. Documento</th>
                                    <th md-column>Fecha Emisión</th>
                                    <th md-column>Observación</th>
                                    <th md-column>Usuario</th>
                                    <th md-column>Total</th>
                                    <th md-column>Estado</th>
                                </tr>
                            </thead>
                            <tbody md-body>
                                <tr md-row ng-repeat="item in consolidaciones" ng-class="item.rowStyle">
                                    <td md-cell>
                                        <md-menu>
                                            <md-button aria-label="Open demo menu" class="md-icon-button"
                                                ng-click="$mdMenu.open($event)">
                                                <i class="mdi mdi-menu"></i>
                                            </md-button>
                                            <md-menu-content class="md-dense">
                                                <md-menu-item>
                                                    <md-button ng-click="openModalDetalle(item)">
                                                        <span md-menu-align-target><i class="ti-menu"></i>
                                                            Detalle</span>
                                                    </md-button>
                                                </md-menu-item>



                                                <md-menu-item ng-if="accion.crear">
                                                    <md-button ng-click="openModalDuplicar(item)"
                                                        ng-disabled="item.anulada">
                                                        <span md-menu-align-target><i class="ti-file"></i>
                                                            Duplicar</span>
                                                    </md-button>
                                                </md-menu-item>


                                                <md-menu-item ng-if="accion.anular && canCancel(item)">
                                                    <md-button ng-click="askToDelete(item)">
                                                        <span md-menu-align-target><i class="ti-na"></i> Anular</span>
                                                    </md-button>
                                                </md-menu-item>

                                                <md-menu-item>
                                                    <md-button ng-click="getReport(item)">
                                                        <span md-menu-align-target><i class=" ti-file"></i> PDF</span>
                                                    </md-button>
                                                </md-menu-item>
                                            </md-menu-content>
                                        </md-menu>
                                    </td>
                                    <td md-cell>{{$index+1}}</td>
                                    <td md-cell>{{item.nombreTipoDoc}}</td>
                                    <td md-cell>{{item.nroDoc}}</td>
                                    <td md-cell>{{item.fechaEmision}}</td>
                                    <td md-cell>{{item.observacion}}</td>
                                    <td md-cell>{{item.nombreUsuario}}</td>
                                    <td md-cell>${{item.total}}</td>
                                    <td md-cell>{{item.nombreEstado}}</td>
                                </tr>
                                <tr class="text-center" ng-show="consolidaciones.length===0">
                                    <td colspan="9">No hay registros en esta Tabla</td>
                                </tr>
                            </tbody>
                            <tfoot md-foot>
                                <tr md-row>
                                    <td md-cell colspan="7"><strong>Total:</strong></td>
                                    <td md-cell>{{total}}</td>
                                    <td md-cell></td>
                                </tr>
                            </tfoot>
                        </table>
                    </md-table-container>
                </div>
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div class="p-2">
                            <select class="form-control border-select" ng-model="dataSearch.pageSize"
                                ng-change="changePageSize()" ng-options="ra for ra in recordsQuantity">
                            </select>
                        </div>
                        <ul uib-pagination total-items="dataSearch.totalRecords" items-Per-Page="dataSearch.pageSize"
                            ng-change="pageChanged()" ng-model="dataSearch.pageIndex" max-size="dataSearch.maxSize"
                            class="pagination" boundary-links="true" rotate="false"></ul>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>
@section Scripts {
    <script src="~/lib/xlsx/xlsx.full.min.js" asp-append-version="true"></script>
    <script src="~/js/restaurant/item.service.min.js" asp-append-version="true"></script>
    <script src="~/js/inventario/controllers/consolidacionInvCtrl.min.js" asp-append-version="true"></script>
}
