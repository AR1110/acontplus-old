@page
@model WebUI.Pages.Inventario.Medida.IndexModel
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div ng-controller="medidaCtrl" ng-cloak>

    <div class="row page-titles">
        <div class="col-md-5 align-self-center">
            <h4 class="text-themecolor">Gestión de Medidas</h4>
        </div>
        <div class="col-md-7 align-self-center text-right">
            <div class="d-flex justify-content-end align-items-center">
                @*<ol class="breadcrumb">
                        <li class="breadcrumb-item"><a href="javascript:void(0)">Inicio</a></li>
                        <li class="breadcrumb-item active">Medida</li>
                    </ol>*@
                <button type="button" ng-if="accion.crear" btn-add-update-medida results="resultModal(item)" class="btn btn-info d-sm-block m-l-15">
                    <i class="ti-plus"></i> Nuevo
                </button>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <div class="row">
                        <div class="col-xl-6 col-lg-6 col-md-12 col-sm-12 col-12">
                            <div class="d-flex justify-content-start">
                                <span class="form-group pull-left page-size form-inline">
                                    <select class="form-control control-color"
                                            ng-model="dataSearch.pageSize"
                                            ng-change="changePageSize()"
                                            ng-options="ra for ra in recordsQuantity">
                                    </select>
                                </span>

                                <span class="form-group pull-left page-size form-inline">
                                    <button type="button" class="btn btn-success m-l-5" ng-click="exportTableToExcel()">
                                        <i class="far fa-file-excel"></i> Exportar
                                    </button>
                                </span>

                            </div>
                        </div>
                        <div class="col-xl-6 col-lg-6 col-md-12 col-sm-12 col-12">
                            <div class="d-flex justify-content-end">
                                <form class="form-material">
                                    <input type="text" class="form-control" ng-model="buscar" placeholder="Buscar Medida" />
                                </form>
                            </div>
                        </div>
                    </div>


                    <div class="table-responsive">
                        <table class="table  table-no-bordered">
                            <thead>
                                <tr>
                                    <th ng-if="accion.editar || accion.eliminar">Op</th>
                                    <th>N°</th>
                                    <th>Descripcion</th>
                                    <th>codigo</th>
                                    <th>Estado</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="t in medidas | filter:buscar track by $index">
                                    <td ng-if="accion.editar || accion.eliminar">
                                        <button type="button" ng-if="accion.editar" class="btn btn-info btn-xs" btn-add-update-medida results="resultModal(item)" params="t"><i class="ti-pencil"></i></button>

                                        <button type="button" ng-if="accion.eliminar" class="btn btn-danger btn-xs" tooltip data-toggle="toggle" title="Eliminar" ng-click="delete(t)"><i class="ti-trash"></i></button>
                                    </td>
                                    <td>{{$index+1}}</td>
                                    <td>{{t.descripcion}}</td>
                                    <td>{{t.codigo}}</td>
                                    <td ng-bind-html="t.estado | estadoPrimario"></td>
                                </tr>
                                <tr class="text-center" ng-show="medidas.length==0">
                                    <td colspan="6">
                                        No existen registros disponibles en esta tabla;
                                    </td>
                                </tr>
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td align="center" colspan="6">
                                        <div class="pull-left">
                                            <ul uib-pagination total-items="totalRecords" items-Per-Page="dataSearch.pageSize" ng-change="pagechanged()" ng-model="dataSearch.pageIndex" max-size="maxSize" class="pagination" boundary-links="true" rotate="false"></ul>
                                        </div>
                                    </td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>


</div>
@section Scripts{
    <script src="~/lib/xlsx/xlsx.full.min.js" asp-append-version="true"></script>
    <script src="~/js/inventario/controllers/medidaCtrl.min.js" asp-append-version="true"></script>

}

