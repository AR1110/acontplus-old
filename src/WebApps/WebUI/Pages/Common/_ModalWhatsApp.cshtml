<div class="modal-header">
    <h5 class="modal-title"><i class="mdi mdi-whatsapp"></i> Envio de notificación por WhatsApp</h5>
    <button type="button" class="close" ng-click="closeModal()">&times;</button>
</div>
<div class="modal-body">
    <div class="row">
        <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">
            <div class="text-success" ng-if="current_device.device">
                Dispositivo Connectado
            </div>
            <p ng-if="current_device.device">
                ID del Dispositivo: <b class="text-info">{{current_device.device}}</b>
            </p>
            <p>
                <b class="text-success">{{comprobante}}</b>
            </p>
        </div>
    </div>
    <hr />
    <form ng-submit="sendMessage()">
        <div class="row">
            <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">
                <div class="form-group">
                    <label for="">Destinatario:</label>
                    <input type="tel" name="" id="" class="form-control" ng-if="!hasPhoneNumber"
                        ng-model="whatsapp.number" required>
                    <select name="" id="" class="form-control" ng-if="hasPhoneNumber" ng-model="whatsapp.number"
                        ng-change="addOtherNumber(whatsapp.number)" required>
                        <option ng-value="item.number" ng-repeat="item in phoneNumbers">{{item.number}}</option>
                        <option value="0">Otro Número</option>
                    </select>
                </div>
            </div>
        </div>
        <hr>
        <div class="row">
            <div class="col-xl-6 col-lg-6 col-md-6 col-sm-6 col-12">
                <button type="submit" class="btn btn-success">
                    <i class="mdi mdi-whatsapp"></i>
                    Enviar
                </button>
            </div>
        </div>

    </form>
</div>
<div class="modal-footer">
    <button type="button" class="btn btn-dark" ng-click="closeModal()">
        &times; Cerrar
    </button>
</div>
