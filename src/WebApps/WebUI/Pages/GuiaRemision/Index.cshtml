@page
@model WebUI.Pages.GuiaRemision.IndexModel 
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div ng-controller="guiaRemisionCtrl">
    <div>
        <div class="row page-titles">
            <div class="col-lg-5 align-self-center">
                <h5 class="color-themecolor">Gestión de Guía de Remisión</h5>
            </div>
            <div class="col-lg-7 align-self-center text-right">
                <div class="d-flex justify-content-end align-items-center">
                    <button type="button" class="btn btn-info m-l-15" ng-click="openModalNew()">
                        <i class="ti-plus"></i>
                        Nuevo
                    </button>
                </div>
            </div>
        </div>


        <div class="card">
            <div class="card-body">
                <div class="row">
                     <div class="col-xl-7 col-lg-7 col-md-6 col-sm-12 col-12">
                        <div class="row">
                            <div class="col-xl-6 col-lg-6 col-md-12 col-sm-12 col-12">
                        <div class="form-gorup">
                            <span for="establecimiento">Estab: <span class="text-danger">*</span></span>
                            <select name="establecimiento" id="establecimiento" ng-model="dataSearch.codEstab"
                                    class="form-control  border-select" ng-change="estabFilter()">
                                <option ng-value="item.codEstab" ng-repeat="item in establecimientos">
                                    {{item.nombreComercial}}
                                </option>
                            </select>
                        </div>
                    </div>
                    <div class="col-xl-6 col-lg-6 col-md-12 col-sm-12 col-12">
                        <span for="date-range-filter">Rango Fechas: </span>
                            <div class="input-group">
                                <div class="input-group-prepend">
                                    <div class="input-group-text">
                                        <div class="custom-control custom-checkbox mr-sm-2">
                                            <input type="checkbox" 
                                                ng-model="dataSearch.checkBoxDate"
                                                   ng-disabled="!(dataSearch.byCliente>0)"
                                                class="custom-control-input" 
                                                id="checkBoxDate">
                                            <label class="custom-control-label" for="checkBoxDate"></label>
                                        </div>
                                    </div>
                                </div>

                                <date-range-filter current-date="dataSearch.fechaInicio"
                                                   start-date="dataSearch.fechaInicio" end-date="dataSearch.fechaFin"
                                                   result-range-date="resultRangeFilter(result)"></date-range-filter>
                            </div>
                    </div>
                        </div>

                     </div>
                     <div class="col-xl-5 col-lg-5 col-md-6 col-sm-12 col-12">
                        <div class="row">
                            <div class="col-xl-9 col-lg-9 col-md-12 col-sm-12 col-12">
                        <div class="form-group">
                            <span for="clienteFiltro">Cliente</span>
                            <input type="text" id="clienteSearchFiltro" autocomplete="off" name="clienteSearchFiltro"
                                   class="form-control border-select" placeholder="Ingrese C.I o Nombre Fiscal"
                                   ng-model="modelTextSearch" typeahead-wait-ms="10"
                                   ng-keyup="onKeyupClienteSearchFiltro()"
                                   uib-typeahead="a as a.nombreFiscal for a in clienteSearch($viewValue)"
                                   typeahead-loading="clienteFiltro.loading" typeahead-no-results="clienteFiltro.noResults"
                                   typeahead-template-url="clienteSearchFiltro.html" typeahead-editable="false"
                                   typeahead-on-select="selectedClienteSearchFiltro($item)" onClick="select();" />

                            <script type="text/ng-template" id="clienteSearchFiltro.html">
                                <div class="autocomplete-suggestion-uib-typeahead">
                                    <span class="item-title">
                                        <b> {{match.model.numeroIdentificacion}}</b> - {{match.model.nombreFiscal}}
                                    </span>
                                </div>
                            </script>
                        </div>
                    </div>
                    <div class="col-xl-2 col-lg-2 col-md-6 col-sm-12 col-12">
                        <div class="btn-group btn-group-sm mt-4" role="group" aria-label="Basic example">
                                <button type="button" class="btn btn-info" ng-click="onClickBtnMore()">
                                    <i class="fas fa-eye" uib-tooltip="Más opciones"></i>
                                </button>
                                <button type="button" class="btn btn-success" uib-tooltip="Recargar"
                                        ng-click="getGuiasRemision()">
                                    <i class="fas fa-redo"></i>
                                </button>
                            </div>
                    </div>
                        </div>
                     </div>                    
                </div>

                <div class="row justify-content-between" ng-if="moreSearchOptions">
                      <div class="col-xl-2 col-lg-2 col-md-12 col-sm-12 col-12">
                    <div class="form-gorup">
                        <span for="ptoEmision">Pto. Emisión: <span class="text-danger">*</span> </span>
                        <select name="ptoEmision" id="ptoEmision" ng-model="dataSearch.idPuntoEmision"
                                class="form-control  border-select" ng-change="getGuiasRemision()">
                            <option ng-value="item.idPuntoEmision" ng-repeat="item in puntosEmision">
                                {{item.ptoEmi}}
                            </option>
                        </select>
                    </div>
                </div>
                    <div class="col-xl-3 col-lg-3 col-md-12 col-sm-12 col-12">
                        <div class="form-group">
                            <span for="usuario">Usuario</span>
                            <input type="text" class="form-control border-select" ng-model="nombreCompleto"
                                   ng-keyup="onKeyupUsuarioSearch()"
                                   uib-typeahead="u as u.nombreCompleto for u in usuarioSearch($viewValue)"
                                   typeahead-editable="false" placeholder="Buscar Usuario" autocomplete="off"
                                   typeahead-template-url="usuarioSearchTemplate.html"
                                   typeahead-no-results="usuarioSearch.noResults"
                                   typeahead-on-select="selectedUsuarioSearch($item)">

                            <script type="text/ng-template" id="usuarioSearchTemplate.html">
                                <div class="autocomplete-suggestion-uib-typeahead">
                                    <span class="item-title">
                                        {{match.model.nombreCompleto}}
                                    </span>
                                </div>
                            </script>
                        </div>
                    </div>

                    <div class="col-xl-2 col-lg-2 col-md-6 col-sm-12 col-12">
                    <div class="form-group">
                        <span>Buscar por Nro. Doc.:</span>
                        <input type="text" class="form-control border-select" ng-model="dataSearch.nroSecuencial" 
                               placeholder="Ej: 123 o 1-30" />
                    </div>
                </div>

                     <div class="col-xl-2 col-lg-2 col-md-12 col-sm-12 col-12">
                        <div class="form-group">
                            <span>Estado:</span>
                            <select id="estadoDocumentos" class="form-control" ng-model="dataSearch.codEstado"
                                    ng-change="getGuiasRemision()">
                                <option value="">Todos</option>
                                <option ng-value="item.codigo" ng-repeat="item in estadosDocumento">
                                    {{item.descripcion}}
                                </option>
                            </select>
                        </div>
                    </div>
                    <div class="col-xl-3">
                        <div class="form-group">
                            <span>Buscar</span>
                            <input type="text" class="form-control border-select" ng-change="searchFilterLocal()"
                                   ng-model="dataSearch.bySearch" placeholder="Ej: 001-002">
                        </div>
                    </div>
                </div>

                <md-table-container style=" max-height: 400px;">
                    <table resize master md-table>
                        <thead md-trim-column-names fix-head md-head>
                            <tr md-row>
                                <th md-column
                                    ng-if="accion.editar || accion.anular || accion.reporte || accion.enviarSri || accion.enviarCorreo">
                                    Op.
                                </th>
                                <th md-column>F. Emisión</th>
                                <th md-column>Nro</th>
                                <th md-column>F. Inicio</th>
                                <th md-column>F. Fin</th>
                                <th md-column>Cliente</th>
                                <th md-column>Factura</th>
                                <th md-column>Estado</th>
                                <th md-column>Transportista</th>
                                <th md-column>Usuario</th>
                            </tr>
                        </thead>
                        <tbody md-body>
                            <tr md-row ng-repeat="item in guiasRemision" ng-class="item.style">
                                <td md-cell
                                    ng-if="accion.editar || accion.anular || accion.reporte || accion.enviarSri || accion.enviarCorreo">
                                    <md-menu>
                                        <md-button aria-label="Open demo menu" class="md-icon-button"
                                                   ng-click="$mdMenu.open($event)">
                                            <icon class="mdi mdi-menu"></icon>
                                        </md-button>
                                        <md-menu-content class="md-dense">
                                            <md-menu-item>
                                                <md-button ng-click="openModalDetalle(item)">
                                                    <span md-menu-align-target>
                                                        <i class="ti-menu"></i>
                                                        Detalle
                                                    </span>
                                                </md-button>
                                            </md-menu-item>

                                            <md-menu-item ng-if="accion.editar">
                                                <md-button ng-click="openModalEdit(item)"
                                                           ng-disabled="item.anulada || item.autorizada">
                                                    <span md-menu-align-target>
                                                        <i class="ti-pencil"></i>
                                                        Editar
                                                    </span>
                                                </md-button>
                                            </md-menu-item>

                                            <md-menu-item ng-if="accion.anular">
                                                <md-button ng-click="askToDelete(item)" ng-disabled="item.anulada">
                                                    <span md-menu-align-target>
                                                        <i class="ti-close"></i>
                                                        Anular
                                                    </span>
                                                </md-button>
                                            </md-menu-item>
                                            <md-menu-item ng-if="accion.reporte">
                                                <md-button ng-click="getReport(item)">
                                                    <span md-menu-align-target>
                                                        <i class=" ti-file"></i>
                                                        PDF
                                                    </span>
                                                </md-button>
                                            </md-menu-item>

                                        </md-menu-content>
                                    </md-menu>
                                </td>
                                <td md-cell>{{item.fechaEmision}}</td>
                                <td md-cell>{{item.nroDoc}}</td>
                                <td md-cell>{{item.fechaInicio}}</td>
                                <td md-cell>{{item.fechaFin}}</td>
                                <td md-cell>{{item.cliente}}</td>
                                <td md-cell>{{item.nroFactura}}</td>
                                <td md-cell>{{item.estadoSri}}</td>
                                <td md-cell>{{item.transportista}}</td>
                                <td md-cell>{{item.usuario}}</td>
                            </tr>
                        </tbody>
                    </table>
                </md-table-container>

            </div>
        </div>
    </div>
</div>

@section Scripts {
        <script src="~/js/logistica/services/logisticaService.js" asp-append-version="true"></script>
    @* <script src="~/js/controllers/logistica/guiaRemisionCtrl.js" asp-append-version="true"></script> *@
        <script src="~/js/logistica/controllers/guiaRemisionCtrl.min.js" asp-append-version="true"></script>
}
