 
    <div class="modal-header">
        <h4 class="modal-title">{{modalTitle}}</h4>
        <button class="close" ng-click="closeModal()">&times;</button>
    </div>

    <div class="modal-body">
        <div class="form-group">
            <label class="d-flex justify-content-between">
                Tipo Identificación
                <!-- <div class="custom-control custom-checkbox align-items-end">
                    <input type="checkbox" class="custom-control-input" id="checkbox0" value="check">
                    <label class="custom-control-label" for="checkbox0">Consultar a SRI</label>
                </div> -->
            </label>
            <div class="input-group">
                <div class="input-group-prepend">
                    <select class="form-control" ng-model="data.idTipoIdentificacion" > 
                        <option ng-value="item.idTipoIdentificacion" ng-repeat="item in tiposIdentificacion">{{item.descripcion}}</option> 
                    </select>
                </div>
                <input 
                
                type="text" 
                class="form-control border-select" 
                id="numeroIdentificacion"
                ng-model="data.numeroIdentificacion" 
                tooltip-placement="top"
                uib-tooltip="Ingrese número identificación y dale 'Enter' para buscar en el SRI"
                ng-enter="onEnterNumeroIdentificacion()"
                />
                 
            </div>
        </div>
 

        <div class="form-group">
            <label  >Razon Social <span class="text-danger">*</span></label>
            <input type="text" name="" ng-model="data.razonSocial" ng-keyup="copiarRazonSocial()"
                class="form-control border-select" touppercase id="">
        </div>

        <div class="form-group">
            <label  >Nombre Comercial <span class="text-danger">*</span></label>
            <input type="text"   ng-model="data.nombreComercial" class="form-control border-select"  >
        </div>

         <div class="form-group">
            <label  >Dirección <span class="text-danger">*</span></label>
            <textarea  rows="2" cols="50" ng-model="data.direccion" class="form-control border-select" > 
            </textarea>
        </div>


        <div class="form-group">
            <label>Email:
                <span tooltip-placement="top"
                    uib-tooltip="Haz doble 'Click' sobre el correo para editar">
                    <i class="fas fa-info-circle"></i>
                </span>
            </label>
            <md-chips ng-model="correos" md-add-on-blur="true" ng-keyup="onKeyupEmail($event)"
                md-transform-chip="transformChipEmail($chip)" md-removable="true"
                md-enable-chip-edit="true" placeholder="Ej: maxi@gmail.com"
                input-aria-label="Correos" tabindex="-1"></md-chips>
            <small></small>
        </div>


        <div class="form-group">
            <label>Telefono:
                <span tooltip-placement="top"
                    uib-tooltip="Haz doble 'Click' sobre el número de telefono para editar">
                    <i class="fas fa-info-circle"></i>
                </span>
            </label>
            <md-chips ng-model="telefonos" md-add-on-blur="true"
                md-transform-chip="transformChipTelefono($chip)" md-removable="true"
                md-enable-chip-edit="true" placeholder="Ej: 0959889744"
                input-aria-label="Número de teléfonos" tabindex="-1"></md-chips>
        </div>


    </div>

    <div class="modal-footer">
        <button type="button" class="btn btn-success" ng-click="save()">
            {{btnText}}
        </button>
        <button type="button" class="btn btn-dark" ng-click="closeModal()">&times; Cerrar</button>
    </div> 