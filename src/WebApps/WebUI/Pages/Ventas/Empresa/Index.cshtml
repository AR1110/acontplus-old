@page
@model WebUI.Pages.Ventas.Empresa.Index
@{
    ViewData["Title"] = "Index";
}

<div ng-controller="empresaCtrl as $ctrl">
    <div class="row page-titles">
        <div class="col-md-5 align-self-center">
            <h4 class="text-themecolor">Gestión de Empresa</h4>
        </div>
        <div class="col-md-7 align-self-center text-right">
            <div class="d-flex justify-content-end align-items-center">
                <button type="button" btn-empresa result-modal="resultModal(result)" class="btn btn-info  m-l-15">
                    <i class="fa fa-plus-circle"></i> Nuevo
                </button>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-body">

            <div class="d-flex justify-content-between">
                <div>
                    <span class="form-group pull-left page-size form-inline">
                        <select class="form-control control-color" ng-model="dataSearch.pageSize"
                                ng-change="changePageSize()" ng-options="ra for ra in recordsQuantity">
                        </select>
                    </span>
                </div>
                <div>
                    <button type="button" class="btn btn-secondary btn-sm" ng-click="refresh()">
                        <i class="fas fa-refresh"></i>
                    </button>
                </div>
            </div>

            <md-table-container>
                <table md-table>
                    <thead md-head>
                        <tr md-row>
                            <th md-column>N°</th>
                            <th md-column></th>
                            <th md-column>Ruc</th>
                            <th md-column>Razon Social</th>
                            <th md-column>Nombre Comercial</th>
                            <th md-column>Estado</th>
                        </tr>
                    </thead>
                    <tbody md-body>
                        <tr md-row ng-repeat="item in empresas | filter: txtFilter">
                            <td md-cell>{{$index+1}}</td>
                            <td md-cell>
                                <div class="justify-content-center">
                                    <a href="javascript:void(0)" ng-if="accion.editar" btn-empresa
                                       result-modal="resultModal(result)" params="item"
                                       class="btn btn-info btn-xs"><i class="ti-pencil"></i></a>
                                    <a href="javascript:void(0)" ng-if="accion.eliminar"
                                       ng-click="askToDelete(item)" class="btn btn-danger btn-xs">
                                        <i class="ti-trash"></i>
                                    </a>
                                </div>
                            </td>
                            <td md-cell>{{item.ruc}}</td>
                            <td md-cell>{{item.razonSocial}}</td>
                            <td md-cell>{{item.nombreComercial}}</td>
                            <td md-cell ng-bind-html="item.estado | estadoPrimario"></td>

                        </tr>

                    </tbody>
                </table>
            </md-table-container>
            <div class="card-body">
                <ul uib-pagination total-items="dataSearch.totalRecords" items-Per-Page="dataSearch.pageSize"
                    ng-change="pagechanged()" ng-model="dataSearch.pageIndex" max-size="dataSearch.maxSize"
                    class="pagination" boundary-links="true" rotate="false">
                </ul>
            </div>

        </div>
    </div>


</div>

@section Scripts{
    <script src="~/js/ventas/controllers/empresaCtrl.min.js" asp-append-version="true"></script>
}

