@page
@model WebUI.Pages.ReporteTributario.IndexModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div ng-controller="reporteVentaCtrl">
    <div class="row page-titles">
        <div class="col-md-5 align-self-center">
            <h4 class="text-themecolor"></h4>
        </div>
        <div class="col-md-7 align-self-center text-right">
            <div class="d-flex justify-content-end align-items-center">
            </div>
        </div>
    </div>

    <form autocomplete="off">
    <div class="card">
        <div class="card-body">
            <div class="row">
                <div class="col-lg-3 col-md-3 col-sm-12 col-12">
                    <div class="form-group">
                        <span>Tipo Documento: </span>
                        <select class="form-control border-select" 
                        ng-model="dataSearch.idTipoDocumento"
                        ng-change="onChangeTipoDoc()"
                        >
                            <option ng-value="item.idTipoDocumento" ng-repeat="item in tiposDoc">
                                {{item.descripcion}}
                            </option>
                        </select>
                    </div>
                </div>
                <div class="col-lg-3 col-md-3 col-sm-12 col-12">
                    <div class="form-group">
                        <span>Establecimiento:</span>
                        <select class="form-control border-select" 
                        ng-model="dataSearch.idEstablecimiento"
                        ng-change="onChangeEstab()"
                        >
                            <option ng-value="0">Todos</option>
                            <option ng-value="item.idEstablecimiento" ng-repeat="item in establecimientos">
                                {{item.nombreComercial}}
                            </option>
                        </select>
                    </div>
                </div>
                <div class="col-lg-3 col-md-3 col-sm-12 col-12">
                    <div class="form-group">
                        <span>Punto Emisión</span>
                        <select class="form-control border-select" ng-model="dataSearch.idPuntoEmision">
                            <option ng-value="0">Todos</option>
                            <option ng-value="item.idPuntoEmision" ng-repeat="item in puntosEmision">
                                {{item.ptoEmi}}
                            </option>
                        </select>
                    </div>
                </div>
                @* <div class="col-lg-3 col-md-3 col-sm-12 col-12">
                    <div class="form-group">
                        <span>Tipo Cliente</span>
                        <select class="form-control border-select">
                            <option></option>
                        </select>
                    </div>
                </div> *@
            </div>
            <div class="row">
                <div class="col-lg-3 col-md-3 col-sm-12 col-12">
                    <span for="date-range-filter">Rango Fechas: </span>
                    @* <div class="input-group">
                        <div class="input-group-prepend">
                            <div class="input-group-text">
                                <div class="custom-control custom-checkbox mr-sm-2">
                                    <input type="checkbox" ng-model="dataSearch.checkBoxFecha"
                                           ng-disabled="!(dataSearch.idCliente>0)" class="custom-control-input"
                                           id="checkBoxFecha">
                                    <label class="custom-control-label" for="checkBoxFecha"></label>
                                </div>
                            </div>
                        </div> *@

                        <date-range-filter current-date="dataSearch.fechaInicio"
                                           start-date="dataSearch.fechaInicio" end-date="dataSearch.fechaFin"
                                           result-range-date="resultRangeFilter(result)"></date-range-filter>
                    @* </div> *@
                </div>
                <div class="col-lg-3 col-md-3 col-sm-12 col-12">
                    <div class="form-group">
                        <span>Estado</span>
                        <select class="form-control border-select" ng-model="dataSearch.idEstadoDocumento">
                            <option ng-value="0">Todos</option>
                            <option ng-value="item.idEstadoDocumento" ng-repeat="item in estadosDoc">
                                {{item.descripcion}}
                            </option>
                        </select>
                    </div>
                </div>
                <div class="col-lg-3 col-md-3 col-sm-12 col-12" ng-if="showField">
                    <div class="form-group">
                        <span>Retencion</span>
                        <select class="form-control border-select" ng-model="dataSearch.codeRetencion">                            
                            <option ng-value="item.code" ng-repeat="item in retenciones">
                                {{item.descripcion}}
                            </option>
                        </select>
                    </div>
                </div>
                <div class="col-lg-3 col-md-3 col-sm-12 col-12" ng-if="showField">
                    <div class="form-group">
                        <span>Devolución</span>
                        <select class="form-control border-select" ng-model="dataSearch.codeDevolucion"> 
                            <option ng-value="item.code" ng-repeat="item in devoluciones">
                                {{item.descripcion}}
                            </option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="row"> 
                <div class="col-xl-4 col-lg-4 col-md-12 col-sm-12 col-12">
                    <span for="date-range-filter">Cliente: </span>
                    <div class="input-group">
                        <div class="input-group-prepend"> 
                                <div class="icheck-primary">
    <input type="checkbox" id="checkBoxCustomer" ng-model="dataSearch.checkBoxCustomer" name="checkBoxCustomerName" />
    <label for="checkBoxCustomer"></label> 
                            </div>
                        </div>

                        <input type="text" id="customerInputSearch" class="form-control border-select"
                        ng-model="cliente.nombreCliente" cliente-search-drtv
                        on-select="onSelectCliente(result)" on-keyup-cliente="onKeyupCliente()"
                        placeholder="Ingrese C.I o Nombre Comercial" onclick="select();">

                    <script type="text/ng-template" id="autocompleteClienteTemplate.html">
                        <div class="autocomplete-suggestion-uib-typeahead">
                            <span class="item-title"><b> {{match.model.numeroIdentificacion}}</b> - {{match.model.nombreFiscal}}</span>
                        </div>
                    </script>
                    </div>
                </div> 
                <div class="col-xl-4 col-lg-4 col-md-12 col-sm-12 col-12">
                    <span for="date-range-filter">Usuario: </span>
                    <div class="input-group">
                        <div class="input-group-prepend"> 
                                <div class="icheck-primary">
    <input type="checkbox" id="checkBoxCustomer" ng-model="dataSearch.checkBoxUser" name="checkBoxUserName" />
    <label for="checkBoxUser"></label> 
                            </div>
                        </div>

                        <input type="text" id="userInputSearch" class="form-control border-select"
                        ng-model="user.nombreUser" user-search-drtv
                        on-select="onSelectUser(result)" on-keyup="onKeyupUser()"
                        placeholder="..." onclick="select();">

                    <script type="text/ng-template" id="autocompleteUserTemplate.html">
                        <div class="autocomplete-suggestion-uib-typeahead">
                            <span class="item-title"><b> {{match.model.nroIdentificacion}}</b> - {{match.model.nombreCompleto}}</span>
                        </div>
                    </script>
                    </div>
                </div> 
            </div>
        </div>
        <div class="card-footer">
            <button type="button" class="btn btn-success" ng-click="getReportPDF()">PDF</button>
            <button type="button" class="btn btn-info" ng-click="getReportEXCEL()">EXCEL</button>
        </div>
    </div> 
</form>
    @section Scripts {
            <script src="~/js/factElect/services/reporteFactElectService.js" asp-append-version="true"></script>
            <script src="~/js/factElect/controllers/reporteFactElectCtrl.min.js" asp-append-version="true"></script>
    }


</div>