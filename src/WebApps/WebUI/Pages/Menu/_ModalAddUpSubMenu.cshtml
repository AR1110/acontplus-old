<form ng-submit="onSave()" autocomplete="off" novalidate>
    <div class="modal-content">
        <div class="modal-header">
            <h5 class="modal-title"><i class="mdi mdi-menu"></i> {{titleModal}} Sub Menú</h5>
            <button type="button" class="close" ng-click="closeModal()">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
        <div class="modal-body">
            <h5 class="box-title">Menú</h5>
            <hr class="m-t-0">
            <div class="row">
                <div class="col-lg-6 col-md-6 col-sm-6 col-12">
                    <div class="form-group">
                        <input type="text" ng-value="menu.descripcion " class="form-control" placeholder="Descripción"
                            disabled />
                    </div>
                </div>
                <div class="col-lg-6 col-md-6 col-sm-6 col-12">
                    <div class="form-group">
                        <input type="text" ng-value="menu.grupo" class="form-control" placeholder="Grupo" disabled />
                    </div>
                </div>
            </div>

            <h5 class="box-title">Sub Menu</h5>
            <hr class="m-t-0">
            <div class="row">
                <div class="col-lg-12 col-md-12 col-sm-12 col-12">
                    <div class="form-group">
                        <label for="descripcionSubMenu">Descripción <span class="text-danger">*</span></label>
                        <input type="text" ng-model="data.descripcion" ng-keyup="obtenerCodigoSubMenu()"
                            class="form-control border-select" placeholder="Descripcion">
                    </div>
                </div>

                <div class="col-lg-12 col-md-12 col-sm-12 col-12">
                    <div class="form-group">
                        <label for="descripcionSubMenu">Código <span class="text-danger">*</span></label>
                        <input type="text" ng-model="data.codTemp" touppercase ng-disabled="data.idSubMenu>0"
                            class="form-control border-select" placeholder="Código">
                    </div>
                </div>

                <div class="col-lg-12 col-md-12 col-sm-12 col-12">
                    <div class="form-group">
                        <label for="urlMenu">Url <span class="text-danger">*</span></label>
                        <input type="text" ng-model="data.url" class="form-control border-select"
                            placeholder="/Usuario/Index">
                    </div>
                </div>

                <div class="col-lg-12 col-md-12 col-sm-12 col-12">
                    <div class="form-group">
                        <label for="descripcionSubMenu">Icono</label>
                        <input type="text" class="form-control border-select" ng-model="data.icono"
                            placeholder="fa fa-home">
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-lg-12 col-md-12 col-sm-12 col-12" ng-show="showEstado">
                    <label for="">Estado: </label>
                    <md-radio-group ng-model="data.estado">
                        <md-radio-button ng-value="true">Activo</md-radio-button>
                        <md-radio-button ng-value="false">Inactivo</md-radio-button>
                    </md-radio-group>
                </div>
            </div>
        </div>
        <div class="modal-footer">
            <button type="submit" class="btn btn-success"><i class="{{btnIcon}}"></i>
                {{btnText}}</button>
            <button type="button" class="btn btn-dark" ng-click="closeModal()">&times; Cerrar</button>
        </div>
    </div>
</form>