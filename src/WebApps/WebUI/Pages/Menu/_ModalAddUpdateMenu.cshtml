<form ng-submit="onSave()" autocomplete="off" novalidate>
    <div class="modal-content">
        <div class="modal-header">
            <h5 class="modal-title">{{titleModal}} Menú</h5>
            <button type="button" class="close" ng-click="closeModal()">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
        <div class="modal-body">
            <div class="row">
                <div class="col-lg-12 colmd-12 col-sm-12 col-12">
                    <div class="form-group">
                        <label for="grupo">Grupo <span class="text-danger">*</span></label>
                        <input type="text" ng-disabled="tipoRegistro==2" touppercase ng-model="data.grupo "
                            class="form-control border-select" placeholder="Ej: A" maxlength="20">
                    </div>
                </div>

                <div class="col-lg-12 colmd-12 col-sm-12 col-12">
                    <div class="form-group">
                        <label for="descripcion">Descripcion <span class="text-danger">*</span></label>
                        <input type="text" ng-model="data.descripcion" class="form-control border-select"
                            placeholder="Ej: Administración" maxlength="30">
                    </div>
                </div>

                <div class="col-lg-12 colmd-12 col-sm-12 col-12">
                    <div class="form-group">
                        <label for="grupo">Icono <span class="text-danger">*</span></label>
                        <input type="text" ng-model="data.icono" class="form-control border-select"
                            placeholder="fa fa-home o mdi mdi-home" maxlength="50">
                    </div>
                </div>
            </div>

            <div ng-show="showEstado">
                <label for="">Estado: </label>
                <md-radio-group ng-model="data.estado">
                    <md-radio-button ng-value="true">Activo</md-radio-button>
                    <md-radio-button ng-value="false">Inactivo</md-radio-button>
                </md-radio-group>
            </div>
        </div>
        <div class="modal-footer">
            <button type="submit" class="btn btn-info"><i class="{{btnIcon}}"></i>
                {{btnText}}</button>
            <button type="button" class="btn btn-dark" ng-click="closeModal()"> &times; Cerrar</button>
        </div>
    </div>
</form>