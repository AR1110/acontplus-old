<!--Se usa en Filtro Factura Venta-->
<input type="text" class="form-control border-select" ng-model="$ctrl.usuarioSearch.nombreCompleto"
                ng-keyup="$ctrl.onKeyupUsuarioSearch()"
                uib-typeahead="u as u.nombreCompleto for u in $ctrl.searchUsuario($viewValue)"
                typeahead-editable="false" placeholder="Buscar Usuario" autocomplete="off"
                typeahead-template-url="usuarioSearchTemplate.html"
                typeahead-no-results="$ctrl.usuarioSearch.noResults"
                typeahead-on-select="$ctrl.selectedUsuarioSearch($item)">

                <script type="text/ng-template" id="usuarioSearchTemplate.html">
                    <div class="autocomplete-suggestion-uib-typeahead">
                        <span class="item-title">
                            {{match.model.nombreCompleto}}</b>
                        </span>
                    </div>
                </script>
                
                <span class="ml-5" ng-if="$ctrl.usuarioSearch.loading"> <i class="fas fa-sync-alt fa-xs"></i> Loading...</span>
                <small class="text-danger ml-5" ng-if="$ctrl.usuarioSearch.noResults">No se encontraron resultados</small>