@page
@model WebUI.Pages.FacturaCompra.IndexModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div ng-controller="facturaCompraCtrl">
    <div class="row page-titles">
        <div class="col-md-5 align-self-center">
            <h4 class="text-themecolor"> Factura Física</h4>
        </div>
        <div class="col-md-7 align-self-center text-right">
            <div class="d-flex justify-content-end align-items-center">
                @* <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/Home/Index">Inicio</a></li>
                <li class="breadcrumb-item"><a href="javascript:void(0)">Compras </a></li>
                <li class="breadcrumb-item active">Factura de Compra</li>
                </ol> *@
                <button type="button" class="btn btn-info m-l-15" ng-if="accion.leer && accion.crear"
                    ng-click="openModalNew()"><i class="fa fa-plus-circle"></i> Nuevo</button>
                @* <button class="btn btn-danger" ng-click="openModalTestNew()">Test New</button> *@
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <div class="row">
                <div class="col-xl-3 col-lg-3 col-md-6 col-sm-12 col-12">
                    <div class="form-gorup">
                        <span for="establecimiento">Establecimiento</span>
                        <select name="establecimiento" id="establecimiento" ng-model="dataSearch.codEstab"
                            class="form-control  border-select" ng-change="getFacturas()">
                            <option ng-value="item.codEstab" ng-repeat="item in establecimientos">
                                {{item.nombreComercial}}
                            </option>
                        </select>
                    </div>
                </div>
                <div class="col-xl-3 col-lg-3 col-md-6 col-sm-12 col-12">
                    <span for="date-range-filter">Rango Fechas: </span>
                    <div class="input-group">
                        <div class="input-group-prepend">
                            <div class="input-group-text">
                                <div class="custom-control custom-checkbox mr-sm-2">
                                    <input type="checkbox" ng-model="dataSearch.checkBoxFecha"
                                        class="custom-control-input" id="checkBoxFecha">
                                    <label class="custom-control-label" for="checkBoxFecha"></label>
                                </div>
                            </div>
                        </div>

                        <date-range-filter current-date="dataSearch.fechaInicio" start-date="dataSearch.fechaInicio"
                            end-date="dataSearch.fechaFin"
                            result-range-date="resultRangeFilter(result)"></date-range-filter>
                    </div>
                </div>
                <div class="col-xl-4 col-lg-4 col-md-6 col-sm-12 col-12">
                    <div class="form-group">
                        <span for="proveedorFiltro">Proveedor:</span>
                        <input type="text" id="providerInputSearch" class="form-control border-select"
                            ng-model="proveedor.nombreProveedor" provider-search-drtv
                            on-select="onSelectProveedor(result)" on-keyup="onKeyupProveedor()"
                            placeholder="Ingrese C.I o Nombre Comercial" onclick="select();">

                        <script type="text/ng-template" id="autocompleteProviderTemplate.html">
                            <div class="autocomplete-suggestion-uib-typeahead">
                                <span class="item-title"><b> {{match.model.numeroIdentificacion}}</b> - {{match.model.nombreFiscal}}</span>
                            </div>
                        </script>
                    </div>
                </div>
                <div class="col-xl-2 col-lg-2 col-md-6 col-sm-12 col-12">
                    <div class="card">
                        <div class="card-body">
                            <button type="button" class="btn btn-info btn-sm" data-toggle="button" data-more="#sh"
                                aria-pressed="false" ng-click="onClickBtnMore()">
                                <span class="text">
                                    <i class="mdi mdi-eye" aria-hidden="true" uib-tooltip="Más opciones"></i>
                                </span>
                                <span class="text-active">
                                    <i class="mdi mdi-eye-off" aria-hidden="true" uib-tooltip="Ocultar opciones"></i>
                                </span>
                            </button>
                            <button type="button" class="btn btn-success btn-sm" ng-click="getFacturas()"
                                uib-tooltip="Recargar">
                                <i class="mdi mdi-refresh"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row" ng-if="moreSearchOptions">
                <div class="col-xl-3 col-lg-3 col-md-6 col-sm-12 col-12">
                    <div class="form-group">
                        <span for="usuarioFiltro">Usuario</span>
                        <input type="text" id="customerInputSearchUser" class="form-control border-select"
                            ng-model="searchUser.nombreCompleto" user-search-drtv on-select="onSelectUser(result)"
                            on-keyup="onKeyupUser()" placeholder="..." onclick="select();">

                        <script type="text/ng-template" id="autocompleteUserTemplate.html">
                            <div class="autocomplete-suggestion-uib-typeahead">
                                <span class="item-title"><b> {{match.model.nroIdentificacion}}</b> - {{match.model.nombreCompleto}}</span>
                            </div>
                        </script>
                    </div>
                </div>
                <div class="col-xl-3 col-lg-3 col-md-6 col-sm-12 col-12">
                    <div class="form-group">
                        <span>Estado:</span>
                        <select class="form-control border-select" ng-model="dataSearch.codEstadoDoc" ng-change="getFacturas()">
                            <option value="">Todos</option>
                            <option ng-value="item.codigo" ng-repeat="item in estadosDoc">
                                {{item.descripcion}}
                            </option>
                        </select>
                    </div>
                </div>
                @* <div class="col-xl-4 col-lg-4 col-md-6 col-sm-12 col-12">
                <div class="form-group">
                <span>Nro. Documento</span>
                <input type="text" class="form-control border-select" ng-model="dataSearch.nroSecuencial"
                placeholder="Ej: 23">
                </div>
                </div> *@
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <div class="row">
                <div class="col-6 d-flex justify-content-start">
                    <span class="form-group pull-left page-size form-inline">
                        <select class="form-control control-color border-select" ng-model="dataSearch.pageSize"
                            ng-change="changePageSize()" ng-options="ra for ra in recordsQuantity">
                        </select>
                    </span>
                </div>

                <div class="col-6 d-flex justify-content-end">
                    <form class="form-material">
                        <input type="text" class="form-control" ng-keyup="filterLocal()" ng-model="dataSearch.textSearch"
                            placeholder="Buscar">
                    </form>
                </div>
            </div>
            <div id="upperScroll" style="overflow-x:scroll; overflow-y: hidden; max-height:20px; width:100%">
                <div name="innerScroll" ng-style="duelScroll" style="height:20px;"></div>
            </div>
            <div ng-style="getStyle($index)">
                <md-table-container name="wireTable" infinite-scroll="loadMore($index)" infinite-scroll-distance="1"
                    infinite-scroll-parent="true" ng-init="isShow=true" ng-show="isShow"
                    style=" max-height: 400px; overflow-x: hidden;">
                    <table resize master md-table name="innerWireTable">
                        <thead fix-head md-head md-on-reorder="facturaCompras">
                            <tr md-row>
                                <th md-column>Op.</th>
                                @* <th md-column>N°</th> *@
                                <th md-column>N°. Doc. </th>
                                <th md-column>F. Emisión</th>
                                <th md-column>F. Vcto</th>
                                <th md-column>Proveedor</th>
                                <th md-column>Total</th>
                                <th md-column>Abono</th>
                                <th md-column>Saldo</th>
                                <th md-column>N°. Ret.</th>
                                <th md-column>Estado</th>
                                <th md-column>Usuario</th>
                            </tr>
                        </thead>
                        <tbody md-body>
                            <tr md-row ng-repeat="f in facturas" ng-class="f.style">
                                <td md-cell>
                                    <md-menu>
                                        <md-button aria-label="Open demo menu" class="md-icon-button"
                                            ng-click="$mdMenu.open($event)">
                                            <icon class="mdi mdi-menu"></icon>
                                        </md-button>
                                        <md-menu-content class="md-dense">
                                            <md-menu-item>
                                                <md-button ng-click="openModalDetalle(f)">
                                                    <span md-menu-align-target><i class="ti-menu"></i>
                                                        Detalle</span>
                                                </md-button>
                                            </md-menu-item>

                                            <md-menu-item ng-if="accion.editar">
                                                <md-button ng-click="openModalEditar(f)">
                                                    <span md-menu-align-target><i class="ti-pencil"></i>
                                                        Editar</span>
                                                </md-button>
                                            </md-menu-item>

                                            <md-menu-item ng-if="accion.eliminar">
                                                <md-button ng-click="askToDelete(f)">
                                                    <span md-menu-align-target><i class="ti-trash"></i>
                                                        Eliminar</span>
                                                </md-button>
                                            </md-menu-item>

                                            <md-menu-item ng-if="accion.reporte">
                                                <md-button ng-click="getReport(f)">
                                                    <span md-menu-align-target>
                                                        <icon class=" ti-file"></icon> PDF
                                                    </span>
                                                </md-button>
                                            </md-menu-item>
                                        </md-menu-content>
                                    </md-menu>
                                </td>
                                <td md-cell>{{f.nroDocumento}}</td>
                                <td md-cell>{{f.fechaEmision}}</td>
                                <td md-cell>{{f.fechaVencimiento}}</td>
                                <td md-cell>{{f.proveedor}}</td>
                                <td md-cell>${{f.total}}</td>
                                <td md-cell>${{f.abono}}</td>
                                <td md-cell>${{f.saldo}}</td>
                                <td md-cell>{{f.nroRetencion}}</td>
                                <td md-cell>{{f.estadoFinanciero}}</td>
                                <td md-cell>{{f.usuario}}</td>
                            </tr>
                            <tr ng-show="facturas.length ==0" class="text-center">
                                <td colspan="11">
                                    No hay registros en esta tabla :)
                                </td>
                            </tr>
                        </tbody>
                        <tfoot md-foot fix>
                            <tr md-row>
                                <td md-cell colspan="1"><span class="font-weight-bold">{{facturas.length}}
                                        Facturas</span></td>
                                <td md-cell colspan="4"><span class="font-weight-bold">Total</span></td>
                                <td md-cell><span class="font-weight-bold">{{total}}</span></td>
                                <td md-cell colspan="5"></td>
                            </tr>
                        </tfoot>
                    </table>
                </md-table-container>
            </div>
        </div>
        <div class="card-body">
            <ul uib-pagination total-items="dataSearch.totalRecords" items-Per-Page="dataSearch.pageSize"
                ng-change="pagechanged()" ng-model="dataSearch.pageIndex" max-size="dataSearch.maxSize"
                class="pagination" boundary-links="true" rotate="false"></ul>
        </div>
    </div>

</div>


@section Scripts {
    @* <script src="~/js/services/storageService.min.js" asp-append-version="true"></script> *@
    @* <script src="~/js/compras/services/facturaCompraService.js" asp-append-version="true"></script> *@
    @* <script src="~/js/common/components/mdAutocompleteProveedor.min.js" asp-append-version="true"></script> *@
    <script src="~/js/common/services/gridOptionsService.js" asp-append-version="true"></script>
    <script src="~/js/compras/controllers/facturaCompraCtrl.min.js" asp-append-version="true"></script>
}
