@page
@model WebUI.Pages.Contabilidad.Cheque.Index

@{
    ViewData["title"] = "Cheques";
    
}

<div ng-controller="chequeCtrl">
    <div class="row page-titles">
        <div class="col-md-5 align-self-center">
            <h4 class="text-themecolor">Cheques</h4>
        </div>
        <div class="col-md-7 align-self-center text-right">
            <div class="d-flex justify-content-end align-items-center"> 
            </div>
        </div>
    </div>  
    <div class="card">  
        <div class="card-body"> 
             <div class="row">
                <div class="col-xl-4 col-lg-4 col-md-6 col-sm-12 col-12">
                    <span for="establecimiento">Establecimiento: </span>
                    <select class="form-control select-border" name="establecimiento" id="establecimiento" ng-model="dataSearch.idEstablecimiento" ng-change="refresh()">
                        <option ng-value="item.idEstablecimiento" ng-repeat="item in establecimientos">
                            {{item.nombreComercial}}
                        </option>
                    </select>
                </div>
                <div class="col-xl-4 col-lg-4 col-md-12 col-sm-12 col-12">
                    <span for="date-range-filter">Rango Fechas: </span>
                    <div class="input-group">
                        <div class="input-group-prepend">
                            <div class="input-group-text">
                                <div class="custom-control custom-checkbox mr-sm-2">
                                    <input type="checkbox" ng-model="dataSearch.checkBoxDate" ng-change="refresh()" class="custom-control-input"
                                        id="checkBoxDate">
                                    <label class="custom-control-label" for="checkBoxDate"></label>
                                </div>
                            </div>
                        </div>

                        <date-range-filter current-date="dataSearch.dateStart"
                            start-date="dataSearch.dateStart" end-date="dataSearch.dateEnd"
                            result-range-date="resultRangeFilter(result)"></date-range-filter>
                    </div>
                </div>
                <div class="col-xl-2 col-lg-2 col-md-12 col-sm-12 col-12">
                    <div class="form-group">
                        <span>Estado: </span>
                        <select class="form-control border-select" ng-model="dataSearch.byEstado" ng-change="refresh()">
                            <option value="">Todos</option>
                            <option ng-value="1">Activos</option>
                            <option ng-value="0">Anulados</option>                            
                        </select>
                    </div>
                </div>
                <div class="col-xl-2 col-lg-2 col-md-6 col-sm-12 col-12">
                    <div class="btn-group btn-group-sm mt-4" role="group" aria-label="Basic example">
                        <button type="button" class="btn btn-info" ng-click="onClickBtnMore()">
                            <i class="fas fa-eye" uib-tooltip="Más opciones"></i>
                        </button>
                        <button type="button" class="btn btn-success" uib-tooltip="Recargar"
                            ng-click="refresh()">
                            <i class="fas fa-redo"></i>
                        </button>
                    </div>
                </div>
            </div>

            <div class="row" ng-if="moreSearchOptions">
                <div class="col-xl-3 col-lg-3 col-md-6 col-12 col-sm-12">
                    <div class="form-group">
                        <span for="tipos">Tipo: </span>
                        <select class="form-control border-select" ng-model="dataSearch.tipo">
                            <option ng-value="item.id" ng-repeat="item in tipos">{{item.descripcion}}</option>                                   
                        </select>
                    </div>          
                </div>
                <div class="col-xl-4 col-lg-4 col-md-6 col-12 col-sm-12">
                    <div class="form-group" ng-show="dataSearch.tipo===1">
                        <span for="proveedorFiltro">Proveedor:</span>
                        <input type="text" id="providerInputSearch" class="form-control border-select"
                            ng-model="proveedor.nombreProveedor" provider-search-drtv
                            on-select="onSelectProveedor(result)" on-keyup="onKeyupProveedor()"
                            placeholder="Ingrese C.I o Nombre Comercial" onclick="select();">

                        <script type="text/ng-template" id="autocompleteProviderTemplate.html">
                            <div class="autocomplete-suggestion-uib-typeahead">
                                <span class="item-title"><b> {{match.model.numeroIdentificacion}}</b> - {{match.model.nombreFiscal}}</span>
                            </div>
                        </script>
                    </div>
                    <div class="form-group" ng-show="dataSearch.tipo===2">
                        <span for="clienteFiltro">Cliente</span>
                        <input type="text" id="customerInputSearch" class="form-control border-select"
                            ng-model="cliente.nombreCliente" cliente-search-drtv
                            on-select="onSelectCliente(result)" on-keyup-cliente="onKeyupCliente()"
                            placeholder="Ingrese C.I o Nombre Comercial" onclick="select();">

                        <script type="text/ng-template" id="autocompleteClienteTemplate.html">
                            <div class="autocomplete-suggestion-uib-typeahead">
                                <span class="item-title"><b> {{match.model.numeroIdentificacion}}</b> - {{match.model.nombreFiscal}}</span>
                            </div>
                        </script>
                    </div>
                </div>

                <!-- <div class="col-xl-3 col-lg-3 col-md-6 col-sm-12 col-12">
                    <div class="form-group">
                        <span for="usuarioFiltro">Usuario</span>
                        <input type="text" id="customerInputSearchUser" class="form-control border-select"
                            ng-model="searchUser.nombreCompleto" user-search-drtv on-select="onSelectUser(result)"
                            on-keyup="onKeyupUser()" placeholder="..." onclick="select();">

                        <script type="text/ng-template" id="autocompleteUserTemplate.html">
                            <div class="autocomplete-suggestion-uib-typeahead">
                                <span class="item-title"><b> {{match.model.nroIdentificacion}}</b> - {{match.model.nombreCompleto}}</span>
                            </div>
                        </script>
                    </div>
                </div> -->
                <div class="col-xl-2 col-lg-2 col-md-6 col-12 col-sm-12">
                    <div class="form-group">
                        <span for="tipos">Posfechado: </span>
                        <select class="form-control border-select" ng-model="dataSearch.posfechado" ng-change="refresh()">
                            <option value="">Todos</option>                                   
                            <option ng-value="true">Posfechados</option>                                   
                            <option ng-value="false">No Posfechados</option>                                   
                        </select>
                    </div>          
                </div>
            </div>

            <div class="row">
                <div class="col-6 d-flex justify-content-start">
                    <span class="form-group pull-left page-size form-inline">
                        <select class="form-control control-color" ng-model="dataSearch.pageSize"
                            ng-change="changePageSize()" ng-options="ra for ra in recordsQuantity">
                        </select>
                    </span>
                </div>

                <div class="col-6 d-flex justify-content-end">
                    <!-- <form class="form-material">
                        <div class="form-group">
                            <input type="text" class="form-control border-select" ng-change="searchFilterLocal()"
                                ng-model="dataSearch.bySearch" placeholder="...">
                        </div>
                    </form> -->
                </div>
            </div>

            <md-table-container style="max-height:400px;">
                <table md-table>
                    <thead md-head fix-head>
                        <tr md-row>
                            <th md-column >Nro.</th>                
                            <th md-column >Op.</th>                
                            <th md-column >Tipo Doc.</th>                
                            <th md-column>Nro. Doc</th>
                            <th md-column>F. Emisión</th> 
                            <th md-column>Persona</th>
                            <th md-column>Posfechado</th>                
                            <th md-column>Nro</th> 
                            <th md-column>Valor</th>                  
                        </tr>     
                    </thead>
                    <tbody md-body>
                        <tr md-row ng-repeat="item in cheques" class="{{item.color}}">
                            <td md-cell>{{$index+1}}</td>
                            <td md-cell  >
                                <div class="dropdown h-2">
                                    <button class="btn btn-default " type="button" id="dropdownMenu" data-toggle="dropdown" data-boundary="viewport" aria-haspopup="true" aria-expanded="false">
                                        <i class="fa fa-bars"></i>
                                    </button>
                                    <div class="dropdown-menu"  aria-labelledby="dropdownMenu">
                                        <button 
                                            class="dropdown-item" 
                                            type="button" 
                                            
                                            ng-click="askToSaveCheck(item)">
                                            <i class="ti-save"></i>  
                                            {{item.cobro?'Cobrar': 'Pagar'}}

                                        </button>

                                        <button 
                                        class="dropdown-item" 
                                        type="button" 
                                        ng-if="accion.anular" 
                                        ng-click="askToAnnulCheck(item)"
                                            tooltip data-toggle="tooltip" 
                                            title="Anular Cobro Cheque">
                                            <i class="mdi mdi-block-helper"></i> Anular
                                            </button>   

                                        <button 
                                        class="dropdown-item" 
                                        type="button" 
                                        ng-if="accion.reporte" 
                                        ng-click="getReport(item)" 
                                        tooltip data-toggle="tooltip" 
                                        title="Reporte PDF"
                                        >
                                        <i class="fa fa-file-pdf"></i> 
                                        PDF
                                        </button>                            
                                    </div>
                                </div>                       
                            </td>                
                            <td md-cell>{{item.codDoc}}</td>  
                            <td md-cell>{{item.nroDocumento}}</td>  
                            <td md-cell> {{item.fechaEmision}}</td>  
                            <td md-cell>{{item.persona}}</td>  
                            <td md-cell>{{item.posfechadoName}}</td>                                                                                                                                                                                                     
                            <td md-cell>{{item.nro}}</td>                                  
                            <td md-cell>${{item.valor}}</td> 
                        </tr>
                        <tr md-row ng-show="cheques.length===0" class="text-center">
                            <td md-cell colspan="9">
                                No hay registros en esta tabla :)
                            </td>
                        </tr>
                    </tbody> 
                </table>
            </md-table-container>
        </div>
         <div class="card-body">
            <ul uib-pagination total-items="dataSearch.totalRecords" items-Per-Page="dataSearch.pageSize"
                ng-change="pagechanged()" ng-model="dataSearch.pageIndex" max-size="dataSearch.maxSize"
                class="pagination" boundary-links="true" rotate="false"></ul>
        </div>
    </div>
</div>

@section Scripts{        
    <script src="~/js/contabilidad/services/chequeService.min.js" asp-append-version="true"></script>
    <script src="~/js/contabilidad/controllers/chequeCtrl.min.js" asp-append-version="true"></script>
}