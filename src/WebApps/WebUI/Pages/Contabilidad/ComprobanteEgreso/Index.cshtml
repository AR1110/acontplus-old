@page
@model WebUI.Pages.Contabilidad.ComprobanteEgreso.Index

@{
    ViewData["title"] = "Comprobante Egresos";
    
}

<div ng-controller="comprobanteEgresoCtrl">
    <div class="row page-titles">
        <div class="col-md-5 align-self-center">
            <h4 class="text-themecolor">Comprobante de Egresos</h4>
        </div>
        <div class="col-md-7 align-self-center text-right">
            <div class="d-flex justify-content-end align-items-center"> 
            </div>
        </div>
    </div> 



    <div class="card">
        <div class="card-body">
            <div class="row">
                <div class="col-xl-4 col-lg-4 col-md-6 col-sm-12 col-12">
                    <span for="establecimiento">Establecimiento: </span>
                    <select class="form-control select-border" name="establecimiento" id="establecimiento" ng-model="dataSearch.codEstab" ng-change="refresh()">
                        <option ng-value="item.codEstab" ng-repeat="item in establecimientos">
                            {{item.nombreComercial}}
                        </option>
                    </select>
                </div>
                <div class="col-xl-4 col-lg-4 col-md-12 col-sm-12 col-12">
                    <span for="date-range-filter">Rango Fechas: </span>
                    <div class="input-group">
                        <div class="input-group-prepend">
                            <div class="input-group-text">
                                <div class="custom-control custom-checkbox mr-sm-2">
                                    <input type="checkbox" ng-model="dataSearch.checkBoxFecha"  class="custom-control-input"
                                        id="checkBoxFecha">
                                    <label class="custom-control-label" for="checkBoxFecha"></label>
                                </div>
                            </div>
                        </div>

                        <date-range-filter current-date="dataSearch.fechaInicio"
                            start-date="dataSearch.fechaInicio" end-date="dataSearch.fechaFin"
                            result-range-date="resultRangeFilter(result)"></date-range-filter>
                    </div>
                </div>
                <div class="col-xl-2 col-lg-2 col-md-12 col-sm-12 col-12">
                    <div class="form-group">
                        <span>Estado: </span>
                        <select class="form-control border-select" ng-model="dataSearch.byEstado" ng-change="refresh()">
                            <option value="">Todos</option>
                            <option ng-value="1">Activos</option>
                            <option ng-value="0">Anulados</option>                            
                        </select>
                    </div>
                </div>
                <div class="col-xl-2 col-lg-2 col-md-6 col-sm-12 col-12">
                    <div class="btn-group btn-group-sm mt-4" role="group" aria-label="Basic example">
                        <button type="button" class="btn btn-info" ng-click="onClickBtnMore()">
                            <i class="fas fa-eye" uib-tooltip="Más opciones"></i>
                        </button>
                        <button type="button" class="btn btn-success" uib-tooltip="Recargar"
                            ng-click="refresh()">
                            <i class="fas fa-redo"></i>
                        </button>
                    </div>
                </div>
            </div>

            <div class="row" ng-if="moreSearchOptions">
                <div class="col-xl-3 col-lg-3 col-md-6 col-12 col-sm-12">
                    <div class="form-group">
                        <span for="tipoPersona">Persona (Proveedor/Empleado)</span>
                        <select class="form-control border-select" ng-model="dataSearch.byTipoPersona">
                            <option value="">Todos</option>
                            <option ng-value="1">Proveedor</option>
                            <option ng-value="2">Empleado</option>
                        </select>
                    </div>
                </div>
                <div class="col-xl-4 col-lg-4 col-md-6 col-12 col-sm-12">
                    <div class="form-group" ng-show="dataSearch.byTipoPersona===1">
                        <span for="proveedorFiltro">Proveedor:</span>
                        <input type="text" id="providerInputSearch" class="form-control border-select"
                            ng-model="proveedor.nombreProveedor" provider-search-drtv
                            on-select="onSelectProveedor(result)" on-keyup="onKeyupProveedor()"
                            placeholder="Ingrese C.I o Nombre Comercial" onclick="select();">

                        <script type="text/ng-template" id="autocompleteProviderTemplate.html">
                            <div class="autocomplete-suggestion-uib-typeahead">
                                <span class="item-title"><b> {{match.model.numeroIdentificacion}}</b> - {{match.model.nombreFiscal}}</span>
                            </div>
                        </script>
                    </div>
                    <div class="form-group" ng-show="dataSearch.byTipoPersona===2">
                        <span>Empleado</span>
                        <input type="text" id="customerInputSearchEmpleado"
                            class="form-control border-select" ng-model="searchEmpleado.nombreCompleto"
                            empleado-search-drtv on-select="onSelectEmpleado(result)"
                            on-keyup="onKeyupEmpleado()" placeholder="..." onclick="select();"
                            ng-disabled="disabledTempInputPersona">

                        <script type="text/ng-template" id="autocompleteEmpleadoTemplate.html">
                            <div class="autocomplete-suggestion-uib-typeahead">
                                <span class="item-title"><b> {{match.model.nroIdentificacion}}</b> - {{match.model.nombreCompleto}}</span>
                            </div>
                        </script>
                    </div>
                </div>

                <div class="col-xl-3 col-lg-3 col-md-6 col-sm-12 col-12">
                    <div class="form-group">
                        <span for="usuarioFiltro">Usuario</span>
                        <input type="text" id="customerInputSearchUser" class="form-control border-select"
                            ng-model="searchUser.nombreCompleto" user-search-drtv on-select="onSelectUser(result)"
                            on-keyup="onKeyupUser()" placeholder="..." onclick="select();">

                        <script type="text/ng-template" id="autocompleteUserTemplate.html">
                            <div class="autocomplete-suggestion-uib-typeahead">
                                <span class="item-title"><b> {{match.model.nroIdentificacion}}</b> - {{match.model.nombreCompleto}}</span>
                            </div>
                        </script>
                    </div>
                </div>
            </div>
        </div>
    
    </div>
    <div class="card">  
        <div class="card-body"> 
            <div class="row">
                <div class="col-6 d-flex justify-content-start">
                    <span class="form-group pull-left page-size form-inline">
                        <select class="form-control control-color" ng-model="dataSearch.pageSize"
                            ng-change="changePageSize()" ng-options="ra for ra in recordsQuantity">
                        </select>
                    </span>
                </div>

                <div class="col-6 d-flex justify-content-end">
                    <!-- <form class="form-material">
                        <div class="form-group">
                            <input type="text" class="form-control border-select" ng-change="searchFilterLocal()"
                                ng-model="dataSearch.bySearch" placeholder="...">
                        </div>
                    </form> -->
                </div>
            </div>

            <md-table-container style="max-height: 400px;">
                <table md-table>
                    <thead fix-head md-head md-order="dataSearch.order" md-on-reorder="comprobantesEgreso">
                        <tr md-row>
                            <th md-column ng-if="accion.historialFinanciero || accion.eliminar || accion.reporte">Op.
                            </th>
                            <th md-column>N°</th>
                            <th md-column>N°. Doc. </th>
                            <th md-column>F. Emision</th>
                            <th md-column>Proveedor</th>
                            <th md-column>Total</th>
                            <th md-column>Estado</th>
                            <th md-column>Usuario</th>
                        </tr>
                    </thead>
                    <tbody md-body>
                        <tr md-row ng-repeat="item in comprobantesEgreso | orderBy: dataSearch.order" ng-class="item.color">
                            <td md-cell ng-if="accion.historialFinanciero || accion.eliminar || accion.reporte">
                                <div class="dropdown h-2">
                                    <button class="btn btn-default " type="button" id="dropdownMenu"
                                        data-toggle="dropdown" data-boundary="viewport" aria-haspopup="true"
                                        aria-expanded="false">
                                        <i class="fa fa-bars"></i>
                                    </button>
                                    <div class="dropdown-menu" aria-labelledby="dropdownMenu">
                                        <button class="dropdown-item" type="button" ng-if="accion.historialFinanciero"
                                            ng-click="openModalHistorialPago(item)"><i class="ti-menu"></i>
                                            Detalle</button>
                                        <button class="dropdown-item" type="button" ng-if="accion.eliminar"
                                            ng-click="askToCancel(item)">&times; Anular</button>
                                        <button class="dropdown-item" type="button" ng-if="accion.reporte"
                                            ng-click="getReport(item)"><i class="fa fa-file-pdf"></i> PDF</button>

                                        <button class="dropdown-item" type="button" ng-if="accion.enviarCorreo"
                                            btn-send-to-email params="item" type-send="typeSend"
                                            get-param-to-send-mail="getParamToSendMail(params)"> <i
                                                class="far fa-envelope"></i>
                                            Enviar Correo</button>  
                                    </div>
                                </div>
                            </td>
                            <td md-cell>{{$index+1}}</td>
                            <td md-cell>{{item.nroDoc}}</td>
                            <td md-cell>{{item.fechaRegistro}}</td>
                            <td md-cell>{{item.persona|uppercase}}</td>
                            <td md-cell>${{item.total}}</td>
                            <td md-cell>{{item.estado}}</td>
                            <td md-cell>{{item.usuario}}</td>
                        </tr>
                        <tr ng-if="comprobantesEgreso.length===0" class="text-center">
                            <td colspan="9">No hay registro.</td>
                        </tr>
                    </tbody>
                    <tfoot>
                        <tr>
                            <td></td>
                        </tr>
                    </tfoot>
                </table>
            </md-table-container>
        </div>
         <div class="card-body">
            <ul uib-pagination total-items="dataSearch.totalRecords" items-Per-Page="dataSearch.pageSize"
                ng-change="pagechanged()" ng-model="dataSearch.pageIndex" max-size="dataSearch.maxSize"
                class="pagination" boundary-links="true" rotate="false"></ul>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/contabilidad/controllers/comprobanteEgresoCtrl.js" asp-append-version="true"></script>

}