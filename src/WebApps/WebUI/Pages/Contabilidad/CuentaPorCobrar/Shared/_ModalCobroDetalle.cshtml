<div class="modal-header">
    <h5 class="modal-title">Historial de Movimientos de Cobro</h5>
    <button type="button" class="close" ng-click="closeModal()">
        &times;
    </button>
</div>
<div class="modal-body">
    <div class="table-responsive">
        <table class="table table-hover   table-sm">
            <tbody>
                <tr>
                    <td><b>Serie Comprobante</b></td>
                    <td>{{codDoc}}-{{comprobante.serieComprobante}}</td>
                </tr>
                <tr>
                    <td><b>Identificación Comprador</b></td>
                    <td>{{comprobante.numeroIdentificacion}}</td>
                </tr>
                <tr>
                    <td><b>Nombre Comprador</b></td>
                    <td>{{comprobante.nombreFiscal}}</td>
                </tr>
                <tr>
                    <td><b>Fecha Emisión</b></td>
                    <td>{{comprobante.fechaEmision}}</td>
                </tr>
                <tr>
                    <td><b>Total</b></td>
                    <td>{{comprobante.importeTotal}}</td>
                </tr>
                <tr>
                    <td><b>Abono</b></td>
                    <td>{{ comprobante.abono }}</td>
                </tr>
                <tr>
                    <td><b>Saldo</b></td>
                    <td>{{ comprobante.saldo }}</td>
                </tr>
            </tbody>
        </table>
    </div>

    <div ng-if="showDetalleCompIngreso">



        <md-table-container>
            <table md-table>
                <thead md-head>
                    <tr md-row>
                        <th md-column></th>
                        <th md-column>N°</th>
                        <th md-column>Fecha Emisión</th>
                        <th md-column>Sub Entidad</th>
                        <th md-column>Valor</th>
                        <th md-column>Posfechado</th>
                        <th md-column>Estado</th>
                    </tr>
                </thead>
                <tbody md-body>
                    <tr md-row ng-repeat-start="item in cobros">
                        <td md-cell>
                            <div class="d-flex flex-column">

                                <i ng-if="!item.showDetalle" ng-click="expandDetalle(item)"
                                    class=" fas fa-arrow-right "></i>
                                <i ng-if="item.showDetalle" ng-click="expandDetalle(item)"
                                    class=" fas fa-arrow-down"></i>

                                <i ng-if="item.showInfoCobro" ng-click="showInfo(item)"
                                    class="ml-2 fas fa-info-circle text-info"></i>

                                <button type="button" ng-if="accion.anularComprobanteIngresoDoc && item.status"
                                    class="btn btn-danger btn-sm" btn-anular-comprobante-ingreso params="item"
                                    on-result="refresh()">
                                    <i class="fas fa-trash-alt"></i>
                                </button>
                            </div>
                        </td>
                        <td md-cell>{{$index+1}}</td>
                        <td md-cell>{{item.fechaEmision}}</td>
                        <td md-cell>{{item.subEntidadFinanciera}}</td>
                        <td md-cell>${{item.valor}}</td>
                        <td md-cell>{{item.posfechado}}</td>
                        <td md-cell>
                            <span class="badge badge-success badge-pill">{{item.estado}}</span>
                        </td>
                    </tr>
                    <tr ng-show="item.showDetalle" ng-repeat-end="">
                        <td md-cell colspan="9">
                            <div class="ml-5 mt-1 mr-5">
                                <div class="table-responsive">
                                    <table class="table table-hover table-bordered table-sm">
                                        <thead>
                                            <tr>
                                                <th>Cuota</th>
                                                <th>Tipo. Documento</th>
                                                <th>Nro. Documento</th>
                                                <th>Fecha Vcto</th>
                                                <th>Total cuota</th>
                                                <th>Interes</th>
                                                <th>Dias Mora</th>
                                                <th>Mora</th>
                                                <th>Abono</th>
                                                <th>Saldo</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr ng-repeat="itemDetalle in item.cobroDetalles">
                                                <td>{{itemDetalle.nroCuota}}</td>
                                                <th>{{itemDetalle.codDoc}}</th>
                                                <td>{{itemDetalle.serieComprobante}}</td>
                                                <td>{{itemDetalle.fechaVencimiento}}</td>
                                                <td>${{itemDetalle.cuota}}</td>
                                                <td>${{itemDetalle.interes}}</td>
                                                <td>{{itemDetalle.diasMora}}</td>
                                                <td>${{itemDetalle.mora}}</td>
                                                <td>${{itemDetalle.abono}}</td>
                                                <td>${{itemDetalle.saldo}}</td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </md-table-container>
    </div>


    <div ng-if="showDetalleCompIngresoByDoc">


        <md-table-container>
            <table md-table>
                <thead md-head>
                    <tr md-row>
                        <th md-column></th>
                        <th md-column>N°</th>
                        <th md-column>N°. Doc </th>
                        <th md-column>Fecha </th>
                        <th md-column>Total </th>
                        <th md-column>Abono </th>
                        <th md-column>Cambio </th>
                        <th md-column>Estado </th>
                    </tr>
                </thead>
                <tbody md-body>
                    <tr md-row ng-repeat-start="item in comprobanteIngresos">
                        <td md-cell>

                            <div class="btn-group btn-group-sm" role="group">
                                <button type="button" class="btn btn-info" ng-click="expandDetalle(item)">
                                    <i class="fas fa-eye"></i>
                                </button>
                                <button type="button" ng-if="item.showInfoCobro" uib-tooltip="Información"
                                    ng-click="showInfo(item)" class="btn btn-info ">
                                    <i class="fas fa-info-circle"></i>
                                </button>

                                <button type="button" class="btn btn-danger"
                                    ng-if="accion.anularComprobanteIngresoDoc && item.status"
                                    btn-anular-comprobante-ingreso params="item" on-result="refresh()">
                                    <i class="fas fa-trash"></i>
                                </button>
                                <button type="button" class="btn btn-secondary" btn-comprobante-ingreso-report
                                    unique="item.idComprobanteIngreso" cod-estab="item.codEstab">
                                    <i class="fa fa-file-pdf"></i>
                                </button>
                            </div>
                        </td>
                        <td md-cell>{{$index+1}}</td>
                        <td md-cell>{{item.serieComprobante}}</td>
                        <td md-cell>{{item.fechaEmision}}</td>
                        <td md-cell>{{item.total}}</td>
                        <td md-cell>${{item.abono}}</td>
                        <td md-cell>${{item.cambio}}</td>
                        <td md-cell>{{item.estado}}</td>
                    </tr>
                    <tr ng-show="item.showDetalle" ng-repeat-end="">
                        <td md-cell colspan="9">
                            <div class="card ml-1 mt-1 mr-1">
                                <div class="card-body shadow">

                                    <div class="table-responsive table-sm">
                                        <table class="table table-small">
                                            <thead>
                                                <tr>
                                                    <th>#</th>
                                                    <th>Op.</th>
                                                    <th>Fecha Emisión</th>
                                                    <th>Entidad Financiera</th>
                                                    <th>Info. Adicional</th>
                                                    <th>Posfechado</th>
                                                    <th>Total</th>
                                                    <th>Abono</th>
                                                    <th>Cambio</th>
                                                    <th>Estado</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <tr ng-repeat="itemCobro    in item.cobros">
                                                    <td>{{$index+1}}</td>
                                                    <td>
                                                        <button type="button" class="btn btn-info btn-sm"
                                                            ng-click="showCuotas(itemCobro)">
                                                            <i class="mdi mdi-information-outline"></i>
                                                        </button>
                                                    </td>
                                                    <td>{{itemCobro.fechaEmision}}</td>
                                                    <td>{{itemCobro.formaCobro}}</td>
                                                    <td>
                                                        <div class="d-flex flex-column justify-content-between">
                                                            <span
                                                                ng-if="itemCobro.infoCobro.codDoc"><b>Doc.:</b>{{itemCobro.infoCobro.nomDoc}}</span>
                                                            <span><b>Nro.:</b>{{itemCobro.infoCobro.nro}}</span>
                                                            <span><b>Lote:</b>{{itemCobro.infoCobro.lote}}</span>
                                                            <span><b>Referencia:</b>{{itemCobro.infoCobro.referencia}}</span>
                                                            <span><b>Aprobación:</b>{{itemCobro.infoCobro.aprobacion}}</span>
                                                        </div>
                                                    </td>
                                                    <td>{{itemCobro.posfechado}}</td>
                                                    <td>{{itemCobro.valor}}</td>
                                                    <td>{{itemCobro.abono}}</td>
                                                    <td>{{itemCobro.vuelto}}</td>
                                                    <td>
                                                        <span
                                                            class="badge badge-success badge-pill">{{itemCobro.estado}}</span>
                                                    </td>
                                                </tr>

                                            </tbody>
                                        </table>
                                    </div>


                                </div>
                            </div>




                        </td>
                    </tr>
                </tbody>
            </table>
        </md-table-container>
    </div>


</div>
<div class="modal-footer">
    <button type="button" class="btn btn-dark" ng-click="closeModal()">
        &times; Cerrar
    </button>
</div>