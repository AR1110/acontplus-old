<div class="modal-header">
    <h4 class="modal-title">Cobro {{TIPO_DOC.codigo}} N° <b> {{comprobante.serieComprobante}}</b></h4>
    <button type="button" class="close" ng-click="closeModal()">&times;</button>
</div>
<div class="modal-body">
    <form>
        <div class="row">
            <div class="col-lg-12">
                <div class="precio-cobro p-3 rounded d-flex justify-content-between">
                    <div class="images d-flex flex-row align-items-center">
                        <div class="d-flex flex-column"> 
                            <span class="entidad">Cliente</span>
                            <span class="text-muted">{{comprobante.identificacionComprador}}</span>
                            <span class="text-muted">{{comprobante.razonSocialComprador}}</span>
                        </div>
                    </div>
                    <div class="d-flex flex-column align-items-start">
                        <span><sup class="font-weight-bold">Total Factura:</sup>
                            <span class="amount ml-1 mr-1">${{comprobante.importeTotal}}</span></span>
                        <span><sup class="font-weight-bold">Fecha Emisión:</sup>
                            <span>{{comprobante.fechaEmision}}</span> </span>
                    </div>
                    @* <div class="d-flex flex-row align-items-center">
                    <sup class="font-weight-bold">Total Factura:</sup>
                    <span class="amount ml-1 mr-1">{{dataTipoDocumento.total |currency:'$'}}</span>
                    <span><b>Fecha Emisión:</b> {{dataTipoDocumento.fechaEmision}}</span>
                    </div> *@
                </div>
            </div>
        </div>

        <div class="row justify-content-between">
            <div class="col-lg-7 mt-2">
                @* <table class="table table-sm table-bordered text-small">
                <tr>
                <td>dd</td>
                <td>dd</td>
                <td>dd</td>
                <td>dd</td>
                </tr>
                </table> *@
            </div>
            <div class="col-lg-3">
                <div class="mt-3 align-self-center text-right">
                    <button type="button" class="btn btn-warning" ng-click="openModalCobroAvanzado()">Cobro
                        avanzado</button>
                </div>
            </div>
        </div>
        <hr />
        <div class="row">
            <div class="col-lg-12 col-md-12 col-sm-12 col-12">
                <div class="list-group list-group-horizontal-xl list-group-horizontal-lg list-group-horizontal-md">
                    <a href="javascript:void(0)" data-toggle="list" class="list-group-item list-group-item-action"
                        ng-class="ef.codigo=='EFE'?'active':''" ng-show="ef.codigo!=='DOC'"
                        ng-repeat="ef in entidadesFinancieras" ng-click="findSubEntidad(ef.idEntidadFinanciera)">
                        <small>{{ef.descripcion}}</small>
                    </a>
                </div>

                <div class="tab-content border border mt-2">
                    <!--EFECTIVO-->
                    <div class="tab-pane active" role="tabpanel" ng-show="entidadFinanciera.codigo==='EFE'">
                        <div class="p-20">
                            <div class="row">
                                <div class="col-lg-4 col-md-4 col-sm-6 col-12">
                                    <div class="form-group">
                                        <label class="text-muted">SubEntidad Financiera <span
                                                class="text-danger">*</span></label>
                                        <select class="form-control border-select"
                                            ng-model="cobro.idSubEntidadFinanciera">
                                            <option ng-value="se.idSubEntidadFinanciera"
                                                ng-repeat="se in subEntidadesFinancieras">{{se.descripcion}}</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-lg-4 col-md-4 col-sm-6 col-12">
                                    <div class="form-group">
                                        <label class="text-muted" for="fechaEmision">Fecha Emisión: <span class="text-danger">*</span></label>
                                        <input type="date" ng-model="cobro.fechaEmision" ng-required="true"
                                            class="form-control border-select">
                                    </div>
                                </div>
                                <div class="col-lg-4 col-md-4 col-sm-12 col-12">
                                    <div class="form-group">
                                        <label class="text-danger" for="valorACancelar">Valor a cancelar</label>
                                        <input type="text" ng-model="cobro.valorAbono" ng-keyup="setValorEfectivo()"
                                            class="form-control border-select" ng-enter="onSave()" ng-required="true"
                                            decimal placeholder="0.00"  onClick="select();"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!--TARJETA-->
                    <div class="tab-pane active" role="tabpanel" ng-show="entidadFinanciera.codigo==='TAR'">
                        <div class="p-20">
                            <div class="row">
                                <div class="form-group col-lg-4">
                                    <label class="text-muted">SubEntidad Financiera <span
                                            class="text-danger">*</span></label>
                                    <select class="form-control border-select" ng-model="cobro.idSubEntidadFinanciera">
                                        <option ng-value="se.idSubEntidadFinanciera"
                                            ng-repeat="se in subEntidadesFinancieras">{{se.descripcion}}</option>
                                    </select>
                                </div>
                                <div class="form-group col-lg-4">
                                    <label class="text-muted">Fecha Emisión: <span class="text-danger">*</span> </label>
                                    <input type="date" ng-model="cobro.fechaEmision" ng-required="true"
                                        class="form-control border-select">
                                </div>
                                <div class="form-group col-lg-4">
                                    <label class="text-danger">Valor a cancelar</label>
                                    <input type="text" ng-model="cobro.valorAbono" ng-keyup="setValorEfectivo()"
                                        class="form-control border-select" ng-enter="onSave()" ng-required="true"
                                        decimal placeholder="0.00" onClick="select();" />
                                </div>
                            </div>
                            <div class="row">
                                <!-- <div class="form-group col-lg-4">
                                    <label class="text-muted">Número <span class="text-danger">*</span></label>
                                    <input type="text" ng-model="cobro.nro" class="form-control border-select" />
                                </div>
                                <div class="form-group col-lg-4">
                                    <label>Ciudad: <span class="text-danger">*</span></label>
                                    <select class="form-control border-select" ng-model="cobro.idCiudad" id="ciudad"
                                        ng-options="cp.idCiudad as cp.descripcion group by cp.provincia for cp in ciudades">
                                    </select>
                                </div> -->
                                <!-- <div class="form-group col-lg-4">
                                    <label>Referencia: <span class="text-danger">*</span></label>
                                    <input type="text" ng-model="cobro.referencia" class="form-control border-select" />
                                </div> -->
                            </div>
                            <div class="row">
                                <div class="col-xl-4 col-lg-4 col-md-6 col-sm-12 col-12">
                                    <div class="form-group">
                                        <label class="text-muted">Referencia: </label>
                                        <input type="text" ng-model="cobro.referencia" class="form-control border-select" />
                                    </div> 
                                </div>
                                <div class="col-xl-4 col-lg-4 col-md-6 col-sm-12 col-12">
                                    <div class="form-group">
                                        <label class="text-muted">Aprobación: </label>
                                        <input type="text" ng-model="cobro.aprobacion"
                                            class="form-control border-select" />
                                    </div>
                                </div>
                                <div class="col-xl-4 col-lg-4 col-md-6 col-sm-12 col-12">
                                    <div class="form-group">
                                        <label class="text-muted">Lote: </label>
                                        <input type="text" ng-model="cobro.lote" class="form-control border-select" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!--TRANSFERENCIAS-->
                    <div class="tab-pane active" role="tabpanel" ng-show="entidadFinanciera.codigo==='TRA'">
                        <div class="p-20">
                            <div class="row">
                                <div class="form-group col-lg-4">
                                    <label class="text-muted">SubEntidad Financiera <span
                                            class="text-danger">*</span></label>
                                    <select class="form-control border-select" ng-model="cobro.idSubEntidadFinanciera">
                                        <option ng-value="se.idSubEntidadFinanciera"
                                            ng-repeat="se in subEntidadesFinancieras">{{se.descripcion}}</option>
                                    </select>
                                </div>
                                <div class="form-group col-lg-4">
                                    <label class="text-muted" for="fechaEmision">Fecha Emisión: <span class="text-danger">*</span></label>
                                    <input type="date" ng-model="cobro.fechaEmision" ng-required="true"
                                        class="form-control border-select">
                                </div>
                                <div class="form-group col-lg-4">
                                    <label class="text-danger">Valor a cancelar</label>
                                    <input type="text" ng-model="cobro.valorAbono" ng-keyup="setValorEfectivo()"
                                        class="form-control border-select" ng-enter="onSave()" ng-required="true"
                                        decimal placeholder="0.00" onClick="select();" />
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-lg-6 col-md-6 col-sm-12 col-12">
                                    <div class="form-group">
                                        <label class="text-muted">Banco<span class="text-danger">*</span></label>
                                        <select class="form-control border-select" ng-model="cobro.idBanco">
                                            <option ng-value="b.idBanco" ng-repeat="b in bancos">{{b.descripcion}}
                                            </option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-lg-6 col-md-6 col-sm-12 col-12">
                                    <div class="form-group">
                                        <label class="text-muted">Número <span class="text-danger">*</span></label>
                                        <input type="text" ng-model="cobro.nro" class="form-control border-select" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!--CHEQUES-->
                    <div class="tab-pane active" role="tabpanel" ng-show="entidadFinanciera.codigo==='CHE'">
                        <div class="p-20">
                            <div class="row">
                                <div class="form-group col-lg-4">
                                    <label class="text-muted">SubEntidad Financiera <span
                                            class="text-danger">*</span></label>
                                    <select class="form-control border-select" ng-model="cobro.idSubEntidadFinanciera">
                                        <option ng-value="se.idSubEntidadFinanciera"
                                            ng-repeat="se in subEntidadesFinancieras">{{se.descripcion}}</option>
                                    </select>
                                </div>
                                <div class="form-group col-lg-4">
                                    <label class="control-label">Fecha Emisión: <span class="text-danger">*</span></label>
                                    <input type="date" ng-model="cobro.fechaEmision" ng-required="true"
                                        class="form-control border-select">
                                </div>
                                <div class="form-group col-lg-4">
                                    <label class="text-danger">Valor a cancelar</label>
                                    <input type="text" ng-model="cobro.valorAbono" ng-keyup="setValorEfectivo()"
                                        class="form-control border-select" ng-enter="onSave()" ng-required="true"
                                        decimal placeholder="0.00" onclick="select();" />
                                </div>
                            </div>

                            <div class="row">

                                <div class="col-lg-3 col-md-3 col-sm-12 col-12">
                                    <div class="form-group">
                                        <label class="text-muted">Ciudad: <span class="text-danger">*</span></label>
                                        <select class="form-control border-select" ng-model="cobro.idCiudad" id="ciudad"
                                            ng-options="cp.idCiudad as cp.descripcion group by cp.provincia for cp in ciudades">
                                        </select>
                                    </div>
                                </div>

                                <div class="col-lg-3 col-md-3 col-sm-12 col-12">
                                    <div class="form-group">
                                        <label class="text-muted">Banco<span class="text-danger">*</span></label>
                                        <select class="form-control border-select" ng-model="cobro.idBanco">
                                            <option ng-value="b.idBanco" ng-repeat="b in bancos">{{b.descripcion}}
                                            </option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-lg-3 col-md-3 col-sm-12 col-12">
                                    <div class="form-group">
                                        <label class="text-muted">Número <span class="text-danger">*</span></label>
                                        <input type="text" ng-model="cobro.nro" class="form-control border-select" />
                                    </div>
                                </div>
                                <div class="col-lg-3 col-md-3 col-sm-12 col-12">
                                    <div class="form-group">
                                        <label class="text-muted">PosFechado</label>
                                        <div class="icheck-primary">
                                            <input type="checkbox" ng-model="cobro.posFechado" id="isPosfechado" />
                                            <label for="isPosfechado"></label>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-lg-12 col-md-12 col-sm-12 col-12">
                                    <div class="form-group">
                                        <label class="text-muted" for="dirigidoA">Dirigido a:</label>
                                        <input type="text" class="form-control border-select"
                                            ng-model="cobro.referencia" onClick="select();">
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row justify-content-center mt-1">
            <div class="col-lg-4">
                <div class="table-responsive">
                    <table class="table table-condensed table-no-bordered table-sm" width="100%">
                        <tbody>
                            <tr class="table-danger" ng-if="comprobante.abono>0">
                                <td align="left">
                                    <h4>Abono Anterior</h4>
                                </td>
                                <td align="right">
                                    <h4>${{comprobante.abono}}</h4>
                                </td>
                            </tr>
                            <tr>
                                <td align="left">
                                    <h4><b>Saldo: </b></h4>
                                </td>
                                <td class="padding-20 " align="right">
                                    <h4>${{cobro.valorSaldo}}</h4>
                                </td>
                            </tr>

                            @* <tr>
                            <td align="left"><h4><b>Valor: </b></h4></td>
                            <td class="padding-20 " align="right"><h4> {{cobro.valorAbono |currency:$}}</h4></td>
                            </tr> *@
                            <tr>
                                <td align="left">
                                    <h4><b>Cambio: </b></h4>
                                </td>
                                <td class="padding-20 " align="right">
                                    <h4> ${{cobro.valorCambio}}</h4>
                                </td>
                            </tr>

                        </tbody>
                    </table>
                </div>
            </div>
        </div>


        <div class="row mt-2">
            <div class="col-md-4"></div>
            <div class="col-md-4 d-flex justify-content-end">

            </div>
            <div class="col-md-4"></div>
        </div>
    </form>
</div>
<div class="modal-footer">
    <button type="button" id="btnSaveCobroRapido" class="btn btn-success" ng-click="save()"><i class="ti-save"></i>
        Guardar</button>
    <button type="button" class="btn btn-dark" ng-click="closeModal()">&times; Cerrar</button>
</div>
