<style>
    .cellPenditeParcial {
        background-color: rgb(247, 150, 26) !important;
        color: #000 !important;
    }

    .cellPendiente {
        background-color: #FF9999 !important;
        color: #000 !important;
    }

    .subgrid-wrapper .ui-grid-cell {
        font-size: 12px !important
            /* filas */
    }

    .subgrid-wrapper .ui-grid-header-cell {
        font-size: 11px !important
            /* encabezados */
    }
</style>
<div class="modal-header">
    <h5 class="modal-title">Cobro por Lote</h5>
    <button class="close" ng-click="closeModal()">&times;</button>
</div>
<div class="modal-body">


    <div class="card mb-3">
        <div class="card-body py-3">


            <div class="d-flex justify-content-center" ng-if="configCobro.configDeuda">
                <div class="d-flex ">
                    <div class="p-2 flex-fill ">
                        Mora
                    </div>
                    <div class="p-2 flex-fill bd-highlight">
                        <p><strong>Interes:</strong>{{configCobro.interes}} </p>
                    </div>
                    <div class="p-2 flex-fill bd-highlight">
                        {{configCobro.interes}} x día
                    </div>
                </div>
            </div>

            <div class="row">
                <!-- Totales -->
                <div class="col-12 ">
                    <div class="d-flex flex-wrap justify-content-center justify-content-md-center">
                        <div class="pr-3 mb-2">
                            <small class="text-muted">Total</small>
                            <div class="h6 text-dark mb-0">{{data.importeTotal}}</div>
                        </div>
                        <div class="pr-3 mb-2">
                            <small class="text-muted">Abono Anterior</small>
                            <div class="h6 text-success mb-0">{{data.totalAbonoAnterior}}</div>
                        </div>
                        <div class="pr-3 mb-2">
                            <small class="text-muted">Saldo</small>
                            <div class="h6 text-warning mb-0">{{data.totalSaldoDoc}}</div>
                        </div>
                        <div class="pr-3 mb-2">
                            <small class="text-muted">Mora</small>
                            <div class="h6 text-danger mb-0">{{data.totalMora}}</div>
                        </div>
                        <div class="pr-3 mb-2">
                            <small class="text-muted">Saldo + Mora</small>
                            <div class="h6 text-danger font-weight-bold mb-0">{{data.saldoActualDoc}}</div>
                        </div>
                        <div class="pr-3 mb-2">
                            <small class="text-muted">Saldo Actual</small>
                            <div class="h6 text-dark mb-0">{{data.totalSaldo}}</div>
                        </div>
                        <div class="pr-3 mb-2">
                            <small class="text-muted">Abono Actual</small>
                            <div class="h6 text-primary mb-0">{{data.totalValorAbono}}</div>
                        </div>
                        <div class="mb-2">
                            <small class="text-muted">Diferencia</small>
                            <div class="h6 text-success mb-0">{{data.valorCambio | currency}}</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Botón "Nuevo Abono" -->
            <div class="row mt-3">
                <div class="col-12 text-right">
                    <button class="btn btn-success btn-sm" ng-if="!isLoading" ng-click="openModalFormaCobro()">
                        <i class="fa fa-plus"></i> Nuevo Abono
                    </button>
                </div>
            </div>
        </div>
    </div>


    <div ui-grid="gridOptions" class="grid" ui-grid-resize-columns ui-grid-cellNav ui-grid-auto-resize
        ui-grid-expandable>
    </div>


    <div class="d-flex flex-column">
