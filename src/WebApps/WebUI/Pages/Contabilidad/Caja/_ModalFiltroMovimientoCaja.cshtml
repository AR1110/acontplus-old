<div class="modal-header">
    <h5 class="modal-title">Filtro</h5>
    <button type="button" class="close" ng-click="$ctrl.closeModal()">&times;</button>
</div>

<div class="modal-body">
    <div class="row justify-content-between">

        <div class="col-xl-5 col-lg-5 col-md-5 col-sm-12 col-12">
            <div class="icheck-info">
                <input type="checkbox" id="fechaMovimientoCaja" ng-model="$ctrl.dataSearch.checkBoxDate" ng-change="$ctrl.onChangeFechaFiltro()">
                <label for="fechaMovimientoCaja">Fecha</label>
            </div>            
        </div>

        <div class="col-xl-5 col-lg-5 col-md-5 col-sm-12 col-12">
            <div class="icheck-info">
                <input type="checkbox" id="estadoMovimientoCaja" ng-model="$ctrl.dataSearch.checkBoxStatus">
                <label for="estadoMovimientoCaja">Estado</label>
            </div>
        </div>        
    </div>
    <hr>

    <div class="row" ng-if="$ctrl.dataSearch.checkBoxDate">
        <div class="col-xl-4 col-lg-4 col-md-6 col-sm-12 col-12">
            <div class="form-group">
                <label class="control-label">Mes: </label>
                <select ng-model="$ctrl.dataSearch.mes " class="form-control" ng-change="$ctrl.getFechaInicioFinFilter($ctrl.dataSearch.mes )">
                    <option ng-value="m.numero" ng-repeat="m in $ctrl.meses">
                        {{m.nombre}}
                    </option>
                </select>
            </div>
        </div>

        <div class="col-xl-4 col-lg-4 col-md-6 col-sm-12 col-12">
            <div class="form-group">
                <label>Fecha Inicio:</label>
                <input type="date" class="form-control" ng-model="$ctrl.dataSearch.dateStart"/>
            </div>
        </div>

        <div class="col-xl-4 col-lg-4 col-md-6 col-sm-12 col-12">
            <div class="form-group">
                <label>Fecha Fin:</label>
                <input type="date" class="form-control" ng-model="$ctrl.dataSearch.dateEnd" />
            </div>
        </div>
    </div>

    <div class="row" ng-if="$ctrl.dataSearch.checkBoxStatus">
        <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">
            <div class="form-group">
                <label for="">Estado</label>
                <select name="" id="" class="form-control border-select" ng-model="$ctrl.dataSearch.statusMovement">
                    <option ng-value="item.statusMovement" ng-repeat="item in $ctrl.estadoMovimientos">
                        {{item.descripcion}}
                    </option>
                </select>
            </div>
        </div>        
    </div>
</div>

<div class="modal-footer">
    <button type="button" class="btn btn-info" ng-click="$ctrl.filtrar()">
        <i class="fa fa-search"></i> Buscar
    </button>
    <button type="button" class="btn btn-dark" ng-click="$ctrl.closeModal()">
        &times; Cerrar
    </button>
</div>