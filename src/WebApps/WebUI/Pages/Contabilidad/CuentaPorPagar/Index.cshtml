@page
@model WebUI.Pages.Contabilidad.CuentaPorPagar.IndexModel
@{
    ViewData["Title"] = "Index";
    
}

<div ng-controller="cuentaPorPagarCtrl">
    <div class="row page-titles">
        <div class="col-md-5 align-self-center">
            <h5 class="text-themecolor">Cuentas por Pagar</h5>
        </div>
    </div>


    <div class="card">
        <div class="card-body">

            <!--Filters-->
            <div class="row">
                <div class="col-xl-3 col-lg-3 col-md-6 col-sm-12 col-12">
                    <div class="form-group">
                        <span for="estab">Establecimiento</span>
                        <select class="form-control border-select" name="estab" id="estab" ng-model="dataSearch.codEstab" ng-change="getCuentasPorPagar()">
                            <option ng-value="item.codEstab" ng-repeat="item in establecimientos">{{item.nombreComercial}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-xl-3 col-lg-3 col-md-6 col-sm-12 col-12">
                    <span for="date-range-filter">Rango Fechas: </span>
                    <div class="input-group">
                        <div class="input-group-prepend">
                            <div class="input-group-text">
                                <div class="custom-control custom-checkbox mr-sm-2">
                                    <input type="checkbox" ng-model="dataSearch.checkBoxFecha"
                                           class="custom-control-input" id="checkBoxFecha" ng-change="getCuentasPorPagar()">
                                    <label class="custom-control-label" for="checkBoxFecha"></label>
                                </div>
                            </div>
                        </div>

                        <date-range-filter current-date="dataSearch.fechaInicio" start-date="dataSearch.fechaInicio"
                                           end-date="dataSearch.fechaFin"
                                           result-range-date="resultRangeFilter(result)"></date-range-filter>
                    </div>
                </div>
                <div class="col-xl-4 col-lg-4 col-md-6 col-sm-12 col-12">
                    <div class="form-group">
                        <span for="proveedorFiltro">Proveedor:</span>
                        <input type="text" id="providerInputSearch" class="form-control border-select"
                               ng-model="proveedor.nombreProveedor" provider-search-drtv
                               on-select="onSelectProveedor(result)" on-keyup="onKeyupProveedor()"
                               placeholder="Ingrese C.I o Nombre Comercial" onclick="select();">

                        <script type="text/ng-template" id="autocompleteProviderTemplate.html">
                            <div class="autocomplete-suggestion-uib-typeahead">
                                <span class="item-title"><b> {{match.model.numeroIdentificacion}}</b> - {{match.model.nombreFiscal}}</span>
                            </div>
                        </script>
                    </div>
                </div>
                <div class="col-xl-2 col-lg-2 col-md-6 col-sm-12 col-12">
                    <div class="card">
                        <div class="card-body">
                            <button type="button" class="btn btn-info btn-sm" data-toggle="button" data-more="#sh"
                                    aria-pressed="false" ng-click="onClickBtnMore()">
                                <span class="text">
                                    <i class="mdi mdi-eye" aria-hidden="true" uib-tooltip="Más opciones"></i>
                                </span>
                                <span class="text-active">
                                    <i class="mdi mdi-eye-off" aria-hidden="true" uib-tooltip="Ocultar opciones"></i>
                                </span>
                            </button>
                            <button type="button" class="btn btn-success btn-sm" ng-click="getCuentasPorPagar()"
                                    uib-tooltip="Recargar">
                                <i class="mdi mdi-refresh"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row" ng-if="moreSearchOptions">
                <div class="col-xl-2 col-lg-2 col-md-6 col-sm-12 col-12">
                    <div class="form-group">
                        <span  >Tipo Documento</span>
                        <select name="tipoDoc" id="tipoDoc" class="form-control  border-select" ng-model="dataSearch.codDoc" ng-change="getCuentasPorPagar()">
                            <option value="">Todos</option>
                            <option ng-value="item.codDoc" ng-repeat="item in tipoDocumentos">
                                {{item.descripcion}}
                            </option>
                        </select>
                    </div>
                </div> 

                <div class="col-xl-2 col-lg-2 col-md-6 col-sm-12 col-12">
                    <div class="form-group">
                        <span  >Estado</span>
                        <select name="estadoDoc" id="estadoDoc" ng-model="dataSearch.codEstado" class="form-control  border-select" ng-change="getCuentasPorPagar()">
                            <option value="">Todos</option>
                            <option ng-value="item.codigo" ng-repeat="item in estadosDoc">
                                {{item.descripcion}}
                            </option>
                        </select>
                    </div>                    
                </div>

                <div class="col-xl-3 col-lg-3 col-md-6 col-sm-12 col-12">
                    <div class="form-group">
                        <span  >Buscar por Nro. Doc.</span>
                        <input type="text" class="form-control border-select" valid-number ng-model="dataSearch.secuencial" placeholder="Ej.20">
                    </div>
                </div>

            </div>
            <!--Filters--->

            <div class="row">
                <div class="col-4 d-flex justify-content-start">
                    <span class="form-group pull-left page-size form-inline">
                        <select class="form-control control-color" ng-model="dataSearch.pageSize"
                                ng-change="changePageSize()" ng-options="ra for ra in recordsQuantity">
                        </select>
                    </span>
                </div>

                <div class="col-4 d-flex justify-content-center align-items-center">
                    <div class="text-center w-100">
                        <button type="button" class="btn btn-success btn-block" ng-click="openDocPaymentModal()">
                            <i class=" far fa-money-bill-alt"></i> Pagar
                        </button>
                    </div>
                </div>
                <div class="col-4 d-flex justify-content-end">
                    <!-- <div class="form-group">
                        <input type="text" class="form-control border-select" ng-change="searchFilterLocal()"
                                ng-model="dataSearch.bySearch" placeholder="...">
                    </div> -->
                </div>
            </div>

            <md-table-container style="max-height: 400px;">
                <table md-table md-row-select="tableOptions.rowSelection" multiple="{{tableOptions.multiSelect}}" ng-model="selectedDocumentos" md-progress="promise">
                    <thead fix-head md-head>
                        <tr md-row>
                            <th md-column><span></span></th>
                            <th md-column><span>N°</span></th>
                            <th md-column><span>Cod. Doc</span></th>
                            <th md-column><span>Serie</span></th>
                            <th md-column><span>Identificacion</span></th>
                            <th md-column><span>Proveedor</span></th>
                            <th md-column>Fecha Emisión</th>
                            <th md-column>Fecha Vcto.</th>
                            <th md-column>Total</th>
                            <th md-column>Abono</th>
                            <th md-column>Saldo</th>
                            <th md-column>Estado</th>
                        </tr>
                    </thead>
                    <tbody md-body>
                        <tr md-row 
                            md-select="item" 
                            md-select-id="idCuentaPorPagar"
                             ng-disabled="rowEnabledPayment(item)" 
                            md-on-select="onSelectDoc"
                             md-on-deselect="onDesSelectDoc" 

                            ng-repeat="item in cuentasPorPagar | orderBy: tableOptions.sortBy track by $index" ng-style="{'background-color': item.colorRow}">
                            <td md-cell>
                                <md-menu>
                                    <md-button aria-label="Open demo menu" class="md-icon-button"
                                               ng-click="$mdMenu.open($event)">
                                        <i class="mdi mdi-menu"></i>
                                    </md-button>
                                    <md-menu-content class="md-dense">
                                        <md-menu-item>
                                            <md-button ng-click="openModalCuota(item)">
                                                <span md-menu-align-target>Cuotas</span>
                                            </md-button>
                                        </md-menu-item> 

                                        <md-menu-item>
                                            <md-button ng-click="openModalHistorialMov(item)" ng-disabled="(item.codPago==='PE')">
                                                <span md-menu-align-target>Hist. Movimiento</span>
                                            </md-button>
                                        </md-menu-item>

                                    </md-menu-content>
                                </md-menu>
                            </td>
                            <td md-cell>{{$index+1}}</td>
                            <td md-cell>{{item.codDoc}}</td>
                            <td md-cell>{{item.serieComprobante}}</td>
                            <td md-cell>{{item.identificacionComprador}}</td>
                            <td md-cell>{{item.razonSocialComprador}}</td>
                            <td md-cell>{{item.fechaEmision}}</td>
                            <td md-cell>{{item.fechaVencimiento}}</td>
                            <td md-cell>${{item.importeTotal}}</td>
                            <td md-cell>${{item.abono}}</td>
                            <td md-cell>${{item.saldo}}</td>
                            <td md-cell>{{item.estado}}</td>
                        </tr>
                    </tbody>
                </table>
            </md-table-container>
        </div>
         <div class="card-body">
            <ul uib-pagination total-items="dataSearch.totalRecords" items-Per-Page="dataSearch.pageSize"
                ng-change="pagechanged()" ng-model="dataSearch.pageIndex" max-size="dataSearch.maxSize"
                class="pagination" boundary-links="true" rotate="false"></ul>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/contabilidad/controllers/cuentaPorPagarCtrl.min.js" asp-append-version="true"></script>
}