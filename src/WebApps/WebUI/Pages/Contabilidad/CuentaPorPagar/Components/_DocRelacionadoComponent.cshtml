 
<div class="modal-header">
    <h5 class="modal-title"><i class="fas fa-file"></i> Doc. Relacionado</h5>
    <button class="close" ng-click="$ctrl.cancel()">&times;</button>
</div>

<div class="modal-body">


    

   <div class="table-responsive">
        <table class="table table-sm table-bordered table-striped text-center">
            <thead class="thead-dark">
                <tr> 
                    <th>N°</th>
                    <th>Nro Documento</th>
                    <th>Tipo Documento</th>
                    <th>Saldo</th>
                    <th>Num Aut Doc Sustento</th>
                </tr>
            </thead>
            <tbody>
                <tr ng-repeat="item in docs" ng-class="{'table-info': item.isDocRelacionado}">
                    <td>{{ $index + 1 }}</td> 
                    <td>{{ item.nroDocumento }}</td>
                    <td>{{ item.tipoDocumento }}</td>
                    <td>{{ item.saldo }}</td>
                    <td>{{ item.numAutDocSustento }}</td>
                </tr>
            </tbody>
        </table>
   </div>
</div> 
<div class="modal-footer"> 
    <button type="button" class="btn btn-dark" ng-click="$ctrl.cancel()">&times; Cerrar</button>
</div>