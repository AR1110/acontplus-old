 <style>
    /* Custom CSS to fix the table header */
.table-responsive {
  height: 200px; /* Set the desired height */
  overflow-y: auto;
}

.table {
  position: relative;
}

thead th {
  position: sticky;
  top: 0;
  background-color: #bee5eb; /* or use any other background color */
  z-index: 2; /* Ensures the header stays on top */
}

.table-bordered th,
.table-bordered td {
  border: 1px solid #dee2e6; /* Ensures the border appears around the header */
}

 </style>
<div class="modal-header">
    <h5 class="modal-title"><i class="fas fa-file"></i> Doc. Relacionado</h5>
    <button class="close" ng-click="$ctrl.cancel()">&times;</button>
</div>

<div class="modal-body">  
    <span class="badge badge-success">Factura - Retención</span>
    <div class="table-responsive">
            <table class="table table-sm table-bordered table-striped text-center"> 
                <thead class="thead-info"> 
                    <tr> 
                        <th>N°</th>
                        <th>Nro Doc.</th>
                        <th>Fecha</th>
                        <th>Total</th>
                        <th>Nro. Ret.</th> 
                        <th>Valor Ret.</th>
                        <th>Total Dev.</th>
                        <th>Fact. Ret.</th>
                    </tr>
                </thead>
                <tbody>
                    <tr ng-repeat="item in facturasRetencion"  >
                        <td>{{ $index + 1 }}</td> 
                        <td>{{ item.serieComprobante }}</td>
                        <td>{{ item.fechaEmision }}</td>
                        <td>{{ item.importeTotal }}</td>
                        <td>{{item.serieComprobanteRetencion}}</td>
                        <td>{{item.valorRetencion}}</td>
                        <td>{{item.totalValorDevolucion}}</td>
                        <td>{{item.valorFactRetencion}}</td>                        
                    </tr>                    
                </tbody>
                <tfoot>
                    <tr>
                        <td ></td>
                        <td ></td>
                        <td ></td>
                        <td  >{{dataTotal.importeTotal}}</td>
                        <td  > </td>
                        <td  >{{dataTotal.valorRetencion}}</td>
                        <td  >{{dataTotal.totalValorDevolucion}}</td>
                        <td >{{dataTotal.valorFactRetencion}}</td>
                    </tr>
                </tfoot>
            </table>
    </div>

 
    <span class="badge badge-danger">Nota Crédito-Factura</span>
    <div class="table-responsive">
        <table class="table table-sm table-bordered table-striped text-center"> 
            <thead class="thead-info"> 
                <tr> 
                    <th>N°</th>
                    <th>Tipo Doc.</th>
                    <th>Nro. Doc</th>
                    <th>Total</th>
                    <th>Nro. Factura</th> 
                </tr>
            </thead>
            <tbody>
                <tr ng-repeat="item in notasCreditoFactura"  >
                    <td>{{$index + 1 }}</td> 
                    <td>{{item.tipoDocumento }}</td>
                    <td>{{item.nroDocumento }}</td>
                    <td>{{item.saldo }}</td>
                    <td>{{item.serieComprobanteFactura}}</td> 
                </tr>
            </tbody>
             <tfoot>
                    <tr>
                        <td  ></td> 
                        <td  ></td> 
                        <td  ></td> 
                        <td  >{{valorTotalNotaCreditoFactura}}</td> 
                    </tr>
                </tfoot>
        </table>
    </div>
</div> 
<div class="modal-footer"> 
    <button type="button" class="btn btn-dark" ng-click="$ctrl.cancel()">&times; Cerrar</button>
</div>