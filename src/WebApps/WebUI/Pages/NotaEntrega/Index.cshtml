@page
@model WebUI.Pages.NotaEntrega.IndexModel


@{
    ViewData["title"] = "Nota Entrega";

}

<div ng-controller="notaEntregaCtrl">
    <div class="row page-titles">
        <div class="col-md-5 align-self-center">
            <h5 class="text-themecolor">Gestión de Nota de Entrega</h5>
        </div>
        <div class="col-md-7 align-self-center text-right">
            <div class="d-flex justify-content-end align-items-center">
                <button class="btn btn-info m-l-15" ng-show="accion.crear" id="btnNewDocument"
                    ng-click="openModalNew()">
                    <i class="fa fa-plus-circle"></i> Nuevo
                </button>
            </div>
        </div>
    </div>



    <div class="card">
        <div class="card-body">
            <div class="row">
                <div class="col-xl-7 col-lg-7 col-md-6 col-sm-12 col-12">
                    <div class="row">
                        <div class="col-xl-6 col-lg-6 col-md-12 col-sm-12 col-12">
                            <div class="form-gorup">
                                <span for="establecimiento">Estab: <span class="text-danger">*</span></span>
                                <select name="establecimiento" id="establecimiento" ng-model="dataSearch.codEstab"
                                    class="form-control  border-select" ng-change="estabFilter()">
                                    <option ng-value="item.codEstab" ng-repeat="item in establecimientos">
                                        {{item.nombreComercial}}
                                    </option>
                                </select>
                            </div>
                        </div>


                        <div class="col-xl-6 col-lg-6 col-md-12 col-sm-12 col-12">
                            <span for="date-range-filter">Rango Fechas: </span>
                            <div class="input-group">
                                <div class="input-group-prepend">
                                    <div class="input-group-text">
                                        <div class="custom-control custom-checkbox mr-sm-2">
                                            <input type="checkbox" ng-model="dataSearch.checkBoxFecha"
                                                class="custom-control-input" id="checkBoxFecha" ng-change="refresh()">
                                            <label class="custom-control-label" for="checkBoxFecha"></label>
                                        </div>
                                    </div>
                                </div>

                                <date-range-filter current-date="dataSearch.fechaInicio"
                                    start-date="dataSearch.fechaInicio" end-date="dataSearch.fechaFin"
                                    result-range-date="resultRangeFilter(result)"></date-range-filter>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-xl-5 col-lg-5 col-md-6 col-sm-12 col-12">
                    <div class="row">
                        <div class="col-xl-9 col-lg-9 col-md-12 col-sm-12 col-12">
                            <div class="form-group">
                                <span for="clienteFiltro">Cliente</span>
                                <input type="text" id="customerInputSearch" class="form-control border-select"
                                    ng-model="cliente.nombreCliente" cliente-search-drtv
                                    on-select="onSelectCliente(result)" on-keyup-cliente="onKeyupCliente()"
                                    placeholder="Ingrese C.I o Nombre Comercial" onclick="select();">

                                <script type="text/ng-template" id="autocompleteClienteTemplate.html">
                                    <div class="autocomplete-suggestion-uib-typeahead">
                                        <span class="item-title"><b> {{match.model.numeroIdentificacion}}</b> - {{match.model.nombreFiscal}}</span>
                                    </div>
                                </script>
                            </div>
                        </div>
                        <div class="col-xl-2 col-lg-2 col-md-6 col-sm-12 col-12">
                            <div class="btn-group btn-group-sm mt-4" role="group" aria-label="Basic example">
                                <button type="button" class="btn btn-info" ng-click="onClickBtnMore()">
                                    <i class="fas fa-eye" uib-tooltip="Más opciones"></i>
                                </button>
                                <button type="button" class="btn btn-success" uib-tooltip="Recargar"
                                    ng-click="getNotaEntregas()">
                                    <i class="fas fa-redo"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row justify-content-between" ng-if="moreSearchOptions">
                <div class="col-xl-5 col-lg-5 col-md-12 col-sm-12 col-12">
                    <div class="row">
                        <div class="col-xl-5 col-lg-5 col-md-12 col-sm-12 col-12">
                            <div class="form-gorup">
                                <span for="ptoEmision">Pto. Emisión: <span class="text-danger">*</span> </span>
                                <select name="ptoEmision" id="ptoEmision" ng-model="dataSearch.idPuntoEmision"
                                    class="form-control  border-select" ng-change="getNotaEntregas()">
                                    <option ng-value="item.idPuntoEmision" ng-repeat="item in puntosEmision">
                                        {{item.ptoEmi}}
                                    </option>
                                </select>
                            </div>
                        </div>
                        <div class="col-xl-7 col-lg-7 col-md-12 col-sm-12 col-12">
                            <div class="form-group">
                                <span for="usuario">Usuario</span>
                                <input type="text" class="form-control border-select" ng-model="dataUserSearch.name"
                                    user-search-drtv on-keyup="onKeyupUsuarioSearch()"
                                    on-select="selectedUsuarioSearch(result)" placeholder="Ej: Jorge">

                                <script type="text/ng-template" id="autocompleteUserTemplate.html">
                                        <div class="autocomplete-suggestion-uib-typeahead">
                                            <span class="item-title">
                                                {{match.model.nombreCompleto}}
                                            </span>
                                        </div>
                                    </script>


                            </div>
                        </div>
                    </div>

                </div>
                <div class="col-xl-7 col-lg-7 col-md-12 col-sm-12 col-12">
                    <div class="row">
                        <div class="col-xl-4 col-lg-4 col-md-6 col-sm-12 col-12">
                            <div class="form-group">
                                <span>Buscar por Nro. Doc.:</span>
                                <input type="text" class="form-control border-select"
                                    ng-model="dataSearch.nroSecuencial" placeholder="Ej: 123 o 1-30" />
                            </div>
                        </div>
                        <div class="col-xl-4 col-lg-4 col-md-6 col-sm-12 col-12">
                            <div class="form-group">
                                <span>Dato Adicional:</span>
                                <input type="text" class="form-control border-select"
                                    ng-model="dataSearch.infoAdicional" placeholder="Ej: SERIE" />
                            </div>
                        </div>

                        <div class="col-xl-4 col-lg-4 col-md-6 col-sm-12 col-12">
                            <div class="form-group">
                                <span>Estado:</span>
                                <select id="estadoDocumentos" class="form-control" ng-model="dataSearch.idEstadoPago"
                                    ng-change="getNotaEntregas()">
                                    <option value="">Todos</option>
                                    <option ng-value="item.idEstadoPago" ng-repeat="item in estadoDocumentos">
                                        {{item.descripcion}}
                                    </option>
                                </select>
                            </div>
                        </div>

                    </div>

                </div>
            </div>

            <div class="row">
                <div class="col-6 d-flex justify-content-start">
                    <span class="form-group pull-left page-size form-inline">
                        <select class="form-control control-color" ng-model="dataSearch.pageSize"
                            ng-change="changePageSize()" ng-options="ra for ra in recordsQuantity">
                        </select>
                    </span>
                </div>

                <div class="col-6 d-flex justify-content-end align-items-center">
                    <div class="icheck-primary mr-2">
                        <input type="checkbox" id="docTransferida" ng-model="dataSearch.convertToDoc"
                            ng-change="getNotaEntregas()" />
                        <label for="docTransferida">Doc. Transferida</label>
                    </div>
                </div>
            </div>

            <!--Lista Nota de Entregas-->

            <div id="upperScroll" style="overflow-x:scroll; overflow-y: hidden; max-height:20px; width:100%">
                <div name="innerScroll" ng-style="duelScroll" style="height:20px;"></div>
            </div>
            <div ng-style="getStyle($index)">
                <md-table-container name="wireTable" infinite-scroll="loadMore($index)" infinite-scroll-distance="1"
                    infinite-scroll-parent="true" ng-init="isShow=true" ng-show="isShow"
                    style=" max-height: 400px; overflow-x: hidden;">
                    <table resize master md-table name="innerWireTable">
                        <thead fix-head md-head md-trim-column-names md-order="dataSearch.order">
                            <tr md-row>
                                <th md-column></th>
                                @* <th md-column>N°</th> *@
                                <th md-column md-order-by="serieComprobante">N°. Doc</th>
                                <th md-column md-order-by="fechaEmision">F. Emision</th>
                                <th md-column>F. Vcto</th>
                                <th md-column md-order-by="razonSocialComprador">Cliente</th>
                                <th md-column md-numeric md-order-by="total" totales-venta-view="ventaPermiso">
                                    Total
                                </th>
                                <th md-column totales-venta-view="ventaPermiso">Abono</th>
                                <th md-column totales-venta-view="ventaPermiso">Saldo</th>
                                <th md-column>Estado </th>
                                <th md-column>Usuario</th>
                            </tr>
                        </thead>
                        <tbody md-body>
                            <tr md-row ng-repeat="ne in notaEntregas | orderBy: dataSearch.order"
                                ng-class="{'table-warning': ne.convertToDoc, 'table-danger': ne.esAnulado}">
                                <td md-cell>
                                    <div class="d-flex">
                                        <md-menu>
                                            <md-button aria-label="Open demo menu" class="md-icon-button"
                                                ng-click="$mdMenu.open($event)">
                                                <i class="mdi mdi-menu"></i>
                                            </md-button>
                                            <md-menu-content class="md-dense">
                                                <md-menu-item>
                                                    <md-button ng-click="openModalDetalle(ne)">
                                                        <span md-menu-align-target>
                                                            <i class="ti-menu"></i>
                                                            Detalle
                                                        </span>
                                                    </md-button>
                                                </md-menu-item>
                                                <md-menu-item
                                                    ng-if="!(ne.convertToDoc || ne.esAnulado) && accion.editar">
                                                    <md-button ng-click="openModalEdit(ne)">
                                                        <span md-menu-align-target>
                                                            <i class="ti-pencil"></i>
                                                            Editar
                                                        </span>
                                                    </md-button>
                                                </md-menu-item>

                                                <md-menu-item
                                                    ng-if="!ne.convertToDoc && accion.anular && !ne.esAnulado ">
                                                    <md-button ng-click="askToDelete(ne)">
                                                        <span md-menu-align-target>
                                                            <i class="ti-close"></i>
                                                            Anular N. Entrega
                                                        </span>
                                                    </md-button>
                                                </md-menu-item>

                                                <md-menu-item ng-if="accion.crear">
                                                    <md-button ng-click="openModalDuplicate(ne)">
                                                        <span md-menu-align-target>
                                                            <i class="ti-files"></i>
                                                            Duplicar
                                                        </span>
                                                    </md-button>
                                                </md-menu-item>

                                                <md-menu-item ng-if="(accion.cobroPago && ne.enabledPayment)">
                                                    <md-button ng-click="opcionCobro(ne)">
                                                        <span md-menu-align-target>
                                                            <i class="ti-shortcode"></i>
                                                            Cobrar
                                                        </span>
                                                    </md-button>
                                                </md-menu-item>


                                                <md-menu-item ng-if="accion.cuota">
                                                    <md-button ng-click="openModalCuota(ne)">
                                                        <span md-menu-align-target>
                                                            <i class="ti-list"></i>
                                                            Cuota
                                                        </span>
                                                    </md-button>
                                                </md-menu-item>


                                                <md-menu-item ng-if="ne.enabledHistorialCobro">
                                                    <md-button btn-historial-cobro params="ne" cod-doc="'NE'"
                                                        on-result="refresh()">
                                                        <span md-menu-align-target>
                                                            <i class="ti-layout-cta-center"></i>
                                                            Historial Cobros
                                                        </span>
                                                    </md-button>
                                                </md-menu-item>

                                                <md-menu-item ng-if="accion.enviarCorreo">
                                                    <md-button action-send-mail params="ne" type-send="typeSendToMail"
                                                        get-param-to-send-mail="getParamToSendMail(params)">
                                                        <span md-menu-align-target>
                                                            <i class="far fa-envelope"></i>
                                                            Enviar Correo
                                                        </span>
                                                    </md-button>
                                                </md-menu-item>

                                                <md-menu-item>
                                                    <md-button uib-tooltip="Enviar por Whatsapp" tooltip-placement="top"
                                                        action-send-to-whats-app params="ne">
                                                        <span md-menu-align-target>
                                                            <i class="mdi mdi-whatsapp"></i> Enviar por Whatsapp
                                                        </span>
                                                    </md-button>
                                                </md-menu-item>


                                                <md-menu-item ng-if="accion.crear && ne.enabledConvertToDoc">
                                                    <md-button btn-convert-to-doc cod-doc="codDoc" id="ne.idDocumento"
                                                        on-result="refresh()">
                                                        <span md-menu-align-target>
                                                            <i class="fas file"></i> Convertir a FV
                                                        </span>
                                                    </md-button>
                                                </md-menu-item>

                                                <md-menu-item ng-if="ne.enabledHistorialConvert">
                                                    <md-button btn-historial-conversion-doc cod-doc="codDoc"
                                                        id="ne.idDocumento">
                                                        <span md-menu-align-target>
                                                            <i class="fas fa-history "></i> Historial Conversión
                                                        </span>
                                                    </md-button>
                                                </md-menu-item>

                                                <md-menu-item>
                                                    <md-button btn-cuenta-por-cobrar params="ne"
                                                        tooltip-placement="top">
                                                        <span md-menu-align-target>
                                                            Cuenta por cobrar
                                                        </span>
                                                    </md-button>
                                                </md-menu-item>

                                            </md-menu-content>
                                        </md-menu>

                                        <button type="button " class="btn btn-secondary btn-sm m-r-10 m-b-5 m-t-5"
                                            ng-click="print(ne)">
                                            <i class="fas fa-print"></i>
                                        </button>

                                        <button type="button" ng-if="accion.reporte"
                                            class="btn btn-secondary btn-sm m-r-10 m-b-5 m-t-5"
                                            ng-click="getReport(ne)">
                                            <i class="fa fa-file-pdf fa-xs"></i>
                                        </button>
                                    </div>
                                </td>
                                @* <td md-cell>{{$index+1}}</td> *@
                                <td md-cell>{{ne.serieComprobante}}</td>
                                <td md-cell>{{ne.fechaEmision}}</td>
                                <td md-cell>{{ne.fechaVencimiento}}</td>
                                <td md-cell>{{ne.razonSocialComprador}}</td>
                                <td md-cell totales-venta-view="ventaPermiso">${{ne.total}}</td>
                                <td md-cell totales-venta-view="ventaPermiso">${{ne.abono}}</td>
                                <td md-cell totales-venta-view="ventaPermiso">${{ne.saldo}}</td>
                                <td md-cell>{{ne.estadoFinanciero}}</td>
                                <td md-cell>{{ne.usuario}}</td>
                            </tr>
                            @* <tr class="text-center" ng-show="notaEntregas.length===0">
                            <td colspan="11">No hay registros</td>
                            </tr> *@
                        </tbody>
                        <tfoot md-foot fixed-tfoot>
                            <tr md-row>
                                <td md-cell colspan="2">
                                    <span class="font-weight-bold">
                                        {{dataSearch.totalRecords}}
                                        Notas de Entregas
                                    </span>
                                </td>
                                <td md-cell colspan="3"><span class="font-weight-bold">Total: </span></td>
                                <td md-cell totales-venta-view="ventaPermiso">
                                    <span class="font-weight-bold">${{total}}</span>
                                </td>
                                <td md-cell totales-venta-view="ventaPermiso">
                                    <span class="font-weight-bold">${{totalAbono}}</span>
                                </td>
                                <td md-cell totales-venta-view="ventaPermiso">
                                    <span class="font-weight-bold">${{totalSaldo}}</span>
                                </td>
                                <td md-cell colspan="3"></td>
                            </tr>
                        </tfoot>
                    </table>
                </md-table-container>
            </div>
        </div>
        <div class="card-body">
            <ul uib-pagination total-items="dataSearch.totalRecords" items-Per-Page="dataSearch.pageSize"
                ng-change="pageChanged()" ng-model="dataSearch.pageIndex" max-size="dataSearch.maxSize"
                class="pagination" boundary-links="true" rotate="false"></ul>
        </div>
    </div>

</div>

@section Scripts {
    <script src="~/js/config/services/solicitudAutorizacionService.min.js" asp-append-version="true"></script>
    <script src="~/js/factElect/directives/factElectDirective.min.js" asp-append-version="true"></script>
    <script src="~/js/ventas/controllers/notaEntregaCtrl.min.js" asp-append-version="true"></script>
    <script src="~/js/contabilidad/components/cuentaPorCobrarComponent.min.js" asp-append-version="true"></script>
    <script src="~/js/common/components/tablaInfoAdicional.min.js" asp-append-version="true"></script>
    <script src="~/js/common/components/modalEliminar.min.js" asp-append-version="true"></script>
}