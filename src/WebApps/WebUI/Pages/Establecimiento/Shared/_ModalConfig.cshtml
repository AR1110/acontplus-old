
<style>
    .drop-box {
        background: #F8F8F8;
        border: 5px dashed #DDD;
        width: 200px;
        height: 100px;
        text-align: center;
        padding-top: 10px;
        /* margin: 10px; */
    }

    .dragover {
        border: 5px dashed blue;
    }
</style>

<div class="modal-header">
    <h5 class="modal-title"><i class="mdi mdi-settings"></i> Config. Establecimiento </h5>
    <button type="button" class="close" ng-click="$ctrl.closeModal()">&times;</button>
</div>

<div class="modal-body">
    <div class="row">

        <div class="col-xl-4 col-lg-4 col-md-12 col-12">
            <div class="card">

                <div class="card-body shadow">
                    <center class="m-t-30">
                        <img ngf-src="$ctrl.file" ng-if="$ctrl.file" ngf-no-object-url="false" class="img-fluid">
                        <div type="file" ng-if="!$ctrl.file"
                             ngf-select="$ctrl.onSave()"
                             ng-model="$ctrl.file"
                             class="drop-box"
                             ngf-drag-over-class="'dragover'"
                             ngf-accept="'image/*'"
                             ngf-validate="{size: {min: 10, max: '20MB'}, width: {min: 100, max:10000}, height: {min: 100, max: 300} ratio: '2x1', duration: {min: '10s', max: '5m'}">
                            Haga clic para cargar imagen.
                        </div>
                        <div class="text-center justify-content-md-center mt-2" ng-if="$ctrl.file">
                            <div class="btn-group" role="group" aria-label="Btn Delete">
                                <button type="button" class="btn btn-danger" ng-click="$ctrl.removeImg()"><i class="far fa-times-circle"></i> Eliminar</button>
                            </div>
                        </div>
                    </center>
                    <div><hr></div>
                    <small class="text-muted">RUC</small>
                    <h6>{{$ctrl.data.ruc}}</h6>

                    <small class="text-muted p-t-30 db">Nombre Comercial</small>
                    <h6>{{$ctrl.data.nombreComercial}}</h6>

                    <small class="text-muted p-t-30 db">Nro. Establecimiento</small>
                    <h6>{{$ctrl.data.estab}}</h6>
                </div>

                @* <div class="card-footer text-center">

                        <button class="btn btn-theme"
                                type="button">+
                        </button>
                    </div>                                      *@

            </div>
        </div>
        <!-- Column -->
        <!-- Column -->
        <div class="col-xl-8 col-lg-8 col-md-12 col-12">
            <md-content>
                <md-tabs class="md-primary" md-center-tabs md-dynamic-height="">
                    <md-tab label="DATOS">
                        <md-content class="md-padding">
                            <div class="row">
                                <div class="col-md-12 col-12 b-r">
                                    <strong>RUC</strong>
                                    <br>
                                    <p class="text-muted">{{$ctrl.data.ruc}}</p>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6 col-12 b-r">
                                    <strong>Npmbre Comercial</strong>
                                    <br>
                                    <p class="text-muted">{{$ctrl.data.nombreComercial}}</p>
                                </div>
                                <div class="col-md-6 col-12 b-r">
                                    <strong>Nro. Establecimiento</strong>
                                    <br>
                                    <p class="text-muted">{{$ctrl.data.estab}}</p>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6  col-12 b-r">
                                    <strong>Tipo Contribuyente</strong><br>
                                    <span class="text-muted" uib-tooltip="{{$ctrl.data.contribuyenteRimpe}}" tooltip-placement="bottom">
                                        {{$ctrl.tipoContribuyente}}
                                    </span>
                                </div>

                                <div class="col-md-6 col-12 b-r">
                                    <strong>Actividad</strong><br>
                                    <p class="text-muted">{{$ctrl.actividadEconomica}}</p>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 col-12 b-r">
                                    <strong>Agente Retención</strong>
                                    <br>
                                    <p class="text-muted">{{$ctrl.data.agenteRetencion}}</p>
                                </div>

                                <div class="col-md-6 col-12 b-r">
                                    <strong>Obliga llevar contabilidad</strong>
                                    <br>
                                    <p class="text-muted">{{$ctrl.data.obligadoContabilidad}}</p>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 col-12 b-r">
                                    <strong>Cantón</strong>
                                    <br>
                                    <p class="text-muted">{{$ctrl.canton}}</p>
                                </div>
                                <div class="col-md-6 col-12 b-r">
                                    <strong>Ubicacion</strong>
                                    <br>
                                    <p class="text-muted">{{$ctrl.data.dirEstablecimiento}}</p>
                                </div>
                            </div>
                        </md-content>
                    </md-tab>

                    <md-tab label="FACT. ELECTRÓNICA">
                        <md-content class="md-padding">
                            <div class="row justify-content-between">
                                <div class="col-lg-4 col-md-6 col-sm-12 col-12">
                                    <label id="autorizacionComprobante">Autorización Comprobante</label>
                                    <md-radio-group ng-model="$ctrl.data.autoSriAuth" ng-change="$ctrl.configSaveFactElect()" aria-labelledby="autorizacionComprobante">
                                        <md-radio-button ng-value="true" class="md-primary">Manual</md-radio-button>
                                        <md-radio-button ng-value="false" class="md-primary">Automática</md-radio-button>
                                    </md-radio-group>
                                </div>
                            </div>

                            <hr />
                        </md-content>
                    </md-tab>

                    <md-tab label="PUNTO EMISION">
                        <md-content class="md-padding">
                            @await Html.PartialAsync("~/Pages/Establecimiento/PuntoEmision/_PuntosEmision.cshtml")
                        </md-content>
                    </md-tab>
                </md-tabs>
            </md-content>
        </div>
        <!-- Column -->
    </div>
</div>

<div class="modal-footer">
    <button type="button" class="btn btn-dark" ng-click="$ctrl.closeModal()">
        &times; Cerrar
    </button>
</div>