@page
@model IndexModel
@{
    ViewData["Title"] = "Index";
}

<div class="row page-titles">
    <div class="col-md-5 align-self-center">
        <h4 class="text-themecolor">Dashboard</h4>
    </div>
    <div class="col-md-7 align-self-center text-right">
        <div class="d-flex justify-content-end align-items-center">
            <ol class="breadcrumb">
            </ol>
        </div>
    </div>
</div>


<!-- ============================================================== -->
<div ng-controller="homeCtrl">
    <div class="card-group" ng-cloak>
        <div class="card">
            <div class="card-body">


                <a href="/Usuario/Index">
                    <div class="row">
                        <div class="col-md-12">
                            <div class="d-flex no-block align-items-center">
                                <div>
                                    <h3><i class="ti-user"></i></h3>
                                    <p class="text-muted">Usuarios</p>
                                </div>
                                <div class="ml-auto">
                                    <h2 class="counter text-primary">{{cantidad.cantidadUsuario}}</h2>
                                </div>
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="progress">
                                <div class="progress-bar bg-primary" role="progressbar" style="width: 85%; height: 6px;"
                                     aria-valuenow="25" aria-valuemin="0" aria-valuemax="100"></div>
                            </div>
                        </div>
                    </div>
                </a>
            </div>
        </div>
        <!-- Column -->
        <!-- Column -->
        <div class="card">
            <div class="card-body">
                <a href="/Compras/Proveedor/Index">
                    <div class="row">
                        <div class="col-md-12">
                            <div class="d-flex no-block align-items-center">
                                <div>
                                    <h3><i class="ti-download"></i></h3>
                                    <p class="text-muted">Proveedores</p>
                                </div>
                                <div class="ml-auto">
                                    <h2 class="counter text-cyan">{{cantidad.cantidadProveedor}}</h2>
                                </div>
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="progress">
                                <div class="progress-bar bg-cyan" role="progressbar" style="width: 85%; height: 6px;"
                                     aria-valuenow="25" aria-valuemin="0" aria-valuemax="100"></div>
                            </div>
                        </div>
                    </div>
                </a>
            </div>
        </div>
        <!-- Column -->
        <!-- Column -->
        <div class="card">
            <div class="card-body">
                <a href="/Cliente/Index">
                    <div class="row">
                        <div class="col-md-12">
                            <div class="d-flex no-block align-items-center">
                                <div>
                                    <h3><i class="ti-upload"></i></h3>
                                    <p class="text-muted">Clientes</p>
                                </div>
                                <div class="ml-auto">
                                    <h2 class="counter text-purple">{{cantidad.cantidadCliente}}</h2>
                                </div>
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="progress">
                                <div class="progress-bar bg-purple" role="progressbar" style="width: 85%; height: 6px;"
                                     aria-valuenow="25" aria-valuemin="0" aria-valuemax="100"></div>
                            </div>
                        </div>
                    </div>
                </a>
            </div>
        </div>
        <!-- Column -->
        <!-- Column -->
        <div class="card">
            <div class="card-body">
                <a href="/Articulo/Index">
                    <div class="row">
                        <div class="col-md-12">
                            <div class="d-flex no-block align-items-center">
                                <div>
                                    <h3><i class="ti-shopping-cart-full"></i></h3>
                                    <p class="text-muted">Articulos</p>
                                </div>
                                <div class="ml-auto">
                                    <h2 class="counter text-success">{{cantidad.cantidadArticulo}}</h2>
                                </div>
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="progress">
                                <div class="progress-bar bg-success" role="progressbar" style="width: 85%; height: 6px;"
                                     aria-valuenow="25" aria-valuemin="0" aria-valuemax="100"></div>
                            </div>
                        </div>
                    </div>
                </a>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <div class="row">
                        <!-- Column -->
                        <div class="col-md-6 col-lg-3 col-xlg-3">
                            <div class="card">
                                <a href="/Factura/Index">
                                    <div class="box bg-info text-center">
                                        <h1 class="font-light text-white"><i class="fa fa-file-invoice-dollar"></i></h1>
                                        <h6 class="text-white">Factura Venta</h6>
                                    </div>
                                </a>
                            </div>
                        </div>
                        <!-- Column -->
                        <div class="col-md-6 col-lg-3 col-xlg-3">
                            <div class="card">
                                <a href="/NotaEntrega/Index">
                                    <div class="box bg-primary text-center">
                                        <h1 class="font-light text-white"><i class="fa fa-money-bills"></i></h1>
                                        <h6 class="text-white">Nota Entrega</h6>
                                    </div>
                                </a>
                            </div>
                        </div>
                        <!-- Column -->
                        <div class="col-md-6 col-lg-3 col-xlg-3">
                            <div class="card">
                                <a href="/Proforma/Index">
                                    <div class="box bg-success text-center">
                                        <h1 class="font-light text-white"><i class="fa fa-money-bill-transfer"></i></h1>
                                        <h6 class="text-white">Proforma</h6>
                                    </div>
                                </a>
                            </div>
                        </div>
                        <div class="col-md-6 col-lg-3 col-xlg-3">
                            <div class="card">
                                <a href="/ConsultarPrecio/Index">
                                    <div class="box bg-purple text-center">
                                        <h1 class="font-light text-white"><i class=" fas fa-donate fa-lg"></i></h1>
                                        <h6 class="text-white">Consultar Precio</h6>
                                    </div>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row" ng-show="emittedDocuments.length > 0 || receivedDocuments.length > 0 || anotherSalesDocuments.length > 0 ">
        <div class="col-xl-4 col-lg-4 col-md-4 col-sm-6 col-12" ng-show="emittedDocuments.length > 0">
            <div class="card">
                <div class="card-body w-100">
                    <canvas id="documentChart"></canvas>
                </div>
                <div class="card-footer">
                    <a href="/FactElect/DocumentoElectronico/Index" title="Ir a Documentos Emitidos"><i class="fa fa-sign-in"></i> </a>
                </div>
            </div>
        </div>
        <div class="col-xl-4 col-lg-4 col-md-4 col-sm-6 col-12" ng-show="receivedDocuments.length > 0">
            <div class="card">
                <div class="card-body w-100">
                    <canvas id="documentReceivedChart"></canvas>
                </div>
                <div class="card-footer">
                    <a href="/Compras/DocumentoRecibido/Index" title="Ir a Documentos Recibidos"><i class="fa fa-sign-in"></i> </a>
                </div>
            </div>
        </div>
        <div class="col-xl-4 col-lg-4 col-md-4 col-sm-6 col-12" ng-show="anotherSalesDocs.length > 0">
            <div class="card">
                <div class="card-body w-100">
                    <canvas id="anotherSalesDocsChart"></canvas>
                </div>
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <script src="~/js/controllers/homeCtrl.js" asp-append-version="true"></script>
}