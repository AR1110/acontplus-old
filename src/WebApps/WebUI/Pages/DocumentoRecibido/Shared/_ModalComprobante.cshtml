<div class="modal-header">
    <h4 class="modal-title">
        <i class="ti-upload"></i> {{comprobanteName}}
    </h4>
    <button type="button" class="close" aria-label="Close" ng-click="closeMainModal()">
        <span aria-hidden="true">&times;</span>
    </button>
</div>
<div class="modal-body">
    <div class="row border">
        <div class="col-xl-7 col-lg-7col-md-7 col-sm-7 col-12 mb-2">
            <div class="form-group">
                <label>Proveedor:</label>
                <input maxlength="300" class="form-control" required name="description"
                    ng-model="infoTributaria.razonSocial" disabled>
            </div>
            <div class="form-group">
                <label>Dirección Matriz:</label>
                <input required class="form-control" name="dirMatriz" ng-model="infoTributaria.dirMatriz" disabled>
            </div>
            <div class="form-group">
                <label>Dir. Establecimiento:</label>
                <h5>{{infoComprobante.dirEstablecimiento}}</h5>
            </div>
            <div class="form-group">
                <label>Obligado Contabilidad:</label>
                <h5>{{infoComprobante.obligadoContabilidad}}</h5>
            </div>

            @* <button type="button" id="btnProv" ng-disabled="btnProvIsEnable" ng-click="addProvClient()"
                class="btn btn-success btn-sm">
                <icon class="ti-save"></icon> Guardar Proveedor
            </button> *@
            <button type="button" id="btnProv" ng-disabled="btnProvIsEnable" btn-proveedor-add-update params="provCliente" result-modal="resultModalProveedor(result)"
                class="btn btn-success btn-sm">
                <icon class="ti-save"></icon> Guardar Proveedor
            </button>
        </div>
        <div class="col-xl-5 col-lg-5 col-md-5 col-sm-5 col-12">
            <div class="form-group">
                <label>Nro. Documento:</label>
                <h5>
                    {{selected[0].comprobante}} {{infoTributaria.estab}} - {{infoTributaria.ptoEmi}}
                    - {{infoTributaria.secuencial}}
                </h5>
            </div>
            <div class="form-group">
                <label>Ruc:</label>
                <input required name="ruc" class="form-control" ng-model="infoTributaria.ruc" disabled>
            </div>
            <div class="form-group">
                <label>Nro. Autorización:</label>
                <input required name="ruc" class="form-control" ng-model="infoTributaria.claveAcceso" disabled>
            </div>
            <div class="form-group">
                <label>Fecha Emisión:</label>
                <input required name="ruc" class="form-control" ng-model="infoComprobante.fechaEmision" disabled>
            </div>
        </div>
    </div>
    <hr>
    <div class="row" ng-if="fullComprobante.codDoc == '04'">
        <div class="col-xl-4 col-lg-4 col-md-4 col-sm-4 col-4">
            <h5>
                <label for="">Comprobante que se modifica: </label>
            </h5>
        </div>
        <div class="col-xl-4 col-lg-4 col-md-4 col-sm-4 col-4">
            <h5>
                {{infoComprobante.codDocModificado}}
            </h5>
        </div>
        <div class="col-xl-4 col-lg-4 col-md-4 col-sm-4 col-4">
            <h5>
                {{infoComprobante.numDocModificado}}
            </h5>
        </div>
    </div>

    <div class="row" ng-if="fullComprobante.codDoc == '04'">
        <div class="col-xl-6 col-lg-6 col-md-6 col-sm-6 col-6">
            <h5>
                <label for="">Fecha Emisión comprobante a modificar: </label>
            </h5>
        </div>
        <div class="col-xl-4 col-lg-4 col-md-4 col-sm-4 col-4">
            <h5>
                {{infoComprobante.fechaEmisionDocSustento}}
            </h5>
        </div>
    </div>
    <div class="row">
        <div class="col-xl-6 col-lg-6 col-md-6 col-sm-6 col-6">
            <h5>
                <label for="">Razón de Modificación: </label>
            </h5>
        </div>
        <div class="col-xl-4 col-lg-4 col-md-4 col-sm-4 col-4">
            <h5>
                {{infoComprobante.motivo}}
            </h5>
        </div>
    </div>
