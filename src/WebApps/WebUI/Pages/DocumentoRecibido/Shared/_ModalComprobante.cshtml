                <tr ng-repeat="item in tempDetail" class="small">
                    <td class="text-center">
                        <md-button ng-if="!(item.idArticulo > 0 && item.idProveedor > 0)" class="md-icon-button"
                            ng-click="openMerge(item)" aria-label="Unir" title="Unir">
                            <md-icon md-font-set="md" class="text-info">sync_alt</md-icon>
                        </md-button>
                        <md-button ng-if="(item.idArticulo > 0 && item.idProveedor > 0)" class="md-icon-button"
                            ng-click="getArticleHistory(item)" aria-label="Historial"
                            title="Historial de ingresos de facturas">
                            <md-icon md-font-set="md" class="text-danger">shopping_cart</md-icon>
                        </md-button>
                        <md-button 
                            ng-if="(item.idArticulo > 0 && item.idProveedor > 0)" 
                            class="md-icon-button" 
                            btn-articulo-historial-compra
                            resultModal="getArticleHC(result)"
                            params = "item"
                            aria-label="Historial" 
                            title="Historial de vinculación">
                            <md-icon md-font-set="md" class="text-info">history</md-icon>
                        </md-button>
                        <md-button ng-if="(item.idDocumentoDetalle == 0 && item.idArticulo > 0 && selected[0].complete)"
                            class="md-icon-button" ng-click="askToAddStok(item)" aria-label="Stock"
                            title="Añadir a stock">
                            <md-icon md-font-set="md" class="text-success">inventory</md-icon>
                        </md-button>
                        <md-button ng-if="(item.idDocumentoDetalle > 0 && selected[0].complete)" class="md-icon-button"
                            ng-click="askToDeleteStok(item)" aria-label="Stock" title="Eliminar del stock">
                            <md-icon md-font-set="md" class="text-danger">delete_forever</md-icon>
                        </md-button>

                        <md-button ng-if="item.idArticulo > 0" class="md-icon-button md-primary" btn-article-add-update params="item" result-modal="resultModalArticleEdit(result)" aria-label="Editar Artículo" title="Editar Artículo">
                            <md-icon md-font-set="md">edit_forever</md-icon>
                        </md-button>

                        <md-button ng-if="item.idArticulo > 0 && item.datosAdicionales && selected[0].codDoc=='01'"
