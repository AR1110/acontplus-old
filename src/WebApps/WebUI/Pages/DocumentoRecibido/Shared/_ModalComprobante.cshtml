                    <th class="text-center">Costo Neto</th>
                    <th class="text-center">Descuento</th>
                    <th class="text-center">Imp.</th>
                    <th class="text-center">Valor Imp.</th>
                    <th class="text-center">Total</th>
                </tr>
            </thead>
