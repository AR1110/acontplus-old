        <div class="col-xl-4 col-lg-4 col-md-4 col-sm-4 col-12">
            <div class="row justify-content-start">
                <div class="col-xl-6 col-lg-6 col-md-6 col-sm-6 col-12">
                    <div class="form-group">
                        <label for="idBodega">Aplicar Bodega para todos:</label>
                        <select id="idBodega" class="form-control" ng-model="comprobanteForm.idBodega"
                            ng-change="addBodega()" required>
                            <option></option>
                            <option ng-value="item.idBodega" ng-repeat="item in bodegasFiltered">
                                {{item.descripcion}}
                            </option>
                        </select>
                    </div>
                </div>

                <div class="col-xl-6 col-lg-6 col-md-6 col-sm-6 col-12">
                    <div class="form-group">
                        <label for="sizeAll">Aplicar Medida para todos</label>
                        <select class="form-control" ng-model="articleSize" ng-change="updateSizeArticles(articleSize)">
                            <option ng-value="size.idMedida" ng-repeat="size in medidas"
                                ng-selected="size.idMedida == articleSize">
                                {{size.descripcion}}
                            </option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-4 col-lg-4 col-md-4 col-sm-4 col-12">
            <div class="row justify-content-end">
                <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">
                    <div class="form-group">
                        <button type="button" ng-if="selected[0].complete" class="btn btn-success btn-lg mt-4"
                            ng-click="exportToExcel()">
                            <i class="fas fa-file-excel"></i> Exportar Articulos
                        </button>
                    </div>
                </div>
            </div>
        </div>

    </div>
    <div class="table-responsive">
        <table class="table table-bordered">
            <caption></caption>
            <thead>
                <tr class="small">
                    <th class="text-center"><i class="ti-settings"></i></th>
                    <th class="text-center">Cant.</th>
                    <th class="text-center">Cód. Principal</th>
                    <th class="text-center">Cód. Auxiliar</th>
