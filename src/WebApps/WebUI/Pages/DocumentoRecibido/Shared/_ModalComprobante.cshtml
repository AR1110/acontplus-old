                            aria-label="Datos Adicionales" title="Datos Adicionales">
                            @* <md-icon md-font-set="md">pen-plus_forever</md-icon> *@
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><title>Añadir/Editar datos adicionales</title><path d="M20.7,7C20.4,7.4 20,7.7 20,8C20,8.3 20.3,8.6 20.6,9C21.1,9.5 21.6,9.9 21.5,10.4C21.5,10.9 21,11.4 20.5,11.9L16.4,16L15,14.7L19.2,10.5L18.2,9.5L16.8,10.9L13,7.1L17,3.3C17.4,2.9 18,2.9 18.4,3.3L20.7,5.6C21.1,6 21.1,6.7 20.7,7M3,17.2L12.6,7.6L16.3,11.4L6.8,21H3V17.2M7,2V5H10V7H7V10H5V7H2V5H5V2H7Z" /></svg>
                        </md-button>
                    </td>
                    <td class="text-center">{{item.cantidad}}</td>
                    <td class="text-center">{{item.codigoPrincipal}}</td>
                    <td class="text-center">{{item.codigoAuxiliar}}</td>
                    <td>{{item.descripcion}}</td>
                    <td>
                        <div style="position:relative; min-width:100px;">
                            <select class="form-control" ng-model="item.idMedida" ng-change="updateArticleTemp(item)">
                                <option ng-value="size.idMedida" ng-repeat="size in medidas">
                                    {{size.descripcion}}
                                </option>
                            </select>
                        </div>
                    </td>
                    <td class="text-right">{{item.precioUnitario | currency}}</td>
                    <td class="text-right">{{item.costoNeto | currency}}</td>
                    <td class="text-right">{{item.descuento | currency}}</td>
                    <td class="text-right">{{item.impuesto}}</td>
                    <td class="text-right">{{item.valorImpuesto | currency}}</td>
                    <td class="text-right">{{item.precioTotalSinImpuesto | currency}}</td>

                </tr>
            </tbody>
        </table>
    </div>
