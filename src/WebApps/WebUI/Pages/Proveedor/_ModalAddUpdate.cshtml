<form autocomplete="off" ng-submit="onSave()">
    <div class="modal-header">
        <h5 class="modal-title">{{tipoRegistro==1?'Nuevo':'Editar'}} Proveedor</h5>
        <button type="button" class="close" ng-click="closeModal()">&times;</button>
    </div>

    <div class="modal-body">
        <uib-tabset active="activeForm">
            <uib-tab index="0">
                <uib-tab-heading>
                    <i class="mdi mdi-account-circle"></i> Datos Generales
                </uib-tab-heading>
                <div class="card">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-xl-6 col-lg-6 col-sm-12 col-12">
                                <div class="form-group">
                                    <label for="tipoIdentificacion">Tipo Identificación: <span class="text-danger">*</span></label>

                                    <div class="input-group mb-3">
                                        <div class="input-group-prepend">
                                            <select class="form-control border-select" id="tipoIdentificacion" name="tipoIdentificacion"
                                                    ng-model="data.idTipoIdentificacion" ng-change="onChangeTipoIdentificacion()">
                                                <option ng-value="item.idTipoIdentificacion" ng-repeat="item in tiposIdentificacion">
                                                    {{item.descripcion}}
                                                </option>
                                            </select>
                                        </div>
                                        <input 
                                            type="text"
                                            id="numeroIdentificacionCedulaRUC" 
                                            valid-number 
                                            ng-model="data.numeroIdentificacion" 
                                            ng-keyup="onKeyupNumeroIdentificacion()"
                                            class="form-control border-select" 
                                            onClick="select();"
                                            placeholder="...">
                                        <input type="text" onClick="select();" id="numeroIdentificacionPasaporte" ng-model="data.numeroIdentificacion" class="form-control border-select" placeholder="Ej: ED12DG34">

                                    </div>
                                    <div class="d-flex justify-content-end">
                                        <small class="text-danger">{{numeroIdentificacionValidationMessage}}</small>
                                    </div>
                                </div>
                            </div>
                            <div class="col-xl-6 col-lg-6 col-sm-12 col-12">
                                <div class="form-group">
                                    <label>Contribuyente <span class="text-danger">*</span></label>
                                    <select class="form-control border-select" ng-model="data.idSubContribuyente"
                                            required="required">
                                        <option ng-value="item.idSubContribuyente" ng-repeat="item in subcontribuyentes">
                                            {{item.descripcion}}
                                        </option>

                                    </select>
                                </div>
                            </div>

                        </div>

                        <!--Nombre Fiscal-->
                        <div class="row">
                            <div class="col-lg-6 col-md-6 col-sm-12 col-12">
                                <div class="form-group">
                                    <label>Nombre Fiscal <span class="text-danger">*</span></label>
                                    <input type="text" touppercase class="form-control border-select" autocomplete="off"
                                           name="nombreFiscal" ng-model="data.nombreFiscal"
                                           ng-keyup="onKeyupNombreFiscal()" required placeholder="Ej: TECNOMEGA" />
                                </div>
                            </div>
                            <div class="col-lg-6 col-md-6 col-sm-12 col-12">
                                <div class="form-group">
                                    <label>Nombre Comercial <span class="text-danger">*</span></label>
                                    <input type="text" touppercase class="form-control border-select" autocomplete="off"
                                           ng-model="data.nombreComercial" placeholder="Ej: TECNOMEGA" />
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-xl-6 col-md-6 col-sm-6 col-12">
                                <div class="form-group">
                                    <label>Email: </label>
                                    <md-chips ng-model="correos" ng-keyup="onKeyupEmail($event)"
                                              md-transform-chip="tranformMdChipsEmail($chip)" md-removable="true"
                                              md-enable-chip-edit="true" md-add-on-blur="true" placeholder="Ej: maxi@gmail.com"
                                              input-aria-label="Correos"></md-chips>
                                </div>
                            </div>
                            <div class="col-xl-6 col-md-6 col-sm-6 col-12">
                                <div class="form-group">
                                    <label>Telefono: </label>
                                    <md-chips ng-model="telefonos" md-transform-chip="transformC($chip)"
                                              md-removable="true" md-enable-chip-edit="true" md-add-on-blur="true"
                                              placeholder="Ej: 0959889744" input-aria-label="Número de teléfonos"></md-chips>
                                </div>
                            </div>
                        </div>


                        <div class="row">
                            <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">
                                <div class="form-group">
                                    <label>Dirección</label>
                                    <textarea class="form-control border-select" touppercase ng-model="data.direccion"
                                              rows="2" placeholder="AV. 09 DE OCTUBRE..."></textarea>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>

            </uib-tab>
            <uib-tab index="1">
                <uib-tab-heading>
                    <i class="mdi mdi-note-plus-outline"></i> Adicional
                </uib-tab-heading>
                <div class="card">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-lg-4 col-md-4 col-sm-6 col-12">
                                <div class="form-group">
                                    <label>Tipo Proveedor: </label>
                                    <select class="form-control border-select" ng-model="data.idTipoClienteProveedor">
                                        <option ng-value="item.idTipoClienteProveedor"
                                                ng-repeat="item in tiposProveedor">{{item.descripcion}}</option>
                                    </select>
                                </div>
                            </div>

                            <div class="col-lg-4 col-md-4 col-sm-6 col-12">
                                <div class="form-group">
                                    <label>Ciudad: </label>
                                    <select class="form-control border-select" ng-model="data.idCiudad"
                                            ng-options="c.idCiudad as c.ciudad group by c.provincia for c in ciudades">
                                    </select>
                                </div>
                            </div>

                            <div class="col-lg-4 col-md-4 col-sm-6 col-12">
                                <div class="form-group">
                                    <label>Tipo Entidad: </label>
                                    <select class="form-control border-select" ng-model="data.idTipoEntidad">
                                        <option ng-value="item.idTipoEntidad" ng-repeat="item in tiposEntidad">
                                            {{item.descripcion}}
                                        </option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-lg-4 col-md-4 col-sm-6 col-12">
                                <div class="form-group">
                                    <label>Tiempo de Credito</label>
                                    <div class="input-group">
                                        <select class="form-control border-select" ng-model="data.idTiempoCredito">
                                            <option ng-value="item.idTiempoCredito"
                                                    ng-repeat="item in tiemposCredito">{{item.descripcion}}</option>
                                        </select>
                                        <div class="input-group-append">
                                            <button type="button" class="btn btn-warning"
                                                    ng-click="refreshTiempoCredito()">
                                                <i class="fas fa-redo fa-xs"></i>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-xl-4 col-lg-4 col-md-4 col-sm-4 col-12 text-center"
                                 ng-show="tipoRegistro==2">
                                <div class="form-group">
                                    <label>Estado</label> <br>
                                    <div class="radio icheck-primary icheck-inline">
                                        <input type="radio" ng-model="data.estado" ng-value="true" id="estadoActivo"
                                               name="estadoActivo" />
                                        <label for="estadoActivo">Activo</label>
                                    </div>
                                    <div class="radio icheck-primary icheck-inline">
                                        <input type="radio" ng-model="data.estado" ng-value="false"
                                               id="estadoInactivo" name="estadoInactivo" />
                                        <label for="estadoInactivo">Inactivo</label>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </uib-tab>
        </uib-tabset>
    </div>
    <div class="modal-footer">
        <button type="submit" class="btn btn-success">
            <i class="{{tipoRegistro==1?'ti-save':'ti-pencil'}}"></i>
            {{tipoRegistro==1?'Guardar':'Actualizar'}}
        </button>
        <button type="button" class="btn btn-dark" ng-click="closeModal()">&times; Cerrar</button>
    </div>
</form> 