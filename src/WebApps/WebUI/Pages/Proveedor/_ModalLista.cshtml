 <div class="modal-header">
    <h5 class="modal-title" > Lista Proveedores</h5>
    <button type="button" class="close" ng-click="closeModal()">&times;</button>
</div>                
<div class="modal-body">
    <div class="d-flex justify-content-between">
                        <div class="col-3">
                            <span class="form-group pull-left page-size form-inline">
                                <select class="form-control border-color control-color" ng-model="dataSearch.pageSize"
                                        ng-change="changePageSize()" ng-options="ra for ra in recordsQuantity">
                                </select>
                            </span>
                        </div>
                        <div class="col-lg-3 col-md-6 col-sm-12 col-12">
                            <form class="form-material">
                                <div class="input-group">
                                    <input type="text" class="form-control" ng-model="dataSearch.textSearch" ng-keyup="onKeyupSearchProveedor()" placeholder="Buscar Proveedor" />
                                    <div class="input-group-append" ng-click="reloadProveedores()">
                                        <button class="btn btn-info">
                                            <i class="fas fa-redo"></i>
                                        </button>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>

    <md-table-container md-scroll-y layout-fill style=" max-height: 400px;">
        <table md-table md-row-select="true"  ng-model="selected">
            <thead md-head >
                <tr md-row>                                                     
                    <th md-column>N°</th>
                    <th md-column>RUC</th>
                    <th md-column>Nombre Fiscal</th>
                    <th md-column>Dirección</th>
                    <th md-column>Teléfono</th>
                    <th md-column>Estado</th>                    
                </tr>
            </thead>
            <tbody md-body>
                <tr md-row md-select="item" md-on-select="selectedCustomer" md-auto-select="true"  ng-repeat="item in proveedores">                                                       
                    <td md-cell>{{$index+1}}</td>
                    <td md-cell>{{item.numeroIdentificacion}}</td>
                    <td md-cell>{{item.nombreFiscal}}</td>
                    <td md-cell>{{item.direccion}}</td>
                    <td md-cell>{{item.telefono}}</td>
                    <td md-cell ng-bind-html="item.estado|estadoPrimario"></td>                               
                </tr>
                <tr ng-show="proveedores.length==0" class="text-center">
                    <td colspan="6">
                        No hay registros en esta tabla :)
                    </td>
                </tr>
            </tbody> 
        </table>
    </md-table-container>  
     <ul uib-pagination total-items="totalRecords" items-Per-Page="dataSearch.pageSize"
                                            ng-change="pagechanged()" ng-model="dataSearch.pageIndex" max-size="maxSize"
                                            class="pagination" boundary-links="true" rotate="false"></ul>
</div>
<div class="modal-footer">                    
    <button type="button" class="btn btn-dark" ng-click="closeModal()">&times; Cerrar</button>
</div>  