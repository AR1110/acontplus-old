<div class="modal-header">
    <h5 class="modal-title">
        <icon class="mdi mdi-table"></icon> Clientes
    </h5>
    <button class="close" ng-click="closeModal()">&times;</button>
</div>
<div class="modal-body">


    <div class="row justify-content-between">
        <div class="col-xl-4 col-lg-4 col-md-12 col-sm-12 col-12">
            <button type="button" class="btn btn-info btn-sm" btn-cliente result-modal="resultModal(result)">
                <icon class="mdi mdi-plus"></icon> Nuevo
            </button>
        </div>

        <div class="col-xl-4 col-lg-4 col-md-12 col-sm-12 col-12">
            <form class="form-material" autocomplete="off">
                <div class="input-group">
                    <input type="text" class="form-control form-control-sm" id="searchCliente"
                        ng-model="dataSearch.textSearch" ng-keyup="onKeyupSearchCliente()"
                        placeholder="Buscar Cliente" />
                    <div class="input-group-append">
                        <button type="button" class="btn btn-secondary btn-sm" uib-tooltip="Recargar"
                            tooltip-placement="top" ng-click="resetList()">
                            <i class="fas fa-undo"></i>
                        </button>
                        <button type="button" class="btn btn-warning btn-sm" uib-tooltip="Copiar"
                            tooltip-placement="top" ng-click="copyTextSearch()">
                            <i class="mdi mdi-content-copy"></i>
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>


    <md-table-container md-scroll-y layout-fill style=" max-height: 400px;">
        <table md-table md-row-select="true" ng-model="selected">
            <thead md-head>
                <tr md-row>
                    <th md-column></th>
                    <th md-column>N°</th>
                    <th md-column>RUC</th>
                    <th md-column>Nombre Fiscal</th>
                    <th md-column>Dirección</th>
                    <th md-column>Teléfono</th>
                    <th md-column>Estado</th>
                </tr>
            </thead>
            <tbody md-body>
                <tr md-row md-select="c" md-on-select="seleccionarCliente" md-auto-select="false"
                    ng-repeat="c in clientes">
                    <td md-cell>
                        <button type="button" class="btn btn-info btn-xs" btn-cliente result-modal="resultModal(result)"
                            params="c">
                            <i class="mdi mdi-pencil"></i>
                        </button>
                    </td>
                    <td md-cell>{{$index+1}}</td>
                    <td md-cell>{{c.numeroIdentificacion}}</td>
                    <td md-cell>{{c.nombreFiscal}}</td>
                    <td md-cell>{{c.direccion}}</td>
                    <td md-cell>{{c.telefono}}</td>
                    <td md-cell ng-bind-html="c.estado|estadoPrimario"></td>
                </tr>
                <tr ng-show="clientes.length==0" class="text-center">
                    <td colspan="7">
                        No hay registros en esta tabla :)
                    </td>
                </tr>
            </tbody>

        </table>
    </md-table-container>


    <div class="pull-left m-t-5 m-l-10">
        <ul uib-pagination total-items="dataSearch.totalRecords" items-Per-Page="dataSearch.pageSize"
            ng-change="pagechanged()" ng-model="dataSearch.pageIndex" max-size="dataSearch.maxSize" class="pagination"
            boundary-links="true" rotate="false"></ul>
    </div>

</div>
<div class="modal-footer">
    <button type="button" class="btn btn-dark btn-sm" ng-click="closeModal()">&times; Cerrar</button>
</div>