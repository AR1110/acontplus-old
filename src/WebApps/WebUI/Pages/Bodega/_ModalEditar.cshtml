
<form ng-submit="onSave()" autocomplete="off" novalidate>    
    <div class="modal-header bg-info text-white">
        <h5 class="modal-title">Editar Bodega</h5>
        <button type="button" class="close" ng-click="closeModal()">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
    <div class="modal-body">
        <div class="row">
            <div class="col-lg-12 col-md-12 col-sm-12 col-12">
                <div class="form-group">
                    <label for="">Establecimiento: <span class="text-danger">*</span> </label>
                    <select class="form-control border-select" ng-model="data.codEstab" disabled>
                            <option ng-value="item.codEstab" ng-repeat="item in sucursales">
                                {{item.nombreComercial}}
                            </option>
                    </select>
                </div>
            </div>
            
            <div class="col-lg-12 col-md-12 col-sm-12 col-12">
                <div class="form-group">
                    <label for="">Descripción: <span class="text-danger">*</span> </label>
                    <input type="text" ng-model="data.descripcion" touppercase class="form-control border-select" placeholder="BODEGA PRINCIPAL">
                </div>
            </div>

            <div class="col-lg-12 col-md-12 col-sm-12 col-12">
                <div class="form-group">
                    <label for="telefono">Teléfono </label>
                    <input type="text" ng-model="data.telefono" class="form-control border-select" valid-number placeholder="0959889748">
                </div>
            </div>

            <div class="col-lg-12 col-md-12 col-sm-12 col-12">
                <div class="form-group">
                    <label for="direccion">Dirección </label>
                    <textarea name="textarea" ng-model="data.direccion" touppercase class="form-control border-select" placeholder="AV. 09 DE OCTUBRE"></textarea>
                </div>
            </div>

            <div class="col-lg-12 col-md-12 col-sm-12 col-12" ng-if="showEstado">
                <div class="form-group">
                    <label for="">Estado: </label>
                    <md-radio-group ng-model="data.estado">
                        <md-radio-button ng-value="true">Activo</md-radio-button>
                        <md-radio-button ng-value="false">Inactivo</md-radio-button>
                    </md-radio-group>
                </div>
            </div>
        </div>                                                       
    </div>
    <div class="modal-footer">
        <button type="submit" class="btn btn-info">
            <i class="ti-pencil"></i> 
            Actualizar
        </button>
        <button type="button" class="btn btn-dark" ng-click="closeModal()">&times; Cerrar</button>
    </div>
    
</form>

           