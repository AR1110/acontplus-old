<div class="card border border-info rounded">
    <div class="card-body">
        <h5 class="card-title">Info Adicional</h5>
        <div class="row">
            <div class="col-xl-3 col-lg-3 col-md-3 col-sm-4 col-3">
                <div class="form-group">
                    <label for="nombre">Nombre:</label>
                    <input type="text" name="nombre" id="nombre" class="form-control"
                        ng-model="additionalInfo.nombre" />
                </div>
            </div>
            <div class="col-xl-7 col-lg-7 col-md-7 col-sm-6 col-9">
                <div class="form-group">
                    <label for="valor">Valor:</label>
                    <input type="text" name="valor" id="valor" class="form-control" ng-model="additionalInfo.valor" />
                </div>
            </div>
        </div>
        <button type="button" id="btnAddInfoAdd" class="btn btn-info" ng-click="addAdditionalInfo()"><i
                class="ti-plus"></i>
            Añadir</button>
        <button type="button" id="btnEditInfoSave" class="btn btn-info" ng-click="updateAdditionalInfo()"
            style="display:none"><i class="ti-save"></i>
            Guardar</button>
        <hr>
        <div class="table-responsive" ng-if="infoAdded.length > 0">
            <table class="table">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Valor</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    <tr ng-repeat="item in infoAdded">
                        <td>{{item.nombre}}</td>
                        <td>{{item.valor}}</td>
                        <td>
                            <button class="btn btn-warning btn-sm" ng-click="editAdditionalInfo($index)"
                                ng-if="item.idRetAtsInfoAdicional > 0"><i class="ti-pencil"></i></button>
                            <button class="btn btn-danger btn-sm" ng-click="askToDeleteAdditionalInfo($index, item)"><i
                                    class="ti-trash"></i></button>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>