<div class="modal-header">
    <h5 class="modal-title">Documentos</h5>
    <button type="button" class="close" ng-click="closeModal()">&times;</button>
</div>
<div class="modal-body">
     
    <div class="row">
        <div class="col-xl-4 col-lg-4 col-md-6 col-sm-6 col-12">
            <label for="date-range-filter">Rango Fechas: </label>
                        <div class="input-group">
                            <div class="input-group-prepend">
                                <div class="input-group-text">
                                    <div class="custom-control custom-checkbox mr-sm-2">
                                        <input type="checkbox" ng-model="dataSearch.checkBoxDate"  class="custom-control-input"
                                            id="checkBoxDate">
                                        <label class="custom-control-label" for="checkBoxDate"></label>
                                    </div>
                                </div>
                            </div>

                            <date-range-filter current-date="dataSearch.fechaInicio"
                                start-date="dataSearch.fechaInicio" end-date="dataSearch.fechaFin"
                                result-range-date="resultRangeFilter(result)"></date-range-filter>
                        </div>
        </div>
            <div class="col-xl-4 col-lg-4 col-md-6 col-sm-12 col-12">
            <div class="form-group">
                <label for="tipoDocumento">Tipo Documento: </label>
                <select class="form-control border-select" ng-model="dataSearch.codDoc"
                        ng-change="getDocs()"  id="tipoDocumento" name="tipoDocumento">
                        <option ng-value="item.codigo" ng-repeat="item in tiposDoc">
                            {{item.descripcion}}
                        </option>
                </select>
            </div>
        </div>
        <div class="col-xl-4 col-lg-4 col-md-6 col-sm-12 col-12">
            <div class="form-group">
                <label for="nroDocumento">Buscar por Nro. Documento:</label>
                <div class="input-group">
                    <input type="text" 
                        class="form-control border-select" 
                        id="nroDocumento" 
                        name="tipoDocumento"
                        placeholder="Ej: 12 o 12-10"
                        ng-enter="getDocs()"
                        ng-model="dataSearch.nroSecuencial"
                        >
                    <div class="input-group-append">
                        <button type="button" class="btn btn-info btn-sm" ng-click="getDocs()">
                            <i class="fas fa-redo"></i>
                        </button>
                    </div>
                </div>
            
            </div>
        </div>
    </div> 

    <div class="row">
        <div class="col-6 d-flex justify-content-start">
            <span class="form-group pull-left page-size form-inline">
                <select class="form-control control-color" ng-model="dataSearch.pageSize"
                    ng-change="changePageSize()" ng-options="ra for ra in recordsQuantity">
                </select>
            </span>
        </div>

        <div class="col-6 d-flex justify-content-end">
           <ul uib-pagination total-items="dataSearch.totalRecords" items-Per-Page="dataSearch.pageSize"
                ng-change="pagechanged()" ng-model="dataSearch.pageIndex" max-size="dataSearch.maxSize"
                class="pagination" boundary-links="true" rotate="false"></ul>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-condensed">
            <thead>
                <tr>
                    <th>N°</th> 
                    <th>Tipo doc.</th>
                    <th>Serie Comprobante</th>
                    <th>Razon Social Comprador</th> 
                    <th>Op.</th>
                </tr>
            </thead>
            <tbody>
                <tr ng-repeat="item in documentos">
                    <td>{{$index +1}}</td> 
                    <td>{{tipoDoc}}</td> 
                    <td>{{item.serieComprobante}}</td>
                    <td>{{item.razonSocialComprador}}</td>
                    <td>
                        <div class="btn-group">
                            <button type="button" class="btn btn-success btn-sm" ng-click="selectedDoc(item)">
                                <i class="fas fa-arrow-circle-down"></i>
                            </button>
                            <button type="button" class="btn btn-info btn-sm" ng-click="openModalPreview(item)">
                                <i class="fas fa-eye"></i>
                            </button>
                        </div>
                    </td>
                </tr>
            </tbody> 
        </table>
    </div>
</div>
<div class="modal-footer">
    <button type="button" class="btn btn-dark" ng-click="closeModal()">
        &times; Cerrar
    </button>
</div>