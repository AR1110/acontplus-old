<form autocomplete="off">
    <div class="modal-header">
        <h5 class="modal-title">Nuevo Nota Crédito Cliente</h5>
        <div class="pull-right text-right">
            <span class="h4"><b>Total:</b> ${{getImporteTotal()}} </span>
        </div>
    </div>
    <div class="modal-body">
        <div class="row">
            <div class="col-xl-4 col-lg-4 col-md-6 col-sm-12 col-12">
                <div class="form-group">
                    <label for="establecimiento">Estab.: <span class="text-danger">*</span></label>
                    <select name="establecimiento" id="establecimiento" class="form-control border-select"
                        ng-model="data.codEstab" ng-change="onChangeEstablecimiento()">
                        <option ng-value="item.codEstab" ng-repeat="item in establecimientos">
                            {{item.nombreComercial}}
                        </option>
                    </select>
                </div>
            </div>
            <div class="col-xl-4 col-lg-4 col-md-6 col-sm-12 col-12">
                <div class="form-group">
                    <label for="puntoEmision">Punto Emisión: <span class="text-danger">*</span></label>
                    <select name="puntoEmision" id="puntoEmision" class="form-control border-select"
                        ng-model="data.idPuntoEmision">
                        <option ng-value="item.idPuntoEmision" ng-repeat="item in puntosEmision">{{item.ptoEmi}}
                        </option>
                    </select>
                </div>
            </div>
            <div class="col-xl-4 col-lg-4 col-md-6 col-sm-12 col-12">
                <div class="form-group">
                    <label for="">Fecha Emisión <span class="text-danger">*</span></label>
                    <input type="date" ng-model="data.fechaEmision" class="form-control border-select">
                </div>
            </div>
        </div>

        <div class="row">
            <div class="co-xl-4 col-lg-4 col-md-6 col-sm-12 col-12">
                <div class="form-group">
                    <label for="">Cliente: <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <input
                              type="text"
                              id="clienteSearchInvoice"
                              autocomplete="off"
                              name="clienteSearchInvoice"
                              class="form-control border-select"
                              placeholder="Ingrese C.I o Nombre Fiscal"
                              ng-model="cliente.nombreFiscal"
                              ng-keyup="onKeyupSearchCliente()"
                              uib-typeahead="item as item.nombreFiscal for item in clienteSearchDynamic($viewValue)"
                              typeahead-loading="clienteSearch.loading"
                              typeahead-no-results="clienteSearch.noResults"
                              typeahead-template-url="autocompleteClienteTemplate.html"
                              typeahead-min-length="1"
                              typeahead-editable="true"
                              typeahead-on-select="onSelectedClienteChange($item)"
                              onClick="select();"
                            />

                            <script type="text/ng-template" id="autocompleteClienteTemplate.html">
                              <div class="autocomplete-suggestion-uib-typeahead">
                                  <span class="item-title">
                                      <b> {{match.model.numeroIdentificacion}}</b> - {{match.model.nombreFiscal}}
                                  </span>
                              </div>
                            </script>

                        <div class="input-group-append">

                            <button type="button" class="btn btn-outline-secondary btn-xs"
                                ng-if="cliente.idCliente>0" btn-cliente params="cliente" tabindex="-1"><i
                                    class="fa fa-edit fa-xs"></i>
                            </button>
                            <button type="button" class="btn btn-outline-secondary btn-xs" btn-cliente-lista
                                result-modal="onSelectedClienteChange(result)" tabindex="-1"><i
                                    class="fa fa-search fa-xs"></i>
                            </button>

                            <button type="button" cliente-info-popover customer="cliente" popover-placement='top'
                                class="btn btn-outline-secondary btn-xs" ng-if="cliente.idCliente>0"
                                tabindex="-1"><i class="fa fa-info fa-xs"></i>
                            </button>
                        </div>
                    </div>
                    <span class="ml-5" ng-if="cliente.loading"> <i class="fas fa-sync-alt fa-xs"></i> Loading...</span>
                    <small class="text-danger ml-5" ng-if="cliente.noResults">No se encontraron resultados</small>
                </div>
            </div>

            <div class="co-xl-4 col-lg-4 col-md-6 col-sm-12 col-12">
                <div class="form-group">
                    <label for="nroIndentificacion" class="">Nro. Identificación:</label>
                    <input type="text" name="nroIndentificacion" id="nroIndentificacion" class="form-control" readonly
                        ng-value="cliente.numeroIdentificacion" placeholder="..." />
                </div>
            </div>

            <div class="co-xl-4 col-lg-4 col-md-6 col-sm-12 col-12">
                <div class="form-group">
                    <label for="Facturas"><code>{{facturas.length}}</code> Facturas</label>
                    <div class="input-group">
                         <input type="text" class="form-control border-select" ng-disabled="!(cliente.idCliente>0)"
                        ng-model="textSearchFactura" placeholder="Buscar Nro. Factura" ng-keyup="onKeyupInvoice()"
                        uib-typeahead="item as item.serieComprobante for item in facturas | filter:{serieComprobante:$viewValue}"
                        typeahead-show-hint="true" typeahead-min-length="0"
                        typeahead-on-select="selectedInvoiceChange($item)" typeahead-editable="false" onClick="select()">
                        <div class="input-group-append">
                             
      
                            <button type="button" class="btn btn-secondary" ng-click="getDetalleDoc()">
                        <i class="ti-eye"></i>
                    </button> 
                        </div>
                    </div>
                   
                    

                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-xl-8 col-lg-8 col-md-12 col-sm-12 col-12">
                <div class="row justify-content-start">
                    <div class="col-xl-6 col-lg-6 col-md-12 col-sm-12 col-12">
                        <label for="">Buscar Articulo</label>
                        <md-autocomplete-articulo-component tipo-doc="tipoDoc"
                            abrir-modal-articulo="abrirModalArticulo(item)"
                            get-data-articulo="getDataIdArticulo(item)"
                            set-item-articulo-en-detalle="setItemArticuloEnDetalle(item)"
                            scope-parent="scopeParent" id-bodega="data.idBodega">
                        </md-autocomplete-articulo-component>
                    </div>

                    <div class="col-xl-3 col-lg-3 col-md-6 col-sm-12 col-12" ng-if="config.multipleVendedor">
                        <div class="form-group">
                            <label for="vendedor">Vendedor: <span class="text-danger">*</span></label>
                            <select name="vendedor" id="vendedor" class="form-control border-select"
                                ng-model="data.idUsuario">
                                <option ng-value="item.idUsuario" ng-repeat="item in vendedores">
                                    {{item.nombreCompleto}}
                                </option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xl-4 col-lg-4 col-md-12 col-sm-12 col-12">
                <div class="row justify-content-end">
                    <div class="col-xl-6 col-lg-6 col-md-12 col-sm-12 col-12">
                        <div class="form-group">
                            <label for="bodegas">Bodega</label>
                            <select name="bodegas" id="bodegas" class="form-control border-select"
                                ng-model="data.idBodega" ng-change="onChangeBodega()">
                                <option ng-value="item.idBodega" ng-repeat="item in bodegas">
                                    {{item.bodega}}
                                </option>
                            </select>
                        </div>
                    </div> 
                    @* <div class="col-xl-6 col-lg-6 col-md-12 col-sm-12 col-12">
                        <div class="form-group">
                            <label for="tarifas">Tarifa:
                                <span tooltip-placement="top"
                                    uib-tooltip="Asignación Rápida de listas de precios seleccionada a todos los productos del documento.">
                                    <i class="fas fa-info-circle fa-xs"></i>
                                </span>
                            </label>
                            <select id="tarifas" class="form-control border-select" ng-model="data.idTarifa"
                                ng-change="askToChangeTariga()">
                                <option ng-value="item.idTarifa" ng-repeat="item in tarifas">
                                    {{item.descripcion}}
                                </option>
                            </select>
                        </div>
                    </div> *@
                </div>
            </div>
        </div>

        <div ui-grid="gridOptions" ui-grid-edit ui-grid-resize-columns ui-grid-cellNav ui-grid-auto-resize
            ui-grid-validate ui-grid-save-state class="grid">
        </div>

        <div class="row mt-1">
            <div class="col-xl-9 col-lg-9 col-md-6 col-sm-12 col-12">
                <div class="row" >
                    @* <div class="col-xl-4 col-lg-4 col-md-6 col-sm-12 col-12">
                        <div class="table-responsive">
                            <table class="table table-clear table-sm">
                                <tbody>
                                    <tr>
                                        <td class="left">
                                            <strong class="text-dark">SubTotal Iva
                                                {{actividadTipoIva.tarifa}}%</strong>
                                        </td>
                                        <td class="right">${{data.subTotalIva}}</td>
                                    </tr>

                                    <tr>
                                        <td class="left">
                                            <strong class="text-dark">SubTotal IVA 0</strong>
                                        </td>
                                        <td class="right">${{data.subTotalIvaCero}}</td>
                                    </tr>

                                    <tr>
                                        <td class="left">
                                            <strong class="text-dark">SubTotal Exento IVA</strong>
                                        </td>
                                        <td class="right">${{data.subTotalExentoIva}}</td>
                                    </tr>

                                    <tr>
                                        <td class="left">
                                            <strong class="text-dark">SubTotal no Objeto IVA</strong>
