<form autocomplete="off">
    <div class="modal-header">
        <h5 class="modal-title">Detalle Proforma</h5>
        <div class="float-center">
            <h5><span>Nro: <b>{{data.serieComprobante}}</b> </span></h5>
        </div>
        <div class="float-right">
            <h4><span class="float-right"><strong>Total: ${{data.total}} </strong></span></h4>
        </div>
    </div>
    <div class="modal-body">
        <div class="row">
            <div class="col-xl-4 col-lg-4 col-md-4 col-sm-12 col-12">
                <div class="form-group">
                    <label for="establecimiento">Estab.: </label>
                    <input type="text" ng-value="data.establecimiento" class="form-control" disabled>
                </div>
            </div>

            <div class="col-xl-4 col-lg-4 col-md-4 col-sm-12 col-12">
                <div class="form-group">
                    <label for="fechaEmision">Fecha Emisión: </label>
                    <input type="date" name="fechaEmision" id="fechaEmision" disabled class="form-control border-select"
                        ng-model="data.fechaEmision">
                    <small class="text-info">{{data.fechaEmisionEscrita}}</small>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-xl-4 col-lg-4 col-md-4 col-sm-12 col-12">
                <div class="form-group">
                    <label for="razonSocialComprador">Cliente: </label>
                    <input type="text" ng-value="cliente.razonSocialComprador" class="form-control" disabled>
                </div>
            </div>

            <div class="col-xl-2 col-lg-2 col-md-2 col-sm-12 col-12">
                <div class="form-group">
                    <label for="identificacionComprador">Nro. Identificaciòn</label>
                    <input type="text" disabled ng-value="cliente.identificacionComprador" class="form-control">
                </div>
            </div>

            <div class="col-xl-3 col-lg-3 col-md-6 col-sm-12 col-12">
                <div class="form-group">
                    <label for="correo">Correo</label>
                    <input type="text" ng-value="cliente.correo" disabled class="form-control">
                </div>
            </div>

            <div class="col-lg-3">
                <div class="form-group">
                    <label for="correo">Dirección</label>
                    <input type="text" ng-value="cliente.direccionComprador" disabled class="form-control">
                </div>
            </div>
        </div>

        <div ui-grid="gridOptions" ui-grid-resize-columns ui-grid-cellNav ui-grid-auto-resize class="grid">
        </div>

        <div class="row mt-1">
            <div class="col-xl-9 col-lg-9 col-md-6 col-sm-12 col-12">
                <div class="row">
                </div>
                <div class="row mt-2">
                    <div class="col-lg-2 col-md-6 col-sm-12 col-12">
                        <div class="form-group">
                            <label>% Descuento</label>
                            <div class="input-group">
                                <input ng-model="data.porcentajeDescuento" disabled valid-number class="form-control" />
                                <div class="input-group-append">
                                    <button type="button" class="btn btn-secondary btn-sm" disabled>
                                        <i class="fa fa-calculator fa-xs"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-2 col-md-6 col-sm-12 col-12">
                        <div class="form-group">
                            <label>Descuento</label>
                            <div class="input-group">
                                <input ng-model="data.totalDescuento" id="totalDescuento" disabled valid-number
                                    placeholder="0.00" class="form-control" />
                                <div class="input-group-append">
                                    <button type="button" class="btn btn-secondary btn-sm" disabled>
                                        <i class="fa fa-calculator fa-xs"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-2 col-md-6 col-sm-12 col-12">
                        <div class="form-group">
                            <label>Transporte</label>
                            <input type="text" decimal ng-model="data.transporte" class="form-control border-select"
                                disabled placeholder="0.00" />
                        </div>
                    </div>

                    <div class="col-lg-2 col-md-6 col-sm-12 col-12">
                        <div class="form-group">
                            <label>Rercargo</label>
                            <input type="text" decimal ng-model="data.recargo" disabled
                                class="form-control border-select" placeholder="0.00" />
                        </div>
                    </div>

                    <div class="col-lg-4">
                        <div class="form-group">
                            <label>Observacion</label>
                            <textarea class="form-control border-select" ng-model="data.observacion" disabled
                                touppercase placeholder="..."></textarea>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-lg-3 col-md-6 col-sm-12 col-12">
                <div class="card border p-2">
                    <div id="draw-dynamic-subtotal"></div>
                </div>
                <button type="button" class="btn btn-secondary btn-sm btn-lg btn-block"
                    open-modal-additional-data-document datos-adicionales="infoAdicionalDocumento" is-view="true">
                    <i class="fas fa-info-circle text-info"></i> Dato Adicional
                </button>

                @* <div class="mt-2">
                <button type="button" class="btn btn-secondary btn-sm btn-lg btn-block"
                ng-click="openModalInfoAdicional(false)">
                <i class="fas fa-info-circle text-info"></i> Dato Adicional
                </button>
                </div> *@
            </div>
        </div>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-dark" ng-click="closeModal()">&times; Cerrar</button>
    </div>
</form>