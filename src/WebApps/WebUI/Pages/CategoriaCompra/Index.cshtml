@page
@model WebUI.Pages.CategoriaCompra.IndexModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Cargo";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div ng-controller="categoriaCompraCtrl">
    <div class="row page-titles">
        <div class="col-md-5 align-self-center">
            <h4 class="text-themecolor">Categoria Compra</h4>
        </div>
        <div class="col-md-7 align-self-center text-right">
            <div class="d-flex justify-content-end align-items-center"> 
                <button type="button" ng-if="accion.leer && accion.crear" class="btn btn-info m-l-15" btn-categoria-compra result-modal="resultModal(result)">
                    <i class="ti-plus"></i> Nuevo
                </button>
            </div>
        </div>
    </div>
    <div class="row">
        <!-- Column -->
        <div class="col-lg-12">
            <div class="card">
                <div class="card-body">
                    <div class="row">
                        <div class="col-lg-9">
                            <span class="form-group pull-left page-size form-inline">
                                <select class="form-control control-color"
                                        ng-model="pageSize"
                                        ng-change="changePageSize()"
                                        ng-options="ra for ra in recordsQuantity">
                                </select>
                            </span>
                        </div>
                        <div class="col-lg-3">
                            <input type="text" class="form-control" ng-model="buscar" placeholder="Buscar Categoria de Compra" />
                        </div>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-condensed">
                            <thead>
                                <tr>
                                    <th ng-if="accion.editar || accion.eliminar">Op.</th>
                                    <th>N°</th>
                                    <th>Código</th>
                                    <th>Descripcón</th>
                                    <th>Estado</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="cc in categoriaCompras | filter:buscar">
                                    <td ng-if="accion.editar || accion.eliminar">
                                        <button class="btn btn-info btn-xs" ng-if="accion.editar" btn-categoria-compra result-modal="resultModal(result)" params="cc"><i class="ti-pencil"></i></button>
                                        <button class="btn btn-danger btn-xs" ng-if="accion.eliminar" ng-click="delete(cc)"><i class="ti-trash"></i></button>
                                    </td>
                                    <td>{{$index+1}}</td>
                                    <td>{{cc.codigo}} </td>
                                    <td>{{cc.descripcion}} </td>
                                    <td ng-bind-html="cc.estado | estadoPrimario"></td>
                                </tr>
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td align="center" colspan="5">
                                        <div class="pull-left">
                                            <ul uib-pagination total-items="totalRecords" items-Per-Page="pageSize" ng-change="pagechanged()" ng-model="pageIndex" max-size="maxSize" class="pagination" boundary-links="true" rotate="false"></ul>
                                        </div>
                                    </td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        <!-- Column -->
    </div>

</div>

@section Scripts{
    <script src="~/js/compras/controllers/categoriaCompraCtrl.min.js" asp-append-version="true"></script>
    <script src="~/js/compras/controllers/categoriaCompraCtrl.min.js" asp-append-version="true"></script>
}