<form autocomplete="off">
    <div class="modal-header">
        <h4 class="modal-title">{{tipoRegistro===1?'Nuevo':'Editar'}} Empresa</h4>
        <button class="close" ng-click="closeModal()">&times;</button>
    </div>

    <div class="modal-body">
        <div class="form-group">
            <label for="ruc">Ruc <span class="text-danger">*</span></label>
            <input type="text" id="ruc" name="ruc" ng-class="typeNotify" placeholder="Ej. 1450152325001"
                ng-model="data.ruc" ng-keyup="validarRuc()" maxlength="13" valid-number
                class="form-control border-select">
            <small class="invalid-feedback">{{message}}</small>
            <small class="valid-feedback">{{message}}</small>
        </div>

        <div class="form-group">
            <label for="">Razon Social <span class="text-danger">*</span></label>
            <input type="text" name="" ng-model="data.razonSocial" ng-keyup="copiarRazonSocial()"
                class="form-control border-select" touppercase id="">
        </div>

        <div class="form-group">
            <label for="">Nombre Comercial <span class="text-danger">*</span></label>
            <input type="text" name="" ng-model="data.nombreComercial" class="form-control border-select" id="">
        </div>

        <div class="form-group" ng-if="tipoRegistro ===2">
            <label for="">Estado</label>
            <md-radio-group ng-model="data.estado" aria-labelledby="Estado Empresa">
                <md-radio-button ng-value="true" class="md-primary">Activo</md-radio-button>
                <md-radio-button ng-value="false">Inactivo</md-radio-button>
            </md-radio-group>
        </div>

    </div>

    <div class="modal-footer">
        <button type="button" class="btn btn-success" ng-click="saveAndUpdate()">
            {{tipoRegistro===1?'Guardar':'Actualizar'}}
        </button>
        <button type="button" class="btn btn-dark" ng-click="closeModal()">&times; Cerrar</button>
    </div>
</form>