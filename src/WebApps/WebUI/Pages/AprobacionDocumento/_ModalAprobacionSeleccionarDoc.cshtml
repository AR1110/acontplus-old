<div class="modal-header">
    <h5 class="modal-title"><i class=" fas fa-exchange-alt"></i> Aprobación de Documento</h5>
    <button class="close" ng-click="close()">&times;</button>
</div>

<div class="modal-body">
    <div class="d-flex justify-content-between">
        <div class="form-group">
            <label for="tipo">Seleccione Doc.:</label>
            <select name="tipo" id="tipo" ng-model="dataSearch.tipo" class="form-control border-select"
                ng-change="onChangeTipo()">
                <option ng-value="0" disabled>Seleccion::</option>
                <option ng-value="item.code" ng-repeat="item in tipos">
                    {{item.desc}}
                </option>
            </select>
        </div>

        <div>
            <div class="icheck-primary">
                <input type="radio" id="radioMultiple" ng-model="dataSearch.radioMultipleIndividual"
                    name="radioNombreMulInd" value="MULTIPLE" ng-change="onChangeRadioMultipleIndividual()" />
                <label for="radioMultiple">Multiple</label>
            </div>
            <div class="icheck-primary">
                <input type="radio" id="radioIndividual" ng-model="dataSearch.radioMultipleIndividual"
                    name="radioNombreMulInd" value="INDIVIDUAL" ng-change="onChangeRadioMultipleIndividual()" />
                <label for="radioIndividual">Individual</label>
            </div>
        </div>

        <div class="d-flex align-items-center">
            <div class="btn-group" role="group" aria-label="Basic example">
                <button type="button" class="btn btn-info">Continuar <i class=" fas fa-angle-right"></i></button>
                <button type="button" class="btn btn-secondary" ng-click="refresh()">
                    <md-icon md-font-set="md">sync</md-icon>

                </button>
            </div>

        </div>
    </div>
    <hr>
    <div class="row" ng-if="dataSearch.tipo > 0 ">
        <div class="col-xl-3 col-lg-3 col-md-4 col-sm-6 col-12">
            <div class="form-group">
                <span for="establecimiento">Establecimiento: <span class="text-danger">*</span></span>
                <select class="form-control border-select" ng-model="dataSearch.codEstab" ng-change="onChangeEstab()">
                    <option ng-value="item.codEstab" ng-repeat="item in establecimientos">
                        {{item.nombreComercial}}
                    </option>
                </select>
            </div>
        </div>
        <div class="col-xl-2 col-lg-2 col-md-4 col-sm-6 col-12">
            <div class="form-group">
                <span for="puntoEmision">Punto Emision: <span class="text-danger">*</span></span>
                <select class="form-control border-select" ng-model="dataSearch.idPuntoEmision" ng-change="refresh()">
                    <option value="">Todos</option>
                    <option ng-value="item.idPuntoEmision" ng-repeat="item in ptosEmision">
                        {{item.ptoEmi}}
                    </option>
                </select>
            </div>
        </div>
        <div class="col-xl-3 col-lg-3 col-md-4 col-sm-6 col-12">
            <div class="form-group">
                <span for="">Rango de fechas:</span>
                <date-range-filter current-date="dataSearch.fechaInicio" start-date="dataSearch.fechaInicio"
                    end-date="dataSearch.fechaFin" result-range-date="resultDateRange(result)"></date-range-filter>
            </div>
        </div>
        <div class="col-xl-4 col-lg-4 col-md-4 col-sm-6 col-12">
            <div class="form-group">
                <span for="">Cliente: <span class="text-danger">*</span></span>
                <input type="text" id="customerInputSearch" class="form-control border-select"
                    ng-model="cliente.nombreCliente" cliente-search-drtv on-select="selectedClienteSearch(result)"
                    on-keyup-cliente="onKeyupCliente()" placeholder="Ingrese C.I o Nombre Comercial"
                    onclick="select();">

                <script type="text/ng-template" id="autocompleteClienteTemplate.html">
                                            <div class="autocomplete-suggestion-uib-typeahead">
                                                <span class="item-title"><b> {{match.model.numeroIdentificacion}}</b> - {{match.model.nombreFiscal}}</span>
                                            </div>
                                        </script>
            </div>

        </div>
    </div>

    <div class="row">
        <div class="col-xl-6 col-lg-6 col-md-6 col-sm-6 col-12">
            <div class="form-group" ng-if="esRadioIndividual() && cliente.idCliente>0">
                <label for="secuencial">Secuencial: <span class="text-danger">*</span></label>
                <div class="input-group">
                    <input type="text" class="form-control border-select" ng-model="dataSearch.nroSecuencial"
                        placeholder="Ej: 123 o 1-30">

                    <div class="input-group-append">
                        <button type="button" class="btn btn-success btn-sm" ng-click="buscarPorNroSecuencial()">
                            Buscar y agregar
                        </button>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-6 col-lg-6 col-md-6 col-sm-6 col-12 d-flex align-items-end justify-content-end">
            <ul ng-if="dataSearch.radioMultipleIndividual==='MULTIPLE'" uib-pagination
                total-items="dataSearch.totalRecords" items-Per-Page="dataSearch.pageSize" ng-change="pageChanged()"
                ng-model="dataSearch.pageIndex" max-size="dataSearch.maxSize" class="pagination" boundary-links="true"
                rotate="false"></ul>
        </div>
    </div>


    <md-table-container>
        <table md-table md-row-select="optionsTable.rowSelection" multiple="{{optionsTable.multiSelect}}"
            ng-model="docsSelected">
            <thead md-head>
                <tr md-row>
                    <th md-column><span>#</span></th>
                    <th md-column><span>Nro. Doc</span></th>
                    <th md-column><span>Fecha Emisión</span></th>
                    <th md-column ng-if="dataSearch.tipo===1"><span>Fecha Vcto</span></th>
                    <th md-column><span>Cliente</span></th>
                    <th md-column><span>Total</span></th>
                    <th md-column><span>Estado</span> </th>
                    <th md-column><span>Usuario</span> </th>
                </tr>
            </thead>
            <tbody md-body>
                <tr md-row md-select="item" md-on-select="logItem" md-auto-select="optionsTable.autoSelect"
                    ng-repeat="item in docs">
                    <td md-cell>{{$index+1}}</td>
                    <td md-cell>{{item.serieComprobante}} </td>
                    <td md-cell>{{item.fechaEmision}}</td>
                    <td md-cell ng-if="dataSearch.tipo===1">{{item.fechaVencimiento}}</td>
                    <td md-cell>{{item.nombreFiscal || item.razonSocialComprador}}</td>
                    <td md-cell>{{item.total }}</td>
                    <td md-cell>{{item.estadoDoc || item.estadoFinanciero}}</td>
                    <td md-cell>{{item.usuario}}</td>
                </tr>
            </tbody>
        </table>
    </md-table-container>

</div>

</div>

<div class="modal-footer">
    <button class="btn btn-dark" ng-click="close()">&times; Cerrar</button>
</div>