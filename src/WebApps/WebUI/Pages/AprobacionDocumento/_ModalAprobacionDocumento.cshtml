<div class="modal-header">
    <h5 class="modal-title"><i class="mdi mdi-file-check"></i> Aprobación del Documento: {{docOrigenDesc}} <i
            class="mdi mdi-arrow-right"></i> {{docDestinoDesc}}</h5>
    <button type="button" class="close" ng-click="closeModal()">&times;</button>
</div>

<div class="modal-body">
    <div class="row">
        <div class="col-xl-3 col-lg-3 col-md-6 col-sm-12 col-xs-12">
            <span>Establecimiento: <span class="text-danger">*</span> </span>
            <select class="form-control" ng-model="data.codEstab" ng-change="onChangeEstab()">
                <option ng-value="item.codEstab" ng-repeat="item in establecimientos">
                    {{item.nombreComercial}}
                </option>
            </select>
        </div>

        <div class="col-xl-3 col-lg-3 col-md-6 col-sm-6 col-xs-12">
            <div class="form-group">
                <span for="cliente">Cliente: <span class="text-danger">*</span></span>
                <input type="text" name="cliente" id="cliente" class="form-control" ng-model="cliente.nombreFiscal"
                    disabled>
            </div>
        </div>

        <div class="col-xl-2 col-lg-2 col-md-6 col-sm-6 col-xs-12">
            <div class="form-group">
                <span for="numeroIdentificacion" class="">Nro. Identificación:</span>
                <input type="text" id="numeroIdentificacion" name="numeroIdentificacion" class="form-control" disabled
                    ng-value="cliente.numeroIdentificacion" placeholder="...">
            </div>
        </div>
        <div class="col-xl-4 col-lg-4 col-md-6 col-sm-6 col-xs-12">
            <div class="form-group">
                <span for="address" class="">Dirección:</span>
                <input type="text" id="address" class="form-control" disabled ng-model="cliente.direccion">
            </div>
        </div>
    </div>

    <!--Second row-->
    <div class="row">
        <div class="col-xl-3 col-lg-3 col-md-3 col-sm-6 col-xs-12">
            <div class="for-group">
                <span>Punto Emisión <span class="text-danger">*</span></span>
                <select class="form-control" ng-model="data.idPuntoEmision">
                    <option ng-value="item.idPuntoEmision" ng-repeat="item in ptosEmision">{{item.ptoEmi}}</option>
                </select>
            </div>
        </div>

        <div class="col-xl-3 col-lg-3 col-md-3 col-sm-6 col-xs-12">
            <div class="form-group">
                <span>Forma Cobro: <span class="text-dangr">*</span> </span>
                <select class="form-control border-select" ng-model="data.idTiempoCredito"
                    ng-change="onChangeTiempoCredito()">
                    <option ng-value="item.idTiempoCredito" ng-repeat="item in tiempoCreditos">
                        {{item.descripcion}}
                    </option>
                </select>
            </div>
        </div>

        <div class="col-xl-3 col-lg-3 col-md-3 col-sm-6 col-xs-12">
            <div class="form-group">
                <span>Fecha Emisión: <span class="text-danger">*</span> </span>
                <input type="date" name="fechaEmision" class="form-control" ng-model="data.fechaEmision"
                    ng-change="onChangeFechaEmision()">
                <small class="text-info">{{fechaEmisionEscrita}}</small>
            </div>
        </div>

        <div class="col-xl-3 col-lg-3 col-md-3 col-sm-6 col-xs-12">
            <div class="form-group">
                <span>Fecha Vcto: <span class="text-danger">*</span> </span>
                <input type="date" name="fechaVcto" class="form-control" ng-model="data.fechaVencimiento" disabled>
                <small class="text-info">{{fechaVencimientoEscrita}}</small>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-xl-8 col-lg-8 col-md-12 col-sm-12 col-12">
            <div class="row">
                <div class="col-xl-8 col-lg-8 col-md-12 col-sm-12 col-12">
                    <span for="">Buscar Articulo</span>
                    <md-autocomplete-articulo-component tipo-doc="tipoDoc" id-bodega="data.idBodega"
                        set-item-articulo-en-detalle="setItemArticuloEnDetalle(item)">
                    </md-autocomplete-articulo-component>
                </div>
                <div class="col-xl-3 col-lg-3 col-md-12 col-sm-12 col-12">
                    <div class="form-group">
                        <span for="">Tarifa:
                            <span tooltip-placement="top"
                                uib-tooltip="Asignación Rápida de listas de precios seleccionada a todos los productos del documento.">
                                <i class="fas fa-info-circle fa-xs"></i>
                            </span>
                        </span>
                        <select id="idTarifa" class="form-control border-select" ng-model="data.idTarifa"
                            ng-change="onChangeTarifaGeneral()">
                            <option ng-value="item.idTarifa" ng-repeat="item in tarifas">{{item.descripcion}}</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-4 col-lg-4 col-md-12 col-sm-12 col-12">
            <div class="row mt-4">
                <div class="col-12 d-flex justify-content-end">
                    <div class="ml-auto">
                        <button type="button" class="btn btn-success" ng-click="askToSaveDocDestino()">
                            <i class="ti-save"></i> Guardar
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div ui-grid="gridOptionsDetalle" ui-grid-edit ui-grid-resize-columns ui-grid-cellNav ui-grid-auto-resize
        ui-grid-validate ui-grid-save-state class="grid">
    </div>

    <!--Subtotales-->
    <div class="row mt-2">
        <div class="col-lg-9 col-md-9 col-sm-12 col-xs-12">
            <div class="card border border-secondary-1">
                <div class="card-body">
                    <div class="row">
                        <div class="col-xl-2 col-lg-2 col-md-3 col-sm-12 col-xs-12">
                            <div class="form-group">
                                <label>% Descuento</label>
                                <div class="input-group">
                                    <input ng-model="data.porcentajeDescuento" disabled class="form-control" />
                                    <div class="input-group-append">
                                        <button type="button" class="btn btn-secondary btn-sm" disabled><i
                                                class="fa fa-calculator fa-xs"></i></button>
                                    </div>
                                </div>

                            </div>
                        </div>

                        <div class="col-xl-2 col-lg-2 col-md-3 col-sm-12 col-xs-12">
                            <div class="form-group">
                                <label>Descuento</label>
                                <div class="input-group">
                                    <input ng-model="data.totalDescuento" disabled placeholder="0.00"
                                        class="form-control" />
                                    <div class="input-group-append">
                                        <button type="button" class="btn btn-secondary btn-sm" disabled><i
                                                class="fa fa-calculator fa-xs"></i></button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-xl-2 col-lg-2 col-md-3 col-sm-12 col-xs-12">
                            <div class="form-group">
                                <label>Transporte</label>
                                <input type="text" ng-model="data.transporte" disabled class="form-control"
                                    placeholder="0.00" />
                            </div>
                        </div>

                        <div class="col-xl-2 col-lg-2 col-md-3 col-sm-12 col-xs-12">
                            <div class="form-group">
                                <label>Rercargo</label>
                                <input type="text" decimal disabled ng-model="data.recargo" class="form-control"
                                    placeholder="0.00" />
                            </div>
                        </div>

                        <div class="col-xl-4 col-lg-4 col-md-12 col-sm-12 col-xs-12">
                            <div class="form-group">
                                <label>Observacion</label>
                                <textarea class="form-control border-select" ng-model="data.observacion"
                                    placeholder="..."></textarea>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-3 col-md-3 col-sm-6 col-xs-12 ml-auto">
            <div class="card border p-2">
                <div id="drawImpuestoTotales"></div>
            </div>
            <div class="mt-2">
                <button class="btn btn-secondary btn-sm btn-lg btn-block" open-modal-additional-data-document
                    datos-adicionales="infoAdicionalDocumento" is-view="false"
                    get-data-additional-document="resultModalInfoAdicional(result)">
                    <i class="fas fa-info-circle text-info"></i> Dato Adicional
                </button>
            </div>
        </div>
    </div>


</div>

<div class="modal-footer">
    <button type="button" class="btn btn-dark" ng-click="closeModal()">
        &times; Cerrar
    </button>
</div>
