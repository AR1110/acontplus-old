<style>
    .gap-1>*+* {
        margin-top: 0.25rem;
    }

    .gap-2>*+* {
        margin-top: 0.5rem;
    }

    .me-2 {
        margin-right: 0.5rem;
    }

    .fw-semibold {
        font-weight: 600;
    }

    .rounded-3 {
        border-radius: 0.375rem !important;
    }

    .vstack>*+* {
        margin-top: 0.25rem;
    }

    .hstack {
        display: flex;
        align-items: center;
    }

    .d-fex {
        display: flex;
        flex-direction: column;
    }

    .text-right {
        text-align: right;
    }
</style>
<div class="modal-header">
    <h5 class="modal-title"><i class="fa fa-file-pdf"></i> Detalle Aprobación Documento: {{docOrigenDesc}} <i
            class="mdi mdi-arrow-right"></i> {{docDestinoDesc}}</h5>
    <span>
        <i ng-click="showHistorialDocumento()" class="fas fa-info-circle"></i>
    </span>
</div>

<div class="modal-body">

    <div class="container-fluid p-3">
        <div class="d-grid gap-2">
            <!-- Header Section -->
            <div class="row">
                <div class="col-md-6 col-sm-6 col-6 mb-2">
                    <div class="border border-dark rounded-3 p-2">
                        <div class="d-flex flex-column gap-1">
                            <div class="vstack">
                                <small class="fw-semibold">Establecimiento</small>
                                <small>{{ data.establecimiento }}</small>
                            </div>
                            <div class="vstack">
                                <small class="fw-semibold">Punto Emisión</small>
                                <small>{{ data.ptoEmi }}</small>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 col-sm-6 col-6 mb-2">
                    <div class="border border-dark rounded-3 p-2">
                        <div class="d-flex flex-column gap-2">
                            <h5 class="fw-semibold">{{docDestinoDesc}}</h5>
                            <div class="hstack">
                                <small class="fw-semibold me-2">Nro.</small>
                                <small>{{ data.serieComprobante }}</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Customer Information Section -->
            <div class="border border-dark rounded-3 p-2 mb-2">
                <div class="row">
                    <div class="col-md-7 col-sm-12 col-12">
                        <div class="d-flex mb-1">
                            <small class="fw-semibold me-2">Razón Social/ Nombres:</small>
                            <small>{{ cliente.nombreFiscal }}</small>
                        </div>
                        <div class="d-flex mb-1">
                            <small class="fw-semibold me-2">Identificación:</small>
                            <small>{{ cliente.numeroIdentificacion }}</small>
                        </div>
                        <div class="d-flex mb-1">
                            <small class="fw-semibold me-2">Dirección:</small>
                            <small>{{ cliente.direccion }}</small>
                        </div>
                        <div class="d-flex mb-1">
                            <small class="fw-semibold me-2">Teléfono:</small>
                            <small>{{ cliente.telefonoComprador }}</small>
                        </div>
                        <div class="d-flex">
                            <small class="fw-semibold me-2">Correo:</small>
                            <small>{{ cliente.correo }}</small>
                        </div>
                    </div>
                    <div class="col-md-5 col-sm-12 col-12">
                        <div class="d-fex">
                            <div class="d-flex mb-1">
                                <small class="fw-semibold me-2">Tiempo Crédito:</small>
                                <small>{{ headerData.tiempoCreditoNombre }}</small>
                            </div>
                            <div class="d-flex mb-1">
                                <small class="fw-semibold me-2">Fecha Emisión:</small>
                                <small>{{ data.fechaEmision }}</small>
                            </div>
                            <div class="d-flex mb-1">
                                <small class="fw-semibold me-2">Fecha Vencimiento:</small>
                                <small>{{ data.fechaEmision }}</small>
                            </div>
                            <div class="d-flex">
                                <small class="fw-semibold me-2">Empleado:</small>
                                <small>{{ headerData.empleadoNombre }}</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Items Table Section -->
            <div class="border border-dark rounded-3 p-2 mb-2">
                <div class="table-responsive">
                    <table class="table table-sm small mb-0">
                        <thead>
                            <tr>
                                <th class="fw-semibold">Nro.</th>
                                <th class="fw-semibold">Codigo</th>
                                <th class="fw-semibold">Descripción</th>
                                <th class="fw-semibold">Medida</th>
                                <th class="fw-semibold">Iva</th>
                                <th class="fw-semibold">Tarifa</th>
                                <th class="fw-semibold text-right">Cant</th>
                                <th class="fw-semibold text-right">Precio U.</th>
                                <th class="fw-semibold text-right">Precio con Iva</th>
                                <th class="fw-semibold text-right">%</th>
                                <th class="fw-semibold text-right">Descto</th>
                                <th class="fw-semibold text-right">Subtotal</th>
                                <th class="fw-semibold text-right">Impuesto</th>
                                <th class="fw-semibold text-right">Total</th>
                                <th class="fw-semibold text-right">Nota</th>
                                <th class="fw-semibold">Bodega</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="item in dataSource track by $index">
                                <td>{{ $index + 1 }}</td>
                                <td>{{ item.codigo }}</td>
                                <td style="width: 250px">{{ item.descripcion }}</td>
                                <td>{{ item.medida }}</td>
                                <td>{{ item.tipoIva }}</td>
                                <td>{{ item.pvp }}</td>
                                <td class="text-right">{{ item.cantidad }}</td>
                                <td class="text-right">{{ item.precioUnitario }}</td>
                                <td class="text-right">{{ item.precioConIva }}</td>
                                <td class="text-right">{{ item.porcentajeDescuento }}</td>
                                <td class="text-right">{{ item.valorDescuento }}</td>
                                <td class="text-right">{{ item.precioTotalSinImpuesto }}</td>
                                <td class="text-right">{{ item.valorImpuesto }}</td>
                                <td class="text-right">{{ item.total }}</td>
                                <td class="text-right">{{ item.nota }}</td>
                                <td>{{ item.bodega }}</td>
                            </tr>
                            <tr ng-if="detalles.length === 0">
                                <td colspan="15" class="text-center">
                                    <span ng-if="isLoading">Cargando...</span>
                                    <span ng-if="!isLoading">Sin registro</span>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Footer Section -->
            <div class="row">
                <div class="col-md-9 col-sm-12 col-12 mb-2">
                    <div class="border border-dark rounded-3 p-2">
                        <div class="d-flex mb-2">
                            <small class="fw-semibold me-2">Observación:</small>
                            <small>{{ headerData.observacion }}</small>
                        </div>

                        <table class="table table-sm small mb-0">
                            <tbody>
                                <tr>
                                    <td colspan="2" class="fw-semibold">Información Adicional</td>
                                </tr>
                                <tr ng-repeat="item in datosAdicionalesDoc track by $index">
                                    <td>{{ item.nombre }}</td>
                                    <td>{{ item.valor }}</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="col-md-3 col-sm-12 col-12">
                    <div class="border border-dark rounded-3 p-2">
                        <!-- Summary totals component would be replaced with custom directive or content -->
                        <div id="drawImpuestoTotales"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>



<div class="modal-footer">

    <button type="button" class="btn btn-dark" ng-click="closeModal()">
        &times; Cerrar
    </button>
</div>
