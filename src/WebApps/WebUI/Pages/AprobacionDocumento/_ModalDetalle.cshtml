<div class="modal-header">
    <h5 class="modal-title"><i class="fa fa-file-pdf"></i> Detalle Aprobación Documento: {{docOrigenDesc}} <i
            class="mdi mdi-arrow-right"></i> {{docDestinoDesc}}</h5>
    <span>
        <i ng-click="showHistorialDocumento()" class="fas fa-info-circle"></i>
    </span>
</div>

<div class="modal-body">
    <div class="row">
        <div class="col-xl-3 col-lg-3 col-md-6 col-sm-12 col-12">
            <div class="form-group">
                <label for="establecimiento">Establecimiento: </label>
                <input type="text" class="form-control" ng-value="data.establecimiento" disabled>
            </div>
        </div>

        <div class="col-xl-3 col-lg-3 col-md-6 col-sm-12 col-12">
            <div class="form-group">
                <label>Punto Emisión </label>
                <input type="text" class="form-control" ng-value="data.ptoEmi" disabled>
                @* <select class="form-control" ng-model="data.idPuntoEmision"
                ng-disabled="dataDisabled.isDisabledPuntoEmision" >
                <option ng-value="item.idPuntoEmision" ng-repeat="item in puntosEmision">{{item.ptoEmi}}</option>
                </select> *@
            </div>
        </div>

        <div class="col-xl-3 col-lg-3 col-md-6 col-sm-12 col-12">
            <div class="form-group">
                <label>Serie Comprobante: </label>
                <input type="text" name="serieComprobante" class="form-control" ng-model="data.serieComprobante"
                    disabled>
            </div>
        </div>

        <div class="col-xl-3 col-lg-3 col-md-6 col-sm-12 col-12">
            <div class="form-group">
                <label>Fecha Emisión: </label>
                <input type="date" name="fechaEmision" class="form-control" ng-model="data.fechaEmision" disabled>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-xl-4 col-lg-4 col-md-6 col-sm-12 col-12">
            <div class="form-group">
                <label for="">Cliente: </label>
                <input type="text" name="" id="" class="form-control" ng-model="cliente.nombreFiscal" disabled>
            </div>
        </div>

        <div class="col-xl-4 col-lg-4 col-md-6 col-sm-12 col-12">
            <div class="form-group">
                <label for="" class="">Nro. Identificación:</label>
                <input type="text" id="" class="form-control" disabled ng-value="cliente.numeroIdentificacion"
                    placeholder="...">
            </div>
        </div>

        <div class="col-xl-4 col-lg-4 col-md-6 col-sm-12 col-12">
            <div class="form-group">
                <label for="address" class="">Dirección:</label>
                <input type="text" id="address" class="form-control" disabled ng-model="cliente.direccion">
            </div>
        </div>
    </div>


    <div ui-grid="gridOptionsDetalle" ui-grid-edit ui-grid-resize-columns ui-grid-cellNav ui-grid-auto-resize
        ui-grid-validate ui-grid-save-state class="grid">
    </div>


    <div class="row mt-2">
        <div class="col-lg-9 col-md-9 col-sm-12 col-12">
            <div class="card border border-secondary-1">
                <div class="card-body">
                    <div class="row">
                        <div class="col-xl-2 col-lg-2 col-md-3 col-sm-12 col-12">
                            <div class="form-group">
                                <label>% Descuento</label>
                                <div class="input-group">
                                    <input ng-model="data.porcentajeDescuento" disabled class="form-control" />
                                    <div class="input-group-append">
                                        <button type="button" class="btn btn-secondary btn-sm" disabled><i
                                                class="fa fa-calculator fa-xs"></i></button>
                                    </div>
                                </div>

                            </div>
                        </div>

                        <div class="col-xl-2 col-lg-2 col-md-3 col-sm-12 col-12">
                            <div class="form-group">
                                <label>Descuento</label>
                                <div class="input-group">
                                    <input ng-model="data.totalDescuento" disabled placeholder="0.00"
                                        class="form-control" />
                                    <div class="input-group-append">
                                        <button type="button" class="btn btn-secondary btn-sm" disabled><i
                                                class="fa fa-calculator fa-xs"></i></button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-xl-2 col-lg-2 col-md-3 col-sm-12 col-12">
                            <div class="form-group">
                                <label>Transporte</label>
                                <input type="text" ng-model="data.transporte" disabled class="form-control"
                                    placeholder="0.00" />
                            </div>
                        </div>

                        <div class="col-xl-2 col-lg-2 col-md-3 col-sm-12 col-12">
                            <div class="form-group">
                                <label>Rercargo</label>
                                <input type="text" decimal disabled ng-model="data.recargo" class="form-control"
                                    placeholder="0.00" />
                            </div>
                        </div>

                        <div class="col-xl-4 col-lg-4 col-md-12 col-sm-12 col-12">
                            <div class="form-group">
                                <label>Observacion</label>
                                <textarea class="form-control border-select" ng-model="data.observacion" disabled
                                    placeholder="..."></textarea>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-3 col-md-3 col-sm-6 col-12 ml-auto">
            <div class="card border p-2">
                <div id="drawImpuestoTotales"></div>
            </div>
        </div>
    </div>

</div>



<div class="modal-footer">

    <button type="button" class="btn btn-dark" ng-click="closeModal()">
        &times; Cerrar
    </button>
</div>
