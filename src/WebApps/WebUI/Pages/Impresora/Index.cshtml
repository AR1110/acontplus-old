@page
@model WebUI.Pages.Impresora.IndexModel;
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div ng-controller="impresoraCtrl" ng-init="initialLoad()">
    <div class="row page-titles">
        <div class="col-md-5 align-self-center">
            <h4 class="text-themecolor">Impresoras</h4>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <div class="row">
                <div class="col-6">
                    <button class="btn btn-info" ng-click="openModalNew()"><i class="ti-plus"></i> Agregar
                        Impresora</button>
                </div>
            </div>
            <hr>
            <div class="table-responsive">
                <table class="table table-no-bordered">
                    <thead>
                        <tr>
                            <th class="text-center">Op.</th>
                            <th>N°</th>
                            <th class="text-center">Estab.</th>
                            <th class="text-center">Impresora</th>
                            <th class="text-center">Equipo</th>
                            <th class="text-center">Documento</th>
                            <th class="text-center">Tipo Impr.</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="item in printers |filter:buscar">
                            <td class="text-center">
                                <button class="btn btn-warning btn-sm" ng-click="openEdit(item.id)"><i
                                        class="ti-pencil"></i></button>
                                <button class="btn btn-danger btn-sm" ng-click="askToDelete(item)"><i
                                        class="ti-trash"></i></button>
                            </td>
                            <td>{{$index+1}}</td>
                            <td class="text-center">{{item.estab}}</td>
                            <td class="text-center">{{item.nombreImpresora}}</td>
                            <td class="text-center">{{item.nombreEquipo}}</td>
                            <td class="text-center">{{item.documento}}</td>
                            <td class="text-center">{{item.tipoImpresora}}</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div id="addUpdatePrinter" class="modal fade" tabindex="-1" role="dialog" data-backdrop="static"
        data-keyboard="false">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                <form ng-submit="saveEdit()">
                    <div class="modal-header">
                        <h5 class="modal-title">
                            {{tipoRegistro==1?'Nuevo':'Editar'}} Impresora
                        </h5>
                        <button type="button" class="close" data-dismiss="modal">&times;</button>
                    </div>
                    <div class="modal-body">
                        <div class="row">
                            <div class="col-xl-6 col-lg-6 col-md-12 col-sm-12 col-12">
                                <div class="form-group">
                                    <label for="">Establecimiento: </label>
                                    <select class="form-control border-select" ng-model="data.codEstab"
                                        ng-disabled="tipoRegistro==2">
                                        <option ng-value="item.codEstab" ng-repeat="item in sucursales">
                                            {{item.nombreComercial}}
                                        </option>
                                    </select>
                                </div>
                            </div>
                            <div ng-if="data.asignar" class="col-xl-3 col-lg-3 col-md-3 col-sm-3 col-12">
                                <div class="form-group">
                                    <label for="nameEquipment">Nombre Equipo:
                                    </label>
                                    <input type="text" id="nameEquipment" class="form-control border-select"
                                        ng-model="data.nombreEquipo" placeholder="PC-01">
                                </div>
                            </div>
                            <div class="col-xl-3 colg-3 col-md-3 col-sm-3 col-12">
                                <div class="form-group">
                                    <label for="ipMaquina">IP Máquina: </label>
                                    <input type="text" class="form-control border-select" ng-model="data.ipMaquina"
                                        placeholder="127.0.0.1:9100" ng-disabled="disabledInputIpMaquina">
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-xl-3 colg-3 col-md-3 col-sm-3 col-12">
                                <div class="form-group">
                                    <label for="ipMaquina">MAC Address: </label>
                                    <input type="text" class="form-control border-select" ng-model="data.ipMaquina"
                                        placeholder="00:00:00:00" ng-disabled="disabledInputIpMaquina">
                                </div>
                            </div>
                            <div class="col-xl-3 col-lg-3 col-md-3 col-sm-3 col-12">
                                <div class="form-group">
                                    <label for="">Tipo Impresora </label>
                                    <select class="form-control border-select" ng-model="data.idTipoImpresora">
                                        <option ng-value="item.idTipoImpresora" ng-repeat="item in tipoImpresoras">
                                            {{item.descripcion}}
                                        </option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-xl-3 col-lg-3 col-md-3 col-sm-3 col-12">
                                <div class="form-group">
                                    <label for="namePrinterEdit">Impresora:
                                    </label>
                                    <input type="text" id="namePrinterEdit" class="form-control border-select"
                                        ng-model="data.nombreImpresora" placeholder="epson l3150">
                                </div>
                            </div>
                            <div class="col-xl-3 colg-3 col-md-3 col-sm-3 col-12" style="margin-top: 25px;">
                                <div class="form-group">
                                    <div class="icheck-warning">
                                        <input type="checkbox" id="checkDefault" ng-model="data.predeterminada" />
                                        <label for="checkDefault">Predeterminada</label>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="table-responsive">
                            <table class="table table-no-bordered">
                                <thead>
                                    <tr>
                                        <th>N°</th>
                                        <th>Documento</th>
                                        <th class="text-center">estado</th>
                                        <th class="text-center">copia</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr ng-repeat="item in documents |filter:buscar">
                                        <td>{{$index+1}}</td>
                                        <td>{{item.descripcion}}</td>
                                        <td class="text-center">
                                            <div class="icheck-info">
                                                <input type="checkbox" id="estado{{$index+1}}" ng-model="item.estado"
                                                    ng-change="clearCopyPrint(item)" />
                                                <label for="estado{{$index+1}}"></label>
                                            </div>
                                        </td>
                                        <td class="text-center">
                                            <div class="icheck-info">
                                                <input type="checkbox" id="copy{{$index+1}}" ng-model="item.copyPrint"
                                                    ng-disabled="!item.estado" />
                                                <label for="copy{{$index+1}}"></label>
                                            </div>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="submit" class="btn btn-success"><i class="ti-save"></i> Guardar</button>
                        <button type="button" class="btn btn-dark" data-dismiss="modal">&times; Cancelar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script src="~/js/config/controllers/impresoraCtrl.min.js" asp-append-version="true"></script>
}
