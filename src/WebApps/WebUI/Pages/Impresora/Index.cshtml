@page
@model WebUI.Pages.Impresora.IndexModel;
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div ng-controller="impresoraCtrl" ng-init="initialLoad()">
    <div class="row page-titles">
        <div class="col-md-5 align-self-center">
            <h4 class="text-themecolor">Impresoras</h4>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <div class="row">
                <div class="col-6">
                    <button class="btn btn-info" id="buttonNew" ng-click="openModalNew()"><i class="ti-plus"></i>
                        Agregar
                        Impresora</button>
                </div>
            </div>
            <hr>
            <div class="table-responsive">
                <table class="table table-no-bordered">
                    <thead>
                        <tr>
                            <th class="text-center">Op.</th>
                            <th class="text-center">N°</th>
                            <th class="text-center">Estab.</th>
                            <th class="text-center">Tipo</th>
                            <th class="text-center">Impresora</th>
                            <th class="text-center">Default</th>
                            <th class="text-center">Equipo</th>
                            <th class="text-center">Servidor</th>
                            <th class="text-center">IP</th>
                            <th class="text-center">Estado</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="item in printers |filter:buscar">
                            <td class="text-center">
                                <button class="btn btn-warning btn-sm" ng-click="openEdit(item.id)"><i
                                        class="ti-pencil"></i></button>
                                <button class="btn btn-danger btn-sm" ng-click="askToDelete(item)"><i
                                        class="ti-trash"></i></button>
                            </td>
                            <td class="text-center">{{$index+1}}</td>
                            <td class="text-center">{{item.estab}}</td>
                            <td class="text-center">{{item.printerTypeName}}</td>
                            <td class="text-center">{{item.name}}</td>
                            <td class="text-center">{{item.default}}</td>
                            <td class="text-center">{{item.machine}}</td>
                            <td class="text-center">{{item.server}}</td>
                            <td class="text-center">{{item.ipAddress}}</td>
                            <td>
                                <md-switch ng-model="item.enabled" aria-label="Toggle switch"
                                    ng-change="updateStatus(item)">
                                    {{item.labelEnabled}}
                                </md-switch>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div id="addUpdatePrinter" class="modal fade" tabindex="-1" role="dialog" data-backdrop="static"
        data-keyboard="false">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                <form ng-submit="saveEdit()">
                    <div class="modal-header">
                        <h5 class="modal-title">
                            {{tipoRegistro==1?'Nuevo':'Editar'}} Impresora
                        </h5>
                        <button type="button" class="close" data-dismiss="modal">&times;</button>
                    </div>
                    <div class="modal-body">
                        <div class="row">
                            <div class="col-xl-6 col-lg-6 col-md-12 col-sm-12 col-12">
                                <div class="form-group">
                                    <label for="">Establecimiento: </label>
                                    <select class="form-control border-select" ng-model="data.establecimientoId"
                                        ng-disabled="tipoRegistro==2" required>
                                        <option ng-value="0">Seleccione un establecimiento</option>
                                        <option ng-value="item.idEstablecimiento" ng-repeat="item in sucursales">
                                            {{item.nombreComercial}}
                                        </option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-xl-3 col-lg-3 col-md-3 col-sm-3 col-12">
                                <div class="form-group">
                                    <label for="nameEquipment">Nombre Equipo:
                                    </label>
                                    <input type="text" id="nameEquipment" class="form-control border-select"
                                        ng-model="data.machine" placeholder="PC-01" required>
                                </div>
                            </div>
                            <div class="col-xl-3 colg-3 col-md-3 col-sm-3 col-12">
                                <div class="form-group">
                                    <label for="ipMaquina">IP Equipo: </label>
                                    <input type="text" class="form-control border-select" ng-model="data.ipAddress"
                                        placeholder="127.0.0.1:9200" required>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-xl-3 col-lg-3 col-md-3 col-sm-3 col-12">
                                <div class="form-group">
                                    <label for="">Tipo Impresora </label>
                                    <select class="form-control border-select" ng-model="data.printerTypeId" required>
                                        <option ng-value="0">Seleccione un tipo</option>
                                        <option ng-value="item.id" ng-repeat="item in tipoImpresoras">
                                            {{item.name}}
                                        </option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-xl-3 col-lg-3 col-md-3 col-sm-3 col-12">
                                <div class="form-group">
                                    <label for="namePrinterEdit">Impresora:</label>
                                    <input type="text" id="namePrinterEdit" class="form-control border-select"
                                        ng-if="localPrinters.length == 0" ng-model="data.name" placeholder="epson l3150"
                                        required>
                                    <select class="form-control border-select" ng-if="localPrinters.length > 0"
                                        ng-model="data.name" required>
                                        <option ng-value="0">Seleccione una impresora</option>
                                        <option ng-value="item.name" ng-repeat="item in localPrinters">
                                            {{item.name}}
                                        </option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-xl-3 colg-3 col-md-3 col-sm-3 col-12" ng-if="data.serverDevice">
                                <div class="form-group">
                                    <label for="macAddress">MAC Address: </label>
                                    <input type="text" name="macAddress" id="macAddress"
                                        class="form-control border-select" ng-model="data.macAddress"
                                        placeholder="00:00:00:00">
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-xl-3 colg-3 col-md-3 col-sm-3 col-12">
                                <div class="form-group">
                                    <div class="icheck-info">
                                        <input type="checkbox" id="checkDefault" ng-model="data.isDefault" />
                                        <label for="checkDefault">Predeterminada</label>
                                    </div>
                                </div>
                            </div>
                            <div class="col-xl-3 colg-3 col-md-3 col-sm-3 col-12">
                                <div class="form-group">
                                    <div class="icheck-primary">
                                        <input type="checkbox" name="serverDevice" id="serverDevice"
                                            ng-model="data.serverDevice" />
                                        <label for="serverDevice">Servidor</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <br>
                        <div class="table-responsive">
                            <table class="table">
                                <thead>
                                    <tr class="small">
                                        <th class="text-center">N°</th>
                                        <th>Documento</th>
                                        <th class="text-center">Estado</th>
                                        <th class="text-center">Copia</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr ng-repeat="item in documents" class="small">
                                        <td class="text-center">{{$index+1}}</td>
                                        <td>{{item.name}}</td>
                                        <td class="text-center">
                                            <input type="checkbox" class="form-check-input" id="estado{{$index+1}}"
                                                ng-model="item.enabled" ng-change="updateDocument(item)">
                                        </td>
                                        <td class="text-center">
                                            <input type="number" id="copies{{$index+1}}" class="form-control" min="1"
                                                max="3" ng-model="item.copies" ng-disabled="!item.enabled"
                                                ng-blur="updateDocument(item)">
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="submit" class="btn btn-success"><i class="ti-save"></i> Guardar</button>
                        <button type="button" class="btn btn-dark" data-dismiss="modal">&times; Cancelar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script src="~/js/config/controllers/impresoraCtrl.min.js" asp-append-version="true"></script>
}
