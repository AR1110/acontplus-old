@page
@model WebUI.Pages.Compras.RetencionCompra.IndexModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Retención Compra";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


@{
    ViewData["Title"] = "Retención de Compra";
}
<style>
    [uib-typeahead-popup].dropdown-menu {
        z-index: 999999 !important;
        max-height: 250px;
        overflow-y: auto;
        width: 50%;
    }

    .table-success-1 {
        background-color: #def5dc;
    }

        .table-success-1:hover {
            background-color: white;
        }
</style>

<div ng-controller="retencionCompraCtrl">
    <div class="row page-titles">
        <div class="col-md-5 align-self-center">
            <h4 class="text-themecolor">Gestión de Retención de Compra </h4>
        </div>
        <div class="col-md-7 align-self-center text-right">
            <div class="d-flex justify-content-end align-items-center">
                <ol class="breadcrumb">
                    @* <li class="breadcrumb-item"><a href="javascript:void(0)">Inicio</a></li>
                    <li class="breadcrumb-item active">Retención Compra</li>*@
                </ol>
                <button type="button" ng-if="accion.leer && accion.crear" ng-click="openModalNew()" class="btn btn-info m-l-15">
                    <i class="fa fa-plus-circle"></i> Nuevo
                </button>
            </div>
        </div>
    </div>


    <partial name="_ModalFiltro" />

    <!--Tabla Retencion Compra -->
    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <md-toolbar class="md-table-toolbar md-default">
                    <div class="md-toolbar-tools">
                        <div class="col-lg-9 col-md-9 col-sm-9">
                            <button type="button" class="btn btn-info" ng-click="openModalFiltro()"><i class=" fas fa-filter"></i> Filtrar</button>
                            <button class="btn  waves-effect waves-light btn-secondary" ng-click="getRetenciones()"><i class=" fas fa-sync"></i> </button>
                        </div>
                        <div class="col-lg-3 col-md-3 col-sm-3">
                            <form class="form-material">
                                <input type="text" class="form-control" ng-keyup="filterLocalRetencion()" ng-model="textFilterLocal" placeholder="Buscar" />
                            </form>
                        </div>
                    </div>
                </md-toolbar>
                <md-divider></md-divider>

                <!-- Tabla Retenciones  -->
                <md-table-container style="max-height: 400px;">
                    <table md-table resize>
                        <thead fix-head md-head>
                            <tr md-row>
                                <th md-column>Op.</th>
                                <th md-column>F. Emisión</th>
                                <th md-column>N°. Doc. </th>
                                <th md-column>Proveedor</th>
                                <th md-column>T. IVA</th>
                                <th md-column>T. RENTA</th>
                                <th md-column>Total</th>
                                <th md-column>Estado</th>
                                <th md-column>Usuario</th>
                            </tr>
                        </thead>
                        <tbody md-body>
                            <tr md-row ng-repeat="item in retenciones" ng-class="item.style">
                                <td md-cell>
                                    <md-menu>
                                        <md-button aria-label="Open demo menu" class="md-icon-button"
                                                   ng-click="$mdMenu.open($event)">
                                            <icon class="mdi mdi-menu"></icon>
                                        </md-button>
                                        <md-menu-content class="md-dense">
                                            <md-menu-item>
                                                <md-button ng-click="openModalDetalle(item)">
                                                    <span md-menu-align-target><i class="ti-menu"></i> Detalle</span>
                                                </md-button>
                                            </md-menu-item>

                                            <md-menu-item ng-if="accion.editar">
                                                <md-button ng-click="openModalEditar(item)" ng-disabled="item.gestion">
                                                    <span md-menu-align-target><i class="ti-pencil"></i> Editar</span>
                                                </md-button>
                                            </md-menu-item>


                                            <md-menu-item ng-if="accion.anular">
                                                <md-button ng-click="askToDelete(item)">
                                                    <span md-menu-align-target><i class="ti-close"></i> Anular</span>
                                                </md-button>
                                            </md-menu-item>

                                            <md-menu-item ng-if="accion.reporte">
                                                <md-button ng-click="getReport(item)">
                                                    <span md-menu-align-target><i class="fa fa-file-pdf"></i> PDF</span>
                                                </md-button>
                                            </md-menu-item>
                                        </md-menu-content>
                                    </md-menu>
                                </td>
                                <td md-cell>{{item.fechaEmision}}</td>
                                <td md-cell>{{item.nroDoc}}</td>
                                <td md-cell>{{item.proveedor}}</td>
                                <td md-cell>${{item.totalIva }}</td>
                                <td md-cell>${{item.totalRenta}}</td>
                                <td md-cell>${{item.total}}</td>
                                <td md-cell>{{item.estadoDoc}}</td>
                                <td md-cell>{{item.usuario}}</td>
                            </tr>
                            <tr ng-show="retenciones.length==0" class="text-center">
                                <td colspan="9">
                                    No hay registros en esta tabla :)
                                </td>
                            </tr>
                        </tbody>
                        <tfoot md-foot>
                            <tr md-row>
                                <td md-cell colspan="2"><span class="font-weight-bold">{{retenciones.length}} Retenciones</span></td>
                                <td md-cell colspan="2"><span class="font-weight-bold">Total:</span></td>
                                <td md-cell><span class="font-weight-bold">{{totalIva | currency:'$': 5}}</span></td>
                                <td md-cell><span class="font-weight-bold">{{totalRenta | currency:'$': 5}}</span></td>
                                <td md-cell><span class="font-weight-bold">{{total | currency:'$': 5}}</span></td>
                                <td md-cell colspan="2"></td>
                            </tr>
                        </tfoot>
                    </table>
                </md-table-container>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script src="~/js/common/components/mdAutocompleteProveedor.min.js" asp-append-version="true"></script>
    <script src="~/js/compras/services/facturaCompraService.min.js" asp-append-version="true"></script>
    <script src="~/js/compras/controllers/retencionCompraCtrl.min.js" asp-append-version="true"></script>


}
