<form autocomplete="off">    
    <div class="modal-header">         
        <h5 class="modal-title">Detalle Compra No Habitual</h5>
        <button type="button" class="close" data-dismiss="modal" ng-click="closeModal()" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
    <div class="modal-body">
        <div class="row" ng-show="showHeader">
            <div class="col-xl-5 col-lg-5 col-md-6 col-sm-12 col-12">
                <div class="form-group" >
                    <label for="categoria">Estab.: <span class="text-danger">*</span></label> 
                    <input type="text" ng-value="data.establecimiento" class="form-control border-select" disabled />

                </div>
            </div>

            <div class="col-xl-3 col-lg-3 col-md-6 col-sm-12 col-12">
                <div class="form-group">
                    <label for="puntoEmision">Punto Emision <span class="text-danger">*</span></label>  
                    <input type="text" ng-value="data.ptoEmi"  class="form-control border-select" disabled />
                </div>
            </div>

            <div class="col-xl-4 col-lg-4 col-md-6 col-sm-12 col-12">
                <div class="form-group">
                    <label>Fecha Emisión: </label>
                    <input type="date" class="form-control" ng-model="data.fechaEmision" disabled />
                    <small class="form-text text-info">{{fechaEmisionEscrita}}</small>
                </div>
            </div>

           
        </div>

        <div class="row" ng-if="showHeader">
            <div class="col-lg-5 col-md-5 col-sm-12 col-12">
                <div class="form-group">
                    <label for="">Proveedor <span class="text-danger">*</span></label>
                    <input type="text" name="" id="" class="form-control" disabled ng-value="proveedor.nombreComercial">
                </div>
            </div>

            <div class="col-xl-3 col-lg-3 col-md-3 col-sm-12 col-12">
                <div class="form-group">
                    <label>Nro. Identificación: </label>
                    <input type="text" class="form-control" ng-model="proveedor.numeroIdentificacion" ng-disabled="true">
                </div>
            </div>

            <div class="col-xl-4 col-lg-4 col-md-4 col-sm-12 col-12">
                <div class="form-group">
                    <label>Dirección: </label>
                    <input type="text" ng-model="proveedor.direccion" ng-disabled="true" class="form-control" />
                </div>
            </div>
        </div>


                     
         <button type="button" class="btn btn-success mb-2" ng-click="getReport()">
            <i class="far fa-file-excel"></i> Exportar Excel 
        </button> 

                    
        <div id="grid" ui-grid="gridOptions" ui-grid-resize-columns ui-grid-auto-resize class="grid">
        </div>

        <div class="row mt-1">
            <div class="col-xl-9 col-lg-9 col-md-6 col-sm-12 col-12">
                <div class="card border border-secondary-1">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-lg-2 col-md-6 col-sm-12 col-12">
                                <div class="form-group">
                                    <label>% Descuento</label>
                                    <div class="input-group">
                                        <input ng-model="data.porcentajeDescuento" disabled decimal
                                            class="form-control border-select" />
                                        <div class="input-group-append">
                                            <button type="button" class="btn btn-secondary btn-sm" disabled>
                                                <i class="fa fa-calculator fa-xs"></i>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-lg-2 col-md-6 col-sm-12 col-12">
                                <div class="form-group">
                                    <label>Descuento</label>
                                    <div class="input-group">
                                        <input ng-model="data.totalDescuento" id="totalDescuento" disabled decimal
                                            placeholder="0.00" class="form-control border-select" />
                                        <div class="input-group-append">
                                            <button type="button" class="btn btn-secondary btn-sm" disabled>
                                                <i class="fa fa-calculator fa-xs"></i>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div> 

                            <div class="col-lg-6 col-md-6 col-sm-12 col-12">
                                <div class="form-group">
                                    <label>Observacion</label>
                                    <textarea class="form-control border-select" ng-model="data.observacion" touppercase
                                        disabled placeholder="..."></textarea>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-lg-3 col-md-6 col-sm-12 col-12">
                <div class="card border p-2">

                    <div id="drawImpuestoTotalesDetalle"></div>

                </div> 
            </div>
        </div>


    </div>
    <div class="modal-footer"> 
        <button type="button" class="btn btn-dark waves-effect" ng-click="closeModal()">&times; Cerrar</button>
    </div>
       
</form>