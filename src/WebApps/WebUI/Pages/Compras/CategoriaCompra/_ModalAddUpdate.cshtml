<div class="modal-header">
    <h5 class="modal-title">{{titleModal}} Categoria de Compra</h5>
    <button class="close" ng-click="closeModal()">&times;</button>
</div>
<div class="modal-body">
    <div class="row">
        <div class="form-group col-lg-12 col-md-12 col-sm-12 col-12">
            <label for="Descripcion">Descripción <span class="text-danger">*</span></label>
            <input type="text" ng-model="data.descripcion" touppercase class="form-control border-select" 
                    ng-keyup="obtenerTresLetras()" placeholder="Ej: Inventarios">
        </div>
    </div>
    <div class="row">
        <div class="form-group col-lg-12 col-md-12 col-sm-12 col-12">
            <label for="codigo">Código <span class="text-danger">*</span></label>
            <input type="text" ng-model="data.codigo"  touppercase 
                    ng-disabled="tipoRegistro==2" class="form-control border-select" placeholder="Ej: INV">
        </div>
    </div>
    <div ng-if="tipoRegistro==2">
        <label for="">Estado: </label>
        <md-radio-group ng-model="data.estado">
            <md-radio-button ng-value="true">Activo</md-radio-button>
            <md-radio-button ng-value="false">Inactivo</md-radio-button>
        </md-radio-group>
    </div>
</div>
<div class="modal-footer">
    <button type="submit" class="btn btn-success" ng-click="save()">
        {{btnTextSave}}
    </button>
    <button type="button" class="btn btn-dark" ng-click="closeModal()">&times; Cerrar</button>
</div>