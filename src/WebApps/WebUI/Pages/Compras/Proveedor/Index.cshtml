@page
@model IndexModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Proveedor";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div ng-controller="proveedorCtrl">
    <div class="row page-titles">
        <div class="col-lg-5 align-self-center">
            <h5 class="text themecolor">Gestión de Proveedores</h5>
        </div>
        <div class="col-lg-7 align-self-center text-right">
            <div class="d-flex justify-content-end align-items-center">
                <button class="btn btn-info m-l-15" ng-if="accion.crear" btn-proveedor-add-update result-modal="resultModal(result)"><i class="fa fa-plus-circle"></i> Nuevo</button>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div class="col-3">
                            <span class="form-group pull-left page-size form-inline">
                                <select class="form-control border-color control-color" ng-model="dataSearch.pageSize"
                                        ng-change="changePageSize()" ng-options="ra for ra in recordsQuantity">
                                </select>
                            </span>
                        </div>
                        <div class="col-lg-3 col-md-6 col-sm-12 col-12">
                            <form class="form-material">
                                <div class="input-group">
                                    <input type="text" class="form-control" ng-model="dataSearch.textSearch" ng-keyup="onKeyupSearchProveedor()" placeholder="Buscar Proveedor" />
                                    <div class="input-group-append" ng-click="reloadProveedores()">
                                        <button class="btn btn-info">
                                            <i class="fas fa-redo"></i>
                                        </button>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>


                    <div class="table-responsive">
                        <table class="table">
                            <thead>
                            <th ng-show="accion.editar || accion.eliminar">Op.</th>
                            <th>N°</th>
                            <th>Ruc</th>
                            <th>Nombre Fiscal</th>
                            <th>Dirección</th>
                            <th>Teléfono</th>
                            <th>Estado</th>
                            </thead>
                            <tbody>
                                <tr ng-repeat="item in proveedores">
                                    <td ng-show="accion.editar || accion.eliminar">
                                        <div layout="row" layout-align="start center">
                                            <button 
                                            class="btn btn-info btn-xs" 
                                            ng-if="accion.editar"  
                                            btn-proveedor-add-update result-modal="resultModal(result)"
                                            params = 'item'
                                            > <i class="ti-pencil"></i></button>
                                            <button class="btn btn-danger btn-xs ml-2" ng-if="accion.eliminar" ng-click="askToDelete(item)"> <i class="ti-trash"></i></button>
                                        </div>
                                    </td>
                                    <td>{{$index+1}}</td>
                                    <td>{{item.numeroIdentificacion}}</td>
                                    <td>{{item.razonSocial}}</td>
                                    <td>{{item.direccion}}</td>
                                    <td>{{item.telefono}}</td>
                                    <td ng-bind-html="item.estado|estadoPrimario"></td>
                                </tr>
                                <tr ng-show="proveedores.length==0" class="text-center">
                                    <td colspan="7">
                                        No hay registros en esta tabla :)
                                    </td>
                                </tr>
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="7"> 
                                        <ul uib-pagination total-items="totalRecords" items-Per-Page="dataSearch.pageSize"
                                            ng-change="pagechanged()" ng-model="dataSearch.pageIndex" max-size="maxSize"
                                            class="pagination" boundary-links="true" rotate="false"></ul>
                                    </td>
                                </tr>
                            <tfoot>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/compras/controllers/proveedorCtrl.min.js" asp-append-version="true"></script>
}