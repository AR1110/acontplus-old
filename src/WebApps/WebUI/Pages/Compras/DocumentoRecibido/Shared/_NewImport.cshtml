 
 
<div class="modal-header">
    <h4 class="modal-title">
        <icon class="ti-upload"></icon> Nueva Importacion
    </h4>
    <button type="button" class="close" data-dismiss="modal" ng-click="closeModal()">&times;</button>
</div>
<div class="modal-body">
    <div class="list-group list-group-horizontal" id="importarXML">
        <a href="javascript:void(0)" ng-click="stepImportarXML()" class="list-group-item list-group-item-action active">
            <div>Paso 1 </div>
            <span>Importar XML</span>
        </a>
        <a href="javascript:void(0)" ng-click="stepCompFounded()" class="list-group-item list-group-item-action">
            <div>Paso 2 </div>
            <span>Comprobantes Encontrados</span>
        </a>
    </div>

    
    
    <div class="tab-content mt-2">
        <div class="tab-pane fade show active" id="stepImportarXML" role="tabpanel">
            <div class="card">
                <div class="card-body shadow">

                    <h4><span class="text-dark">Establecimiento: </span> {{dataEstab.nombreComercial}}</h4>
                    <hr>
                        <div class="row">
                            <div class="col-12">
                                <div class="form-group">
                                    <label for="">Archivo Sri:</label>
                                    <input type="file" ngf-select ng-model="fileTxt" class="form-control">
                                </div>
                            </div>
                        </div>        
                
                </div>
            </div>
        </div>

        <div class="tab-pane fade show active" id="stepCompFounded" style="display: none;" role="tabpanel">
           <div class="card">
                <div class="card-body shadow">
                    <h4><span class="text-dark">Establecimiento: </span> {{dataEstab.nombreComercial}}</h4>
                    <hr>

                    <div class="row">
                        <div class="col-12">
                            <p class="text-warning">Por favor seleccione solamente los comprobantes que se registraran en este ESTABLECIMIENTO!</p>
                        </div>
                    </div>
                    <div class="table-responsive">
                        <table md-table md-row-select multiple ng-model="compToImport" md-progress="promise">
                            <caption>Lista de Importaciones</caption>
                            <thead md-head md-order="query.sortBy" fix-head>
                                <tr md-row>
                                    <th md-column>Doc.</th>
                                    <th md-column md-order-by="serieComprobante">Serie</th>
                                    <th md-column>Ruc Emisor</th>
                                    <th md-column md-order-by="razonSocialEmisior">
                                        <span>Razón Social Emisor</span>
                                    </th>
                                    <th md-column>Fecha Emisión</th>
                                    <th md-column>F. Aut.</th>
                                    <th md-column md-order-by="importeTotal">Total</th>
                                    <th md-column>No. Aut.</th>
                                </tr>
                            </thead>
                            <tbody md-body>
                                <tr md-row md-select="item" md-select-id="index"
                                    md-auto-select ng-repeat="item in compFounded">
                                    <td md-cell>{{item.comprobante}}</td>
                                    <td md-cell>{{item.serieComprobante}}</td>
                                    <td md-cell>{{item.rucEmisor}}</td>
                                    <td class="text-lSoeft" md-cell>
                                        {{item.razonSocialEmisior}}
                                    </td>
                                    <td md-cell>{{item.fechaEmision}}</td>
                                    <td md-cell>{{item.fechaAutorizacion}}</td>
                                    <td md-cell class="text-right">
                                        {{item.importeTotal |
                                        currency }}
                                    </td>
                                    <td class="text-left" md-cell>
                                        {{item.numeroAutorizacion}}
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                </div>
            </div>
        </div>
    </div> 
</div>
<div class="modal-footer">

    
    <div ng-show="footerActionStepUno">
        <button type="button" class="btn btn-info" ng-click="readFileTxt()"><i class=" fas fa-angle-right"></i> Siguiente</button>
        <button type="button" class="btn btn-dark" ng-click="closeModal()">&times; Cerrar</button>
    </div>
    <div ng-show="footerActionStepDos">
        <button type="button" class="btn btn-info" ng-click="stepGoToImportTxt()"><i class=" fas fa-angle-left"></i> Atras</button>
        <button type="button" class="btn btn-success" ng-click="askToSaveFounded()"> <i class="ti-save"></i> Guardar</button>
    </div>   
</div> 

<div id="xmlIndividualModal" class="modal fade" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form ng-submit="putXmlManual()">
                <div class="modal-header">
                    <h4 class="modal-title">
                        <icon class="ti-upload"></icon> Subir Xml
                    </h4>
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <div class="col-xl-6 col-lg-6 col-md-6 col-sm-12 col-12">
                            <div class="form-group">
                                <label for="comprobante">Comprobante:</label>
                                <input type="text" class="form-control" value="{{selected[0].comprobante}}"
                                       disabled>
                            </div>
                        </div>
                        <div class="col-xl-6 col-lg-6 col-md-6 col-sm-12 col-12">
                            <div class="form-group">
                                <label for="comprobante">Serie:</label>
                                <input type="text" class="form-control" value="{{selected[0].serieComprobante}}"
                                       disabled>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">
                            <div class="form-group">
                                <label for="comprobante">Clave Acceso:</label>
                                <input type="text" class="form-control" value="{{selected[0].claveAcceso}}"
                                       disabled>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-12">
                            <div class="form-group">
                                <label for="">Archivo Xml Sri:</label>
                                <input type="file" ngf-select ng-model="fileXml" class="form-control">
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-success"><i class="ti-upload"></i> Subir</button>
                    <button type="button" class="btn btn-dark" data-dismiss="modal">
                        <i class="ti-close"></i>
                        Cerrar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>