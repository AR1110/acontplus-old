 
<form ng-submit="askToMigrate()">
    <div class="modal-content">
        <div class="modal-header">
            <h5 class="modal-title">Migrar comprobantes</h5>
            <button type="button" class="close" data-dismiss="modal" ng-click="closeModal()">&times;</button>
        </div>
        <div class="modal-body">
            <div class="row">
                <div class="col-xl-6 col-lg-6 col-md-6 col-sm-6 col-12">
                    <div class="form-group">
                        <label>Establecimiento Origen: </label>
                        <h5 class="text-danger">{{dataEstab.nombreComercial}}</h5>
                    </div>
                </div>
                <div class="col-xl-6 col-lg-6 col-md-6 col-sm-6 col-12">
                    <div class="form-group">
                        <label>Establecimiento Destino: </label>
                        <select class="form-control border-select" ng-model="migrate.codEstab">
                            <option ng-value="item.codEstab" ng-repeat="item in establecimientosToMigrate">
                                {{item.nombreComercial}}
                            </option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-12">
                    <p class="text-warning">Por favor seleccione solamente los comprobantes que se migraran al ESTABLECIMIENTO de destino!</p>
                </div>
            </div>
            <div class="table-responsive">
                <table md-table md-row-select multiple ng-model="comprobantesToMigrate" md-progress="promise">
                    <caption>Lista de Importaciones</caption>
                    <thead md-head md-order="query.sortBy">
                        <tr md-row>
                            <th md-column>Doc.</th>
                            <th md-column md-order-by="serieComprobante">Serie</th>
                            <th md-column>Ruc Emisor</th>
                            <th md-column md-order-by="razonSocialEmisior">
                                <span>Razón Social Emisor</span>
                            </th>
                            <th md-column>Fecha Emisión</th>
                            <th md-column>F. Aut.</th>
                            <th md-column md-order-by="importeTotal">Total</th>
                            <th md-column>No. Aut.</th>
                        </tr>
                    </thead>
                    <tbody md-body>
                        <tr md-row md-select="item" md-select-id="index"
                            md-auto-select ng-repeat="item in comprobantesTempToMigrate">
                            <td md-cell>{{item.comprobante}}</td>
                            <td md-cell>{{item.serieComprobante}}</td>
                            <td md-cell>{{item.rucEmisor}}</td>
                            <td class="text-lSoeft" md-cell>
                                {{item.razonSocialEmisior}}
                            </td>
                            <td md-cell>{{item.fechaEmision}}</td>
                            <td md-cell>{{item.fechaAutorizacion}}</td>
                            <td md-cell class="text-right">
                                {{item.importeTotal |
                                currency }}
                            </td>
                            <td class="text-left" md-cell>
                                {{item.numeroAutorizacion}}
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
        <div class="modal-footer">
            <button type="submit" class="btn btn-success"><i class="fa-solid fa-file-export"></i> Migrar</button>
            <button type="button" class="btn btn-dark" data-dismiss="modal" ng-click="closeModal()">&times; Cancelar</button>
        </div>
    </div>
</form>
     