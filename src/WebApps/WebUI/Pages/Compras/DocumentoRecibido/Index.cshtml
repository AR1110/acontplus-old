@page
@model WebUI.Pages.Compras.DocumentoRecibido.IndexModel

@{
    ViewData["Title"] = "Index";
    
}

<div ng-controller="documentoRecibidoCtrl">
    <div class="row page-titles">
        <div class="col-md-5 align-self-center">
            <h5 class="text-themecolor">Recepción de Comprobantes</h5>
        </div>
        <div class="col-md-7 align-self-center text-right">
            <div class="d-flex justify-content-end align-items-center">

            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <div class="row">
                <div class="col-xl-4 col-lg-4 col-md-6 col-sm-12 col-12">
                    <div class="form-group">
                        <span for="establecimiento">
                            Estab: <span class="text-danger">*</span>
                        </span>
                        <select class="form-control border-select" ng-model="dataSearch.codEstab"
                                ng-change="onChangeEstab()">
                            <option ng-value="item.codEstab" ng-repeat="item in establecimientos">
                                {{item.nombreComercial}}
                            </option>
                        </select>
                    </div>
                </div>
                <div class="col-xl-3 col-lg-3 col-md-6 col-sm-12 col-12">
                    <span for="date-range-filter">Rango Fechas: </span>
                    <div class="input-group">
                        <div class="input-group-prepend">
                            <div class="input-group-text">
                                <div class="custom-control custom-checkbox mr-sm-2">
                                    <input type="checkbox" ng-model="dataSearch.checkBoxFecha"
                                           class="custom-control-input" id="checkBoxFecha">
                                    <label class="custom-control-label" for="checkBoxFecha"></label>
                                </div>
                            </div>
                        </div>

                        <date-range-filter current-date="dataSearch.fechaInicio" start-date="dataSearch.fechaInicio"
                                           end-date="dataSearch.fechaFin"
                                           result-range-date="resultRangeFilter(result)"></date-range-filter>
                    </div>

                </div>

                <div class="col-xl-3 col-lg-3 col-md-6 col-sm-12 col-12">
                    <div class="form-group">
                        <span for="tipoComprobante">
                            Tipo Comprobante
                        </span>
                        <select class="form-control border-select" ng-model="dataSearch.codDoc"
                                ng-change="getComprobantes()">
                            <option ng-value="">Todos</option>
                            <option ng-value="item.codDoc" ng-repeat="item in tipoComprobantes">
                                {{item.descripcion}}
                            </option>
                        </select>
                    </div>
                </div>

                <div class="col-xl-2 col-lg-2 col-md-6 col-sm-12 col-12">
                    <div class="btn-group btn-group-sm mt-4" role="group" aria-label="Basic example">
                        <button type="button" class="btn btn-info" ng-click="onClickBtnMore()">
                            <i class="{{extraOptionsIcon}}" uib-tooltip="{{extraOptionsTooltip}}"></i>
                        </button>
                        <button type="button" class="btn btn-success" uib-tooltip="Recargar"
                                ng-click="getComprobantes()">
                            <i class="fas fa-redo"></i>
                        </button>
                    </div>
                </div>

            </div>

            <div class="row" ng-if="moreOptionsFilter">
                <div class="col-xl-4 col-lg-4 col-md-6 col-sm-12 col-12">
                    <div class="form-group">
                        <span for="proveedorFiltro">Proveedor:</span>
                        <input type="text" id="providerInputSearch" class="form-control border-select"
                               ng-model="proveedor.nombreProveedor" provider-search-drtv
                               on-select="onSelectProveedor(result)" on-keyup="onKeyupProveedor()"
                               placeholder="Ingrese C.I o Nombre Comercial" onclick="select();">

                        <script type="text/ng-template" id="autocompleteProviderTemplate.html">
                            <div class="autocomplete-suggestion-uib-typeahead">
                                <span class="item-title"><b> {{match.model.numeroIdentificacion}}</b> - {{match.model.nombreFiscal}}</span>
                            </div>
                        </script>
                    </div>
                </div>
                <div class="col-xl-4 col-lg-4 col-md-4 col-sm-12 col-12">
                    <div class="form-group">
                        <span for="claveAcceso">Clave Acceso:</span>
                        <input type="text" class="form-control border-select" ng-change="onChangeClaveAcceso()" id="claveAcceso"
                               valid-number ng-model="dataSearch.claveAcceso" />
                        <span class="text-info" ng-if="claveAccesoLongitud">{{claveAccesoLongitud}} dígitos</span>
                    </div>
                </div>
                <div class="col-xl-4 col-lg-4 col-md-4 col-sm-12 col-12">
                    <div class="form-group">
                        <span for="serieComprobante">Nro. Documento:</span>
                        <input type="text" class="form-control border-select" id="serieComprobante"
                               ng-change="onChangeSerieComprobante()" valid-number
                               ng-model="dataSearch.serieComprobante" />
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="button-group ml-2">
                    <button hidden type="button" class="btn btn-info" ng-click="openModalImportacionAutomatica()">
                        <i class="ti-cloud"></i> Importación Automatica
                    </button>
                    <button class="btn btn-danger" ng-click="openModalImportacionManual()">
                        <i class="fa fa-keyboard"></i> Importación Manual
                    </button>
                    <button class="btn btn-success" ng-click="openModalMigrate()">
                        <i class="fa-solid fa-file-export"></i> Migrar Comprobantes
                    </button> 
                    <button class="btn btn-warning" ng-if="selected.length > 0" ng-click="editSubcategory()">
                        <i class="fa fa-pencil"></i> Modificar Subcategoria
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <div class="row">
                <div class="col-6 d-flex justify-content-start">
                    <span class="form-group pull-left page-size form-inline">
                        <select class="form-control control-color border-select" ng-model="dataSearch.pageSize"
                                ng-change="changePageSize()" ng-options="ra for ra in recordsQuantity">
                        </select>
                    </span>
                </div>

                <div class="col-6 d-flex justify-content-end">
                    <form class="form-material">
                        <input type="text" class="form-control" onclick="select();" ng-keyup="onKeyupSearchFilter()"
                               ng-model="dataSearch.textSearch" placeholder="Buscar en el listado actual">
                    </form>
                </div>
            </div>
            <div class="table-responsive" style="max-height: 400px;">
                <table md-table md-row-select="true" ng-model="selected" md-progress="promise" multiple="true">
                    <thead md-head md-order="query.sortBy" fix-head>
                        <tr md-row>
                            <th md-column>Op.</th>
                            <th md-column>Subcategoría</th>
                            <th md-column>No. Aut.</th>
                            <th md-column>Doc.</th>
                            <th md-column md-order-by="serieComprobante">Serie</th>
                            <th md-column>Ruc Emisor</th>
                            <th md-column md-order-by="razonSocialEmisor">
                                <span>Razón Social Emisor</span>
                            </th>
                            <th md-column md-order-by="fechaEmision">Fecha Emisión</th>
                            <th md-column>F. Aut.</th>
                            <th md-column md-order-by="importeTotal">Total</th>
                        </tr>
                    </thead>
                    <tbody md-body>
                        <tr md-row md-select="item" md-select-id="index"
                            md-auto-select="false"
                            ng-repeat="item in comprobantes | orderBy: query.sortBy track by $index"
                            style="{{item.colorRow}}" title="{{item.hoverText}}">
                            <td md-cell>
                                <md-menu>
                                    <md-button aria-label="Open Options" class="md-icon-button"
                                               ng-click="$mdMenu.open($event)">
                                        <icon class="fa fa-bars"></icon>
                                    </md-button>
                                    <md-menu-content class="md-dense">
                                        <md-menu-item>
                                            <md-button ng-click="getById(item)">
                                                <span md-menu-align-target><i class="fa fa-upload"></i> Visualizar Comprobante</span>
                                            </md-button>
                                        </md-menu-item>
                                        <md-menu-item>
                                            <md-button ng-click="getMergedDocs(item)">
                                                <span md-menu-align-target><i class="fa fa-link"></i> Docs. Relacionados</span>
                                            </md-button>
                                        </md-menu-item>
                                        <md-menu-item ng-if="!item.complete">
                                            <md-button ng-click="putXml(item)">
                                                <span md-menu-align-target><i class="fa fa-sync"></i>Actualizar Xml</span>
                                            </md-button>
                                        </md-menu-item>
                                        <md-menu-item>
                                            <md-button ng-click="downloadXml(item)">
                                                <span md-menu-align-target><i class="fa fa-download"></i> Descargar Xml</span>
                                            </md-button>
                                        </md-menu-item>
                                        <md-menu-item ng-if="!item.complete">
                                            <md-button ng-click="askToDelete(item)">
                                                <span md-menu-align-target><i class="fa fa-trash"></i> Eliminar</span>
                                            </md-button>
                                        </md-menu-item>
                                        <md-menu-item ng-if="(item.codDoc == '01')">
                                            <md-button ng-click="getRide(item)">
                                                <span md-menu-align-target><i class="fa fa-file-pdf"></i> Ride</span>
                                            </md-button>
                                        </md-menu-item>
                                    </md-menu-content>
                                </md-menu>
                            </td>
                            <td md-cell style="{{item.colorCol}}">{{item.subcategoryName}}</td>
                            <td class="text-left" style="{{item.colorCol}}" md-cell>
                                {{item.numeroAutorizacion}}
                            </td>
                            <td md-cell style="{{item.colorCol}}">{{item.comprobante}}</td>
                            <td md-cell style="{{item.colorCol}}">{{item.serieComprobante}}</td>
                            <td md-cell style="{{item.colorCol}}">{{item.rucEmisor}}</td>
                            <td class="text-left" style="{{item.colorCol}}" md-cell>
                                {{item.razonSocialEmisor}}
                            </td>
                            <td md-cell style="{{item.colorCol}}">{{item.fechaEmision}}</td>
                            <td md-cell style="{{item.colorCol}}">{{item.fechaAutorizacion}}</td>
                            <td md-cell class="text-right" style="{{item.colorCol}}">
                                {{item.importeTotal |
                                currency }}
                            </td>
                        </tr>
                    </tbody>
                    <tfoot ng-if="comprobantes.length == 0">
                        <tr>
                            <td colspan="8">No se encontraron registros</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
        <div class="card-body">
            <ul uib-pagination total-items="dataSearch.totalRecords" items-Per-Page="dataSearch.pageSize"
                ng-change="pagechanged()" ng-model="dataSearch.pageIndex" max-size="dataSearch.maxSize"
                class="pagination" boundary-links="true" rotate="false"></ul>
        </div>
    </div>
</div>
@section Scripts {
    <environment include="Development">
        <script src="~/js/compras/services/docRecibidoService.js" asp-append-version="true"></script>
        <script src="~/js/contabilidad/services/subcategoryService.js" asp-append-version="true"></script>
        <script src="~/js/compras/controllers/documentoRecibidoCtrl.js" asp-append-version="true"></script>
    </environment>
    <environment include="Staging,Production">
        <script src="~/js/compras/services/docRecibidoService.min.js" asp-append-version="true"></script>
        <script src="~/js/contabilidad/services/subcategoryService.min.js" asp-append-version="true"></script>
        <script src="~/js/compras/controllers/documentoRecibidoCtrl.min.js" asp-append-version="true"></script>
    </environment>
}
