@page
@model WebUI.Pages.Compras.DocumentoRecibido.IndexAngularModel
@{
    ViewData["Title"] = "Documento Recibido";
}

<div id="iframeApp" ng-controller="iframeAngularCtrl"></div>
@section Scripts {
    <script src="~/js/controllers/iframeAngularCtrl.js" asp-append-version="true"></script>
    <script>
            window.angularAppUrl = @Html.Raw(Json.Serialize(Model.AngularAppUrl));
    </script>
}