@page
@model WebUI.Pages.ConsumoTpv.ReportModel
@{
    ViewData["Title"] = "Reporte";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div ng-controller="reporteTpvCtrl">
    <div class="row page-titles">
        <div class="col-md-5 align-self-center">
            <h5 class="text-themecolor">Reportes TPV</h5>
        </div>
    </div>
    <div class="row">
        <div class="col-xl-6 col-lg-6 col-md-6 col-sm-12 col-12 offset-xl-3 offset-lg-3 offset-md-3">
            <div class="card">
                <form ng-submit="getReport()">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-xl-6 col-lg-6 col-md-6 col-sm-6 col-12">
                                <div class="form-group">
                                    <label for="idConfigTpv">Servicio:</label>
                                    <select name="idConfigTpv" id="idConfigTpv" class="form-control">
                                        <option ng-value="item.idConfigTpv" ng-repeat="item in configurations">
                                            {{item.descripcion}}
                                        </option>
                                        <option value="0" ng-seleted="0">Consolidado</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">
                                <div class="form-group">
                                    <label for="idEmpresa">Empresa:</label>
                                    <select name="idEmpresa" id="idEmpresa" class="form-control"
                                            ng-model="report.idEmpresa" required>
                                        <option value="">Seleccione</option>
                                        <option ng-value="item.idEmpresa" ng-repeat="item in empresas">
                                            {{item.razonSocial}}
                                        </option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-xl-6 col-lg-6 col-md-6 col-sm-6 col-12">
                                <div class="form-group">
                                    <label for="fechaInicio">Fecha Inicio:</label>
                                    <input type="date" id="fechaInicio" class="form-control"
                                           ng-model="report.fechaInicio" required />
                                </div>
                            </div>
                            <div class="col-xl-6 col-lg-6 col-md-6 col-sm-6 col-12">
                                <div class="form-group">
                                    <label for="fechaInicio">Fecha Fin:</label>
                                    <input type="date" id="fechaFin" class="form-control" ng-model="report.fechaFin"
                                           required />
                                </div>
                            </div>
                        </div>
                        <div class="card-footer">
                            <button type="submit" class="btn btn-success"><i class="fa fa-file-excel"></i> Descargar</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script src="~/js/controllers/restaurant/reporteTpvCtrl.js" asp-append-version="true"></script>
}