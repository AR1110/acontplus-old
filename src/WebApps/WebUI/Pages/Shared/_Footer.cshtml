@model dynamic
<footer class="footer">
    <div class="row g-4">
        <div class="col-12 col-sm-4 col-md-4 col-lg-3 col-xl-3">
            <p class="mb-0">
                Copyright &copy; 2021 - <a class="text-decoration-none fs-4 me-4 text-danger"
                    href="@(Model["BusinessUrl"])" target="_blank">Acontplus</a>
            </p>
        </div>
        <div class="col-12 col-sm-8 col-md-8 col-lg-9 col-xl-9">
            <div class="social float-right">
                <a href="@(Model["UserManual"])" class="btn btn-info" data-bs-toggle="tooltip"
                    title="Manual de Usuario">
                    <i aria-hidden="true" class="fa fa-book-open-reader"></i>
                </a>
                <a href="@(Model["Whatsapp"])" target="_blank" class="btn btn-success" data-bs-toggle="tooltip"
                    title="Si requiere ayuda personalizada comuniquese al siguiente número!">
                    <i aria-hidden="true" class="fab fa-whatsapp"></i>
                </a>
                <a href="@(Model["Facebook"])" target="_blank" class="btn btn-facebook" data-bs-toggle="tooltip"
                    title="Visita nuestra página en Facebook">
                    <i aria-hidden="true" class="fab fa-facebook-f"></i>
                </a>
                <a href="@(Model["Youtube"])" target="_blank" class="btn btn-youtube" data-bs-toggle="tooltip"
                    title="Visita nuestro canal en Youtube">
                    <i aria-hidden="true" class="fab fa-youtube"></i>
                </a>
                <a href="@(Model["GooglePlay"])" target="_blank" class="btn btn-playstore" data-bs-toggle="tooltip"
                    title="Descargar desde Google Play">
                    <i aria-hidden="true" class="fab fa-google-play"></i>
                </a>
            </div>
        </div>
    </div>
</footer>
