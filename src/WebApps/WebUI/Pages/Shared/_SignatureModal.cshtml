
<div class="modal-header">
    <h5 class="modal-title"><i class="fa fa-warning text-danger"></i> Firma Electrónica</h5>
    <button type="button" class="close" ng-click="onClose()">&times;</button>
</div>
<div class="modal-body">
    <h5>
        {{message}}
    </h5>
</div>
<div class="modal-footer">
    <button type="submit" class="btn btn-outline-success btn-sm" ng-click="onSupport()"><i class="fa fa-user-cog"></i> Solicitar soporte</button>
    <button type="button" class="btn btn-outline-dark btn-sm" ng-click="onClose()">&times; Cerrar</button>
</div>

