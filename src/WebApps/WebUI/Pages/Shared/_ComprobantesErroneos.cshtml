<div class="modal-header">
    <h5 class="modal-title">
        <i class="fa fa-warning text-danger"></i>
        Comprobantes Electrónicos Pendientes - {{dataSearch.totalRecords}} docs.
    </h5>
    <button type="button" class="close" ng-click="onClose()">&times;</button>
</div>
<div class="modal-body">
    <div class="row">
        <div class="col-lg-4">
            <span class="form-group pull-left page-size form-inline">
                <select class="form-control form-control-sm control-color" ng-model="dataSearch.pageSize"
                    ng-change="changePageSize()" ng-options="ra for ra in dataSearch.recordsQuantity">
                </select>
            </span>
        </div>
        <div class="col-lg-8 d-flex justify-content-end">
            <div class="pull-right">
                <ul uib-pagination total-items="dataSearch.totalRecords" items-Per-Page="dataSearch.pageSize"
                    ng-change="pageChanged()" ng-model="dataSearch.pageIndex" max-size="dataSearch.maxSize"
                    class="pagination" boundary-links="true" rotate="false"></ul>
            </div>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-sm table-bordered">
            <caption>
                <h5 class="text-danger">Se encontraron los siguientes comprobantes sin autorizar o posiblemente con
                    errores, por favor verifique!</h5>
            </caption>
            <thead>
                <tr class="small text-center">
                    <th>N°</th>
                    <th>Doc.</th>
                    <th>Serie</th>
                    <th>Fecha Emisión</th>
                    <th>Clave Acceso</th>
                    <th>Estado</th>
                    <th>Ambiente</th>
                </tr>
            </thead>
            <tbody>
                <tr ng-repeat="item in docs" class="small p-5">
                    <td>{{$index+1}}</td>
                    <td>{{item.comprobante}}</td>
                    <td>{{item.serieComprobante}}</td>
                    <td>{{item.fechaEmision}}</td>
                    <td>{{item.claveAcceso}}</td>
                    <td>{{item.estado}}</td>
                    <td>{{item.ambiente}}</td>
                </tr>
            </tbody>
        </table>

    </div>
</div>
<div class="modal-footer">
    <button type="button" class="btn btn-info btn-sm" ng-click="fixDocs()"><i class="ti-hand-point-right"></i>
        Revisar</button>
    <button type="button" class="btn btn-dark btn-sm" ng-click="onClose()">&times; Cerrar</button>
</div>