@model dynamic
<header class="topbar">
    <nav class="navbar top-navbar navbar-expand-md navbar-dark">
        <!-- ============================================================== -->
        <!-- Logo -->
        <!-- ============================================================== -->
        <div class="navbar-header">
            <a class="navbar-brand" href="/Index">
                <b>
                    <!-- Dark Logo icon -->
                    <img src="~/assets/images/icon/logo-icon.png" width="190" alt="homepage"
                        class="dark-logo img-fluid">
                    <!-- Light Logo icon -->
                    <img src="~/assets/images/icon/logo-icon.png" width="190" alt="homepage"
                        class="light-logo img-fluid">
                </b>

                <!-- dark Logo text -->
                <span style="">
                    @* <!-- dark Logo text -->
                    <img src="../assets/images/logo-text.png" alt="homepage" class="dark-logo">
                    <!-- Light Logo text -->
                    <img src="../assets/images/logo-light-text.png" class="light-logo" alt="homepage"> *@
                </span>
            </a>
        </div>

        <!-- ============================================================== -->
        <!-- End Logo -->
        <!-- ============================================================== -->

        <div class="navbar-collapse">

            <!-- ============================================================== -->
            <!-- toggle and nav items -->
            <!-- ============================================================== -->
            <ul class="navbar-nav mr-auto">
                <!-- This is  -->
                <li class="nav-item">
                    <a class="nav-link nav-toggler d-block d-md-none waves-effect waves-dark" href="javascript:void(0)">
                        <icon class="ti-menu"></icon>
                    </a>
                </li>
                <li class="nav-item" id="toggleButton">
                    <a id="menu_toggle"
                        class="nav-link sidebartoggler d-none d-lg-block d-md-block waves-effect waves-dark"
                        href="javascript:void(0)">
                        <icon class="icon-menu"></icon>
                    </a>
                </li>
                <!-- ============================================================== -->
                <li class="nav-item">
                    <a class="nav-link d-lg-block m-md-block d-none text-white" href="javascript:void(0)">
                        <span id="horaActual"></span>
                    </a>
                </li>
            </ul>

            <div class="navbar-nav d-lg-block m-md-block d-none mx-auto text-white">
                <div class="d-flex flex-column">
                    <div class="p-0 text-white">{{userData.tradeName}}</div>
                    <div class="p-0 text-white"><small>{{userData.businessName}}</small></div>
                </div>
            </div>

            <!-- ============================================================== -->
            <!-- User profile and search -->
            <!-- ============================================================== -->
            <ul class="navbar-nav my-lg-0">

                <li class="nav-item dropdown u-pro">
                    <a class="nav-link dropdown-toggle waves-effect waves-dark profile-pic" href=""
                        data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                        <img src="~/assets/images/user/user.png" alt="user" class="">
                        <span class="hidden-md-down">
                            Hola,
                            {{userData.username}} &nbsp;<icon class="fa fa-angle-down"></icon>
                        </span>
                    </a>
                    <div class="dropdown-menu dropdown-menu-right animated flipInY">
                        <a href="/Config/UserProfile/Index" class="dropdown-item">
                            <icon class="ti-user"></icon> Mi perfil
                        </a>
                        <div class="dropdown-divider"></div>
                        <a href="@(Model["Whatsapp"])" target="_blank" class="dropdown-item text-success"
                            data-bs-toggle="tooltip"
                            title="Si requiere ayuda personalizada comuniquese al siguiente número!">
                            <i aria-hidden="true" class="fab fa-whatsapp"></i> Soporte
                        </a>

                        <div class="dropdown-divider"></div>

                        <a href="@(Model["UserManual"])" class="dropdown-item text-danger" data-bs-toggle="tooltip"
                            title="Manual de Usuario">
                            <i aria-hidden="true" class="fa fa-book-reader"></i> Manual de Usuario
                        </a>
                        <div class="dropdown-divider"></div>
                        <a href="javascript:void(0)" ng-click="logout()" class="dropdown-item">
                            <icon class="fa fa-power-off"></icon> Cerrar Sesión
                        </a>
                    </div>
                </li>
                <li class="nav-item right-side-toggle">
                    <a class="nav-link  waves-effect waves-light" href="javascript:void(0)">
                        <icon class="ti-settings"></icon>
                    </a>
                </li>
            </ul>
        </div>
    </nav>
</header>