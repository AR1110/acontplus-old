@page
@model WebUI.Pages.Politica.IndexModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["title"] = "Politica";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div ng-controller="politicaCtrl">
    <div class="row page-titles">
        <div class="col-md-5 align-self-center">
            <h4 class="text-themecolor">Gestión de Politicas</h4>
        </div>
        <div class="col-md-7 align-self-center text-right">
            <div class="d-flex justify-content-end align-items-center">
                @*<ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="javascript:void(0)">Inicio</a></li>
                <li class="breadcrumb-item active">Politica</li>
                </ol>*@
                <button type="button" ng-if="accion.leer && accion.crear" ng-click="abrirModal(0,1)"
                    class="btn btn-info m-l-15">
                    <i class="fas fa-plus-circle"></i> Nuevo
                </button>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <div class="row">
                        <div class="col-lg-9">
                            <span class="form-group pull-left page-size form-inline">
                                <select class="form-control control-color" ng-model="pageSize"
                                    ng-change="changePageSize()" ng-options="ra for ra in recordsQuantity">
                                </select>
                            </span>
                        </div>
                        <div class="col-lg-3">
                            <input type="text" class="form-control" ng-model="buscar" placeholder="Buscar Politica" />
                        </div>
                    </div>
                    <!--Politicas -->
                    <div class="table-responsive">
                        <table class="table table-condensed">
                            <thead>
                                <tr>
                                    <th>N°</th>
                                    <th>Codigo</th>
                                    <th>Descripcion</th>
                                    <th>Estado</th>
                                    <th ng-show="accion.editar || accion.eliminar || accion.acceso">Op.</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="p in politicas | filter:buscar track by $index">
                                    <td>{{$index+1}}</td>
                                    <td>{{p.codigo}}</td>
                                    <td>{{p.descripcion}}</td>
                                    <td ng-bind-html="p.estado | estadoPrimario"></td>
                                    <td ng-if="accion.editar || accion.eliminar || accion.acceso">
                                        <button type="button" ng-if="accion.editar" class="btn btn-info btn-xs" tooltip
                                            data-toggle="toggle" title="Editar" ng-click="abrirModal(p,2)">
                                            <i class="ti-pencil"></i>
                                        </button>
                                        <button type="button" ng-if="accion.eliminar" class="btn btn-danger btn-xs"
                                            tooltip data-toggle="toggle" title="Eliminar" ng-click="delete(p)">
                                            <i class="ti-trash"></i>
                                        </button>
                                        <button type="button" ng-if="accion.acceso" class="btn btn-warning btn-xs"
                                            ng-click="openModalAcceso(p)" tooltip data-toggle="toggle" title="Accesos">
                                            <i class="fas fa-key"></i>
                                        </button>
                                    </td>
                                </tr>
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td align="center" colspan="9">
                                        <div class="pull-left">
                                            <ul uib-pagination total-items="totalRecords" items-Per-Page="pageSize"
                                                ng-change="pagechanged()" ng-model="pageIndex" max-size="maxSize"
                                                class="pagination" boundary-links="true" rotate="false"></ul>
                                        </div>
                                    </td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

<!--Modal Para Agregar y Actualizar la Politica -->
<partial name="_ModalAddUpdate" />

<!--Modal Paea Asignar Accesos a la Politica -->
<partial name="_Acceso" />
</div>

@section Scripts {
    <script src="~/js/config/services/politicaService.js" asp-append-version="true"></script>
    <script src="~/js/config/controllers/politicaCtrl.js" asp-append-version="true"></script>

}