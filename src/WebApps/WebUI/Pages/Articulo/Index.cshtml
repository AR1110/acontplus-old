@page
@model WebUI.Pages.Articulo.IndexModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["title"] = "Articulo";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
 
<style>
    .thumbnail {
        width: 100px;
        height: auto;
    }

        .thumbnail:hover {
            top: -50px;
            left: -35px;
            width: 500px;
            height: auto;
            display: block;
            z-index: 999;
            cursor: pointer;
            -webkit-transition-property: all;
            -webkit-transition-duration: 0.3s;
            -webkit-transition-timing-function: ease;
        }
</style>
<div id="example-table"></div>
<div ng-controller="articuloCtrl">
    <div class="row page-titles">
        <div class="col-md-5 align-self-center">
            <h5 class="text-themecolor">Gestión de Articulos</h5>
        </div>
        <div class="col-md-7 align-self-center text-right">
            <div class="d-flex justify-content-end align-item-center">
                <button class="btn btn-info m-l-15" ng-if="accion.leer && accion.crear" btn-article-add-update result-modal="resultModal(result)">
                    <i class="fa fa-plus-circle"></i> Nuevo
                </button>
                @* <button class="btn btn-warning m-l-15" ng-click="openModalNew()"><i class="fa fa-plus-circle"></i>
                New Test</button> *@
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <div class="row">
                <div class="col-lg-3 col-xl-3 col-md-12 col-sm-12 col-12">
                    <div class="form-group">
                        <span>SubFamilia</span>
                        <select name="subFamilia" id="subFamilia" class="form form-control border-select"
                                ng-model="dataSearch.idSubFamilia" ng-change="searchArticulo()">
                            <option value="">Todos</option>
                            <option ng-value="item.idSubFamilia" ng-repeat="item in subFamilias">
                                {{item.descripcion}}
                            </option>
                        </select>
                    </div>
                </div>
                <div class="col-lg-3 col-xl-3 col-md-12 col-sm-12 col-12">
                    <div class="form-group">
                        <span>Medida</span>
                        <select name="medida" id="medida" class="form form-control border-select"
                                ng-model="dataSearch.idMedida" ng-change="searchArticulo()">
                            <option value="">Todos</option>
                            <option ng-value="item.idMedida" ng-repeat="item in medidas">
                                {{item.descripcion}}
                            </option>
                        </select>
                    </div>
                </div>
                <div class="col-lg-3 col-xl-3 col-md-12 col-sm-12 col-12">
                    <div class="form-group">
                        <span>Marca</span>
                        <select name="marca" id="marca" class="form form-control border-select"
                                ng-model="dataSearch.idMarca" ng-change="searchArticulo()">
                            <option value="">Todos</option>
                            <option ng-value="item.idMarca" ng-repeat="item in marcas">
                                {{item.descripcion}}
                            </option>
                        </select>
                    </div>
                </div>
                <div class="col-lg-3 col-xl-3 col-md-12 col-sm-12 col-12">
                    <div class="form-group">
                        <span>Modelos</span>
                        <select name="modelo" id="modelo" class="form form-control border-select"
                                ng-model="dataSearch.idModelo" ng-change="searchArticulo()">
                            <option value="">Todos</option>
                            <option ng-value="item.idModelo" ng-repeat="item in modelos">
                                {{item.descripcion}}
                            </option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-lg-3 col-xl-3 col-md-12 col-sm-12 col-12">
                    <div class="form-group">
                        <span>Tipo Iva</span>
                        <select name="tipoIva" id="tipoIva" class="form form-control border-select"
                                ng-model="dataSearch.idTipoIva" ng-change="searchArticulo()">
                            <option value="">Todos</option>
                            <option ng-value="item.idTipoIva" ng-repeat="item in tiposIva">
                                {{item.descripcion}}
                            </option>
                        </select>
                    </div>
                </div>
                <div class="col-lg-3 col-xl-3 col-md-12 col-sm-12 col-12">
                    <div class="form-group">
                        <spna>Stock</spna>
                        <select class="form-control border-select" ng-model="dataSearch.byStock"
                                ng-change="searchArticulo()">
                            <option value="">Todos</option>
                            <option ng-value="1">Con Stock</option>
                            <option ng-value="2">Sin Stock</option>
                        </select>
                    </div>
                </div>
                <div class="col-lg-2 col-xl-2 col-md-12 col-sm-12 col-12">
                    <div class="form-group">
                        <span>Estado</span>
                        <select name="" id="" class="form-control border-select" ng-model="dataSearch.status"
                                ng-change="searchArticulo()">
                            <option value="">Todos</option>
                            <option ng-value="1">Activo</option>
                            <option ng-value="0">Inactivo</option>
                        </select>
                    </div>
                </div>
                <div class="col-lg-2 col-xl-2 col-md-12 col-sm-12 col-12">
                    <div class="form-group">
                        <span>Fraccionado</span>
                        <md-switch ng-model="dataSearch.checkBoxFraccionado" aria-label="Inventario"
                                   ng-change="searchArticulo()">
                            {{ dataSearch.checkBoxFraccionado?'SI':'NO' }}
                        </md-switch>
                    </div>
                </div>
                <div class="col-lg-2 col-xl-2 col-md-12 col-sm-12 col-12">
                    <div class="form-group">
                        <span>Inventario</span>
                        <md-switch ng-model="dataSearch.checkBoxInventario" ng-change="searchArticulo()"
                                   aria-label="Switch 1">
                            {{dataSearch.checkBoxInventario?'SI':'NO'}}
                        </md-switch>
                    </div>
                </div>
            </div>
        </div>
    </div>


    <div class="card">
        <div class="card-body">

            <div class="row">
                <div class="col-lg-9 col-md-9 col-sm-1">
                    <span class="form-group pull-left page-size form-inline">
                        <select class="form-control control-color" ng-model="dataSearch.pageSize"
                                ng-change="changePageSize()" ng-options="ra for ra in recordsQuantity">
                        </select>
                    </span>
                </div>
                <div class="col-lg-3 col-md-3 col-sm-12 col-12">
                    <form class="form-material">
                        <div class="input-group">
                            <input type="text" class="form-control" ng-model="dataSearch.bySearch"
                                   ng-change="searchArticulo()" placeholder="Buscar Articulo" />
                            <div class="input-group-append">
                                <button class="btn btn-secondary btn-sm" ng-click="searchArticulo()">
                                    <i class="fas fa-redo"></i>
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>



            <md-table-container style=" max-height: 400px;">
                <table resize master md-table>
                    <thead md-trim-column-names fix-head md-head>
                        <tr md-row>
                            <th md-column></th>
                            <th md-column>Op.</th>
                            <th md-column>N°</th>
                            <th md-column>Imagen</th>
                            <th md-column>Código</th>
                            <th md-column>Descripción</th>
                            <th md-column>Medida</th>
                            <th md-column>Sub Familia</th>
                            <th md-column>Stock</th>
                            <th md-column>Estado</th>
                        </tr>
                    </thead>
                    <tbody md-body>
                        <tr md-row ng-repeat-start="a in articulos">
                            <td md-cell ng-click="expandDetalle(a)">
                                <span ng-if="a.expanded">
                                    <icon class="fas fa-caret-square-down"></icon>
                                </span>
                                <span ng-if="!a.expanded">
                                    <icon class="fas fa-caret-square-right"></icon>
                                </span>
                            </td>
                            <td md-cell>
                                <md-menu>
                                    <md-button aria-label="Open demo menu" class="md-icon-button"
                                               ng-click="$mdMenu.open($event)">
                                        <icon class="mdi mdi-menu"></icon>
                                    </md-button>
                                    <md-menu-content class="md-dense">
                                        <md-menu-item ng-if="accion.editar">
                                            <md-button btn-article-add-update result-modal="resultModal(result)" params="a">
                                                <span md-menu-align-target>
                                                    <i class="ti-pencil"></i>
                                                    Editar
                                                </span>
                                            </md-button>
                                        </md-menu-item>

                                        <md-menu-item ng-if="accion.eliminar || !a.articulo.estado">
                                            <md-button ng-click="askToDelete(a)">
                                                <span md-menu-align-target>
                                                    <i class="ti-trash"></i>
                                                    Eliminar
                                                </span>
                                            </md-button>
                                        </md-menu-item>



                                        <md-menu-item>
                                            <md-button ng-click="updateStockArticle(a)">
                                                <span md-menu-align-target>
                                                    <icon class="fas  fas fa-boxes"></icon> Actualizar Stock
                                                </span>
                                            </md-button>
                                        </md-menu-item>

                                        <md-menu-item ng-if="accion.kardex">
                                            <md-button view-kardex-btn params="a">
                                                <span md-menu-align-target>
                                                    <icon class="fas fa-clipboard-list"></icon> Kardex
                                                </span>
                                            </md-button>
                                        </md-menu-item>

                                        <md-menu-item ng-if="accion.imagen">
                                            <md-button ng-click="openModalArticuloImagen(a)">
                                                <span md-menu-align-target>
                                                    <icon class="ti-image"></icon> Imagenes
                                                </span>
                                            </md-button>
                                        </md-menu-item>


                                        <!--Historial Compras-->
                                        <md-menu-item>
                                            <md-button btn-articulo-historial-compra params="a" title="Historial Compras">
                                                <span md-menu-align-target>
                                                    <icon class="mdi mdi-history"></icon> Hist. Compras
                                                </span>
                                            </md-button>
                                        </md-menu-item>

                                    </md-menu-content>
                                </md-menu>
                                <button type="button" class="btn btn-outline-success btn-xs" ng-show="a.imagen"
                                        ng-click="openModalImagen(a)">
                                    <i class="fas fa-file-image"></i>
                                </button>
                            </td>
                            <td md-cell>{{$index+1}}</td>
                            <td md-cell style="vertical-align: middle">
                                <img class="img-fluid img-thumbnail" ng-click="previewImg(a)" ng-class="{thumbnail: a.s3ObjectUrl.length > 0}"
                                     width="50" src="{{a.s3ObjectUrl}}" />
                            </td>
                            <td md-cell>{{a.codigo}}</td>
                            <td md-cell>
                                <span tooltip uib-tooltip="{{a.observaciones}}" tooltip-trigger="'mouseenter'"
                                      tooltip-placement="{{a.observaciones?'top':''}}">{{a.descripcion}}</span>
                            </td>
                            <td md-cell>{{a.medida}}</td>
                            <td md-cell>{{a.subFamilia}}</td>
                            <td md-cell>
                                <h6>
                                    <span ng-class="a.style" estab-stock article="a">
                                        {{a.stock}}
                                    </span>
                                </h6>
                            </td>
                            <td md-cell ng-bind-html="a.estado | estadoPrimario"></td>
                        </tr>
                        <tr md-row ng-if="a.expanded" ng-repeat-end="">
                            <td md-cell colspan="10">
                                <ul class="nav nav-tabs mt-2" role="tablist">
                                    <li class="nav-item">
                                        <a class="nav-link" data-toggle="tab" href="#home{{$index}}" role="tab" aria-selected="false">
                                            <span class="hidden-sm-up"><icon class="ti-home"></icon></span>
                                            <span class="hidden-xs-down">General</span>
                                        </a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link active" data-toggle="tab" href="#profile{{$index}}" role="tab" aria-selected="true">
                                            <span class="hidden-sm-up"><icon class=" fas fa-hand-holding-usd"></icon></span>
                                            <span class="hidden-xs-down">Tarifa</span>
                                        </a>
                                    </li>
                                </ul>
                                <div class="tab-content tabcontent-border mb-2">
                                    <div class="tab-pane" id="home{{$index}}" role="tabpanel">
                                        <div class="p-20">
                                            <div class="row">
                                                <div class="col-md-3 col-xs-6 b-r">
                                                    <strong>Articulo</strong>
                                                    <br>
                                                    <p class="text-muted">{{a.view.descripcion}}</p>
                                                </div>
                                                <div class="col-md-2 col-xs-6 b-r">
                                                    <strong>Código</strong>
                                                    <br>
                                                    <p class="text-muted">{{a.view.codigo}}</p>
                                                </div>
                                                <div class="col-md-2 col-xs-6 b-r">
                                                    <strong>Cod. Auxiliar</strong>
                                                    <br>
                                                    <p class="text-muted">{{a.view.codigoAuxiliar}}</p>
                                                </div>
                                                <div class="col-md-2 col-xs-6">
                                                    <strong>T. IVA</strong>
                                                    <br>
                                                    <p class="text-muted">{{a.view.nombreTipoIva}}</p>
                                                </div>
                                                <div class="col-md-3 col-xs-6">
                                                    <strong>Observación</strong>
                                                    <br>
                                                    <p class="text-muted">{{a.view.observaciones}}</p>
                                                </div>
                                            </div>
                                            <hr />
                                            <div class="row">
                                                <div class="col-md-3 col-xs-6 b-r">
                                                    <strong>Fraccionable</strong>
                                                    <br>
                                                    <p class="text-muted">
                                                        <span ng-bind-html="a.view.productoFraccionable|sino"></span>
                                                    </p>
                                                </div>
                                                <div class="col-md-2 col-xs-6 b-r">
                                                    <strong>Inventario</strong>
                                                    <br>
                                                    <p class="text-muted">
                                                        <span ng-bind-html="a.view.llevaInventario|sino"></span>
                                                    </p>
                                                </div>
                                                <div class="col-md-2 col-xs-6 b-r">
                                                    <strong>Lote</strong>
                                                    <br>
                                                    <p class="text-muted">{{a.view.lote}}</p>
                                                </div>
                                                <div class="col-md-2 col-xs-6">
                                                    <strong>F. Creación</strong>
                                                    <br>
                                                    <p class="text-muted">
                                                        {{a.view.fechaCreacion}}
                                                    </p>
                                                </div>
                                                <div class="col-md-3 col-xs-6">
                                                    <strong>F. Caducidad</strong>
                                                    <br>
                                                    <p class="text-muted">{{a.view.fechaCaducidad}}</p>
                                                </div>
                                            </div>
                                            <hr />
                                            <div class="row">
                                                <div class="col-md-3 col-xs-6 b-r">
                                                    <strong>Stock Máximo</strong>
                                                    <br>
                                                    <p class="text-muted">{{a.view.stockMaximo}}</p>
                                                </div>
                                                <div class="col-md-2 col-xs-6 b-r">
                                                    <strong>Stock Minimo</strong>
                                                    <br>
                                                    <p class="text-muted">{{a.view.stockMinimo}}</p>
                                                </div>
                                                <div class="col-md-2 col-xs-6 b-r">
                                                    <strong>P. Costo</strong>
                                                    <br>
                                                    <p class="text-muted">
                                                        <h5>{{a.view.precioCosto|currency:'$'}}</h5>
                                                    </p>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="tab-pane active p-20" id="profile{{$index}}" role="tabpanel">
                                        <div class="table-responsive m-t-5">
                                            <table class="table table-bordered table-striped table-sm">
                                                <caption></caption>
                                                <thead>
                                                    <tr>
                                                        <th>N°</th>
                                                        <th>Tarifa</th>
                                                        <th>P. Venta</th>
                                                        <th>P. IVA</th>
                                                        <th>%. Utilidad</th>
                                                        <th>Estado</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <tr ng-repeat="pvp in a.tarifas">
                                                        <td>{{$index+1}}</td>
                                                        <td>{{pvp.tarifa}}</td>
                                                        <td>{{pvp.precioVenta}}</td>
                                                        <td>{{pvp.precioConIva}}</td>
                                                        <td>{{pvp.porcentajeUtilidad}}</td>
                                                        <td>{{pvp.precioPredeterminado?'Predeterminada':''}}</td>
                                                    </tr>
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                    <div class="tab-pane p-20" id="messages" role="tabpanel">3</div>
                                </div>
                            </td>
                        </tr>
                        <tr ng-show="articulos.length===0" class="text-center">
                            <td colspan="9">No hay registros en esta tabla.</td>
                        </tr>
                    </tbody>
                </table>
            </md-table-container>
        </div>

        <div class="card-body">
            <ul uib-pagination total-items="dataSearch.totalRecords" items-Per-Page="dataSearch.pageSize"
                ng-change="pagechanged()" ng-model="dataSearch.pageIndex" max-size="dataSearch.maxSize"
                class="pagination" boundary-links="true" rotate="false"></ul>
        </div>
    </div>
</div>



@section Scripts {
    <script src="~/js/inventario/controllers/articuloCtrl.min.js" asp-append-version="true"></script>

}