<style>
    .custom-template-md-autocomplete-articulo {
        max-width: 1200px !important;
        width: 1200px !important;
    }

    .standard-container {
        width: 1200px;
    }

    .autocomplete-standard-template li:last-child {
        border-bottom-width: 0;
    }

    .autocomplete-standard-template li {
        border-bottom: 1px solid #ccc;
        height: auto;
        padding-top: 1px;
        padding-bottom: 1px;
        /* white-space: normal; */
    }

    .rtable #headerAutocompleteArticulo:hover {
        cursor: none;
        background-color: white;
    }

    .autocomplete-standard-template .item-desc {
        font-size: 12px;
        margin: 0.8em 0 .8em;
        max-width: 200px;
    }



    .rtable .column-articulo-descripcion {
        width: 290px;
        min-width: 290px;
        max-width: 290px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap !important;
        word-break: break-all !important;
    }



    .rtable .suggestion-column {
        font-size: 12px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap !important;
        word-break: break-all !important;
    }

    .rtable .suggestion-codigo {
        width: 100px;
        min-width: 100px;
        max-width: 100px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap !important;
        word-break: break-all !important;
    }

    .zindex {
        z-index: 999999 !important;
    }

    .contentArticlePopover {
        z-index: 999999 !important;
        max-width: 400px !important;
    }
</style>


@* <div ng-submit="$event.preventDefault()"> *@
<!-- md-search-text-change="searchTextChange(searchText)"  -->
<div class="mb-1" id="">
    <md-autocomplete id="mainContentMdAutocomplete" input-focus md-input-id="custom-template-md-autocomplete-articulo"
        uib-tooltip="Buscar Artículo por descripción o Código " tooltip-placement="top" tooltip-trigger="'mouseenter'"
        ng-enter="getDataArticuloByEnterCode(true);" md-no-cache="false" md-selected-item="selectedItem"
        md-search-text="searchText" md-selected-item-change="selectArticleSearch(item)"
        md-items="item in searchTextChange(searchText)" md-item-text="item.descripcion"
        ng-focus="focusDescripcionArticulo('#custom-template-md-autocomplete-articulo')" md-escape-options="clear"
        input-aria-label="Buscador Articulo" placeholder="{{placeholder}}"
        md-menu-class="autocomplete-standard-template" md-menu-container-class="standard-container" md-mode="standard"
        md-clear-button="false">
        <md-item-template>
            <div class="table-responsive">
                <table class="rtable">
                    <thead>
                        <tr ng-show="item.showHeader">
                            <th>Codigo</th>
                            <th>Descripcion</th>
                            <th>Stock</th>
                            <th>Iva</th>
                            <th>SubFamilia</th>
                            <th>Medida</th>
                            <th>Marca</th>
                            <th ng-repeat="pvp in item.priceSale">
                                {{pvp.tarifa}}
                            </th>
                            <th>
                                Ubicación
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td class="suggestion-codigo text-left">
                                {{ item.codigo }}
                            </td>
                            <td class="column-articulo-descripcion text-left" uib-tooltip="{{item.descripcion}}"
                                tooltip-placement="bottom" tooltip-trigger="focus">
                                <img ng-if="item.s3ObjectUrl" ng-click="previewImg($event, item)"
                                    src="{{item.s3ObjectUrl}}" class="img-thumbnail" width="30">
                                <span class="item-desc font-weight-bold">
                                    {{item.descripcion}}
                                </span>
                            </td>
                            <td class="suggestion-column text-center">
                                <h6><span estab-stock article="item" class="{{item.style}}">{{ item.stock}} </span></h6>
                            </td>
                            <td class="suggestion-column text-center">
                                {{ item.iva}}
                            </td>
                            <td class="suggestion-column text-center">
                                {{ item.subFamilia}}
                            </td>
                            <td class="suggestion-column text-center">
                                <span article-fraccionado-info-drtv article="item" class="{{item.fraccionado}}">
                                    {{ item.medida}}
                                </span>

                            </td>
                            <td class="suggestion-column text-center">
                                {{ item.marca}}
                            </td>
                            <td class="suggestion-column text-center" ng-repeat="pvp in item.priceSale">
                                <span class="font-weight-bold">${{pvp.precio}}</span>
                            </td>
                            <td class="suggestion-column text-center" ng-if="item.warehouses.length >0"
                                ng-repeat="ub in item.warehouses">
                                {{ub.ubicacion}}
                            </td>
                            <td class="suggestion-column text-center" ng-if="item.warehouses.length ===0">

                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </md-item-template>
        <md-not-found>
            No se encontraron estados que coincidan con "{{searchText}}".
        </md-not-found>
        @* <md-not-found>
        No hay estados coincidentes con "{{searchText}}"
        </md-not-found> *@
    </md-autocomplete>
    <a href="javascript:void(0)" class="btn btn-success btn-xs mt-1" ng-if="$parent.articlePermission.crear"
        tabindex="-1" ng-click="openModalArticulo()">
        <i class="fas fa-plus"></i> Nuevo
    </a>
    <a href="javascript:void(0)" class="btn btn-info btn-xs mt-1" tabindex="-1" ng-click="openModalArticuloGeneral()">
        <i class="fas fa-search"></i> Lista
    </a>
</div>



@* </div> *@