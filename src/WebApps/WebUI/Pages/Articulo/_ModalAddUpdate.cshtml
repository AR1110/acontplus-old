<div class="modal-header">
    <h5 class="modal-title">{{tipoRegistro==1?'Nuevo': 'Editar'}} Articulo</h5>
    <button class="close" ng-click="closeModal()">&times;</button>
</div>
<div class="modal-body">

    <uib-tabset>
        <uib-tab index="0" heading="General">
            <div class="card">
                <div class="card-body border-mb">

                    <div class="row">
                        <div class="col-xl-6 col-lg-6 col-md-12 col-sm-12 col-12">
                            <div class="form-group">
                                <label class="form-control-label" for="descripcion">
                                    Nombre Articulo: <span class="text-danger">*</span>
                                </label>
                                <input type="text" autocomplete="off" ng-model="data.descripcion"
                                       name="articuloDescripcion" touppercase class="form-control border-select"
                                       placeholder="Ej: Laptop-HP">
                            </div>
                        </div>

                        <div class="col-xl-6 col-lg-6 col-md-12 col-sm-12 col-12">
                            <div class="form-group ">
                                <label class="control-label">Sub Familia: <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <select class="form-control border-select" ng-model="data.idSubFamilia"
                                            ng-change="getArticuloCodigo()"
                                            ng-options="sf.idSubFamilia as sf.subFamilia group by sf.familia  for sf in subFamilias">
                                    </select>
                                    <div class="input-group-append">
                                        <button class="btn btn-outline-secondary btn-sm" btn-add-update-sub-familia results="resultModalSubFamilia(item)" type="button" tabindex="-1">
                                            <i class="fa fa-plus fa-xs"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row" ng-show="tipoRegistro===1">
                        <div class="col-xl-6 col-lg-6 col-md-12 col-sm-12 col-12">
                            <div class="row">
                                <div class="col-xl-4 col-lg-4 col-md-6 col-sm-12 col-12">
                                    <div class="form-group">
                                        <label for="">Código: <span class="text-danger">*</span></label>
                                        <input type="text" ng-model="data.codigo" ng-focus="delayFocus('.codigo')"
                                               class="form-control border-select codigo" placeholder="Ej: COM050">
                                    </div>
                                </div>

                                <div class="col-xl-4 col-lg-4 col-md-6 col-sm-12 col-12">
                                    <div class="form-group">
                                        <label for="">Código Aux: </label>
                                        <input type="text" ng-model="data.codigoAuxiliar"
                                               ng-focus="delayFocus('.codigoAuxiliar')"
                                               class="form-control border-select codigoAuxiliar" placeholder="Ej: COM050">
                                    </div>
                                </div>

                                <div class="col-xl-4 col-lg-4 col-md-12 col-sm-12 col-12">
                                    <div class="form-group">
                                        <label for="">Código de Barra: <span class="text-danger">*</span> </label>
                                        <div class="input-group">
                                            <input type="text" class="form-control border-select codigoBarra"
                                                   ng-focus="delayFocus('.codigoBarra')" ng-model="data.codigoBarra"
                                                   touppercase placeholder="H20089" value="" />
                                            <div class="input-group-append">
                                                <button class="btn btn-outline-secondary" ng-click="getBarcode()">
                                                    <i class="fas fa-barcode"></i>
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-xl-6 col-lg-6 col-md-12 col-sm-12 col-12">
                            <div class="row">
                                <div class="col-xl-6 col-lg-6 col-md-6 col-sm-12 col-12">
                                    <div class="form-group">
                                        <label for="">Tipo Artículo: <span class="text-danger">*</span> </label>
                                        <select class="form-control border-select tipoArticulo"
                                                ng-model="data.idTipoArticulo" ng-focus="delayFocus('.tipoArticulo')">
                                            <option ng-value="item.idTipoArticulo"
                                                    ng-repeat="item in tipoArticulos">{{item.descripcion}}</option>
                                        </select>
                                    </div>
                                </div>

                                <div class="col-xl-6 col-lg-6 col-md-6 col-sm-12 col-12">
                                    <div class="form-group">
                                        <label for="">U. Medida</label>
                                        <div class="input-group">
                                            <select class="form-control border-select medida"
                                                    ng-model="data.idMedida" ng-focus="delayFocus('.medida')">
                                                <option ng-value="item.idMedida" ng-repeat="item in medidas">
                                                    {{item.descripcion}}
                                                </option>
                                            </select>
                                            <div class="input-group-append">
                                                <button class="btn btn-outline-secondary btn-sm" btn-add-update-medida results="resultModalMedida(item)" tabindex="-1">
                                                    <i class="fa fa-plus fa-xs"></i>
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row" ng-show="tipoRegistro===1">
                        <div class="form-group col-lg-2 col-md-6 col-sm-6 col-12">
                            <label for="">Tipo Iva: </label>
                            <label for="">Tipo Iva: </label>
                            <select class="form-control border-select tipoIva" ng-model="data.idTipoIva"
                                    ng-change="recalculateTarifaAdd()" ng-focus="delayFocus('.tipoIva')"
                                    ng-disabled="!articlePermission.isUpdatePrice">
                                <option ng-value="item.idTipoIva" ng-repeat="item in tipoIvas">{{item.descripcion}}</option>
                            </select>
                        </div>
                        <div class="form-group col-lg-2 col-md-6 col-sm-6 col-xs-6">
                            <label for="">Precio Costo: <span class="text-danger">*</span></label>
                            <input type="text" class="form-control border-select precioCosto" decimal
                                   ng-focus="delayFocus('.precioCosto')" ng-model="data.precioCosto"
                                   ng-blur="redondearPrecioCosto()" ng-change="recalculateTarifaAdd()"
                                   placeholder="0.00">
                        </div>
                        <div class="form-group col-lg-2 col-md-6 col-sm-6 col-xs-6">
                            <label for="">Precio Sin Subsidio:</label>
                            <input type="text" class="form-control border-select precioSinSubsidio" decimal
                                   ng-focus="delayFocus('.precioSinSubsidio')" ng-model="data.precioSinSubsidio"
                                   placeholder="0.00">
                        </div>
                        <div class="form-group col-lg-2 col-md-6 col-sm-6 col-12 text-center ">
                            <label>Inventario: </label>
                            <div class="icheck-primary ">
                                <input type="checkbox" id="llevarInventarioAgregar1" name="llevarInventarioAgregar1"
                                       ng-model="data.llevaInventario" />
                                <label for="llevarInventarioAgregar1"></label>
                            </div>
                        </div>
                        <div class="form-group col-lg-2 col-md-3 col-sm-6 col-12 text-center">
                            <label>Adicionales: </label>
                            <div class="icheck-primary">
                                <input type="checkbox" id="datosAdicionalesAgregar1" name="datosAdicionalesAgregar1"
                                       ng-model="data.datosAdicionales" />
                                <label for="datosAdicionalesAgregar1"></label>
                            </div>
                        </div>
                        <div class="form-group col-lg-2 col-md-3 col-sm-6 col-12 text-center"
                             ng-show="data.datosAdicionales">
                            <label>Etiqueta: </label>
                            <select ng-model="data.idEtiqueta" class="form-control">
                                <option ng-value="item.idEtiqueta"
                                        ng-repeat="item in etiquetaActividades">{{item.descripcion}}</option>
                            </select>
                        </div>
                        <div class="form-group col-lg-2 col-md-3 col-sm-6 col-12 text-center">
                            <label for="">Fraccionable: </label>
                            <div class="icheck-primary">
                                <input type="checkbox" id="productoFraccionableAgregar1"
                                       name="productoFraccionableAgregar1" ng-model="data.productoFraccionable" />
                                <label for="productoFraccionableAgregar1"></label>
                            </div>
                        </div>
                    </div>

                    <!--ACTUALIZAR-->
                    <div ng-show="tipoRegistro==2">

                        <div class="row">
                            <div class="form-group col-lg-3 col-md-2 col-sm-6 col-xs-6">
                                <label for="">Código: <span class="text-danger">*</span></label>
                                <input type="text" ng-model="data.codigo"
                                       class="form-control border-select codigoUpdate"
                                       ng-focus="delayFocus('.codigoUpdate')" placeholder="Ej: COM050">
                            </div>
                            <div class="form-group col-lg-2 col-md-2 col-sm-6 col-xs-6">
                                <label for="codigoAuxiliar">Código Aux: <span class="text-danger">*</span> </label>
                                <input type="text" name="codigoAuxiliar" id="codigoAuxiliar" ng-model="data.codigoAuxiliar"
                                       class="form-control border-select codigoAuxiliarUp"
                                       ng-focus="delayFocus('.codigoAuxiliarUp')" placeholder="Ej: COM050">
                            </div>
                            <div class="form-group col-lg-2 col-md-2">
                                <div class="form-group">
                                    <label for="">Código de Barra: <span class="text-danger">*</span> </label>
                                    <div class="input-group">
                                        <input type="text" class="form-control border-select codigoBarraUp"
                                               ng-focus="delayFocus('.codigoBarraUp')" ng-model="data.codigoBarra"
                                               touppercase placeholder="H20089" value="" />
                                        <div class="input-group-append">
                                            <button class="btn btn-outline-secondary" ng-click="getBarcode()">
                                                <i class="fas fa-barcode"></i>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="form-group col-lg-2 col-md-4 col-sm-6 col-xs-6">
                                <label for="">Tipo Artículo: <span class="text-danger">*</span> </label>
                                <select class="form-control border-select tipoArticulo"
                                        ng-model="data.idTipoArticulo" ng-focus="delayFocus('.tipoArticulo')">
                                    <option ng-value="item.idTipoArticulo" ng-repeat="item in tipoArticulos">
                                        {{item.descripcion}}
                                    </option>
                                </select>
                            </div>

                            <div class="form-group col-lg-3 col-md-4 col-sm-6 col-xs-6">
                                <label for="medida">U. Medida <span class="text-danger">*</span> </label>
                                <div class="input-group">
                                    <select id="medida" name="medida" class="form-control border-select medida" ng-model="data.idMedida"
                                            ng-focus="delayFocus('.medida')">
                                        <option ng-value="item.idMedida" ng-repeat="item in medidas">
                                            {{item.descripcion}}
                                        </option>
                                    </select>
                                    <div class="input-group-append">
                                        <button class="btn btn-outline-secondary btn-sm" btn-add-update-medida results="resultModalMedida(item)" tabindex="-1">
                                            <i class="fa fa-plus fa-xs"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>


                        <div class="row">
                            <div class="form-group col-lg-2 col-md-2 col-sm-6 col-xs-6">
                                <label>Adicionales: </label>
                                <div class="icheck-primary">
                                    <input type="checkbox" id="datosAdicionalesUpdate" name="datosAdicionalesUpdate"
                                           ng-model="data.datosAdicionales" />
                                    <label for="datosAdicionalesUpdate"></label>
                                </div>
                            </div>

                            <div class="form-group col-lg-2 col-md-2 col-sm-4 col-xs-6 text-center"
                                 ng-show="data.datosAdicionales">
                                <label for="etiqueta">Etiqueta: </label>
                                <select ng-model="data.idEtiqueta" id="etiqueta" class="form-control">
                                    <option ng-value="item.idEtiqueta"
                                            ng-repeat="item in etiquetaActividades">{{item.descripcion}}</option>
                                </select>
                            </div>

                            <div class="form-group col-lg-2 col-md-2 col-sm-6 col-xs-6 text-center">
                                <label for="">Llevar Inventario: </label>
                                <div class="icheck-primary">
                                    <input type="checkbox" id="llevaInventarioUpdate" name="llevaInventarioUpdate"
                                           ng-model="data.llevaInventario" />
                                    <label for="llevaInventarioUpdate"></label>
                                </div>
                            </div>
                            <div class="form-group col-lg-2 col-md-2 col-sm-6 col-xs-6 text-center">
                                <label for="">Fraccionable: </label>
                                <div class="icheck-primary">
                                    <input type="checkbox" id="productoFraccionableUpdate"
                                           name="productoFraccionableUpdate" ng-model="data.productoFraccionable" />
                                    <label for="productoFraccionableUpdate"></label>
                                </div>
                            </div>
                            <div class="form-group col-lg-3 col-md-3 col-sm-6 col-xs-6">
                                <label for="">Estado: </label>
                                <md-switch ng-model="data.estado" aria-label="Estado">
                                    {{ data.estado?'Activo':'Inactivo' }}
                                </md-switch>
                            </div>
                        </div>

                        <div class="row">
                            <div class="form-group col-lg-2 col-md-2 col-sm-6 col-xs-6">
                                <label for="tipoIva">Tipo Iva: <span class="text-danger">*</span> </label>
                                <select class="form-control border-select tipoIva" name="tipoIva" ng-model="data.idTipoIva"
                                        ng-change="recalculateTarifaAdd()" ng-focus="delayFocus('.tipoIva')"
                                        ng-disabled="!articlePermission.isUpdatePrice">
                                    <option ng-value="item.idTipoIva" ng-repeat="item in tipoIvas">{{item.descripcion}}</option>
                                </select>
                            </div>
                            <div class="form-group col-lg-3 col-md-3 col-sm-6 col-xs-6"
                                 ng-if="articlePermission.isUpdatePrice">
                                <label for="">Precio Costo: <span class="text-danger">*</span></label>
                                <input type="number" class="form-control precioCostoUp"
                                       ng-disabled="!opcionCalculate"
                                       ng-focus="delayFocus('.precioCostoUp')"
                                       ng-change="recalculateTarifaUpdate()" ng-model="data.precioCosto"
                                       step="any" placeholder="0.00">
                            </div>

                            <div class="form-group col-lg-2 col-md-6 col-sm-6 col-xs-6">
                                <label for="">Precio Sin Subsidio:</label>
                                <input type="text" class="form-control border-select precioSinSubsidio" decimal
                                       ng-focus="delayFocus('.precioSinSubsidio')" ng-model="data.precioSinSubsidio"
                                       placeholder="0.00">
                            </div> 
                            <!--Opcion para calcular pvp-tarifas-->
                            <div class="col-lg-3 col-md-3 col-sm-6 col-xs-6 mt-4"
                                 ng-show="articlePermission.isUpdatePrice">
                                <div class="custom-control custom-radio">
                                    <input type="radio" id="optionPvp" ng-model="opcionCalculate" value="optionPvp" name="optionCalculatePVP" class="custom-control-input">
                                    <label class="custom-control-label" for="optionPvp">PVP</label>
                                </div>
                                <div class="custom-control custom-radio">
                                    <input type="radio" id="optionPorcentaje" ng-model="opcionCalculate" value="optionPorcentaje" name="optionCalculatePVP" class="custom-control-input">
                                    <label class="custom-control-label" for="optionPorcentaje">% Util</label>
                                </div> 
                            </div>
                        </div>
                    </div>


                    <div class="row">
                        <div class="col-xl-10 col-lg-10 col-md-10 col-sm-12 col-12">
                            <div ui-grid="gridOptions" ui-grid-edit ui-grid-resize-columns ui-grid-cellNav
                                 ui-grid-auto-resize class="grid"></div>
                        </div>
                    </div>
                </div>

            </div>
        </uib-tab>


        <!--DATOS ADICIONALES-->
        <uib-tab index="1" heading="Datos Adicionales" select="onTabArticulo(2)">
            <div class="card">
                <div class="card-body">
                    <p><b class="text-info">Articulo: </b> <b class="text-success">{{data.descripcion}}</b></p>
                    <div class="row">
                        <div class="form-group col-lg-4 col-md-4 col-sm-6 col-12">
                            <label for="">Marca: </label>
                            <div class="input-group">
                                <select class="form-control border-select" ng-model="data.idMarca">
                                    <option value="">Ninguna</option>
                                    <option ng-value="item.idMarca" ng-repeat="item in marcas">
                                        {{item.descripcion}}
                                    </option>
                                </select>
                                <div class="input-group-append">
                                    <button class="btn btn-outline-secondary btn-sm" btn-add-update-marca results="resultModalMarca(item)"
                                            tabindex="-1">
                                        <i class="fa fa-plus fa-xs"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                        <div class="form-group col-lg-4 col-md-4 col-sm-6 col-12">
                            <label for="modelo">Modelo: </label>
                            <div class="input-group">
                                <select id="modelo" name="modelo" class="form-control border-select" ng-model="data.idModelo">
                                    <option value="">Ninguna</option>
                                    <option ng-value="item.idModelo" ng-repeat="item in modelos">
                                        {{item.descripcion}}
                                    </option>
                                </select>
                                @* <select class="form-control border-select" ng-model="data.idModelo"
                                ng-options="m.idModelo as m.modelo group by m.marca for m in modelos">
                                </select> *@
                                <div class="input-group-append">
                                    <div class="input-group-append">
                                        <button class="btn btn-outline-secondary btn-sm" btn-add-update-modelo results="resultModalModelo(item)" tabindex="-1">
                                            <i class="fa fa-plus fa-xs"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="form-group col-lg-4 col-md-4 col-sm-6 col-12">
                            <label for="">ICE: </label>
                            <select class="form-control border-select" ng-model="data.idTipoIce">
                                <option value="">Ninguna</option>
                                <option ng-value="item.idTipoIce" ng-repeat="item in tipoIces">
                                    {{item.descripcion}}
                                </option>
                            </select>
                        </div>
                        @*<div class="form-group col-lg-2 col-md-1 col-sm-6 col-xs-6">
                        <label for="">Valor.: </label>
                        <input type="text" ng-model="tipoIce.valor" class="form-control" placeholder="0">
                        </div>*@
                    </div>
                    <div class="row">
                        <div class="form-group col-lg-4 col-md-3 col-sm-6 col-xs-6">
                            <label>Stock Mínimo: </label>
                            <input type="text" class="form-control border-select" value="1" ng-model="data.stockMinimo"
                                   valid-number placeholder="0">
                        </div>
                        <div class="form-group col-lg-4 col-md-3 col-sm-6 col-xs-6">
                            <label for="">Stock Máximo: </label>
                            <input type="text" class="form-control border-select" value="2" ng-model="data.stockMaximo"
                                   valid-number placeholder="0">
                        </div>
                        <div class="form-group col-lg-4 col-md-4 col-sm-6 col-xs-6">
                            <label for="">Observación: </label>
                            <textarea name="textarea" ng-model="data.observaciones"
                                      class="form-control border-select"></textarea>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-xl-4 col-lg-4 col-md-6 col-sm-12 col-12">
                            <div class="form-group">
                                <label for="">Cantidad mínima venta al por mayor</label>
                                <input type="text" class="form-control border-select" ng-model="data.cantMinimaVentaPorMayor" decimal placeholder="0.00">
                            </div>
                        </div>
                    </div>
                    <hr />

                    <!--Ubicacion-->
                    <div class="row" ng-show="tipoOperacion==1">
                        <div class="form-group col-lg-6 col-md-6 col-sm-6 col-xs-6">
                            <label for="">Bodega: </label>
                            <select class="custom-select border-select" ng-model="dataUbicacion.idBodega">
                                <option ng-value="item.idBodega" ng-repeat="item in bodegas">
                                    {{item.bodega}}
                                </option>
                            </select>
                        </div>
                        <div class="form-group col-lg-6 col-md-6 col-sm-6 col-xs-6">
                            <label for="">Ubicación</label>
                            <input type="text" ng-model="articuloUbicacion.ubicacion" class="form-control"
                                   placeholder="Ej: S/N" />
                        </div>
                    </div>

                    <div class="row">
                        <div class="form-group col-lg-6 col-md-6 col-sm-6 col-xs-6">
                            <label><b>¿El producto tiene fecha de caducidad?</b> </label>
                            <div class="icheck-primary ">
                                <input type="checkbox" id="fechaCaducidadProducto" ng-model="data.caducidad" />
                                <label for="fechaCaducidadProducto"></label>
                            </div>
                            <div ng-show="data.caducidad">
                                <label for="">Fecha de Caducidad: <span class="text-danger">*</span> </label>
                                <input type="date" ng-model="data.fechaCaducidad" class="form-control" />

                            </div>
                        </div>
                        <div class="form-group col-lg-6 col-md-6 col-sm-6 col-xs-6">
                            <label><b>¿El producto posee lote?</b> </label>
                            <div class="icheck-primary ">
                                <input type="checkbox" id="datosLoteAgregar" ng-model="data.datosLote" />
                                <label for="datosLoteAgregar"></label>
                            </div>
                            <div ng-show="data.datosLote">
                                <label for="">Lote: <span class="text-danger">*</span> </label>
                                <input type="text" ng-model="data.lote" class="form-control"
                                       placeholder="LO-01" />

                                <label for="">Fecha Creación: <span class="text-danger">*</span> </label>
                                <input type="date" ng-model="data.fechaCreacion" class="form-control" />

                                <label for="">Fecha Caducidad: <span class="text-danger">*</span> </label>
                                <input type="date" ng-model="data.fechaCaducidadLote" class="form-control" />
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="form-group col-lg-6 col-md-6 col-sm-6 col-12">
                            <div class="form-group">
                                <label>Imagen: </label>
                                <input type="file"
                                       class="form-control"
                                       ngf-select
                                       ngf-pattern="'image/*'"
                                       ngf-accept="'image/*'"
                                       ng-model="image.selectedFile" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </uib-tab>

        <!--CÓDIGOS BARRAS-->
        <uib-tab index="2" heading="Código de Barras" select="onTabArticulo(3)" ng-show="tipoRegistro===2">
            <div class="card border border mt-2">
                <div class="card-body">
                    <div class="row">
                        <div class="col-lg-4 col-md-4 col-sm-4 col-12 border-right">
                            <div class="row">
                                <div class="col-lg-12 col-md-12 col-sm-12 col-12">
                                    <div class="form-group">
                                        <label>Medida: <span class="text-danger">*</span></label>
                                        <div class="input-group">
                                            <select class="form-control border-select"
                                                    ng-model="dataCodigoBarra.idMedida">
                                                <option ng-value="item.idMedida" ng-repeat="item in medidas">
                                                    {{item.descripcion}}
                                                </option>
                                            </select>
                                            <div class="input-group-append" id="button-addon4">
                                                <button class="btn btn-outline-secondary btn-sm" btn-add-update-medida results="resultModalMedidaCodigoBarra(item)" tabindex="-1">
                                                    <i class="fa fa-plus fa-xs"></i>
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-lg-12 col-md-12 col-sm-12 col-12">
                                    <div class="form-group">
                                        <label for="">Código Barra: <span class="text-danger">*</span></label>
                                        <input type="text" ng-model="dataCodigoBarra.codigoBarra" touppercase
                                               class="form-control" placeholder="C. Barra">
                                    </div>
                                </div>

                                <div class="col-lg-12 col-md-12 col-sm-12 col-12">
                                    <div class="form-group">
                                        <label>Descripción: </label>
                                        <input type="text" ng-model="dataCodigoBarra.descripcion" touppercase
                                               class="form-control" placeholder="Descripción">
                                    </div>
                                </div>
                                <div class="col-lg-12 col-md-12 col-sm-12 col-12 nopadding">
                                    <div class="form-group">
                                        <label>Color: </label>
                                        <input type="color" ng-model="dataCodigoBarra.color" class="form-control" />
                                    </div>
                                </div>
                                <div class="ml-auto">
                                    <button type="button" class="btn btn-success" ng-click="saveCodigoBarra()">
                                        <i class="{{dataCodigoBarra.idArticuloCodigoBarra>0?'ti-pencil':'ti-save'}}"></i>
                                        {{dataCodigoBarra.idArticuloCodigoBarra>0?'Actualizar':'Guardar'}}
                                    </button>
                                    <button type="button" class="btn btn-danger" ng-click="resetDataCodigoBarra()"> Limpiar</button>
                                </div>
                            </div>

                        </div>

                        <div class="col-lg-8 col-md-8 col-sm-8 col-12">
                            <div class="card">
                                <div class="card-body">
                                    <div class="table-responsive">
                                        <table class="table table-condensed table-sm">
                                            <thead>
                                                <tr>
                                                    <th>N°</th>
                                                    <th>Codigo Barra</th>
                                                    <th>Descripcion</th>
                                                    <th>Medida</th>
                                                    <th>Color</th>
                                                    <th>Accion</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <tr ng-repeat="item in articuloCodigoBarras">
                                                    <td>{{$index+1}}</td>
                                                    <td>{{item.codigoBarra}}</td>
                                                    <td>{{item.descripcion}}</td>
                                                    <td>{{item.medida}}</td>
                                                    <td>
                                                        <div ng-style="coloresCodigoBarra(item)"></div>
                                                    </td>
                                                    <td>
                                                        <a class="text-success"
                                                           ng-click="editarCodigoBarra(item)"
                                                           href="javascript:;" title="Editar">
                                                            <i class="fa fa-edit"></i>
                                                        </a>
                                                        <a class="text-danger"
                                                           ng-click="askToDeleteCodigoBarra(item)"
                                                           href="javascript:void(0);" title="Eliminar">
                                                            <i class="fa fa-trash"></i>
                                                        </a>
                                                    </td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </uib-tab>

        <!--UBICACIONES-->
        <uib-tab index="4" heading="Ubicación" select="onTabArticulo(4)">
            <!--Agregar-->
            <div class="card-body" ng-if="tipoRegistro===1">
                <div class="row">
                    <div class="col-xl-4 col-lg-4 col-md-4 col-sm-12 col-12">
                        <div class="form-group">
                            <label for="">Establecimientos: <span class="text-danger">*</span> </label>
                            <select class="form-control" ng-model="dataUbicacion.idEstablecimiento"
                                    ng-change="onChangeEstab()">
                                <option ng-value="item.idEstablecimiento" ng-repeat="item in establecimientos">
                                    {{item.nombreComercial}}
                                </option>
                            </select>
                        </div>
                    </div>

                    <div class="col-xl-4 col-lg-4 col-md-4 col-sm-12 col-12">
                        <div class="form-group">
                            <label for="">Bodega: <span class="text-danger">*</span> </label>
                            <select class="form-control" ng-model="dataUbicacion.idBodega">
                                <option ng-value="item.idBodega" ng-repeat="item in bodegas">
                                    {{item.bodega}}
                                </option>
                            </select>
                        </div>
                    </div>

                    <div class="col-xl-4 col-lg-4 col-md-4 col-sm-12 col-12">
                        <div class="form-group">
                            <label for="">Ubicación <span class="text-danger">*</span></label>
                            <input type="text" ng-model="dataUbicacion.ubicacion" class="form-control border-select"
                                   placeholder="Ej: S/N" />
                        </div>
                    </div>
                </div>
            </div>



            <!--Actualizar-->
            <div class="card-body" ng-if="tipoRegistro===2">
                <div class="row">
                    <div class="col-lg-4 col-md-4 col-sm-4 col-12 border-right">
                        <div class="row">
                            <div class="col-lg-12 col-md-12 col-sm-12 col-12">
                                <div class="form-group">
                                    <label for="">Establecimientos: <span class="text-danger">*</span> </label>
                                    <select class="form-control" ng-model="dataUbicacion.idEstablecimiento"
                                            ng-change="onChangeEstab()">
                                        <option ng-value="item.idEstablecimiento"
                                                ng-repeat="item in establecimientos">
                                            {{item.nombreComercial}}
                                        </option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-lg-12 col-md-12 col-sm-12 col-12">
                                <div class="form-group">
                                    <label for="">Bodega: <span class="text-danger">*</span> </label>
                                    <select class="form-control" ng-model="dataUbicacion.idBodega">
                                        <option ng-value="item.idBodega" ng-repeat="item in bodegas">
                                            {{item.bodega}}
                                        </option>
                                    </select>
                                </div>
                            </div>

                            <div class="col-lg-12 col-md-12 col-sm-12 col-12">
                                <div class="form-group">
                                    <label for="">Ubicación <span class="text-danger">*</span></label>
                                    <input type="text" ng-model="dataUbicacion.ubicacion"
                                           class="form-control border-select" placeholder="Ej: S/N" />
                                </div>
                            </div>

                            <div class="ml-auto">
                                @* ng-click="saveUpdate()" *@
                                <button class="btn btn-success" ng-click="saveUbicacion()">
                                    <i class="{{dataUbicacion.idArticuloUbicacion>0?'ti-pencil':'ti-save'}}"></i>
                                    {{dataUbicacion.idArticuloUbicacion>0?'Actualizar':'Guardar'}}
                                </button>
                                <button type="button" class="btn btn-danger" ng-click="resetDataUbicacion()">
                                    Limpiar
                                </button>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-8 col-md-8 col-sm-8 col-12">
                        <div class="table-responsive">
                            <table class="table table-condensed table-sm">
                                <thead>
                                    <tr>
                                        <th>N°</th>
                                        <th>Bodega</th>
                                        <th>Ubicación</th>
                                        <th>Op.</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr ng-repeat="item in articuloUbicaciones">
                                        <td>{{$index+1}}</td>
                                        <td>{{item.descripcion}}</td>
                                        <td>{{item.ubicacion}}</td>
                                        <td>
                                            <a class="text-success" ng-click="editarUbicacion(item)"
                                               href="javascript:;" title="Editar">
                                                <i class="fa fa-edit"></i>
                                            </a>
                                            <a class="text-danger" ng-click="askToDeleteUbicacion(item)"
                                               href="javascript:;" title="Eliminar">
                                                <i class="fa fa-trash"></i>
                                            </a>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </uib-tab>
    </uib-tabset>


</div>
<div class="modal-footer">
    <button type="button" class="btn btn-success"
            ng-click="save()">
        {{tipoRegistro==1?'Guardar':'Actualizar'}}
    </button>
    <button type="button" class="btn btn-dark" ng-click="closeModal()">&times; Cerrar</button>
</div>