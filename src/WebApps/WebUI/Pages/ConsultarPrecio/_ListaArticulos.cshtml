<div>
    <md-table-container style="max-height: 400px;">
        <table resize master md-table class="text-center">
            <thead md-head md-order="dataSearch.order">
                <tr md-row class="border">
                    <th md-column colspan="8"></th>
                    <th md-column colspan="5" class="border text-center">Tarifas</th>
                    <th md-column ng-if="stocks.length" colspan="{{stocks.length}}" class="border text-center">
                        Bodega-Stock</th>
                    <th md-column colspan="3" class="border"></th>

                </tr>
                <tr md-row>
                    <th md-column><span>Op.</span></th>
                    <th md-column><span>Img</span></th>
                    <th md-column md-order-by="codigo"><span>Código</span></th>
                    <th md-column md-order-by="descripcion"><span>Descripción</span></th>
                    <th md-column md-order-by="codigoBarra">Cod. Barra</th>
                    <th md-column md-order-by="medida">Medida</th>
                    <th md-column><span>Iva</span></th>
                    <th md-column md-order-by="stock">Stock</th>
                    <th md-column ng-repeat="item in tarifas" class="border text-center">
                        {{item.tarifa}}
                    </th>
                    <th md-column ng-repeat="item in stocks" class="border text-center">
                        {{item.bodega}}
                    </th>
                    <th md-column>Marca</th>
                    <th md-column>Modelo</th>
                    <th md-column>Obs.</th>
                </tr>
            </thead>
            <tbody md-body>
                <tr md-row ng-repeat="item in articulos | orderBy: dataSearch.order track by $index">
                    <td md-cell>
                        <div class="d-flex ">
                            <button type="button" class="btn btn-success btn-xs mr-2" ng-if="options.multiSelect"
                                ng-click="askToSelect(item)"
                                placeholder="Hover over this for a tooltip until this is filled"
                                uib-tooltip="Agregar artículo en el detalle del documento">
                                <i class="fas fa-cart-arrow-down"></i>
                            </button>
                            <view-kardex params="item"></view-kardex>
                        </div>
                    </td>
                    <td md-cell style="vertical-align: middle">
                        <img class="img-fluid img-thumbnail" ng-click="previewImg(item)" width="50"
                            src="{{item.s3ObjectUrl}}" />
                    </td>
                    <td md-cell>{{item.codigo}}</td>
                    <td md-cell>
                        <a tooltip uib-tooltip="{{item.observaciones}}" tooltip-trigger="'mouseenter'"
                            tooltip-placement="top" href="javascript:void(0)">
                            {{item.descripcion}}
                        </a>
                    </td>
                    <td md-cell>{{item.codigoBarra}}</td>
                    <td md-cell>{{item.medida}}</td>
                    <td md-cell>{{item.tipoIva}}</td>
                    <td md-cell>
                        @* popover-title="{{item.descripcion}}" *@
                        <span style="cursor: pointer;" estab-stock article="item" class="btn btn-default">
                            <h6>
                                <spna ng-class="item.color">{{item.stock}}</spna>
                            </h6>

                        </span>


                    </td>
                    <td md-cell ng-repeat="pvp in item.tarifas" class="border">{{pvp.precioConIva}}</td>
                    <td md-cell ng-repeat="stock in item.stocks" class="border">{{stock.stock}}</td>
                    <td md-cell>{{item.marca}}</td>
                    <td md-cell>{{item.modelo}}</td>
                    <td md-cell>{{item.observaciones}}</td>

                </tr>
                <tr ng-show="articulos.length==0" class="text-center">
                    <td colspan="17">
                        No hay registros en esta tabla :)
                    </td>
                </tr>
            </tbody>
        </table>
    </md-table-container>
</div>
<div class="row justify-content-between mt-1">
    <div class="col-xl-4 col-lg-4 col-md-6 col-sm-12 col-12">
        <ul uib-pagination total-items="dataSearch.totalRecords" items-Per-Page="dataSearch.pageSize"
            ng-change="pagechanged()" ng-model="dataSearch.pageIndex" max-size="dataSearch.maxSize" class="pagination"
            boundary-links="true" rotate="false"></ul>
    </div>
    <div class="col-xl-2 col-lg-2 col-md-6 col-sm-12 col-12">
        <span class="text-dark">Total {{dataSearch.totalRecords}} Artículos</span>
    </div>
</div>
