<form ng-submit="onSave()" autocomplete="off">
    <div class="modal-header">
        <div class="float-left">
            <div class="custom-control custom-checkbox">
                <input type="checkbox" class="custom-control-input" ng-model="showHeader" id="checkbox0" value="check">
                <label class="custom-control-label" for="checkbox0">Mas datos</label>
            </div>
        </div>
        <div class="float-center">
            <h5><span>Detalle Factura </span></h5>
        </div>
        <div class="float-right">
            <h4><span class="float-right"><strong>Total: ${{data.total}} </strong></span></h4>
        </div>
    </div>

    <div class="modal-body">
        <div class="row" ng-if="showHeader">
            <div class="col-xl-2 col-lg-2 col-md-6 col-sm-12 col-12">
                <div class="form-group">
                    <label for="establecimiento">Estab.: </label>
                    <input type="text" ng-value="data.establecimiento" class="form-control" disabled>
                </div>
            </div>

            <div class="col-xl-3 col-lg-3 col-md-6 col-sm-6 col-12">
                <div class="form-group">
                    <label for="">Cliente: </label>
                    <input type="text" ng-value="cliente.razonSocialComprador" class="form-control" disabled>
                </div>
            </div>

            <div class="col-xl-2 col-lg-2 col-md-6 col-sm-6 col-12">
                <div class="form-group">
                    <label for="nroIndentificacion" class="">Nro. Identificación:</label>
                    <input type="text" class="form-control" disabled ng-value="cliente.identificacionComprador"
                        placeholder="..." />
                </div>
            </div>

            <div class="col-xl-2 col-lg-2 col-md-6 col-sm-6 col-12">
                <div class="form-group">
                    <label for="address" class="">Dirección:</label>
                    <input type="text" class="form-control" disabled ng-model="cliente.direccionComprador" />
                </div>
            </div>

            <div class="col-xl-3 col-lg-3 col-md-6 col-sm-6 col-12">
                <div class="form-group">
                    <label for="email" class="">Correo:</label>
                    <input type="text" name="email" id="email" class="form-control" disabled ng-model="cliente.correo">
                </div>
            </div>
        </div>

        <div class="row" ng-if="showHeader">
            <div class="col-xl-2 col-lg-2 col-md-6 col-sm-6 col-12">
                <div class="form-group">
                    <label for="serieComprobante">Serie Comprobante: </label>
                    <input type="text" name="serieComprobante" ng-value="data.serieComprobante" class="form-control"
                        disabled>
                </div>
            </div>

            <div class="col-xl-3 col-xl-3 col-lg-3 col-md-6 col-sm-6 col-12">
                <div class="form-group">
                    <label for="tiempoCredito">Tiempo Crédito: </label>
                    <input type="text" name="tiempoCredito" ng-value="data.tiempoCredito" class="form-control" disabled>
                </div>
            </div>

            <div class="col-xl-2 col-lg-2 col-md-6 col-sm-6 col-12">
                <div class="form-group">
                    <label for="fechaEmision">Fecha Emisión: </label>
                    <input type="date" name="fechaEmision" id="fechaEmision" class="form-control border-select"
                        ng-model="data.fechaEmision" disabled />
                    <small class="text-info">{{data.fechaEmisionEscrita}}</small>
                </div>
            </div>

            <div class="col-xl-2 col-lg-2 col-md-6 col-sm-6 col-12">
                <div class="form-group">
                    <label for="fechaVencimiento">Fecha Vencimiento:</label>
                    <input type="date" name="fechaVencimiento" id="fechaVencimiento" class="form-control" disabled
                        ng-model="data.fechaVencimiento" />
                    <small class="text-info">{{data.fechaVencimientoEscrita}}</small>
                </div>
            </div>

            <div class="col-xl-3 col-lg-3 col-md-6 col-sm-12 col-12">
                <div class="form-group">
                    <label for="empleado">Empleado</label>
                    <input type="text" name="empleado" id="empleado" class="form-control " ng-value="data.empleado"
                        disabled />
                </div>
            </div>
        </div>

        <div ui-grid="gridOptions" ui-grid-resize-columns ui-grid-cellNav ui-grid-auto-resize class="grid">
        </div>

        <div class="row mt-1">
            <div class="col-xl-9 col-lg-9 col-md-6 col-sm-12 col-12"> 
                <div class="row mt-2">
                    <div class="col-xl-3 col-lg-3 col-md-6 col-sm-12 col-12">
                        <div class="form-group">
                            <label>% Descuento</label>
                            <div class="input-group">
                                <input ng-model="data.porcentajeDescuento" disabled valid-number class="form-control" />
                                <div class="input-group-append">
                                    <button type="button" class="btn btn-secondary btn-sm" disabled>
                                        <i class="fa fa-calculator fa-xs"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-xl-3 col-lg-3 col-md-6 col-sm-12 col-12">
                        <div class="form-group">
                            <label>Descuento</label>
                            <div class="input-group">
                                <input ng-model="data.totalDescuento" id="totalDescuento" disabled valid-number
                                    placeholder="0.00" class="form-control" />
                                <div class="input-group-append">
                                    <button type="button" class="btn btn-secondary btn-sm" disabled>
                                        <i class="fa fa-calculator fa-xs"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div> 

                    <div class="col-xl-6 col-lg-6 col-md-12 col-sm-12 col-12">
                        <div class="form-group">
                            <label>Observacion</label>
                            <textarea class="form-control border-select" ng-model="data.observacion" touppercase
                                disabled placeholder="..."></textarea>
                        </div>
                    </div>
                </div>
                <div class="row">
                <div class="col-xl-8 col-lg-8 col-md-12 col-sm-12 col-12">
                    <div class="card border">
                        <!-- <div class="card-header">
                            <span class="card-title">FORMA DE PAGO</span>
                        </div> -->
                        <div class="card-body">
                            <div class="table-responsive">
                                <table class="table">
                                    <thead>
                                        <tr>
                                            <th>Forma de Pago</th>
                                            <th>Plazo</th>
                                            <th>Valor</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr>
                                            <td>
                                                 {{dataFormaPago.formaPago}}
                                            </td>
                                            <td width="100px">
                                                {{dataFormaPago.plazo}} {{dataFormaPago.plazo>1?'Días': 'Día'}}
                                            </td>
                                            <td width="100px">
                                                ${{dataFormaPago.total}}
                                            </td> 
                                        </tr>
                                    </tbody>
                                </table>
                            </div> 
                        </div>
                    </div>
                </div>
                <div class="col-xl-6 col-lg-6 col-md-12 col-sm-12 col-12">
                </div>
            </div> 
            </div>

            <div class="col-xl-3 col-lg-3 col-md-6 col-sm-12 col-12">
                <div class="card border p-2">
                    <div id="draw-dynamic-subtotal"></div>
                </div>
                <button type="button" class="btn btn-secondary btn-sm btn-lg btn-block"
                    open-modal-additional-data-document datos-adicionales="infoAdicionalDocumento" is-view="true">
                    <i class="fas fa-info-circle text-info"></i> Dato Adicional
                </button>

            </div>
        </div>




    </div>

    <div class="modal-footer"> 
        <button type="button" class="btn btn-dark" ng-click="closeModal()">
            &times; Cerrar
        </button>
    </div>
</form>