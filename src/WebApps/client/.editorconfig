root = false
extends = ..\..\..\.editorconfig

[*]
charset = utf-8
end_of_line = lf
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.{ts,html}]
indent_size = 2
# Vertical spacing controls
max_line_length = 120
# New rules for vertical alignment
align_assignments = true
align_parameters = true
align_chained_calls = true

[*.scss]
indent_size = 2
align_properties = true
