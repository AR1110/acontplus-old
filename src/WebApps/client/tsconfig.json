/* To learn more about this file see: https://angular.io/config/tsconfig. */
{
  "compileOnSave": false,
  "compilerOptions": {
    "baseUrl": "./",
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "preserve",
    "paths": {
      "@core/*": ["src/app/core/*"],
      "@company-customer/*": ["src/app/modules/customer/company-customer/*"],
      "@modules/*": ["src/app/modules/*"],
      "@accounting/*": ["src/app/modules/accounting/*"],
      "@technical-support/*": ["src/app/modules/technical-support/*"],
      "@inventory/*": ["src/app/modules/inventory/*", "src/app/modules/inventory/shared/*"],
      "@purchase/*": ["src/app/modules/purchase/*"],
      "@purchases/*": ["src/app/modules/purchases/*"],
      "@sale/*": ["src/app/modules/sale/*", "src/app/modules/inventory/shared/*"],
      "@restaurant/*": ["src/app/modules/restaurant/*"],
      "@billing/*": ["src/app/modules/billing/*"],
      "@mechanical/*": ["src/app/modules/mechanical/*"],
      "@customer/*": ["src/app/modules/customer/*"],
      "@shared/*": ["src/app/shared/*"],
      "@sri/*": ["src/app/modules/sri/*"],
      "@barber-shop/*": ["src/app/modules/barber-shop/*"]
    }
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "typeCheckHostBindings": true,
    "strictTemplates": true
  },
  "files": [],
  "references": [
    {
      "path": "./tsconfig.app.json"
    },
    {
      "path": "./tsconfig.spec.json"
    }
  ]
}
