{
  "singleQuote": true,
  "trailingComma": "all",
  "printWidth": 120,
  "useTabs": false,
  "tabWidth": 2,
  "semi": true,
  "arrowParens": "always",
  "bracketSpacing": true,
  "bracketSameLine": false,
  "htmlWhitespaceSensitivity": "css",
  "embeddedLanguageFormatting": "auto",
  "organizeImports": true,
  "importOrder": ["^@angular", "^@app", "^[./]"],
  "importOrderSeparation": true,
  "alignObjectProperties": true,
  "alignArguments": true,
  "alignTernaryLines": true,
  "verticalAlignment": {
    "enabled": true,
    "multilineObjects": true,
    "functionParameters": true,
    "importStatements": true
  }
}
