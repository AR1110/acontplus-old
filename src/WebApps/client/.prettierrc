{
  "tabWidth": 2,
  "useTabs": false,
  "singleQuote": true,
  "semi": true,
  "arrowParens": "always",
  "bracketSpacing": true,
  "endOfLine": "lf",
  "trailingComma": "all",
  "printWidth": 120,
  "bracketSameLine": false,
  "htmlWhitespaceSensitivity": "css",
  "embeddedLanguageFormatting": "auto",
  "verticalAlignment": {
    "enabled": true,
    "groups": [
      {
        "start": "^import",
        "end": "(from|require)\\s+['\"]",
        "alignBy": "from"
      },
      {
        "start": "=",
        "end": ";",
        "alignBy": "="
      },
      {
        "start": ":",
        "end": ",",
        "alignBy": ":"
      }
    ],
    "multilineObjects": true,
    "functionParameters": true,
    "importStatements": true
  },
  "plugins": [
    "prettier-plugin-sort-imports"
  ],
  "overrides": [
    {
      "files": ["*.component.html"],
      "options": {
        "parser": "angular",
        "htmlWhitespaceSensitivity": "ignore",
        "verticalAlignment": {
          "alignAttributes": true,
          "alignOpenTagEnd": true,
          "minAttributeCount": 2
        }
      }
    },
    {
      "files": ["*.{ts,tsx,js}"],
      "options": {
        "organizeImports": true,
        "importOrder": ["^@angular", "^@app", "^[./]"],
        "importOrderSeparation": true,
        "importOrderParserPlugins": ["typescript", "decorators"],
        "alignObjectProperties": true,
        "alignArguments": true,
        "alignTernaryLines": true
      }
    }
  ]
}
