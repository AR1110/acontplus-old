{
  "name": "client",
  "version": "3.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --hmr",
    "development": "ng build -c development --base-href /client/",
    "production": "ng build -c production",
    "staging": "ng build -c staging --base-href /client/",
    "watch": "ng build --watch --configuration development",
    "test": "node --experimental-vm-modules --no-warnings node_modules/jest/bin/jest.js --config jest.config.mjs",
    "test:watch": "node --experimental-vm-modules --no-warnings node_modules/jest/bin/jest.js --config jest.config.mjs --watch",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix",
    "format": "prettier --write \"src/**/*.{ts,js,html,scss,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,js,html,scss,css,json}\"",
    "prepare": "husky"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@acontplus/core": "^1.1.3",
    "@acontplus/ng-common": "^1.0.11",
    "@acontplus/ng-components": "^2.1.23",
    "@acontplus/ng-infrastructure": "^2.0.6",
    "@acontplus/ng-notifications": "^2.0.2",
    "@acontplus/ui-kit": "^1.0.2",
    "@angular/animations": "^21.1.0",
    "@angular/cdk": "^21.1.0",
    "@angular/common": "^21.1.0",
    "@angular/compiler": "^21.1.0",
    "@angular/core": "^21.1.0",
    "@angular/forms": "^21.1.0",
    "@angular/material": "^21.1.0",
    "@angular/platform-browser": "^21.1.0",
    "@angular/platform-browser-dynamic": "^21.1.0",
    "@angular/router": "^21.1.0",
    "@formkit/tempo": "^1.0.0",
    "@jsverse/transloco": "^8.2.0",
    "@ng-select/ng-select": "^21.1.4",
    "@ngrx/signals": "^21.0.1",
    "@ngx-formly/core": "^7.0.1",
    "@ngx-translate/core": "^17.0.0",
    "@ngx-translate/http-loader": "^17.0.0",
    "bootstrap": "^5.3.8",
    "chart.js": "^4.5.1",
    "date-fns": "^4.1.0",
    "decimal.js": "^10.6.0",
    "file-saver": "^2.0.5",
    "jest-editor-support": "32.0.0-beta.1",
    "jwt-decode": "^4.0.0",
    "ng-apexcharts": "^2.0.4",
    "ngx-colors": "^3.6.0",
    "ngx-cookie-service": "^21.1.0",
    "ngx-datex": "^1.0.5",
    "ngx-file-drop": "^16.0.0",
    "ngx-mask": "^20.0.3",
    "ngx-permissions": "^19.0.0",
    "ngx-progressbar": "^14.0.0",
    "ngx-quill": "^30.0.1",
    "ngx-toastr": "^19.1.0",
    "photoviewer": "^3.11.1",
    "quill": "^2.0.3",
    "rxjs": "^7.8.2",
    "screenfull": "^6.0.2",
    "shepherd.js": "^14.5.1",
    "sweetalert2": "^11.26.17",
    "tabulator-tables": "^6.3.1",
    "tslib": "^2.8.1",
    "ua-parser-js": "^2.0.8",
    "uuid": "^13.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@angular/build": "^21.1.0",
    "@angular/cli": "^21.1.0",
    "@angular/compiler-cli": "^21.1.0",
    "@angular/localize": "^21.1.0",
    "@types/file-saver": "^2.0.7",
    "@types/jest": "^30.0.0",
    "@types/tabulator-tables": "^6.3.1",
    "angular-eslint": "21.1.0",
    "eslint": "^9.39.2",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "jest-preset-angular": "^16.0.0",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.0",
    "prettier-plugin-sort-imports": "^1.8.9",
    "sass": "^1.97.2",
    "source-map-explorer": "^2.5.3",
    "tree-cli": "^0.6.7",
    "ts-jest": "^29.4.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.53.0",
    "zone.js": "^0.16.0"
  },
  "lint-staged": {
    "src/**/*.{ts,html}": [
      "eslint --fix"
    ],
    "src/**/*.{ts,js,html,scss,css,json}": [
      "prettier --write"
    ]
  }
}