{
  "name": "client",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --hmr",
    "development": "ng build -c development --base-href /client/",
    "production": "ng build -c production",
    "staging": "ng build -c staging --base-href /client/",
    "watch": "ng build --watch --configuration development",
    "test": "node --experimental-vm-modules --no-warnings node_modules/jest/bin/jest.js --config jest.config.mjs",
    "test:watch": "node --experimental-vm-modules --no-warnings node_modules/jest/bin/jest.js --config jest.config.mjs --watch",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix",
    "format": "prettier --write \"src/**/*.{ts,js,html,scss,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,js,html,scss,css,json}\"",
    "prepare": "husky"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.3.3",
    "@angular/cdk": "^20.2.7",
    "@angular/cli": "^20.3.13",
    "@angular/common": "^20.3.3",
    "@angular/compiler": "^20.3.15",
    "@angular/core": "^20.3.3",
    "@angular/forms": "^20.3.3",
    "@angular/material": "^20.2.7",
    "@angular/platform-browser": "^20.3.3",
    "@angular/platform-browser-dynamic": "^20.3.3",
    "@angular/router": "^20.3.3",
    "@formkit/tempo": "^0.1.2",
    "@fortawesome/angular-fontawesome": "^3.0.0",
    "@fortawesome/fontawesome-svg-core": "^7.1.0",
    "@fortawesome/free-brands-svg-icons": "^7.1.0",
    "@ng-matero/extensions": "^20.3.1",
    "@ng-select/ng-select": "^20.2.2",
    "@ngrx/signals": "^20.0.1",
    "@ngx-formly/core": "^7.0.0",
    "@ngx-translate/core": "^17.0.0",
    "@ngx-translate/http-loader": "^17.0.0",
    "bootstrap": "^5.3.8",
    "chart.js": "^4.5.0",
    "date-fns": "^4.1.0",
    "decimal.js": "^10.6.0",
    "file-saver": "^2.0.5",
    "jest-editor-support": "^31.1.2",
    "jwt-decode": "^4.0.0",
    "ng-apexcharts": "^2.0.3",
    "ngx-colors": "^3.6.0",
    "ngx-cookie-service": "^20.1.0",
    "ngx-file-drop": "^16.0.0",
    "ngx-mask": "^20.0.3",
    "ngx-permissions": "^19.0.0",
    "ngx-progressbar": "^14.0.0",
    "ngx-quill": "^28.0.1",
    "ngx-toastr": "^19.1.0",
    "photoviewer": "^3.10.3",
    "quill": "^2.0.3",
    "rxjs": "^7.8.2",
    "screenfull": "^6.0.2",
    "shepherd.js": "^14.5.1",
    "sweetalert2": "^11.24.1",
    "tabulator-tables": "^6.3.1",
    "tslib": "^2.8.1",
    "ua-parser-js": "^2.0.5",
    "uuid": "^13.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@angular/build": "^20.3.4",
    "@angular/compiler-cli": "^20.3.3",
    "@angular/localize": "^20.3.3",
    "@types/file-saver": "^2.0.7",
    "@types/jest": "^30.0.0",
    "@types/tabulator-tables": "^6.2.11",
    "angular-eslint": "20.3.0",
    "eslint": "^9.37.0",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "jest-preset-angular": "^15.0.2",
    "lint-staged": "^15.3.0",
    "prettier": "^3.6.2",
    "prettier-plugin-sort-imports": "^1.8.8",
    "sass": "^1.93.2",
    "source-map-explorer": "^2.5.3",
    "tree-cli": "^0.6.7",
    "ts-jest": "^29.4.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "zone.js": "^0.15.1"
  },
  "lint-staged": {
    "src/**/*.{ts,html}": [
      "eslint --fix"
    ],
    "src/**/*.{ts,js,html,scss,css,json}": [
      "prettier --write"
    ]
  }
}
