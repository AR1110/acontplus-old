{
  "name": "client",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --hmr",
    "development": "ng build -c development --base-href /client/",
    "production": "ng build -c production",
    "staging": "ng build -c staging --base-href /client/",
    "watch": "ng build --watch --configuration development",
    "test": "node --experimental-vm-modules --no-warnings node_modules/jest/bin/jest.js --config jest.config.mjs",
    "test:watch": "node --experimental-vm-modules --no-warnings node_modules/jest/bin/jest.js --config jest.config.mjs --watch",
    "lint": "ng lint",
    "format": "prettier --write \"./src/**/*.{ts,js,html,scss,css}\"",
    "check-format": "prettier --check \"./src/**/*.{ts,js,html,scss,css}\""
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.3.3",
    "@angular/cdk": "^20.1.4",
    "@angular/cli": "^20.3.4",
    "@angular/common": "^20.3.3",
    "@angular/compiler": "^20.3.3",
    "@angular/core": "^20.3.3",
    "@angular/forms": "^20.3.3",
    "@angular/material": "^20.1.4",
    "@angular/platform-browser": "^20.3.3",
    "@angular/platform-browser-dynamic": "^20.3.3",
    "@angular/router": "^20.3.3",
    "@formkit/tempo": "^0.1.2",
    "@fortawesome/angular-fontawesome": "^2.0.1",
    "@fortawesome/fontawesome-svg-core": "^7.0.0",
    "@fortawesome/free-brands-svg-icons": "^7.0.0",
    "@ng-matero/extensions": "^20.3.1",
    "@ng-select/ng-select": "^15.2.0",
    "@ngrx/signals": "^20.0.0",
    "@ngx-formly/core": "^7.0.0",
    "@ngx-translate/core": "^17.0.0",
    "@ngx-translate/http-loader": "^17.0.0",
    "bootstrap": "^5.3.7",
    "chart.js": "^4.5.0",
    "date-fns": "^4.1.0",
    "decimal.js": "^10.6.0",
    "file-saver": "^2.0.5",
    "jest-editor-support": "^31.1.2",
    "jwt-decode": "^4.0.0",
    "ngx-colors": "^3.6.0",
    "ngx-cookie-service": "^20.0.1",
    "ngx-file-drop": "^16.0.0",
    "ngx-mask": "^20.0.2",
