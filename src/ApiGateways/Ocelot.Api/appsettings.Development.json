{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AdvancedLogging": {
    "EnableLocalFile": true,
    "Shared": false,
    "Buffered": true,
    "LocalFilePath": "C:\\Acontplus\\Logs\\ApiGateways\\OcelotApi\\log-.txt",
    "TimeZoneId": "America/Guayaquil"
  },
  "Serilog": { // This is the Serilog-specific configuration section that complements your code
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System.Net.Http.HttpClient": "Warning" // Example override for noisy HttpClient logs
      }
    },
    "Enrich": [
      // Add enrichers NOT already handled by your ConfigureAdvancedLogger
      // Your code already has: WithEnvironmentUserName, FromLogContext, CustomTimeZoneEnricher
      "WithMachineName",
      "WithEnvironmentUserName",
      "FromLogContext"
    ],
    "Properties": {
      "Application": "Ocelot.API" // A global property for all logs
    }
    // DO NOT put your conditional S3, DB, or complex file sinks here,
    // as they are better handled by your ConfigureAdvancedLogger and LoggingOptions.
    // A basic console sink might be useful here if your code doesn't manage it for all environments.
    // "WriteTo": [ { "Name": "Console" } ] // If you want a simple console sink always
  },
  "SafeOrigins": "https://localhost:7166,https://localhost:4200,http://localhost:5001",
  "JwtSettings": {
    "Audience": [ "ocelot.service" ]
  }
}

