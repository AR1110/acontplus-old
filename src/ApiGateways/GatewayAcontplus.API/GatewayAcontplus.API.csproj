    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AspNetCoreHostingModel>OutOfProcess</AspNetCoreHostingModel>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Ocelot" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Services\Common\Common.Core\Common.Core.csproj" />
    <ProjectReference Include="..\..\Services\Common\Services.Common\Services.Common.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\SharedSettings\sharedsettings.Development.json" Link="SharedSettings\sharedsettings.Development.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\SharedSettings\sharedsettings.Staging.json" Link="SharedSettings\sharedsettings.Staging.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\SharedSettings\sharedsettings.Production.json" Link="SharedSettings\sharedsettings.Production.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
