# Environment Configuration Template
# Copy this file:
#   - To .env for development (tracked in git with safe values)
#   - To .env.staging for staging (gitignored, sensitive data)
#   - To .env.production for production (gitignored, sensitive data)
#
# Usage:
#   Development: docker-compose up -d
#   Staging:     docker-compose -f docker-compose.yml -f docker-compose.staging.yml --env-file .env.staging up -d
#   Production:  docker-compose -f docker-compose.yml -f docker-compose.prod.yml --env-file .env.production up -d

# ==============================================================================
# GENERAL SETTINGS
# ==============================================================================

# Project name (prefix for container names)
# Development:  acontplus-dev
# Staging:      acontplus-staging
# Production:   acontplus-prod
COMPOSE_PROJECT_NAME=acontplus-dev

# Docker Registry (leave empty for local, set for remote registry)
# Local:        (empty)
# Azure:        myregistry.azurecr.io/
# AWS ECR:      123456789.dkr.ecr.us-east-1.amazonaws.com/
# Docker Hub:   username/
DOCKER_REGISTRY=

# Environment: Development, Staging, Production
# Determines which ocelot.{Environment}.json is loaded
ASPNETCORE_ENVIRONMENT=Development

# ==============================================================================
# NETWORKING
# ==============================================================================

# Gateway Port (external access)
# Development:  5000
# Staging:      80
# Production:   80
GATEWAY_PORT=5000

# Service URLs (internal Docker network communication)
# These use Docker DNS resolution - DO NOT CHANGE unless you rename services
SERVICE_URL_IDENTITY=http://identity.api:8080
SERVICE_URL_ACCOUNTING=http://accounting.api:8080
SERVICE_URL_BILLING=http://billing.api:8080
SERVICE_URL_SALES=http://sales.api:8080
SERVICE_URL_INVENTORY=http://inventory.api:8080
SERVICE_URL_PURCHASES=http://purchases.api:8080
SERVICE_URL_COMMON=http://common.api:8080
SERVICE_URL_CONFIGURATION=http://configuration.api:8080
SERVICE_URL_RESTAURANT=http://restaurant.api:8080
SERVICE_URL_MECHANICAL=http://mechanical.api:8080
SERVICE_URL_VET=http://vet.api:8080
SERVICE_URL_BARBERSHOP=http://barbershop.api:8080
SERVICE_URL_TECHSUPPORT=http://technicalsupport.api:8080

# ==============================================================================
# LOGGING
# ==============================================================================

# Log Level: Trace, Debug, Information, Warning, Error, Critical
# Development:  Information or Debug
# Staging:      Information
# Production:   Warning or Error
LOG_LEVEL=Information

# Log file path (inside container)
LOG_PATH=/app/logs/log-.txt

# Enable local file logging (in addition to Docker logs)
# Development:  true
# Staging:      true
# Production:   false (use centralized logging)
ENABLE_LOCAL_FILE_LOGGING=true

# Log Driver Configuration
LOG_DRIVER=json-file
# Development:  50m logs, 5 files
# Staging:      20m logs, 5 files
# Production:   10m logs, 3 files
LOG_MAX_SIZE=50m
LOG_MAX_FILE=5

# ==============================================================================
# DATABASE
# ==============================================================================

# Database Server
# Development:  host.docker.internal or IP (3.17.16.153)
# Staging:      staging-db-server.com
# Production:   production-db-server.com
DB_SERVER=host.docker.internal
DB_PORT=1433

# Database Name
# Development:  AcontPlus
# Staging:      AcontPlus_Staging
# Production:   AcontPlus
DB_NAME=AcontPlus

# Database Credentials
DB_USER=sa
DB_PASSWORD=CHANGE_THIS_PASSWORD
DB_TRUST_CERT=True

# Full connection string (auto-composed from above, or override)
# Development:  Simple connection
# Staging:      With retry logic and moderate pool
# Production:   With full retry logic, large pool, optimized settings
CONNECTION_STRING=Server=${DB_SERVER},${DB_PORT};Database=${DB_NAME};User Id=${DB_USER};Password=${DB_PASSWORD};TrustServerCertificate=${DB_TRUST_CERT};Pooling=true;Max Pool Size=20;Min Pool Size=3;Connection Timeout=30;

# ==============================================================================
# SECURITY & AUTHENTICATION
# ==============================================================================

# JWT Settings
# IMPORTANT: Generate unique key for each environment using:
#   openssl rand -base64 64
JWT_SECRET_KEY=CHANGE_THIS_TO_SECURE_KEY_MIN_64_CHARS_LONG
JWT_ISSUER=https://localhost:7060
JWT_AUDIENCE_GATEWAY=https://localhost:7060/api/gateway
JWT_AUDIENCE_IDENTITY=https://localhost:7060/api/identity
JWT_AUDIENCE_ACCOUNTING=https://localhost:7060/api/accounting
JWT_AUDIENCE_BILLING=https://localhost:7060/api/billing
JWT_AUDIENCE_SALES=https://localhost:7060/api/sales
JWT_AUDIENCE_INVENTORY=https://localhost:7060/api/inventory
JWT_AUDIENCE_PURCHASES=https://localhost:7060/api/purchases
JWT_AUDIENCE_COMMON=https://localhost:7060/api/common
JWT_AUDIENCE_CONFIGURATION=https://localhost:7060/api/configuration
JWT_AUDIENCE_RESTAURANT=https://localhost:7060/api/restaurant
JWT_AUDIENCE_MECHANICAL=https://localhost:7060/api/mechanical
JWT_AUDIENCE_VET=https://localhost:7060/api/vet
JWT_AUDIENCE_BARBERSHOP=https://localhost:7060/api/barbershop
JWT_AUDIENCE_TECHSUPPORT=https://localhost:7060/api/technicalsupport

# JWT Token Expiration (seconds for access, days for refresh)
JWT_ACCESS_EXPIRATION=3600
JWT_REFRESH_EXPIRATION=7

# API Gateway URL (used by services for inter-service communication)
# Development:  https://localhost:7060
# Staging:      https://staging.acontplus.com
# Production:   https://api.acontplus.com
APIGATEWAY_ACONTPLUS=https://localhost:7060

# CORS Origins (comma-separated, no spaces)
# Development:  Local dev URLs
# Staging:      Staging domains
# Production:   Production domains only
SAFE_ORIGINS=https://localhost:7166,https://localhost:4200,http://localhost:5001

# ==============================================================================
# DOCKER RUNTIME SETTINGS
# ==============================================================================

# Restart Policy: no, always, on-failure, unless-stopped
# Development:  unless-stopped
# Staging:      unless-stopped
# Production:   always
RESTART_POLICY=unless-stopped

# Resource Limits (applied in staging/production compose files)
# Development:  (empty - no limits)
# Staging:      CPU: 1.5, RAM: 512M
# Production:   CPU: 2, RAM: 1G
MEMORY_LIMIT=512M
CPU_LIMIT=1

# ==============================================================================
# FEATURE FLAGS
# ==============================================================================

# Enable Swagger/OpenAPI documentation
# Development:  true
# Staging:      true (for testing)
# Production:   false (security risk)
ENABLE_SWAGGER=true

# Enable health check endpoints
ENABLE_HEALTHCHECKS=true

# ==============================================================================
# EXTERNAL SERVICES (Optional)
# ==============================================================================

# Redis Cache
# REDIS_HOST=redis-dev
# REDIS_PORT=6379
# REDIS_PASSWORD=

# RabbitMQ Message Broker
# RABBITMQ_HOST=rabbitmq-dev
# RABBITMQ_PORT=5672
# RABBITMQ_USER=acontplus
# RABBITMQ_PASSWORD=

# ==============================================================================
# CLOUD STORAGE (Optional)
# ==============================================================================

# AWS S3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# S3_BUCKET_NAME=acontplus-assets

# Azure Blob Storage
# AZURE_STORAGE_CONNECTION_STRING=
# AZURE_STORAGE_CONTAINER=acontplus-assets

# ==============================================================================
# EMAIL / NOTIFICATIONS (Optional)
# ==============================================================================

# SMTP Settings
# SMTP_SERVER=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USERNAME=apikey
# SMTP_PASSWORD=
# EMAIL_FROM=noreply@acontplus.com

# ==============================================================================
# MONITORING & APM (Optional)
# ==============================================================================

# Application Insights (Azure)
# APPLICATION_INSIGHTS_KEY=

# Elastic APM
# ELASTIC_APM_SERVER_URL=
# ELASTIC_APM_SECRET_TOKEN=

# ==============================================================================
# ENVIRONMENT-SPECIFIC NOTES
# ==============================================================================
#
# DEVELOPMENT (.env - tracked in git):
#   - Use safe/example values only
#   - DB password can be real dev server password (not production)
#   - JWT key can be example (generates new tokens each restart)
#   - DOCKER_REGISTRY empty (builds local images)
#
# STAGING (.env.staging - GITIGNORED):
#   - Copy from .env.example
#   - Set real staging database credentials
#   - Generate unique JWT_SECRET_KEY: openssl rand -base64 64
#   - Set staging domain URLs
#   - Optional: Set DOCKER_REGISTRY for shared registry
#
# PRODUCTION (.env.production - GITIGNORED):
#   - Copy from .env.example
#   - Set real production database credentials
#   - Generate unique JWT_SECRET_KEY: openssl rand -base64 64
#   - Set production domain URLs
#   - ENABLE_SWAGGER=false
#   - LOG_LEVEL=Warning
#   - Recommended: Use secrets manager (Azure Key Vault, AWS Secrets)
#
# ==============================================================================
# SECURITY CHECKLIST
# ==============================================================================
# ✅ .env.staging and .env.production are in .gitignore
# ✅ JWT_SECRET_KEY is unique per environment (64+ characters)
# ✅ DB_PASSWORD is strong and rotated regularly
# ✅ SAFE_ORIGINS only includes trusted domains
# ✅ Production has ENABLE_SWAGGER=false
# ✅ Production secrets stored in vault (not in .env file)
