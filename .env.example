# Environment Configuration Template
# Copy this to .env (for development) or customize .env.development / .env.production
# .env files are loaded automatically by docker-compose

# ==============================================================================
# GENERAL SETTINGS
# ==============================================================================

COMPOSE_PROJECT_NAME=acontplus-dev

# Docker Registry (leave empty for local, set for remote registry)
DOCKER_REGISTRY=

# Environment: Development, Staging, Production
ASPNETCORE_ENVIRONMENT=Development

# ==============================================================================
# NETWORKING
# ==============================================================================

# Gateway Port (external access)
GATEWAY_PORT=5000

# Service URLs (internal Docker network communication)
SERVICE_URL_IDENTITY=http://identity.api:8080
SERVICE_URL_ACCOUNTING=http://accounting.api:8080
SERVICE_URL_BILLING=http://billing.api:8080
SERVICE_URL_SALES=http://sales.api:8080
SERVICE_URL_INVENTORY=http://inventory.api:8080
SERVICE_URL_PURCHASES=http://purchases.api:8080
SERVICE_URL_COMMON=http://common.api:8080
SERVICE_URL_CONFIGURATION=http://configuration.api:8080
SERVICE_URL_RESTAURANT=http://restaurant.api:8080
SERVICE_URL_MECHANICAL=http://mechanical.api:8080
SERVICE_URL_VET=http://vet.api:8080
SERVICE_URL_BARBERSHOP=http://barbershop.api:8080
SERVICE_URL_TECHSUPPORT=http://technicalsupport.api:8080

# ==============================================================================
# LOGGING
# ==============================================================================

LOG_LEVEL=Information
LOG_PATH=/app/logs/log-.txt
ENABLE_LOCAL_FILE_LOGGING=true

# Log Driver Configuration
LOG_DRIVER=json-file
LOG_MAX_SIZE=50m
LOG_MAX_FILE=5

# ==============================================================================
# DATABASE
# ==============================================================================

# Database connection details
# Use 'host.docker.internal' to connect to host machine
# Or use Docker service name for containerized database
DB_SERVER=host.docker.internal
DB_PORT=1433
DB_NAME=AcontPlus
DB_USER=sa
DB_PASSWORD=Strong@Password123
DB_TRUST_CERT=True

# Full connection string (or let it be built from above)
# CONNECTION_STRING=Server=${DB_SERVER},${DB_PORT};Database=${DB_NAME};User Id=${DB_USER};Password=${DB_PASSWORD};TrustServerCertificate=${DB_TRUST_CERT}

# ==============================================================================
# SECURITY & AUTHENTICATION
# ==============================================================================

# JWT Settings
JWT_SECRET_KEY=your-super-secret-key-minimum-64-characters-long-CHANGE-THIS
JWT_ISSUER=https://localhost:7060
JWT_AUDIENCE_GATEWAY=https://localhost:7060/api/gateway
JWT_AUDIENCE_IDENTITY=https://localhost:7060/api/identity
JWT_AUDIENCE_ACCOUNTING=https://localhost:7060/api/accounting
JWT_AUDIENCE_BILLING=https://localhost:7060/api/billing
JWT_AUDIENCE_SALES=https://localhost:7060/api/sales
JWT_AUDIENCE_INVENTORY=https://localhost:7060/api/inventory
JWT_AUDIENCE_PURCHASES=https://localhost:7060/api/purchases
JWT_AUDIENCE_COMMON=https://localhost:7060/api/common
JWT_AUDIENCE_CONFIGURATION=https://localhost:7060/api/configuration
JWT_AUDIENCE_RESTAURANT=https://localhost:7060/api/restaurant
JWT_AUDIENCE_MECHANICAL=https://localhost:7060/api/mechanical
JWT_AUDIENCE_VET=https://localhost:7060/api/vet
JWT_AUDIENCE_BARBERSHOP=https://localhost:7060/api/barbershop
JWT_AUDIENCE_TECHSUPPORT=https://localhost:7060/api/technicalsupport
JWT_ACCESS_EXPIRATION=7200
JWT_REFRESH_EXPIRATION=7

# API Gateway
APIGATEWAY_ACONTPLUS=https://localhost:7060

# CORS Origins (comma-separated)
SAFE_ORIGINS=https://localhost:7166,https://localhost:4200,http://localhost:5001

# ==============================================================================
# EXTERNAL SERVICES
# ==============================================================================

# Redis Cache
# REDIS_HOST=redis
# REDIS_PORT=6379
# REDIS_PASSWORD=

# RabbitMQ Message Broker
# RABBITMQ_HOST=rabbitmq
# RABBITMQ_PORT=5672
# RABBITMQ_USER=guest
# RABBITMQ_PASSWORD=guest

# ==============================================================================
# CLOUD STORAGE
# ==============================================================================

# AWS S3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# S3_BUCKET_NAME=

# Azure Blob Storage
# AZURE_STORAGE_CONNECTION_STRING=
# AZURE_STORAGE_CONTAINER=

# ==============================================================================
# EMAIL / NOTIFICATIONS
# ==============================================================================

# SMTP Settings
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# EMAIL_FROM=

# ==============================================================================
# DOCKER RUNTIME SETTINGS
# ==============================================================================

# Restart Policy: no, always, on-failure, unless-stopped
RESTART_POLICY=no

# Resource Limits (production only)
MEMORY_LIMIT=
CPU_LIMIT=

# ==============================================================================
# FEATURE FLAGS
# ==============================================================================

# ENABLE_SWAGGER=true
# ENABLE_HEALTHCHECKS=true
# ENABLE_METRICS=false

# ==============================================================================
# NOTES
# ==============================================================================
# - Sensitive values (passwords, secrets) should use User Secrets in development
# - For production, use secrets management (Azure Key Vault, AWS Secrets Manager, etc.)
# - Variables can use ${VAR_NAME} syntax for composition
# - Lines starting with # are comments
# - Empty values use defaults defined in docker-compose files
