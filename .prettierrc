{
  "tabWidth": 2,
  "useTabs": false,
  "singleQuote": true,
  "semi": true,
  "arrowParens": "always",
  "bracketSpacing": true,
  "endOfLine": "lf",

  "trailingComma": "all",
  "printWidth": 120,
  "bracketSameLine": false,
  "htmlWhitespaceSensitivity": "css",
  "embeddedLanguageFormatting": "auto",

  "verticalAlignment": {
    "enabled": true,
    "groups": [
      {
        "start": "^import",
        "end": "(from|require)\\s+['\"]",
        "alignBy": "from"
      },
      {
        "start": "=",
        "end": ";",
        "alignBy": "="
      },
      {
        "start": ":",
        "end": ",",
        "alignBy": ":"
      }
    ],
    "multilineObjects": true,
    "functionParameters": true,
    "importStatements": true
  },

  "overrides": [
    {
      "files": ["*.cs"],
      "options": {
        "printWidth": 140,
        "singleQuote": false,
        "bracketSameLine": true,
        "verticalAlignment": {
          "alignPropertyDefinitions": true,
          "alignParameters": true
        }
      }
    },
    {
      "files": ["*.component.html"],
      "options": {
        "parser": "angular",
        "htmlWhitespaceSensitivity": "ignore",
        "verticalAlignment": {
          "alignAttributes": true,
          "alignOpenTagEnd": true,
          "minAttributeCount": 2
        }
      }
    },
    {
      "files": ["*.sql"],
      "options": {
        "keywordCase": "upper",
        "identifierCase": "lower",
        "verticalAlignment": {
          "alignClauses": true,
          "alignExpressions": true,
          "groupWhereClauses": true
        }
      }
    },
    {
      "files": ["*.{ts,tsx,js}"],
      "options": {
        "organizeImports": true,
        "importOrder": ["^@angular", "^@app", "^[./]"],
        "importOrderSeparation": true,
        "alignObjectProperties": true,
        "alignArguments": true,
        "alignTernaryLines": true
      }
    }
  ]
}
