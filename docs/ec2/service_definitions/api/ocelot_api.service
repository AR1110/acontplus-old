[Unit]
Description= Ocelot Gateway Api - Acontplus
After=network.target

[Service]
WorkingDirectory=/home/acontplus/services/ocelot_api
ExecStart=/usr/bin/dotnet /home/acontplus/services/ocelot_api/AcontplusGateway.API.dll
Restart=always
RestartSec=10
KillSignal=SIGINT
SyslogIdentifier=dotnet-ocelot-api
User=root
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=DOTNET_PRINT_TELEMETRY_MESSAGE=false

[Install]
WantedBy=multi-user.target