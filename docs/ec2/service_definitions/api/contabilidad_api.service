[Unit]
Description= Contabilidad Api - Acontplus
After=network.target

[Service]
WorkingDirectory=/home/acontplus/services/contabilidad_api
ExecStart=/usr/bin/dotnet /home/acontplus/services/contabilidad_api/Contabilidad.API.dll
Restart=always
RestartSec=10
KillSignal=SIGINT
SyslogIdentifier=dotnet-contabilidad-api
User=root
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=DOTNET_PRINT_TELEMETRY_MESSAGE=false
Environment=ASPNETCORE_URLS=http://0.0.0.0:5005

[Install]
WantedBy=multi-user.target