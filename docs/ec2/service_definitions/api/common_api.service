[Unit]
Description= Common Api - Acontplus
After=network.target

[Service]
WorkingDirectory=/home/acontplus/services/common_api
ExecStart=/usr/bin/dotnet /home/acontplus/services/common_api/Common.API.dll
Restart=always
RestartSec=10
KillSignal=SIGINT
SyslogIdentifier=dotnet-common-api
User=root
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=DOTNET_PRINT_TELEMETRY_MESSAGE=false
Environment=ASPNETCORE_URLS=http://0.0.0.0:5002

[Install]
WantedBy=multi-user.target