[Unit]
Description= Inventario Api - Acontplus
After=network.target

[Service]
WorkingDirectory=/home/acontplus/services/inventario_api
ExecStart=/usr/bin/dotnet /home/acontplus/services/inventario_api/Inventario.API.dll
Restart=always
RestartSec=10
KillSignal=SIGINT
SyslogIdentifier=dotnet-inventario-api
User=root
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=DOTNET_PRINT_TELEMETRY_MESSAGE=false
Environment=ASPNETCORE_URLS=http://0.0.0.0:5008

[Install]
WantedBy=multi-user.target