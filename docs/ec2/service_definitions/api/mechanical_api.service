[Unit]
Description= Mechanical Api - Acontplus
After=network.target

[Service]
WorkingDirectory=/home/acontplus/services/mechanical_api
ExecStart=/usr/bin/dotnet /home/acontplus/services/mechanical_api/Mechanical.API.dll
Restart=always
RestartSec=10
KillSignal=SIGINT
SyslogIdentifier=dotnet-mechanical-api
User=root
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=DOTNET_PRINT_TELEMETRY_MESSAGE=false

[Install]
WantedBy=multi-user.target