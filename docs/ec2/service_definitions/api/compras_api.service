[Unit]
Description= Compras Api - Acontplus
After=network.target

[Service]
WorkingDirectory=/home/acontplus/services/compras_api
ExecStart=/usr/bin/dotnet /home/acontplus/services/compras_api/Compras.API.dll
Restart=always
RestartSec=10
KillSignal=SIGINT
SyslogIdentifier=dotnet-compras-api
User=root
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=DOTNET_PRINT_TELEMETRY_MESSAGE=false

[Install]
WantedBy=multi-user.target