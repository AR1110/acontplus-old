[Unit]
Description= Technical Support Api - Acontplus
After=network.target

[Service]
WorkingDirectory=/home/acontplus/services/tech_support_api
ExecStart=/usr/bin/dotnet /home/acontplus/services/tech_support_api/TechnicalSupport.API.dll
Restart=always
RestartSec=10
KillSignal=SIGINT
SyslogIdentifier=dotnet-tech-support-api
User=root
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=DOTNET_PRINT_TELEMETRY_MESSAGE=false
Environment=ASPNETCORE_URLS=http://0.0.0.0:5012

[Install]
WantedBy=multi-user.target