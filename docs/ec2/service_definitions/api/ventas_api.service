[Unit]
Description= Ventas Api - Acontplus
After=network.target

[Service]
WorkingDirectory=/home/acontplus/services/ventas_api
ExecStart=/usr/bin/dotnet /home/acontplus/services/ventas_api/Ventas.API.dll
Restart=always
RestartSec=10
KillSignal=SIGINT
SyslogIdentifier=dotnet-ventas-api
User=root
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=DOTNET_PRINT_TELEMETRY_MESSAGE=false

[Install]
WantedBy=multi-user.target