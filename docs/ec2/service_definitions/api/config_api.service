[Unit]
Description= Configuracion Api - Acontplus
After=network.target

[Service]
WorkingDirectory=/home/acontplus/services/config_api
ExecStart=/usr/bin/dotnet /home/acontplus/services/config_api/Configuracion.API.dll
Restart=always
RestartSec=10
KillSignal=SIGINT
SyslogIdentifier=dotnet-config-api
User=root
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=DOTNET_PRINT_TELEMETRY_MESSAGE=false

[Install]
WantedBy=multi-user.target