[Unit]
Description= Identity Api - Acontplus
After=network.target

[Service]
WorkingDirectory=/home/acontplus/services/identity_api
ExecStart=/usr/bin/dotnet /home/acontplus/services/identity_api/Identity.API.dll
Restart=always
RestartSec=10
KillSignal=SIGINT
SyslogIdentifier=dotnet-identity-api
User=root
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=DOTNET_PRINT_TELEMETRY_MESSAGE=false

[Install]
WantedBy=multi-user.target