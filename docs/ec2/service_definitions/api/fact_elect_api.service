[Unit]
After=network.target
Description= Facturación Api - Acontplus

[Service]
WorkingDirectory=/home/acontplus/services/fact_elect_api
ExecStart=/usr/bin/dotnet /home/acontplus/services/fact_elect_api/FactElect.API.dll
Restart=always
RestartSec=10
KillSignal=SIGINT
SyslogIdentifier=dotnet-fact-elect-api
User=root
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=DOTNET_PRINT_TELEMETRY_MESSAGE=false
Environment=ASPNETCORE_URLS=http://0.0.0.0:5006

[Install]
WantedBy=multi-user.target