[Unit]
Description= Restaurant Web App - Acontplus
After=network.target

[Service]
WorkingDirectory=/home/acontplus/web_apps/restaurant
ExecStart=/usr/bin/dotnet /home/acontplus/web_apps/restaurant/Restaurant.Api.dll
Restart=always
RestartSec=10
KillSignal=SIGINT
SyslogIdentifier=dotnet-restaurant-api
User=root
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=DOTNET_PRINT_TELEMETRY_MESSAGE=false
Environment=ASPNETCORE_URLS=http://0.0.0.0:5011

[Install]
WantedBy=multi-user.target