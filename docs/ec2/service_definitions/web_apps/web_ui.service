[Unit]
Description= Acontplus Web App
After=network.target

[Service]
WorkingDirectory=/home/acontplus/web_apps/web_ui
ExecStart=/usr/bin/dotnet /home/acontplus/web_apps/web_ui/WebUI.dll
Restart=always
RestartSec=10
KillSignal=SIGINT
SyslogIdentifier=dotnet-web-ui
User=root
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=DOTNET_PRINT_TELEMETRY_MESSAGE=false
Environment=ASPNETCORE_URLS=http://0.0.0.0:5000

[Install]
WantedBy=multi-user.target