[Unit]
Description= Demo Web App - Acontplus
After=network.target

[Service]
WorkingDirectory=/home/acontplus/web_apps/demo
ExecStart=/usr/bin/dotnet /home/acontplus/services/web_apps/demo/Demo.Api.dll
Restart=always
RestartSec=10
KillSignal=SIGINT
SyslogIdentifier=dotnet-demo-api
User=root
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=DOTNET_PRINT_TELEMETRY_MESSAGE=false

[Install]
WantedBy=multi-user.target