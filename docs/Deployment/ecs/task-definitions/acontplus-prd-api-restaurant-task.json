{
  "family": "acontplus-prd-api-restaurant-task",
  "executionRoleArn": "arn:aws:iam::{ACCOUNT_ID}:role/acontplus-prd-ecs-task-role",
  "taskRoleArn": "arn:aws:iam::{ACCOUNT_ID}:role/acontplus-prd-ecs-task-role",
  "networkMode": "awsvpc",
  "containerDefinitions": [
    {
      "name": "acontplus-api-restaurant",
      "image": "{ACCOUNT_ID}.dkr.ecr.us-east-1.amazonaws.com/acontplus-api-restaurant:{ENV}-latest",
      "portMappings": [
        {
          "name": "acontplus-api-restaurant",
          "containerPort": 8080,
          "hostPort": 8080,
          "protocol": "tcp",
          "appProtocol": "http"
        }
      ],
      "environment": [
        {
          "name": "ASPNETCORE__ENVIRONMENT",
          "value": "${ENVIRONMENT}"
        },
        {
          "name": "AllowedCorsOrigins",
          "value": "http://localhost,http://localhost:8000,https://restaurant.acontplus.com,https://acontplus.com"
        },
        {
          "name": "S3Bucket__Name",
          "value": "acontplus-prd-str-uploads-s3"
        },
        {
          "name": "S3Bucket__Region",
          "value": "us-east-1"
        }
      ],
      "secrets": [
        {
          "name": "JwtSettings__SecurityKey",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:{ACCOUNT_ID}:secret:acontplus/prd/auth/jwt-secret"
        },
        {
          "name": "ConnectionStrings__DefaultConnection",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:{ACCOUNT_ID}:secret:acontplus/prd/db/main/connection-string"
        },
        {
          "name": "AwsConfiguration__AWSAccessKey",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:{ACCOUNT_ID}:secret:acontplus/prd/aws/access-key"
        },
        {
          "name": "AwsConfiguration__AWSSecretKey",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:{ACCOUNT_ID}:secret:acontplus/prd/aws/secret-key"
        }
      ],
      "essential": true,
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-region": "us-east-1",
          "awslogs-create-group": "true",
          "awslogs-group": "/acontplus/prd/api/restaurant",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ],
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "256",
  "memory": "512"
}
