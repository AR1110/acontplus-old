{
  "family": "acontplus-prd-api-identity-task",
  "executionRoleArn": "arn:aws:iam::{ACCOUNT_ID}:role/acontplus-prd-ecs-task-role",
  "taskRoleArn": "arn:aws:iam::{ACCOUNT_ID}:role/acontplus-prd-ecs-task-role",
  "networkMode": "awsvpc",
  "containerDefinitions": [
    {
      "name": "acontplus-api-identity",
      "image": "{ACCOUNT_ID}.dkr.ecr.us-east-1.amazonaws.com/acontplus-api-identity:{ENV}-latest",
      "portMappings": [
        {
          "name": "acontplus-api-identity",
          "containerPort": 8080,
          "hostPort": 8080,
          "protocol": "tcp",
          "appProtocol": "http"
        }
      ],
      "environment": [
        {
          "name": "ASPNETCORE__ENVIRONMENT",
          "value": "${ENVIRONMENT}"
        },
        {
          "name": "JwtSettings__ExpirationInMinutes",
          "value": "900"
        },
        {
          "name": "TokenCleanup__CheckInterval",
          "value": "60"
        },
        {
          "name": "TokenCleanup__TopExpiredTokens",
          "value": "50"
        }
      ],
      "secrets": [
        {
          "name": "JwtSettings__SecurityKey",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:{ACCOUNT_ID}:secret:acontplus/prd/auth/jwt-secret"
        },
        {
          "name": "ConnectionStrings__DefaultConnection",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:{ACCOUNT_ID}:secret:acontplus/prd/db/main/connection-string"
        },
        {
          "name": "ApiGateways__Acontplus",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:{ACCOUNT_ID}:secret:acontplus/prd/api-gateway/url"
        }
      ],
      "essential": true,
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-region": "us-east-1",
          "awslogs-create-group": "true",
          "awslogs-group": "/acontplus/prd/api/identity",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ],
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "256",
  "memory": "512"
}
