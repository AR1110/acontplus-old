{
  "family": "acontplus-prd-gtw-ocelot-task",
  "executionRoleArn": "arn:aws:iam::{ACCOUNT_ID}:role/acontplus-prd-ecs-task-role",
  "taskRoleArn": "arn:aws:iam::{ACCOUNT_ID}:role/acontplus-prd-ecs-task-role",
  "networkMode": "awsvpc",
  "containerDefinitions": [
    {
      "name": "acontplus-gtw-ocelot",
      "image": "{ACCOUNT_ID}.dkr.ecr.us-east-1.amazonaws.com/acontplus-gtw-ocelot:{ENV}-latest",
      "portMappings": [
        {
          "name": "acontplus-gtw-ocelot",
          "containerPort": 8080,
          "hostPort": 8080,
          "protocol": "tcp",
          "appProtocol": "http"
        }
      ],
      "environment": [
        {
          "name": "ASPNETCORE__ENVIRONMENT",
          "value": "${ENVIRONMENT}"
        },
        {
          "name": "SafeOrigins",
          "value": "https://app.acontplus.com,https://client.acontplus.com,https://demo.acontplus.com,https://admin.acontplus.com,https://invoice.acontplus.com,https://restaurant.acontplus.com,http://localhost:7166,http://localhost:4200"
        },
        {
          "name": "JwtSettings__ExpirationInMinutes",
          "value": "${ACONTPLUS_JWT_SETTINGS_EXPIRATION_IN_MINUTES}"
        }
      ],
      "secrets": [
        {
          "name": "JwtSettings__SecurityKey",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:{ACCOUNT_ID}:secret:acontplus/prd/auth/jwt-secret"
        }
      ],
      "essential": true,
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-region": "us-east-1",
          "awslogs-create-group": "true",
          "awslogs-group": "/acontplus/prd/gtw/ocelot",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ],
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "512",
  "memory": "1024"
}
