{
  "family": "acontplus-services-identity-api",
  "executionRoleArn": "arn:aws:iam::866150703026:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::866150703026:role/ecsTaskRole",
  "networkMode": "awsvpc",
  "containerDefinitions": [
    {
      "name": "identity-api",
      "image": "866150703026.dkr.ecr.us-east-1.amazonaws.com/identity-api:latest",
      "portMappings": [
        {
          "name": "identity-api",
          "containerPort": 8080,
          "hostPort": 8080,
          "protocol": "tcp",
          "appProtocol": "http"
        }
      ],
      "environment": [
        {
          "name": "ASPNETCORE__ENVIRONMENT",
          "value": "${ENVIRONMENT}"
        },
        {
          "name": "JwtSettings__ExpirationInMinutes",
          "value": "900"
        },
        {
          "name": "TokenCleanup__CheckInterval",
          "value": "60"
        },
        {
          "name": "TokenCleanup__TopExpiredTokens",
          "value": "50"
        }
      ],
      "secrets": [
        {
          "name": "JwtSettings__SecurityKey",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:866150703026:secret:ACONTPLUS_JWT_SETTINGS_SECURITY_KEY-ekCllZ"
        },
        {
          "name": "ConnectionStrings__DefaultConnection",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:866150703026:secret:ACONTPLUS_CONN_STRING_PRD-sw4due"
        },
        {
          "name": "ApiGateways__Acontplus",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:866150703026:secret:ACONTPLUS_API_GATEWAY_PRD-CoHQu7"
        }
      ],
      "essential": true,
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-region": "us-east-1",
          "awslogs-create-group": "true",
          "awslogs-group": "/ecs/acontplus-services-identity-api",
          "awslogs-stream-prefix": "identity-api"
        }
      }
    }
  ],
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "256",
  "memory": "512"
}
