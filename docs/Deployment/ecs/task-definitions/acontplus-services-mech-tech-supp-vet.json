{
  "family": "acontplus-services-mech-tech-supp-vet",
  "executionRoleArn": "arn:aws:iam::866150703026:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::866150703026:role/ecsTaskRole",
  "networkMode": "awsvpc",
  "containerDefinitions": [
    {
      "name": "mechanical-api",
      "image": "866150703026.dkr.ecr.us-east-1.amazonaws.com/mechanical-api:latest",
      "portMappings": [
        {
          "name": "mechanical-api",
          "containerPort": 8000,
          "hostPort": 8000,
          "protocol": "tcp",
          "appProtocol": "http"
        }
      ],
      "environment": {
        "name": "ASPNETCORE__ENVIRONMENT",
        "value": "${ENVIRONMENT}"
      },
      "secrets": [
        {
          "name": "JwtSettings__SecurityKey",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:866150703026:secret:ACONTPLUS_JWT_SETTINGS_SECURITY_KEY-ekCllZ"
        },
        {
          "name": "ConnectionStrings__DefaultConnection",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:866150703026:secret:ACONTPLUS_CONN_STRING_PRD-sw4due"
        }
      ],
      "essential": true,
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-region": "us-east-1",
          "awslogs-create-group": "true",
          "awslogs-group": "/ecs/acontplus-services-mechanical-api",
          "awslogs-stream-prefix": "mechanical-api"
        }
      }
    },
    {
      "name": "tech-support-api",
      "image": "866150703026.dkr.ecr.us-east-1.amazonaws.com/tech-support-api:latest",
      "portMappings": [
        {
          "name": "tech-support-api",
          "containerPort": 8001,
          "hostPort": 8001,
          "protocol": "tcp",
          "appProtocol": "http"
        }
      ],
      "environment": {
        "name": "ASPNETCORE__ENVIRONMENT",
        "value": "${ENVIRONMENT}"
      },
      "secrets": [
        {
          "name": "JwtSettings__SecurityKey",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:866150703026:secret:ACONTPLUS_JWT_SETTINGS_SECURITY_KEY-ekCllZ"
        },
        {
          "name": "ConnectionStrings__DefaultConnection",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:866150703026:secret:ACONTPLUS_CONN_STRING_PRD-sw4due"
        }
      ],
      "essential": true,
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-region": "us-east-1",
          "awslogs-create-group": "true",
          "awslogs-group": "/ecs/acontplus-services-tech-support-api",
          "awslogs-stream-prefix": "tech-support-api"
        }
      }
    },
    {
      "name": "vet-api",
      "image": "866150703026.dkr.ecr.us-east-1.amazonaws.com/vet-api:latest",
      "portMappings": [
        {
          "name": "vet-api",
          "containerPort": 8002,
          "hostPort": 8002,
          "protocol": "tcp",
          "appProtocol": "http"
        }
      ],
      "environment": {
        "name": "ASPNETCORE__ENVIRONMENT",
        "value": "${ENVIRONMENT}"
      },
      "secrets": [
        {
          "name": "JwtSettings__SecurityKey",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:866150703026:secret:ACONTPLUS_JWT_SETTINGS_SECURITY_KEY-ekCllZ"
        },
        {
          "name": "ConnectionStrings__DefaultConnection",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:866150703026:secret:ACONTPLUS_CONN_STRING_PRD-sw4due"
        }
      ],
      "essential": true,
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-region": "us-east-1",
          "awslogs-create-group": "true",
          "awslogs-group": "/ecs/acontplus-services-mech-tech-supp-vet",
          "awslogs-stream-prefix": "vet-api"
        }
      }
    }
  ],
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "256",
  "memory": "512"
}
