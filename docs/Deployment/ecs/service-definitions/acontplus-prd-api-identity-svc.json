{
  "cluster": "acontplus-prd-ecs",
  "deploymentConfiguration": {
    "maximumPercent": 200,
    "minimumHealthyPercent": 50
  },
  "deploymentController": {
    "type": "ECS"
  },
  "desiredCount": 1,
  "enableECSManagedTags": true,
  "enableExecuteCommand": true,
  "launchType": "FARGATE",
  "networkConfiguration": {
    "awsvpcConfiguration": {
      "assignPublicIp": "ENABLED",
      "securityGroups": ["sg-0b97cddbc968046e6"],
      "subnets": [
        "subnet-0b9c5c1185466f2c8",
        "subnet-07500f3abec27f804"
      ]
    }
  },
  "platformVersion": "LATEST",
  "propagateTags": "SERVICE",
  "serviceName": "acontplus-prd-api-identity-svc",
  "serviceConnectConfiguration": {
    "enabled": true,
    "services": [
      {
        "portName": "acontplus-api-identity",
        "clientAliases": [
          {
            "port": 80
          }
        ]
      }
    ],
    "logConfiguration": {
      "logDriver": "awslogs",
      "options": {
        "awslogs-create-group": "true",
        "awslogs-group": "/acontplus/prd/api/identity",
        "awslogs-region": "us-east-1",
        "awslogs-stream-prefix": "ecs"
      }
    }
  },
  "taskDefinition": "acontplus-prd-api-identity-task"
}
