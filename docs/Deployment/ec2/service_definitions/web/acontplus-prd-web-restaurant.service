[Unit]
Description=AcontPlus Restaurant Web - Production
After=network.target

[Service]
WorkingDirectory=/home/acontplus/services/acontplus-web-restaurant
ExecStart=/usr/bin/dotnet /home/acontplus/services/acontplus-web-restaurant/WebRestaurant.dll
Restart=always
RestartSec=10
KillSignal=SIGINT
SyslogIdentifier=acontplus-web-restaurant
User=acontplus
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=DOTNET_PRINT_TELEMETRY_MESSAGE=false
Environment=ASPNETCORE_URLS=http://0.0.0.0:8001

[Install]
WantedBy=multi-user.target
