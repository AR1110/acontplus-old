[Unit]
Description=AcontPlus Invoice Web - Production
After=network.target

[Service]
WorkingDirectory=/home/acontplus/services/acontplus-web-invoice
ExecStart=/usr/bin/dotnet /home/acontplus/services/acontplus-web-invoice/WebInvoice.dll
Restart=always
RestartSec=10
KillSignal=SIGINT
SyslogIdentifier=acontplus-web-invoice
User=acontplus
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=DOTNET_PRINT_TELEMETRY_MESSAGE=false
Environment=ASPNETCORE_URLS=http://0.0.0.0:8002

[Install]
WantedBy=multi-user.target
