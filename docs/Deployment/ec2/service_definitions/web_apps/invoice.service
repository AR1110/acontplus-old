[Unit]
Description= Invoice Web App - Acontplus
After=network.target

[Service]
WorkingDirectory=/home/acontplus/web_apps/invoice
ExecStart=/usr/bin/dotnet /home/acontplus/web_apps/invoice/Invoice.Api.dll
Restart=always
RestartSec=10
KillSignal=SIGINT
SyslogIdentifier=dotnet-invoice-api
User=root
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=DOTNET_PRINT_TELEMETRY_MESSAGE=false
Environment=ASPNETCORE_URLS=http://0.0.0.0:8003

[Install]
WantedBy=multi-user.target