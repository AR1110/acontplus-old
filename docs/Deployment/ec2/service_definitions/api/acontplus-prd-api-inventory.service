[Unit]
Description=AcontPlus Inventory API - Production
After=network.target

[Service]
WorkingDirectory=/home/acontplus/services/acontplus-api-inventory
ExecStart=/usr/bin/dotnet /home/acontplus/services/acontplus-api-inventory/Inventory.Api.dll
Restart=always
RestartSec=10
KillSignal=SIGINT
SyslogIdentifier=acontplus-api-inventory
User=acontplus
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=DOTNET_PRINT_TELEMETRY_MESSAGE=false
Environment=ASPNETCORE_URLS=http://0.0.0.0:5008

[Install]
WantedBy=multi-user.target
