[Unit]
Description=AcontPlus Mechanical API - Production
After=network.target

[Service]
WorkingDirectory=/home/acontplus/services/acontplus-api-mechanical
ExecStart=/usr/bin/dotnet /home/acontplus/services/acontplus-api-mechanical/Mechanical.Api.dll
Restart=always
RestartSec=10
KillSignal=SIGINT
SyslogIdentifier=acontplus-api-mechanical
User=acontplus
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=DOTNET_PRINT_TELEMETRY_MESSAGE=false
Environment=ASPNETCORE_URLS=http://0.0.0.0:5009

[Install]
WantedBy=multi-user.target
