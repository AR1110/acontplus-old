[Unit]
Description= BarberShop Api - Acontplus
After=network.target

[Service]
WorkingDirectory=/home/acontplus/services/barber_shop_api
ExecStart=/usr/bin/dotnet /home/acontplus/services/barber_shop_api/BarberShop.Api.dll
Restart=always
RestartSec=10
KillSignal=SIGINT
SyslogIdentifier=dotnet-barber-shop-api
User=root
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=DOTNET_PRINT_TELEMETRY_MESSAGE=false
Environment=ASPNETCORE_URLS=http://0.0.0.0:5015

[Install]
WantedBy=multi-user.target