[Unit]
Description=AcontPlus Billing API - Production
After=network.target

[Service]
WorkingDirectory=/home/acontplus/services/acontplus-api-billing
ExecStart=/usr/bin/dotnet /home/acontplus/services/acontplus-api-billing/Billing.Api.dll
Restart=always
RestartSec=10
KillSignal=SIGINT
SyslogIdentifier=acontplus-api-billing
User=acontplus
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=DOTNET_PRINT_TELEMETRY_MESSAGE=false
Environment=ASPNETCORE_URLS=http://0.0.0.0:5003

[Install]
WantedBy=multi-user.target
