[Unit]
Description=AcontPlus Restaurant API - Production
After=network.target

[Service]
WorkingDirectory=/home/acontplus/services/acontplus-api-restaurant
ExecStart=/usr/bin/dotnet /home/acontplus/services/acontplus-api-restaurant/Restaurant.Api.dll
Restart=always
RestartSec=10
KillSignal=SIGINT
SyslogIdentifier=acontplus-api-restaurant
User=acontplus
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=DOTNET_PRINT_TELEMETRY_MESSAGE=false
Environment=ASPNETCORE_URLS=http://0.0.0.0:5011

[Install]
WantedBy=multi-user.target
