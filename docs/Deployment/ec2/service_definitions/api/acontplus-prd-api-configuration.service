[Unit]
Description=AcontPlus Configuration API - Production
After=network.target

[Service]
WorkingDirectory=/home/acontplus/services/acontplus-api-configuration
ExecStart=/usr/bin/dotnet /home/acontplus/services/acontplus-api-configuration/Configuration.Api.dll
Restart=always
RestartSec=10
KillSignal=SIGINT
SyslogIdentifier=acontplus-api-configuration
User=acontplus
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=DOTNET_PRINT_TELEMETRY_MESSAGE=false
Environment=ASPNETCORE_URLS=http://0.0.0.0:5006

[Install]
WantedBy=multi-user.target
