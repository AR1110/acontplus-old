[Unit]
Description=AcontPlus Sales API - Production
After=network.target

[Service]
WorkingDirectory=/home/acontplus/services/acontplus-api-sales
ExecStart=/usr/bin/dotnet /home/acontplus/services/acontplus-api-sales/Sales.Api.dll
Restart=always
RestartSec=10
KillSignal=SIGINT
SyslogIdentifier=acontplus-api-sales
User=acontplus
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=DOTNET_PRINT_TELEMETRY_MESSAGE=false
Environment=ASPNETCORE_URLS=http://0.0.0.0:5013

[Install]
WantedBy=multi-user.target
