[Unit]
Description=AcontPlus Common API - Production
After=network.target

[Service]
WorkingDirectory=/home/acontplus/services/acontplus-api-common
ExecStart=/usr/bin/dotnet /home/acontplus/services/acontplus-api-common/Common.Api.dll
Restart=always
RestartSec=10
KillSignal=SIGINT
SyslogIdentifier=acontplus-api-common
User=acontplus
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=DOTNET_PRINT_TELEMETRY_MESSAGE=false
Environment=ASPNETCORE_URLS=http://0.0.0.0:5004

[Install]
WantedBy=multi-user.target
