[Unit]
Description=AcontPlus Accounting API - Production
After=network.target

[Service]
WorkingDirectory=/home/acontplus/services/acontplus-api-accounting
ExecStart=/usr/bin/dotnet /home/acontplus/services/acontplus-api-accounting/Accounting.Api.dll
Restart=always
RestartSec=10
KillSignal=SIGINT
SyslogIdentifier=acontplus-api-accounting
User=acontplus
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=DOTNET_PRINT_TELEMETRY_MESSAGE=false
Environment=ASPNETCORE_URLS=http://0.0.0.0:5005

[Install]
WantedBy=multi-user.target
