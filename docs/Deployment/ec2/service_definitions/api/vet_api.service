[Unit]
Description= Veterianaria Api - Acontplus
After=network.target

[Service]
WorkingDirectory=/home/acontplus/services/vet_api
ExecStart=/usr/bin/dotnet /home/acontplus/services/vet_api/Vet.API.dll
Restart=always
RestartSec=10
KillSignal=SIGINT
SyslogIdentifier=dotnet-vet-api
User=root
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=DOTNET_PRINT_TELEMETRY_MESSAGE=false
Environment=ASPNETCORE_URLS=http://0.0.0.0:5014

[Install]
WantedBy=multi-user.target