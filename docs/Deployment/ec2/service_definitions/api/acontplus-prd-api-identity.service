[Unit]
Description=AcontPlus Identity API - Production
After=network.target

[Service]
WorkingDirectory=/home/acontplus/services/acontplus-api-identity
ExecStart=/usr/bin/dotnet /home/acontplus/services/acontplus-api-identity/Identity.Api.dll
Restart=always
RestartSec=10
KillSignal=SIGINT
SyslogIdentifier=acontplus-api-identity
User=acontplus
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=DOTNET_PRINT_TELEMETRY_MESSAGE=false
Environment=ASPNETCORE_URLS=http://0.0.0.0:5007

[Install]
WantedBy=multi-user.target
