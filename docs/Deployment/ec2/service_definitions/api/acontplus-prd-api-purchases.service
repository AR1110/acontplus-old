[Unit]
Description=AcontPlus Purchases API - Production
After=network.target

[Service]
WorkingDirectory=/home/acontplus/services/acontplus-api-purchases
ExecStart=/usr/bin/dotnet /home/acontplus/services/acontplus-api-purchases/Purchases.Api.dll
Restart=always
RestartSec=10
KillSignal=SIGINT
SyslogIdentifier=acontplus-api-purchases
User=acontplus
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=DOTNET_PRINT_TELEMETRY_MESSAGE=false
Environment=ASPNETCORE_URLS=http://0.0.0.0:5010

[Install]
WantedBy=multi-user.target
