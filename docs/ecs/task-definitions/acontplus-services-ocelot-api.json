{
  "family": "acontplus-services-ocelot-api",
  "executionRoleArn": "arn:aws:iam::866150703026:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::866150703026:role/ecsTaskRole",
  "networkMode": "awsvpc",
  "containerDefinitions": [
    {
      "name": "ocelot-api",
      "image": "866150703026.dkr.ecr.us-east-1.amazonaws.com/ocelot-api:latest",
      "portMappings": [
        {
          "name": "ocelot-api",
          "containerPort": 8080,
          "hostPort": 8080,
          "protocol": "tcp",
          "appProtocol": "http"
        }
      ],
      "environment": [
        {
          "name": "ASPNETCORE__ENVIRONMENT",
          "value": "${ENVIRONMENT}"
        },
        {
          "name": "SafeOrigins",
          "value": "https://app.acontplus.com,https://client.acontplus.com,https://demo.acontplus.com,https://admin.acontplus.com,https://invoice.acontplus.com,https://restaurant.acontplus.com,http://localhost:7166,http://localhost:4200"
        },
        {
          "name": "JwtSettings__ExpirationInMinutes",
          "value": "${ACONTPLUS_JWT_SETTINGS_EXPIRATION_IN_MINUTES}"
        }
      ],
      "secrets": {
        "name": "JwtSettings__SecurityKey",
        "valueFrom": "arn:aws:secretsmanager:us-east-1:866150703026:secret:ACONTPLUS_JWT_SETTINGS_SECURITY_KEY-ekCllZ"
      },
      "essential": true,
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-region": "us-east-1",
          "awslogs-create-group": "true",
          "awslogs-group": "/ecs/acontplus-services-ocelot-api",
          "awslogs-stream-prefix": "ocelot-api"
        }
      }
    }
  ],
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "512",
  "memory": "1024"
}
