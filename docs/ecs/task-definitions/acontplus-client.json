{
  "family": "acontplus-client",
  "executionRoleArn": "arn:aws:iam::866150703026:role/ecsTaskExecutionRole",
  "networkMode": "awsvpc",
  "containerDefinitions": [
    {
      "name": "acontplus-client",
      "image": "866150703026.dkr.ecr.us-east-1.amazonaws.com/acontplus-client:latest",
      "portMappings": [
        {
          "name": "acontplus-client",
          "containerPort": 80,
          "hostPort": 80,
          "protocol": "tcp",
          "appProtocol": "http"
        }
      ],
      "essential": true,
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-region": "us-east-1",
          "awslogs-create-group": "true",
          "awslogs-group": "/ecs/acontplus-client",
          "awslogs-stream-prefix": "acontplus-client"
        }
      }
    }
  ],
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512"
}
