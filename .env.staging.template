# ══════════════════════════════════════════════════════════════════════════════
# AcontPlus - Staging Environment Configuration Template
# ══════════════════════════════════════════════════════════════════════════════
#
# Instructions:
#   1. Copy this file to .env.staging
#   2. Replace placeholder values with actual staging environment values
#   3. DO NOT commit .env.staging to version control (add to .gitignore)
#
# Usage:
#   docker-compose -f docker-compose.yml -f docker-compose.staging.yml --env-file .env.staging up -d
# ══════════════════════════════════════════════════════════════════════════════

# ──────────────────────────────────────────────────────────────────────────────
# General Configuration
# ──────────────────────────────────────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Staging
RESTART_POLICY=unless-stopped

# ──────────────────────────────────────────────────────────────────────────────
# Database Connection
# ──────────────────────────────────────────────────────────────────────────────
# SQL Server connection string for staging database
CONNECTION_STRING=Server=your-staging-server;Database=AcontPlus_Staging;User Id=your-user;Password=your-password;TrustServerCertificate=True;MultipleActiveResultSets=true

# ──────────────────────────────────────────────────────────────────────────────
# Logging Configuration
# ──────────────────────────────────────────────────────────────────────────────
LOG_LEVEL=Information
LOG_PATH=/app/logs/log-.txt
ENABLE_LOCAL_FILE_LOGGING=true

# Docker logging driver settings
LOG_DRIVER=json-file
LOG_MAX_SIZE=20m
LOG_MAX_FILE=5

# ──────────────────────────────────────────────────────────────────────────────
# Gateway & CORS Configuration
# ──────────────────────────────────────────────────────────────────────────────
GATEWAY_PORT=80
# Comma-separated list of allowed origins for CORS
SAFE_ORIGINS=http://localhost:4200,http://staging.yourcompany.com,https://staging.yourcompany.com

# ──────────────────────────────────────────────────────────────────────────────
# Service URLs (Internal Docker Network)
# ──────────────────────────────────────────────────────────────────────────────
# Use internal docker service names or external URLs as needed
SERVICE_URL_IDENTITY=http://identity.api:8080
SERVICE_URL_ACCOUNTING=http://accounting.api:8080
SERVICE_URL_BILLING=http://billing.api:8080
SERVICE_URL_SALES=http://sales.api:8080
SERVICE_URL_INVENTORY=http://inventory.api:8080
SERVICE_URL_PURCHASES=http://purchases.api:8080
SERVICE_URL_COMMON=http://common.api:8080
SERVICE_URL_CONFIGURATION=http://configuration.api:8080
SERVICE_URL_RESTAURANT=http://restaurant.api:8080
SERVICE_URL_MECHANICAL=http://mechanical.api:8080
SERVICE_URL_VET=http://vet.api:8080
SERVICE_URL_BARBERSHOP=http://barbershop.api:8080
SERVICE_URL_TECHSUPPORT=http://technicalsupport.api:8080

# ──────────────────────────────────────────────────────────────────────────────
# Resource Limits
# ──────────────────────────────────────────────────────────────────────────────
CPU_LIMIT=1.5
MEMORY_LIMIT=512M
