{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/AcontPlus.sln", // <--- THIS IS KEY!
        "--nologo",
        "--tl:off",
        "--property:GenerateFullPaths=true",
        "--property:BuildInParallel=true",
        "/clp:Summary;Verbosity=minimal",
        "/maxcpucount"
      ],
      "problemMatcher": "$msCompile",
      "group": { "kind": "build", "isDefault": true },
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "showReuseMessage": false
      },
      "options": {
        "env": {
          "DOTNET_CLI_TELEMETRY_OPTOUT": "1",
          "DOTNET_SKIP_FIRST_TIME_EXPERIENCE": "1"
        }
      }
    },
    {
      "label": "publish (optimized)",
      "command": "dotnet",
      "type": "process",
      "args": [
        "publish",
        "${workspaceFolder}/AcontPlus.sln",
        "--nologo",
        "--configuration Release",
        "--property:PublishReadyToRun=true",
        "--property:PublishTrimmed=true",
        "--property:EnableCompressionInSingleFile=true",
        "--self-contained false",
        "--logger:\"Console;Summary;Verbosity=minimal\""
      ],
      "problemMatcher": "$msCompile",
      "presentation": {
        "reveal": "always",
        "panel": "new" // Always new panel to avoid output mixing
      }
    },
    {
      "label": "watch (hot reload)",
      "command": "dotnet",
      "type": "process",
      "args": [
        "watch",
        "--project",
        "${workspaceFolder}/AcontPlus.sln",
        "--non-interactive",
        "--nologo",
        "--property:HotReloadEnabled=true",
        "--property:HotReloadProfile=aspnetcore"
      ],
      "problemMatcher": "$msCompile",
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "options": {
        "env": {
          "ASPNETCORE_ENVIRONMENT": "Development",
          "DOTNET_WATCH_SUPPRESS_LAUNCH_BROWSER": "true"
        }
      }
    },
    {
      "label": "clean (aggressive)",
      "command": "dotnet",
      "type": "process",
      "args": ["clean", "${workspaceFolder}/AcontPlus.sln", "--nologo", "--verbosity minimal", "/t:Clean"],
      "problemMatcher": "$msCompile",
      "presentation": {
        "echo": false,
        "reveal": "never"
      }
    },
    {
      "label": "restore (full)",
      "command": "dotnet",
      "type": "process",
      "args": [
        "restore",
        "${workspaceFolder}/AcontPlus.sln",
        "--disable-parallel", // More reliable for large solutions
        "--force-evaluate", // Force reevaluation of packages
        "--verbosity minimal"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "docker-compose: up",
      "type": "shell",
      "command": "docker-compose up -d",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "group": "build"
    },
    {
      "label": "docker-compose: down",
      "type": "shell",
      "command": "docker-compose down",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    }
  ]
}
