{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}\\AcontPlus.sln",
        "--nologo",
        "--tl:off",
        "--property:GenerateFullPaths=true",
        "--property:UseSharedCompilation=false",
        "--property:BuildInParallel=true",
        "/clp:Summary;Verbosity=minimal",
        "/maxcpucount"
      ],
      "problemMatcher": "$msCompile",
      "group": { "kind": "build", "isDefault": true },
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "showReuseMessage": false
      },
      "options": {
        "env": {
          "DOTNET_CLI_TELEMETRY_OPTOUT": "1",
          "DOTNET_SKIP_FIRST_TIME_EXPERIENCE": "1"
        }
      }
    },
    {
      "label": "build-specific",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${input:projectPath}",
        "--nologo",
        "--configuration",
        "Debug",
        "--verbosity",
        "minimal"
      ],
      "problemMatcher": "$msCompile",
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated"
      }
    },
    {
      "label": "restore",
      "command": "dotnet",
      "type": "process",
      "args": [
        "restore",
        "${workspaceFolder}\\AcontPlus.sln",
        "--disable-parallel",
        "--force-evaluate",
        "--verbosity",
        "minimal"
      ],
      "problemMatcher": "$msCompile",
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated"
      }
    },
    {
      "label": "clean",
      "command": "dotnet",
      "type": "process",
      "args": [
        "clean",
        "${workspaceFolder}\\AcontPlus.sln",
        "--nologo",
        "--verbosity",
        "minimal"
      ],
      "problemMatcher": "$msCompile",
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated"
      }
    },
    {
      "label": "watch",
      "command": "dotnet",
      "type": "process",
      "args": [
        "watch",
        "--project",
        "${input:projectPath}",
        "--non-interactive",
        "--nologo"
      ],
      "problemMatcher": "$msCompile",
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "options": {
        "env": {
          "ASPNETCORE_ENVIRONMENT": "Development",
          "DOTNET_WATCH_SUPPRESS_LAUNCH_BROWSER": "true"
        }
      }
    },
    {
      "label": "npm-install-client",
      "type": "shell",
      "command": "npm",
      "args": ["install"],
      "options": {
        "cwd": "${workspaceFolder}\\src\\WebApps\\client"
      },
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "npm-start-client",
      "type": "shell",
      "command": "npm",
      "args": ["run", "start"],
      "options": {
        "cwd": "${workspaceFolder}\\src\\WebApps\\client"
      },
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "npm-install-backoffice",
      "type": "shell",
      "command": "npm",
      "args": ["install"],
      "options": {
        "cwd": "${workspaceFolder}\\src\\WebApps\\backoffice"
      },
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "docker-compose-up",
      "type": "shell",
      "command": "docker-compose",
      "args": ["up", "--build", "-d"],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "docker-compose-down",
      "type": "shell",
      "command": "docker-compose",
      "args": ["down"],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    }
  ],
  "inputs": [
    {
      "id": "projectPath",
      "description": "Selecciona el proyecto a compilar",
      "type": "pickString",
      "options": [
        "${workspaceFolder}\\src\\Services\\Identity\\Identity.API\\Identity.API.csproj",
        "${workspaceFolder}\\src\\Services\\Common\\Common.API\\Common.API.csproj",
        "${workspaceFolder}\\src\\Services\\Configuracion\\Configuracion.API\\Configuracion.API.csproj",
        "${workspaceFolder}\\src\\Services\\Configuration\\Configuration.Api\\Configuration.Api.csproj",
        "${workspaceFolder}\\src\\Services\\Inventario\\Inventario.API\\Inventario.API.csproj",
        "${workspaceFolder}\\src\\Services\\Inventory\\Inventory.Api\\Inventory.Api.csproj",
        "${workspaceFolder}\\src\\Services\\Restaurant\\Restaurant.API\\Restaurant.API.csproj",
        "${workspaceFolder}\\src\\Services\\Facturacion\\FactElect.API\\FactElect.API.csproj",
        "${workspaceFolder}\\src\\Services\\Ventas\\Ventas.API\\Ventas.API.csproj",
        "${workspaceFolder}\\src\\Services\\Sales\\Sales.Api\\Sales.Api.csproj",
        "${workspaceFolder}\\src\\ApiGateways\\Ocelot.Api\\Ocelot.Api.csproj",
        "${workspaceFolder}\\src\\ApiGateways\\GatewayAcontplus.API\\GatewayAcontplus.API.csproj"
      ]
    }
  ]
}
