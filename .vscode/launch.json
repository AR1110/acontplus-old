    "version": "0.2.0",
    "configurations": [
        {
            "name": ".NET Core Launch (Frontend)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/src/WebApps/WebUI/bin/Debug/net6.0/WebUI.dll",
            "args": [],
            "cwd": "${workspaceFolder}/src/WebApps/WebUI",
            "stopAtEntry": false,
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
            },
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            },
            "sourceFileMap": {
                "/Views": "${workspaceFolder}/Views"
            },
            "justMyCode": false,
        },
