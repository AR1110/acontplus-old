# ══════════════════════════════════════════════════════════════════════════════
# AcontPlus - Production Environment Configuration Template
# ══════════════════════════════════════════════════════════════════════════════
#
# ⚠️  CRITICAL: Production environment configuration
#
# Instructions:
#   1. Copy this file to .env.production
#   2. Replace placeholder values with actual production environment values
#   3. DO NOT commit .env.production to version control (add to .gitignore)
#   4. Protect this file with appropriate permissions (chmod 600)
#   5. Use strong passwords and secure connection strings
#
# Usage:
#   docker-compose -f docker-compose.yml -f docker-compose.prod.yml --env-file .env.production up -d
# ══════════════════════════════════════════════════════════════════════════════

# ──────────────────────────────────────────────────────────────────────────────
# General Configuration
# ──────────────────────────────────────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Production
RESTART_POLICY=always

# ──────────────────────────────────────────────────────────────────────────────
# Database Connection
# ──────────────────────────────────────────────────────────────────────────────
# SQL Server connection string for production database
# ⚠️ SECURITY: Use strong passwords and secure connection methods
CONNECTION_STRING=Server=your-production-server;Database=AcontPlus_Production;User Id=your-user;Password=CHANGE-THIS-PASSWORD;TrustServerCertificate=False;Encrypt=True;MultipleActiveResultSets=true

# ──────────────────────────────────────────────────────────────────────────────
# Logging Configuration
# ──────────────────────────────────────────────────────────────────────────────
LOG_LEVEL=Warning
LOG_PATH=/app/logs/log-.txt
ENABLE_LOCAL_FILE_LOGGING=false

# Docker logging driver settings (more conservative in production)
LOG_DRIVER=json-file
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3

# ──────────────────────────────────────────────────────────────────────────────
# Gateway & CORS Configuration
# ──────────────────────────────────────────────────────────────────────────────
GATEWAY_PORT=80
# Comma-separated list of allowed origins for CORS
# ⚠️ SECURITY: Only include actual production domains
SAFE_ORIGINS=https://app.yourcompany.com,https://www.yourcompany.com

# ──────────────────────────────────────────────────────────────────────────────
# Service URLs (Internal Docker Network)
# ──────────────────────────────────────────────────────────────────────────────
# Use internal docker service names or external URLs as needed
SERVICE_URL_IDENTITY=http://identity.api:8080
SERVICE_URL_ACCOUNTING=http://accounting.api:8080
SERVICE_URL_BILLING=http://billing.api:8080
SERVICE_URL_SALES=http://sales.api:8080
SERVICE_URL_INVENTORY=http://inventory.api:8080
SERVICE_URL_PURCHASES=http://purchases.api:8080
SERVICE_URL_COMMON=http://common.api:8080
SERVICE_URL_CONFIGURATION=http://configuration.api:8080
SERVICE_URL_RESTAURANT=http://restaurant.api:8080
SERVICE_URL_MECHANICAL=http://mechanical.api:8080
SERVICE_URL_VET=http://vet.api:8080
SERVICE_URL_BARBERSHOP=http://barbershop.api:8080
SERVICE_URL_TECHSUPPORT=http://technicalsupport.api:8080

# ──────────────────────────────────────────────────────────────────────────────
# Resource Limits
# ──────────────────────────────────────────────────────────────────────────────
CPU_LIMIT=1
MEMORY_LIMIT=512M
