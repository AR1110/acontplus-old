    <PackageVersion Include="Acontplus.Infrastructure" Version="1.3.2" />
    <PackageVersion Include="Acontplus.Persistence.SqlServer" Version="2.0.5" />
    <PackageVersion Include="Acontplus.Logging" Version="1.2.2" />
    <PackageVersion Include="Acontplus.Notifications" Version="1.4.7" />
    <PackageVersion Include="Acontplus.S3Application" Version="1.2.4" />
    <PackageVersion Include="Acontplus.Services" Version="2.1.4" />
    <PackageVersion Include="Acontplus.Utilities" Version="2.0.4" />
    <PackageVersion Include="AspNetCore.HealthChecks.UI.Client" Version="9.0.0" />
    <PackageVersion Include="Humanizer" Version="3.0.1" />
    <PackageVersion Include="Mapster" Version="7.4.0" />
