<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Acontplus.Common.ApiDocumentation" Version="0.0.7" />
    <PackageVersion Include="Acontplus.Common.Core" Version="1.3.10" />
    <PackageVersion Include="Acontplus.Common.FactElect" Version="0.1.9" />
    <PackageVersion Include="Acontplus.Common.Infrastructure" Version="1.2.11" />
    <PackageVersion Include="Acontplus.Common.Logging" Version="0.1.6" />
    <PackageVersion Include="Acontplus.Common.Notifications" Version="0.1.18" />
    <PackageVersion Include="Acontplus.Common.Reports" Version="1.0.9" />
    <PackageVersion Include="Acontplus.Common.S3Application" Version="1.1.18" />
    <PackageVersion Include="Acontplus.Common.Services" Version="1.0.6" />
    <PackageVersion Include="AspNetCore.HealthChecks.UI.Client" Version="9.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="9.0.4" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" Version="9.0.4" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Razor.RuntimeCompilation" Version="9.0.4" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="9.0.4" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageVersion>
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Tools" Version="9.0.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageVersion>
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="9.0.4" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="9.0.4" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="9.0.4" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="9.0.4" />
    <PackageVersion Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.21.2" />
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageVersion Include="Ocelot" Version="24.0.0" />
    <PackageVersion Include="ReportViewerCore.NETCore" Version="15.1.26" />
    <PackageVersion Include="Scrutor" Version="6.0.1" />
  </ItemGroup>
</Project>