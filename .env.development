# Development Environment Variables
# This file is used automatically by docker-compose up
# Rename to .env for local development

COMPOSE_PROJECT_NAME=acontplus-dev

# Docker Registry (leave empty for local)
DOCKER_REGISTRY=

# Environment
ASPNETCORE_ENVIRONMENT=Development

# Gateway Port
GATEWAY_PORT=5000

# Logging Configuration
LOG_LEVEL=Information
LOG_PATH=/app/logs/log-.txt
ENABLE_LOCAL_FILE_LOGGING=true

# Service URLs (Docker network names)
SERVICE_URL_IDENTITY=http://identity.api:8080
SERVICE_URL_ACCOUNTING=http://accounting.api:8080
SERVICE_URL_BILLING=http://billing.api:8080
SERVICE_URL_SALES=http://sales.api:8080
SERVICE_URL_INVENTORY=http://inventory.api:8080
SERVICE_URL_PURCHASES=http://purchases.api:8080
SERVICE_URL_COMMON=http://common.api:8080
SERVICE_URL_CONFIGURATION=http://configuration.api:8080
SERVICE_URL_RESTAURANT=http://restaurant.api:8080
SERVICE_URL_MECHANICAL=http://mechanical.api:8080
SERVICE_URL_VET=http://vet.api:8080
SERVICE_URL_BARBERSHOP=http://barbershop.api:8080
SERVICE_URL_TECHSUPPORT=http://technicalsupport.api:8080

# Database Configuration
# Uncomment and configure for your environment
# DB_SERVER=host.docker.internal
DB_SERVER=3.17.16.153
DB_PORT=1433
DB_NAME=AcontPlus
DB_USER=sa
DB_PASSWORD=Acontplus2025Dev@!
DB_TRUST_CERT=True
CONNECTION_STRING=Server=${DB_SERVER},${DB_PORT};Database=${DB_NAME};User Id=${DB_USER};Password=${DB_PASSWORD};TrustServerCertificate=${DB_TRUST_CERT}

# JWT Settings
# Set these via User Secrets or uncomment below
# JWT_SECRET_KEY=your-super-secret-key-min-32-characters-long
# JWT_ISSUER=AcontPlus
# JWT_ACCESS_EXPIRATION=7200
# JWT_REFRESH_EXPIRATION=7

# CORS Origins
SAFE_ORIGINS=https://localhost:7166,https://localhost:4200,http://localhost:5001

# Resource Limits (not enforced in dev)
RESTART_POLICY=no
MEMORY_LIMIT=
CPU_LIMIT=

# Logging Driver
LOG_DRIVER=json-file
LOG_MAX_SIZE=50m
LOG_MAX_FILE=5

# Redis (if used)
# REDIS_HOST=redis
# REDIS_PORT=6379
# REDIS_PASSWORD=

# RabbitMQ (if used)
# RABBITMQ_HOST=rabbitmq
# RABBITMQ_PORT=5672
# RABBITMQ_USER=guest
# RABBITMQ_PASSWORD=guest

# Email Settings (if used)
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# EMAIL_FROM=

# AWS/S3 Settings (if used)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# S3_BUCKET_NAME=

# Feature Flags
# ENABLE_SWAGGER=true
# ENABLE_HEALTHCHECKS=true
