{
  "family": "ocelot-api-td",
  "networkMode": "awsvpc",
  "executionRoleArn": "arn:aws:iam::866150703026:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "ocelot-api-container",
      "image": "866150703026.dkr.ecr.us-east-1.amazonaws.com/ocelot-api-repo:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8080,
          "hostPort": 8080,
          "protocol": "tcp"
        }
      ],
      "environment": [
        { "name": "ASPNETCORE__ENVIRONMENT", "value": "${ENVIRONMENT}" },
        {
          "name": "SafeOrigins",
          "value": "https://app.acontplus.com,https://demo.acontplus.com,https://admin.acontplus.com,https://invoice.acontplus.com,https://restaurant.acontplus.com,http://localhost:7166,http://localhost:4200"
        },
        {
          "name": "JwtSettings__ExpirationInMinutes",
          "value": "${ACONTPLUS_JWT_SETTINGS_EXPIRATION_IN_MINUTES}"
        },
        { "name": "AdvancedLogging__EnableLocalFile", "value": "false" },
        { "name": "AdvancedLogging__EnableDatabaseLogging", "value": "true" },
        { "name": "AdvancedLogging__TimeZoneId", "value": "America/Guayaquil" },
        { "name": "AdvancedLogging__MinimumLogLevel", "value": "Error" }
      ],
      "secrets": [
        {
          "name": "JwtSettings__SecurityKey",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:866150703026:secret:ACONTPLUS_JWT_SETTINGS_SECURITY_KEY-ekCllZ"
        },
        {
          "name": "AdvancedLogging__DatabaseConnectionString",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:866150703026:secret:ACONTPLUS_CONN_STRING_PRD-sw4due"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-region": "us-east-1",
          "awslogs-create-group": "true",
          "awslogs-group": "acontplus/services/ocelot-api",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ],
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024"
}
