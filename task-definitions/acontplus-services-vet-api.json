{
  "family": "acontplus-services-vet-api",
  "executionRoleArn": "arn:aws:iam::866150703026:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::866150703026:role/ecsTaskRole",
  "networkMode": "awsvpc",
  "containerDefinitions": [
    {
      "name": "vet-api",
      "image": "866150703026.dkr.ecr.us-east-1.amazonaws.com/vet-api:latest",
      "cpu": 100,
      "portMappings": [
        {
          "name": "vet-api",
          "containerPort": 8080,
          "hostPort": 8080,
          "protocol": "tcp",
          "appProtocol": "http"
        }
      ],
      "environment": [
        { "name": "ASPNETCORE__ENVIRONMENT", "value": "${ENVIRONMENT}" },
        {
          "name": "AllowedCorsOrigins",
          "value": "http://localhost,http://localhost:8000,https://vet.acontplus.com,https://acontplus.com"
        },
        {
          "name": "JwtSettings__ExpirationInMinutes",
          "value": "${ACONTPLUS_JWT_SETTINGS_EXPIRATION_IN_MINUTES}"
        },
        { "name": "AdvancedLogging__EnableLocalFile", "value": "false" },
        { "name": "AdvancedLogging__EnableDatabaseLogging", "value": "false" },
        { "name": "AdvancedLogging__TimeZoneId", "value": "America/Guayaquil" },
        { "name": "AdvancedLogging__MinimumLogLevel", "value": "Error" },
        {
          "name": "S3Bucket__Name",
          "value": "acontplusprd"
        },
        {
          "name": "S3Bucket__Region",
          "value": "us-east-1"
        }
      ],
      "secrets": [
        {
          "name": "JwtSettings__SecurityKey",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:866150703026:secret:ACONTPLUS_JWT_SETTINGS_SECURITY_KEY-ekCllZ"
        },
        {
          "name": "AdvancedLogging__DatabaseConnectionString",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:866150703026:secret:ACONTPLUS_CONN_STRING_PRD-sw4due"
        },
        {
          "name": "ConnectionStrings__DefaultConnection",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:866150703026:secret:ACONTPLUS_CONN_STRING_PRD-sw4due"
        },
        {
          "name": "AwsConfiguration__AWSAccessKey",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:866150703026:secret:AWS_ACCESS_KEY_PRD-brGgAt"
        },
        {
          "name": "AwsConfiguration__AWSSecretKey",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:866150703026:secret:AWS_SECRET_KEY_PRD-sSGTMu"
        }
      ],
      "essential": true,
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-region": "us-east-1",
          "awslogs-create-group": "true",
          "awslogs-group": "/ecs/acontplus-services-vet-api",
          "awslogs-stream-prefix": "vet-api"
        }
      }
    }
  ],
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512"
}
